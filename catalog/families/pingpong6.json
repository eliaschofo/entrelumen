{
  "schemaVersion": 1,
  "about": "Mod ping-pong round 6 (docs/design/mod-pingpong.md#ronda-6-279-contenido-de-la-búsqueda-hacia-afuera): the content mods approved from the outward search of 27 September (docs/research/mod-outward.md). Petrol's Parts stays out: every Petrolpark's Library it accepts requires a JEI newer than the locked 19.50.0.414.",
  "content": {
    "createrailgrinding": [
      "II",
      "Slide along Create's train tracks keeping momentum; a boots enchantment",
      "Native: no items, and Create's tracks already follow its own ladder"
    ],
    "create_integrated_farming": [
      "II",
      "Create farming: vacuum harvester, fishing nets on trains and boats, roosts fed by spouts",
      "Native: brass, the mechanical harvester and Farmer's Delight canvas already place it in Act II"
    ],
    "croptopiabotany": [
      "I-II",
      "Croptopia's crops and trees grow in Botany Pots and their tiers",
      "Data only: the pots and their tier upgrades are staged by the resource balance"
    ],
    "alshanex_familiars": [
      "II-V",
      "Tameable spellcasting familiars for Iron's Spells, with their structures, shards and rituals",
      "Native: the familiar spellbook takes a diamond spell book and mithril, so it follows Iron's ladder"
    ],
    "ars_affinity": [
      "II-IV",
      "School affinities for Ars Nouveau: passives earned by casting and one active ability",
      "Native: it grows with the spells a player already casts"
    ]
  },
  "qol": {
    "ironsspellsnftbteams": "Iron's Spells summons do not attack players of their owner's FTB team"
  },
