{
  "schemaVersion": 1,
  "content": {
    "mcwdoors": [
      "I",
      "Wooden, metal and glass doors in every native wood and several building styles",
      "Complete the Macaw windows, fences, roofs and bridges already selected for shelters and Ark housing"
    ],
    "mcwtrpdoors": [
      "I",
      "Matching trapdoors for cellars, lofts and service hatches",
      "Maintenance access in workshops and Ark modules without opaque placeholder blocks"
    ],
    "mcwpaths": [
      "I",
      "Paving, cobbled and brick path blocks for walkable routes",
      "Mark routes between outposts, farms and Ark districts alongside Macaw bridges"
    ],
    "mcwstairs": [
      "I",
      "Balustrade, loft and platform stairs",
      "Vertical circulation for observatories and multi-level Ark modules"
    ],
    "refurbished_furniture": [
      "I-V",
      "Functional kitchens, fridges, freezers, stoves, sinks, lamps, mailboxes and door bells",
      "Working appliances cook and store food from the cooking family; post boxes let teammates exchange parcels between homes"
    ],
    "easy_villagers": [
      "II-IV",
      "Villagers carried as items and kept in compact breeder, farmer, trader and converter blocks",
      "The compact iron farm needs a living matrix (II) and the automatic trader a routing matrix (III); fewer villager entities help server load"
    ],
    "enderstorage": [
      "III",
      "Colour-frequency ender chests, tanks and pouches shared per player or team",
      "Chest, tank and pouch each need a routing matrix (III): cross-dimension item and fluid transfer arrives with AE2 wireless logistics"
    ],
    "laserbridges": [
      "IV",
      "Toggleable hard-light bridges and laser fences powered by redstone",
      "End-crystal fixtures for Ark walkways, hangar doors and safe expedition crossings"
    ],
    "solcarrot": [
      "I-VI",
      "A food book that rewards eating many different foods with extra hearts",
      "Pack milestones at 10, 25, 45, 70 and 100 unique foods grant one heart each, so the Pam, Herbs and Harvest, Farmer's Delight and sushi kitchens pay off gradually"
    ]
  },
  "qol": {
    "simplemagnets": "Toggleable item magnets with filters and a demagnetizing coil for farms",
    "itemcollectors": "Area item collectors with filters for farm and mob-drop collection points",
    "trashcans": "Filterable item, fluid and energy trash cans for automation overflow",
    "colorfulhearts": "Readable stacked heart rows when food variety adds health",
    "overloadedarmorbar": "Readable armour values above twenty points",
    "notenoughanimations": "Third-person animations for held maps, books, eating and ladders",
    "modelfix": "Fix gaps in extruded item models",
    "nochatreports": "Keep cooperative server chat free of signed reporting metadata"
  },
  "clientOnly": [
    "colorfulhearts",
    "overloadedarmorbar",
    "notenoughanimations",
    "modelfix"
  ],
  "performance": [
    "alltheleaks"
  ],
