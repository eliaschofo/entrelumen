{
  "schemaVersion": 1,
  "content": {
    "merequester": [
      "IV",
      "An AE2 requester that keeps chosen items stocked through existing autocrafting",
      "Keeps Ark component buffers topped up without another storage system"
    ],
    "sophisticatedstorageinmotion": [
      "II-IV",
      "Sophisticated chests and barrels on Create contraptions, minecarts and boats",
      "Mobile storage for trains and expedition carts beside the existing Sophisticated Storage"
    ],
    "sophisticatedstoragecreateintegration": [
      "II-III",
      "Create integration for Sophisticated Storage",
      "Contraption and deployer interaction with existing storage blocks"
    ],
    "sophisticatedbackpackscreateintegration": [
      "II-III",
      "Create integration for Sophisticated Backpacks",
      "Backpacks on contraptions and deployers for supplied builders"
    ],
    "create_hypertube": [
      "III",
      "Kinetic-powered hypertubes that move players along built routes",
      "Station-to-workshop travel that must be built and powered, beside trains and aircraft"
    ],
    "bellsandwhistles": [
      "II",
      "Decorative and functional Create train parts: platform blocks, doors, grab bars",
      "Finish train stations and expedition rail lines"
    ],
    "botanytrees": [
      "I-III",
      "Trees grown in the existing Botany Pots",
      "Compact wood and fruit supply that inherits the staged Botany Pots hopper and tier recipes"
    ],
    "elevatorid": [
      "I-II",
      "Colour-matched elevator blocks between floors",
      "Vertical circulation in multi-level bases and Ark modules without a teleport network"
    ],
    "energymeter": [
      "II-III",
      "An inline FE meter with rate readout and redstone output",
      "Measure generator output and machine draw before scaling a power plant"
    ],
    "rangedpumps": [
      "III",
      "A powered pump that drains fluids across a configurable range",
      "Supplies lava and water to Mekanism, Powah magmators and IE without manual buckets"
    ],
    "dummmmmmy": [
      "I",
      "A target dummy that shows damage numbers",
      "Test weapons, spells and armour from Iron's Spells, Draconic and Mekanism safely"
    ]
  },
  "qol": {
    "ae2netanalyser": "Visualise an AE2 network's channels and connections to debug large networks"
  },
