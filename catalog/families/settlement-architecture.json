    "mcwfences": [
      "I",
      "Picket and stockade fences, hedges, and matching gates for inhabited outposts",
      "Mark farm boundaries and safe foot routes between the Ark district, Create workshops and expedition shelters"
    ],
    "mcwlights": [
      "I-II",
      "Garden and wall lights, ceiling fixtures, fans and chandeliers for readable occupied spaces",
      "Light observatory approaches and Ark homes with optional fixtures beyond the existing lamp texture variants"
    ],
    "mcwwindows": [
      "I-II",
      "Resizable framed windows with working shutters and blinds for early homes",
      "Give the observatory and Ark housing controllable sightlines and daylight without requiring decorative blocks for progress"
    ]
