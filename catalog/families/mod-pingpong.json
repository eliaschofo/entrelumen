{
  "schemaVersion": 1,
  "content": {
    "modern_industrialization": [
      "II-V",
      "Steam-to-quantum industrial progression with its own multiblocks",
      "Fallback chosen by Elias because GregTech CEu Modern has no working NeoForge 1.21.1 server build; nuclear, fusion, quantum circuits, the electric quarry and flight carry act components; the replicator and the implosion nether star are removed"
    ],
    "oritech": [
      "III-V",
      "Laser, augment and particle-accelerator engineering",
      "Machines join the Mekanism/IE power network; the particle accelerator and enderic laser carry act components"
    ],
    "enderio": [
      "II-V",
      "Conduits, alloy smelting and capacitor-tiered machines",
      "Alloys and conduits in the workshop; the octadic capacitor carries an Act V component"
    ],
    "mahoutsukai": [
      "III-IV",
      "Mana-based blood and blade magic",
      "Arcane alternative beside Ars Nouveau and Occultism; native progression"
    ],
    "ad_astra": [
      "V",
      "Rocketry and planetary expeditions",
      "The NASA workbench needs the Ark bus: space opens while building the Ark"
    ],
    "deep_aether": [
      "IV",
      "Deeper Aether biomes, creatures and materials",
      "Extends the Aether expedition toward the Sun Spirit; shares the Aether portal"
    ],
    "eternal_starlight": [
      "IV",
      "Starlit expedition dimension with its own bosses",
      "The Orb of Prophecy needs a horizon chart: the observatory act opens the islands under another light"
    ],
    "undergarden": [
      "III",
      "Hostile underground dimension with its own ores",
      "The catalyst needs a routing matrix: an expedition route after the JAMD mining dimension"
    ],
    "naturalist": [
      "I",
      "Wildlife and field-guide fauna",
      "Ambient life for gardens and expeditions; small mobs do not cross portals"
    ],
    "friendsandfoes": [
      "I",
      "Vanilla-style creatures and golems",
      "Copper golems and villager-adjacent life for inhabited ruins"
    ],
    "creeperoverhaul": [
      "I",
      "Biome-specific creeper variants",
      "Hostile variety without new progression"
    ],
    "endermanoverhaul": [
      "I-III",
      "Biome and dimension-specific endermen",
      "Hostile variety across dimensions without new progression"
    ],
    "mowziesmobs": [
      "II-IV",
      "Mini-bosses and unique creatures",
      "Optional encounters with signature gear; not act bosses"
    ],
    "refinedstorage": [
      "III",
      "Alternative digital storage (optional to AE2)",
      "Controller needs a routing matrix and the autocrafter a handling core, matching AE2 entry in Act III"
    ],
    "refinedstorage_mekanism_integration": [
      "III",
      "Chemical storage for Refined Storage",
      "Parity with Applied Mekanistics for AE2"
    ],
    "refinedstorage_emi_integration": [
      "III",
      "Refined Storage recipe transfer in EMI",
      "Parity with AE2 EMI transfer"
    ],
    "mekanismcovers": [
      "III",
      "Cable covers for Mekanism transmitters",
      "Tidy Mekanism networks through built walls"
    ],
    "mekanisticrouters": [
      "III",
      "Mekanism chemical and energy modules for Modular Routers",
      "Extends compact routers to Mekanism chemicals"
    ],
    "pamhc2crops": [
      "I",
      "Pam's HarvestCraft 2 crops",
      "Completes the Pam's food core and trees already locked; duplicates unified with Almost Unified"
    ],
    "croptopia": [
      "I",
      "Crops, fruit trees and dishes",
      "Food variety; duplicate crops unified with Almost Unified under Farmer's Delight priority"
    ],
    "twilightdelight": [
      "IV",
      "Twilight Forest cooking",
      "Twilight expedition ingredients become meals"
    ],
    "ends_delight": [
      "IV",
      "End cooking",
      "End observatory expedition ingredients become meals"
    ],
    "mynethersdelight": [
      "II",
      "Nether cooking",
      "Nether foundry expedition ingredients become meals"
    ],
    "aethersdelight": [
      "IV",
      "Aether cooking",
      "Aether expedition ingredients become meals"
    ],
    "createdeco": [
      "II",
      "Create-style industrial decoration",
      "Finish Create workshops and Heliodor copper architecture"
    ],
    "littletiles": [
      "I",
      "Sub-block sculpting (Chisels & Bits equivalent for 1.21.1)",
      "Detailed player builds on the 16x16 lot; replaces Chisels & Bits, whose NeoForge 1.21.1 build fails to load; measured separately"
    ],
    "another_furniture": [
      "I",
      "Furniture and interior details",
      "Habitation interiors beside Handcrafted and Macaw's"
    ],
    "repurposed_structures": [
      "I-IV",
      "Variant vanilla structures across biomes and dimensions",
      "Exploration loot through Lootr; ENTRELUMEN ruins stay separate"
    ],
    "psi": [
      "II-III",
      "Programmable spell casting with CADs, bullets and a spell programmer",
      "Terra's programmable magic: the CAD Assembler needs a calibration frame (Act II) and the psigem CAD cores a routing matrix (Act III); its guide-book recipe gets its own ID so PneumaticCraft's book keeps patchouli:guide_book"
    ],
    "create_new_age": [
      "II-IV",
      "Heliodor's solar and electric engineering on Create: solar heating plates, generator coils, carbon brushes, energisers, motors and a thorium reactor",
      "The basic solar plate needs a calibration frame and the generator coil an energy coupler (Act II); the advanced solar plate, energiser and motor a power regulator (Act III); the reinforced energiser and motor a spectral lens and the reactor rod a containment seal (Act IV)"
    ],
    "create_central_kitchen": [
      "II",
      "Create automation of Farmer's Delight cooking pots, skillets, stoves, cutting boards and feasts",
      "Cooking route of the Create kitchen; its cutting-board-to-sawing and -deploying conversions stay off because Slice & Dice's slicer covers cutting"
    ],
    "sliceanddice": [
      "II",
      "Slicer for cutting-board recipes, sprinklers and liquid fertilizer",
      "Cutting and farm-watering route of the Create kitchen; its basin cooking stays off because Central Kitchen automates the real cooking pot"
    ],
    "mr_dungeons_andtaverns": [
      "I-IV",
      "Taverns, towers, crypts, camps and small dungeons in the Overworld, Nether and End",
      "Loot through Lootr; Overworld worldgen cost measured against the previous lock"
    ]
  },
  "qol": {
    "carryon": "Carry chests and animals; sensitive ENTRELUMEN, Ark and ruin blocks blacklisted"
  },
  "clientOnly": [
    "refinedstorage_emi_integration"
  ],
