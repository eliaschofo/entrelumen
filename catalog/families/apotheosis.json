{
  "schemaVersion": 1,
  "content": {
    "apotheosis": [
      "I-VI",
      "Adventure module: affixed loot, gems, rarity materials, salvaging, invaders and player-chosen World Tiers",
      "World Tiers unlock with the team campaign (Haven at start, Frontier after Act II, Ascent after Act III, Summit after Act V, Pinnacle after the Ark activation); its rune spawner modifiers yield to ENTRELUMEN augments"
    ],
    "apothic_enchanting": [
      "I-V",
      "Eterna, Quanta and Arcana enchanting table, shelves, infusion, tomes and the Library of Alexandria",
      "ENTRELUMEN cartographer, patina, lumen and horizon shelves and the Atlas Library extend it; 90- and 100-Eterna endshelves need a containment seal (IV) or an Ark bus (V)"
    ],
    "apothic_spawners": [
      "III-V",
      "In-place spawner modifiers for delay, count, range, conditions and behaviour",
      "Sixteen ENTRELUMEN augments carry the modifiers, staged III-V beside the IV mob-farm routes; silk-touch spawner harvesting stays disabled"
    ]
  },
