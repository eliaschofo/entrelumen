{
  "schemaVersion": 1,
  "content": {
    "betterdungeons": [
      "I-III",
      "Replaces vanilla dungeons with skeleton, spider and zombie dungeon layouts",
      "Early combat rooms with Lootr chests instead of a second dungeon layer"
    ],
    "bettermineshafts": [
      "I-II",
      "Replaces vanilla mineshafts with biome-styled shafts",
      "Early mining expeditions before the JAMD mining dimension"
    ],
    "betterstrongholds": [
      "III-IV",
      "Replaces the stronghold with a larger themed fortress",
      "The End route stays a real expedition before Draconic and End materials"
    ],
    "betterdeserttemples": [
      "I-III",
      "Replaces desert pyramids with explorable temples and puzzles",
      "Desert expeditions and archaeology beside the existing archaeology viewer"
    ],
    "betterjungletemples": [
      "I-III",
      "Replaces jungle temples with trapped, multi-room temples",
      "Jungle expedition goal with native loot"
    ],
    "betterwitchhuts": [
      "I-II",
      "Replaces swamp and cave witch huts",
      "Early witch encounters that feed Malum and Occultism reagents"
    ],
    "betteroceanmonuments": [
      "III-IV",
      "Replaces ocean monuments with a larger, readable guardian fortress",
      "Prismarine and sponge expeditions for Aquaculture and coastal outposts"
    ],
    "betterfortresses": [
      "II-III",
      "Replaces Nether fortresses with larger themed fortresses",
      "Blaze and wither-skeleton supply for Powah, brewing and Draconic prerequisites"
    ],
    "betterendisland": [
      "IV-V",
      "Replaces the End island and dragon arena",
      "A clearer dragon fight before End-tier goo, Draconic and elytra routes"
    ],
    "yungsextras": [
      "I-III",
      "Small decorative wells, ruins and scattered details",
      "Low-cost points of interest without another large structure set"
    ],
    "t_and_t": [
      "I-III",
      "Biome-specific village and pillager outpost variants and ships",
      "Varied settlements for Easy Villagers, trading and expedition waypoints"
    ],
    "explorify": [
      "I-III",
      "Vanilla-style small structures and ruins with loot",
      "Frequent early points of interest; loot stays through Lootr per player"
    ],
    "deeperdarker": [
      "IV-V",
      "Expanded ancient cities and the Otherside dimension below the Deep Dark",
      "Echo and sculk materials feed Just Dire Things tier-four goo and late armour"
    ],
    "cataclysm": [
      "IV-VI",
      "Boss structures with Ignis, the Netherite Monstrosity, the Harbinger, Leviathan and other bosses",
      "Optional late boss expeditions with their own drops; the campaign never requires defeating them"
    ],
    "hellish_trials": [
      "II-III",
      "Nether trial chambers with trial spawners and vaults",
      "A Nether counterpart to vanilla trial chambers for the first Nether expeditions"
    ]
  },
