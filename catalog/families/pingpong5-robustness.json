{
  "schemaVersion": 1,
  "about": "Mod ping-pong round 5, batch 1 (docs/design/mod-pingpong.md#ronda-5): robustness and performance from the 27 September census of ATM10, FTB Evolution and Craftoria. Fixes and optimizations with no items and no act gate; plus the Create collision hotfix and, from the outward search of 27 September (docs/research/mod-outward.md), Mekanism Pipez Fix, Neruina and Async Locator Refined.",
  "qol": {
    "imfast": "Stops the dedicated server from kicking or rubber-banding players who move fast (jetpacks, elytra, aircraft)",
    "packetfixer": "Raises packet size limits so full backpacks, large item data and big recipe syncs do not disconnect players",
    "lmft": "One bad entry in a tag file no longer empties the whole tag",
    "crash_assistant": "Crash window that names the likely cause and uploads the logs only when the player asks",
    "nanny": "Repairs the NaN health some mods leave behind, which makes a player immortal or kills them",
    "bcc": "Server list shows whether a server runs the same ENTRELUMEN version",
    "derenderpatcher": "Correct Draconic Evolution rendering (energy core, reactor, injectors) under Sodium",
    "createcollisionfix": "Stops the Create 6.0.10 contraption-collision crash (NullPointerException on the separation axis) that sends the server into a restart loop; remove when Create moves to 6.0.11, which carries the fix (PR #10301)",
    "mekpipezfix": "Pipez pipes keep feeding Mekanism multiblocks after a restart, so a fission reactor no longer loses its water and melts down",
    "neruina": "Suspends the entity, block entity or item that throws while ticking instead of crashing the server, and tells the players where it is"
  },
  "clientOnly": [
    "entityculling",
    "crash_assistant",
    "sodium_extra",
    "cmpreviewfixer",
    "derenderpatcher"
  ],
  "performance": [
    "entityculling",
    "structure_layout_optimizer",
    "sodium_extra",
    "nerb",
    "cmpreviewfixer",
    "asynclocator"
  ],
