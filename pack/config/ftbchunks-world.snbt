# ENTRELUMEN: FTB Chunks shows its map and minimap only to players with the ftbchunks_mapping stage.
# The companion gives that stage to every player outside the Envés and takes it away inside, so the
# dungeon's fog map is the only map there (docs/design/dungeon-enves.md). Everything else keeps FTB
# Chunks' defaults. Server admins may override in <world>/serverconfig/ftbchunks-world.snbt.
{
	require_game_stage: true
}
