    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Gift:\",\"color\":\"#9BE08A\"},{\"text\":\" a second one, so you can breed a pair.\"}]",
    "{@pagebreak}",
    "A fished bee comes out angry: keep a cage and a honey treat ready."
  ],
  "quest.65031E9BE7567D19.title": "Oily Bee",
  "quest.65031E9BE7567D19.quest_desc": [
