    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"IV to V: \"},{\"text\":\"Wyvern\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6FC734E34DCB6224\"}},{\"text\":\", \"},{\"text\":\"Draconic\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4338BEEF620CA369\"}},{\"text\":\" and \"},{\"text\":\"Chaotic\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2747470770A8C4BD\"}},{\"text\":\" tools\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:luminous_pickaxe\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"VI: the Luminous pickaxe, speed \"},{\"text\":\"60\",\"color\":\"#E8B04A\"},{\"text\":\" and no block it can't break\"}]"
  ],
  "task.344ADAAAF68256E3.title": "Any armor trim template",
  "quest.5676765C7A170966.title": "Eighteen ways to dress armor",
  "quest.5676765C7A170966.quest_subtitle": "The stats stay put. The looks don't.",
  "quest.5676765C7A170966.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A trim changes how armor looks and nothing else.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:sentry_armor_trim_smithing_template\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Eighteen patterns, each found somewhere different\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Ten materials tint them: copper, iron, gold, diamond, netherite, emerald, lapis, redstone, quartz and amethyst\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:emerald\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Solsticio's smith sells all eighteen: from \"},{\"text\":\"20\",\"color\":\"#E8B04A\"},{\"text\":\" to \"},{\"text\":\"64\",\"color\":\"#E8B04A\"},{\"text\":\" emeralds\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Look in shipwrecks, jungle temples, ancient cities, End cities and trial chambers: the elder guardian drops Tide, an outpost hides Sentry and the woodland mansion, Vex.\"}]"
  ],
  "task.73AE0EA864C5D6B9.title": "Any upgrade template from a mod",
  "quest.5E43D96990A49441.title": "Upgrade templates from mods",
  "quest.5E43D96990A49441.quest_subtitle": "The netherite trick, copied a dozen times.",
  "quest.5E43D96990A49441.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Modded upgrades copy the vanilla recipe: template, base, ingot.\"}]",
