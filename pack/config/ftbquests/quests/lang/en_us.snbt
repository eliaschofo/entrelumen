    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"The fire family starts here: coal, blaze, sulfur, lava, breeze.\"}]"
  ],
  "quest.352070B28F32FD7B.title": "Ghostly Bee",
