    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:tertium_essence\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Comb: \"},{\"text\":\"Tertium Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:tertium_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"50%\",\"bold\":true},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Reward:\",\"color\":\"#9BE08A\"},{\"text\":\" a random \"},{\"text\":\"perfect gene\",\"color\":\"#FFD84A\"},{\"text\":\".\"}]"
  ],
