  "image.097283882158DB29.title": "Back to the Sun of Heliodor",
  "chapter.52C84F9A5687FDE1.title": "Productive Bees · The Crown",
  "chapter.52C84F9A5687FDE1.chapter_subtitle": [
    "The top of the tree: bees hatched from eggs in other mods' machines, and Mystical Agriculture's ladder up the middle."
  ],
  "quest.35F3DE413F5CC15F.title": "ProsperiBee",
  "quest.35F3DE413F5CC15F.quest_subtitle": "Seeds for the seed mod.",
  "quest.35F3DE413F5CC15F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Feed a \"},{\"text\":\"Crystalline Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"631D1DB8B25062CC\"}},{\"text\":\" a \"},{\"text\":\"Prosperity Block\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:prosperity_block\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:prosperity_shard\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Comb: \"},{\"text\":\"Prosperity Shard\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:prosperity_shard\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"30%\",\"bold\":true},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Every rung of the ladder above is its egg, infused.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Gift:\",\"color\":\"#9BE08A\"},{\"text\":\" a second one; its kind will not pair up.\"}]"
  ],
  "quest.07E7E98882856A70.title": "Inferium Bee",
  "quest.07E7E98882856A70.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"On an \"},{\"text\":\"Infusion Altar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:infusion_altar\",\"count\":1}}},{\"text\":\": a \"},{\"text\":\"ProsperiBee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"35F3DE413F5CC15F\"}},{\"text\":\" egg, with four inferium blocks and four inferium essences around it.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Eggs come from a type gene in the \"},{\"text\":\"incubator\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3221DCBBBB0504C7\"}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:inferium_essence\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Comb: \"},{\"text\":\"Inferium Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:inferium_essence\",\"count\":1}}},{\"text\":\", every time.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Reward:\",\"color\":\"#9BE08A\"},{\"text\":\" a random \"},{\"text\":\"perfect gene\",\"color\":\"#FFD84A\"},{\"text\":\".\"}]"
  ],
  "quest.0D0CAEC22E26B3F4.title": "Prudentium Bee",
  "quest.0D0CAEC22E26B3F4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"On an \"},{\"text\":\"Infusion Altar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:infusion_altar\",\"count\":1}}},{\"text\":\": an \"},{\"text\":\"Inferium Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"07E7E98882856A70\"}},{\"text\":\" egg, with four prudentium blocks and four prudentium essences around it.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:prudentium_essence\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Comb: \"},{\"text\":\"Prudentium Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:prudentium_essence\",\"count\":1}}},{\"text\":\", every time.\"}]"
