    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"The \"},{\"text\":\"Deepshelf of Arcane Treasures\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:treasure_shelf\",\"count\":1}}},{\"text\":\" lets Mending and friends show up.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Most curses come with them.\",\"color\":\"#FF8C7A\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"+\"},{\"text\":\"10\",\"color\":\"#FF8A3D\"},{\"text\":\" Eterna up to \"},{\"text\":\"70\",\"color\":\"#FF8A3D\"},{\"text\":\", -\"},{\"text\":\"15\",\"color\":\"#FF8A3D\"},{\"text\":\" Quanta, -\"},{\"text\":\"15\",\"color\":\"#FF8A3D\"},{\"text\":\" Arcana.\"}]",
    "{@pagebreak}",
    "Two Deepshelves, four gold blocks, two diamonds and an emerald block."
  ],
  "quest.4F4583C7325315E7.title": "Aquatic filtration",
  "quest.4F4583C7325315E7.quest_subtitle": "A bouncer for enchantments.",
  "quest.4F4583C7325315E7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Ban enchantments from the table.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Slot up to \"},{\"text\":\"six\",\"color\":\"#FF8A3D\"},{\"text\":\" single-enchantment books into the \"},{\"text\":\"Seashelf of Aquatic Filtration\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:filtering_shelf\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Those stop showing up; the shelf gains Eterna and Arcana per book.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Four prismarine bricks, two Infused Seashelves and three \"},{\"text\":\"Prismarine Brick Slabs\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:prismarine_brick_slab\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.60EC9EDD56376A7D.title": "The Raven's table",
  "quest.60EC9EDD56376A7D.quest_subtitle": "Nevermore guessing.",
  "quest.60EC9EDD56376A7D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Set the three stats by hand.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"On the \"},{\"text\":\"Enchanting Table of the Raven\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:raven_enchanting_table\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Still within your World Tier's ceiling.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"A Perfect Gem of the Royal Family and two \"},{\"text\":\"God-Fused Pearls\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apotheosis:god_fused_pearl\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Plus an \"},{\"text\":\"Apothic Enchanting Table\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:apothic_enchanting_table\",\"count\":1}}},{\"text\":\" and three obsidian.\"}]"
  ],
  "task.215C40680592D1BF.title": "Enchant with every stat at maximum",
  "quest.5FFBA74236335DE0.title": "Maximum strength",
  "quest.5FFBA74236335DE0.quest_subtitle": "Every bar, full.",
  "quest.5FFBA74236335DE0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Every stat at its maximum at once.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"The Raven's table makes it a setting instead of a hunt.\"}]"
  ],
  "reward.2E8EE8217BFEA1E1.title": "Secret found",
  "quest.2BC7F48DD260BD7E.title": "Hellshelf of Sight",
  "quest.2BC7F48DD260BD7E.quest_subtitle": "A spyglass for the soul.",
  "quest.2BC7F48DD260BD7E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The \"},{\"text\":\"Hellshelf of Sight\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:sightshelf\",\"count\":1}}},{\"text\":\" adds \"},{\"text\":\"one\",\"color\":\"#FF8A3D\"},{\"text\":\" clue.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"One more enchantment shown before you pay.\"}]",
    "{@pagebreak}",
    "Four gold blocks, two Infused Hellshelves and a Potion of Night Vision.",
    "",
    "[\"\",{\"text\":\"Plus an \"},{\"text\":\"Eye of Ender\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_eye\",\"count\":1}}},{\"text\":\" and a \"},{\"text\":\"Spyglass\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:spyglass\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.762F1B60A21D3B11.title": "Masterful sight",
  "quest.762F1B60A21D3B11.quest_subtitle": "The Runes Reveal All.",
  "quest.762F1B60A21D3B11.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The \"},{\"text\":\"Hellshelf of Masterful Sight\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:sightshelf_t2\",\"count\":1}}},{\"text\":\" adds \"},{\"text\":\"two\",\"color\":\"#FF8A3D\"},{\"text\":\" clues.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"When every possible enchantment is visible, the preview says so.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"A Hellshelf of Sight, two \"},{\"text\":\"Netherite Ingots\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:netherite_ingot\",\"count\":1}}},{\"text\":\" and four emerald blocks.\"}]",
    "",
    "Plus two long night vision potions."
  ],
  "quest.213870BB6F9F47F2.title": "No more Too Expensive",
  "quest.213870BB6F9F47F2.quest_subtitle": "The anvil stopped haggling.",
  "quest.213870BB6F9F47F2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The anvil has no \"},{\"text\":\"40\",\"color\":\"#FF8A3D\"},{\"text\":\"-level cap anymore.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Every repair and combination goes through.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"It charges those levels' experience counted from zero, not your top levels.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Each use still doubles the item's prior-work penalty.\"}]"
  ],
  "quest.4D2D8B889ED9DAAC.title": "Tome of Scrapping",
  "quest.4D2D8B889ED9DAAC.quest_subtitle": "Recycling, the violent way.",
  "quest.4D2D8B889ED9DAAC.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"In an anvil, a \"},{\"text\":\"Tome of Scrapping\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:scrap_tome\",\"count\":1}}},{\"text\":\" destroys an enchanted item.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"You keep a book with \"},{\"text\":\"half\",\"color\":\"#FF8A3D\"},{\"text\":\" its enchantments, rounded up.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Your enchanting seed picks which.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Eight \"},{\"text\":\"Books\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:book\",\"count\":1}}},{\"text\":\" around an \"},{\"text\":\"Anvil\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:anvil\",\"count\":1}}},{\"text\":\" make eight.\"}]"
  ],
  "quest.5EA5741561913A04.title": "Superior scrapping",
  "quest.5EA5741561913A04.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The \"},{\"text\":\"Tome of Superior Scrapping\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:improved_scrap_tome\",\"count\":1}}},{\"text\":\" takes \"},{\"text\":\"every\",\"color\":\"#FF8A3D\"},{\"text\":\" enchantment.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"The item still goes.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Infuse\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"22E1C3ED5D785AC2\"}},{\"text\":\" a Tome of Scrapping at \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\" Eterna, \"},{\"text\":\"25\",\"color\":\"#FF8A3D\"},{\"text\":\" to \"},{\"text\":\"50\",\"color\":\"#FF8A3D\"},{\"text\":\" Quanta, \"},{\"text\":\"35\",\"color\":\"#FF8A3D\"},{\"text\":\" Arcana: four tomes.\"}]"
  ],
  "quest.66FF9CFD8BD2FD12.title": "Tome of Extraction",
  "quest.66FF9CFD8BD2FD12.quest_subtitle": "Keep the sword, take the magic.",
  "quest.66FF9CFD8BD2FD12.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The \"},{\"text\":\"Tome of Extraction\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:extraction_tome\",\"count\":1}}},{\"text\":\" pulls every enchantment into a book.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"The item stays \"},{\"text\":\"whole\",\"color\":\"#9BE08A\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"A Superior tome at \"},{\"text\":\"60\",\"color\":\"#FF8A3D\"},{\"text\":\" Eterna, \"},{\"text\":\"25\",\"color\":\"#FF8A3D\"},{\"text\":\" to \"},{\"text\":\"75\",\"color\":\"#FF8A3D\"},{\"text\":\" Quanta, \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\" Arcana gives four.\"}]"
  ],
  "quest.696C7F2B1A1F260E.title": "Prismatic Cobweb",
  "quest.696C7F2B1A1F260E.quest_subtitle": "A cobweb that catches curses.",
  "quest.696C7F2B1A1F260E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Strip every curse from an item.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"In an anvil, with the \"},{\"text\":\"Prismatic Cobweb\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:prismatic_web\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"The other enchantments stay.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Four prismarine shards around a \"},{\"text\":\"Cobweb\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:cobweb\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Eight string and a honeycomb make the cobweb.\"}]"
  ],
  "quest.60760C62C872171D.title": "Vanilla rules, bent",
  "quest.60760C62C872171D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Apothic loosens vanilla's exclusions.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Protection shares an item with one specialized protection.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Sharpness shares it with Smite or Bane of Arthropods.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Most enchantments pass their vanilla maximum; the question mark shows how far.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Each protection point is \"},{\"text\":\"2.5%\",\"color\":\"#FF8A3D\"},{\"text\":\" damage reduction here, up to \"},{\"text\":\"85%\",\"color\":\"#FF8A3D\"},{\"text\":\" (vanilla: \"},{\"text\":\"4%\",\"color\":\"#FF8A3D\"},{\"text\":\", up to \"},{\"text\":\"80%\",\"color\":\"#FF8A3D\"},{\"text\":\").\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Shears also take Unbreaking, Efficiency and Fortune.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Tridents take Sharpness, Looting and Piercing.\"}]"
  ],
  "task.31CFE0AC3FB1A1C4.title": "The Chronicle of Shadows",
  "quest.071023362CD7F66D.title": "The Chronicle of Shadows",
  "quest.071023362CD7F66D.quest_subtitle": "Written by someone called Shadows. Of course.",
  "quest.071023362CD7F66D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Apotheosis's own guide, for a \"},{\"text\":\"Book\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:book\",\"count\":1}}},{\"text\":\" and a \"},{\"text\":\"Gold Ingot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:gold_ingot\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Enchanting, affixes, gems, spawners and charms.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"It describes the mod without this pack's changes.\",\"color\":\"#FF8C7A\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Here tiers rise by themselves, spawners stay put and runes are gone.\"}]"
  ],
  "quest.0EAAB5E982A88005.title": "Blades that loot",
  "quest.0EAAB5E982A88005.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two sword enchantments that work on the loot.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Scavenger\",\"color\":\"#FF8A3D\"},{\"text\":\" (III): \"},{\"text\":\"2.5%\",\"color\":\"#FF8A3D\"},{\"text\":\" per level to roll a kill's loot twice, bosses included.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Knowledge of the Ages\",\"color\":\"#FF8A3D\"},{\"text\":\" (III): drops turn straight into experience.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Capturing, from Apothic Spawners, sometimes drops the mob's \"},{\"text\":\"spawn egg\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7DFEB61C03844351\"}},{\"text\":\".\"}]"
  ],
  "quest.7B7A80E6BC57AB3A.title": "Tools that overdo it",
  "quest.7B7A80E6BC57AB3A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three tool enchantments, none of them shy.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Chainsaw\",\"color\":\"#FF8A3D\"},{\"text\":\" (axes): the whole tree comes down, for durability.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Miner's Fervor\",\"color\":\"#FF8A3D\"},{\"text\":\" (V): very fast, never instant. Replaces Efficiency.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Boon of the Earth\",\"color\":\"#FF8A3D\"},{\"text\":\" (V, pickaxes): plain stone may drop ores.\"}]"
  ],
  "quest.280E8D322C96CDB7.title": "Hoes and shears",
  "quest.280E8D322C96CDB7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Farm tools learn tricks too.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Nature's Blessing\",\"color\":\"#FF8A3D\"},{\"text\":\" (III, hoes): the hoe works as bone meal.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Temptation\",\"color\":\"#FF8A3D\"},{\"text\":\" (hoes): animals follow you.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Shears: \"},{\"text\":\"Growth Serum\",\"color\":\"#FF8A3D\"},{\"text\":\", \"},{\"text\":\"Chromatic Aberration\",\"color\":\"#FF8A3D\"},{\"text\":\" and \"},{\"text\":\"Worker Exploitation\",\"color\":\"#FF8C7A\"},{\"text\":\".\"}]",
    "{@pagebreak}",
    "Growth Serum: half the time the sheep regrows at once. Chromatic Aberration: random wool colours.",
    "",
    "Worker Exploitation: double wool, and the sheep gets hurt."
  ],
  "quest.696B345010B7EA49.title": "Armor with a temper",
  "quest.696B345010B7EA49.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four armor enchantments, none of them polite.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Berserker's Fury\",\"color\":\"#FF8C7A\"},{\"text\":\" (chest): taking a hit hurts more, then Resistance, Speed and Strength.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Icy Thorns\",\"color\":\"#FF8A3D\"},{\"text\":\" (chest): slows attackers. \"},{\"text\":\"Rebounding\",\"color\":\"#FF8A3D\"},{\"text\":\" (chest, legs): throws them back.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Stable Footing\",\"color\":\"#FF8A3D\"},{\"text\":\" (boots): no mining penalty while flying.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"Life-Mending (anything, corrupted): the healing you receive repairs the item.\"}]"
  ],
  "quest.5CAB849DA6030E53.title": "Shields and strings",
  "quest.5CAB849DA6030E53.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four enchantments for shields, bows and crossbows.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Reflective Defenses\",\"color\":\"#FF8A3D\"},{\"text\":\" (V): \"},{\"text\":\"15%\",\"color\":\"#FF8A3D\"},{\"text\":\" of each blocked hit bounces back per level.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Shield Bash\",\"color\":\"#FF8A3D\"},{\"text\":\" (IV): shields hit harder, and wear faster.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Endless Quiver\",\"color\":\"#FF8A3D\"},{\"text\":\" (bows): every arrow is infinite. \"},{\"text\":\"Crescendo of Bolts\",\"color\":\"#FF8A3D\"},{\"text\":\" (V): free extra shots.\"}]"
  ],
  "quest.217DEEC16EE60BA9.title": "Tomes aim the roll",
  "quest.217DEEC16EE60BA9.quest_subtitle": "Books with opinions.",
  "quest.217DEEC16EE60BA9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Tomes only take their own type's enchantments.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Enchanted, it turns into a normal enchanted book.\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:book\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Two \"},{\"text\":\"Books\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:book\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Blaze Powder\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:blaze_powder\",\"count\":1}}},{\"text\":\": two \"},{\"text\":\"Tomes of Weaponry\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:weapon_tome\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "Pickaxe, fishing, bow and other tomes use a blaze rod, sticks and books."
  ],
  "quest.7FEE682231310998.title": "A tome for every piece",
  "quest.7FEE682231310998.quest_subtitle": "Five, eight, seven, four.",
  "quest.7FEE682231310998.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four armor tomes, one per slot.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:blaze_rod\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Each takes a \"},{\"text\":\"Blaze Rod\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:blaze_rod\",\"count\":1}}},{\"text\":\" and as many books as the piece takes metal: \"},{\"text\":\"5, 8, 7, 4\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Hunting one protection? Enchant its tome, not the armor.\"}]"
  ],
  "quest.6AEA9192E19F1112.title": "Lapis and books for the common table",
  "quest.6AEA9192E19F1112.quest_subtitle": "Somebody has to keep the shelves stocked.",
  "quest.6AEA9192E19F1112.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"64\",\"color\":\"#FF8A3D\"},{\"text\":\" Lapis Lazuli and \"},{\"text\":\"16\",\"color\":\"#FF8A3D\"},{\"text\":\" books, once a day.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Lapis pays every offer; books become shelves, tomes and more books.\"}]"
  ],
  "quest.758E6575C6681CC7.title": "The Enchantment Library",
  "quest.758E6575C6681CC7.quest_subtitle": "A bank that only takes books.",
  "quest.758E6575C6681CC7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Bank enchanted books as points.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"In the \"},{\"text\":\"Enchantment Library\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:library\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"A click pulls one level onto a book; a shift-click, as many as it can.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Up to \"},{\"text\":\"XVI\",\"color\":\"#FF8A3D\"},{\"text\":\", never above the highest level you put in.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Four \"},{\"text\":\"Ender Chests\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_chest\",\"count\":1}}},{\"text\":\", four infused shelves and an enchanting table.\"}]"
  ],
  "quest.4F9972B26966FF7A.title": "Library of Alexandria",
  "quest.4F9972B26966FF7A.quest_subtitle": "No fire this time.",
  "quest.4F9972B26966FF7A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The \"},{\"text\":\"Library of Alexandria\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:ender_library\",\"count\":1}}},{\"text\":\" holds up to \"},{\"text\":\"XXXI\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Infuse the library: exactly \"},{\"text\":\"100\",\"color\":\"#FF8A3D\"},{\"text\":\" Eterna, \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\" to \"},{\"text\":\"50\",\"color\":\"#FF8A3D\"},{\"text\":\" Quanta, \"},{\"text\":\"100\",\"color\":\"#FF8A3D\"},{\"text\":\" Arcana.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"The points come along.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"A \"},{\"text\":\"100\",\"color\":\"#FF8A3D\"},{\"text\":\"-Eterna infusion waits for Summit.\"}]"
  ],
  "quest.034159BC81B6BB34.title": "The Atlas Library",
  "quest.034159BC81B6BB34.quest_subtitle": "It writes what it never read.",
  "quest.034159BC81B6BB34.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Any enchantment, even one never deposited.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"The \"},{\"text\":\"Atlas Library\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:atlas_library\",\"count\":1}}},{\"text\":\" writes it, up to \"},{\"text\":\"XL\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"One level per \"},{\"text\":\"2.5\",\"color\":\"#FF8A3D\"},{\"text\":\" Eterna of its own ring; your World Tier does not cap it.\"}]",
    "{@pagebreak}",
    "Books pay into a pool of lumen. A deposit is worth at most half what that level costs.",
    "",
    "Each level up doubles the price, and curses are refused.",
    "",
    "A Library of Alexandria and two Horizon Shelves.",
    "",
    "[\"\",{\"text\":\"Two \"},{\"text\":\"Containment Seals\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:containment_seal\",\"count\":1}}},{\"text\":\" and four Ingots of the Skies.\"}]"
  ],
  "quest.11BF9193B86B4311.title": "The Atlas Library, by the numbers",
  "quest.11BF9193B86B4311.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Prices in lumen:\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Sharpness V deposits \"},{\"text\":\"8\",\"color\":\"#FF8A3D\"},{\"text\":\"; Sharpness X costs \"},{\"text\":\"512\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Mending costs \"},{\"text\":\"10\",\"color\":\"#FF8A3D\"},{\"text\":\" and gives back \"},{\"text\":\"2\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Hoppers and ME buses feed it books; breaking it keeps the pool.\"}]",
    "{@pagebreak}",
    "Quick Charge and Lure stop at V: above that, vanilla breaks."
  ],
  "quest.37BCA76CD4EBF50C.title": "Read the runes",
  "quest.37BCA76CD4EBF50C.quest_subtitle": "Standard Galactic, more or less.",
  "quest.37BCA76CD4EBF50C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The table has been muttering since you walked in.\"}]",
    "",
    "No reward: a few glowing letters."
  ],
  "image.7072FFEAE59F3D24.title": "[\"\",{\"text\":\"Apotheosis\",\"color\":\"#F3EEFF\",\"bold\":true}]",
  "image.0DD972323F58B6D5.title": "[\"\",{\"text\":\"Enchanting\",\"color\":\"#F2B27A\"}]",
  "image.7CC0D90FC4838600.title": "Back to the Sun of Heliodor",
  "image.0412326B71CBC4B2.title": "Apotheosis · Adventure",
  "image.24993F68C8324C96.title": "Apotheosis · Adventure",
  "image.1CD6E0EB6D215EF3.title": "Apotheosis · Spawners",
  "image.6DE64B867090F351.title": "Apotheosis · Spawners",
  "image.105345EA663687BB.title": "[\"\",{\"text\":\"Haven 45\",\"color\":\"#8FE68F\"}]",
  "image.044BAB5653B031F9.title": "[\"\",{\"text\":\"Frontier 75\",\"color\":\"#8FE68F\"}]",
  "image.6EDF062CC131550F.title": "[\"\",{\"text\":\"Ascent 90\",\"color\":\"#8FE68F\"}]",
  "image.0F7EC8ECD004B679.title": "[\"\",{\"text\":\"Summit 100\",\"color\":\"#8FE68F\"}]",
  "image.0718756AF0729B76.title": "[\"\",{\"text\":\"Quanta\",\"color\":\"#E94E4E\"}]",
  "image.46F7BE9E96F36C04.title": "[\"\",{\"text\":\"Arcana\",\"color\":\"#C13BC1\"}]",
  "image.7E5532059897EB26.title": "[\"\",{\"text\":\"Eterna\",\"color\":\"#4EE94E\"}]",
  "image.0A95D92788F96FB4.title": "[\"\",{\"text\":\"Quanta\",\"color\":\"#E94E4E\"}]",
  "image.4385E9DE57F431A1.title": "[\"\",{\"text\":\"Arcana\",\"color\":\"#C13BC1\"}]",
  "image.693D5D26986FC700.title": "[\"\",{\"text\":\"Haven 45\",\"color\":\"#8FE68F\"}]",
  "image.56E7C17A3A792905.title": "[\"\",{\"text\":\"Frontier 75\",\"color\":\"#8FE68F\"}]",
  "image.76FAED3FB9C95F50.title": "[\"\",{\"text\":\"Ascent 90\",\"color\":\"#8FE68F\"}]",
  "image.3FA807729162EBCD.title": "[\"\",{\"text\":\"Summit 100\",\"color\":\"#8FE68F\"}]",
  "image.100217259BAE03DD.title": "[\"\",{\"text\":\"15%\",\"color\":\"#E94E4E\"}]",
  "image.484307326E1F9F7C.title": "[\"\",{\"text\":\"50%\",\"color\":\"#E94E4E\"}]",
  "image.5971FF5D5154CF78.title": "[\"\",{\"text\":\"100%\",\"color\":\"#E94E4E\"}]",
  "image.3989DEF0EC5FB6F0.title": "[\"\",{\"text\":\"25%\",\"color\":\"#C13BC1\"}]",
  "image.04EC673A7B306299.title": "[\"\",{\"text\":\"75%\",\"color\":\"#C13BC1\"}]",
  "image.098C4DC7339CE035.title": "[\"\",{\"text\":\"100%\",\"color\":\"#C13BC1\"}]",
  "chapter.2CB268C1D9DEBD9E.title": "EvilCraft",
  "chapter.2CB268C1D9DEBD9E.chapter_subtitle": [
    "Dark gems, blood machines and the Box of Eternal Closure: every fight becomes fuel, and every spirit a farm that never spawns a mob."
  ],
  "quest.7043B42051E1F0E1.title": "Dark Gems",
  "quest.7043B42051E1F0E1.quest_subtitle": "Black glitter with bad intentions.",
  "quest.7043B42051E1F0E1.quest_desc": [
    "[\"\",{\"text\":\"Dark Ore\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:dark_ore\",\"count\":1}}},{\"text\":\" runs from bedrock up to height 66, thickest near the bottom, and glows when you touch it. Each block drops four or five \"},{\"text\":\"Dark Gems\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:dark_gem\",\"count\":1}}},{\"text\":\"; Fortune adds more, plus \"},{\"text\":\"Crushed Dark Gems\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:dark_gem_crushed\",\"count\":1}}},{\"text\":\" for rings, brooms and promises.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"No Fortune yet? An Oritech \"},{\"text\":\"Pulverizer\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"04932A1C97664069\"}},{\"text\":\" grinds a Dark Gem into a Crushed one, and Dark Ore into two gems and a crushed one.\"}]"
  ],
  "quest.063626A177E886C8.title": "Blood Extractor",
  "quest.063626A177E886C8.quest_subtitle": "A syringe with opinions.",
  "quest.063626A177E886C8.quest_desc": [
    "[\"\",{\"text\":\"Three \"},{\"text\":\"Spikes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:dark_spike\",\"count\":1}}},{\"text\":\" (a Dark Gem over iron makes sixteen), glass and another gem. Anywhere in your inventory it fills when you kill something: 5 to 40 mB per point of the victim's max health. \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and use it on a Blood Stain, left where something fell to its death, to drain it.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Used on the ground it pours out a bucket of blood. Extractors combined in a crafting grid, alone or with \"},{\"text\":\"Dark Tanks\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"439881AF0DC88B9D\"}},{\"text\":\", add up their capacity; each one holds five buckets.\"}]"
  ],
  "quest.439881AF0DC88B9D.title": "Dark Tank",
  "quest.439881AF0DC88B9D.quest_subtitle": "Sixteen buckets that fit in a pocket.",
  "quest.439881AF0DC88B9D.quest_desc": [
    "[\"\",{\"text\":\"Two Dark Gems, two iron ingots and glass. The \"},{\"text\":\"Dark Tank\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:dark_tank\",\"count\":1}}},{\"text\":\" holds sixteen buckets, placed or carried. Right-click a placed tank to open a drain below it; \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and use it in the air to keep every container you carry topped up.\"}]",
    "{@pagebreak}",
    "Tanks combined in a crafting grid add up without losing a drop. Iron blocks and Dark Blocks in the same pattern make one with nine times the room: 144 buckets."
  ],
  "quest.3235317897092347.title": "A blood farm",
  "quest.3235317897092347.quest_subtitle": "Grim, efficient and very quiet.",
  "quest.3235317897092347.quest_desc": [
    "[\"\",{\"text\":\"Six Dark Gems around a \"},{\"text\":\"Dark Block\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:dark_block\",\"count\":1}}},{\"text\":\" make a \"},{\"text\":\"Sanguinary Pedestal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:sanguinary_pedestal_0\",\"count\":1}}},{\"text\":\": it drains Blood Stains within two blocks into the tanks touching it. A \"},{\"text\":\"Spiked Plate\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:spiked_plate\",\"count\":1}}},{\"text\":\" on top hits mobs for 4 and sends it 160 mB per hit.\"}]",
    "{@pagebreak}",
    "Mobs killed on the plate drop what they would for a player, and the plate gives a redstone signal while it hurts something. Players cross it unharmed.",
    "",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Dark Power Gems upgrade the pedestal: twice the reach, five stains a tick and half again as much blood from each.\"}]"
  ],
  "quest.7CDFDBE98EC4294D.title": "Dark Power Gem",
  "quest.7CDFDBE98EC4294D.quest_subtitle": "A pool party nobody wants to attend.",
  "quest.7CDFDBE98EC4294D.quest_desc": [
    "[\"\",{\"text\":\"Pour five buckets of blood into a pool and toss a Dark Gem in: it drinks all five source blocks and comes out a \"},{\"text\":\"Dark Power Gem\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:dark_power_gem\",\"count\":1}}},{\"text\":\". You only need one this way; the Blood Infuser makes the next ones for a quarter of a bucket.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Dig the pool within four blocks of water, or under open sky on a rainy day, and it won't dry out while you gather the blood.\"}]"
  ],
  "quest.07C819EB548364E0.title": "Blood Infusion Core",
  "quest.07C819EB548364E0.quest_subtitle": "Eight scabs and a heart.",
  "quest.07C819EB548364E0.quest_desc": [
    "[\"\",{\"text\":\"Blood left out dries into \"},{\"text\":\"Hardened Blood\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:hardened_blood\",\"count\":1}}},{\"text\":\". Break it with \"},{\"text\":\"Flint and Steel\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:flint_and_steel\",\"count\":1}}},{\"text\":\" for five to nine \"},{\"text\":\"Hardened Blood Shards\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:hardened_blood_shard\",\"count\":1}}},{\"text\":\"; eight of them around a Dark Power Gem make the \"},{\"text\":\"Blood Infusion Core\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:blood_infusion_core\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "Broken any other way, hardened blood turns back into liquid, and rain melts it too. With Silk Touch you keep the block, which smelts into nine shards. Every blood machine that follows is built around a core."
  ],
  "quest.76FA8595F2D5755E.title": "Blood Infuser",
  "quest.76FA8595F2D5755E.quest_subtitle": "It gets hungry. Feed it.",
  "quest.76FA8595F2D5755E.quest_desc": [
    "[\"\",{\"text\":\"Eight cobblestone around the core. Feed it blood with a container or a pipe, put an item in the middle slot and it infuses: Dark Power Gems for 250 mB, \"},{\"text\":\"Undead Saplings\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:undead_sapling\",\"count\":1}}},{\"text\":\" from dead bushes, bricks, planks. Anything that holds blood gets filled instead. Redstone pauses it.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Its tank holds ten buckets. Most recipes above the first need a higher tier, and the tier comes from \"},{\"text\":\"Promises of Tenacity\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FE60F7EF4A97CEE\"}},{\"text\":\".\"}]"
  ],
  "quest.1FCBB104FA180DDD.title": "Undead Tree",
  "quest.1FCBB104FA180DDD.quest_subtitle": "It grows. It isn't alive about it.",
  "quest.1FCBB104FA180DDD.quest_desc": [
    "[\"\",{\"text\":\"A sapling and shears in a crafting grid give a dead bush; infuse it with 800 mB. The \"},{\"text\":\"Undead Sapling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:undead_sapling\",\"count\":1}}},{\"text\":\" grows a tree whose leaves drip Blood Stains and drop more dead bushes. Its planks under a Dark Gem make four \"},{\"text\":\"Dark Sticks\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:dark_stick\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A dropped Dark Stick turns its pale end toward the nearest \"},{\"text\":\"Dark Temple\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3ACFD4FB69BD07EB\"}},{\"text\":\".\"}]"
  ],
  "quest.711D75049FB2E851.title": "The Broom",
  "quest.711D75049FB2E851.quest_subtitle": "Witch-grade transport, blood-grade fuel.",
  "quest.711D75049FB2E851.quest_desc": [
    "[\"\",{\"text\":\"Crushed Dark Gems and Dark Sticks make a bare rod, brush and cap; the three together in a crafting grid are a \"},{\"text\":\"Broom\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:broom\",\"count\":1}}},{\"text\":\". Use it to mount, and it flies where you look. It carries ten buckets and burns 1 mB a tick; run dry and it crawls.\"}]",
    "{@pagebreak}",
    "Dress each part before assembling: bones or blaze rods on the rod, feathers or wool on the brush, gems or heads on the cap. Every material changes speed, turning and climb, and each part's tooltip shows how. An empty broom drinks from other blood containers you carry.",
    "",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and use on a block parks the broom there instead of mounting it.\"}]"
  ],
  "quest.2604EA60E3063DEF.title": "Bowl of Promises",
  "quest.2604EA60E3063DEF.quest_subtitle": "Machines believe what they're told.",
  "quest.2604EA60E3063DEF.quest_desc": [
    "[\"\",{\"text\":\"Three Dark Power Gems make a \"},{\"text\":\"Bowl of Empty Promises\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:bowl_of_promises_empty\",\"count\":1}}},{\"text\":\"; dust it with two Crushed Dark Gems and infuse it with five buckets. It comes out at the infuser's own tier and is never used up. An iron block soaked in ten buckets becomes the \"},{\"text\":\"Iron Promise Acceptor\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:promise_acceptor_iron\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.5FE60F7EF4A97CEE.title": "Promises of Tenacity",
  "quest.5FE60F7EF4A97CEE.quest_subtitle": "Bigger tank, more slots, darker recipes.",
  "quest.5FE60F7EF4A97CEE.quest_desc": [
    "[\"\",{\"text\":\"A tier 0 bowl, the iron acceptor and a spider eye make \"},{\"text\":\"Promise of Tenacity I\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:promise_tier_1\",\"count\":1}}},{\"text\":\". In the infuser's first slot it lifts the machine to tier 1, which makes tier 1 bowls: one of those, a gold acceptor (a gold block, 40 buckets) and an ender pearl make \"},{\"text\":\"Tenacity II\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:promise_tier_2\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "Each tier opens one more upgrade slot.",
    "",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The tooltip says each Tenacity doubles the tank; the machine quadruples it: 40 buckets at tier 1, 160 at tier 2, 640 at tier 3. Just enough for the next acceptor.\"}]"
  ],
  "quest.31229FD30B0895A7.title": "Dark Blood Bricks",
  "quest.31229FD30B0895A7.quest_subtitle": "Masonry that remembers.",
  "quest.31229FD30B0895A7.quest_desc": [
    "[\"\",{\"text\":\"A \"},{\"text\":\"Dark Block\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:dark_block\",\"count\":1}}},{\"text\":\" with a stone brick on each side makes four \"},{\"text\":\"Dark Bricks\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:dark_brick\",\"count\":1}}},{\"text\":\"; at tier 2 the infuser soaks each in a bucket of blood. A zombie's furnace is a hollow shell three wide, four tall and three deep: 33 \"},{\"text\":\"Dark Blood Bricks\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:dark_blood_brick\",\"count\":1}}},{\"text\":\" plus the furnace.\"}]"
  ],
  "quest.09F4B8C1E0773233.title": "Spirit Furnace",
  "quest.09F4B8C1E0773233.quest_subtitle": "Mob chef. The menu is the mob.",
  "quest.09F4B8C1E0773233.quest_desc": [
    "[\"\",{\"text\":\"Four Dark Blood Bricks around a core make the \"},{\"text\":\"Spirit Furnace\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:spirit_furnace\",\"count\":1}}},{\"text\":\". Set it into one wall of the brick shell and the bricks glow red. It revives a boxed spirit just long enough to cook it: the mob's drops land in its four output slots and the box comes back for another round.\"}]",
    "{@pagebreak}",
    "Each batch takes ten ticks per point of the mob's health and armor at 25 mB a tick: a zombie is eleven seconds and five and a half buckets. Promises make it faster and thriftier; hoppers and pipes put boxes and blood in and take the drops out."
  ],
  "quest.0DE1D4B13C0A2DA2.title": "Vengeance Spirits",
  "quest.0DE1D4B13C0A2DA2.quest_subtitle": "They remember you. Specifically you.",
  "quest.0DE1D4B13C0A2DA2.quest_desc": [
    "[\"\",{\"text\":\"Every mob that dies leaves a spirit for up to fifty seconds, at most five within 32 blocks. Four iron ingots and four Crushed Dark Gems make the \"},{\"text\":\"Vengeance Ring\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:vengeance_ring\",\"count\":1}}},{\"text\":\": kill while you carry it and the fresh spirit turns on you, visible and angry.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and use switches it on: jump, speed, haste and invisibility, while every spirit within ten blocks comes for you, and one shows up if none is near. Each spirit hits once and vanishes, and no ordinary weapon touches it.\"}]"
  ],
  "quest.70D17A9748662DC6.title": "Vengeance Focus",
  "quest.70D17A9748662DC6.quest_subtitle": "A beam that says 'hold still'.",
  "quest.70D17A9748662DC6.quest_desc": [
    "[\"\",{\"text\":\"The ring in a frame of iron and Crushed Dark Gems. Hold use like a bow and the \"},{\"text\":\"Vengeance Focus\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:vengeance_focus\",\"count\":1}}},{\"text\":\" fires a beam that freezes the spirit it touches; keep it on target, since each hit only holds for a few ticks. A frozen spirit doesn't age, either.\"}]"
  ],
  "quest.60ED7DD7BCE245C1.title": "Box of Eternal Closure",
  "quest.60ED7DD7BCE245C1.quest_subtitle": "A jail with a lid.",
  "quest.60ED7DD7BCE245C1.quest_desc": [
    "[\"\",{\"text\":\"Six Crushed Dark Gems, two Potions of Weakness and an Ender Chest. Set the \"},{\"text\":\"Box of Eternal Closure\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:box_of_eternal_closure\",\"count\":1}}},{\"text\":\" on solid ground and open it: an open box pulls in the nearest frozen spirit within ten blocks and snaps shut. Swarms don't fit.\"}]",
    "{@pagebreak}",
    "Broken, the box keeps its prisoner, and a comparator reads 15 from a full one. Opening a full box lets the spirit out, angry at everyone around."
  ],
  "task.72C6BCB87D52E183.title": "Box a spirit",
  "task.50D0633D8AD2D644.title": "Watch your Spirit Furnace",
  "quest.4AD07AAD58C2D981.title": "Eternal Closure",
  "quest.4AD07AAD58C2D981.quest_subtitle": "Every fight is fuel now.",
  "quest.4AD07AAD58C2D981.quest_desc": [
    "Freeze a spirit with the focus, let an open box take it, then load the box into the Spirit Furnace with blood to spare. The mob cooks forever and the box never empties: a mob farm that never spawns a single mob."
  ],
  "quest.385FA6C934E3365F.title": "Origins of Darkness",
  "quest.385FA6C934E3365F.quest_subtitle": "Someone else's diary. Read it anyway.",
  "quest.385FA6C934E3365F.quest_desc": [
    "[\"\",{\"text\":\"Nobody crafts it: one chest in five in village smithies and shepherds' houses, dungeons, mineshafts, jungle temples, igloos, fortresses and ancient cities holds one. Or feed a \"},{\"text\":\"Darkened Apple\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:darkened_apple\",\"count\":1}}},{\"text\":\" to an animal and throw a book into the anomaly it leaves when it fades away.\"}]"
  ],
  "quest.0209960928120702.title": "Evil dungeons",
  "quest.0209960928120702.quest_subtitle": "Somebody lost a fight here. Several somebodies.",
  "quest.0209960928120702.quest_desc": [
    "[\"\",{\"text\":\"Caves hide rooms floored with \"},{\"text\":\"Bloody Cobblestone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:bloody_cobblestone\",\"count\":1}}},{\"text\":\", with a spawner and two or three dungeon chests. Any dungeon chest may hold the diary, Condensed Blood that tops up a blood machine, a ready-made Broom or a Box of Eternal Closure with something already inside.\"}]"
  ],
  "task.7E073C77C88B190C.title": "Kill a Nether Fish",
  "quest.12725BE2B211B610.title": "Libelles and Nether Fish",
  "quest.12725BE2B211B610.quest_subtitle": "Two pests the diary is proud of.",
  "quest.12725BE2B211B610.quest_desc": [
    "[\"\",{\"text\":\"Poisonous Libelles are giant dragonflies over rivers that poison you and drop \"},{\"text\":\"Poison Sacs\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:poison_sac\",\"count\":1}}},{\"text\":\"; four poisonous things and a bucket make a \"},{\"text\":\"Poison Bucket\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:bucket_poison\",\"count\":1}}},{\"text\":\". In Soul Sand Valleys, some netherrack, nether brick and soul sand hide Nether Fish that set you on fire.\"}]"
  ],
  "quest.2B529AB6EBE14361.title": "Full moon over the village",
  "quest.2B529AB6EBE14361.quest_subtitle": "The quiet neighbor was never that quiet.",
  "quest.2B529AB6EBE14361.quest_desc": [
    "[\"\",{\"text\":\"A villager who takes a Blood Infuser, Blood Chest or Purifier as a job site becomes a Werewolvian, and lightning turns half the villagers it strikes into one. On full-moon nights they turn into Werewolves: 40 health, hits for 7. Each one drops \"},{\"text\":\"Werewolf Fur\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:werewolf_fur\",\"count\":1}}},{\"text\":\", maybe bones and flesh.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"By day they trade: dark gems, shards, poison sacs and werewolf parts for emeralds, and they sell Crushed Dark Gems, Undead Saplings, Vengeance Focuses and Boxes of Eternal Closure. A master sells \"},{\"text\":\"Garmonbozia\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"31722D0E2BBEF367\"}},{\"text\":\" for ten emeralds.\"}]",
    "",
    "[\"\",{\"text\":\"A dead werewolf is a dead trader.\",\"color\":\"#FF8C7A\"},{\"text\":\" Werewolf Flesh eaten at night gives strength, speed and a high jump; by day, poison.\"}]"
  ],
  "quest.6576A19DEE2AE093.title": "Five dark enchantments",
  "quest.6576A19DEE2AE093.quest_desc": [
    "[\"\",{\"text\":\"Life Stealing heals you with part of the damage you deal, Poison Tip poisons from a bow, and Unusing stops a tool at its last point of durability instead of breaking it. Curse of Breaking wears tools faster; Curse of Vengeance calls spirits whenever the tool is used. The \"},{\"text\":\"Purifier\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6D0085AFA7386179\"}},{\"text\":\" lifts curses.\"}]"
  ],
  "quest.1A06B7ADE9A53F3B.title": "Cannibal",
  "quest.1A06B7ADE9A53F3B.quest_subtitle": "Try a friend instead.",
  "quest.1A06B7ADE9A53F3B.quest_desc": [
    "A player who dies sometimes drops Humanoid Flesh with their name on it. At night it gives strength, speed and a high jump; by day it poisons. Your own tastes of wither and blindness."
  ],
  "reward.2FE6F3B4F4109F3D.title": "Secret found",
  "task.7EFC81365AC0478D.title": "An Exalted Crafter, either kind",
  "quest.25A8564FA469CFE5.title": "Exalted Crafter",
  "quest.25A8564FA469CFE5.quest_subtitle": "Craft-ception.",
  "quest.25A8564FA469CFE5.quest_desc": [
    "[\"\",{\"text\":\"A crafting table for your pocket: gold, iron, a crafting table, two Crushed Dark Gems and a chest. Built on an Ender Chest it opens your ender inventory; on a wooden chest it keeps a small one of its own. Bind \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.evilcraft.exaltedCrafting\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" in Controls to open it from anywhere in your inventory.\"}]",
    "{@pagebreak}",
    "Struck by lightning it becomes empowered: dropped, it neither burns nor despawns."
  ],
  "quest.209E90DEAD32F3AA.title": "Odds and ends",
  "quest.209E90DEAD32F3AA.quest_subtitle": "The diary's junk drawer.",
  "quest.209E90DEAD32F3AA.quest_desc": [
    "[\"\",{\"text\":\"Spikey Claws\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:spikey_claws\",\"count\":1}}},{\"text\":\", three Spikes on an iron ingot, dig soft blocks fast and hit like a weapon. \"},{\"text\":\"Obscured Glass\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:obscured_glass\",\"count\":1}}},{\"text\":\" stays see-through while blocking nearly all light. A \"},{\"text\":\"Display Stand\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:display_stand\",\"count\":1}}},{\"text\":\" shows off an item, in whatever wood you craft it from.\"}]",
    "{@pagebreak}",
    "Pipes reach the stand's item from the top and bottom; from the sides you use the item itself, its tank, energy and all."
  ],
  "quest.10EB289139AE9A2E.title": "Nasty gases",
  "quest.10EB289139AE9A2E.quest_subtitle": "Finally.",
  "quest.10EB289139AE9A2E.quest_desc": [
    "[\"\",{\"text\":\"You bound \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.evilcraft.fart\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and pressed it. The pack leaves it unbound for a reason, but EvilCraft ships farting switched on. Your team heard.\"}]"
  ],
  "reward.4007DEB859CCB637.title": "Secret found",
  "quest.351C2326640B6B1B.title": "Weather Container",
  "quest.351C2326640B6B1B.quest_subtitle": "Bottled rain. Bottled lightning. Bottled nice day.",
  "quest.351C2326640B6B1B.quest_desc": [
    "[\"\",{\"text\":\"A Dark Gem, a glass bottle and sugar. Drop an empty \"},{\"text\":\"Weather Container\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:weather_container\",\"count\":1}}},{\"text\":\" on a Dark Temple's accumulator and it bottles the weather, and the sky moves on to the next. Throw a full one anywhere to let its weather out.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"A clear one and two water buckets craft a rain one; rain and two glowstone dust, a lightning one. Eight ender pearls around a lightning container make eight \"},{\"text\":\"Lightning Grenades\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:lightning_grenade\",\"count\":1}}},{\"text\":\", and a rain container turns into \"},{\"text\":\"Eternal Water\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:eternal_water\",\"count\":1}}},{\"text\":\", a block that never runs dry.\"}]"
  ],
  "quest.3ACFD4FB69BD07EB.title": "Dark Temple",
  "quest.3ACFD4FB69BD07EB.quest_subtitle": "An ancient civilization that overdid it.",
  "quest.3ACFD4FB69BD07EB.quest_desc": [
    "[\"\",{\"text\":\"Stone-brick ruins on hills, plains, forests, deserts and shores, each with four \"},{\"text\":\"Environmental Accumulators\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:environmental_accumulator\",\"count\":1}}},{\"text\":\". Drop an item on one in the right weather and it pours the sky's power into it, then changes the weather. Lost? A dropped Dark Stick points its pale end at the nearest temple.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Every use degrades the land around it:\",\"color\":\"#FF8C7A\"},{\"text\":\" the biome turns Degraded, mobs appear, the ground warps and anyone nearby feels sick and pale. Broken, an accumulator gives up its core: see the \"},{\"text\":\"home version\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"337E39C7E1F2F446\"}},{\"text\":\".\"}]"
  ],
  "quest.38D504698812501C.title": "Empowered Inverted Potentia",
  "quest.38D504698812501C.quest_subtitle": "Charged by the sky, whether it likes it or not.",
  "quest.38D504698812501C.quest_desc": [
    "[\"\",{\"text\":\"Redstone, glowstone, a slimeball and lapis make a \"},{\"text\":\"Potentia Sphere\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:potentia_sphere\",\"count\":1}}},{\"text\":\"; four Dark Gems around it make \"},{\"text\":\"Inverted Potentia\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:inverted_potentia\",\"count\":1}}},{\"text\":\". Lightning empowers it: drop it on a temple accumulator in a thunderstorm, or let a bolt hit it where it lies.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"A thrown \"},{\"text\":\"Lightning Grenade\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:lightning_grenade\",\"count\":1}}},{\"text\":\" calls a bolt wherever it lands. The \"},{\"text\":\"maces\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1720221FD539D4BE\"}},{\"text\":\" and the \"},{\"text\":\"Necromancer Staff\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5680508F4F1D9E9F\"}},{\"text\":\" each need one \"},{\"text\":\"Empowered Inverted Potentia\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:inverted_potentia_empowered\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.337E50765CA60B8F.title": "Biome Extract",
  "quest.337E50765CA60B8F.quest_subtitle": "Terraforming, one bottle at a time.",
  "quest.337E50765CA60B8F.quest_desc": [
    "[\"\",{\"text\":\"A Dark Gem, a Crushed Dark Gem and five glass make three empty bottles. Drop one on an accumulator and it fills with the biome the machine stands in; thrown, the \"},{\"text\":\"Biome Extract\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:biome_extract\",\"count\":1}}},{\"text\":\" repaints the ground where it breaks.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"A temple that has worn down its land bottles Degraded.\",\"color\":\"#FF8C7A\"},{\"text\":\" The \"},{\"text\":\"Sanguinary Environmental Accumulator\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"337E39C7E1F2F446\"}},{\"text\":\" makes clean extracts.\"}]"
  ],
  "quest.337E39C7E1F2F446.title": "An accumulator at home",
  "quest.337E39C7E1F2F446.quest_subtitle": "Weather on tap, paid in blood.",
  "quest.337E39C7E1F2F446.quest_desc": [
    "[\"\",{\"text\":\"Break a temple accumulator for its \"},{\"text\":\"Environmental Accumulation Core\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:environmental_accumulation_core\",\"count\":1}}},{\"text\":\". With Garmonbozia, a Blood Infusion Core, two iron blocks and cobblestone it becomes the \"},{\"text\":\"Sanguinary Environmental Accumulator\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:sanguinary_environmental_accumulator\",\"count\":1}}},{\"text\":\": no weather, no degradation, but eight tanks of blood around it.\"}]",
    "{@pagebreak}",
    "The tanks sit three blocks out and one to the side, two per face; smoke marks each missing one. An empowered potentia costs sixty buckets, a biome extract twenty-five."
  ],
  "quest.7E2465162DFCD0F3.title": "Blood Chests",
  "quest.7E2465162DFCD0F3.quest_subtitle": "Free repairs, fine print included.",
  "quest.7E2465162DFCD0F3.quest_desc": [
    "[\"\",{\"text\":\"Eight planks around a core make a \"},{\"text\":\"Blood Chest\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:blood_chest\",\"count\":1}}},{\"text\":\": tools in its ten slots mend at 5 mB per point of durability. Now and then one picks up a random curse, which the \"},{\"text\":\"Purifier\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6D0085AFA7386179\"}},{\"text\":\" lifts.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"For a whole armory, the \"},{\"text\":\"Colossal Blood Chest\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:colossal_blood_chest\",\"count\":1}}},{\"text\":\" has 45 slots, takes promises, never curses what it mends and spends less per item the more it mends at once. Build a hollow 3x3x3 of Reinforced Undead Planks (tier 2 infusion) with the chest in one wall, never the middle.\"}]"
  ],
  "quest.6D0085AFA7386179.title": "Purifier",
  "quest.6D0085AFA7386179.quest_subtitle": "Exorcism, one bucket at a time.",
  "quest.6D0085AFA7386179.quest_desc": [
    "[\"\",{\"text\":\"Two shards, four Dark Gems, a Dark Block and a core. With a tool inside, each bucket lifts one level of any curse, vanilla ones included. Filled to its three buckets with a \"},{\"text\":\"Blook\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:blook\",\"count\":1}}},{\"text\":\" beside the item, it moves one random enchantment onto an enchanted book.\"}]",
    "{@pagebreak}",
    "The Blook is a book infused with half a bucket at tier 1. Moving an enchantment off also lowers the item's anvil cost. Full, with an empty bottle, it pulls a potion effect off a mob standing inside."
  ],
  "quest.0E305F7EF8D735F8.title": "Blood-powered tools",
  "quest.0E305F7EF8D735F8.quest_subtitle": "Every one of them is thirsty.",
  "quest.0E305F7EF8D735F8.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Blood Pearl of Teleportation\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:blood_pearl_of_teleportation\",\"count\":1}}},{\"text\":\" is an ender pearl you keep: 100 mB a throw. The \"},{\"text\":\"Kineticator\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:kineticator\",\"count\":1}}},{\"text\":\" pulls items and experience toward you; crafted mirrored, it pushes them away. The \"},{\"text\":\"Sceptre of Thunder\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:sceptre_of_thunder\",\"count\":1}}},{\"text\":\" calls a thunderstorm, once.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The last two need a filled \"},{\"text\":\"Blood Orb\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:blood_orb_filled\",\"count\":1}}},{\"text\":\": four glass around iron, infused with ten buckets at tier 1. \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and use switches the Kineticator on and off; plain use changes its reach.\"}]"
  ],
  "quest.3452C9BE044B1BAA.title": "Power gems for the common store",
  "quest.3452C9BE044B1BAA.quest_subtitle": "Every dark machine starts with one.",
  "quest.3452C9BE044B1BAA.quest_desc": [
    "[\"\",{\"text\":\"Eight \"},{\"text\":\"Dark Power Gems\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:dark_power_gem\",\"count\":1}}},{\"text\":\" for the common store, once a day. At 250 mB each in the infuser, a spiked plate over a pedestal pays for them in about a dozen hits.\"}]"
  ],
  "quest.16C2A3E477E47828.title": "More promises",
  "quest.16C2A3E477E47828.quest_subtitle": "Faster, cheaper, deeper.",
  "quest.16C2A3E477E47828.quest_desc": [
    "[\"\",{\"text\":\"Tenacity III\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:promise_tier_3\",\"count\":1}}},{\"text\":\" takes a tier 2 bowl, an eye of ender and a diamond block soaked in 160 buckets. A tier 1 bowl and an iron acceptor make \"},{\"text\":\"Velocity\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:promise_speed_0\",\"count\":1}}},{\"text\":\" with a redstone block, doubling speed, or \"},{\"text\":\"Productivity\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:promise_efficiency_0\",\"count\":1}}},{\"text\":\" with a lapis block, cutting blood by a third.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Promises stack four to a slot for a stronger effect. The Spirit Furnace, the Reanimator, the Colossal Blood Chest and the home accumulator take them too.\"}]"
  ],
  "quest.2E615AD05035224D.title": "The infuser's side jobs",
  "quest.2E615AD05035224D.quest_subtitle": "Blood makes everything better. Allegedly.",
  "quest.2E615AD05035224D.quest_desc": [
    "[\"\",{\"text\":\"From tier 1 the infuser earns its keep: coal becomes \"},{\"text\":\"Blood-Waxed Coal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:blood_waxed_coal\",\"count\":1}}},{\"text\":\" that burns twice as long, bone meal becomes \"},{\"text\":\"Blood Potash\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:blood_potash\",\"count\":1}}},{\"text\":\" that grows twice as much, rotten flesh turns to leather, dirt to grass and a Potentia Sphere to an ender pearl.\"}]",
    "{@pagebreak}",
    "Higher tiers go darker: redstone from Dull Dust, netherrack from cobblestone, soul sand from sand, nether wart from seeds, blaze rods from bones, and mob heads climbing from skeleton to wither skeleton."
  ],
  "quest.06515B5043E364D1.title": "Entangled Chalices",
  "quest.06515B5043E364D1.quest_subtitle": "Spooky action at a distance, but for blood.",
  "quest.06515B5043E364D1.quest_desc": [
    "[\"\",{\"text\":\"A ghast tear infused with ten buckets at tier 3 turns into a \"},{\"text\":\"Corrupted Tear\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:corrupted_tear\",\"count\":1}}},{\"text\":\". With six gold ingots and two Dark Gems it makes two \"},{\"text\":\"Entangled Chalices\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:entangled_chalice\",\"count\":1}}},{\"text\":\" that share one tank wherever they are; craft an old chalice in place of the center gold to add a new one to its network.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and use one in your hand for Omni-supply: it keeps every container you carry filled from the shared tank.\"}]"
  ],
  "quest.661F846763B2CF34.title": "Invigorating Pendant",
  "quest.661F846763B2CF34.quest_subtitle": "Antidote on a string.",
  "quest.661F846763B2CF34.quest_desc": [
    "[\"\",{\"text\":\"Three Golden Strings (string and a gold nugget), two Crushed Dark Gems and a core. Carried, the \"},{\"text\":\"Invigorating Pendant\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:invigorating_pendant\",\"count\":1}}},{\"text\":\" burns away harmful effects with its blood, worse ones costing more, and even puts out fire. It holds five buckets.\"}]"
  ],
  "quest.0E8B294D9372E88A.title": "Primed Pendant",
  "quest.0E8B294D9372E88A.quest_subtitle": "Your favorite potion, on a drip.",
  "quest.0E8B294D9372E88A.quest_desc": [
    "[\"\",{\"text\":\"The Invigorating Pendant's recipe with Garmonbozia in the middle. Load a potion into the \"},{\"text\":\"Primed Pendant\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:primed_pendant\",\"count\":1}}},{\"text\":\" and, carried, it keeps that effect on you for as long as its blood lasts; stronger effects cost more.\"}]"
  ],
  "quest.11526DB1D54E7597.title": "Effortless Ring",
  "quest.11526DB1D54E7597.quest_subtitle": "Stairs are for other people.",
  "quest.11526DB1D54E7597.quest_desc": [
    "[\"\",{\"text\":\"A Promise of Velocity, a Promise of Productivity, gold and iron. Carried, the \"},{\"text\":\"Effortless Ring\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:effortless_ring\",\"count\":1}}},{\"text\":\" lets you walk faster, jump higher and farther, step up full blocks and land a little softer, and it drinks no blood at all.\"}]"
  ],
  "quest.27FFB9FB26490BDB.title": "No act for the broom",
  "quest.27FFB9FB26490BDB.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"EvilCraft's own recipes wait for no act in this pack, so a broom flies as soon as you can fill it. The jetpacks wait for act III and the Rending Gale for act IV.\"}]"
  ],
  "quest.3391117C032001D3.title": "Tune the broom",
  "quest.3391117C032001D3.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A broom crafted with an item gains a modifier for good: redstone for speed, coal for acceleration, glowstone for turning, feathers for climb, blaze powder to set rammed mobs alight, a pickaxe to smash through blocks. A Nether Star or Garmonbozia adds a modifier slot.\"}]"
  ],
  "quest.5F54C8D037AD7D5C.title": "Vein Sword",
  "quest.5F54C8D037AD7D5C.quest_subtitle": "It doesn't cut deep. It cuts wet.",
  "quest.5F54C8D037AD7D5C.quest_desc": [
    "[\"\",{\"text\":\"Two Dark Power Gems, a Dark Stick and two Spikes. The \"},{\"text\":\"Vein Sword\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:vein_sword\",\"count\":1}}},{\"text\":\" comes with Looting II and doubles the blood your \"},{\"text\":\"Blood Extractors\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"063626A177E886C8\"}},{\"text\":\" collect from every kill made with it in hand. Its gold edge is fragile: 32 hits, so keep a Blood Chest nearby.\"}]"
  ],
  "quest.1720221FD539D4BE.title": "Mace of Distortion",
  "quest.1720221FD539D4BE.quest_subtitle": "Personal space, enforced.",
  "quest.1720221FD539D4BE.quest_desc": [
    "[\"\",{\"text\":\"Two Dark Power Gems, an \"},{\"text\":\"Empowered Inverted Potentia\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"38D504698812501C\"}},{\"text\":\" and two Dark Sticks. Hold use to charge a sphere around you and let go to throw back and hurt everything inside it. \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and use cycles five power levels: more damage, more blood. It holds four buckets.\"}]"
  ],
  "quest.5680508F4F1D9E9F.title": "Necromancer Staff",
  "quest.5680508F4F1D9E9F.quest_subtitle": "Zombies, on loan.",
  "quest.5680508F4F1D9E9F.quest_desc": [
    "[\"\",{\"text\":\"Two Dark Power Gems, any mob head, two Spikes, an Empowered Inverted Potentia and a Dark Stick. Use the \"},{\"text\":\"Necromancer Staff\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:necromancer_staff\",\"count\":1}}},{\"text\":\" and zombies rise to attack whatever you target, for a while. Each call costs two of its ten buckets.\"}]"
  ],
  "quest.2039C21DAA25C10D.title": "Mace of Destruction",
  "quest.2039C21DAA25C10D.quest_subtitle": "Distortion's louder sibling.",
  "quest.2039C21DAA25C10D.quest_desc": [
    "[\"\",{\"text\":\"The Mace of Distortion's recipe with \"},{\"text\":\"Garmonbozia\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"31722D0E2BBEF367\"}},{\"text\":\" in place of the power gems. Its release is an explosion instead of a push: the longer the charge, the bigger the blast, and every power level starts it bigger.\"}]"
  ],
  "quest.71FEBCF88B291853.title": "Master Distorter",
  "quest.71FEBCF88B291853.quest_subtitle": "Ten is a crowd.",
  "quest.71FEBCF88B291853.quest_desc": [
    "Ten mobs thrown back in a single release. The higher the power level, the harder the push and the thirstier the mace."
  ],
  "reward.4314675132B0014B.title": "Secret found",
  "quest.533F15FB4123F14E.title": "Spirit protection",
  "quest.533F15FB4123F14E.quest_subtitle": "Ghosts hate endings. And fire.",
  "quest.533F15FB4123F14E.quest_desc": [
    "[\"\",{\"text\":\"Smelt a Dark Block into a \"},{\"text\":\"Burning Gemstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:burning_gem_stone\",\"count\":1}}},{\"text\":\": carried, it turns each spirit's hit into hunger, 64 hits per stone. With a Dark Stick it makes four \"},{\"text\":\"Gemstone Torches\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:gem_stone_torch\",\"count\":1}}},{\"text\":\"; no spirit is born within fifteen blocks of one.\"}]",
    "{@pagebreak}",
    "Spirits born elsewhere still wander in, so wall the place off."
  ],
  "quest.60704D6563FE56FE.title": "Vengeance Pickaxe",
  "quest.60704D6563FE56FE.quest_subtitle": "Fortune favors the haunted.",
  "quest.60704D6563FE56FE.quest_desc": [
    "[\"\",{\"text\":\"Three diamonds, two Hardened Blood Shards and two Dark Sticks. The \"},{\"text\":\"Vengeance Pickaxe\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:vengeance_pickaxe\",\"count\":1}}},{\"text\":\" comes with Fortune V and Curse of Vengeance III: it digs a quarter faster than diamond, spirits gather while you use it, and the Purifier won't touch this curse.\"}]"
  ],
  "quest.7B702615C979002F.title": "Spirit-killing 101",
  "quest.7B702615C979002F.quest_subtitle": "They fear endings. Bring one.",
  "quest.7B702615C979002F.quest_desc": [
    "[\"\",{\"text\":\"Two filled Blood Orbs, four End Crystals and two Popped Chorus Fruit around the Vengeance Focus make the \"},{\"text\":\"Piercing Vengeance Focus\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:piercing_vengeance_focus\",\"count\":1}}},{\"text\":\", whose beam hurts spirits. A spirit killed with it drops a \"},{\"text\":\"Vengeance Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:vengeance_essence\",\"count\":1}}},{\"text\":\" and whatever its mob would have dropped.\"}]"
  ],
  "quest.31722D0E2BBEF367.title": "Garmonbozia",
  "quest.31722D0E2BBEF367.quest_subtitle": "Pain and sorrow, served as creamed corn.",
  "quest.31722D0E2BBEF367.quest_desc": [
    "[\"\",{\"text\":\"Eight Crushed Dark Gems around a Vengeance Essence materialize it; the infuser at tier 3 pours fifty buckets into that for \"},{\"text\":\"Garmonbozia\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:garmonbozia\",\"count\":1}}},{\"text\":\". It adds a slot to a broom and goes into the Mace of Destruction, the Primed Pendant, Spectral Glasses, Rejuvenated Flesh and the home accumulator.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A master \"},{\"text\":\"Werewolvian\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2B529AB6EBE14361\"}},{\"text\":\" sells it for ten emeralds.\"}]"
  ],
  "quest.73AB1A037D478AA7.title": "Glasses and endless flesh",
  "quest.73AB1A037D478AA7.quest_subtitle": "See them first. Eat later.",
  "quest.73AB1A037D478AA7.quest_desc": [
    "[\"\",{\"text\":\"Two Vengeance Rings and Garmonbozia make \"},{\"text\":\"Spectral Glasses\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:spectral_glasses\",\"count\":1}}},{\"text\":\": carried, they show every spirit without it noticing you, unless it was already after you. Werewolf or humanoid flesh with Garmonbozia makes \"},{\"text\":\"Rejuvenated Flesh\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:flesh_rejuvenated\",\"count\":1}}},{\"text\":\", a meal that never runs out while it has blood.\"}]"
  ],
  "quest.06763A6655A282B2.title": "Spirits into spawn eggs",
  "quest.06763A6655A282B2.quest_subtitle": "The spirit gets a body. Briefly.",
  "quest.06763A6655A282B2.quest_desc": [
    "[\"\",{\"text\":\"Cobblestone, iron, an iron block and a core. Give the \"},{\"text\":\"Spirit Reanimator\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"evilcraft:spirit_reanimator\",\"count\":1}}},{\"text\":\" a boxed spirit, an egg and two and a half buckets: out comes that mob's spawn egg. The spirit is spent and the box empties; a mob with no spawn egg can't come back.\"}]"
  ],
  "quest.3509EB58F98E4447.title": "A new box isn't empty",
  "quest.3509EB58F98E4447.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A crafted box comes with a swarm of vengeance inside, and so do half the boxes found in chests. Opening it lets the swarm out and after you; a \"},{\"text\":\"Burning Gemstone\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"533F15FB4123F14E\"}},{\"text\":\" turns its hit into hunger. Then the box waits, open, for your spirit.\"}]",
    "{@pagebreak}",
    "The other half of the found boxes hold the spirit of a real player. Cooked, it gives up that player's head and a drop of its own."
  ],
  "image.4709AE87C3BA896D.title": "[\"\",{\"text\":\"A strange new world\",\"color\":\"#FF7A7A\"}]",
  "image.2A8EE1FE7FCE31CF.title": "[\"\",{\"text\":\"The workshop\",\"color\":\"#FF7A7A\"}]",
  "image.1E259A096DA3D4EF.title": "[\"\",{\"text\":\"Dark Temples\",\"color\":\"#FF7A7A\"}]",
  "image.72B77E211B5D5223.title": "[\"\",{\"text\":\"Blood machinery\",\"color\":\"#FF7A7A\"}]",
  "image.4E5682EAE12EAC9E.title": "[\"\",{\"text\":\"Weapons\",\"color\":\"#FF7A7A\"}]",
  "image.69B859CD3F4E86CD.title": "[\"\",{\"text\":\"Promises\",\"color\":\"#FF7A7A\"}]",
  "image.43D2D7FBCD0812EC.title": "[\"\",{\"text\":\"Pendants and rings\",\"color\":\"#FF7A7A\"}]",
  "image.0610922BFFD67A13.title": "[\"\",{\"text\":\"After death\",\"color\":\"#FF7A7A\"}]",
  "image.785A1EBE5415C114.title": "[\"\",{\"text\":\"EvilCraft\",\"color\":\"#F3EEDF\",\"bold\":true}]",
  "image.4911CC3ED07B88DD.title": "[\"\",{\"text\":\"blood · spirits · closure\",\"color\":\"#E8A0A8\",\"font\":\"minecraft:alt\"}]",
  "image.62FDA1A96523EA0B.title": "Back to the Sun of Heliodor",
  "chapter.618DE437ED55A7C4.title": "Iron's Spells 'n Spellbooks",
  "chapter.618DE437ED55A7C4.chapter_subtitle": [
    "Nine schools around one table: scrolls, spell books, ink, the forge, the cauldron and the robes that carry your mana."
  ],
  "quest.5300AB8C0C6E4322.title": "The Inscription Table",
  "quest.5300AB8C0C6E4322.quest_subtitle": "A desk for spells, not homework.",
  "quest.5300AB8C0C6E4322.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A book on three wooden slabs and two fences.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Set a spell book and a scroll on it and the spell moves into the book.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Take the scroll back out later and the spell leaves the book, the scroll whole again.\"}]"
  ],
  "quest.310C86E24A1949F0.title": "Don't read that scroll",
  "quest.310C86E24A1949F0.quest_subtitle": "The urge is strong. Resist.",
  "quest.310C86E24A1949F0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Spellcasters drop scrolls and magic chests hide them, each holding one spell at a fixed level.\"}]",
    "",
    "Reading one casts it once, with no mana or cooldown, and burns the page. Inscribed into a book, it casts for good."
  ],
  "quest.5874FEF7661D32F2.title": "Common Ink",
  "quest.5874FEF7661D32F2.quest_subtitle": "Cheap, plentiful and very sticky.",
  "quest.5874FEF7661D32F2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Spellcasters drop it, magic chests keep it and the \"},{\"translate\":\"entity.minecraft.wandering_trader\",\"color\":\"#8FD6C8\"},{\"text\":\" sells it.\"}]",
    "",
    "Ink sets a scroll's rarity: common writes a spell's lowest levels, legendary its highest."
  ],
  "task.1891A0DBA205CAC7.title": "Wear it in the Spell Book slot",
  "quest.5B5796E05B4E5718.title": "A book to write in",
  "quest.5B5796E05B4E5718.quest_subtitle": "Flimsy by name, flimsy by nature.",
  "quest.5B5796E05B4E5718.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two copper ingots, a string and six paper: the \"},{\"text\":\"Flimsy Journal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:copper_spell_book\",\"count\":1}}},{\"text\":\", five spell slots.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"It goes in the Spell Book slot of your curios.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Worn there, its spells fill the spell wheel.\"}]"
  ],
  "quest.0F2BD1F9BD1B43E6.title": "The wheel, then cast",
  "quest.0F2BD1F9BD1B43E6.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Hold \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.irons_spellbooks.spell_wheel\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and pick a spell, then press \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.irons_spellbooks.spellbook_cast\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" to cast it. Fifteen quick-cast slots come unbound under Controls: give your favourite spells a key each.\"}]"
  ],
  "quest.010419F8C02E30ED.title": "A mana bar of its own",
  "quest.010419F8C02E30ED.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Iron's mana is its own bar, \"},{\"text\":\"100\",\"color\":\"#8EC8FF\"},{\"text\":\" to start and apart from Ars's. Robes, rings and books raise it, and the Ark's \"},{\"text\":\"Arcane Module\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4BCEABDD4D9E618C\"}},{\"text\":\" adds half again to every magic that shows mana, this one included.\"}]"
  ],
  "quest.2DA843F392A3C84D.title": "Arcane Essence",
  "quest.2DA843F392A3C84D.quest_subtitle": "Magic dust, sold by the pinch.",
  "quest.2DA843F392A3C84D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Magic chests and spellcasters drop it, and the Dead King by the fistful.\"}]",
    "",
    "It sews robes, forges ingots, fills jars and tips staffs: keep a stack on you."
  ],
  "quest.6630614DD62181BF.title": "Arcane Cloth",
  "quest.6630614DD62181BF.quest_subtitle": "Wool that went to wizard school.",
  "quest.6630614DD62181BF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight \"},{\"text\":\"Arcane Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:arcane_essence\",\"count\":1}}},{\"text\":\" around any wool.\"}]",
    "",
    "Every robe from here on is cut from it, and the better spell books bind it into their covers."
  ],
  "quest.241F2B077C534AE0.title": "Blank Runestone",
  "quest.241F2B077C534AE0.quest_subtitle": "A rock with potential.",
  "quest.241F2B077C534AE0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Magic chests, vaults and catacomb walls hide them.\"}]",
    "",
    "Eight of a school's focus around one make that school's rune, and a rune turns a plain wizard piece into school armour.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Each piece of school armour is the matching wizard piece, the rune and one \"},{\"text\":\"Arcane Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:arcane_essence\",\"count\":1}}},{\"text\":\", at a crafting table or at a smithing table with the rune as template.\"}]",
    "",
    "[\"\",{\"text\":\"Every piece gives \"},{\"text\":\"125\",\"color\":\"#8EC8FF\"},{\"text\":\" max mana, \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" power in its school and \"},{\"text\":\"5%\",\"color\":\"#8EC8FF\"},{\"text\":\" spell power.\"}]"
  ],
  "task.3BEF209EA9D4C48E.title": "Iron's Guidebook",
  "quest.1588F3F9DFC9186D.title": "The mod's own manual",
  "quest.1588F3F9DFC9186D.quest_subtitle": "Read the instructions. They have pictures.",
  "quest.1588F3F9DFC9186D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A book and one \"},{\"text\":\"Arcane Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:arcane_essence\",\"count\":1}}},{\"text\":\" make Iron's Guidebook.\"}]",
    "",
    "It covers early, mid and late game, the nine schools, ink and every craftable book, recipes included."
  ],
  "quest.373EA23A6D7071EA.title": "The Ironbound Tome",
  "quest.373EA23A6D7071EA.quest_subtitle": "Chains included. Mercifully.",
  "quest.373EA23A6D7071EA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three chains, four leather and two paper: six slots to the journal's five.\"}]",
    "",
    "To move house, pull each scroll out of the old book at the Inscription Table and write it into the new one."
  ],
  "quest.121B4A64A0030D29.title": "Hogskin",
  "quest.121B4A64A0030D29.quest_subtitle": "The hoglin disagreed.",
  "quest.121B4A64A0030D29.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Hoglins drop it in the Crimson Forest.\"}]",
    "",
    "Both better books ask for it, and the Lesser Spell Slot Improvement eats six later.",
    "",
    "Four spare hides craft back into four leather."
  ],
  "quest.597CF7E4B465F18F.title": "The Apprentice's Spell Book",
  "quest.597CF7E4B465F18F.quest_subtitle": "Gold trim for a promising student.",
  "quest.597CF7E4B465F18F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three gold ingots, four Arcane Essence and two Hogskin:\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Eight slots\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"+\"},{\"text\":\"50\",\"color\":\"#8EC8FF\"},{\"text\":\" max mana\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"15%\",\"color\":\"#8EC8FF\"},{\"text\":\" shorter cast times\"}]",
    "",
    "The first book with bonuses of its own."
  ],
  "quest.4E40FFE6E511D3CC.title": "Read the book, not the cover",
  "quest.4E40FFE6E511D3CC.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Found books carry fixed bonuses, and not all of them are gifts: the \"},{\"text\":\"Rotten Spell Book\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:rotten_spell_book\",\"count\":1}}},{\"text\":\" adds \"},{\"text\":\"100\",\"color\":\"#8EC8FF\"},{\"text\":\" mana but takes \"},{\"text\":\"15%\",\"color\":\"#8EC8FF\"},{\"text\":\" spell resistance. Hover a book before you swap: the tooltip lists slots, mana and every bonus.\"}]"
  ],
  "quest.3C1E081D38A18B38.title": "The Enchanted Spell Book",
  "quest.3C1E081D38A18B38.quest_subtitle": "Ten slots and a cover that hums.",
  "quest.3C1E081D38A18B38.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two diamonds, four Hogskin, two Arcane Cloth and an enchanted book: ten slots and +\"},{\"text\":\"100\",\"color\":\"#8EC8FF\"},{\"text\":\" max mana.\"}]",
    "",
    "Fill it at the Inscription Table with scrolls you forged yourself.",
    "{@pagebreak}",
    "A good first page: one spell that hits hard, one that moves you, one that saves you, one that heals, and one from a school you haven't tried yet.",
    "",
    "[\"\",{\"text\":\"Its spine reads \"},{\"text\":\"scribo ergo sum\",\"color\":\"#B98CFF\",\"font\":\"minecraft:alt\"},{\"text\":\". The book agrees.\"}]"
  ],
  "quest.63517637E8CE5A1E.title": "The Scroll Forge",
  "quest.63517637E8CE5A1E.quest_subtitle": "Goodbye, loot lottery.",
  "quest.63517637E8CE5A1E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three polished deepslate over four crying obsidian.\"}]",
    "",
    "Feed it ink, paper and a school's focus, then pick the spell: the ink sets the rarity, the focus the school.",
    "",
    "You write what you want instead of hoping for it."
  ],
  "quest.2D9931B075D2E8A5.title": "The trader deals in magic",
  "quest.2D9931B075D2E8A5.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Here the \"},{\"translate\":\"entity.minecraft.wandering_trader\",\"color\":\"#8FD6C8\"},{\"text\":\" sells scrolls, ink and bundles of mystery scrolls, buys spare ink for emeralds or essence, and now and then carries a ring or an amulet. Check every one that wanders by.\"}]"
  ],
  "task.76D632E831E810D8.title": "Defeat an Ancient Knight",
  "quest.0F5261E364129735.title": "Cinder Essence",
  "quest.0F5261E364129735.quest_subtitle": "Knights in rusty armour.",
  "quest.0F5261E364129735.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Break an Armor Pile and an Ancient Knight climbs out.\"}]",
    "",
    "Piles stand in the Nether's citadels and battlegrounds, or in a Pyromancer Tower.",
    "",
    "[\"\",{\"text\":\"Killed by a player it always drops one \"},{\"text\":\"Cinder Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:cinder_essence\",\"count\":1}}},{\"text\":\", and one time in eight a netherite scrap.\"}]"
  ],
  "quest.685ED6CB1E5B9681.title": "The Alchemist Cauldron",
  "quest.685ED6CB1E5B9681.quest_subtitle": "Double, double, ink and trouble.",
  "quest.685ED6CB1E5B9681.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four iron ingots around a cauldron, two Arcane Essence and one Cinder Essence.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"It brews ink up the ladder, elixirs from potions and blood from mobs.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Bottles fill it and empty it, \"},{\"text\":\"250\",\"color\":\"#8EC8FF\"},{\"text\":\" mB at a time.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A swamp Mangrove Hut has one standing inside, and mining it drops the cauldron whole.\"}]"
  ],
  "quest.0A8DC93283501E75.title": "Scrolls you don't want",
  "quest.0A8DC93283501E75.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Drop an unwanted scroll into an Alchemist Cauldron holding water: half the time it dissolves into a bottle's worth of ink of its rarity. Duplicate loot becomes forge fuel.\"}]"
  ],
  "quest.673162D9FF069DE3.title": "Three elixirs",
  "quest.673162D9FF069DE3.quest_subtitle": "Tastes like a fight you already won.",
  "quest.673162D9FF069DE3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Potions in, elixirs out: the cauldron does the rest.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Oakskin: Strong Healing and an oak log\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Evasion: Mana III and an ender pearl\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Invisibility: long Invisibility and a Shriving Stone\"}]",
    "",
    "Amethyst or dragon's breath brews the greater ones."
  ],
  "quest.05BD517A1BB294A7.title": "Uncommon Ink",
  "quest.05BD517A1BB294A7.quest_subtitle": "Four bottles in, one bottle out.",
  "quest.05BD517A1BB294A7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Every step up the ladder costs four of the ink below.\"}]",
    "",
    "[\"\",{\"text\":\"In the Alchemist Cauldron, \"},{\"text\":\"1000\",\"color\":\"#8EC8FF\"},{\"text\":\" mB of Common Ink (four bottles) and a copper ingot brew one bottle of Uncommon.\"}]"
  ],
  "quest.2AFCDCE41D624416.title": "Rare Ink",
  "quest.2AFCDCE41D624416.quest_subtitle": "Rare, in theory.",
  "quest.2AFCDCE41D624416.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four bottles of Uncommon and an iron ingot.\"}]",
    "",
    "Wizards and magic chests hand it out often enough that brewing it is rarely the fast way."
  ],
  "quest.2D00795A42C7A800.title": "Epic Ink",
  "quest.2D00795A42C7A800.quest_subtitle": "Sixty-four commons walk into a cauldron.",
  "quest.2D00795A42C7A800.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four bottles of Rare and a gold ingot, or loot.\"}]",
    "",
    "Boss vaults pay in rare to legendary ink, and an Icebreaker captain keeps a bottle.",
    "",
    "[\"\",{\"text\":\"Brewed from the bottom, each costs \"},{\"text\":\"64\",\"color\":\"#8EC8FF\"},{\"text\":\" Common Ink.\"}]"
  ],
  "task.2CDF850A88EC6027.title": "Brew a Potion of Mana",
  "quest.28B4C01DBB923BB8.title": "Liquid patience",
  "quest.28B4C01DBB923BB8.quest_subtitle": "Tastes like blue.",
  "quest.28B4C01DBB923BB8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A bottle of mana is one brew away.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"An Awkward Potion and one Arcane Essence brew a Potion of Mana in a plain brewing stand.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Glowstone dust, then an amethyst shard, then a cluster take it up to IV.\"}]",
    "",
    "[\"\",{\"text\":\"Each level refills \"},{\"text\":\"25\",\"color\":\"#8EC8FF\"},{\"text\":\" mana plus \"},{\"text\":\"5%\",\"color\":\"#8EC8FF\"},{\"text\":\" of your maximum.\"}]"
  ],
  "quest.4C06C356143F7FEC.title": "The Wandering Magician",
  "quest.4C06C356143F7FEC.quest_subtitle": "Leather, but make it mystical.",
  "quest.4C06C356143F7FEC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Each piece of leather armour plus one Arcane Essence, shapeless.\"}]",
    "",
    "[\"\",{\"text\":\"25\",\"color\":\"#8EC8FF\"},{\"text\":\" max mana per piece: small, but it's the first mana you can wear.\"}]"
  ],
  "quest.237C28464BF31110.title": "The Scarecrow",
  "quest.237C28464BF31110.quest_subtitle": "Crows hate it. Zombies don't care.",
  "quest.237C28464BF31110.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Arcane Cloth sewn onto hay bales, leather and a carved pumpkin over a leather cap.\"}]",
    "",
    "[\"\",{\"text\":\"75\",\"color\":\"#8EC8FF\"},{\"text\":\" max mana per piece, three times the Wandering Magician's.\"}]"
  ],
  "quest.4C06564A76AECE57.title": "Wizard robes",
  "quest.4C06564A76AECE57.quest_subtitle": "The pointy hat is optional. Mostly.",
  "quest.4C06564A76AECE57.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Pure Arcane Cloth: robes, leggings, boots and a hood or a pointy hat.\"}]",
    "",
    "[\"\",{\"text\":\"Each piece adds \"},{\"text\":\"125\",\"color\":\"#8EC8FF\"},{\"text\":\" max mana and \"},{\"text\":\"5%\",\"color\":\"#8EC8FF\"},{\"text\":\" spell power, and each is the blank that a rune turns into school armour.\"}]"
  ],
  "quest.73227953D2C9A615.title": "Essence for the archive",
  "quest.73227953D2C9A615.quest_subtitle": "Every library runs on donations.",
  "quest.73227953D2C9A615.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Thirty-two \"},{\"text\":\"Arcane Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:arcane_essence\",\"count\":1}}},{\"text\":\" for the common store, once a day.\"}]",
    "",
    "One Dead King covers it with change to spare."
  ],
  "quest.0672E75E2444ABC8.title": "The Graybeard Staff",
  "quest.0672E75E2444ABC8.quest_subtitle": "The beard is optional.",
  "quest.0672E75E2444ABC8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A wooden shovel, an iron ingot and one Arcane Essence.\"}]",
    "",
    "[\"\",{\"text\":\"Right-click casts your selected spell straight from the staff, and holding it adds \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" spell power and \"},{\"text\":\"25%\",\"color\":\"#8EC8FF\"},{\"text\":\" mana regeneration.\"}]"
  ],
  "quest.74FF66CA0E7C2F2B.title": "The Artificer's Cane",
  "quest.74FF66CA0E7C2F2B.quest_subtitle": "Wizardry, but make it dapper.",
  "quest.74FF66CA0E7C2F2B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three crimson planks, two gold ingots and an amethyst shard.\"}]",
    "",
    "[\"\",{\"text\":\"It trades the staff's mana regeneration for \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" shorter cast times and \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" shorter cooldowns, on top of \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" spell power.\"}]"
  ],
  "quest.0B4F37178C16F430.title": "School of Fire",
  "quest.0B4F37178C16F430.quest_subtitle": "Hot takes only.",
  "quest.0B4F37178C16F430.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Damage now and burning after.\"}]",
    "",
    "Its focus is the Blaze Rod: one in the forge writes a fire scroll, eight around a Blank Runestone make the Fire Rune.",
    "",
    "The Pyromancer sells fire scrolls in his tower."
  ],
  "quest.5D9708BE379038AC.title": "School of Lightning",
  "quest.5D9708BE379038AC.quest_subtitle": "Bottled at the source.",
  "quest.5D9708BE379038AC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Concentrated damage that jumps between targets.\"}]",
    "",
    "[\"\",{\"text\":\"Its focus, the \"},{\"text\":\"Bottle o' Lightning\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:lightning_bottle\",\"count\":1}}},{\"text\":\", is an empty bottle used on a charged creeper: wait for a storm and bring a trident with Channeling.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Here lightning heals a creeper and makes it fireproof, so the charged one survives to be bottled.\"}]"
  ],
  "quest.149AD2EC3FEA6650.title": "School of Ender",
  "quest.149AD2EC3FEA6650.quest_subtitle": "Arcane, mystic, occasionally rude.",
  "quest.149AD2EC3FEA6650.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Damage, utility and movement in one school:\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Magic Missile\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Teleport\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Counterspell\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Portal\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"A Black Hole\"}]",
    "",
    "Its focus is the Ender Pearl, the easiest focus to farm."
  ],
  "quest.549DE42C4E2EA1AF.title": "School of Evocation",
  "quest.549DE42C4E2EA1AF.quest_subtitle": "Illager tricks, legally obtained.",
  "quest.549DE42C4E2EA1AF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Trickery and conjuring: the widest spread of any school.\"}]",
    "",
    "Fangs, vexes, a spectral steed, shields and invisibility.",
    "",
    "Its focus is the Emerald, and an Archevoker drops its rune half the time."
  ],
  "quest.16AAAB0D7E1898FC.title": "School of Holy",
  "quest.16AAAB0D7E1898FC.quest_subtitle": "Heals, buffs, smites. Mostly heals.",
  "quest.16AAAB0D7E1898FC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Support first: healing, buffs for allies and a little smiting.\"}]",
    "",
    "[\"\",{\"text\":\"Its focus, the \"},{\"text\":\"Divine Pearl\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:divine_pearl\",\"count\":1}}},{\"text\":\", is one gold ingot and one amethyst shard, shapeless.\"}]"
  ],
  "quest.3B82220E97B79356.title": "The Eldritch school",
  "quest.3B82220E97B79356.quest_subtitle": "Forgotten for a reason.",
  "quest.3B82220E97B79356.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Nobody starts with it.\"}]",
    "",
    "[\"\",{\"text\":\"Eight \"},{\"text\":\"Ancient Knowledge Fragments\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:ancient_knowledge_fragment\",\"count\":1}}},{\"text\":\" around an echo shard restore a manuscript; using it teaches one Eldritch spell, and from then on the echo shard is the school's focus.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Fragments turn up in Ancient Cities, End cities, stronghold libraries and boss vaults.\"}]"
  ],
  "quest.38E649B2924F1E95.title": "School of Blood",
  "quest.38E649B2924F1E95.quest_subtitle": "It's not a phase.",
  "quest.38E649B2924F1E95.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Necromancy, wither and life-stealing damage.\"}]",
    "",
    "[\"\",{\"text\":\"Its focus, the \"},{\"text\":\"Blood Vial\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:blood_vial\",\"count\":1}}},{\"text\":\", comes from a cauldron over a lit campfire: mobs standing in it cook into blood you can bottle.\"}]"
  ],
  "quest.50F2031A01160D47.title": "School of Nature",
  "quest.50F2031A01160D47.quest_subtitle": "Grown locally, poisonous globally.",
  "quest.50F2031A01160D47.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Debuffs first, then damage to finish: poison, roots, acid, a stomp.\"}]",
    "",
    "Its focus is the Poisonous Potato, and eight plain potatoes around one make four."
  ],
  "quest.4796CEA3BD858B10.title": "School of Ice",
  "quest.4796CEA3BD858B10.quest_subtitle": "Chill. Literally.",
  "quest.4796CEA3BD858B10.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Damage and crowd control: freezing rays, ice tombs, a polar bear.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:frozen_bone\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Its focus is the \"},{\"text\":\"Frozen Bone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:frozen_bone\",\"count\":1}}},{\"text\":\", dropped by a \"},{\"translate\":\"entity.minecraft.stray\",\"color\":\"#8FD6C8\"},{\"text\":\" in the snow.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"The Cryomancer in his mountain tower sells ice scrolls.\"}]"
  ],
  "quest.115FD59DCE962219.title": "Pyromancer robes",
  "quest.115FD59DCE962219.quest_subtitle": "Dress for the job you want.",
  "quest.115FD59DCE962219.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight Blaze Rods around a Blank Runestone make the Fire Rune.\"}]",
    "",
    "[\"\",{\"text\":\"Each wizard piece it touches becomes Pyromancer: +\"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" fire power apiece.\"}]",
    "",
    "Keep the robe; late on it becomes the Infernal Sorcerer's chestplate."
  ],
  "quest.3C5E14957C2B2FD4.title": "Electromancer robes",
  "quest.3C5E14957C2B2FD4.quest_subtitle": "The hairdo is included. Upright.",
  "quest.3C5E14957C2B2FD4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight Bottles o' Lightning make the Lightning Rune, and each Electromancer piece adds \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" lightning power.\"}]",
    "",
    "Eight bottles means eight charged creepers: collect them in one long thunderstorm."
  ],
  "quest.67357F1DEA4D674E.title": "Shadow-Walker armour",
  "quest.67357F1DEA4D674E.quest_subtitle": "Lurking is a lifestyle.",
  "quest.67357F1DEA4D674E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight Ender Pearls make the Ender Rune, and each Shadow-Walker piece adds \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" ender power.\"}]",
    "",
    "[\"\",{\"text\":\"The Dragonskin Spell Book adds another \"},{\"text\":\"10\",\"color\":\"#8EC8FF\"},{\"text\":\" on top, if you ever meet a dragon.\"}]"
  ],
  "quest.1A3FE40267096C8E.title": "Archevoker coat",
  "quest.1A3FE40267096C8E.quest_subtitle": "Stolen fashion is still fashion.",
  "quest.1A3FE40267096C8E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight Emeralds make the Evocation Rune, unless an Archevoker drops one first.\"}]",
    "",
    "[\"\",{\"text\":\"Each piece adds \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" evocation power, and the boots are the base of the Boots of Speed.\"}]"
  ],
  "quest.58A0A148F65AEB00.title": "Priest robes",
  "quest.58A0A148F65AEB00.quest_subtitle": "Vows optional.",
  "quest.58A0A148F65AEB00.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight Divine Pearls make the Holy Rune.\"}]",
    "",
    "[\"\",{\"text\":\"Each Priest piece adds \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" holy power, and the robes are the base of the Lightbringer Chestplate later on.\"}]"
  ],
  "quest.0CB62D92B5694C3F.title": "Cultist armour",
  "quest.0CB62D92B5694C3F.quest_subtitle": "Membership has its privileges.",
  "quest.0CB62D92B5694C3F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight Blood Vials make the Blood Rune: park a cauldron over a campfire next to a mob farm.\"}]",
    "",
    "[\"\",{\"text\":\"Each Cultist piece adds \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" blood power.\"}]"
  ],
  "quest.35B78B120361E1C1.title": "Plagued armour",
  "quest.35B78B120361E1C1.quest_subtitle": "Smells like victory. And rot.",
  "quest.35B78B120361E1C1.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight Poisonous Potatoes make the Nature Rune.\"}]",
    "",
    "[\"\",{\"text\":\"Each Plagued piece adds \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" nature power.\"}]",
    "",
    "One rune with a Mithril Scrap later makes a Poisonward Ring."
  ],
  "quest.1584DCF89D376C8B.title": "Cryomancer coat",
  "quest.1584DCF89D376C8B.quest_subtitle": "Cold shoulders, warm heart.",
  "quest.1584DCF89D376C8B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight Frozen Bones make the Ice Rune, and each Cryomancer piece adds \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" ice power.\"}]",
    "",
    "[\"\",{\"text\":\"The Frostbranded Book adds another \"},{\"text\":\"10\",\"color\":\"#8EC8FF\"},{\"text\":\" once you've met the Ice Spider.\"}]"
  ],
  "quest.5E4295CD5E030CFF.title": "Mind the wizard's chests",
  "quest.5E4295CD5E030CFF.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Nearly every Iron's structure keeps an Inscription Table, and wizards guard the chests and barrels around them. Open one while its owner is there and the trader becomes a fight: shop first, loot later.\"}]"
  ],
  "task.24BBF85D0C5C8CF1.title": "Find a Pyromancer Tower",
  "task.54695E94C12BE681.title": "Meet the Pyromancer",
  "quest.3789FDF73666994F.title": "The Pyromancer Tower",
  "quest.3789FDF73666994F.quest_subtitle": "Knock. He's armed.",
  "quest.3789FDF73666994F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A stone tower in hills, forests, plains and swamps.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"The Pyromancer inside sells fire scrolls and buys ink.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"His casks keep Fire Ale, which grants Fire Resistance and Haste for \"},{\"text\":\"45\",\"color\":\"#8EC8FF\"},{\"text\":\" seconds and a bit of nausea.\"}]"
  ],
  "task.10FF0027F4DDCAAB.title": "Find a Mountain Tower",
  "task.1F232EA3C6B84624.title": "Meet the Cryomancer",
  "quest.4500547D8732D2BC.title": "The Mountain Tower",
  "quest.4500547D8732D2BC.quest_subtitle": "Great view. Terrible heating.",
  "quest.4500547D8732D2BC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A lone tower on mountains and snowy plains, home of the Cryomancer, who sells ice scrolls and buys ink.\"}]",
    "",
    "His ice barrel sometimes hides a Frostward Ring or an Affinity Ring."
  ],
  "task.73D5DB32A48B01E2.title": "Find a Mangrove Hut",
  "task.426BA08A99B38EBD.title": "Meet the Apothecarist",
  "quest.7802410ECA5C97C5.title": "The Mangrove Hut",
  "quest.7802410ECA5C97C5.quest_subtitle": "Potions, no questions.",
  "quest.7802410ECA5C97C5.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A stilt hut in the swamp where the Apothecarist sells nature scrolls and elixirs.\"}]",
    "",
    "A hidden shelf keeps Netherward Tinctures: used on a hoglin or piglin, one stops it zombifying in the Overworld."
  ],
  "quest.6B13D17F2D534BDA.title": "Hogskin at home",
  "quest.6B13D17F2D534BDA.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Put a Netherward Tincture on two hoglins, bring them to the Overworld and breed them: their piglets inherit the immunity, and the pen becomes a Hogskin farm far from the Crimson Forest.\"}]"
  ],
  "task.012981119CA525A7.title": "Meet a village Priest",
  "quest.51CDF302EADF274D.title": "The village Priest",
  "quest.51CDF302EADF274D.quest_subtitle": "Tithes accepted in emeralds.",
  "quest.51CDF302EADF274D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Some villages grow a chapel with a Priest in holy robes, counted as an ally by their golems.\"}]",
    "",
    "He sells healing potions, and his chests keep Divine Pearls."
  ],
  "task.4BBA7BD650AD27EC.title": "Find an Evoker Fort",
  "task.45A62D995848628C.title": "Defeat the Archevoker",
  "quest.4F4D13E31901C04A.title": "The Evoker Fort",
  "quest.4F4D13E31901C04A.quest_subtitle": "Illager HQ. Bring friends.",
  "quest.4F4D13E31901C04A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A walled camp with an Archevoker in the back.\"}]",
    "",
    "It stands in hills, forests, deserts and plains, held by illagers, Magehunter Vindicators and the Archevoker.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"He drops an evocation scroll, ink and, half the time, an Evocation Rune.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"His logbooks explain what he came for.\"}]"
  ],
  "quest.7C4C3A9A3D74E7D4.title": "Evidence for the Priest",
  "quest.7C4C3A9A3D74E7D4.quest_subtitle": "Confession is good for the loot.",
  "quest.7C4C3A9A3D74E7D4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Turn in the proof and the Priest pays in books.\"}]",
    "",
    "[\"\",{\"text\":\"Bring a Priest the Archevoker's translated logbook from an Evoker Fort and he trades you a \"},{\"text\":\"Villager Bible\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:villager_spell_book\",\"count\":1}}},{\"text\":\":\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Ten slots\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" holy power\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" shorter casts\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"200\",\"color\":\"#8EC8FF\"},{\"text\":\" mana\"}]"
  ],
  "task.6CBDA6AD1AA699F7.title": "Find the Impaled Icebreaker",
  "quest.621FB7ED1FD9EBF0.title": "The Impaled Icebreaker",
  "quest.621FB7ED1FD9EBF0.quest_subtitle": "It did not break the ice.",
  "quest.621FB7ED1FD9EBF0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A ship run aground in frozen oceans, ice spikes and frozen peaks.\"}]",
    "",
    "Its captain's quarters always hold a Permafrost Shard, a spyglass, a bottle of Epic Ink and a bundle of emeralds."
  ],
  "quest.348AD9A4EC2BD728.title": "Furled Maps",
  "quest.348AD9A4EC2BD728.quest_subtitle": "X marks the tower.",
  "quest.348AD9A4EC2BD728.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Opened, it marks the nearest structure of its kind that nobody has explored.\"}]",
    "",
    "Found in chests, sold by traders or crafted, each points to one kind: Evoker Fort battle plans, an Arctic Expedition Route, a Legion Outpost."
  ],
  "task.7D0124B322D0E739.title": "Anger a wizard",
  "quest.1B76343F3F74B4E0.title": "A Fool's Folly",
  "quest.1B76343F3F74B4E0.quest_subtitle": "The chest was in plain sight. So were you.",
  "quest.1B76343F3F74B4E0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"You opened a chest right under a wizard's nose.\"}]",
    "",
    "He noticed."
  ],
  "reward.7C0199482B9F448D.title": "Secret found",
  "task.3A316F4B3CAF4405.title": "Find a Rotten Spell Book",
  "quest.0AE8AE8DBF5A0B43.title": "How long's this been here?",
  "quest.0AE8AE8DBF5A0B43.quest_subtitle": "Smells like a library basement.",
  "quest.0AE8AE8DBF5A0B43.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A \"},{\"text\":\"Rotten Spell Book\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:rotten_spell_book\",\"count\":1}}},{\"text\":\": eight slots and \"},{\"text\":\"100\",\"color\":\"#8EC8FF\"},{\"text\":\" mana, minus \"},{\"text\":\"15%\",\"color\":\"#8EC8FF\"},{\"text\":\" spell resistance.\"}]",
    "",
    "Catacomb coffins and old dungeon chests leave them lying around."
  ],
  "reward.1B09C8170022F2EF.title": "Secret found",
  "task.7D567C0D8937CB56.title": "Craft a Druidic Tome",
  "quest.1EF102ED5F947ACE.title": "One with Nature",
  "quest.1EF102ED5F947ACE.quest_subtitle": "Compost, but make it literature.",
  "quest.1EF102ED5F947ACE.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The rot came off: a \"},{\"text\":\"Druidic Tome\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:druidic_spell_book\",\"count\":1}}},{\"text\":\", ten slots and \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" nature power.\"}]",
    "",
    "A Rotten Spell Book, a spore blossom, an amethyst cluster, honey, glow ink and two Arcane Cloth."
  ],
  "reward.41C3C929EC20CBEB.title": "Secret found",
  "task.537FC6DB271D6B42.title": "Loot a Blaze Instruction Manual",
  "quest.79C72E8A5ADE77EC.title": "Defunct Machinery",
  "quest.79C72E8A5ADE77EC.quest_subtitle": "Warranty void if ignited.",
  "quest.79C72E8A5ADE77EC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"One blaze in a hundred carries a \"},{\"text\":\"Blaze Instruction Manual\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:blaze_spell_book\",\"count\":1}}},{\"text\":\", and yours didn't burn:\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Ten slots\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" fire power\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"200\",\"color\":\"#8EC8FF\"},{\"text\":\" mana\"}]"
  ],
  "reward.0F9231220C86439B.title": "Secret found",
  "task.6E125D3D54D54E04.title": "Loot a Grimoire of Evokation",
  "quest.5134789FE92AE19B.title": "Grimoire of Evokation",
  "quest.5134789FE92AE19B.quest_subtitle": "Some assembly required. Fangs included.",
  "quest.5134789FE92AE19B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"An Evoker or Archevoker let go of its book.\"}]",
    "",
    "[\"\",{\"text\":\"Fang Strike, Fang Ward and Summon Vex locked inside, \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" evocation power and \"},{\"text\":\"200\",\"color\":\"#8EC8FF\"},{\"text\":\" mana.\"}]",
    "",
    "About one kill in a hundred."
  ],
  "reward.27B5CB8B3C8FB4BA.title": "Secret found",
  "quest.3C1286288752D6BA.title": "Light the desk candle",
  "quest.3C1286288752D6BA.quest_subtitle": "Reading light, magic grade.",
  "quest.3C1286288752D6BA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Every scholar needs a candle.\"}]",
    "",
    "No reward: just glow."
  ],
  "quest.35C68D624E53A71A.title": "Make a wish",
  "quest.35C68D624E53A71A.quest_subtitle": "Terms and conditions apply.",
  "quest.35C68D624E53A71A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A star just fell over the schools.\"}]",
    "",
    "Nothing to craft. Just look up."
  ],
  "image.4D15D6BFB84C8D4E.title": "[\"\",{\"text\":\"IRON'S SPELLS\",\"color\":\"#F3E7C6\",\"bold\":true}]",
  "image.4850C20E2CEFC989.title": "[\"\",{\"text\":\"The sky of the schools\",\"color\":\"#AFC0FF\"}]",
  "image.37EAD02131776D12.title": "Back to the Sun of Heliodor",
  "image.4EB19D21CC30AE84.title": "On to Iron's Spells · The Arcane Anvil",
  "image.4037C6FC74183475.title": "[\"\",{\"text\":\"Mage towers\",\"color\":\"#F3E7C6\"}]",
  "image.13A65CC453C404E1.title": "[\"\",{\"text\":\"Robes and mana\",\"color\":\"#F3E7C6\"}]",
  "image.2FEDE531B6BA47B7.title": "[\"\",{\"text\":\"Alchemy\",\"color\":\"#F3E7C6\"}]",
  "image.14E53D4AC38EF0EE.title": "[\"\",{\"text\":\"Books and staves\",\"color\":\"#F3E7C6\"}]",
  "image.345730941C7BCA5F.title": "[\"\",{\"text\":\"nature\",\"color\":\"#B7E04A\"}]",
  "image.07E75EBC6D5B7081.title": "[\"\",{\"text\":\"ice\",\"color\":\"#B5E4FF\"}]",
  "image.678900E3DB45C786.title": "[\"\",{\"text\":\"holy\",\"color\":\"#FFE04A\"}]",
  "image.4E308ED44AC87803.title": "[\"\",{\"text\":\"lightning\",\"color\":\"#5C8BFF\"}]",
  "image.0938E89BF1F39BD1.title": "[\"\",{\"text\":\"fire\",\"color\":\"#FF8030\"}]",
  "image.6561465B18163B13.title": "[\"\",{\"text\":\"blood\",\"color\":\"#F0405E\"}]",
  "image.0B0D5C9F60110F18.title": "[\"\",{\"text\":\"eldritch\",\"color\":\"#29DFEB\"}]",
  "image.2E94B7B71E2095FD.title": "[\"\",{\"text\":\"ender\",\"color\":\"#A55CFF\"}]",
  "image.7EE0C4F20B272ECD.title": "[\"\",{\"text\":\"evocation\",\"color\":\"#4BD26A\"}]",
  "chapter.2AE77651E66CB572.title": "Nature's Aura",
  "chapter.2AE77651E66CB572.chapter_subtitle": [
    "Gold leaf, a ring of stands and an altar at the heart: take aura from the ground, spend it well, give it back."
  ],
  "quest.23D456E8D1488BBE.title": "The Ritual of the Forest",
  "quest.23D456E8D1488BBE.quest_subtitle": "A tree gives its life for your recipe.",
  "quest.23D456E8D1488BBE.quest_desc": [
    "[\"\",{\"text\":\"A \"},{\"text\":\"Gold Leaf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:gold_leaf\",\"count\":1}}},{\"text\":\" over any log makes a \"},{\"text\":\"Wooden Stand\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:wood_stand\",\"count\":1}}},{\"text\":\", and one leaf crushes into two \"},{\"text\":\"Gold Powder\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:gold_powder\",\"count\":1}}},{\"text\":\". Lay sixteen powder in a ring around a sapling as the book shows, put the ingredients on stands around it and let the sapling grow.\"}]",
    "{@pagebreak}",
    "When the tree grows, by time or bone meal, the ritual eats it and the result drops in the middle. Only the stands that hold an ingredient need to be there."
  ],
  "quest.1ABA937F5A5951D2.title": "The Environmental Eye",
  "quest.1ABA937F5A5951D2.quest_subtitle": "Never garden blind.",
  "quest.1ABA937F5A5951D2.quest_desc": [
    "[\"\",{\"text\":\"A ritual of a \"},{\"text\":\"Spider Eye\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:spider_eye\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Gold Ingot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:gold_ingot\",\"count\":1}}},{\"text\":\" and two \"},{\"text\":\"Gold Leaf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:gold_leaf\",\"count\":1}}},{\"text\":\" makes the \"},{\"text\":\"Environmental Eye\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:eye\",\"count\":1}}},{\"text\":\". In your hotbar it shows a bar at the top left: the aura around you, half full when the ground is untouched.\"}]",
    "{@pagebreak}",
    "Look at an aura block, such as the altar, and a second bar shows what it holds."
  ],
  "quest.0E8C5FBA5BEA7FEB.title": "Bottled air",
  "quest.0E8C5FBA5BEA7FEB.quest_subtitle": "The only souvenir that is literally air.",
  "quest.0E8C5FBA5BEA7FEB.quest_desc": [
    "[\"\",{\"text\":\"A \"},{\"text\":\"Glass Bottle\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:glass_bottle\",\"count\":1}}},{\"text\":\" and any planks make a \"},{\"text\":\"Bottle and Cork\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:bottle_two_the_rebottling\",\"count\":1}}},{\"text\":\". Use it on the air where the aura is plentiful: it takes 20,000 from the richest spot nearby and holds sunlight in the Overworld, ghosts in the Nether and darkness in the End.\"}]"
  ],
  "quest.10FCA52E96462BEC.title": "A Token of Joy",
  "quest.10FCA52E96462BEC.quest_subtitle": "Carved happiness, two per tree.",
  "quest.10FCA52E96462BEC.quest_desc": [
    "[\"\",{\"text\":\"Tokens are wooden figurines of an emotion, and nearly every device takes one. \"},{\"text\":\"Joy\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:token_joy\",\"count\":1}}},{\"text\":\" is a ritual of Bottled Sunlight, a \"},{\"text\":\"Gold Leaf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:gold_leaf\",\"count\":1}}},{\"text\":\", a small flower, an \"},{\"text\":\"Apple\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:apple\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Torch\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:torch\",\"count\":1}}},{\"text\":\" and an \"},{\"text\":\"Iron Ingot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:iron_ingot\",\"count\":1}}},{\"text\":\", and each ritual carves two.\"}]"
  ],
  "quest.45D368FDE6DD8769.title": "The Natural Altar",
  "quest.45D368FDE6DD8769.quest_subtitle": "Pillars, gold and a little patience.",
  "quest.45D368FDE6DD8769.quest_desc": [
    "[\"\",{\"text\":\"A ritual of three \"},{\"text\":\"Stone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:stone\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Gold Leaf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:gold_leaf\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Gold Ingot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:gold_ingot\",\"count\":1}}},{\"text\":\" and a \"},{\"text\":\"Token of Joy\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:token_joy\",\"count\":1}}},{\"text\":\" makes the \"},{\"text\":\"Natural Altar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:nature_altar\",\"count\":1}}},{\"text\":\". Build its structure as the book shows: four pillars and a floor, with eight \"},{\"text\":\"Golden Stone Bricks\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:gold_brick\",\"count\":1}}},{\"text\":\" (stone bricks and one Brilliant Fiber each).\"}]",
    "{@pagebreak}",
    "Complete, it draws up to 300 aura a tick from within 20 blocks and stores 500,000. It stops when the area runs empty, so on its own it never drives the ground below zero.",
    "",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"It collects Overworld and Nether aura, not the End's. In the Nether, build it with nether bricks and Golden Nether Bricks.\"}]"
  ],
  "quest.4992211AD7666DB4.title": "What the altar makes",
  "quest.4992211AD7666DB4.quest_subtitle": "Iron with a green thumb.",
  "quest.4992211AD7666DB4.quest_desc": [
    "[\"\",{\"text\":\"Set one item on the altar and wait. An \"},{\"text\":\"Iron Ingot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:iron_ingot\",\"count\":1}}},{\"text\":\" becomes \"},{\"text\":\"Infused Iron\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_iron\",\"count\":1}}},{\"text\":\" for 15,000 aura in four seconds; a \"},{\"text\":\"Gold Ingot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:gold_ingot\",\"count\":1}}},{\"text\":\" becomes \"},{\"text\":\"Tainted Gold\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:tainted_gold\",\"count\":1}}},{\"text\":\" for 3,000 in fifteen; \"},{\"text\":\"Stone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:stone\",\"count\":1}}},{\"text\":\" becomes \"},{\"text\":\"Infused Rock\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_stone\",\"count\":1}}},{\"text\":\". Blocks work too.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The altar holds one item at a time and only lets finished ones out, so a hopper above it and one below make a production line.\"}]"
  ],
  "quest.5177A56C364EFD6A.title": "Bottled ghosts",
  "quest.5177A56C364EFD6A.quest_subtitle": "Spooky, scary, and it corks.",
  "quest.5177A56C364EFD6A.quest_desc": [
    "[\"\",{\"text\":\"Take a \"},{\"text\":\"Bottle and Cork\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:bottle_two_the_rebottling\",\"count\":1}}},{\"text\":\" to the Nether and use it on the air: the aura there comes out as ghosts. Ghosts go into the Tokens of Fear and Anger and the Spirit of Calling, and the Natural Altar works in the Nether too.\"}]"
  ],
  "quest.54A733D4D80AF58D.title": "Fear and Sorrow",
  "quest.54A733D4D80AF58D.quest_subtitle": "Two moods the gods respect.",
  "quest.54A733D4D80AF58D.quest_desc": [
    "[\"\",{\"text\":\"Fear\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:token_fear\",\"count\":1}}},{\"text\":\" carves from Bottled Ghosts, a \"},{\"text\":\"Gold Leaf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:gold_leaf\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Rotten Flesh\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:rotten_flesh\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Feather\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:feather\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Bone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:bone\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Soul Sand\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:soul_sand\",\"count\":1}}},{\"text\":\". \"},{\"text\":\"Sorrow\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:token_sorrow\",\"count\":1}}},{\"text\":\" from Bottled Sunlight, a leaf, a \"},{\"text\":\"Ghast Tear\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ghast_tear\",\"count\":1}}},{\"text\":\", raw meat, glass and a fish.\"}]"
  ],
  "quest.6544882E3E98EE62.title": "The Offering Table",
  "quest.6544882E3E98EE62.quest_subtitle": "Flowers for the gods, in two rings.",
  "quest.6544882E3E98EE62.quest_desc": [
    "[\"\",{\"text\":\"Three stone, \"},{\"text\":\"Infused Iron\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_iron\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Token of Fear\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:token_fear\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Token of Sorrow\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:token_sorrow\",\"count\":1}}},{\"text\":\" and three logs make the \"},{\"text\":\"Offering Table\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:offering_table\",\"count\":1}}},{\"text\":\". Plant two rings of small flowers around it as the book shows; any small flower counts.\"}]"
  ],
  "quest.61D7D048F05DA8C6.title": "Gold that grows on trees",
  "quest.61D7D048F05DA8C6.quest_subtitle": "Money does grow on trees. You just have to ask.",
  "quest.61D7D048F05DA8C6.quest_desc": [
    "[\"\",{\"text\":\"Four leaves, four \"},{\"text\":\"Gold Nuggets\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:gold_nugget\",\"count\":1}}},{\"text\":\" and one \"},{\"text\":\"Short Grass\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:short_grass\",\"count\":1}}},{\"text\":\" make four \"},{\"text\":\"Brilliant Fiber\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:gold_fiber\",\"count\":1}}},{\"text\":\". Use one on the leaves of any tree: the gold spreads through the crown, and fully golden leaves drop \"},{\"text\":\"Gold Leaf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:gold_leaf\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.441C4201C1880A9C.title": "The Book of Natural Aura",
  "quest.441C4201C1880A9C.quest_subtitle": "A manual that grows with you.",
  "quest.441C4201C1880A9C.quest_desc": [
    "[\"\",{\"text\":\"Two \"},{\"text\":\"Paper\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:paper\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Leather\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:leather\",\"count\":1}}},{\"text\":\" and any sapling, shapeless. Its chapters open as you earn the mod's advancements: a red mark is a new chapter, an orange one your next research step, and the front page links to the advancement tab.\"}]"
  ],
  "quest.154F3AA4AAD11341.title": "Pick them ripe",
  "quest.154F3AA4AAD11341.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Golden leaves ripen through four stages and, from the third, gild a neighbouring leaf now and then. Break them only when fully gold: each then drops a \"},{\"text\":\"Gold Leaf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:gold_leaf\",\"count\":1}}},{\"text\":\" three times in four; earlier, nothing.\"}]"
  ],
  "quest.47441405B6AAB511.title": "Plants that hum",
  "quest.47441405B6AAB511.quest_subtitle": "Pressed flowers for a magical botanist.",
  "quest.47441405B6AAB511.quest_desc": [
    "[\"\",{\"text\":\"Aura Blooms\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:aura_bloom\",\"count\":1}}},{\"text\":\" grow on grass all over the Overworld, \"},{\"text\":\"Aura Cacti\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:aura_cactus\",\"count\":1}}},{\"text\":\" in sandy biomes, and \"},{\"text\":\"Crimson\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:crimson_aura_mushroom\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Warped Aura Fungi\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:warped_aura_mushroom\",\"count\":1}}},{\"text\":\" in the Nether. Every one the world generates leaves 150,000 extra aura in the ground around it.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"That makes their patches the gentlest place to fill your first bottles. The purple \"},{\"text\":\"Aura Mushroom\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:aura_mushroom\",\"count\":1}}},{\"text\":\" grows only on mushroom islands, and all of them fit in a flower pot.\"}]"
  ],
  "quest.55EDA79C71E709D6.title": "The sapling decides",
  "quest.55EDA79C71E709D6.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Each ritual names its sapling: almost all take an \"},{\"text\":\"Oak Sapling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:oak_sapling\",\"count\":1}}},{\"text\":\", but the Transmutation Catalyst and the Powder of Fertility want a \"},{\"text\":\"Jungle Sapling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:jungle_sapling\",\"count\":1}}},{\"text\":\". After the tree grows, a ritual takes ten to thirty seconds.\"}]"
  ],
  "quest.5C0DDAD164835AD4.title": "Wear it, don't hold it",
  "quest.5C0DDAD164835AD4.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Curios slots take the mod's trinkets: the Environmental Eye and Ocular a charm, the Aura Cache and Trove a belt, the Amulet of Wrath a necklace and the Ring of Last Chance a ring. Every one of them works from there.\"}]"
  ],
  "quest.09484EBB494EFD55.title": "The world is a battery",
  "quest.09484EBB494EFD55.quest_desc": [
    "Aura is not stored in nodes: it lies in the ground everywhere, a million units wherever nothing has touched it. Drains pull from the richest spot nearby and generators fill the poorest, so a drained area heals first when you add a generator.",
    "{@pagebreak}",
    "Left alone, aura drifts to even itself out. Pushed more than 150 blocks from where it was made, it slowly fizzles away."
  ],
  "quest.244FA97B79277C8B.title": "A bottle of nothing",
  "quest.244FA97B79277C8B.quest_subtitle": "Contents: absolutely nothing. Handle with care.",
  "quest.244FA97B79277C8B.quest_desc": [
    "[\"\",{\"text\":\"Where devices have dragged the aura far below empty, past what the Environmental Eye can show, a \"},{\"text\":\"Bottle and Cork\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:bottle_two_the_rebottling\",\"count\":1}}},{\"text\":\" catches a \"},{\"text\":\"Bottled Vacuum\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:vacuum_bottle\",\"count\":1}}},{\"text\":\" instead of aura. It is the heart of the Aura Imbalance Ward.\"}]"
  ],
  "quest.24CFD6B0622822C3.title": "The Aura Imbalance Ward",
  "quest.24CFD6B0622822C3.quest_subtitle": "A seatbelt for your machines.",
  "quest.24CFD6B0622822C3.quest_desc": [
    "[\"\",{\"text\":\"Four \"},{\"text\":\"Infused Rock\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_stone\",\"count\":1}}},{\"text\":\", the four stronger tokens and a \"},{\"text\":\"Bottled Vacuum\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:vacuum_bottle\",\"count\":1}}},{\"text\":\" make the \"},{\"text\":\"Aura Imbalance Ward\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:lower_limiter\",\"count\":1}}},{\"text\":\". Place it against a device that spends aura: the device only runs while the area stays above zero after its cost. The ward itself costs nothing.\"}]"
  ],
  "quest.116B803C6C4E8D37.title": "Too little, too much",
  "quest.116B803C6C4E8D37.quest_desc": [
    "Below an empty bar, grass and leaves decay, netherrack rots into soul soil, breathing hurts and endermen and zombified piglins lose their temper; far below, the surface explodes. From three quarters of the bar up, crops grow in spurts, Aura Caches refill and netherrack grows grass.",
    "{@pagebreak}",
    "Only the Overworld and the Nether suffer decay. The book's Aura Imbalance chapter lists every effect, and the Environmental Ocular shows the active ones."
  ],
  "quest.461C04169FA78A2B.title": "The Aura Detector",
  "quest.461C04169FA78A2B.quest_subtitle": "A thermometer with a redstone tongue.",
  "quest.461C04169FA78A2B.quest_desc": [
    "[\"\",{\"text\":\"An \"},{\"text\":\"Environmental Eye\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:eye\",\"count\":1}}},{\"text\":\" ringed by \"},{\"text\":\"Infused Rock\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_stone\",\"count\":1}}},{\"text\":\" and redstone makes the \"},{\"text\":\"Aura Detector\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:aura_detector\",\"count\":1}}},{\"text\":\". A \"},{\"text\":\"Redstone Comparator\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:comparator\",\"count\":1}}},{\"text\":\" against it reads the aura within 25 blocks: 15 is a full bar, half that is untouched ground. Use it to switch generators off before they overflow.\"}]"
  ],
  "quest.1F0C745EFAEBBCD8.title": "The Redstone Aura Vaporizer",
  "quest.1F0C745EFAEBBCD8.quest_subtitle": "Tick, tock, sunlight.",
  "quest.1F0C745EFAEBBCD8.quest_desc": [
    "[\"\",{\"text\":\"Bottled aura in the \"},{\"text\":\"Redstone Aura Vaporizer\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:aura_timer\",\"count\":1}}},{\"text\":\" evaporates at a fixed pace and emits a pulse each time: sunlight lasts a second, ghosts a minute and darkness an hour, and more bottles add up. A redstone signal resets it.\"}]"
  ],
  "quest.544CC0113B575494.title": "Deadly Day",
  "quest.544CC0113B575494.quest_subtitle": "Congratulations, you broke the grass.",
  "quest.544CC0113B575494.quest_desc": [
    "The aura around you hit zero. Plant Ancient Trees to refill the ground and put an Aura Imbalance Ward beside anything that drains on its own."
  ],
  "reward.26C75992DD9A76D8.title": "Secret found",
  "quest.61D6F861B8C8FD80.title": "Effect Powder",
  "quest.61D6F861B8C8FD80.quest_subtitle": "Magic, by the pinch.",
  "quest.61D6F861B8C8FD80.quest_desc": [
    "[\"\",{\"text\":\"Rituals make powders that switch an imbalance effect off, or on for the ones that need them. Drop a stack on the ground: its range in blocks equals the stack size; hit it to pick it up. \"},{\"text\":\"Powder of Steady Growth\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:effect_powder\",\"count\":1}}},{\"text\":\" stops the crop spurts.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Powder Manipulator\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:powder_placer\",\"count\":1}}},{\"text\":\" lays powder from a chest beside it on a redstone pulse and picks it back up on the next.\"}]"
  ],
  "quest.194BC2B18DD77BED.title": "Increase of Fertility",
  "quest.194BC2B18DD77BED.quest_subtitle": "Romance is in the air. Literally.",
  "quest.194BC2B18DD77BED.quest_desc": [
    "[\"\",{\"text\":\"A jungle-sapling ritual of two Gold Powder, an \"},{\"text\":\"Ingot of the Skies\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:sky_ingot\",\"count\":1}}},{\"text\":\" and an \"},{\"text\":\"Egg\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:egg\",\"count\":1}}},{\"text\":\" makes eight \"},{\"text\":\"Powder of Fertility\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:effect_powder\",\"count\":1}}},{\"text\":\". Near it, above three quarters of the bar, animals breed on their own and dropped eggs hatch, until 200 animals crowd the area.\"}]"
  ],
  "quest.09A048CBBB5316C5.title": "Mineral Amassing",
  "quest.09A048CBBB5316C5.quest_subtitle": "The ground grows ores. Nobody asks how.",
  "quest.09A048CBBB5316C5.quest_desc": [
    "[\"\",{\"text\":\"Two Gold Powder, a \"},{\"text\":\"Diamond Ore\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond_ore\",\"count\":1}}},{\"text\":\" and a \"},{\"text\":\"Redstone Ore\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:redstone_ore\",\"count\":1}}},{\"text\":\" make four \"},{\"text\":\"Powder of the Bountiful Core\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:effect_powder\",\"count\":1}}},{\"text\":\". With the aura past the top of the Environmental Eye's bar, which takes a Creational Catalyst, ores appear in the stone around it; it drinks a lot of aura doing it.\"}]"
  ],
  "quest.5B7EE54AECCA4453.title": "Bottled darkness",
  "quest.5B7EE54AECCA4453.quest_subtitle": "The End: now available to go.",
  "quest.5B7EE54AECCA4453.quest_desc": [
    "[\"\",{\"text\":\"In the End, a \"},{\"text\":\"Bottle and Cork\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:bottle_two_the_rebottling\",\"count\":1}}},{\"text\":\" fills with darkness. Darkness goes into the World Eye, the Lamp of Sanctuary, the Ender Crate, the Eye of the Shulker and the Aura Attraction Cart; the altar turns it into \"},{\"text\":\"Dragon's Breath\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:dragon_breath\",\"count\":1}}},{\"text\":\" with a Transmutation Catalyst.\"}]"
  ],
  "quest.3D990502C6760FA3.title": "The World Eye",
  "quest.3D990502C6760FA3.quest_subtitle": "Someone has to keep watching.",
  "quest.3D990502C6760FA3.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"World Eye\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:chunk_loader\",\"count\":1}}},{\"text\":\" keeps an area loaded for a little aura. A redstone signal sets its radius, up to about 30 blocks at full strength, and the loaded area can come out slightly bigger. Be kind to shared servers.\"}]"
  ],
  "quest.41D803B6CBC77922.title": "Ender Crate and Ocular",
  "quest.41D803B6CBC77922.quest_subtitle": "Same box, any dimension.",
  "quest.41D803B6CBC77922.quest_desc": [
    "[\"\",{\"text\":\"Crates that share an Ender Name share one inventory, across dimensions. Name one on an anvil with an \"},{\"text\":\"Eye of Ender\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_eye\",\"count\":1}}},{\"text\":\"; the \"},{\"text\":\"Ender Ocular\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:ender_access\",\"count\":1}}},{\"text\":\" opens the same storage from your hand, paid from an Aura Cache.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A Token of Terror inside a crate locks its name, so nobody else can claim it.\"}]"
  ],
  "quest.16F95EDC5F597890.title": "The Aura Attraction Cart",
  "quest.16F95EDC5F597890.quest_subtitle": "Aura, now shipped by rail.",
  "quest.16F95EDC5F597890.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Aura Attraction Cart\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:mover_cart\",\"count\":1}}},{\"text\":\" carries aura along rails. A powered activator rail makes it grab the excess aura around it; an unpowered one makes it let go. Some aura is lost on the way.\"}]"
  ],
  "quest.62807C86526F1FA4.title": "The Lamp of Sanctuary",
  "quest.62807C86526F1FA4.quest_subtitle": "Monsters: not on my lawn.",
  "quest.62807C86526F1FA4.quest_desc": [
    "[\"\",{\"text\":\"With a redstone signal, the \"},{\"text\":\"Lamp of Sanctuary\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:spawn_lamp\",\"count\":1}}},{\"text\":\" stops monsters from spawning within up to about 48 blocks, whatever the light. The signal's strength sets the range, and each spawn it prevents costs a little aura.\"}]"
  ],
  "quest.18050EDDAEA8B54E.title": "Rails of the Worlds",
  "quest.18050EDDAEA8B54E.quest_subtitle": "Mind the gap between dimensions.",
  "quest.18050EDDAEA8B54E.quest_desc": [
    "A minecart rolling over one of these rails lands in that rail's dimension: Overworld and Nether trade places at one eighth of the distance, the End sends you to its obsidian platform and back to world spawn. Carts with living passengers stay put."
  ],
  "quest.02B79EE4FDE7D058.title": "Eyes that fly home",
  "quest.02B79EE4FDE7D058.quest_subtitle": "Like an Eye of Ender, with better taste.",
  "quest.02B79EE4FDE7D058.quest_desc": [
    "[\"\",{\"text\":\"Thrown, each eye flies toward its structure like an Eye of Ender: the \"},{\"text\":\"Eye of the Blaze\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:fortress_finder\",\"count\":1}}},{\"text\":\" to a Nether fortress, the \"},{\"text\":\"Eye of the Shulker\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:end_city_finder\",\"count\":1}}},{\"text\":\" to an End city and the \"},{\"text\":\"Eye of the Pillager\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:outpost_finder\",\"count\":1}}},{\"text\":\" to a pillager outpost. Each takes two bottles of its dimension's aura.\"}]"
  ],
  "quest.465F5DC640F8DB06.title": "Aura from the End",
  "quest.465F5DC640F8DB06.quest_subtitle": "The dragon leaves flowers behind.",
  "quest.465F5DC640F8DB06.quest_desc": [
    "[\"\",{\"text\":\"Once the Ender Dragon dies, \"},{\"text\":\"Roses of Oblivion\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:end_flower\",\"count\":1}}},{\"text\":\" sprout on the End island. Drop an \"},{\"text\":\"Eye of Ender\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_eye\",\"count\":1}}},{\"text\":\" beside one, in any dimension: it swallows the eye and releases 500,000 aura, no catalyst needed.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Reaper of Ender Heights\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:chorus_generator\",\"count\":1}}},{\"text\":\" harvests a whole chorus plant growing within two blocks on a redstone signal; the taller and wider the plant, the more aura.\"}]"
  ],
  "quest.52DF6B1354B40B19.title": "The Environmental Ocular",
  "quest.52DF6B1354B40B19.quest_subtitle": "Suddenly I see a lot better.",
  "quest.52DF6B1354B40B19.quest_desc": [
    "[\"\",{\"text\":\"A ritual of the \"},{\"text\":\"Environmental Eye\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:eye\",\"count\":1}}},{\"text\":\", two \"},{\"text\":\"Ingots of the Skies\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:sky_ingot\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Rose of Oblivion\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:end_flower\",\"count\":1}}},{\"text\":\" and two Gold Leaf makes the \"},{\"text\":\"Environmental Ocular\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:eye_improved\",\"count\":1}}},{\"text\":\". Its bar reaches twice as far, it works from anywhere in the inventory and it shows an icon for each imbalance effect where you stand.\"}]"
  ],
  "quest.7F4D00FE009AE647.title": "Infused iron for the common store",
  "quest.7F4D00FE009AE647.quest_subtitle": "The workshop always wants more.",
  "quest.7F4D00FE009AE647.quest_desc": [
    "[\"\",{\"text\":\"Eight \"},{\"text\":\"Infused Iron\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_iron\",\"count\":1}}},{\"text\":\" for the common store. The Aura Cache, the Offering Table, the Spirit of Calling and most devices each take some.\"}]"
  ],
  "quest.6099370A6BFA9DFE.title": "Hoppers with manners",
  "quest.6099370A6BFA9DFE.quest_subtitle": "Items, sorted with a green thumb.",
  "quest.6099370A6BFA9DFE.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Hopper Enhancement\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:hopper_upgrade\",\"count\":1}}},{\"text\":\" on top of a hopper pulls items from about seven blocks away, a little aura each. The \"},{\"text\":\"Adept Hopper\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:grated_chute\",\"count\":1}}},{\"text\":\" is a faster hopper that only passes items shown in item frames on its sides; use it to invert the filter.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Item Distributor\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:item_distributor\",\"count\":1}}},{\"text\":\" takes from a container above and deals items evenly into the containers at its sides.\"}]"
  ],
  "quest.3FEBFE2C75518997.title": "The Imperceptible Builder",
  "quest.3FEBFE2C75518997.quest_subtitle": "Plop, plop, placement.",
  "quest.3FEBFE2C75518997.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Imperceptible Builder\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:placer\",\"count\":1}}},{\"text\":\" places blocks from a container on top of it onto matching blocks within about five: cobblestone in an item frame on it and planks in the chest lay planks on every cobblestone. A \"},{\"text\":\"Farming Stencil\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:farming_stencil\",\"count\":1}}},{\"text\":\" in the frame targets farmland. Redstone pauses it.\"}]"
  ],
  "quest.77BD2EF5398C4F34.title": "Invisible fences",
  "quest.77BD2EF5398C4F34.quest_subtitle": "Stay. Good cow.",
  "quest.77BD2EF5398C4F34.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Corporeal Eye\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:animal_container\",\"count\":1}}},{\"text\":\" keeps animals from leaving its area without a single fence; the \"},{\"text\":\"Item Grounder\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:pickup_stopper\",\"count\":1}}},{\"text\":\" lets dropped items be picked up only by someone sneaking, up to eight blocks away. On both, the redstone signal sets the range.\"}]"
  ],
  "quest.3A31B8FDDFF83B8B.title": "The Crumbling Catalyst",
  "quest.3A31B8FDDFF83B8B.quest_subtitle": "Your altar, now with a mortar and pestle.",
  "quest.3A31B8FDDFF83B8B.quest_desc": [
    "[\"\",{\"text\":\"Anger\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:token_anger\",\"count\":1}}},{\"text\":\" carves from Bottled Ghosts, a leaf, a \"},{\"text\":\"Magma Block\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:magma_block\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Blaze Powder\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:blaze_powder\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Gunpowder\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:gunpowder\",\"count\":1}}},{\"text\":\" and an \"},{\"text\":\"Ender Pearl\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_pearl\",\"count\":1}}},{\"text\":\". Add a golden brick, Infused Rock, a piston and flint for the \"},{\"text\":\"Crumbling Catalyst\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:crushing_catalyst\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "Set it on one of the altar's four lower golden bricks and the altar crushes: a bone into six bone meal, a Gold Leaf into four Gold Powder, a blaze rod into four powder, cobblestone into sand. The first three are twice what a crafting grid gives."
  ],
  "quest.7DF9910955D1C05F.title": "The Extraneous Firestarter",
  "quest.7DF9910955D1C05F.quest_subtitle": "Cozy warmth, charged to the planet.",
  "quest.7DF9910955D1C05F.quest_desc": [
    "[\"\",{\"text\":\"A ritual of two \"},{\"text\":\"Infused Rock\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_stone\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Tainted Gold\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:tainted_gold\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Infused Iron\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_iron\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Fire Charge\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:fire_charge\",\"count\":1}}},{\"text\":\", flint, a magma block and a \"},{\"text\":\"Token of Fear\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:token_fear\",\"count\":1}}},{\"text\":\" makes the \"},{\"text\":\"Extraneous Firestarter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:furnace_heater\",\"count\":1}}},{\"text\":\". Against any side of a furnace, it heats and speeds it with aura.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"It keeps drinking even past empty, so the ground can go negative.\",\"color\":\"#FF8C7A\"},{\"text\":\" An Aura Imbalance Ward beside it stops that.\"}]"
  ],
  "quest.29894D4BE81A76E9.title": "Armorer's Aid",
  "quest.29894D4BE81A76E9.quest_subtitle": "Two ingots for the price of one, sometimes.",
  "quest.29894D4BE81A76E9.quest_desc": [
    "[\"\",{\"text\":\"An \"},{\"text\":\"Extraneous Firestarter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:furnace_heater\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Blast Furnace\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:blast_furnace\",\"count\":1}}},{\"text\":\", two Tokens of Terror, Infused Iron and cobblestone make \"},{\"text\":\"Armorer's Aid\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:blast_furnace_booster\",\"count\":1}}},{\"text\":\". On top of a blast furnace it gives each ore a chance at two ingots, and hoppers can feed it from any side.\"}]"
  ],
  "quest.0DC0D0332C4F6397.title": "The Aura Cache",
  "quest.0DC0D0332C4F6397.quest_subtitle": "Ca-ching.",
  "quest.0DC0D0332C4F6397.quest_desc": [
    "[\"\",{\"text\":\"Four \"},{\"text\":\"Infused Rock\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_stone\",\"count\":1}}},{\"text\":\", four \"},{\"text\":\"Infused Iron\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_iron\",\"count\":1}}},{\"text\":\" and a \"},{\"text\":\"Bucket\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:bucket\",\"count\":1}}},{\"text\":\" make the \"},{\"text\":\"Aura Cache\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:aura_cache\",\"count\":1}}},{\"text\":\": 400,000 aura to carry. Set it on the altar to fill it. The mod's staffs and trinkets draw from it, and while you sneak it repairs the mod's tools in hand and its armor, 300 aura a point.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The book still has Nature's Mend pages, but 41.9 registers no such enchantment:\",\"color\":\"#FF8C7A\"},{\"text\":\" only Nature's Aura gear repairs from aura.\"}]"
  ],
  "quest.4057018AB5A21247.title": "Botanist's gear",
  "quest.4057018AB5A21247.quest_subtitle": "Tools with a green thumb.",
  "quest.4057018AB5A21247.quest_desc": [
    "[\"\",{\"text\":\"Infused Iron with Ancient Wood Rods for handles, so grow an Ancient Tree first. The \"},{\"text\":\"Botanist's Pickaxe\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_iron_pickaxe\",\"count\":1}}},{\"text\":\" turns blocks mossy on right-click and the \"},{\"text\":\"Blade\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_iron_sword\",\"count\":1}}},{\"text\":\" slows what it hits; the axe clears leaves fast, the shovel spreads grass and the hoe finds seeds.\"}]",
    "{@pagebreak}",
    "The full Botanist's armor gives attackers a short Wither, and makes the Amulet of Wrath's shockwave wither them too."
  ],
  "quest.42D035F965D782A4.title": "Skyseeker's gear",
  "quest.42D035F965D782A4.quest_subtitle": "Diamonds never fall into lava again.",
  "quest.42D035F965D782A4.quest_desc": [
    "[\"\",{\"text\":\"Ingots of the Skies on Ancient Wood Rods. The \"},{\"text\":\"Skyseeker's Pickaxe\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:sky_pickaxe\",\"count\":1}}},{\"text\":\" sends what it mines straight to your inventory, and the \"},{\"text\":\"Handaxe\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:sky_axe\",\"count\":1}}},{\"text\":\", switched on by sneak-using it, fells small trees at once. The shovel swaps blocks for the one in your off-hand and the hoe tills wide.\"}]",
    "{@pagebreak}",
    "The full Skyseeker's armor, or the set with an Elytra, makes you faster and lets you step up full blocks. The blade makes its targets float."
  ],
  "quest.25DD37FFB2ED5D5E.title": "Soulstrider's gear",
  "quest.25DD37FFB2ED5D5E.quest_subtitle": "Sky, earth and the depths in one bar.",
  "quest.25DD37FFB2ED5D5E.quest_desc": [
    "[\"\",{\"text\":\"Two \"},{\"text\":\"Ingots of the Skies\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:sky_ingot\",\"count\":1}}},{\"text\":\", two Tainted Gold and a \"},{\"text\":\"Netherite Scrap\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:netherite_scrap\",\"count\":1}}},{\"text\":\" make an \"},{\"text\":\"Ingot of the Depths\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:depth_ingot\",\"count\":1}}},{\"text\":\". Sneak-use the \"},{\"text\":\"Soulstrider's Pickaxe\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:depth_pickaxe\",\"count\":1}}},{\"text\":\" to mine whole ore veins; the handaxe fells any tree, however big.\"}]",
    "{@pagebreak}",
    "The shovel greens a wide area of dirt, the hoe clears leaves far around and the blade sweeps a crowd. The full armor freezes nearby enemies in place when you are struck."
  ],
  "quest.08614DCFBD78E746.title": "Striding in Style",
  "quest.08614DCFBD78E746.quest_subtitle": "Nine pieces. No regrets.",
  "quest.08614DCFBD78E746.quest_desc": [
    "Every Soulstrider's tool and armor piece, at once: thirty-five Ingots of the Depths, seventy sky ingots from the offering bowl."
  ],
  "reward.38BAD0EF2CA98ECB.title": "Secret found",
  "quest.4A49A9E8732DD39F.title": "The Aura Trove",
  "quest.4A49A9E8732DD39F.quest_subtitle": "Three caches in a trenchcoat.",
  "quest.4A49A9E8732DD39F.quest_desc": [
    "[\"\",{\"text\":\"An \"},{\"text\":\"Aura Cache\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:aura_cache\",\"count\":1}}},{\"text\":\" with four \"},{\"text\":\"Ingots of the Skies\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:sky_ingot\",\"count\":1}}},{\"text\":\" and four Infused Rock becomes the \"},{\"text\":\"Aura Trove\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:aura_trove\",\"count\":1}}},{\"text\":\": 1,200,000 aura, three times the cache.\"}]"
  ],
  "quest.0D6AB7E547FC1356.title": "The Mystical Magnifier",
  "quest.0D6AB7E547FC1356.quest_subtitle": "I spy with my little eye.",
  "quest.0D6AB7E547FC1356.quest_desc": [
    "[\"\",{\"text\":\"Hold the \"},{\"text\":\"Mystical Magnifier\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:range_visualizer\",\"count\":1}}},{\"text\":\" and use it on a device to see its working range drawn around it; use it again to hide it. On a Rail of the Worlds it marks the destination, even through walls.\"}]"
  ],
  "quest.3BFA3A15B7DDEF56.title": "Staffs that find",
  "quest.3BFA3A15B7DDEF56.quest_subtitle": "Treasure hunting, sponsored by aura.",
  "quest.3BFA3A15B7DDEF56.quest_desc": [
    "[\"\",{\"text\":\"Swung with an Aura Cache on you: the \"},{\"text\":\"Staff of Riches\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:loot_finder\",\"count\":1}}},{\"text\":\" lights up containers within about 64 blocks for a minute, the \"},{\"text\":\"Staff of Shadows\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:cave_finder\",\"count\":1}}},{\"text\":\" shows dark spots where monsters can spawn for half a minute, and the \"},{\"text\":\"Staff of Ancient Knowledge\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:netherite_finder\",\"count\":1}}},{\"text\":\" marks Ancient Debris through stone.\"}]"
  ],
  "quest.3A63930AA6A005BC.title": "Wrath and light",
  "quest.3A63930AA6A005BC.quest_subtitle": "Stomp first, ask questions later.",
  "quest.3A63930AA6A005BC.quest_desc": [
    "[\"\",{\"text\":\"With the \"},{\"text\":\"Amulet of Wrath\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:shockwave_creator\",\"count\":1}}},{\"text\":\" anywhere on you, sneak and jump in place to stomp a shockwave that hurts everything close. The \"},{\"text\":\"Staff of Baldur\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:light_staff\",\"count\":1}}},{\"text\":\" fires a ray that lights up where it lands, as if glowstone were there, and sets creatures on fire. Both run on a cache.\"}]"
  ],
  "quest.688C721A5A7E5C04.title": "Against loss",
  "quest.688C721A5A7E5C04.quest_subtitle": "Death, delayed. Paperwork pending.",
  "quest.688C721A5A7E5C04.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Ring of Last Chance\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:death_ring\",\"count\":1}}},{\"text\":\" saves you from death once, like a totem, and is used up. The \"},{\"text\":\"Token of Undying Friendship\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:pet_reviver\",\"count\":1}}},{\"text\":\", given to a tamed pet, sends it home instead of letting it die. \"},{\"text\":\"Eir's Token\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:break_prevention\",\"count\":1}}},{\"text\":\" on an anvil makes a tool stop working at zero durability instead of breaking.\"}]"
  ],
  "quest.1EFEEF9BC6A10011.title": "The Bucket of Infinite Color",
  "quest.1EFEEF9BC6A10011.quest_subtitle": "Three dyes, every color.",
  "quest.1EFEEF9BC6A10011.quest_desc": [
    "[\"\",{\"text\":\"Sneak-use the \"},{\"text\":\"Bucket of Infinite Color\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:color_changer\",\"count\":1}}},{\"text\":\" on any dyed block to take its color, then use it to paint. Sneak-use it in the air for fill mode, which repaints every touching block of the same color. The paint is aura from a cache.\"}]"
  ],
  "quest.5C7810C168AFECD6.title": "Crimson Meal",
  "quest.5C7810C168AFECD6.quest_subtitle": "Bone meal, but make it Nether.",
  "quest.5C7810C168AFECD6.quest_desc": [
    "[\"\",{\"text\":\"Eight \"},{\"text\":\"Bone Meal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:bone_meal\",\"count\":1}}},{\"text\":\" around Bottled Ghosts make eight \"},{\"text\":\"Crimson Meal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:crimson_meal\",\"count\":1}}},{\"text\":\". Each use on \"},{\"text\":\"Nether Wart\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:nether_wart\",\"count\":1}}},{\"text\":\" has a one-in-five chance to grow it; used on bare soul sand, it can plant warts around.\"}]"
  ],
  "quest.258DC1B17D1B42E8.title": "A wart the size of a tree",
  "quest.258DC1B17D1B42E8.quest_subtitle": "Some mushrooms just want to be trees.",
  "quest.258DC1B17D1B42E8.quest_desc": [
    "[\"\",{\"text\":\"Crimson Meal on fully grown Nether Wart can raise a whole \"},{\"text\":\"Nether Wart Mushroom\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:nether_wart_mushroom\",\"count\":1}}},{\"text\":\", and Silk Touch keeps a block of it. Without it, each block drops one or two warts.\"}]"
  ],
  "reward.1A23571A03ABB8A7.title": "Secret found",
  "quest.7D4CCA7580D5B1D1.title": "Ancient Trees",
  "quest.7D4CCA7580D5B1D1.quest_subtitle": "They give until they're bare.",
  "quest.7D4CCA7580D5B1D1.quest_desc": [
    "[\"\",{\"text\":\"A ritual of an \"},{\"text\":\"Oak Sapling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:oak_sapling\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Dandelion\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:dandelion\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Poppy\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:poppy\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Wheat Seeds\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:wheat_seeds\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Sugar Cane\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:sugar_cane\",\"count\":1}}},{\"text\":\" and a \"},{\"text\":\"Gold Leaf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:gold_leaf\",\"count\":1}}},{\"text\":\" makes two \"},{\"text\":\"Ancient Saplings\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:ancient_sapling\",\"count\":1}}},{\"text\":\". Grown, their leaves feed drained ground within 25 blocks back toward normal, and wilt as they give.\"}]",
    "{@pagebreak}",
    "They only work in the Overworld. Their logs make Ancient Wood Rods, the handle of every Nature's Aura tool and staff."
  ],
  "quest.7447D8C94CD8B600.title": "The Herbivorous Absorber",
  "quest.7447D8C94CD8B600.quest_subtitle": "A picky eater with a sweet tooth.",
  "quest.7447D8C94CD8B600.quest_desc": [
    "[\"\",{\"text\":\"Infused Iron\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_iron\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Token of Joy\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:token_joy\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Peony\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:peony\",\"count\":1}}},{\"text\":\" and planks make the \"},{\"text\":\"Herbivorous Absorber\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:flower_generator\",\"count\":1}}},{\"text\":\". Every half second it eats a small flower within three blocks for up to 25,000 aura, in the Overworld only.\"}]",
    "{@pagebreak}",
    "The same kind again is worth 500 less each time, and eating other kinds lets it recover, so plant about six kinds and it stays at full value."
  ],
  "quest.1D0F0FEE089CC36B.title": "Red sparks mean full",
  "quest.1D0F0FEE089CC36B.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Generators stop adding aura once the area within 35 blocks would pass the top of the Environmental Eye's bar, and red sparks fly from them. An Aura Detector can switch them off before that; a Creational Catalyst underneath lifts the limit.\"}]"
  ],
  "quest.7FF688D0F84EBBD4.title": "Aura from the garden",
  "quest.7FF688D0F84EBBD4.quest_subtitle": "Tidy trees, clean stones, happy planet.",
  "quest.7FF688D0F84EBBD4.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Canopy Diminisher\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:oak_generator\",\"count\":1}}},{\"text\":\" makes oaks within ten blocks grow small, and each big oak it prevents becomes 100,000 aura: a tree farm's best friend. The \"},{\"text\":\"Swamp Homi\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:moss_generator\",\"count\":1}}},{\"text\":\" scrubs the moss off mossy blocks around it, a little aura per block. The Diminisher only works in the Overworld.\"}]"
  ],
  "quest.3CD669119305D757.title": "The Ritual of the Brewer",
  "quest.3CD669119305D757.quest_subtitle": "Brewed for the planet, not for you.",
  "quest.3CD669119305D757.quest_desc": [
    "[\"\",{\"text\":\"Build the \"},{\"text\":\"Lingering Absorber\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:potion_generator\",\"count\":1}}},{\"text\":\"'s structure as the book shows, then throw a positive lingering potion beside it: the effect turns into aura, more for longer and stronger effects. One potion at a time, or the others go to waste.\"}]"
  ],
  "quest.3963C0259CD52088.title": "Aura from creatures",
  "quest.3963C0259CD52088.quest_subtitle": "Grim, but efficient.",
  "quest.3963C0259CD52088.quest_desc": [
    "[\"\",{\"text\":\"Passive animals killed near the \"},{\"text\":\"Disentangler of Mortals\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:animal_generator\",\"count\":1}}},{\"text\":\" free their soul as aura, far more after about an hour and a half of life, and drop nothing. The \"},{\"text\":\"Offshoot Observer\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:slime_split_generator\",\"count\":1}}},{\"text\":\" turns each slime or magma cube that splits nearby into aura, more for bigger and rarer ones.\"}]"
  ],
  "quest.4AB62CCA8BFAC29B.title": "Aura on target",
  "quest.4AB62CCA8BFAC29B.quest_subtitle": "Aim for the north side. Always the north side.",
  "quest.4AB62CCA8BFAC29B.quest_desc": [
    "[\"\",{\"text\":\"Shoot the \"},{\"text\":\"Shooting Mark\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:projectile_generator\",\"count\":1}}},{\"text\":\"'s four sides in order, starting with north: each hit on the active side becomes aura, an ender pearl worth far more than a snowball. The \"},{\"text\":\"Firecracker Gaze\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:firework_generator\",\"count\":1}}},{\"text\":\" launches fireworks dropped near it and turns the explosions into aura, more for fancier rockets.\"}]"
  ],
  "quest.6E3C0FEEC0276B33.title": "The Creational Catalyst",
  "quest.6E3C0FEEC0276B33.quest_subtitle": "No ceiling, only fizzle.",
  "quest.6E3C0FEEC0276B33.quest_desc": [
    "[\"\",{\"text\":\"Four \"},{\"text\":\"Infused Rock\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_stone\",\"count\":1}}},{\"text\":\", the four stronger tokens and \"},{\"text\":\"Tainted Gold\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:tainted_gold\",\"count\":1}}},{\"text\":\" make the \"},{\"text\":\"Creational Catalyst\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:generator_limit_remover\",\"count\":1}}},{\"text\":\". Directly under a generator, it lets it keep adding aura past the top of the Environmental Eye's bar.\"}]"
  ],
  "quest.20D5AAF1E3A44A3B.title": "The Spirit of Calling",
  "quest.20D5AAF1E3A44A3B.quest_subtitle": "Knocking on heaven's door, in triplicate.",
  "quest.20D5AAF1E3A44A3B.quest_desc": [
    "[\"\",{\"text\":\"Bottled Sunlight on top, Bottled Ghosts below, \"},{\"text\":\"Infused Iron\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_iron\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Tainted Gold\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:tainted_gold\",\"count\":1}}},{\"text\":\" at the sides and a \"},{\"text\":\"Diamond\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\" in the middle make three \"},{\"text\":\"Spirits of Calling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:calling_spirit\",\"count\":1}}},{\"text\":\", the item that summons the gods' attention.\"}]"
  ],
  "quest.14A224DDD4B25015.title": "One spirit, one bowl",
  "quest.14A224DDD4B25015.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"One spirit converts the whole bowl, up to sixteen items, so always fill it. Throw exactly one spirit within a block of the table: a dropped stack of them is ignored.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The gifts fall from the top of the world onto the table, so leave the sky above it open. A \"},{\"text\":\"Wither Rose\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:wither_rose\",\"count\":1}}},{\"text\":\" in the rings makes the gods throw some \"},{\"text\":\"Black Dye\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:black_dye\",\"count\":1}}},{\"text\":\" in with them.\"}]"
  ],
  "quest.08001C294EFA9C63.title": "Ingots of the Skies",
  "quest.08001C294EFA9C63.quest_subtitle": "When the gods pay, they pay in metal.",
  "quest.08001C294EFA9C63.quest_desc": [
    "[\"\",{\"text\":\"Fill the table's bowl with \"},{\"text\":\"Infused Iron\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_iron\",\"count\":1}}},{\"text\":\" and throw one \"},{\"text\":\"Spirit of Calling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:calling_spirit\",\"count\":1}}},{\"text\":\" beside it: a harmless bolt strikes and each ingot comes back as an \"},{\"text\":\"Ingot of the Skies\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:sky_ingot\",\"count\":1}}},{\"text\":\". \"},{\"text\":\"Tainted Gold\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:tainted_gold\",\"count\":1}}},{\"text\":\" gives two apiece.\"}]",
    "{@pagebreak}",
    "In this pack sky ingots are an act V material: the Powah spirited capacitor, the Draconic Endshelf, the horizon shelves, the Renewal Engine and act VI's Luminous Ingot all take them."
  ],
  "quest.5C61FC7DC4A15D47.title": "The Renewal Engine",
  "quest.5C61FC7DC4A15D47.quest_subtitle": "Keep the table busy.",
  "quest.5C61FC7DC4A15D47.quest_desc": [
    "[\"\",{\"text\":\"Two \"},{\"text\":\"Ingots of the Skies\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:sky_ingot\",\"count\":1}}},{\"text\":\", two imperium essences, two Ecosystem Capsules and two Propagation Cores make the \"},{\"text\":\"Renewal Engine\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:renewal_engine\",\"count\":1}}},{\"text\":\", delivered for «Renewable Horizons» in act V. Mekanism's SPS port and the Mega pot upgrade take one each too.\"}]"
  ],
  "quest.0A7328CE39A59CC0.title": "A balanced grove",
  "quest.0A7328CE39A59CC0.quest_subtitle": "Leave it greener than you found it.",
  "quest.0A7328CE39A59CC0.quest_desc": [
    "Stand where the aura reaches three quarters of the Environmental Eye's bar, checked every ten seconds within 25 blocks of you. Ancient Trees, absorbers and generators have to out-produce everything the altar and your devices drain.",
    "{@pagebreak}",
    "At that level crops grow in spurts and Aura Caches refill on their own. Heliodor's gardens kept growing after everyone vanished; this one grows because of you."
  ],
  "quest.2F031A06427A0781.title": "Stronger feelings",
  "quest.2F031A06427A0781.quest_subtitle": "Upgrade your emotional range.",
  "quest.2F031A06427A0781.quest_desc": [
    "[\"\",{\"text\":\"Offer a token instead of iron: Joy comes back as \"},{\"text\":\"Euphoria\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:token_euphoria\",\"count\":1}}},{\"text\":\", Fear as \"},{\"text\":\"Terror\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:token_terror\",\"count\":1}}},{\"text\":\", Anger as \"},{\"text\":\"Rage\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:token_rage\",\"count\":1}}},{\"text\":\" and Sorrow as \"},{\"text\":\"Grief\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:token_grief\",\"count\":1}}},{\"text\":\". The late devices and trinkets are built from these.\"}]"
  ],
  "quest.1E0BA88629F4B13E.title": "The Transmutation Catalyst",
  "quest.1E0BA88629F4B13E.quest_subtitle": "Not-so-equivalent exchange.",
  "quest.1E0BA88629F4B13E.quest_desc": [
    "[\"\",{\"text\":\"A jungle-sapling ritual of a golden brick, \"},{\"text\":\"Infused Rock\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_stone\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Brewing Stand\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:brewing_stand\",\"count\":1}}},{\"text\":\", an \"},{\"text\":\"Ingot of the Skies\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:sky_ingot\",\"count\":1}}},{\"text\":\", a Gold Leaf and \"},{\"text\":\"Glowstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:glowstone\",\"count\":1}}},{\"text\":\" makes the \"},{\"text\":\"Transmutation Catalyst\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:conversion_catalyst\",\"count\":1}}},{\"text\":\". On a lower golden brick of the altar, it turns one thing into another.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Soul soil into \"},{\"text\":\"Ghast Tears\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ghast_tear\",\"count\":1}}},{\"text\":\", amethyst shards into \"},{\"text\":\"Ender Pearls\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_pearl\",\"count\":1}}},{\"text\":\", charcoal into coal, rotten flesh into leather, a water bucket into milk, Bottled Darkness into \"},{\"text\":\"Dragon's Breath\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:dragon_breath\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.382146CD7C5728B1.title": "The Energetic Aura Forge",
  "quest.382146CD7C5728B1.quest_subtitle": "Nature, now in Forge Energy.",
  "quest.382146CD7C5728B1.quest_desc": [
    "[\"\",{\"text\":\"A Transmutation Catalyst, two \"},{\"text\":\"Ingots of the Skies\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:sky_ingot\",\"count\":1}}},{\"text\":\", Tokens of Fear and Anger and four redstone blocks make the \"},{\"text\":\"Energetic Aura Forge\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:rf_converter\",\"count\":1}}},{\"text\":\". Built into its structure, it turns only the aura above normal within 45 blocks into Forge Energy, faster the more there is.\"}]"
  ],
  "quest.7D39D1A7D746D316.title": "The Everlasting Spring",
  "quest.7D39D1A7D746D316.quest_subtitle": "Water that never runs out, lava that learns manners.",
  "quest.7D39D1A7D746D316.quest_desc": [
    "[\"\",{\"text\":\"Four \"},{\"text\":\"Water Buckets\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:water_bucket\",\"count\":1}}},{\"text\":\", stone bricks and a \"},{\"text\":\"Token of Euphoria\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:token_euphoria\",\"count\":1}}},{\"text\":\" make the \"},{\"text\":\"Everlasting Spring\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:spring\",\"count\":1}}},{\"text\":\". It fills buckets and the cauldron above it, feeds pipes, wets sponges and waters farmland five blocks around, even in the Nether.\"}]",
    "{@pagebreak}",
    "Lava one block away sideways turns into cobblestone, one block above or below into stone, and lava touching it into obsidian. Each costs aura."
  ],
  "quest.27BD68763485F01C.title": "Weather on order",
  "quest.27BD68763485F01C.quest_subtitle": "Tired of rain? File a complaint with the sky.",
  "quest.27BD68763485F01C.quest_desc": [
    "[\"\",{\"text\":\"Throw items beside the \"},{\"text\":\"Cloudshifter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:weather_changer\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"Sunflowers\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:sunflower\",\"count\":1}}},{\"text\":\" clear the sky, \"},{\"text\":\"Dark Prismarine\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:dark_prismarine\",\"count\":1}}},{\"text\":\" brings rain and \"},{\"text\":\"Fire Charges\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:fire_charge\",\"count\":1}}},{\"text\":\" a thunderstorm; more items, longer weather. With a redstone signal, \"},{\"text\":\"Winter's Calling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:snow_creator\",\"count\":1}}},{\"text\":\" snows over an area, freezes water and sometimes builds snow golems.\"}]"
  ],
  "quest.004CC4AE5EA71071.title": "The Shifting Sundial",
  "quest.004CC4AE5EA71071.quest_subtitle": "Skip the night. Or the whole week.",
  "quest.004CC4AE5EA71071.quest_desc": [
    "[\"\",{\"text\":\"Offer a \"},{\"text\":\"Nether Star\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:nether_star\",\"count\":1}}},{\"text\":\" to get the \"},{\"text\":\"Hand of Time\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:clock_hand\",\"count\":1}}},{\"text\":\", and hang it in an item frame on the \"},{\"text\":\"Shifting Sundial\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:time_changer\",\"count\":1}}},{\"text\":\": its rotation picks the hour, straight up is midnight. Drop a \"},{\"text\":\"Clock\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:clock\",\"count\":1}}},{\"text\":\" next to it to jump there; the further, the more aura.\"}]"
  ],
  "quest.6E458C97F79C1565.title": "The Aura Field Creator",
  "quest.6E458C97F79C1565.quest_subtitle": "A quarry made of weather.",
  "quest.6E458C97F79C1565.quest_desc": [
    "[\"\",{\"text\":\"The recipe makes two \"},{\"text\":\"Aura Field Creators\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:field_creator\",\"count\":1}}},{\"text\":\". Sneak-use one and use the other to link them, up to 24 blocks apart, then give one a redstone signal: after a short charge, every block placed between them breaks and drops.\"}]",
    "{@pagebreak}",
    "Shears or an enchanted tool in an item frame on either creator make the field break blocks as that tool would."
  ],
  "quest.1A36F0053CEB9C10.title": "The Automatic Constructor",
  "quest.1A36F0053CEB9C10.quest_subtitle": "A crafting table that works nights.",
  "quest.1A36F0053CEB9C10.quest_desc": [
    "[\"\",{\"text\":\"Build the \"},{\"text\":\"Automatic Constructor\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:auto_crafter\",\"count\":1}}},{\"text\":\"'s ring of Ancient Logs as the book shows, with its arrow pointing to the top row of the recipe. Drop the ingredients on the logs in their crafting positions: a few seconds later the result falls out of the bottom.\"}]"
  ],
  "quest.1DE6FC8C2CF9808A.title": "The Altar of Birthing",
  "quest.1DE6FC8C2CF9808A.quest_subtitle": "Some assembly required. Also a shulker shell.",
  "quest.1DE6FC8C2CF9808A.quest_desc": [
    "[\"\",{\"text\":\"Breed two animals where the aura is a little above normal and the baby may come with \"},{\"text\":\"Spirits of Birthing\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:birth_spirit\",\"count\":1}}},{\"text\":\". Throw a spirit and a creature's ingredients beside the \"},{\"text\":\"Altar of Birthing\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:animal_spawner\",\"count\":1}}},{\"text\":\", built into its structure, and the creature appears.\"}]",
    "{@pagebreak}",
    "A Shulker Shell makes a shulker for 150,000 aura; a bone and obsidian, a wither skeleton; beef and leather, a cow. The book lists every creature it knows."
  ],
  "image.468B5EDA1F877DE0.title": "[\"\",{\"text\":\"Below empty\",\"color\":\"#F0CC52\"}]",
  "image.4BEFE805D4AE9ED6.title": "[\"\",{\"text\":\"Imbalance\",\"color\":\"#F0CC52\"}]",
  "image.267D8F71693ADF8B.title": "[\"\",{\"text\":\"Instruments\",\"color\":\"#F0CC52\"}]",
  "image.78BAD6F5FE5DD985.title": "[\"\",{\"text\":\"Powders that create\",\"color\":\"#F0CC52\"}]",
  "image.59562E29A361B3D8.title": "[\"\",{\"text\":\"The End\",\"color\":\"#F0CC52\"}]",
  "image.0DCDC7AFB86B0371.title": "[\"\",{\"text\":\"Sanctuary and rails\",\"color\":\"#F0CC52\"}]",
  "image.4BC74D7599386FAC.title": "[\"\",{\"text\":\"Aura at work\",\"color\":\"#F0CC52\"}]",
  "image.4253021624B31204.title": "[\"\",{\"text\":\"Furnaces\",\"color\":\"#F0CC52\"}]",
  "image.5D5CBDE2C6C9A7F6.title": "[\"\",{\"text\":\"Three tiers of tools\",\"color\":\"#F0CC52\"}]",
  "image.5ACC38B1E8272F04.title": "[\"\",{\"text\":\"Staffs\",\"color\":\"#F0CC52\"}]",
  "image.2E6E0ABF5BB1AC57.title": "[\"\",{\"text\":\"Keepsakes\",\"color\":\"#F0CC52\"}]",
  "image.134FA7AFB6B83AD7.title": "[\"\",{\"text\":\"The Nether\",\"color\":\"#F0CC52\"}]",
  "image.097752A465C8D65C.title": "[\"\",{\"text\":\"Garden and brew\",\"color\":\"#F0CC52\"}]",
  "image.7A1C767EEA221CEE.title": "[\"\",{\"text\":\"Creatures and targets\",\"color\":\"#F0CC52\"}]",
  "image.14C1CE56ABC972ED.title": "[\"\",{\"text\":\"Water, weather, time\",\"color\":\"#F0CC52\"}]",
  "image.6573B8F073410F1D.title": "[\"\",{\"text\":\"Fields, crafts, births\",\"color\":\"#F0CC52\"}]",
  "image.7B08CB25ADB373BB.title": "[\"\",{\"text\":\"Nature's Aura\",\"color\":\"#FFF2C0\",\"bold\":true}]",
  "image.5E2B85588759B5FC.title": "[\"\",{\"text\":\"what you take give back\",\"color\":\"#C9E88F\",\"font\":\"minecraft:alt\"}]",
  "image.76F8C69696BFE48C.title": "Back to the Sun of Heliodor",
  "chapter.5AB53528D9DFD2D3.title": "Occultism · Rituals",
  "chapter.5AB53528D9DFD2D3.chapter_subtitle": [
    "Chalk, bowls and true names: from a Foliot in a circle to spirits that forge on request."
  ],
  "quest.55F0051E7C82041E.title": "Demon's Dream",
  "quest.55F0051E7C82041E.quest_subtitle": "Grandma's garden, if grandma summoned demons.",
  "quest.55F0051E7C82041E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Break short or tall grass until \"},{\"text\":\"Demon's Dream Seeds\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:datura_seeds\",\"count\":1}}},{\"text\":\" drop: one try in fifty, and never with shears.\"}]",
    "",
    "Plant them on farmland. Everything in Occultism starts with the fruit."
  ],
  "quest.4EF837799172E91F.title": "The Third Eye",
  "quest.4EF837799172E91F.quest_subtitle": "Side effects include enlightenment.",
  "quest.4EF837799172E91F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eat a \"},{\"text\":\"Demon's Dream Fruit\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:datura\",\"count\":1}}},{\"text\":\": with luck you get the Third Eye and see where the Otherworld overlaps ours.\"}]",
    "",
    "While it lasts you can also harvest those Otherworld blocks by hand, which even the goggles won't let you do.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Nine fruits or seeds press into a \"},{\"text\":\"Demon's Dream Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:demons_dream_essence\",\"count\":1}}},{\"text\":\": the Third Eye for sure and for longer, plus a grab bag of other effects.\"}]",
    "",
    "[\"\",{\"text\":\"Spiritfire purifies it into \"},{\"text\":\"Otherworld Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:otherworld_essence\",\"count\":1}}},{\"text\":\", which keeps the good ones.\"}]"
  ],
  "quest.7823312EBC3C6871.title": "The Dictionary of Spirits",
  "quest.7823312EBC3C6871.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Demon's Dream Seeds and a book: manual and tool in one.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Each ritual page shows its pentacle.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"The eye icon previews it in the world, and a right-click with the book anchors the preview where you'll draw.\"}]"
  ],
  "quest.0E09EEC04A2E0A79.title": "Spiritfire",
  "quest.0E09EEC04A2E0A79.quest_subtitle": "A bonfire with a customs office.",
  "quest.0E09EEC04A2E0A79.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Drop a \"},{\"text\":\"Demon's Dream Fruit\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:datura\",\"count\":1}}},{\"text\":\" and light it with \"},{\"text\":\"Flint and Steel\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:flint_and_steel\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Spiritfire\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:spirit_fire\",\"count\":1}}},{\"text\":\" spares the living and converts what you throw in: \"},{\"text\":\"Andesite\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:andesite\",\"count\":1}}},{\"text\":\" into \"},{\"text\":\"Otherstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:otherstone\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Diamond\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\" into a \"},{\"text\":\"Spirit Attuned Gem\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:spirit_attuned_gem\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A sacrificial bowl set above spiritfire converts whatever you put in it at once.\"}]"
  ],
  "quest.20100A494B9AB672.title": "Trees from the other side",
  "quest.20100A494B9AB672.quest_subtitle": "Looks like oak. Isn't.",
  "quest.20100A494B9AB672.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"An \"},{\"text\":\"Oak Sapling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:oak_sapling\",\"count\":1}}},{\"text\":\" in spiritfire turns into an \"},{\"text\":\"Unstable Otherworld Sapling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:otherworld_sapling_natural\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Its tree looks like plain oak; eat Demon's Dream before you chop and the \"},{\"text\":\"Otherworld Logs\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:otherworld_log\",\"count\":1}}},{\"text\":\" come off as what they are.\"}]",
    "{@pagebreak}",
    "Otherworld Groves grow wild underground: lush caves with these trees and walls of Otherstone.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A divination rod attuned to their logs or leaves finds one.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"In the Overworld, look down.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Otherworld saplings drop only from leaves you break by hand.\"}]"
  ],
  "quest.4B35F393DC92C7AA.title": "White chalk",
  "quest.4B35F393DC92C7AA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Ash and burnt stone, purified in spiritfire: that's chalk.\"}]",
    "",
    "[\"\",{\"text\":\"Smelt \"},{\"text\":\"Otherstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:otherstone\",\"count\":1}}},{\"text\":\" twice for \"},{\"text\":\"Burnt Otherstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:burnt_otherstone\",\"count\":1}}},{\"text\":\" and burn Otherworld Logs in spiritfire for \"},{\"text\":\"Otherworld Ashes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:otherworld_ashes\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Three of each make \"},{\"text\":\"Impure White Chalk\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:chalk_white_impure\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Spiritfire purifies it.\"}]",
    "{@pagebreak}",
    "Right-click a block to draw a glyph.",
    "",
    "Only color and position count: clicking again just changes the doodle."
  ],
  "quest.1C3EF3482F1256F9.title": "Bowls for the offerings",
  "quest.1C3EF3482F1256F9.quest_subtitle": "Fine dining for spirits.",
  "quest.1C3EF3482F1256F9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Otherstone makes the bowls; gold makes the one that counts.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Five \"},{\"text\":\"Otherstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:otherstone\",\"count\":1}}},{\"text\":\" shape a \"},{\"text\":\"Sacrificial Bowl\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:sacrificial_bowl\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Eight gold ingots around one make the \"},{\"text\":\"Golden Ritual Bowl\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:golden_sacrificial_bowl\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "The golden one sits at the pentacle's center and starts the ritual.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Plain bowls hold the ingredients anywhere within \"},{\"text\":\"8\",\"color\":\"#CE8BFF\"},{\"text\":\" blocks horizontally.\"}]"
  ],
  "quest.1C93C34CD1BCA38E.title": "Candles and tallow",
  "quest.1C93C34CD1BCA38E.quest_subtitle": "Ambience is a technical requirement.",
  "quest.1C93C34CD1BCA38E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Nearly every pentacle wants candles, and any candle counts, vanilla ones too.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:butcher_knife\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A \"},{\"text\":\"Butcher Knife\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:butcher_knife\",\"count\":1}}},{\"text\":\" takes \"},{\"text\":\"Tallow\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:tallow\",\"count\":1}}},{\"text\":\" from pigs, cows and sheep.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"String over tallow makes a \"},{\"text\":\"Large Candle\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:large_candle\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.6517C4129FA2CD9B.title": "A book with a name in it",
  "quest.6517C4129FA2CD9B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Dye sets the spirit's tier; the book keeps its contract.\"}]",
    "",
    "[\"\",{\"text\":\"Spiritfire makes the parts: black dye into \"},{\"text\":\"Purified Ink\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:purified_ink\",\"count\":1}}},{\"text\":\", a feather into an \"},{\"text\":\"Awakened Feather\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:awakened_feather\",\"count\":1}}},{\"text\":\", a book into a \"},{\"text\":\"Taboo Book\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:taboo_book\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:book_of_binding_foliot\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"With blue dye they make a \"},{\"text\":\"Book of Binding: Foliot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:book_of_binding_foliot\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Craft it with the Dictionary to write a name in.\"}]",
    "{@pagebreak}",
    "The dye sets the tier: blue Foliot, purple Djinni, yellow Afrit, green Marid.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Which name you get is decoration.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Only the tier counts.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Six at once: fill a \"},{\"text\":\"Chiseled Bookshelf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:chiseled_bookshelf\",\"count\":1}}},{\"text\":\" with books and sneak-use the Dictionary on it.\"}]"
  ],
  "quest.195DB7C39D08F1A7.title": "Divination Rod",
  "quest.195DB7C39D08F1A7.quest_subtitle": "Dowsing, with better eyesight.",
  "quest.195DB7C39D08F1A7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A \"},{\"text\":\"Spirit Attuned Gem\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:spirit_attuned_gem\",\"count\":1}}},{\"text\":\" set in gold and glass.\"}]",
    "",
    "Sneak-use it on andesite, oak wood, oak leaves or netherrack to attune it to their Otherworld twin, then hold right-click.",
    "{@pagebreak}",
    "Theurgy is in this pack, so the rod answers with a trail of particles toward the find instead of an outline.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The rod's crystals tell distance: white is nothing found, and the more purple, the closer.\"}]"
  ],
  "quest.36C42226788C6281.title": "The Spirit Attuned Crystal",
  "quest.36C42226788C6281.quest_subtitle": "Four diamonds' worth of patience.",
  "quest.36C42226788C6281.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four Spirit Attuned Gems in a square.\"}]",
    "",
    "Crystals steady unstable pentacles, and from the Afrit tier on most pentacles want four or eight.",
    "",
    "[\"\",{\"text\":\"It is also Occultism's share of the act IV \"},{\"text\":\"Spectral Lens\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:spectral_lens\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Short on diamonds? \"},{\"text\":\"Ars Ocultas\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6644EE1A37239BF7\"}},{\"text\":\" imbues the gems from Source Gems.\"}]"
  ],
  "quest.5CB156A16604FA31.title": "Chalk wears out",
  "quest.5CB156A16604FA31.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Every glyph spends chalk. A Djinni repairs any chalk on Strigeor's Higher Binding for three Otherworld Essence and a Spirit Attuned Gem, and Malum's Repair Pylon mends white, yellow, purple and red with eight arcane spirits: the pack ships those four recipes fixed.\"}]"
  ],
  "quest.053EFFA5CEA3E9E0.title": "Demon's Dream for the common store",
  "quest.053EFFA5CEA3E9E0.quest_subtitle": "The spirits eat first.",
  "quest.053EFFA5CEA3E9E0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Thirty-two \"},{\"text\":\"Demon's Dream Fruits\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:datura\",\"count\":1}}},{\"text\":\" for the common store, once a day.\"}]",
    "",
    "Spiritfire, healing spirits and the dimensional battlefield's fuel all run on it."
  ],
  "task.3380AF2584E7B8C6.title": "Summon a Foliot Crusher",
  "quest.1CA9462AE1EC919A.title": "Aviar's Circle",
  "quest.1CA9462AE1EC919A.quest_subtitle": "Ore doubling, with a pulse.",
  "quest.1CA9462AE1EC919A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"One circle, four ingots and a Foliot that doubles your ore.\"}]",
    "",
    "[\"\",{\"text\":\"Set the golden bowl down, draw \"},{\"text\":\"Aviar's Circle\",\"italic\":true},{\"text\":\" around it in white chalk with four candles, and put an iron, a gold, a copper and a silver ingot in the bowls.\"}]",
    "{@pagebreak}",
    "Right-click the golden bowl with the bound Foliot book: purple particles mean it took.",
    "",
    "The Foliot Crusher picks up ores dropped near it and turns each into two dusts.",
    "",
    "Djinni, Afrit and Marid crushers make three, four and six."
  ],
  "quest.0F3A72F66AD6AC52.title": "Any silver will do",
  "quest.0F3A72F66AD6AC52.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Rituals ask for tags, not mods: any silver ingot fills the crusher's bowl. Almost Unified merges duplicate metals, so recipes that make silver hand out Immersive Engineering's.\"}]"
  ],
  "quest.63C6B6180B77CA54.title": "Yellow chalk",
  "quest.63C6B6180B77CA54.quest_subtitle": "Spirits, now with bodies.",
  "quest.63C6B6180B77CA54.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Yellow glyphs turn a summoning into a possession.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Impure white chalk, glowstone dust and two gold dusts, purified in spiritfire.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"The crusher makes the dust, and so do Immersive Engineering and Mekanism.\"}]",
    "",
    "The spirit takes a body instead of its own shape."
  ],
  "quest.0A1B2A6A83AAAF8F.title": "Grey smoke: it's waiting",
  "quest.0A1B2A6A83AAAF8F.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Grey particles over the golden bowl and nothing consumed: the ritual wants an item used within \"},{\"text\":\"16\",\"color\":\"#CE8BFF\"},{\"text\":\" blocks, or a sacrifice killed by a player within \"},{\"text\":\"8\",\"color\":\"#CE8BFF\"},{\"text\":\". Kills by machines don't count.\"}]"
  ],
  "task.33500511937AA794.title": "Kill a Possessed Endermite",
  "quest.4E9DB6E8CEC581C6.title": "End stone without the End",
  "quest.4E9DB6E8CEC581C6.quest_subtitle": "It visits the End so you don't have to.",
  "quest.4E9DB6E8CEC581C6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"One thrown egg, and a Possessed Endermite pays in End Stone.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Draw \"},{\"text\":\"Hedyrin's Lure\",\"italic\":true},{\"text\":\": colorless and yellow glyphs, four candles.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Put dirt and stone twice in the bowls and start it with the Foliot book.\"}]",
    "",
    "[\"\",{\"text\":\"When the smoke turns grey, throw an \"},{\"text\":\"Egg\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:egg\",\"count\":1}}},{\"text\":\": it drops one or two \"},{\"text\":\"End Stone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:end_stone\",\"count\":1}}},{\"text\":\", every time.\"}]"
  ],
  "quest.5ECD62C10AC28D2B.title": "Purple chalk",
  "quest.5ECD62C10AC28D2B.quest_subtitle": "Put a Foliot in it. It'll work harder.",
  "quest.5ECD62C10AC28D2B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Impure white chalk, crushed end stone and two obsidian dusts, then spiritfire.\"}]",
    "",
    "Purple is the infusion color: the ritual binds a spirit into an object instead of calling it out.",
    "",
    "[\"\",{\"text\":\"Eziveus' Spectral Compulsion\",\"italic\":true},{\"text\":\", the Foliot infusion, wants purple, colorless glyphs and eight candles.\"}]"
  ],
  "quest.360C63CD62EEDB62.title": "Otherworld Goggles",
  "quest.360C63CD62EEDB62.quest_subtitle": "Enlightenment, now with a prescription.",
  "quest.360C63CD62EEDB62.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A permanent Third Eye, and it even shows iesnium ore.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:lenses\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Glass panes around a Spirit Attuned Gem make \"},{\"text\":\"Glass Lenses\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:lenses\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:infused_lenses\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A Foliot infusion with two silver and a gold ingot turns them into \"},{\"text\":\"Infused Lenses\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:infused_lenses\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Add a \"},{\"text\":\"Lens Frame\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:lens_frame\",\"count\":1}}},{\"text\":\" and leather.\"}]",
    "{@pagebreak}",
    "They show, they don't harvest.",
    "",
    "Breaking an Otherworld block for its true drop still takes Demon's Dream or an Infused or Iesnium Pickaxe."
  ],
  "quest.2F116E61C2089619.title": "Research Fragment Dust",
  "quest.2F116E61C2089619.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Emerald dust and two \"},{\"text\":\"Bottles o' Enchanting\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:experience_bottle\",\"count\":1}}},{\"text\":\" on the Foliot infusion: the spirit grinds experience into \"},{\"text\":\"dust\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:research_fragment_dust\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Lime chalk needs it, and later the iesnium bowl and the knowledge tablet."
  ],
  "quest.2FDA25063F13E2DD.title": "Light gray and lime",
  "quest.2FDA25063F13E2DD.quest_subtitle": "Second tier. The spirits read the fine print.",
  "quest.2FDA25063F13E2DD.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two chalks, second tier: one strengthens white, the other lures Djinni.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Light gray: impure white chalk with silver, iron and calcite dusts, a stronger foundation that stands in for white almost everywhere.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Lime: adds research dust, emerald dust and a slime ball, and lures Djinni.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Their pentacles also want \"},{\"text\":\"skeleton skulls\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"41C2DC9AECD6B6D0\"}},{\"text\":\".\"}]"
  ],
  "quest.11E684A9434F73CD.title": "Read the table",
  "quest.11E684A9434F73CD.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The Dictionary's Pentacles tab is a table: each row a ritual type, each column a spirit tier. Draw a pentacle once and every tier up is an upgrade of the same drawing; four \"},{\"text\":\"19\",\"color\":\"#CE8BFF\"},{\"text\":\"-block squares hold them all.\"}]"
  ],
  "quest.41C2DC9AECD6B6D0.title": "Skulls on demand",
  "quest.41C2DC9AECD6B6D0.quest_subtitle": "A bone to pick.",
  "quest.41C2DC9AECD6B6D0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Hedyrin's Lure with four bones and a chicken as the sacrifice: a Foliot raises a skeleton and possesses it.\"}]",
    "",
    "[\"\",{\"text\":\"The Possessed Skeleton ignores daylight and always drops a \"},{\"text\":\"Skeleton Skull\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:skeleton_skull\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Djinni summonings want four skulls.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Djinni infusions, eight.\"}]"
  ],
  "task.558FF11EBCA45173.title": "Possess a witch",
  "task.1064AB9DF4323337.title": "Possess a phantom",
  "quest.4C39CBA3E1BA49CD.title": "Hedyrin's other catches",
  "quest.4C39CBA3E1BA49CD.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The lure calls more than endermites.\"}]",
    "",
    "A glass bottle, redstone and two mushrooms with a chicken give a Possessed Witch, whose drops include Bottles o' Enchanting.",
    "",
    "[\"\",{\"text\":\"Leather and feathers with a bat, bee, parrot or allay give a Possessed Phantom and one to four \"},{\"text\":\"Phantom Membranes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:phantom_membrane\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.57D4D0D6C014C7D4.title": "The Apprentice Ritual Satchel",
  "quest.57D4D0D6C014C7D4.quest_subtitle": "Pentacles to go.",
  "quest.57D4D0D6C014C7D4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Foliot infusion of a hopper, a dispenser, wool, leather, string and silver.\"}]",
    "",
    "Fill it with chalk, candles and skulls, anchor a Dictionary preview, and right-click the preview with the satchel: it sets the pentacle block by block."
  ],
  "quest.4DD282FC85BCA251.title": "A pickaxe with a Djinni inside",
  "quest.4DD282FC85BCA251.quest_subtitle": "The Djinni did not sign up for this.",
  "quest.4DD282FC85BCA251.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three Spirit Attuned Gems make a \"},{\"text\":\"Spirit Attuned Pickaxe Head\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:spirit_attuned_pickaxe_head\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"With two sticks and two silver ingots, infuse it on \"},{\"text\":\"Strigeor's Higher Binding\",\"italic\":true},{\"text\":\", \"},{\"text\":\"eight skulls\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"41C2DC9AECD6B6D0\"}},{\"text\":\" and all, with a Book of Binding dyed purple.\"}]",
    "",
    "It mines iesnium ore, but it's brittle: get your first iesnium and make a real pick."
  ],
  "quest.3E8773D95C626DDC.title": "Iesnium",
  "quest.3E8773D95C626DDC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"In the Nether it passes for netherrack.\"}]",
    "",
    "[\"\",{\"text\":\"The goggles show it, a rod attuned to netherrack points at it, and only an Infused or Iesnium Pickaxe breaks it for \"},{\"text\":\"Raw Iesnium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:raw_iesnium\",\"count\":1}}},{\"text\":\", which smelts into ingots.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Fortune works.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Silk Touch gives a stable ore any pickaxe can mine.\"}]"
  ],
  "quest.0DACD7FB4D755D9F.title": "Iesnium Pickaxe",
  "quest.0DACD7FB4D755D9F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three \"},{\"text\":\"Iesnium Ingots\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:iesnium_ingot\",\"count\":1}}},{\"text\":\" and two sticks: a lasting pick for Otherworld ores.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Keep a few on hand.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Every miner spirit's ritual eats one.\"}]"
  ],
  "task.0B39EF39FB3E5311.title": "Possess an enderman",
  "task.07F6E6B01A776037.title": "Possess a ghast",
  "task.0D04BE0FD1CFD69A.title": "Possess a blaze",
  "quest.43ECC510994B503E.title": "Ihagan's Enthrallment",
  "quest.43ECC510994B503E.quest_subtitle": "Nether and End drops, by appointment.",
  "quest.43ECC510994B503E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The Djinni possession pentacle farms the Nether and the End from home.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_pearl\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A Possessed Enderman (a pig) always drops an \"},{\"text\":\"Ender Pearl\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_pearl\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ghast_tear\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A Possessed Ghast (a cow) a \"},{\"text\":\"Ghast Tear\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ghast_tear\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:blaze_rod\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A Possessed Blaze (a chicken) two to six \"},{\"text\":\"Blaze Rods\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:blaze_rod\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "task.1FA1397DB9988EED.title": "Call a villager",
  "quest.0A5441852CB56BEA.title": "A villager, to order",
  "quest.0A5441852CB56BEA.quest_subtitle": "Human resources.",
  "quest.0A5441852CB56BEA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A spirit takes a villager's shape, and it counts as a human sacrifice.\"}]",
    "",
    "Ihagan's Enthrallment with a bed, a campfire and a pie, then a Bottle o' Enchanting used when the smoke turns grey.",
    "",
    "Several later rituals want a human sacrifice."
  ],
  "quest.5F4B6EB6C68DE635.title": "Gray chalk",
  "quest.5F4B6EB6C68DE635.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Gray is the third foundation, and it starts as a paste.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:gray_paste\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Gunpowder, a clay ball, a Phantom Membrane and gray dye on Strigeor's Higher Binding give \"},{\"text\":\"Gray Paste\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:gray_paste\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"With impure white chalk it makes gray chalk.\"}]",
    "",
    "Afrit pentacles need gray or black wherever they show dark glyphs.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Gray Paste also crafts some dusts back into their minerals: emerald, lapis, obsidian, amethyst, echo shards.\"}]"
  ],
  "quest.6FABB369F5895D94.title": "Orange chalk",
  "quest.6FABB369F5895D94.quest_subtitle": "Honey, but make it haunted.",
  "quest.6FABB369F5895D94.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Possess a bee and its honey turns cursed.\"}]",
    "",
    "Ihagan's Enthrallment with honeycomb, a honey block, a honey bottle and a honeycomb block, plus a chicken: a Djinni possesses a bee that keeps its stinger and calls friends when hit.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:cursed_honey\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"It is the only source of \"},{\"text\":\"Cursed Honey\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:cursed_honey\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"With glow berries and blaze powder, the honey makes orange chalk.\"}]"
  ],
  "task.6104BDB308593B64.title": "Kill the Unbound Afrit",
  "quest.2C1E92621CCD380C.title": "Kandar's Open Conjure",
  "quest.2C1E92621CCD380C.quest_subtitle": "You called it. It's your problem now.",
  "quest.2C1E92621CCD380C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The first Afrit comes unbound, and it doesn't come to chat.\"}]",
    "",
    "[\"\",{\"text\":\"An Afrit called on purpose with nothing to hold it: netherrack, an iesnium ingot, \"},{\"text\":\"Flint and Steel\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:flint_and_steel\",\"count\":1}}},{\"text\":\" and gunpowder, a Book of Binding dyed yellow and a cow as the sacrifice.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:afrit_essence\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Kill it for \"},{\"text\":\"Afrit Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:afrit_essence\",\"count\":1}}},{\"text\":\": nothing else drops it.\"}]",
    "{@pagebreak}",
    "The pentacle has no red chalk.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"Unbound spirits attack everything near them. Call it far from home, in good armor, with potions ready.\"}]"
  ],
  "quest.63072CA991C42FDB.title": "Red chalk",
  "quest.63072CA991C42FDB.quest_subtitle": "Third tier. The contracts get serious.",
  "quest.63072CA991C42FDB.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Impure white chalk, Afrit Essence, a \"},{\"text\":\"Torchflower\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:torchflower\",\"count\":1}}},{\"text\":\" and redstone dust, purified in spiritfire.\"}]",
    "",
    "[\"\",{\"text\":\"Red glyphs hold an Afrit to your will: \"},{\"text\":\"Abras' Conjure\",\"italic\":true},{\"text\":\" summons one, \"},{\"text\":\"Posuc's Convocation\",\"italic\":true},{\"text\":\" makes one possess, \"},{\"text\":\"Sevira's Permanent Confinement\",\"italic\":true},{\"text\":\" binds one into objects.\"}]"
  ],
  "quest.407A60E2360F572F.title": "The Artisanal Ritual Satchel",
  "quest.407A60E2360F572F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The apprentice satchel, promoted: whole pentacles in one click.\"}]",
    "",
    "An Afrit takes over the satchel: upgrade the apprentice one with Afrit Essence and four ender pearls on Sevira's circle, contents kept.",
    "",
    "Used on the golden bowl, it packs an intact pentacle back up."
  ],
  "quest.6D7E55F1FBFCD366.title": "The Iesnium Ritual Bowl",
  "quest.6D7E55F1FBFCD366.quest_subtitle": "For summoners with somewhere to be.",
  "quest.6D7E55F1FBFCD366.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"It takes the golden bowl's place at the center of any pentacle and runs every ritual in a quarter of the time.\"}]",
    "",
    "Sevira's Permanent Confinement with a golden bowl, research dust, a Spirit Attuned Crystal, a block of iesnium and Afrit Essence.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Hang a sacrificial bowl upside down above the central bowl, up to three blocks up, and crafted results land in it instead of popping out.\"}]"
  ],
  "task.1DAF164C0D2872C0.title": "Possess a hoglin",
  "task.1AEB3789E20195F3.title": "Possess a shulker",
  "quest.0C49A13D32C096C4.title": "Posuc's Convocation",
  "quest.0C49A13D32C096C4.quest_subtitle": "Templates without the bastion.",
  "quest.0C49A13D32C096C4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Afrit possession, crystals included.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:netherite_upgrade_smithing_template\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A Possessed Hoglin (netherite scrap, porkchops, a crystal and a pig) can drop a \"},{\"text\":\"Netherite Upgrade\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:netherite_upgrade_smithing_template\",\"count\":1}}},{\"text\":\" or give the scrap back.\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:shulker_shell\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A Possessed Shulker (dragon's breath, purple glazed terracotta, end stone and a slime) drops one or two \"},{\"text\":\"Shulker Shells\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:shulker_shell\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Outside the Nether a hoglin turns zoglin after a while: kill it first.\"}]"
  ],
  "task.3EB8BE4F402CB1C4.title": "Possess a warden",
  "quest.044C780D22936829.title": "A warden on a leash",
  "quest.044C780D22936829.quest_subtitle": "Six sculk and a cow. Worth it.",
  "quest.044C780D22936829.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Posuc's Convocation with six sculk and a cow as the sacrifice: an Afrit wears a Warden.\"}]",
    "",
    "[\"\",{\"text\":\"It always drops six to nine \"},{\"text\":\"Echo Shards\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:echo_shard\",\"count\":1}}},{\"text\":\", the raw stuff of cyan chalk, and sometimes a disc fragment or a trim.\"}]",
    "",
    "Run, and it digs back down like any warden."
  ],
  "quest.635B924428B70C33.title": "Pink chalk",
  "quest.635B924428B70C33.quest_subtitle": "Pork, fire and a questionable contract.",
  "quest.635B924428B70C33.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A possessed piglin's meat makes pink chalk, three pieces at a time.\"}]",
    "",
    "[\"\",{\"text\":\"Odus' Open Convocation\",\"italic\":true},{\"text\":\" makes an Afrit possess a zombified piglin without red chalk: gilded blackstone, warped and crimson fungus and quartz, the Afrit book and a pig.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:demonic_meat\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"The Possessed Zombified Piglin is the only source of \"},{\"text\":\"Demonic Meat\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:demonic_meat\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.1EFC2C35364A3693.title": "Green chalk",
  "quest.1EFC2C35364A3693.quest_subtitle": "Pesto for spirits.",
  "quest.1EFC2C35364A3693.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three each of leaves, saplings and seeds on the Foliot infusion: the spirit squeezes them into \"},{\"text\":\"Nature Paste\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:nature_paste\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "With impure white chalk it makes green chalk, the glyph wild spirits can't ignore.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Nature Paste and cobblestone craft mossy cobblestone.\"}]"
  ],
  "quest.284793BE6235E376.title": "Light blue chalk",
  "quest.284793BE6235E376.quest_subtitle": "It never melts. Don't ask how.",
  "quest.284793BE6235E376.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Impure white chalk with crushed ice, crushed packed ice and crushed blue ice.\"}]",
    "",
    "[\"\",{\"text\":\"A Foliot Crusher melts ice, so this takes a \"},{\"text\":\"Djinni Crusher\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3E436D1792543A16\"}},{\"text\":\" or better.\"}]",
    "",
    "The glyphs are inert and steady the wild pentacles."
  ],
  "task.0C7F8C1C847F834F.title": "Call the Wild Hunt",
  "quest.11A513C5F99884D1.title": "The Wild Hunt",
  "quest.11A513C5F99884D1.quest_subtitle": "They hunt. You provide the venue.",
  "quest.11A513C5F99884D1.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Wild spirits get an open door: pink, green and light blue glyphs, no candles, no protection.\"}]",
    "",
    "[\"\",{\"text\":\"Osorin's Unbound Calling\",\"italic\":true},{\"text\":\" starts with a \"},{\"text\":\"Skeleton Skull\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:skeleton_skull\",\"count\":1}}},{\"text\":\", with copper, silver and gold blocks, a diamond, netherrack and soul sand in the bowls, and a human sacrifice.\"}]",
    "{@pagebreak}",
    "The Hunt answers: Greater Spirits shaped like wither skeletons, nearly untouchable until their skeleton minions fall.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"They drop \"},{\"text\":\"Wither Skeleton Skulls\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:wither_skeleton_skull\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Marid pentacles take four.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A villager counts as a human sacrifice. So does a player. Bring the villager.\"}]"
  ],
  "task.77A12E53BD753221.title": "Forge a Budding Amethyst",
  "task.420FE0C6518E30F1.title": "Forge Reinforced Deepslate",
  "quest.305BA499CA315EE5.title": "Forged by wild spirits",
  "quest.305BA499CA315EE5.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Some wild rituals bind nothing: the spirits forge an item and leave.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"An amethyst block, six amethyst dusts and a pig make \"},{\"text\":\"Budding Amethyst\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:budding_amethyst\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Deepslate, iron bars, obsidian and an iesnium ingot, paid with a warden, make \"},{\"text\":\"Reinforced Deepslate\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:reinforced_deepslate\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Possessed mobs count as their plain kind for sacrifices: a Possessed Warden pays for the deepslate.\"}]"
  ],
  "task.413B9ED44FD2B926.title": "Call a Wild Weak Breeze",
  "task.49C6DA72C97202FD.title": "Call a Wild Breeze",
  "task.0A9B56959D165173.title": "Call a Wild Strong Breeze",
  "quest.224E1F69351C3783.title": "Trial by breeze",
  "quest.224E1F69351C3783.quest_subtitle": "Three keys, no chamber.",
  "quest.224E1F69351C3783.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two breezes, two keys: the first opens the second ritual.\"}]",
    "",
    "[\"\",{\"text\":\"A honeycomb with four copper blocks and four tuff bricks calls a Wild Weak Breeze that drops a \"},{\"text\":\"Trial Key\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:trial_key\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ominous_trial_key\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"That key starts the next ritual, whose breeze drops an \"},{\"text\":\"Ominous Trial Key\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ominous_trial_key\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"That one calls the Wild Strong Breeze and its \"},{\"text\":\"Heavy Core\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:heavy_core\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Each costs a villager."
  ],
  "task.5474C8BBA2E93CAC.title": "Call a husk horde",
  "task.694920EAEDAFDA08.title": "Call a drowned horde",
  "task.30DD8832DDE2449F.title": "Call a silverfish horde",
  "quest.189C192C7E1E8EF6.title": "Hordes for sherds",
  "quest.189C192C7E1E8EF6.quest_subtitle": "Archaeology, minus the brushing.",
  "quest.189C192C7E1E8EF6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Osorin's circle also calls wild hordes, five at a time.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Husks drop desert sherds and the dune trim.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Drowned drop ocean sherds, turtle and sniffer eggs and tridents.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Silverfish drop trail-ruin sherds, four trims and the relic disc.\"}]"
  ],
  "task.4AFE931C4459760A.title": "Call a Wild Illager Invasion",
  "quest.5994EC33E05AD7DF.title": "An invasion you ordered",
  "quest.5994EC33E05AD7DF.quest_subtitle": "Totems, delivered by hand. Theirs.",
  "quest.5994EC33E05AD7DF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Order an invasion and keep the totems.\"}]",
    "",
    "A golden apple, three dark oak logs and three emerald dusts, plus a human sacrifice, call a Wild Evoker and his crew.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:totem_of_undying\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"The evoker drops \"},{\"text\":\"Totems of Undying\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:totem_of_undying\",\"count\":1}}},{\"text\":\" and the vex and sentry trims.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"The Afrit stabilizer and the Marid miner both eat totems.\"}]"
  ],
  "task.19405AED60C7208C.title": "Call a creeper horde",
  "quest.57A93FE444150288.title": "Mixtape from beyond",
  "quest.57A93FE444150288.quest_subtitle": "Five creepers, all charged, all opinions.",
  "quest.57A93FE444150288.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"You called a Wild Horde of Creepers with \"},{\"text\":\"Flint and Steel\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:flint_and_steel\",\"count\":1}}},{\"text\":\" on Osorin's circle.\"}]",
    "",
    "They come charged, five at a time, and each drops one to three music discs, the ones a skeleton's arrow usually has to earn."
  ],
  "reward.39864DB8F5A4029D.title": "Secret found",
  "task.6C9F164E1B176627.title": "Forge a Bell",
  "quest.1B1BFCC1E67DAA02.title": "For whom the bell was forged",
  "quest.1B1BFCC1E67DAA02.quest_subtitle": "Ask not.",
  "quest.1B1BFCC1E67DAA02.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Wild spirits forged you a \"},{\"text\":\"Bell\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:bell\",\"count\":1}}},{\"text\":\", and a goat paid the bill.\"}]",
    "",
    "The recipe: a gold block, gold nuggets, a chain, stone and a log. Every village without one can finally stop pretending."
  ],
  "reward.47D4EC2194956E23.title": "Secret found",
  "quest.59B8673D231F55EE.title": "Black chalk",
  "quest.59B8673D231F55EE.quest_subtitle": "Fourth foundation, forged from the Wither's share.",
  "quest.59B8673D231F55EE.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The strongest foundation: it replaces every colorless glyph.\"}]",
    "",
    "[\"\",{\"text\":\"Sevira's Permanent Confinement with netherite dust, a \"},{\"text\":\"Wither Skeleton Skull\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:wither_skeleton_skull\",\"count\":1}}},{\"text\":\", crushed blackstone and a \"},{\"text\":\"Wither Rose\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:wither_rose\",\"count\":1}}},{\"text\":\" gives three \"},{\"text\":\"Witherite Dust\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:witherite_dust\",\"count\":1}}},{\"text\":\": one black chalk.\"}]"
  ],
  "quest.3DE2FD1DF100C63B.title": "A conduit, by possession",
  "quest.3DE2FD1DF100C63B.quest_subtitle": "Heart of the sea, on appointment.",
  "quest.3DE2FD1DF100C63B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The Marid wants a \"},{\"text\":\"Conduit\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:conduit\",\"count\":1}}},{\"text\":\", and an Elder Guardian will pay for it.\"}]",
    "",
    "Posuc's Convocation with prismarine bricks, dark prismarine, a sea lantern, a water bucket and an emerald, and any fish: an Afrit possesses an Elder Guardian.",
    "",
    "[\"\",{\"text\":\"It drops two to four \"},{\"text\":\"Nautilus Shells\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:nautilus_shell\",\"count\":1}}},{\"text\":\" and, \"},{\"text\":\"40%\",\"color\":\"#CE8BFF\"},{\"text\":\" of the time, a \"},{\"text\":\"Heart of the Sea\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:heart_of_the_sea\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "task.545E35A4AE1B5C9E.title": "Kill the Unbound Marid",
  "quest.52E803E1AC79FF90.title": "Tibira's Attraction",
  "quest.52E803E1AC79FF90.quest_subtitle": "Legendary, if you survive it.",
  "quest.52E803E1AC79FF90.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Black chalk opens \"},{\"text\":\"Tibira's Attraction\",\"italic\":true},{\"text\":\", an Afrit-sized pentacle that calls a Marid and binds nothing.\"}]",
    "",
    "[\"\",{\"text\":\"A Conduit, prismarine crystals, a prismarine shard and a ghast tear go in the bowls, a Book of Binding dyed green starts it, and at the grey smoke you use a \"},{\"text\":\"Trident\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:trident\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Kill it for \"},{\"text\":\"Marid Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:marid_essence\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.4337313ECB14CF3D.title": "Blue chalk",
  "quest.4337313ECB14CF3D.quest_subtitle": "Fourth tier. Read everything twice.",
  "quest.4337313ECB14CF3D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Impure white chalk, Marid Essence, lapis dust and a tube coral.\"}]",
    "",
    "[\"\",{\"text\":\"Blue glyphs overpower a Marid: \"},{\"text\":\"Fatma's Incentivized Attraction\",\"italic\":true},{\"text\":\" summons one, \"},{\"text\":\"Xeovrenth Adjure\",\"italic\":true},{\"text\":\" makes one possess, \"},{\"text\":\"Uphyxes Inverted Tower\",\"italic\":true},{\"text\":\" binds one into objects.\"}]",
    "",
    "[\"\",{\"text\":\"Every Marid pentacle is \"},{\"text\":\"21\",\"color\":\"#CE8BFF\"},{\"text\":\" blocks across.\"}]"
  ],
  "quest.2DD8C1C18855F572.title": "The True Sight Staff",
  "quest.2DD8C1C18855F572.quest_subtitle": "Seeing is harvesting.",
  "quest.2DD8C1C18855F572.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Harvest Otherworld blocks by hand, and search for any block with your rods.\"}]",
    "",
    "A Marid infusion of a netherite ingot, an Iesnium Pickaxe, Otherworld Goggles, a Divination Rod, Otherworld Essence and Marid Essence.",
    "",
    "It works in the off-hand or a curio slot."
  ],
  "quest.14454992886C61FD.title": "Brown chalk",
  "quest.14454992886C61FD.quest_subtitle": "An alignment test with one wrong answer.",
  "quest.14454992886C61FD.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The Goat of Mercy is the only source of Cruelty Essence.\"}]",
    "",
    "Xeovrenth Adjure calls it: pointed dripstone, rabbit feet, armadillo scutes and wool in the bowls, the Marid book and a human sacrifice.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:cruelty_essence\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Kill the goat for \"},{\"text\":\"Cruelty Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:cruelty_essence\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"With cocoa beans and a brown mushroom it makes brown chalk.\"}]"
  ],
  "quest.10BB6D93F4A64E5B.title": "Cyan chalk",
  "quest.10BB6D93F4A64E5B.quest_subtitle": "The oldest color on record.",
  "quest.10BB6D93F4A64E5B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Impure white chalk, iesnium dust, \"},{\"text\":\"Echo Dust\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:echo_dust\",\"count\":1}}},{\"text\":\" and a \"},{\"text\":\"Glow Ink Sac\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:glow_ink_sac\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Only a \"},{\"text\":\"Marid Crusher\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"26FEE7CF2C363E14\"}},{\"text\":\" grinds an echo shard without ruining it.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A \"},{\"text\":\"possessed warden\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"044C780D22936829\"}},{\"text\":\" keeps you in shards.\"}]"
  ],
  "quest.2B039873C1090434.title": "Magenta chalk",
  "quest.2B039873C1090434.quest_subtitle": "Dragon's breath, bottled and ground.",
  "quest.2B039873C1090434.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Magenta is priced in dragon's breath.\"}]",
    "",
    "[\"\",{\"text\":\"Uphyxes Inverted Tower\",\"italic\":true},{\"text\":\" with two amethyst dusts, crushed end stone, four \"},{\"text\":\"End Crystals\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:end_crystal\",\"count\":1}}},{\"text\":\" and three \"},{\"text\":\"Dragon's Breath\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:dragon_breath\",\"count\":1}}},{\"text\":\" makes one \"},{\"text\":\"Dragonyst Dust\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:dragonyst_dust\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "With amethyst dust and chorus fruit it becomes magenta chalk."
  ],
  "quest.2544F516F6A9D36A.title": "The Celestial Chalice",
  "quest.2544F516F6A9D36A.quest_subtitle": "Rituals at the speed of thought.",
  "quest.2544F516F6A9D36A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Ronaza's Contact\",\"italic\":true},{\"text\":\" reaches the Eldritch spirits, and their service is instant.\"}]",
    "",
    "Twelve blocks (a heavy core, reinforced deepslate, a netherite block, a respawn anchor, a sculk catalyst among them), a ravager, and the iesnium bowl as the key: the chalice runs any ritual at once.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Built from the dark iesnium bowl instead, it comes out as the Eldritch Chalice, same power.\"}]"
  ],
  "quest.21E542A0FB078F6A.title": "Every color in one stick",
  "quest.21E542A0FB078F6A.quest_subtitle": "Sixteen colors, one pocket.",
  "quest.21E542A0FB078F6A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The last circle pays with a stick that draws any glyph.\"}]",
    "",
    "[\"\",{\"text\":\"Ronaza's Contact is a \"},{\"text\":\"21\",\"color\":\"#CE8BFF\"},{\"text\":\"-block pentacle of cyan, magenta, brown and the three wild colors, set with a beacon, an enchanting table, a lodestone and five other oddities.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Twelve colored chalks, a \"},{\"text\":\"Chalk Brush\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:brush\",\"count\":1}}},{\"text\":\" and a sheep buy its best service: the \"},{\"text\":\"Rainbow Chalk\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:chalk_rainbow\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Hold a dye in the other hand to pick the color, and sneak-use it on a glyph to erase it.",
    "",
    "The circle is drawn. Every spirit in the Dictionary answers to it now."
  ],
  "task.11836A140C04C24B.title": "Draw with the Void Chalk",
  "quest.2457FF8BC9A7EFF5.title": "Silence, in chalk",
  "quest.2457FF8BC9A7EFF5.quest_subtitle": "...",
  "quest.2457FF8BC9A7EFF5.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"You drew with the \"},{\"text\":\"Void Chalk\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:chalk_void\",\"count\":1}}},{\"text\":\": white, light gray, gray and black forged into one, paid with a human sacrifice.\"}]",
    "",
    "It stands in for any glyph and flickers between white and black. The Eldritch spirits declined to elaborate."
  ],
  "reward.2790999FB4AA2833.title": "Secret found",
  "quest.1A6B65C6B83CF7C7.title": "Light the candles",
  "quest.1A6B65C6B83CF7C7.quest_subtitle": "Ambience, as required.",
  "quest.1A6B65C6B83CF7C7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Ten wicks, one match, no witnesses.\"}]",
    "",
    "No reward: just light."
  ],
  "image.08E5331C103EA473.title": "Back to the Sun of Heliodor",
  "image.0E5DF840A7DA82E0.title": "[\"\",{\"text\":\"OCCULTISM\",\"color\":\"#F3EEDF\",\"bold\":true}]",
  "image.0865E19EB7B9F6BE.title": "[\"\",{\"text\":\"Rituals\",\"color\":\"#B9A7E0\"}]",
  "image.0BDD8A6E741176C5.title": "[\"\",{\"text\":\"chalk bowl true name\",\"color\":\"#8F7FBF\",\"font\":\"minecraft:alt\"}]",
  "image.1439E014414B2607.title": "[\"\",{\"text\":\"» Spirits and storage\",\"color\":\"#E8B04A\"}]",
  "image.3187410603D10F46.title": "The purple chalk closes the rose",
  "image.4567AFC4E5CAD19F.title": "A Foliot, summoned",
  "image.1B352E98D9A93DBD.title": "A Djinni, bound",
  "image.5D5E357B76CFC8B5.title": "An Afrit, unbound",
  "image.60186B21536D7417.title": "The Wild Hunt answers",
  "image.40E220F4898EDCB9.title": "A Marid, in the water of the circle",
  "image.37F46B6D0BF83D8F.title": "[\"\",{\"text\":\"Foliot possessions\",\"color\":\"#B9A7E0\"}]",
  "image.297F0C5EC6F2100B.title": "[\"\",{\"text\":\"Djinni possessions\",\"color\":\"#B9A7E0\"}]",
  "image.09E6CCBAC40F970F.title": "[\"\",{\"text\":\"Afrit possessions\",\"color\":\"#B9A7E0\"}]",
  "image.15552F97B145ED24.title": "[\"\",{\"text\":\"Wild rituals\",\"color\":\"#B9A7E0\"}]",
  "chapter.0B73BDE318224662.title": "Reliquary",
  "chapter.0B73BDE318224662.chapter_subtitle": [
    "Monster parts become relics: a bottomless tear, a handgun, an apothecary and pedestals that put it all to work."
  ],
  "task.4B0F0F4B0A5BB51C.title": "Any monster part",
  "quest.4046BADD160B83AA.title": "One trophy per monster",
  "quest.4046BADD160B83AA.quest_subtitle": "Every monster carries a souvenir.",
  "quest.4046BADD160B83AA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Kill it yourself and the monster might leave you a part.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Monsters you kill yourself get \"},{\"text\":\"2\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E3B955\"},{\"text\":\" tries at dropping a part, about \"},{\"text\":\"2%\",\"color\":\"#E3B955\"},{\"text\":\" each.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Blazes, ghasts, cave spiders and zombified piglins, \"},{\"text\":\"3%\",\"color\":\"#E3B955\"},{\"text\":\".\"}]",
    "",
    "Looting raises one try and Severing the other. The part's tooltip names its mob.",
    "{@pagebreak}",
    "Parts aren't crafted here, only won.",
    "",
    "Old chests keep a few:",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Dungeons\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Mineshafts\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Temples\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Strongholds\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Nether fortresses\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"End cities\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Igloos\"}]"
  ],
  "quest.1602FCCE67071632.title": "The Void Tear",
  "quest.1602FCCE67071632.quest_subtitle": "A pocket with no bottom. Finally.",
  "quest.1602FCCE67071632.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A ghast tear, a \"},{\"text\":\"Nebulous Heart\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:nebulous_heart\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Slime Pearl\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:slime_pearl\",\"count\":1}}},{\"text\":\" and lapis.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Right-click an empty one and it swallows the item you carry most of, up to two billion.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and right-click keeps it vacuuming.\"}]",
    "",
    "Use it on a chest to pour in or pull out.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and scroll picks what it leaves in your inventory: nothing, one stack, or as many stacks as fit.\"}]"
  ],
  "quest.72F59AF80955C0B0.title": "Keep a spare tear",
  "quest.72F59AF80955C0B0.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Only an empty \"},{\"text\":\"Void Tear\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:void_tear\",\"count\":1}}},{\"text\":\" goes into a recipe, and empty ones stack to \"},{\"text\":\"16\",\"color\":\"#E3B955\"},{\"text\":\". Make a few: the chalice, the Infernal Tear, the Touchstone, the Harvest Rod, the Rending Gale and the ender, torch and ice staffs each eat one.\"}]"
  ],
  "quest.0D1D01C3A723C11C.title": "The Emperor's Chalice",
  "quest.0D1D01C3A723C11C.quest_subtitle": "Water for life. Yours, a little.",
  "quest.0D1D01C3A723C11C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"An emerald, a gold ingot, a bucket and an empty Void Tear make a water bucket that never runs dry.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and right-click switches it to soaking water up instead.\"}]",
    "",
    "Aimed at nothing, it's a cup: each sip gives food and takes health, as drowning damage."
  ],
  "quest.4802FE87BB88938D.title": "Claw and essence",
  "quest.4802FE87BB88938D.quest_subtitle": "The glue of half the relics.",
  "quest.4802FE87BB88938D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two workshop parts the relics keep asking for.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"An \"},{\"text\":\"Infernal Claw\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:infernal_claw\",\"count\":1}}},{\"text\":\" is leather, a Molten Core, a Rib Bone and a Slime Pearl.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Fertile Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:fertile_essence\",\"count\":1}}},{\"text\":\" is a Rib Bone, a Catalyzing Gland, green dye and a Slime Pearl.\"}]"
  ],
  "quest.3F66B42978A29BEB.title": "Coin of Fortune",
  "quest.3F66B42978A29BEB.quest_subtitle": "Heads you win. Tails you also win.",
  "quest.3F66B42978A29BEB.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Nebulous Heart, a gold nugget, a Slime Pearl and a Bat Wing.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Switched on with \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and right-click, it pulls items and experience from \"},{\"text\":\"5\",\"color\":\"#E3B955\"},{\"text\":\" blocks around.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Hold right-click and it reaches \"},{\"text\":\"15\",\"color\":\"#E3B955\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"keybind.reliquary.fortune_coin\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" switches it from your inventory or the Curios necklace slot. It ships unbound: set it in Controls.\"}]"
  ],
  "quest.52A9060E379A883A.title": "The Infernal Tear",
  "quest.52A9060E379A883A.quest_subtitle": "It turns clutter into levels.",
  "quest.52A9060E379A883A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"An empty Void Tear, a Witch Hat, a Molten Core and an Infernal Claw.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and right-click: it takes the item on its list you carry most of and burns it into experience.\"}]",
    "",
    "[\"\",{\"text\":\"Iron is worth \"},{\"text\":\"6\",\"color\":\"#E3B955\"},{\"text\":\" points, a diamond \"},{\"text\":\"32\",\"color\":\"#E3B955\"},{\"text\":\", a nether star \"},{\"text\":\"192\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E3B955\"},{\"text\":\".\"}]"
  ],
  "quest.6B7CA145EEF35E33.title": "A bank for your XP",
  "quest.6B7CA145EEF35E33.quest_subtitle": "A savings account that levels up.",
  "quest.6B7CA145EEF35E33.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Nebulous Heart, the Coin, a Witch Hat and the Infernal Tear.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Switched on, it soaks up your experience and spends it mending your Mending gear.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Switched off, each right-click pays levels back.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and scroll sets how many.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"On a pedestal it's a tank: pipes fill it with other mods' liquid experience and drain Reliquary's, and a running pedestal spends it repairing Mending gear on pedestals within \"},{\"text\":\"5\",\"color\":\"#E3B955\"},{\"text\":\" blocks.\"}]"
  ],
  "task.5FC8C704B16F80F4.title": "Any display pedestal",
  "quest.7E50F06A485B4F37.title": "A place to show it",
  "quest.7E50F06A485B4F37.quest_subtitle": "Every relic deserves a stand.",
  "quest.7E50F06A485B4F37.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A carpet, some quartz and a little gold: the hall's first plinth.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"A carpet on a quartz block, two gold nuggets and three quartz slabs make a \"},{\"text\":\"Display Pedestal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:pedestals/passive/white_passive_pedestal\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"The carpet picks its colour.\"}]",
    "",
    "It only shows off what you set on it."
  ],
  "task.22FCA4663F9E07DD.title": "Any pedestal",
  "quest.2DF1BCA7D91D6E9F.title": "Pedestals that work",
  "quest.2DF1BCA7D91D6E9F.quest_subtitle": "Set it down. It keeps working.",
  "quest.2DF1BCA7D91D6E9F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four diamonds around a Display Pedestal.\"}]",
    "",
    "It runs the item set on it while switched on. Any of these switches it on:",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Right-click its switch with an empty hand\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"A redstone signal\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"A redstone block on another pedestal: it switches on every pedestal within \"},{\"text\":\"10\",\"color\":\"#E3B955\"},{\"text\":\" blocks\"}]"
  ],
  "quest.45821A9CDF41BE5A.title": "Pedestal jobs",
  "quest.45821A9CDF41BE5A.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"What a pedestal does depends on what sits on it:\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:iron_sword\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A sword swings at mobs within \"},{\"text\":\"5\",\"color\":\"#E3B955\"},{\"text\":\" blocks, sparing bosses, pets and babies\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:bucket\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A bucket milks cows and scoops up fluids within \"},{\"text\":\"4\",\"color\":\"#E3B955\"},{\"text\":\" blocks into tanks beside it\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:shears\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Shears clip sheep and leaves\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:fishing_rod\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A fishing rod fishes; pair it with the Coin to collect\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Relics work there too: the Coin pulls drops into chests beside it, the Harvest Rod tends crops within \"},{\"text\":\"4\",\"color\":\"#E3B955\"},{\"text\":\" blocks, a Mob Charm keeps its monster off players within \"},{\"text\":\"21\",\"color\":\"#E3B955\"},{\"text\":\" blocks and the Rending Gale lends flight.\"}]"
  ],
  "quest.3D7F21C902B6A1AC.title": "Angelic Feather",
  "quest.3D7F21C902B6A1AC.quest_subtitle": "Falling, now with a service charge.",
  "quest.3D7F21C902B6A1AC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A feather, a Nebulous Heart, a Bat Wing and Fertile Essence.\"}]",
    "",
    "Anywhere in your inventory it turns fall damage into hunger and adds a little jump.",
    "",
    "Mineshafts and desert and jungle temples sometimes hide one."
  ],
  "quest.538232CAD306FDE3.title": "Three Angelheart Vials",
  "quest.538232CAD306FDE3.quest_subtitle": "Emergency hearts, sold in threes.",
  "quest.538232CAD306FDE3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A milk bucket, an Infernal Claw, two Fertile Essences and five glass panes.\"}]",
    "",
    "When a hit would kill you, a vial shatters instead, heals a quarter of your health and clears bad effects.",
    "",
    "Stronghold chests keep a few."
  ],
  "quest.632F3641C05B1EF2.title": "Phoenix Down",
  "quest.632F3641C05B1EF2.quest_subtitle": "Death, postponed.",
  "quest.632F3641C05B1EF2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three Angelheart Vials and an Angelic Feather.\"}]",
    "",
    "When a hit would kill you, it brings you back at full health with resistance and regeneration, plus fire resistance or water breathing if fire or water got you, and turns back into the feather.",
    "",
    "Until then it also works as the feather: falls cost hunger, not health."
  ],
  "quest.59048BB167D66A6D.title": "Gun parts",
  "quest.59048BB167D66A6D.quest_subtitle": "Some assembly required.",
  "quest.59048BB167D66A6D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Bring about thirty iron.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"The \"},{\"text\":\"Empty Magazine\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:magazines/empty_magazine\",\"count\":1}}},{\"text\":\" is iron, glass and stone.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"The barrel adds two Nebulous Hearts and magma cream, the grip an Empty Magazine and magma cream, the hammer a blaze rod, a Molten Core and a stone button.\"}]"
  ],
  "quest.399F5E31880D8EC7.title": "The Hunter's Handgun",
  "quest.399F5E31880D8EC7.quest_subtitle": "Magic, with a trigger.",
  "quest.399F5E31880D8EC7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The three parts, a Slime Pearl and five iron.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Right-click fires.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Hold it with a loaded magazine in your inventory to reload eight shots, and the empty magazine comes back.\"}]",
    "",
    "[\"\",{\"text\":\"Fire rate, reload and kick improve with every XP level up to \"},{\"text\":\"20\",\"color\":\"#E3B955\"},{\"text\":\".\"}]"
  ],
  "quest.501B16652F594FF3.title": "Load a magazine",
  "quest.501B16652F594FF3.quest_subtitle": "Eight in, eight out.",
  "quest.501B16652F594FF3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Flint, two gold nuggets and gunpowder make eight \"},{\"text\":\"Neutral Shots\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:bullets/neutral_bullet\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Eight shots around an Empty Magazine load it. Every shot you fire leaves an \"},{\"text\":\"Empty Casing\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:bullets/empty_bullet\",\"count\":1}}},{\"text\":\" behind.\"}]"
  ],
  "quest.09F8CB7937C5A8F6.title": "Two guns, one rhythm",
  "quest.09F8CB7937C5A8F6.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"With a handgun in each hand the two take turns, so you shoot about twice as often. Four \"},{\"text\":\"Empty Casings\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:bullets/empty_bullet\",\"count\":1}}},{\"text\":\" make a gold nugget back.\"}]"
  ],
  "quest.7AC2F1CEEA2BEB03.title": "Eight kinds of shot",
  "quest.7AC2F1CEEA2BEB03.quest_subtitle": "The right bullet for the wrong day.",
  "quest.7AC2F1CEEA2BEB03.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Most shots are gunpowder and gold nuggets plus one extra:\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Lapis makes Seeker, which chases its target\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"A slimeball, Concussive, a small blast\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Sandstone and a slimeball, Sand, which blinds\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Two Catalyzing Glands, Storm, stronger in rain\"}]",
    "",
    "Blaze swaps the gunpowder for blaze powder and a rod: it burns.",
    "{@pagebreak}",
    "Upgrades take eight shots and a part:",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Neutral and a Zombie Heart make Exorcism, brutal on the undead\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Seeker and a Nebulous Heart make Ender, which also pierces\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Concussive and a Catalyzing Gland make Buster, a TNT-sized blast that breaks blocks\"}]"
  ],
  "quest.3FEC3C3AAC632325.title": "Mortar and pestle",
  "quest.3FEC3C3AAC632325.quest_subtitle": "Grind first, ask questions later.",
  "quest.3FEC3C3AAC632325.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Six quartz blocks and three Catalyzing Glands.\"}]",
    "",
    "[\"\",{\"text\":\"Put in two or three ingredients and right-click it five times with an empty hand: an effect two of them share becomes a \"},{\"text\":\"Potion Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:potion_essence\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Sugar and a gold nugget share Haste."
  ],
  "quest.601CA63963459A03.title": "The Apothecary Cauldron",
  "quest.601CA63963459A03.quest_subtitle": "Toil and trouble, mostly toil.",
  "quest.601CA63963459A03.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A cauldron with two Catalyzing Glands, three Nebulous Hearts, two Infernal Claws and a Molten Core.\"}]",
    "",
    "Set it over fire, lava or a campfire, fill it with a water bucket, add a Potion Essence and nether wart: eight seconds later the brew is ready."
  ],
  "task.3D5117F41508503A.title": "Any condensed potion",
  "quest.1063B9D521B2B524.title": "Bottle the brew",
  "quest.1063B9D521B2B524.quest_subtitle": "Three sips per bucket.",
  "quest.1063B9D521B2B524.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Five glass panes make a \"},{\"text\":\"Condensed Potion Vial\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:empty_potion_vial\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "A finished cauldron fills three per bucket of water, and one potion can carry several effects at once."
  ],
  "quest.79D88FB8AB5CF2BB.title": "Season the brew",
  "quest.79D88FB8AB5CF2BB.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Add them with the essence:\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Up to three redstone: the potion lasts longer\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Up to two glowstone: it gets stronger\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Gunpowder: it becomes a splash potion\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Gunpowder and dragon's breath: a lingering one\"}]"
  ],
  "quest.259C9E212300D607.title": "Bottles to throw",
  "quest.259C9E212300D607.quest_subtitle": "Holy water, garden spray, love potion.",
  "quest.259C9E212300D607.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Made to be thrown, not drunk.\"}]",
    "",
    "[\"\",{\"text\":\"Glowing Water\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:glowing_water\",\"count\":1}}},{\"text\":\" (a water bucket, glowstone, nether wart, gunpowder, glass panes) splashes the undead hard.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"The Fertile Potion bonemeals where it lands.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Aphrodite's Serum puts nearby animals in the mood.\"}]",
    "",
    "Both take Fertile Essence.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Three bread and a Glowing Water bake three \"},{\"text\":\"Glowing Bread\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:glowing_bread\",\"count\":1}}},{\"text\":\": one fills your hunger bar.\"}]"
  ],
  "quest.2D1FEE859BB50ACB.title": "Arrows with a brew",
  "quest.2D1FEE859BB50ACB.quest_subtitle": "Robin Hood went to pharmacy school.",
  "quest.2D1FEE859BB50ACB.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight arrows around a Lingering Condensed Potion make eight \"},{\"text\":\"Tipped Arrows\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:tipped_arrow\",\"count\":1}}},{\"text\":\" with all its effects.\"}]",
    "",
    "Eight handgun shots around the same potion come out tipped too, and a magazine keeps it."
  ],
  "quest.6A52ABC658E4ADEE.title": "Count to three",
  "quest.6A52ABC658E4ADEE.quest_subtitle": "Then throw it. Not before.",
  "quest.6A52ABC658E4ADEE.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A big blast with good manners.\"}]",
    "",
    "[\"\",{\"text\":\"Glowing Water, a gold nugget, TNT and a Catalyzing Gland make four \"},{\"text\":\"Holy Hand Grenades\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:holy_hand_grenade\",\"count\":1}}},{\"text\":\": a big blast that hurts only your enemies and breaks no blocks.\"}]"
  ],
  "reward.2D827E67E09B224F.title": "Secret found",
  "quest.0D04899BFA835765.title": "Touchstone of Midas",
  "quest.0D04899BFA835765.quest_subtitle": "Gold that heals gold.",
  "quest.0D04899BFA835765.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"An anvil, two gold blocks, three Molten Cores, two Catalyzing Glands and an empty Void Tear.\"}]",
    "",
    "[\"\",{\"text\":\"Switched on with \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and right-click, it soaks up glowstone dust, four charges each, and spends one per repair on the gold tools, weapons and armour you carry.\"}]"
  ],
  "quest.12BB08BAA577106A.title": "Twilight Cloak",
  "quest.12BB08BAA577106A.quest_subtitle": "Dress code: darkness.",
  "quest.12BB08BAA577106A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Invisible wherever the light gives out.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Crimson Cloth is red and black wool with two Nebulous Hearts.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Three of it, four black wool and two iron make the cloak.\"}]",
    "",
    "[\"\",{\"text\":\"Switched on with \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and right-click, it hides you from mobs wherever the light is \"},{\"text\":\"4\",\"color\":\"#E3B955\"},{\"text\":\" or less, even when you hit them.\"}]"
  ],
  "quest.1C667558A576F2E1.title": "From the deep",
  "quest.1C667558A576F2E1.quest_subtitle": "Calamari, but make it armour.",
  "quest.1C667558A576F2E1.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two ways to make peace with the sea.\"}]",
    "",
    "[\"\",{\"text\":\"Three Squid Beaks and a Slime Pearl make a Kraken Shell Fragment; three fragments and a Nebulous Heart, the \"},{\"text\":\"Kraken Shell\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:kraken_shell\",\"count\":1}}},{\"text\":\": drowning costs hunger instead of health.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The Serpent Staff (two Chelicerae, an eye of ender, a fragment, a stick) spits poison that drains life and calms its target for \"},{\"text\":\"15\",\"color\":\"#E3B955\"},{\"text\":\" seconds.\"}]"
  ],
  "quest.5211737DB3C3FFAB.title": "Peace treaties with mobs",
  "quest.5211737DB3C3FFAB.quest_subtitle": "Diplomacy, one species at a time.",
  "quest.5211737DB3C3FFAB.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Six fragments, and that mob stops seeing you.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"A zombie's Charm Fragment is six Zombie Hearts, two rotten flesh and a bone.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Other mobs follow the pattern.\"}]",
    "",
    "[\"\",{\"text\":\"Six fragments, leather and string make its \"},{\"text\":\"Mob Charm\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:mob_charm\",\"count\":1}}},{\"text\":\": that mob ignores you even when you hit it.\"}]",
    "",
    "[\"\",{\"text\":\"Each kill of it wears the charm by \"},{\"text\":\"1\",\"color\":\"#E3B955\"},{\"text\":\" of \"},{\"text\":\"80\",\"color\":\"#E3B955\"},{\"text\":\".\"}]",
    "{@pagebreak}",
    "Other monsters, modded ones included, drop their own fragments now and then.",
    "",
    "[\"\",{\"text\":\"Five fragments and three leather make the Charm Belt, which holds every charm and fits the \"},{\"text\":\"Curios\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"56867C76555F0B5F\"}},{\"text\":\" belt slot.\"}]"
  ],
  "quest.7D66240090D3242C.title": "Friends with fire",
  "quest.7D66240090D3242C.quest_subtitle": "The Nether, but cosy.",
  "quest.7D66240090D3242C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three single claws and a Slime Pearl make the \"},{\"text\":\"Infernal Claws\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:infernal_claws\",\"count\":1}}},{\"text\":\": fire, not lava, costs hunger instead of health.\"}]",
    "",
    "The Salamander's Eye, held, puts out flames around you and bats ghast fireballs back.",
    "",
    "[\"\",{\"text\":\"The Infernal Chalice carries \"},{\"text\":\"500\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E3B955\"},{\"text\":\" buckets of lava and trades fire and lava damage for hunger.\"}]",
    "{@pagebreak}",
    "The Pyromancer's Staff (the claws, the eye, an Infernal Tear and a blaze rod) shoots blaze and ghast fireballs, fed with blaze powder and fire charges, and swallows the ones thrown at you."
  ],
  "quest.51649DEF1D6F4C0F.title": "Tools with a trick",
  "quest.51649DEF1D6F4C0F.quest_subtitle": "Fishing for pockets.",
  "quest.51649DEF1D6F4C0F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two tools, two tricks: one steals, one clears.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:rod_of_lyssa\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"The \"},{\"text\":\"Rod of Lyssa\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:rod_of_lyssa\",\"count\":1}}},{\"text\":\" (an Infernal Claw, a Bat Wing, a Nebulous Heart, a fishing rod) reels in mobs and items.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Hook one while sneaking and it steals something, more reliably the higher your level.\"}]",
    "{@pagebreak}",
    "The Destruction Catalyst clears a 3×3×3 cube of plain stone, dirt or netherrack for three gunpowder, and drops nothing."
  ],
  "quest.4CB4E091ADE69433.title": "Witherless Rose",
  "quest.4CB4E091ADE69433.quest_subtitle": "Kill four Withers to stop fearing the fifth.",
  "quest.4CB4E091ADE69433.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four nether stars, four Fertile Essences and a rose bush.\"}]",
    "",
    "While it's in your inventory, the wither effect can't touch you.",
    "",
    "[\"\",{\"text\":\"Here nether stars come only from the \"},{\"text\":\"Wither\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"617F3D63E49031FA\"}},{\"text\":\", so it's a late, deliberate buy.\"}]"
  ],
  "quest.704767047C143491.title": "Ender Staff and Wraith Node",
  "quest.704767047C143491.quest_subtitle": "Pearls, but polite.",
  "quest.704767047C143491.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Pearls that never hurt you, and a way home.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"The staff swallows ender pearls, up to \"},{\"text\":\"250\",\"color\":\"#E3B955\"},{\"text\":\", and throws ones that don't hurt you.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Long cast flies straighter and farther.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Bind it to a \"},{\"text\":\"Wraith Node\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:wraith_node\",\"count\":1}}},{\"text\":\" (a Nebulous Heart and an emerald) and, in node mode, holding right-click takes you back there, same dimension only.\"}]"
  ],
  "quest.3AE6FEA5D618D686.title": "The Rending Gale",
  "quest.3AE6FEA5D618D686.quest_subtitle": "Your own private storm.",
  "quest.3AE6FEA5D618D686.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Flight, lightning and a wind with a temper.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Fed feathers, it flies you where you point.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and scroll switch it to push, pull or lightning in a thunderstorm.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Two Bat Wings, an Eye of the Storm, gold, an empty Void Tear, a stick and, in this pack, an act IV \"},{\"text\":\"Zanite Gemstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aether:zanite_gemstone\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"It has no fall protection: point down and hold to land softly.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"On a running pedestal in flight mode, every player within \"},{\"text\":\"30\",\"color\":\"#E3B955\"},{\"text\":\" blocks can fly.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"End city chests hide one now and then.\"}]"
  ],
  "quest.1F2BD5D642D742F3.title": "Never place a torch again",
  "quest.1F2BD5D642D742F3.quest_subtitle": "Paranoid, and right.",
  "quest.1F2BD5D642D742F3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Darkness stops being your problem.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"The Sojourner's Staff stores \"},{\"text\":\"1,500\",\"color\":\"#E3B955\"},{\"text\":\" of each light and places them up to \"},{\"text\":\"30\",\"color\":\"#E3B955\"},{\"text\":\" blocks away\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"The \"},{\"text\":\"Lantern of Paranoia\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:lantern_of_paranoia\",\"count\":1}}},{\"text\":\", switched on, sets torches around you wherever the light drops to zero\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"The Interdiction Torch pushes mobs back within \"},{\"text\":\"5\",\"color\":\"#E3B955\"},{\"text\":\" blocks\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The staff takes torches, lanterns, glowstone and more, and places one extra per \"},{\"text\":\"6\",\"color\":\"#E3B955\"},{\"text\":\" blocks.\"}]"
  ],
  "quest.564CB92AB2A60BF4.title": "The cold line",
  "quest.564CB92AB2A60BF4.quest_subtitle": "Chill. Literally.",
  "quest.564CB92AB2A60BF4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Snowballs that hurt, and a staff that freezes lava.\"}]",
    "",
    "[\"\",{\"text\":\"The Ice Magus Rod (two diamonds, a Frozen Core, an empty Void Tear, iron) stores \"},{\"text\":\"250\",\"color\":\"#E3B955\"},{\"text\":\" snowballs and fires ones that hurt, hardest on blazes and fireproof mobs.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Add another tear, a Frozen Core and the Shears of Winter and it becomes the \"},{\"text\":\"Glacial Staff\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:glacial_staff\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"The staff also freezes water into packed ice and lava into obsidian around you.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Both melt back once you leave.\"}]",
    "",
    "The Shears of Winter (a Frozen Core, shears, two diamonds) shear sheep and strip leaves all around while you hold right-click."
  ],
  "quest.47B3F1FBA7A0719F.title": "Harvest Rod and lily pads",
  "quest.47B3F1FBA7A0719F.quest_subtitle": "Farming, in bulk.",
  "quest.47B3F1FBA7A0719F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A whole patch under one held click.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"The \"},{\"text\":\"Harvest Rod\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:harvest_rod\",\"count\":1}}},{\"text\":\" (an empty Void Tear, Fertile Essence, two rose bushes, two vines, a stick) stores bone meal and seeds.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Hold right-click to bonemeal, plant or hoe a \"},{\"text\":\"5×5\",\"color\":\"#E3B955\"},{\"text\":\" area.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Three Fertile Essences on a lily pad make a Lilypad of Fertility that speeds crops within \"},{\"text\":\"4\",\"color\":\"#E3B955\"},{\"text\":\" blocks.\"}]"
  ],
  "quest.3C7E7A384AC7FC77.title": "The night shift",
  "quest.3C7E7A384AC7FC77.quest_subtitle": "Eight monsters, eight souvenirs.",
  "quest.3C7E7A384AC7FC77.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Learn who drops what before the night shift starts.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Zombies, husks and zombie villagers give hearts.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Skeletons and strays, ribs.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Spiders, chelicerae.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Creepers, glands.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Slimes, bats, endermen and witches finish the set. Hoard the \"},{\"text\":\"Witch Hat\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:witch_hat\",\"count\":1}}},{\"text\":\": two relics need one.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Bats dodge swords, not a \"},{\"text\":\"Seeker Shot\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7AC2F1CEEA2BEB03\"}},{\"text\":\".\"}]"
  ],
  "quest.26DF67BD7AB6A016.title": "Trophies from far away",
  "quest.26DF67BD7AB6A016.quest_subtitle": "Pack for the Nether, the sea and the snow.",
  "quest.26DF67BD7AB6A016.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Blazes and magma cubes give Molten Cores; wither skeletons, Withered Ribs; squid, beaks; guardians, spikes.\"}]",
    "",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Frozen Core\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:frozen_core\",\"count\":1}}},{\"text\":\" comes from snow golems, or from igloo chests four times in ten.\"}]"
  ],
  "quest.75974F7E0E2DE9B1.title": "Blades for the hunt",
  "quest.75974F7E0E2DE9B1.quest_subtitle": "Fragile, golden and unfair.",
  "quest.75974F7E0E2DE9B1.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Bring a better blade to the second try.\"}]",
    "",
    "[\"\",{\"text\":\"Severing, a rare sword enchantment up to V, powers the second try: \"},{\"text\":\"12%\",\"color\":\"#E3B955\"},{\"text\":\" at I and \"},{\"text\":\"10%\",\"color\":\"#E3B955\"},{\"text\":\" more a level for most parts.\"}]",
    "",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Magicbane\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:magicbane\",\"count\":1}}},{\"text\":\" counts as two more levels of it, but breaks after \"},{\"text\":\"16\",\"color\":\"#E3B955\"},{\"text\":\" hits.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Cross of Mercy\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:mercy_cross\",\"count\":1}}},{\"text\":\" hits the undead harder.\"}]",
    "",
    "[\"\",{\"text\":\"Both are gold, so the \"},{\"text\":\"Touchstone of Midas\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0D04899BFA835765\"}},{\"text\":\" repairs them.\"}]"
  ],
  "quest.67E629F9FB07CC3A.title": "Spare parts",
  "quest.67E629F9FB07CC3A.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Parts break down in the crafting grid: a \"},{\"text\":\"Rib Bone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:rib_bone\",\"count\":1}}},{\"text\":\" into five bones, a \"},{\"text\":\"Nebulous Heart\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:nebulous_heart\",\"count\":1}}},{\"text\":\" into three ender pearls, two Molten Cores into four blaze rods, three Catalyzing Glands into a ghast tear.\"}]",
    "",
    "Three Withered Ribs and a skeleton skull make a wither skeleton skull."
  ],
  "task.045EC4801E0748A5.title": "Any 16 monster parts",
  "quest.17C02368C995638A.title": "Trophies for the common store",
  "quest.17C02368C995638A.quest_subtitle": "Somebody out there needs a Zombie Heart.",
  "quest.17C02368C995638A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The common store takes monster parts by the bag, any mix.\"}]",
    "",
    "What a long night of hunting leaves over becomes a crate."
  ],
  "quest.11E5AE0A0BED0295.title": "Lightning in a jar",
  "quest.11E5AE0A0BED0295.quest_subtitle": "That creeper had a very bad day.",
  "quest.11E5AE0A0BED0295.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Only a charged creeper drops an \"},{\"text\":\"Eye of the Storm\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:eye_of_the_storm\",\"count\":1}}},{\"text\":\", and only when a player kills it: two tries of about \"},{\"text\":\"3%\",\"color\":\"#E3B955\"},{\"text\":\".\"}]",
    "",
    "It breaks down into ten gunpowder, but the Rending Gale wants it whole."
  ],
  "reward.0305A7FBD81B22E7.title": "Secret found",
  "quest.42624A1953E3F0E1.title": "Altar of Light",
  "quest.42624A1953E3F0E1.quest_subtitle": "Photosynthesis for rocks.",
  "quest.42624A1953E3F0E1.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Obsidian, a redstone lamp, a Nebulous Heart and a Catalyzing Gland.\"}]",
    "",
    "[\"\",{\"text\":\"Right-click it with redstone three times: in daylight under open sky, some \"},{\"text\":\"20\",\"color\":\"#E3B955\"},{\"text\":\" minutes later a glowstone block grows on top.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"Its partner, the \"},{\"text\":\"Tome of Alkahestry\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"reliquary:alkahestry_tome\",\"count\":1}}},{\"text\":\", is gone from this pack.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E3B955\"},{\"text\":\"The altar works alone.\"}]"
  ],
  "quest.09A09F5AB3BF9AE8.title": "What the pack took away",
  "quest.09A09F5AB3BF9AE8.quest_subtitle": "No free diamonds. Sorry.",
  "quest.09A09F5AB3BF9AE8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The pack shut the duplicating shortcut.\"}]",
    "",
    "The Tome of Alkahestry and its copying recipes are gone: charged with redstone, it duplicated iron, gold, diamonds and even nether stars.",
    "",
    "Spawn eggs from Charm Fragments are gone too, so mob farms stay staged.",
    "{@pagebreak}",
    "The Witch Hat's info page still mentions the tome. Ignore that line."
  ],
  "quest.246DBC77952D5BF9.title": "Flip the switch",
  "quest.246DBC77952D5BF9.quest_subtitle": "Let there be exhibits.",
  "quest.246DBC77952D5BF9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Somebody has to switch on the hall lights.\"}]",
    "",
    "The curator's ceiling lamps take it from here."
  ],
  "quest.427C31F5A333F839.title": "Sign the guestbook",
  "quest.427C31F5A333F839.quest_subtitle": "Every museum has one.",
  "quest.427C31F5A333F839.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Name, date and one line about the Void Tear.\"}]",
    "",
    "The lectern by the door keeps the pen."
  ],
  "image.446B942BB03B2F93.title": "[\"\",{\"text\":\"The handgun\",\"color\":\"#F3E9CF\"}]",
  "image.40AF9E7554A06600.title": "[\"\",{\"text\":\"The apothecary\",\"color\":\"#F3E9CF\"}]",
  "image.07CB9BDFF118FFDE.title": "[\"\",{\"text\":\"The hunt\",\"color\":\"#F3E9CF\"}]",
  "image.431E2ADAC6164E9A.title": "Back to the Sun of Heliodor",
  "image.004D4ADC4937040D.title": "[\"\",{\"text\":\"RELIQUARY\",\"color\":\"#F3E9CF\",\"bold\":true}]",
  "image.5CA1DFCB543A63D6.title": "[\"\",{\"text\":\"hunt · craft · display\",\"color\":\"#E3B955\",\"font\":\"minecraft:uniform\"}]",
  "image.24815E5C17449B18.title": "[\"\",{\"text\":\"Relics that guard\",\"color\":\"#F3E9CF\"}]",
  "image.7989A98D0480350E.title": "[\"\",{\"text\":\"Relics that burn\",\"color\":\"#F3E9CF\"}]",
  "image.6446460252465A09.title": "[\"\",{\"text\":\"Home comforts\",\"color\":\"#F3E9CF\"}]",
  "image.59B8997D2B7565AA.title": "[\"\",{\"text\":\"Staffs\",\"color\":\"#F3E9CF\"}]",
  "image.596C9992F4BE2E1E.title": "[\"\",{\"text\":\"Alkahestry\",\"color\":\"#E3B955\"}]",
  "chapter.1B43556F7B974465.title": "Apotheosis · Spawners",
  "chapter.1B43556F7B974465.chapter_subtitle": [
    "Sixteen copper augments tune a spawner where it stands, one set per act from III to V. The flame grows with every act: ENTRELUMEN version of Apothic Spawners, with no runes."
  ],
  "task.76E7B6B79FF3082D.title": "Look at a Monster Spawner",
  "quest.46B4B2355B6D1190.title": "Spawners you tune in place",
  "quest.46B4B2355B6D1190.quest_subtitle": "You don't move the spawner. You move in.",
  "quest.46B4B2355B6D1190.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Every spawner has stats.\"}]",
    "",
    "Here you tune them in place.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Sixteen\",\"color\":\"#FF8A3D\"},{\"text\":\" copper augments, one set per act: \"},{\"text\":\"III\",\"color\":\"#FF8A3D\"},{\"text\":\", \"},{\"text\":\"IV\",\"color\":\"#FF8A3D\"},{\"text\":\", \"},{\"text\":\"V\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Each use moves one stat \"},{\"text\":\"one step\",\"color\":\"#FF8A3D\"},{\"text\":\", up to a cap.\"}]"
  ],
  "quest.2FA66A984D5CBF5F.title": "What a spawner knows",
  "quest.2FA66A984D5CBF5F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A dungeon spawner, by the numbers.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Waits \"},{\"text\":\"200 to 800\",\"color\":\"#FF8A3D\"},{\"text\":\" ticks between spawns.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Tries \"},{\"text\":\"4\",\"color\":\"#FF8A3D\"},{\"text\":\" mobs at a time and stops at \"},{\"text\":\"6\",\"color\":\"#FF8A3D\"},{\"text\":\" nearby.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Needs a player within \"},{\"text\":\"16\",\"color\":\"#FF8A3D\"},{\"text\":\" blocks; spawns within \"},{\"text\":\"4\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Look at it with Jade and hold \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.keyboard.left.control\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" to read its current stats.\"}]"
  ],
  "quest.3604CB1267C1BCF1.title": "Spawners stay put",
  "quest.3604CB1267C1BCF1.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Silk Touch can't lift a spawner in this pack.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Portable spawners would bring mob farms before their act.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Build around the one you find. Scout a few before you invest.\"}]"
  ],
  "quest.4A3E617E34F69B7F.title": "No runes here",
  "quest.4A3E617E34F69B7F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Apotheosis \"},{\"text\":\"8.7\",\"color\":\"#FF8A3D\"},{\"text\":\" put spawner modifiers on runes.\"}]",
    "",
    "Not here.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Every modifier lives on a copper augment: \"},{\"text\":\"one route\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Spawner Chains\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apotheosis:spawner_chain\",\"count\":1}}},{\"text\":\" still drop from blown-up spawners, but craft nothing.\"}]"
  ],
  "quest.1130D1DBD5D17857.title": "Copper medallions",
  "quest.1130D1DBD5D17857.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Every augment is the same medallion:\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:sugar\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"its classic core in the middle, like \"},{\"text\":\"sugar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:sugar\",\"count\":1}}},{\"text\":\" or a \"},{\"text\":\"clock\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:clock\",\"count\":1}}},{\"text\":\";\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"create:copper_sheet\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"an act component on top and three \"},{\"text\":\"Copper Sheets\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"create:copper_sheet\",\"count\":1}}},{\"text\":\" around.\"}]",
    "",
    "EMI shows each one with its step and cap."
  ],
  "task.497457C6B927DEDB.title": "Enter a Nether fortress",
  "quest.482C3406948169E0.title": "Where spawners hide",
  "quest.482C3406948169E0.quest_subtitle": "Blazes by appointment.",
  "quest.482C3406948169E0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Spawners wait in the usual places.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Dungeons: zombies, skeletons, spiders.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Mineshafts: cave spiders. Nether fortresses: \"},{\"text\":\"blazes\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Caves: Apotheosis rogue spawners, each over a chest.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Blaze rods feed \"},{\"text\":\"Hellshelves\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:hellshelf\",\"count\":1}}},{\"text\":\", tomes and sigils.\"}]"
  ],
  "task.2FB15D1A02FFAF30.title": "Apply an augment to a spawner",
  "quest.323AF494EF14AD45.title": "Applying an augment",
  "quest.323AF494EF14AD45.quest_subtitle": "Right-click, and the cage listens.",
  "quest.323AF494EF14AD45.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Right-click the spawner with an augment in hand.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"The augment is spent; the stat moves \"},{\"text\":\"one step\",\"color\":\"#FF8A3D\"},{\"text\":\", up to its cap.\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:quartz\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"With \"},{\"text\":\"Nether Quartz\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:quartz\",\"count\":1}}},{\"text\":\" in the other hand it undoes one step instead. The quartz stays.\"}]"
  ],
  "quest.1CEB5CEB62360BE4.title": "Quickening",
  "quest.1CEB5CEB62360BE4.quest_subtitle": "Sugar for the cage.",
  "quest.1CEB5CEB62360BE4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Quickening\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:augment_min_delay\",\"count\":1}}},{\"text\":\": minimum delay \"},{\"text\":\"-10\",\"color\":\"#FF8A3D\"},{\"text\":\" ticks per use.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Down to \"},{\"text\":\"20\",\"color\":\"#FF8A3D\"},{\"text\":\" ticks.\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:sugar\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Core: \"},{\"text\":\"sugar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:sugar\",\"count\":1}}},{\"text\":\" on a \"},{\"text\":\"Power Regulator\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:power_regulator\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.72F86EDEBB547D84.title": "Hastening",
  "quest.72F86EDEBB547D84.quest_subtitle": "A clock, told to hurry.",
  "quest.72F86EDEBB547D84.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Hastening\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:augment_max_delay\",\"count\":1}}},{\"text\":\": maximum delay \"},{\"text\":\"-20\",\"color\":\"#FF8A3D\"},{\"text\":\" ticks per use.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Down to \"},{\"text\":\"20\",\"color\":\"#FF8A3D\"},{\"text\":\" ticks.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Below the minimum, the minimum wins: \"},{\"text\":\"lower both\",\"color\":\"#FF8C7A\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Core: a \"},{\"text\":\"clock\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:clock\",\"count\":1}}},{\"text\":\" on a \"},{\"text\":\"Power Regulator\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:power_regulator\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "task.3C93E2B31C8D75DD.title": "Bring a minimum delay down to 20",
  "quest.5806A46413A36138.title": "I am the fast",
  "quest.5806A46413A36138.quest_subtitle": "One spawn a second, if the maximum follows.",
  "quest.5806A46413A36138.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Minimum delay at \"},{\"text\":\"20\",\"color\":\"#FF8A3D\"},{\"text\":\" ticks: the cap.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"From a dungeon spawner: \"},{\"text\":\"18\",\"color\":\"#FF8A3D\"},{\"text\":\" Quickening Augments.\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:power_regulator\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Each one costs a \"},{\"text\":\"Power Regulator\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:power_regulator\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "task.73DD9F7372BFCE40.title": "Bring a maximum delay down to 20",
  "quest.5ABE61211BB79861.title": "Time-warped",
  "quest.5ABE61211BB79861.quest_subtitle": "Eight hundred ticks, folded into twenty.",
  "quest.5ABE61211BB79861.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Maximum delay at \"},{\"text\":\"20\",\"color\":\"#FF8A3D\"},{\"text\":\" ticks: the cap.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"From a dungeon spawner: \"},{\"text\":\"39\",\"color\":\"#FF8A3D\"},{\"text\":\" Hastening Augments.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"With the minimum at \"},{\"text\":\"20\",\"color\":\"#FF8A3D\"},{\"text\":\" too, it spawns \"},{\"text\":\"every second\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]"
  ],
  "quest.67C43166A62B1243.title": "Count before you craft",
  "quest.67C43166A62B1243.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Augments to each cap, from a dungeon spawner:\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Quickening \"},{\"text\":\"18\",\"color\":\"#FF8A3D\"},{\"text\":\" · Hastening \"},{\"text\":\"39\",\"color\":\"#FF8A3D\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Multitude \"},{\"text\":\"6\",\"color\":\"#FF8A3D\"},{\"text\":\" · Crowd \"},{\"text\":\"13\",\"color\":\"#FF8A3D\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Reach \"},{\"text\":\"8\",\"color\":\"#FF8A3D\"},{\"text\":\" · Spread \"},{\"text\":\"14\",\"color\":\"#FF8A3D\"},{\"text\":\" · Debilitating \"},{\"text\":\"16\",\"color\":\"#FF8A3D\"}]",
    "",
    "Each one eats its act component: automate them."
  ],
  "quest.527B9F06CC766C21.title": "Silent",
  "quest.527B9F06CC766C21.quest_subtitle": "Peace, quiet, and a very busy cage.",
  "quest.527B9F06CC766C21.quest_desc": [
