  "quest.1176AE6DA3431D93.title": "Ender Bee",
  "quest.1176AE6DA3431D93.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Lives in the \"},{\"text\":\"End Stone Nest\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:end_stone_nest\",\"count\":1}}},{\"text\":\", only in the End.\"}]",
