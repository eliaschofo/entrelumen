    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Up to \"},{\"text\":\"32\",\"color\":\"#FF8A3D\"},{\"text\":\". Keep that floor lit and open, or spawns fail.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Core: a \"},{\"text\":\"piston\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:piston\",\"count\":1}}},{\"text\":\" on a \"},{\"text\":\"Routing Matrix\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:routing_matrix\",\"count\":1}}},{\"text\":\".\"}]"
