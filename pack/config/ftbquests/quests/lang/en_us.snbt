  "quest.43C99D740412F605.title": "A thirstier dagger",
  "quest.43C99D740412F605.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The Enchanter puts Soul Siphoner on a dagger.\"}]",
