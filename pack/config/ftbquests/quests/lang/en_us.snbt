    "[\"\",{\"text\":\"• It works a \"},{\"text\":\"3×3\",\"bold\":true},{\"text\":\" patch; every upgrade tier adds a ring, up to \"},{\"text\":\"15×15\",\"bold\":true},{\"text\":\".\"}]"
