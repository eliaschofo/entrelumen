  "quest.162E139D9D4F412F.quest_desc": [
    "[\"\",{\"text\":\"Awakened Supremium Growth Accelerators\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:awakened_supremium_growth_accelerator\",\"count\":1}}},{\"text\":\" reach \"},{\"text\":\"54\",\"bold\":true},{\"text\":\" blocks.\"}]",
