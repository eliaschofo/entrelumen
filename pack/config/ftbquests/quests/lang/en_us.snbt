  "quest.67F53D7FCBA8E90B.quest_desc": [
    "[\"\",{\"text\":\"8\",\"bold\":true},{\"text\":\" essences give \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" \"},{\"text\":\"End Steel Ingots\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"enderio:end_steel_ingot\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Seed: \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"End Steel Ingots\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"enderio:end_steel_ingot\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Supremium Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:supremium_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"tier 5\",\"color\":\"#C4DE52\"},{\"text\":\".\"}]"
  ],
  "task.0EB8B4524BE06D0C.title": "16 essences from the bed",
