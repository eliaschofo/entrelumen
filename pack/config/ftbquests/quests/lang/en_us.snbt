    "[\"\",{\"text\":\"• \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" inferium and \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" inferium ingots turn it into the \"},{\"text\":\"Inferium Machine Upgrade\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:inferium_upgrade\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "• Each tier wraps the previous upgrade in four essences and four ingots of its own.",
