  "quest.77186F2E840A27EB.title": "Soulstone masonry",
  "quest.77186F2E840A27EB.quest_desc": [
    "Soulstone works like any stone.",
    "",
    "• Bricks, chiseled bricks, smooth, slabs, stairs and walls.",
