    "[\"\",{\"text\":\"• Then pick a bonus: \"},{\"text\":\"Supremium Growth Accelerators\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:supremium_growth_accelerator\",\"count\":1}}},{\"text\":\", fertilizer or essence.\"}]"
  ],
