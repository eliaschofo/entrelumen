    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Core: \"},{\"text\":\"wool\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:white_wool\",\"count\":1}}},{\"text\":\" on a \"},{\"text\":\"Handling Core\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:handling_core\",\"count\":1}}},{\"text\":\".\"}]"
