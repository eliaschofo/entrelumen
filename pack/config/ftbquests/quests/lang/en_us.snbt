  ],
  "quest.2441366B2A6BEDB8.title": "Awakened Supremium Bee",
  "quest.2441366B2A6BEDB8.quest_subtitle": "The crown jewel.",
  "quest.2441366B2A6BEDB8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"On an \"},{\"text\":\"Awakening Altar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:awakening_altar\",\"count\":1}}},{\"text\":\": a Supremium Bee egg and four awakened supremium blocks.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Plus twenty of each elemental essence.\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:awakened_supremium_essence\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Comb: \"},{\"text\":\"Awakened Supremium Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:awakened_supremium_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"10%\",\"bold\":true},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Gift:\",\"color\":\"#9BE08A\"},{\"text\":\" a second one, and a \"},{\"text\":\"perfect gene\",\"color\":\"#FFD84A\"},{\"text\":\" of your choice.\"}]"
  ],
  "quest.791ED9D0AF6167E2.title": "Soulium Bee",
  "quest.791ED9D0AF6167E2.quest_desc": [
