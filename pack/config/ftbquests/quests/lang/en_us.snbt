  ],
  "quest.5DCF5003DE90D8A8.title": "Diamond, the first big one",
  "quest.5DCF5003DE90D8A8.quest_subtitle": "Twenty points and a table full of ideas.",
  "quest.5DCF5003DE90D8A8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Same shape as iron, with toughness on top.\"}]",
    "",
    "[\"\",{\"text\":\"20\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E8B04A\"},{\"text\":\" armor points.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"24\",\"color\":\"#E8B04A\"},{\"text\":\" diamonds: \"},{\"text\":\"5\",\"color\":\"#E8B04A\"},{\"text\":\", \"},{\"text\":\"8\",\"color\":\"#E8B04A\"},{\"text\":\", \"},{\"text\":\"7\",\"color\":\"#E8B04A\"},{\"text\":\" and \"},{\"text\":\"4\",\"color\":\"#E8B04A\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Each piece also carries \"},{\"text\":\"2\",\"color\":\"#E8B04A\"},{\"text\":\" toughness, which blunts the biggest hits\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Enchantability is only \"},{\"text\":\"10\",\"color\":\"#E8B04A\"},{\"text\":\", but the pack's table climbs far past level 30: \"},{\"text\":\"Apotheosis · Enchanting\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"78409D0F30264A4E\"}}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Robes and other class sets start from a diamond or iron chestplate: \"},{\"text\":\"Ars Nouveau robes\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0B32EE7DA07573F6\"}},{\"text\":\".\"}]"
  ],
  "quest.4A0396714615DA1F.title": "Netherite upgrade template",
  "quest.4A0396714615DA1F.quest_subtitle": "One per piece. Bastions are generous.",
  "quest.4A0396714615DA1F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A bastion has the first one; the rest you copy.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Bastion chests: bridge, hoglin stable, other and treasure\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:emerald\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Solsticio's smith sells it: \"},{\"text\":\"48\",\"color\":\"#E8B04A\"},{\"text\":\" emeralds, from act IV. \"},{\"text\":\"The sixteen shops\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4AC078B71F8995FF\"}}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Copies: \"},{\"text\":\"7\",\"color\":\"#E8B04A\"},{\"text\":\" diamonds and a \"},{\"text\":\"Netherrack\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:netherrack\",\"count\":1}}},{\"text\":\" around the template make \"},{\"text\":\"2\",\"color\":\"#E8B04A\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"The template is spent on every piece: a full set is four templates.\"}]"
  ],
  "quest.366CB84368848221.title": "Netherite ingot",
  "quest.366CB84368848221.quest_subtitle": "Four scraps and four golds. Patience, mostly.",
  "quest.366CB84368848221.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four scrap and four gold, shapeless.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:netherite_scrap\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"One \"},{\"text\":\"Ancient Debris\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ancient_debris\",\"count\":1}}},{\"text\":\" smelts into one scrap, twice as fast in a blast furnace\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Mekanism triples it: \"},{\"text\":\"three scraps per debris\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FFBDA5C1966E63E\"}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"The dealer in rarities sells scrap for \"},{\"text\":\"4\",\"color\":\"#E8B04A\"},{\"text\":\" emerald blocks each, from act IV\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Keep the gold for last: four ingots are the cheap half.\"}]"
  ],
  "quest.224722532A1DBC7C.title": "Netherite, the base of it all",
  "quest.224722532A1DBC7C.quest_subtitle": "Diamond, upgraded. Everything after builds on it.",
  "quest.224722532A1DBC7C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Diamond plus an ingot plus a template, four times.\"}]",
    "",
    "[\"\",{\"text\":\"20\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E8B04A\"},{\"text\":\" armor points.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Toughness \"},{\"text\":\"3\",\"color\":\"#E8B04A\"},{\"text\":\" and knockback resistance \"},{\"text\":\"0.1\",\"color\":\"#E8B04A\"},{\"text\":\" a piece; it never burns in lava\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Ignitium, Cursium, Warden and the Luminous set are all smithed on top of netherite\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"A smithing table keeps enchantments and affixes through the upgrade\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Durability climbs too: the chestplate goes from \"},{\"text\":\"528\",\"color\":\"#E8B04A\"},{\"text\":\" to \"},{\"text\":\"592\",\"color\":\"#E8B04A\"},{\"text\":\".\"}]"
  ],
