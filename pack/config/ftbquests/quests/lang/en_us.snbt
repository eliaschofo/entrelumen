    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Craft a Diamond Bee egg ringed by \"},{\"text\":\"8×\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Arcane Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:arcane_essence\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:arcane_essence\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Comb: \"},{\"text\":\"Arcane Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:arcane_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"75%\",\"bold\":true},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"With an Iron Bee it also makes mithril.\"}]"
  ],
  "quest.2873E6392DAD24E6.title": "Super Experience Bee",
  "quest.2873E6392DAD24E6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Feed an \"},{\"text\":\"Experience Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7B43DE0FD900D675\"}},{\"text\":\" a \"},{\"text\":\"Super Enchanting Template\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"create_enchantment_industry:super_enchanting_template\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Its comb mixes into super experience in a Create mixer.\"}]"
  ],
  "quest.5C21D12EC528C301.title": "Bees that won't pair up",
  "quest.5C21D12EC528C301.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Many mod bees cannot breed with their own kind.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"The upper Mystical Agriculture tiers, the sky metals and the fusion bees each take another egg.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Park one in a hive and let the combs do the rest.\"}]"
  ],
  "quest.1B679D7140DCE2B3.title": "Eggs to order",
  "quest.1B679D7140DCE2B3.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Every bee in this crown starts as an egg fed to a machine.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Bottle a bee, spin the bottle, and purify its type gene to \"},{\"text\":\"100%\",\"bold\":true},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"A pure type gene on a treat hatches that egg every time in the incubator.\"}]"
  ],
  "quest.3D9B14EE69E4658D.title": "Inferium combs for the store",
  "quest.3D9B14EE69E4658D.quest_subtitle": "Essence by the comb.",
  "quest.3D9B14EE69E4658D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Sixteen Inferium Bee combs for the common store.\"}]",
    "",
    "Every essence there saves a seed somewhere else."
  ],
  "quest.65A7239838C2C68E.title": "Polish the crown",
  "quest.65A7239838C2C68E.quest_subtitle": "Five jewels, one rag.",
  "quest.65A7239838C2C68E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A crown that size collects fingerprints.\"}]",
    "",
    "No reward: the shine is the reward."
  ],
