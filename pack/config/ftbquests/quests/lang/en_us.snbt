  ],
  "quest.619FAACEEAA5DACE.title": "Spare seeds into essence",
  "quest.619FAACEEAA5DACE.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Seed Reprocessor\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:seed_reprocessor\",\"count\":1}}},{\"text\":\" turns every spare seed into \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" essences of its crop.\"}]",
