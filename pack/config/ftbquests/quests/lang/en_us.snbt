  "quest.17C390EAF2E2DFA8.quest_desc": [
    "The rest of Ender IO's metals.",
    "",
    "[\"\",{\"text\":\"• Harvest \"},{\"text\":\"16\",\"bold\":true},{\"text\":\" essences from any of its crops.\"}]",
