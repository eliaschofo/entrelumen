    "• On the record: one creeper essence, one skeleton essence and a dye; the dye picks the song."
  ],
  "quest.1DDA93C864ADF619.title": "Walls the Wither can't break",
  "quest.1DDA93C864ADF619.quest_subtitle": "Boss arena, some assembly required.",
  "quest.1DDA93C864ADF619.quest_desc": [
    "The Wither can't break these, and the Dragon can't damage them.",
    "",
    "[\"\",{\"text\":\"• Four wither skeleton essences around soulstone: a \"},{\"text\":\"Witherproof Block\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:witherproof_block\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Around soul glass: \"},{\"text\":\"Witherproof Glass\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:witherproof_glass\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "• The Dragon still flies straight through them."
  ],
  "quest.7429D142E01E50C5.title": "Pigstep, homegrown",
  "quest.7429D142E01E50C5.quest_subtitle": "Bastions hate this one trick.",
  "quest.7429D142E01E50C5.quest_desc": [
    "[\"\",{\"text\":\"A blank record with one nether, one netherite and one gold essence presses \"},{\"text\":\"Pigstep\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:music_disc_pigstep\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "• Otherwise it only turns up in bastion chests."
  ],
  "reward.37028C0C1BD92C93.title": "Secret found",
  "quest.49C5D52870DE19E7.title": "A heart, grown to order",
  "quest.49C5D52870DE19E7.quest_subtitle": "No treasure map required.",
  "quest.49C5D52870DE19E7.quest_desc": [
    "[\"\",{\"text\":\"Diamond, prismarine and squid essences around a nautilus shell make a \"},{\"text\":\"Heart of the Sea\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:heart_of_the_sea\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "• Prismarine with fish essence makes the shell."
  ],
  "reward.75708C4E692FB7A0.title": "Secret found",
  "quest.3DDB2166F4ACF858.title": "Mobs from essence",
  "quest.3DDB2166F4ACF858.quest_subtitle": "Agriculture, in reverse.",
  "quest.3DDB2166F4ACF858.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Soulium Spawner\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:soulium_spawner\",\"count\":1}}},{\"text\":\" turns mob essence back into the mob.\"}]",
    "",
    "[\"\",{\"text\":\"• Recipe: \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" wither skeleton skulls, \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" soulium ingots, iron and a frame.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"12\",\"bold\":true},{\"text\":\" essences for a pig, \"},{\"text\":\"16\",\"bold\":true},{\"text\":\" for a zombie, \"},{\"text\":\"24\",\"bold\":true},{\"text\":\" for a blaze, \"},{\"text\":\"32\",\"bold\":true},{\"text\":\" for a wither skeleton.\"}]",
    "",
    "[\"\",{\"text\":\"• Mobs appear within \"},{\"text\":\"3\",\"bold\":true},{\"text\":\" blocks.\"}]"
  ],
  "quest.59D4499CC9596240.title": "Enchantments without dice",
  "quest.59D4499CC9596240.quest_subtitle": "No lapis, no luck.",
  "quest.59D4499CC9596240.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Enchanter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:enchanter\",\"count\":1}}},{\"text\":\" puts the enchantment you pick on a tool or a book.\"}]",
    "",
    "[\"\",{\"text\":\"• Recipe: an enchanting table on a soulium ingot and \"},{\"text\":\"3\",\"bold\":true},{\"text\":\" soulstone.\"}]",
    "",
    "[\"\",{\"text\":\"• It costs experience essence and a themed item: \"},{\"text\":\"64\",\"bold\":true},{\"text\":\" essence and \"},{\"text\":\"16\",\"bold\":true},{\"text\":\" redstone for Efficiency.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Each multiple of the recipe adds a level, up to the enchantment's cap; a slot holds up to \"},{\"text\":\"512\",\"bold\":true},{\"text\":\".\"}]"
  ],
  "quest.27291BF52E3A7961.title": "Experience, bottled and planted",
  "quest.27291BF52E3A7961.quest_desc": [
    "[\"\",{\"text\":\"An \"},{\"text\":\"Experience Capsule\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:experience_capsule\",\"count\":1}}},{\"text\":\" soaks up the orbs you collect, up to \"},{\"text\":\"1200\",\"bold\":true},{\"text\":\" points.\"}]",
    "",
    "[\"\",{\"text\":\"• Recipe: \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" soulium ingots and \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" soul glass.\"}]",
    "",
    "[\"\",{\"text\":\"• Four full capsules on the pedestals make \"},{\"text\":\"Experience Seeds\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:experience_seeds\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"tier 4\",\"color\":\"#C4DE52\"},{\"text\":\".\"}]",
    "",
    "• The Enchanter drinks their essence, and Mystical Enlightenment needs it.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• Eight essences give \"},{\"text\":\"8\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Experience Droplets\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:experience_droplet\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Each droplet and a glass bottle make a \"},{\"text\":\"Bottle o' Enchanting\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:experience_bottle\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.39DCEA564325CFBA.title": "Mending, on request",
  "quest.39DCEA564325CFBA.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The Enchanter does Mending too: \"},{\"text\":\"3\",\"bold\":true},{\"text\":\" wither skeleton skulls and \"},{\"text\":\"256\",\"bold\":true},{\"text\":\" experience essence.\"}]",
    "",
    "[\"\",{\"text\":\"• Silk Touch: \"},{\"text\":\"32\",\"bold\":true},{\"text\":\" slimeballs and \"},{\"text\":\"128\",\"bold\":true},{\"text\":\" essence.\"}]"
  ],
  "quest.77509E143AE258EE.title": "Room for one more ability",
  "quest.77509E143AE258EE.quest_desc": [
    "Augments add abilities to essence gear.",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Tinkering Table\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:tinkering_table\",\"count\":1}}},{\"text\":\": stone and \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" soulium dust.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Unattuned Augment\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:unattuned_augment\",\"count\":1}}},{\"text\":\": prosperity shards and iron.\"}]",
    "",
    "• Infuse the augment on the altar, then socket it at the table."
  ],
  "quest.60B77A10CE64CA72.title": "Inferium gear",
  "quest.60B77A10CE64CA72.quest_desc": [
    "[\"\",{\"text\":\"Diamond gear plus \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" ingots and \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" gemstones of a tier becomes that tier's gear.\"}]",
    "",
    "• It keeps its enchantments.",
    "",
    "• It lasts longer, digs faster and has one augment slot.",
    "",
    "• An anvil repairs it with the tier's ingot."
  ],
  "quest.028575103C17E899.title": "Prudentium gear",
  "quest.028575103C17E899.quest_desc": [
    "Each tier upgrades the last one's piece: the pickaxe you started with keeps climbing.",
    "",
    "• Tier 2 opens Speed I, Night Vision, Jump Boost I and Mining AOE I."
  ],
  "quest.012E9C2FB7D8302C.title": "Tertium gear",
  "quest.012E9C2FB7D8302C.quest_desc": [
    "Tertium gear takes the augments that change how you move.",
    "",
    "• Step Assist, No Fall Damage, Slow Falling and Fire Resistance.",
    "",
    "• Haste I and Strength I as well."
  ],
  "quest.47C8AA0B473443EC.title": "Imperium gear",
  "quest.47C8AA0B473443EC.quest_desc": [
    "Imperium gear carries the tier-4 augments.",
    "",
    "• Haste II, Speed III and Strength II.",
    "",
    "• Poison Resistance, Hunger Resistance and Mining AOE III."
  ],
  "quest.49FEC79F35F926CA.title": "Supremium gear",
  "quest.49FEC79F35F926CA.quest_desc": [
    "Supremium gear takes every augment, flight included.",
    "",
    "• Its tools enchant at a plain enchanting table.",
    "",
    "• The armor still wears out: the pack keeps that default."
  ],
  "quest.1CA1FB45E4B92545.title": "Creative flight, earned",
  "quest.1CA1FB45E4B92545.quest_subtitle": "Four nether stars. Worth every one.",
  "quest.1CA1FB45E4B92545.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Flight Augment\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:flight_augment\",\"count\":1}}},{\"text\":\" grants creative flight while you wear it.\"}]",
    "",
    "[\"\",{\"text\":\"• Infused from \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" nether stars and \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" supremium essences.\"}]",
    "",
    "• It goes in a supremium chestplate."
  ],
  "quest.72DD20610A9F8208.title": "Bows, rods and shears",
  "quest.72DD20610A9F8208.quest_desc": [
    "The same upgrade works on bows, crossbows, fishing rods and shears.",
    "",
    "• Essence bows and crossbows draw faster and hit harder with each tier.",
    "",
    "[\"\",{\"text\":\"• From \"},{\"text\":\"1.1×\",\"bold\":true},{\"text\":\" speed and \"},{\"text\":\"+1\",\"bold\":true},{\"text\":\" damage at inferium to \"},{\"text\":\"2.1×\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"+4\",\"bold\":true},{\"text\":\" awakened.\"}]"
  ],
  "quest.22280B31AA115989.title": "Augments for digging",
  "quest.22280B31AA115989.quest_desc": [
    "[\"\",{\"text\":\"Area augments dig, till and make paths in \"},{\"text\":\"3×3\",\"bold\":true},{\"text\":\", up to \"},{\"text\":\"9×9\",\"bold\":true},{\"text\":\" at their top tier.\"}]",
    "",
    "• Iron tools around an unattuned augment make them.",
    "",
    "• Haste goes on a chestplate and costs redstone."
  ],
  "quest.259A5D9E40C11F79.title": "Augments for the senses",
  "quest.259A5D9E40C11F79.quest_desc": [
    "Three augments for what you see and breathe.",
    "",
    "• Golden carrots: Night Vision, on helmets.",
    "",
    "• Pufferfish: Water Breathing, on helmets.",
    "",
    "• Magma cream: Fire Resistance, on any armor piece."
  ],
  "quest.2000F9DD845234F3.title": "Augments for the road",
  "quest.2000F9DD845234F3.quest_desc": [
    "Four augments for getting around.",
    "",
    "• Sugar: Speed, on leggings.",
    "",
    "• Rabbit's feet: Jump Boost; diamonds and wool: No Fall Damage. Both on boots.",
    "",
    "• Stairs: Step Assist, on leggings or boots."
  ],
  "quest.23476146D562F567.title": "Augments for a fight",
  "quest.23476146D562F567.quest_desc": [
    "Swords and armor get their own augments.",
    "",
    "• Strength and Attack AOE go on swords.",
    "",
    "[\"\",{\"text\":\"• Health Boost and Absorption go on any armor: up to \"},{\"text\":\"10\",\"bold\":true},{\"text\":\" extra hearts.\"}]",
    "",
    "• Health Boost costs wither skeleton skulls from level I."
  ],
  "quest.295E42EA74678741.title": "Augments against bad luck",
  "quest.295E42EA74678741.quest_desc": [
    "One resistance per augment.",
    "",
    "• Leather and milk: Nausea. Torches and glowstone: Blindness.",
    "",
    "• Milk and imperium: Poison.",
    "",
    "[\"\",{\"text\":\"• Wither Resistance is tier 5: \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" nether stars, \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" wither skeleton skulls and \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" supremium.\"}]"
  ],
  "quest.48508F4ED026C786.title": "The second altar",
  "quest.48508F4ED026C786.quest_subtitle": "Orange wool this time. It matters.",
  "quest.48508F4ED026C786.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Awakening Altar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:awakening_altar\",\"count\":1}}},{\"text\":\" wakes supremium up.\"}]",
    "",
    "[\"\",{\"text\":\"• Gold, orange wool and soulstone make it and its \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Awakening Pedestals\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:awakening_pedestal\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "• Placed, it shows the eight spots: four pedestals and four vessels.",
    "",
    "• A redstone signal starts it."
  ],
  "quest.470CE93026FEFAD8.title": "Air",
  "quest.470CE93026FEFAD8.quest_desc": [
    "[\"\",{\"text\":\"Air Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:air_essence\",\"count\":1}}},{\"text\":\" fills a vessel of the awakening altar.\"}]",
    "",
    "[\"\",{\"text\":\"• Seed: \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Air Agglomeratio\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:air_agglomeratio\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Inferium Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:inferium_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"elemental tier\",\"color\":\"#C4DE52\"},{\"text\":\".\"}]",
    "",
    "• Each agglomeratio: a glass bottle, gravel, dirt and a clay ball."
  ],
  "quest.2C8B747523ED5853.title": "Earth",
  "quest.2C8B747523ED5853.quest_desc": [
    "[\"\",{\"text\":\"Earth Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:earth_essence\",\"count\":1}}},{\"text\":\" fills a vessel of the awakening altar.\"}]",
    "",
    "[\"\",{\"text\":\"• Seed: \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Earth Agglomeratio\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:earth_agglomeratio\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Inferium Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:inferium_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"elemental tier\",\"color\":\"#C4DE52\"},{\"text\":\".\"}]",
    "",
    "• Each agglomeratio: short grass, gravel, dirt and a clay ball.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• One earth with eight nether essences gives \"},{\"text\":\"16\",\"bold\":true},{\"text\":\" soul soil.\"}]"
  ],
  "quest.5440DCF7E7330A8C.title": "Water",
  "quest.5440DCF7E7330A8C.quest_desc": [
    "[\"\",{\"text\":\"Water Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:water_essence\",\"count\":1}}},{\"text\":\" fills a vessel; four in a bucket make a \"},{\"text\":\"Water Bucket\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:water_bucket\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Seed: \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Water Agglomeratio\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:water_agglomeratio\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Inferium Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:inferium_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"elemental tier\",\"color\":\"#C4DE52\"},{\"text\":\".\"}]",
    "",
    "• Each agglomeratio: a water bucket, gravel, dirt and a clay ball.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• One essence sets eight concrete powder into \"},{\"text\":\"8\",\"bold\":true},{\"text\":\" concrete.\"}]",
    "",
    "[\"\",{\"text\":\"• With dirt: \"},{\"text\":\"24\",\"bold\":true},{\"text\":\" clay balls or \"},{\"text\":\"12\",\"bold\":true},{\"text\":\" mud. With nature: \"},{\"text\":\"8\",\"bold\":true},{\"text\":\" kelp.\"}]"
  ],
  "quest.50B28893EB51C05E.title": "Fire",
  "quest.50B28893EB51C05E.quest_desc": [
    "[\"\",{\"text\":\"Fire Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:fire_essence\",\"count\":1}}},{\"text\":\" fills a vessel; four in a bucket make a \"},{\"text\":\"Lava Bucket\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:lava_bucket\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Seed: \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Fire Agglomeratio\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:fire_agglomeratio\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Inferium Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:inferium_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"elemental tier\",\"color\":\"#C4DE52\"},{\"text\":\".\"}]",
    "",
    "• Each agglomeratio: a lava bucket, gravel, dirt and a clay ball.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• With dirt: \"},{\"text\":\"16\",\"bold\":true},{\"text\":\" sand or red sand. With stone: \"},{\"text\":\"8\",\"bold\":true},{\"text\":\" flint or \"},{\"text\":\"12\",\"bold\":true},{\"text\":\" tuff.\"}]"
  ],
  "quest.0E4DADD35126FC7B.title": "The four elements",
  "quest.0E4DADD35126FC7B.quest_subtitle": "Gravel, dirt and clay, four ways.",
  "quest.0E4DADD35126FC7B.quest_desc": [
    "[\"\",{\"text\":\"Each awakening drinks \"},{\"text\":\"10\",\"bold\":true},{\"text\":\" of every element.\"}]",
    "",
    "• Air, earth, water and fire essence, ten of each.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Elemental crops count inferium farmland as their own tier: plant them there for the \"},{\"text\":\"20%\",\"bold\":true},{\"text\":\" odds.\"}]"
  ],
  "quest.1684E583E20FDEC9.title": "Four vessels",
  "quest.1684E583E20FDEC9.quest_desc": [
    "[\"\",{\"text\":\"Each \"},{\"text\":\"Essence Vessel\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:essence_vessel\",\"count\":1}}},{\"text\":\" holds up to \"},{\"text\":\"40\",\"bold\":true},{\"text\":\" of one elemental essence.\"}]",
    "",
    "• Recipe: gold, glass and soulstone.",
    "",
    "• The awakening altar drinks from all four at once."
  ],
  "quest.0826D3348EC4A160.title": "The Wither",
  "quest.0826D3348EC4A160.quest_subtitle": "A donor with three heads.",
  "quest.0826D3348EC4A160.quest_desc": [
    "[\"\",{\"text\":\"Killed with an essence weapon enchanted with Mystical Enlightenment, it drops \"},{\"text\":\"Cognizant Dust\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:cognizant_dust\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" at level I, one more per level.\"}]",
    "",
    "[\"\",{\"text\":\"• Any essence weapon also shakes out \"},{\"text\":\"1\",\"bold\":true},{\"text\":\" to \"},{\"text\":\"3\",\"bold\":true},{\"text\":\" essences of its tier.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Mystical Enlightenment comes from the Enchanter: \"},{\"text\":\"3\",\"bold\":true},{\"text\":\" supremium and \"},{\"text\":\"64\",\"bold\":true},{\"text\":\" experience essences per level.\"}]"
  ],
  "quest.2F9D40EF186A4510.title": "The Ender Dragon",
  "quest.2F9D40EF186A4510.quest_subtitle": "Better odds, longer commute.",
  "quest.2F9D40EF186A4510.quest_desc": [
    "[\"\",{\"text\":\"The Dragon pays more: \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Cognizant Dust\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:cognizant_dust\",\"count\":1}}},{\"text\":\" plus \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" per Mystical Enlightenment level.\"}]",
    "",
    "[\"\",{\"text\":\"• And \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" to \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" essences of your weapon's tier.\"}]"
  ],
  "quest.407E45A9049C0435.title": "Dust that knows",
  "quest.407E45A9049C0435.quest_desc": [
    "[\"\",{\"text\":\"One awakening takes \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Cognizant Dust\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:cognizant_dust\",\"count\":1}}},{\"text\":\", a supremium block and \"},{\"text\":\"10\",\"bold\":true},{\"text\":\" of each element.\"}]",
    "",
