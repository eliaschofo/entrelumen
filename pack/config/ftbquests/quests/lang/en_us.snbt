  "quest.1D36BEF7A5EA2A67.title": "No AI, no lag",
  "quest.1D36BEF7A5EA2A67.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Any big farm wants Stupor.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Mobs without AI cost the server far less.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"They still get pushed into a killing chamber.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Wire Control to a lever: one switch stops it all.\"}]"
  ],
  "task.5ED54198BBBE1B02.title": "Build the Ultimate Spawner",
  "quest.161AAF92BC2C0056.title": "The ultimate spawner",
  "quest.161AAF92BC2C0056.quest_subtitle": "The dungeon works for you now.",
  "quest.161AAF92BC2C0056.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"One cage, everything a spawner can be.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Minimum and maximum delay at \"},{\"text\":\"20\",\"color\":\"#FF8A3D\"},{\"text\":\" ticks.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Control\",\"color\":\"#FF8A3D\"},{\"text\":\", \"},{\"text\":\"Stupor\",\"color\":\"#FF8A3D\"},{\"text\":\", \"},{\"text\":\"Defiant\",\"color\":\"#FF8A3D\"},{\"text\":\" and \"},{\"text\":\"Solitude\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "{@pagebreak}",
    "Three acts and some sixty augments, all spent on one block of iron bars."
  ],
  "task.334A8D5C0A6B1ED6.title": "Get a spawn egg with Capturing",
  "quest.7DFEB61C03844351.title": "Capturing and spawn eggs",
  "quest.7DFEB61C03844351.quest_subtitle": "Gotta catch... one, eventually.",
  "quest.7DFEB61C03844351.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A spawn egg changes a spawner's mob.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Capturing\",\"color\":\"#FF8A3D\"},{\"text\":\", a sword enchantment: each kill has \"},{\"text\":\"0.5%\",\"color\":\"#FF8A3D\"},{\"text\":\" per level to drop its egg.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"The Chronicle says \"},{\"text\":\"0.4%\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"This pack's config sets \"},{\"text\":\"0.5%\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]"
  ],
  "quest.1E54FD607A2D4D56.title": "A leash that rewrites spawners",
  "quest.1E54FD607A2D4D56.quest_subtitle": "The witch is non-negotiable.",
  "quest.1E54FD607A2D4D56.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Bind the mob you are leading to a spawner.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"The \"},{\"text\":\"Occult Ender Lead\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:occult_ender_lead\",\"count\":1}}},{\"text\":\": catch a witch in an \"},{\"text\":\"Ender Lead\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:ender_lead\",\"count\":1}}},{\"text\":\", then infuse it.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"80\",\"color\":\"#FF8A3D\"},{\"text\":\" Eterna, \"},{\"text\":\"85\",\"color\":\"#FF8A3D\"},{\"text\":\" Quanta, \"},{\"text\":\"60 to 85\",\"color\":\"#FF8A3D\"},{\"text\":\" Arcana. It never breaks.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Native Apotheosis asks \"},{\"text\":\"75\",\"color\":\"#FF8A3D\"},{\"text\":\" Eterna. Here it takes \"},{\"text\":\"80\",\"color\":\"#FF8A3D\"},{\"text\":\": rewriting spawners is a mob farm, and those open in act IV.\"}]"
  ],
  "quest.203B80FC2D8AAD20.title": "What the farm leaves behind",
  "quest.203B80FC2D8AAD20.quest_subtitle": "Bones for the garden, string for the looms.",
  "quest.203B80FC2D8AAD20.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"64\",\"color\":\"#FF8A3D\"},{\"text\":\" bones and \"},{\"text\":\"64\",\"color\":\"#FF8A3D\"},{\"text\":\" string, once a day.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"A skeleton or spider spawner's usual harvest.\"}]"
  ],
  "quest.51F591833F20FE83.title": "Feed the flame",
  "quest.51F591833F20FE83.quest_subtitle": "Every spawner wants a little fire.",
  "quest.51F591833F20FE83.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The little flame inside the cage was hungry.\"}]",
    "",
    "No reward: only sparks."
  ],
  "image.409E97275C2F490D.title": "[\"\",{\"text\":\"Apotheosis\",\"color\":\"#F3EEFF\",\"bold\":true}]",
  "image.7863700F9B4697D1.title": "[\"\",{\"text\":\"Spawners\",\"color\":\"#F2B27A\"}]",
  "image.7625E422669FC9A5.title": "Back to the Sun of Heliodor",
  "image.683FBDC2E35EEAB0.title": "Apotheosis · Adventure",
  "image.5AEAAC0B08EA0E9E.title": "Apotheosis · Adventure",
  "image.364539866B6EF6CF.title": "Apotheosis · Enchanting",
  "image.4691FC70C71E5128.title": "Apotheosis · Enchanting",
  "chapter.6299A6DE7C1CDB53.title": "Ars Nouveau · Addons",
  "chapter.6299A6DE7C1CDB53.chapter_subtitle": [
    "Nine addons around one mark: the elements, Create machines, AE2, fluids, spirits, charms, remote control and more glyphs."
  ],
  "quest.380894BB2C2418A4.title": "Mark of Mastery",
  "quest.380894BB2C2418A4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Wilden Tribute imbued with all eight essences gives five \"},{\"text\":\"Marks of Mastery\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:mark_of_mastery\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"A mark turns a lesser focus into a full one, or tier \"},{\"text\":\"3\",\"color\":\"#C7A0F5\"},{\"text\":\" Ars armour into elemental armour.\"}]"
  ],
  "task.3E81D67EA8414824.title": "Three elemental essences",
  "quest.4781668B662B5EB1.title": "Pick a school",
  "quest.4781668B662B5EB1.quest_subtitle": "Loyalty has perks.",
  "quest.4781668B662B5EB1.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three essences of your element, an amethyst shard and three gold make its lesser focus.\"}]",
    "",
    "With Ars Elemental most glyphs belong to a school, and gear attuned to one boosts it.",
    "",
    "Pick one focus: the other three close in this book, not in the game."
  ],
  "quest.2924750F480D52C9.title": "School of Fire",
  "quest.2924750F480D52C9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"An amethyst shard imbued with three \"},{\"text\":\"fire essences\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_nouveau:fire_essence\",\"count\":1}}},{\"text\":\" and three gold, \"},{\"text\":\"5000\",\"color\":\"#C7A0F5\"},{\"text\":\" Source: a \"},{\"text\":\"Lesser Focus of Fire\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:lesser_fire_focus\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"As a curio it boosts fire glyphs.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Ignite adds Magic Burn.\"}]"
  ],
  "quest.6E26AB0785FDC99F.title": "School of Water",
  "quest.6E26AB0785FDC99F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The same recipe with water essences: a \"},{\"text\":\"Lesser Focus of Water\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:lesser_water_focus\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "It boosts water glyphs and weakens the element across from it."
  ],
  "quest.3A6E58D645AAB6BE.title": "School of Earth",
  "quest.3A6E58D645AAB6BE.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"With earth essences: a \"},{\"text\":\"Lesser Focus of Earth\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:lesser_earth_focus\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Diggers love it: earth glyphs get stronger and cheaper."
  ],
  "quest.02AEEEAC0E66F7ED.title": "School of Air",
  "quest.02AEEEAC0E66F7ED.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"With air essences: a \"},{\"text\":\"Lesser Focus of Air\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:lesser_air_focus\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Lightning, wind and falling slower, all a little better."
  ],
  "quest.0EACFC65D758ED00.title": "Magic to shafts",
  "quest.0EACFC65D758ED00.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Rotation made of magic, until the jar runs dry.\"}]",
    "",
    "[\"\",{\"text\":\"Imbue a Create precision mechanism with amethyst and Source Gems, then build the \"},{\"text\":\"Source Motor\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_technica:source_motor\",\"count\":1}}},{\"text\":\" with brass and cogs.\"}]",
    "",
    "It turns jar Source into rotation: fuel, not free power."
  ],
  "quest.646DFC08E02887AB.title": "Create recipes, cast",
  "quest.646DFC08E02887AB.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Ars Technica glyphs run Create recipes on dropped items: Obliterate crushes, Press presses, Fuse mixes, Whirl washes or smelts by the next glyph. A timer turret over a hopper is a Create machine on Source.\"}]"
  ],
  "quest.228526A103C7AB08.title": "A hamster wheel, rebranded",
  "quest.228526A103C7AB08.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Ars and Create share a wheel.\"}]",
    "",
    "[\"\",{\"text\":\"A starbuncle charm and a water wheel make a \"},{\"text\":\"Starbuncle Wheel\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_creo:starbuncle_wheel\",\"count\":1}}},{\"text\":\": small rotation, more with a gold block in front.\"}]",
    "",
    "Ars blocks also work on moving contraptions."
  ],
  "quest.6644EE1A37239BF7.title": "Spirits in jars",
  "quest.6644EE1A37239BF7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Spirits that keep working and never wear out.\"}]",
    "",
    "Catch an Occultism worker in a containment jar: it grabs matching items around the jar.",
    "",
    "[\"\",{\"text\":\"Ars Ocultas also imbues a \"},{\"text\":\"Spirit Attuned Gem\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:spirit_attuned_gem\",\"count\":1}}},{\"text\":\" from a Source Gem: no diamond burned.\"}]"
  ],
  "quest.4266D0AE6FBF7F11.title": "Source in AE2",
  "quest.4266D0AE6FBF7F11.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"With AE2, the \"},{\"text\":\"ME Source Converter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"arseng:source_acceptor\",\"count\":1}}},{\"text\":\" turns Source from linked jars into AE energy.\"}]",
    "",
    "When the jars run dry, the network stops: a bridge, not a generator."
  ],
  "quest.67984B072FE95817.title": "Charms with charges",
  "quest.67984B072FE95817.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Ars Additions makes curios with charges around a bottle in the apparatus.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"The \"},{\"text\":\"Charm of Second Wind\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_additions:undying_charm\",\"count\":1}}},{\"text\":\" saves you from a fatal hit.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Others cover falls, fire, water and the void.\"}]",
    "",
    "Recharge them in the chamber."
  ],
  "quest.2D79F650880F3F27.title": "Remote access",
  "quest.2D79F650880F3F27.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Your storage, wherever you stand.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_additions:warp_index\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"The \"},{\"text\":\"Warp Index\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_additions:warp_index\",\"count\":1}}},{\"text\":\" opens your storage lectern from anywhere in the dimension.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"The stabilised one crosses dimensions.\"}]",
    "",
    "Craft it on a mundane belt with an eye, a crystal and two charms."
  ],
  "quest.73D9F01382DCC7E0.title": "A lag alarm",
  "quest.73D9F01382DCC7E0.quest_subtitle": "On a shared server, a small act of love.",
  "quest.73D9F01382DCC7E0.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Ars Controle's \"},{\"text\":\"Temporal Stability Sensor\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_controle:temporal_stability_sensor\",\"count\":1}}},{\"text\":\" raises its comparator signal as the world nears lag. Wire it to beds, turrets or braziers and your farms rest when the server struggles.\"}]"
  ],
  "quest.45C9169153C229A0.title": "Major Focus of Fire",
  "quest.45C9169153C229A0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Mark of Mastery on your lesser focus at the apparatus, \"},{\"text\":\"5000\",\"color\":\"#C7A0F5\"},{\"text\":\" Source: the \"},{\"text\":\"Focus of Fire\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:fire_focus\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "It keeps the school's boosts and adds Spell Damage II while you burn or swim in lava."
  ],
  "quest.614F9A50D2E3856A.title": "Major Focus of Water",
  "quest.614F9A50D2E3856A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Mark of Mastery on your lesser focus at the apparatus, \"},{\"text\":\"5000\",\"color\":\"#C7A0F5\"},{\"text\":\" Source: the \"},{\"text\":\"Focus of Water\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:water_focus\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "It keeps the school's boosts and adds Mana Regen I while wet, II and Dolphin's Grace while swimming."
  ],
  "quest.4B9BE3F1A0554C6F.title": "Major Focus of Earth",
  "quest.4B9BE3F1A0554C6F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Mark of Mastery on your lesser focus at the apparatus, \"},{\"text\":\"5000\",\"color\":\"#C7A0F5\"},{\"text\":\" Source: the \"},{\"text\":\"Focus of Earth\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:earth_focus\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"It keeps the school's boosts and adds Mana Regen I below Y \"},{\"text\":\"0\",\"color\":\"#C7A0F5\"},{\"text\":\".\"}]"
  ],
  "quest.60DDCF57404CF9D4.title": "Major Focus of Air",
  "quest.60DDCF57404CF9D4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Mark of Mastery on your lesser focus at the apparatus, \"},{\"text\":\"5000\",\"color\":\"#C7A0F5\"},{\"text\":\" Source: the \"},{\"text\":\"Focus of Air\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:air_focus\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "It keeps the school's boosts and adds Mana Regen I high in the sky."
  ],
  "task.7BBC20FD86AE97B9.title": "Any elemental armor piece",
  "quest.248939212EE20078.title": "Dressed for your element",
  "quest.248939212EE20078.quest_subtitle": "Fireproof, and stylish about it.",
  "quest.248939212EE20078.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Your armor, cut for one element.\"}]",
    "",
    "[\"\",{\"text\":\"A \"},{\"text\":\"Mark of Mastery\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:mark_of_mastery\",\"count\":1}}},{\"text\":\", a netherite ingot and two essences at the apparatus turn tier \"},{\"text\":\"3\",\"color\":\"#C7A0F5\"},{\"text\":\" Ars armor into its elemental cut, \"},{\"text\":\"7000\",\"color\":\"#C7A0F5\"},{\"text\":\" Source, threads and enchantments kept.\"}]",
    "",
    "Each piece boosts and discounts its school and blunts that element's harm.",
    "{@pagebreak}",
    "A full set of one element turns the harm it blocks into mana and adds a trick: fire puts you out at once, water refills your air, earth feeds you when you starve underground, air all but cancels falls."
  ],
  "task.1D883BDA3CE7A196.title": "Any elemental turret",
  "quest.024694EFF95ED404.title": "Turrets with a school",
  "quest.024694EFF95ED404.quest_subtitle": "Sentries that went to school.",
  "quest.024694EFF95ED404.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A turret that learned an element.\"}]",
    "",
    "[\"\",{\"text\":\"Imbue an \"},{\"text\":\"Enchanted Spell Turret\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_nouveau:spell_turret\",\"count\":1}}},{\"text\":\" with three essences and a major focus, \"},{\"text\":\"5000\",\"color\":\"#C7A0F5\"},{\"text\":\" Source: an \"},{\"text\":\"elemental turret\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:fire_turret\",\"count\":1}}},{\"text\":\", with the focus sealed inside.\"}]",
    "",
    "[\"\",{\"text\":\"Its spells trigger that focus's combos and cost \"},{\"text\":\"65%\",\"color\":\"#C7A0F5\"},{\"text\":\" less when they carry a glyph of its school.\"}]",
    "{@pagebreak}",
    "Three manipulation essences and a Focus of Block Shaping make a Manipulation one, no mark needed."
  ],
  "quest.599AF2386989F5DA.title": "The fifth school",
  "quest.599AF2386989F5DA.quest_subtitle": "Your wolves come back. Angrier.",
  "quest.599AF2386989F5DA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two wither roses, a wither skeleton skull and anima essence on a Focus of Summoning: the \"},{\"text\":\"Focus of Necromancy\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:necrotic_focus\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Summons that die rise once more, cast your homing spells and heal you when they kill."
  ],
  "quest.4372B3A3FBF3073E.title": "Trinkets Pouch",
  "quest.4372B3A3FBF3073E.quest_subtitle": "For the jewelry you forgot you had.",
  "quest.4372B3A3FBF3073E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A chest wrapped in eight \"},{\"text\":\"Magebloom Fiber\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_nouveau:magebloom_fiber\",\"count\":1}}},{\"text\":\": the \"},{\"text\":\"Trinkets Pouch\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:curio_bag\",\"count\":1}}},{\"text\":\", a bag only for magical trinkets.\"}]",
    "",
    "Rings, amulets, charms and foci stop eating inventory slots."
  ],
  "quest.66064E8286CA9AB2.title": "Spellcaster Bag",
  "quest.66064E8286CA9AB2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The pouch, promoted.\"}]",
    "",
    "[\"\",{\"text\":\"Two manipulation essences, blaze powder and two gold blocks turn the pouch into a \"},{\"text\":\"Spellcaster Bag\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:caster_bag\",\"count\":1}}},{\"text\":\": the same trinket storage, for the parchments, tomes and wands you carry.\"}]"
  ],
  "quest.3E086644DE69525E.title": "Enchanter's Bangle",
  "quest.3E086644DE69525E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Jewelry for your spells.\"}]",
    "",
    "[\"\",{\"text\":\"An end crystal, two gold blocks and a Source block on a Ring of Potential: the \"},{\"text\":\"Enchanter's Bangle\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:base_bangle\",\"count\":1}}},{\"text\":\", a chance to boost any spell.\"}]",
    "",
    "Attune it with a school's essences for a steady boost and that element's side effect."
  ],
  "task.66D484D67EC210D9.title": "Any attuned bangle",
  "quest.64B762BA77F17761.title": "A bangle per school",
  "quest.64B762BA77F17761.quest_subtitle": "Accessorize, then incinerate.",
  "quest.64B762BA77F17761.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three essences and a catalyst attune the Enchanter's Bangle at the apparatus:\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Fire charge\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Powder snow\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Cobweb\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Piston\"}]",
    "",
    "[\"\",{\"text\":\"A \"},{\"text\":\"Fire Bangle\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:fire_bangle\",\"count\":1}}},{\"text\":\" and its kin boost their school's damage and mark your hits: fire burns, water freezes, earth snares, air knocks back.\"}]",
    "{@pagebreak}",
    "Anima and summoning get theirs too: two anima essences, a ghast tear and a wither rose, or two conjuration essences, a bone and a Wilden horn."
  ],
  "quest.250FF80E57C9EF58.title": "Relays with an element",
  "quest.250FF80E57C9EF58.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two essences and two diamonds on a relay raise its capacity and speed.\"}]",
    "",
    "[\"\",{\"text\":\"The warper version, the \"},{\"text\":\"Wind Warper Relay\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:air_relay\",\"count\":1}}},{\"text\":\", also stops losing Source over long jumps.\"}]"
  ],
  "task.3A65B3D53C59D881.title": "Any prism lens",
  "quest.54E58F67C38B3AE3.title": "Prisms with a lens",
  "quest.54E58F67C38B3AE3.quest_subtitle": "Aim once, bend forever.",
  "quest.54E58F67C38B3AE3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A spell prism ringed with quartz and four Source Gems: the \"},{\"text\":\"Advanced Spell Prism\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:advanced_prism\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Aim it at a block with the dominion wand and fit a lens to speed spells up, slow them down, arc them, make them home, pierce more or chain its own glyphs on.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Five lenses are quartz imbued with manipulation essence and the glyph they copy, \"},{\"text\":\"2000\",\"color\":\"#C7A0F5\"},{\"text\":\" Source.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"The chaining one is quartz with a Source Gem block and blank parchment at the apparatus, scribed like a spell.\"}]",
    "",
    "Piercing and chaining spend Source on every shot."
  ],
  "quest.0D09CAF0C2B68386.title": "Elevators by current",
  "quest.0D09CAF0C2B68386.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Soul sand, air and water essence and four prismarine shards: a \"},{\"text\":\"Bubble Current Elevator\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:water_upstream\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"It lifts anyone in water, even flowing water.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Stack them for height, sneak to go down.\"}]"
  ],
  "quest.4CEA23EB20EE1173.title": "Urn of Endless Waters",
  "quest.4CEA23EB20EE1173.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A flower pot with a Source Gem, two water essences and two prismarine shards: the \"},{\"text\":\"Urn of Endless Waters\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:everfull_urn\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Link a cauldron to it with the dominion wand and it stays full for a little Source."
  ],
  "quest.45DF8905C45955E4.title": "A siren of your own",
  "quest.45DF8905C45955E4.quest_subtitle": "Pays in pickles.",
  "quest.45DF8905C45955E4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Sirens swim near coral.\"}]",
    "",
    "[\"\",{\"text\":\"Give one a sea pickle for shards, then add prismarine, fish and Source Gems at the apparatus: a \"},{\"text\":\"Siren Charm\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:siren_charm\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "On prismarine it becomes a shrine that fishes for you."
  ],
  "quest.392E849CBC22984F.title": "Two new ways to throw",
  "quest.392E849CBC22984F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"One falls, one chases.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Arc Projectile\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:glyph_arc_projectile\",\"count\":1}}},{\"text\":\" falls with gravity and bounces once per Pierce.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Homing Projectile\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_elemental:glyph_homing_projectile\",\"count\":1}}},{\"text\":\" chases the nearest creature, for a Nether Star at the scribe's table.\"}]"
  ],
  "quest.69CFD7185398097F.title": "Calibrated Precision Mechanism",
  "quest.69CFD7185398097F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Create's precision, tuned with Source.\"}]",
    "",
    "[\"\",{\"text\":\"A Create precision mechanism on the apparatus with four amethyst shards and four Source Gems, \"},{\"text\":\"500\",\"color\":\"#C7A0F5\"},{\"text\":\" Source: the \"},{\"text\":\"Calibrated Precision Mechanism\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_technica:calibrated_precision_mechanism\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Every Ars Technica machine starts from one."
  ],
  "quest.1B21C821E7DB322C.title": "Arcane Wrench",
  "quest.1B21C821E7DB322C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The wrench that also picks up magic.\"}]",
    "",
    "[\"\",{\"text\":\"Enchant a \"},{\"text\":\"Create wrench\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"create:wrench\",\"count\":1}}},{\"text\":\" at the apparatus with gold, a calibrated mechanism and manipulation essence, \"},{\"text\":\"500\",\"color\":\"#C7A0F5\"},{\"text\":\" Source: the \"},{\"text\":\"Arcane Wrench\",\"color\":\"#C7A0F5\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Sneak-use picks up pedestals, turrets and containment jars.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"On a relay it makes a Precise Relay with a cooldown you set.\"}]"
  ],
  "quest.0133EA206A595221.title": "Focus of Transmutation",
  "quest.0133EA206A595221.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A focus for the tinkerer.\"}]",
    "",
    "[\"\",{\"text\":\"Brass, a rabbit's foot, a calibrated mechanism and an emerald on manipulation essence: the \"},{\"text\":\"Focus of Transmutation\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_technica:transmutation_focus\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Each glyph gets a free Luck, and Press, Polish and Whirl run twice as fast."
  ],
  "quest.11015A435B6A0D33.title": "Mark of Technomancy",
  "quest.11015A435B6A0D33.quest_subtitle": "Half wizard, half mechanic.",
  "quest.11015A435B6A0D33.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The mark that puts a toolbelt on a mage.\"}]",
    "",
    "[\"\",{\"text\":\"A Wilden Tribute with both mechanisms, manipulation essence, iron, copper, zinc, and brass and gold plates, \"},{\"text\":\"10000\",\"color\":\"#C7A0F5\"},{\"text\":\" Source: the \"},{\"text\":\"Mark of Technomancy\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_technica:mark_of_technomancy\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "With netherite and brass it turns Arcanist robes into Technomancer's."
  ],
  "task.70D6A3CB2DEAC717.title": "Any technomancer armor piece",
  "quest.1FA8CDE6027E0DEC.title": "Robes with a toolbelt",
  "quest.1FA8CDE6027E0DEC.quest_subtitle": "Goggles included.",
  "quest.1FA8CDE6027E0DEC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Ars armor, retrained as an engineer.\"}]",
    "",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Mark of Technomancy\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_technica:mark_of_technomancy\",\"count\":1}}},{\"text\":\", netherite and two brass ingots turn tier \"},{\"text\":\"3\",\"color\":\"#C7A0F5\"},{\"text\":\" Ars armor into a technomancer cut, \"},{\"text\":\"7000\",\"color\":\"#C7A0F5\"},{\"text\":\" Source: Artificer from Sorcerer, Technomancer from Arcanist, Machinaguard from Battlemage.\"}]",
    "{@pagebreak}",
    "Each piece boosts manipulation glyphs and blunts saws and crushers.",
    "",
    "The hat shows what Create's engineer's goggles show, and a full set speeds up nearby schematicannons.",
    "",
    "A Mark of Mastery works in place of the Mark of Technomancy."
  ],
  "quest.3E56E680745C6F29.title": "Pocket Factory",
  "quest.3E56E680745C6F29.quest_subtitle": "The author's own soundtrack.",
  "quest.3E56E680745C6F29.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A music disc, burned and pressed by hand.\"}]",
    "",
    "[\"\",{\"text\":\"Burn any music disc blank with fire essence at the apparatus, then press it between two brass plates and two Source Gems: the \"},{\"text\":\"Music Disc\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_technica:pocket_factory\",\"count\":1}}},{\"text\":\" Pocket Factory, two and a half minutes by zeroregard, who also made Ars Technica.\"}]"
  ],
  "quest.3FFE6537FA814AB0.title": "A jar on the network",
  "quest.3FFE6537FA814AB0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Source Jar with manipulation essence and an ME Interface: the \"},{\"text\":\"ME Source Jar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"arseng:me_source_jar\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Rituals, the apparatus and relays pull Source from it as if it were any jar, and it refills from your ME drives."
  ],
  "quest.338DF2041B8C05F8.title": "Source by the kilobyte",
  "quest.338DF2041B8C05F8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Your ME drives learn a new resource.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"arseng:source_cell_housing\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"An item cell housing with manipulation essence, Source Gems and gold becomes an \"},{\"text\":\"ME Source Cell Housing\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"arseng:source_cell_housing\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Add a cell component for a \"},{\"text\":\"1k Source Storage Cell\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"arseng:source_storage_cell_1k\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Drives then hold Source like items."
  ],
  "quest.794EDB40FD230426.title": "Fluid Jar",
  "quest.794EDB40FD230426.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Gold, glass, a water essence and blue archwood: the \"},{\"text\":\"Fluid Jar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"starbunclemania:fluid_jar\",\"count\":1}}},{\"text\":\", sixteen buckets of any fluid.\"}]",
    "",
    "A potion fluid inside feeds a Potion Jar placed on top."
  ],
  "quest.784895E98D1C389B.title": "New jobs for starbuncles",
  "quest.784895E98D1C389B.quest_subtitle": "Same pay, more paperwork.",
  "quest.784895E98D1C389B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Give a starbuncle a \"},{\"text\":\"Starbucket\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"starbunclemania:star_bucket\",\"count\":1}}},{\"text\":\" and it carries fluids; a \"},{\"text\":\"StarbAttery\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"starbunclemania:star_battery\",\"count\":1}}},{\"text\":\", and it carries FE.\"}]",
    "",
    "Sneak while giving it for looks only."
  ],
  "quest.2557809358A7CDB4.title": "Source from fluids",
  "quest.2557809358A7CDB4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A bucket of liquid Source between gold and Source Gems: the \"},{\"text\":\"Fluid Sourcelink\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"starbunclemania:fluid_sourcelink\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "It burns fluids for Source and drains tanks placed under it."
  ],
  "quest.5F27BA0E58089DE8.title": "Liquid Source",
  "quest.5F27BA0E58089DE8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Fluid Jar crafted with a relay: the \"},{\"text\":\"Source Condenser\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"starbunclemania:source_condenser\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"It condenses Source from nearby jars into a fluid and pours it into tanks below.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Pipe it anywhere.\"}]"
  ],
  "quest.1C3ED9ADD74CF4A6.title": "Wixie workstations",
  "quest.1C3ED9ADD74CF4A6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Put a Wixie on a furnace, a crucible or a cooking pot and it works that station instead of the cauldron.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"On a fluid jar it mixes.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"On a stonecutter or cutting board it cuts.\"}]"
  ],
  "quest.0F39DE69423A68E7.title": "Paperwork for fluids",
  "quest.0F39DE69423A68E7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Parchment with a water essence makes a \"},{\"text\":\"Fluid Scroll\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"starbunclemania:fluid_scroll_allow\",\"count\":1}}},{\"text\":\", a filter for fluid starbuncles.\"}]",
    "",
    "[\"\",{\"text\":\"Parchment and a compass, a \"},{\"text\":\"Direction Scroll\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"starbunclemania:direction_scroll\",\"count\":1}}},{\"text\":\": it picks which face of a block they use.\"}]"
  ],
  "quest.4E3289E49702193C.title": "Pie day",
  "quest.4E3289E49702193C.quest_subtitle": "The circle has a sweet tooth.",
  "quest.4E3289E49702193C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Sixteen \"},{\"text\":\"Source Berry Pies\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_nouveau:source_berry_pie\",\"count\":1}}},{\"text\":\" for the common store: egg, sugar, magebloom and three sourceberries each.\"}]",
    "",
    "A Wixie on a cooking pot bakes them while you work."
  ],
  "quest.12F0F6FA1B7A48D7.title": "Sacrificial Altar",
  "quest.12F0F6FA1B7A48D7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Occultism's bowl, rebuilt with Source.\"}]",
    "",
    "[\"\",{\"text\":\"Rebuild the golden sacrificial bowl at the apparatus with four silver ingots, a drygmy shard, sourcestone and a containment jar, \"},{\"text\":\"5000\",\"color\":\"#C7A0F5\"},{\"text\":\" Source: the \"},{\"text\":\"Sacrificial Altar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_ocultas:altar\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "The same bridge also swaps gold and silver by imbuement."
  ],
  "quest.3C249F478F112ADE.title": "One pool, many jars",
  "quest.3C249F478F112ADE.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four ender pearls and four popped chorus fruits on a Source Jar: an \"},{\"text\":\"Ender Source Jar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_additions:ender_source_jar\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Every one you place shares the same pool, so the base's Source reaches your outposts."
  ],
  "quest.70FAC3B7CEF3BB5C.title": "Handy Haversack",
  "quest.70FAC3B7CEF3BB5C.quest_subtitle": "Your chest, on your back.",
  "quest.70FAC3B7CEF3BB5C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Bind the \"},{\"text\":\"Handy Haversack\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_additions:handy_haversack\",\"count\":1}}},{\"text\":\" to a container, then use items on it to send them there from anywhere.\"}]",
    "",
    "When that container's chunk unloads, the haversack closes."
  ],
  "quest.47E41BC039657CAA.title": "Source Spawner",
  "quest.47E41BC039657CAA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Drygmy Charm with a Focus of Summoning and conjuration essence: the \"},{\"text\":\"Source Spawner\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_additions:source_spawner\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "It spawns whatever sits in nearby Containment Jars and pays each mob in Source."
  ],
  "quest.602AEF84C9C21258.title": "Finding places",
  "quest.602AEF84C9C21258.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Gold around an amethyst shard makes a \"},{\"text\":\"Wayfinder\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_additions:wayfinder\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"With a compass, a Source Gem and purple archwood it becomes the \"},{\"text\":\"Locate Structure\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_additions:ritual_locate_structure\",\"count\":1}}},{\"text\":\" tablet: the augments pick what to find.\"}]"
  ],
  "quest.19D4E6F1A92B57F7.title": "Arcane Permanence",
  "quest.19D4E6F1A92B57F7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Blue archwood, a Nether Star, a Source Gem and earth essence: \"},{\"text\":\"Arcane Permanence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_additions:ritual_chunk_loading\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "While fed a steady stream of Source, it keeps the chunks around the brazier loaded."
  ],
  "quest.68D6813C3F8AA9AA.title": "Nexus Tower",
  "quest.68D6813C3F8AA9AA.quest_subtitle": "Built on a leyline, no rent due.",
  "quest.68D6813C3F8AA9AA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"You found a Nexus Tower.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Its Warp Nexus holds nine warp scrolls and, sitting on a leyline, teleports for free.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Moved anywhere else it costs \"},{\"text\":\"1000\",\"color\":\"#C7A0F5\"},{\"text\":\" Source per jump.\"}]"
  ],
  "reward.2CDFECF3F1D39AD6.title": "Secret found",
  "quest.080357400D80C563.title": "A portal that still hums",
  "quest.080357400D80C563.quest_subtitle": "Mind the gap.",
  "quest.080357400D80C563.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"You found a ruined warp portal.\"}]",
    "",
    "Throw an Explorer's Warp Scroll into its frame and it drops you near a structure: which one, the scroll decides."
  ],
  "reward.5246C6E13ED93DCB.title": "Secret found",
  "quest.35F4412064FDADCF.title": "Pages from a lost codex",
  "quest.35F4412064FDADCF.quest_subtitle": "Homework from a vanished school.",
  "quest.35F4412064FDADCF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Loot that teaches you a glyph.\"}]",
    "",
    "[\"\",{\"text\":\"Chests in nexus towers, arcane libraries and ruined warp portals hold one to four \"},{\"text\":\"Codex Entries\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_additions:codex_entry\",\"count\":1}}},{\"text\":\", and dungeon, temple and stronghold chests sometimes one.\"}]",
    "",
    "[\"\",{\"text\":\"Use an entry to learn a random tier \"},{\"text\":\"1\",\"color\":\"#C7A0F5\"},{\"text\":\" glyph you don't know yet, plus a little experience.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"No chest in this pack holds the Lost or Ancient entries, for tiers \"},{\"text\":\"2\",\"color\":\"#C7A0F5\"},{\"text\":\" and \"},{\"text\":\"3\",\"color\":\"#C7A0F5\"},{\"text\":\".\"}]"
  ],
  "quest.4A5C9EDE9F43BA3B.title": "The dominion wand, from afar",
  "quest.4A5C9EDE9F43BA3B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A dominion wand with four ender pearls and four popped chorus fruits: the \"},{\"text\":\"Remote\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_controle:remote\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Select a block or creature once, then configure it from anywhere, like the wand at arm's length."
  ],
  "quest.5B48725CCBD7B82A.title": "Scryer's Linkage",
  "quest.5B48725CCBD7B82A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Ender pearls and popped chorus on a Scry Crystal: the \"},{\"text\":\"Scryer's Linkage\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_controle:scryers_linkage\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Link it to a distant block with the dominion wand and machines at the linkage reach that block's items, fluids, energy and redstone."
  ],
  "quest.6AF3C7F4F372CABF.title": "Warping Spell Prism",
  "quest.6AF3C7F4F372CABF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A spell prism with ender pearls and popped chorus: the \"},{\"text\":\"Warping Spell Prism\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_controle:warping_spell_prism\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "A projectile that hits it comes out wherever you bound it, even in another dimension."
  ],
  "quest.77CE704DBFDF9098.title": "A ritual in your pocket",
  "quest.77CE704DBFDF9098.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Rituals that walk with you.\"}]",
    "",
    "[\"\",{\"text\":\"A brazier relay with a Nether Star, the Wilden Tribute, pearls, chorus and manipulation essence: the \"},{\"text\":\"Portable Brazier Relay\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_controle:portable_brazier_relay\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "You carry the ritual's effect, as long as its brazier stays loaded and fed."
  ],
  "quest.074836C0F4099E3B.title": "Spells with conditions",
  "quest.074836C0F4099E3B.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Ars Controle's filter glyphs stop a spell unless a condition holds: Above, Below, Level, Not, Or, Xor, Random. Precise Delay waits an exact number of ticks. Filters make turrets pick their targets.\"}]"
  ],
  "quest.0D51ECA3FC9B3BE5.title": "Spell Binder",
  "quest.0D51ECA3FC9B3BE5.quest_subtitle": "A book of books.",
  "quest.0D51ECA3FC9B3BE5.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Novice Spell Book wrapped in eight leather: the \"},{\"text\":\"Spell Binder\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"not_enough_glyphs:spell_binder\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "It casts from the spell parchments and caster tomes you keep inside, ten of them on the radial menu."
  ],
  "quest.13547694FFCC308E.title": "Covers for the binder",
  "quest.13547694FFCC308E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The Alteration Table fits two covers on a binder, like threads.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Lucky Cover\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"not_enough_glyphs:thread_scritchance\",\"count\":1}}},{\"text\":\" raises spell critical chance.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Keen Cover\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"not_enough_glyphs:thread_scritdamage\",\"count\":1}}},{\"text\":\", critical damage.\"}]"
  ],
  "quest.10D1426A397B6EA7.title": "Spells on standby",
  "quest.10D1426A397B6EA7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A spell that waits for the bad moment.\"}]",
    "",
    "[\"\",{\"text\":\"Contingency glyphs hold the rest of the spell until something happens: \"},{\"text\":\"health drops\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"not_enough_glyphs:glyph_contingency_health\",\"count\":1}}},{\"text\":\" below \"},{\"text\":\"20%\",\"color\":\"#C7A0F5\"},{\"text\":\", or a \"},{\"text\":\"long fall\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"not_enough_glyphs:glyph_contingency_fall\",\"count\":1}}},{\"text\":\" starts.\"}]",
    "",
    "Heal or Slowfall behind them is insurance you cast in advance."
  ],
  "quest.73412E8EA4D0BDDB.title": "Farm and flatten",
  "quest.73412E8EA4D0BDDB.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Plow\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"not_enough_glyphs:glyph_plow\",\"count\":1}}},{\"text\":\" tills like a hoe.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"Propagate Plane\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"not_enough_glyphs:glyph_propagate_plane\",\"count\":1}}},{\"text\":\" spreads the rest of the spell over a flat area from the block hit.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#C7A0F5\"},{\"text\":\"AOE and Pierce size it, Sensitive makes it round.\"}]"
  ],
  "quest.3ABBB5892CB9D083.title": "Doodle in the margin",
  "quest.3ABBB5892CB9D083.quest_subtitle": "The pointy kind of hat.",
  "quest.3ABBB5892CB9D083.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Every grimoire ends up with a wizard hat in a margin.\"}]",
    "",
    "No reward: just a doodle."
  ],
  "image.6A929B21B0921F03.title": "Back to Ars Nouveau",
  "image.2529D426726ECB16.title": "[\"\",{\"text\":\"APPENDIX\",\"color\":\"#2B2148\",\"bold\":true}]",
  "image.7729E7D74F035F80.title": "[\"\",{\"text\":\"Ars Additions\",\"color\":\"#2B2148\"}]",
  "image.55911DB8AF9749F1.title": "[\"\",{\"text\":\"Ars Controle\",\"color\":\"#2B2148\"}]",
  "image.62650DDD3A8301CE.title": "[\"\",{\"text\":\"Ars Elemental: gear\",\"color\":\"#2B2148\"}]",
  "image.7B420222E9AA3772.title": "[\"\",{\"text\":\"Ars Technica\",\"color\":\"#2B2148\"}]",
  "image.471A4ACD095EE0F7.title": "[\"\",{\"text\":\"Starbunclemania\",\"color\":\"#2B2148\"}]",
  "image.1CF61423CCDB3711.title": "[\"\",{\"text\":\"Not Enough Glyphs\",\"color\":\"#2B2148\"}]",
  "image.3B127A1D99FC2701.title": "[\"\",{\"text\":\"Ars Énergistique\",\"color\":\"#2B2148\"}]",
  "image.00024A1262B392DD.title": "[\"\",{\"text\":\"Ars Ocultas\",\"color\":\"#2B2148\"}]",
  "image.30AC6F208D81924C.title": "[\"\",{\"text\":\"Ars Elemental: schools\",\"color\":\"#2B2148\"}]",
  "chapter.77684ABAA0372D83.title": "Forbidden and Arcanus",
  "chapter.77684ABAA0372D83.chapter_subtitle": [
    "Darkstone, deorum and dark rituals: the Clibano, the Hephaestus Forge from tier 1 to 5, modifiers and the Eternal Stella."
  ],
  "quest.4FC309242490B654.title": "Arcane Crystal",
  "quest.4FC309242490B654.quest_subtitle": "It hums. That's normal.",
  "quest.4FC309242490B654.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Its ore sits between Y -\"},{\"text\":\"40\",\"color\":\"#A99BFF\"},{\"text\":\" and \"},{\"text\":\"14\",\"color\":\"#A99BFF\"},{\"text\":\", thickest around -\"},{\"text\":\"13\",\"color\":\"#A99BFF\"},{\"text\":\", in stone and deepslate.\"}]",
    "",
    "[\"\",{\"text\":\"Each ore drops one \"},{\"text\":\"Arcane Crystal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:arcane_crystal\",\"count\":1}}},{\"text\":\", more with Fortune.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Keep whole crystals: the first two forge upgrades eat eight.\"}]"
  ],
  "quest.72FC0572C7252A6E.title": "Crystal for the common store",
  "quest.72FC0572C7252A6E.quest_subtitle": "Somebody always needs dust.",
  "quest.72FC0572C7252A6E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Sixteen arcane crystals for the common store, once a day.\"}]",
    "",
    "Dust, Mundabitur, Deorum and the first forge upgrades all start from them."
  ],
  "quest.58C0337B2A6CA678.title": "Arcane Crystal Dust",
  "quest.58C0337B2A6CA678.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Smelt or blast a crystal into \"},{\"text\":\"Arcane Crystal Dust\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:arcane_crystal_dust\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Mundabitur, Deorum, Aureal Bottles, Arcane Bone Meal and Corrupti Dust all take it."
  ],
  "quest.338375EA7163146B.title": "Darkstone",
  "quest.338375EA7163146B.quest_subtitle": "The basement, sold by the ton.",
  "quest.338375EA7163146B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"It fills the floor of the world, from bedrock up to about Y -\"},{\"text\":\"51\",\"color\":\"#A99BFF\"},{\"text\":\", in veins of up to twenty blocks.\"}]",
    "",
    "[\"\",{\"text\":\"Four \"},{\"text\":\"Darkstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:darkstone\",\"count\":1}}},{\"text\":\" polish into four Polished Darkstone, and the forge floor alone wants \"},{\"text\":\"48\",\"color\":\"#A99BFF\"},{\"text\":\".\"}]"
  ],
  "quest.5693E18BB2B40839.title": "Mundabitur Dust",
  "quest.5693E18BB2B40839.quest_subtitle": "Wake-up powder for sleeping stone.",
  "quest.5693E18BB2B40839.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"One pinch wakes up a finished structure.\"}]",
    "",
    "[\"\",{\"text\":\"Arcane crystal dust, redstone, blaze powder, bone meal, a phantom membrane and gunpowder make four \"},{\"text\":\"Mundabitur Dust\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:mundabitur_dust\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Used on a finished structure it wakes it up: the Clibano, the forge and the crystal obelisks all start with a pinch."
  ],
  "quest.3C32648DA7CFCF15.title": "Deorum",
  "quest.3C32648DA7CFCF15.quest_subtitle": "Gold that went to finishing school.",
  "quest.3C32648DA7CFCF15.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Gold that pays for the forge's floor and its third tier.\"}]",
    "",
    "A gold ingot in the middle, two Mundabitur Dust and two arcane crystal dust beside it, charcoal in the corners.",
    "",
    "[\"\",{\"text\":\"Deorum Ingots\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:deorum_ingot\",\"count\":1}}},{\"text\":\" gild the forge floor, make its arcane blocks and pay the tier \"},{\"text\":\"3\",\"color\":\"#A99BFF\"},{\"text\":\" upgrade.\"}]"
  ],
  "quest.5D48E2CFBF8D6733.title": "The forge floor",
  "quest.5D48E2CFBF8D6733.quest_subtitle": "Sixty-one blocks, no pressure.",
  "quest.5D48E2CFBF8D6733.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A flat floor with a gilded heart.\"}]",
    "",
    "Nine by nine with the corners cut:",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"48\",\"color\":\"#A99BFF\"},{\"text\":\" \"},{\"text\":\"Polished Darkstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:polished_darkstone\",\"count\":1}}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"9\",\"color\":\"#A99BFF\"},{\"text\":\" \"},{\"text\":\"Gilded Chiseled Polished Darkstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:gilded_chiseled_polished_darkstone\",\"count\":1}}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"4\",\"color\":\"#A99BFF\"},{\"text\":\" \"},{\"text\":\"Chiseled Arcane Polished Darkstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:chiseled_arcane_polished_darkstone\",\"count\":1}}},{\"text\":\", in a cross around the centre\"}]",
    "{@pagebreak}",
    "One Deorum Nugget gilds a chiseled block. The arcane ones start as eight Polished Darkstone around a Deorum Ingot, then slabs, then two slabs stacked. The gilded blocks sit under the centre and the eight pedestal spots."
  ],
  "quest.0DEEAA8CD231572A.title": "Darkstone Pedestals",
  "quest.0DEEAA8CD231572A.quest_subtitle": "Eight seats at the table.",
  "quest.0DEEAA8CD231572A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three arcane polished darkstone slabs on top, a pillar, three Polished Darkstone at the foot.\"}]",
    "",
    "[\"\",{\"text\":\"Eight \"},{\"text\":\"Darkstone Pedestals\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:darkstone_pedestal\",\"count\":1}}},{\"text\":\" stand on the outer gilded blocks, and each holds one ritual ingredient.\"}]"
  ],
  "quest.358A3821475C5EDC.title": "Watch it built",
  "quest.358A3821475C5EDC.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Hover a Darkstone Pedestal or the forge and hold \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.ponder.ponder\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\": Ponder lays the floor block by block. Its label says \"},{\"text\":\"45\",\"color\":\"#A99BFF\"},{\"text\":\" Polished Darkstone; the pattern the forge checks wants \"},{\"text\":\"48\",\"color\":\"#A99BFF\"},{\"text\":\".\"}]"
  ],
  "quest.00D0B2C1D5AE335F.title": "Hands off the pedestals",
  "quest.00D0B2C1D5AE335F.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Rituals never fail by chance. Swap a pedestal item while the circle turns and it fails with a bang, spitting out the main ingredient; wait, and the result lands in the main slot.\"}]"
  ],
  "quest.0E80A8EFE984002E.title": "Magical Farmland",
  "quest.0E80A8EFE984002E.quest_subtitle": "Double harvest, same seeds.",
  "quest.0E80A8EFE984002E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Bone meal that upgrades the field, not the crop.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Four bone meal around arcane crystal dust make four \"},{\"text\":\"Arcane Bone Meal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:arcane_bone_meal\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Use one on farmland to make it magical.\"}]",
    "",
    "Fully grown crops on it drop twice, seeds of wheat, beetroot, melon and pumpkin excepted."
  ],
  "quest.4E7A15C1D48FC57D.title": "Storm in a pinch",
  "quest.4E7A15C1D48FC57D.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Mundabitur Dust on a creeper charges it, no thunderstorm needed. The mobs a charged creeper blows up can drop their heads.\"}]"
  ],
  "quest.0C5E009946DCB505.title": "Aurum, orchids and fungyss",
  "quest.0C5E009946DCB505.quest_subtitle": "The flower forest's secret shelf.",
  "quest.0C5E009946DCB505.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Where the gold trees grow, and who sells the saplings.\"}]",
    "",
    "Aurum trees and Yellow Orchids grow in flower forests, and a few aurum leaves drop gold nuggets.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Wandering Traders sell \"},{\"text\":\"Aurum Saplings\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:aurum_sapling\",\"count\":1}}},{\"text\":\", Yellow Orchids and Fungyss.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Bone meal grows a Fungyss into a giant mushroom.\"}]"
  ],
  "quest.01CECD15EB6D9432.title": "What the mobs leave",
  "quest.01CECD15EB6D9432.quest_subtitle": "Bats, squid and endermen, all donors.",
  "quest.01CECD15EB6D9432.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three mobs leave parts you'd never think to keep.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:ender_pearl_fragment\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Bats drop Bat Wings now and then, squid Tentacles, endermen up to two \"},{\"text\":\"Ender Pearl Fragments\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:ender_pearl_fragment\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Four fragments rebuild a pearl.\"}]",
    "",
    "A wing, a mushroom, nether wart and a bowl make Bat Soup, with twelve seconds of Night Vision."
  ],
  "quest.75FD269D6078BCB0.title": "Building in the dark",
  "quest.75FD269D6078BCB0.quest_subtitle": "The forge floor, but for your house.",
  "quest.75FD269D6078BCB0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Darkstone comes in bricks, tiles, pillars, walls and chiseled blocks.\"}]",
    "",
    "Deorum gives glass, doors, chains and lanterns, a Rune in eight glass makes Runic Glass, and Soulless Sand has a sandstone set of its own."
  ],
  "task.6E6D0FC41FCD90EF.title": "Look at your forge",
  "quest.253FE16B6D4A2791.title": "The Hephaestus Forge",
  "quest.253FE16B6D4A2791.quest_subtitle": "Stand back. It's a lightning thing.",
  "quest.253FE16B6D4A2791.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Build the floor first, then wake a smithing table.\"}]",
    "",
    "[\"\",{\"text\":\"Put a \"},{\"text\":\"Smithing Table\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:smithing_table\",\"count\":1}}},{\"text\":\" on the central gilded block, keep the air above the floor clear and use Mundabitur Dust on the table.\"}]",
    "",
    "[\"\",{\"text\":\"A crimson bolt strikes, harmless, and the table is now a tier \"},{\"text\":\"1\",\"color\":\"#A99BFF\"},{\"text\":\" forge.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Its menu holds the main ingredient in the middle, an input slot for each essence and the enhancer slots: one at tier \"},{\"text\":\"1\",\"color\":\"#A99BFF\"},{\"text\":\" and one more per tier, up to four.\"}]",
    "",
    "Broken, the forge drops itself with its tier."
  ],
  "quest.25867C799AFFEEC8.title": "The first ritual",
  "quest.25867C799AFFEEC8.quest_subtitle": "Strike once. Then touch nothing.",
  "quest.25867C799AFFEEC8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Lodestone and a handful of clay, wax, slime and iron.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"A Lodestone in the main slot.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"On the pedestals two clay balls, two Wax, two slime balls and an iron ingot.\"}]",
    "",
    "[\"\",{\"text\":\"With \"},{\"text\":\"100\",\"color\":\"#A99BFF\"},{\"text\":\" \"},{\"text\":\"aureal\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"20379F2B379281E0\"}},{\"text\":\", \"},{\"text\":\"1,250\",\"color\":\"#A99BFF\"},{\"text\":\" \"},{\"text\":\"blood\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"43964D75733C9493\"}},{\"text\":\" and \"},{\"text\":\"2\",\"color\":\"#A99BFF\"},{\"text\":\" \"},{\"text\":\"souls\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"13CC10E9C5C72D52\"}},{\"text\":\" in the forge, right-click it with a gavel: out comes \"},{\"text\":\"Ferrognetic Mixture\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:ferrognetic_mixture\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "Every ritual works like this: the main ingredient in the forge, exactly one item per pedestal, the essences in the tanks, a gavel strike.",
    "",
    "Wax is a honey bottle and a slime ball."
  ],
  "task.1959157B41C5D9CE.title": "Look at a tier 2 forge",
  "quest.6488F327A9FE403D.title": "Tier 2",
  "quest.6488F327A9FE403D.quest_subtitle": "The forge grows by eating.",
  "quest.6488F327A9FE403D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"One ritual, three kinds of food.\"}]",
    "",
    "[\"\",{\"text\":\"Tier \"},{\"text\":\"2\",\"font\":\"entrelumen:quest_big\",\"color\":\"#A99BFF\"},{\"text\":\" holds \"},{\"text\":\"3,000\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"50\",\"color\":\"#A99BFF\"},{\"text\":\" souls, \"},{\"text\":\"15,000\",\"color\":\"#A99BFF\"},{\"text\":\" blood and \"},{\"text\":\"1,350\",\"color\":\"#A99BFF\"},{\"text\":\" experience, with two enhancer slots.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Main slot: \"},{\"text\":\"Edelwood Planks\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"63CB6C45914A7709\"}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Pedestals: four arcane crystals and four \"},{\"text\":\"Spawner Scrap\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"689CD59FDC4C6701\"}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Essences: \"},{\"text\":\"500\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"6,000\",\"color\":\"#A99BFF\"},{\"text\":\" blood and \"},{\"text\":\"10\",\"color\":\"#A99BFF\"},{\"text\":\" souls\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Each upgrade needs exactly the tier before it and every soul that tier can hold: \"},{\"text\":\"10\",\"color\":\"#A99BFF\"},{\"text\":\", \"},{\"text\":\"50\",\"color\":\"#A99BFF\"},{\"text\":\", \"},{\"text\":\"100\",\"color\":\"#A99BFF\"},{\"text\":\", then \"},{\"text\":\"500\",\"color\":\"#A99BFF\"},{\"text\":\".\"}]"
  ],
  "quest.6CA12743B44C426C.title": "Apply Modifier",
  "quest.6CA12743B44C426C.quest_subtitle": "Tools that cheat, one trick each.",
  "quest.6CA12743B44C426C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight darkstone around a Netherite Upgrade make the \"},{\"text\":\"Smithing Template\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:apply_modifier_smithing_template\",\"count\":1}}},{\"text\":\" for modifiers.\"}]",
    "",
    "At a Smithing Table it joins a tool or an armor piece with a modifier item forged in the Hephaestus Forge."
  ],
  "task.5066B1A110B63AF9.title": "Look at a tier 3 forge",
  "quest.4BCB6540F2A03C41.title": "Tier 3",
  "quest.4BCB6540F2A03C41.quest_subtitle": "Gold makes everything better. Deorum, twice.",
  "quest.4BCB6540F2A03C41.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Same table, richer plate.\"}]",
    "",
    "[\"\",{\"text\":\"Tier \"},{\"text\":\"3\",\"font\":\"entrelumen:quest_big\",\"color\":\"#A99BFF\"},{\"text\":\" holds \"},{\"text\":\"5,000\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"100\",\"color\":\"#A99BFF\"},{\"text\":\" souls, \"},{\"text\":\"30,000\",\"color\":\"#A99BFF\"},{\"text\":\" blood and \"},{\"text\":\"2,500\",\"color\":\"#A99BFF\"},{\"text\":\" experience, with three enhancer slots.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Main slot: Chiseled Polished Darkstone\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Pedestals: four arcane crystals and four Deorum Ingots\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Essences: \"},{\"text\":\"1,000\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"9,000\",\"color\":\"#A99BFF\"},{\"text\":\" blood and \"},{\"text\":\"50\",\"color\":\"#A99BFF\"},{\"text\":\" souls\"}]",
    "{@pagebreak}",
    "It opens the Eternal Stella, the Quantum Injector and the Sea and Whirlwind Prisms."
  ],
  "quest.312349D84B6E290C.title": "Eternal Stella",
  "quest.312349D84B6E290C.quest_subtitle": "Forever has a price. It's in Act IV.",
  "quest.312349D84B6E290C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Turn a tool into one that never breaks.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Main slot: a diamond\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Pedestals: three Xpetrified Orbs and a \"},{\"text\":\"Stellarite Piece\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"52CF7E2611C2A687\"}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Essences: \"},{\"text\":\"82\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"1,000\",\"color\":\"#A99BFF\"},{\"text\":\" blood and \"},{\"text\":\"1\",\"color\":\"#A99BFF\"},{\"text\":\" soul\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"A tier \"},{\"text\":\"3\",\"color\":\"#A99BFF\"},{\"text\":\" ritual. In this pack it also wants a \"},{\"text\":\"Containment Seal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:containment_seal\",\"count\":1}}},{\"text\":\" on the pedestals.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"At the Smithing Table the \"},{\"text\":\"Eternal Stella\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:eternal_stella\",\"count\":1}}},{\"text\":\" makes a tool or armor piece Eternal: its durability is gone for good.\"}]",
    "",
    "Elytra refuse it."
  ],
  "task.4ED2727F9F418F91.title": "Look at a tier 4 forge",
  "quest.093B7EBC34AED82F.title": "Tier 4",
  "quest.093B7EBC34AED82F.quest_subtitle": "A hundred souls, all accounted for.",
  "quest.093B7EBC34AED82F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The plate gets heavy.\"}]",
    "",
    "[\"\",{\"text\":\"Tier \"},{\"text\":\"4\",\"font\":\"entrelumen:quest_big\",\"color\":\"#A99BFF\"},{\"text\":\" holds \"},{\"text\":\"10,000\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"500\",\"color\":\"#A99BFF\"},{\"text\":\" souls, \"},{\"text\":\"50,000\",\"color\":\"#A99BFF\"},{\"text\":\" blood and \"},{\"text\":\"5,000\",\"color\":\"#A99BFF\"},{\"text\":\" experience.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Main slot: Chiseled Polished Darkstone again\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Pedestals: four \"},{\"text\":\"Stellarite Pieces\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"52CF7E2611C2A687\"}},{\"text\":\" and four \"},{\"text\":\"Runes\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1EF883D9A7A41ECA\"}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Essences: \"},{\"text\":\"2,000\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"12,000\",\"color\":\"#A99BFF\"},{\"text\":\" blood and \"},{\"text\":\"100\",\"color\":\"#A99BFF\"},{\"text\":\" souls\"}]",
    "{@pagebreak}",
    "All four enhancer slots open."
  ],
  "quest.4D22C5E3A84C7B6F.title": "The last offering",
  "quest.4D22C5E3A84C7B6F.quest_subtitle": "Everything the forge asked for, at once.",
  "quest.4D22C5E3A84C7B6F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The whole pantry, in one sitting.\"}]",
    "",
    "[\"\",{\"text\":\"The tier \"},{\"text\":\"5\",\"font\":\"entrelumen:quest_big\",\"color\":\"#A99BFF\"},{\"text\":\" ritual:\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Main slot: a \"},{\"text\":\"Stellarite Block\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:stellarite_block\",\"count\":1}}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Pedestals: four Sculk Catalysts, two \"},{\"text\":\"Dark Nether Stars\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FA7700B4E305788\"}},{\"text\":\" and two Dragon Scales\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Essences: \"},{\"text\":\"5,000\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"20,000\",\"color\":\"#A99BFF\"},{\"text\":\" blood and \"},{\"text\":\"500\",\"color\":\"#A99BFF\"},{\"text\":\" souls\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A \"},{\"text\":\"Crimson Stone\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"21FD8E9DDE9B1674\"}},{\"text\":\" halves those \"},{\"text\":\"500\",\"color\":\"#A99BFF\"},{\"text\":\" souls.\"}]"
  ],
  "task.27D687CF2B3FA780.title": "Look at a tier 5 forge",
  "quest.5CA11C0E042C3532.title": "Master of the forge",
  "quest.5CA11C0E042C3532.quest_subtitle": "Five tiers, one circle of gold.",
  "quest.5CA11C0E042C3532.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The last upgrade draws a circle of its own, ringed in gold instead of white.\"}]",
    "",
    "[\"\",{\"text\":\"A tier \"},{\"text\":\"5\",\"color\":\"#A99BFF\"},{\"text\":\" forge holds \"},{\"text\":\"20,000\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"1,000\",\"color\":\"#A99BFF\"},{\"text\":\" souls, \"},{\"text\":\"100,000\",\"color\":\"#A99BFF\"},{\"text\":\" blood and \"},{\"text\":\"7,500\",\"color\":\"#A99BFF\"},{\"text\":\" experience: room for any ritual twice over.\"}]",
    "{@pagebreak}",
    "Every tier is still in the stone: darkstone, deorum, stellarite and a dragon's scales.",
    "",
    "The smithing table remembers what it was."
  ],
  "quest.1B60A5EE34117ECD.title": "Blacksmith Gavel",
  "quest.1B60A5EE34117ECD.quest_subtitle": "A hammer that thinks it's a judge.",
  "quest.1B60A5EE34117ECD.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Six clay balls shape a \"},{\"text\":\"Blacksmith Gavel Head\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:blacksmith_gavel_head\",\"count\":1}}},{\"text\":\"; four ingots and two sticks around it finish the gavel.\"}]",
    "",
    "[\"\",{\"text\":\"It mines like a pickaxe of its material, and every ritual it starts costs \"},{\"text\":\"50\",\"color\":\"#A99BFF\"},{\"text\":\" durability.\"}]"
  ],
  "quest.2A2194624B5B9D37.title": "Netherite Gavel",
  "quest.2A2194624B5B9D37.quest_subtitle": "Order in the forge, for longer.",
  "quest.2A2194624B5B9D37.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Diamond Blacksmith Gavel, a Netherite Upgrade and a netherite ingot at the Smithing Table.\"}]",
    "",
    "It shrugs off fire and lava like any netherite tool and starts about forty rituals before it needs mending."
  ],
  "quest.36C3D50459FB3977.title": "The gavel's other job",
  "quest.36C3D50459FB3977.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Any gavel is also a pickaxe, and ores mined with one drop double \"},{\"text\":\"30%\",\"color\":\"#A99BFF\"},{\"text\":\" of the time. Silk Touch turns that off.\"}]"
  ],
  "quest.20379F2B379281E0.title": "Aureal",
  "quest.20379F2B379281E0.quest_subtitle": "Bottled light, arcane blend.",
  "quest.20379F2B379281E0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Your first essence comes out of a potion.\"}]",
    "",
    "[\"\",{\"text\":\"Eight arcane crystal dust around a Potion of Regeneration II make an \"},{\"text\":\"Aureal Bottle\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:aureal_bottle\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"35\",\"color\":\"#A99BFF\"},{\"text\":\" aureal in the forge's aureal slot.\"}]",
    "",
    "Dungeon chests hold one or two a fifth of the time.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Drink one instead and its \"},{\"text\":\"35\",\"color\":\"#A99BFF\"},{\"text\":\" go to your own aureal, which holds \"},{\"text\":\"100\",\"color\":\"#A99BFF\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Brewed with gunpowder it becomes a Splash Aureal Bottle: \"},{\"text\":\"30\",\"color\":\"#A99BFF\"},{\"text\":\" aureal for every player within four blocks.\"}]"
  ],
  "quest.13CC10E9C5C72D52.title": "Souls",
  "quest.13CC10E9C5C72D52.quest_subtitle": "Ten fill a tier 1 forge.",
  "quest.13CC10E9C5C72D52.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Kill a ghost, or squeeze a soul out of sand.\"}]",
    "",
    "[\"\",{\"text\":\"Lost Souls wander the Overworld and drop a \"},{\"text\":\"Soul\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:soul\",\"count\":1}}},{\"text\":\" when killed, and a Soul Extractor pulls one out of every soul sand block.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"A Soul is \"},{\"text\":\"1\",\"font\":\"entrelumen:quest_big\",\"color\":\"#A99BFF\"},{\"text\":\" in the forge's soul slot.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Tier \"},{\"text\":\"1\",\"color\":\"#A99BFF\"},{\"text\":\" holds \"},{\"text\":\"10\",\"color\":\"#A99BFF\"},{\"text\":\".\"}]"
  ],
  "quest.43964D75733C9493.title": "Blood",
  "quest.43964D75733C9493.quest_subtitle": "The forge takes it fresh.",
  "quest.43964D75733C9493.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Anything hurt within five blocks of the forge adds \"},{\"text\":\"20\",\"color\":\"#A99BFF\"},{\"text\":\" blood per point of health it loses.\"}]",
    "",
    "[\"\",{\"text\":\"To carry it, hold a \"},{\"text\":\"Test Tube\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:test_tube\",\"count\":1}}},{\"text\":\" (a glass bottle and a Rune) in your off hand while you fight: it fills up to \"},{\"text\":\"3,000\",\"color\":\"#A99BFF\"},{\"text\":\".\"}]"
  ],
  "task.331BF33031809BFF.title": "Look at an obelisk",
  "quest.51BC45132861AF2D.title": "Arcane Crystal Obelisk",
  "quest.51BC45132861AF2D.quest_subtitle": "Aureal on a drip.",
  "quest.51BC45132861AF2D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Stack two Arcane Crystal Blocks on an Arcane Polished Darkstone and use Mundabitur on them.\"}]",
    "",
    "[\"\",{\"text\":\"The obelisk gives \"},{\"text\":\"1\",\"color\":\"#A99BFF\"},{\"text\":\" aureal every five seconds to the nearest forge within four blocks.\"}]"
  ],
  "task.73D1F97B97ACF0A9.title": "Kill 3 Lost Souls",
  "quest.7AEAAC0E31EFF00A.title": "Soul Looting",
  "quest.7AEAAC0E31EFF00A.quest_subtitle": "Everybody has a little ghost in them.",
  "quest.7AEAAC0E31EFF00A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Soul Looting on a sword gives each kill a \"},{\"text\":\"5\",\"color\":\"#A99BFF\"},{\"text\":\", \"},{\"text\":\"10\",\"color\":\"#A99BFF\"},{\"text\":\" or \"},{\"text\":\"15%\",\"color\":\"#A99BFF\"},{\"text\":\" chance to free a Lost Soul.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Players, villagers and traders release plain ones.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Zombies, skeletons, witches, illagers and piglins, corrupt ones that drop Corrupt Souls.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"One freed soul in \"},{\"text\":\"25\",\"color\":\"#A99BFF\"},{\"text\":\" comes out enchanted, and its Enchanted Soul is worth \"},{\"text\":\"10\",\"color\":\"#A99BFF\"},{\"text\":\" in the forge.\"}]",
    "",
    "[\"\",{\"text\":\"Corrupt Souls grow \"},{\"text\":\"Edelwood\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"63CB6C45914A7709\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A \"},{\"text\":\"Splash Aureal Bottle\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"20379F2B379281E0\"}},{\"text\":\" turns a Corrupt Lost Soul into a plain one, and a plain one into an enchanted one.\"}]"
  ],
  "quest.24A3592008C81356.title": "Experience",
  "quest.24A3592008C81356.quest_subtitle": "Melt the old gear. Sentiment not included.",
  "quest.24A3592008C81356.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A \"},{\"text\":\"Bottle o' Enchanting\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:experience_bottle\",\"count\":1}}},{\"text\":\" is worth \"},{\"text\":\"15\",\"color\":\"#A99BFF\"},{\"text\":\" in the forge's experience slot.\"}]",
    "",
    "Enchanted gear and books melt there too: their enchantments turn into experience and books come back blank, but curses stay put."
  ],
  "quest.40C2A1FCDBC69DD4.title": "Soul Extractor",
  "quest.40C2A1FCDBC69DD4.quest_subtitle": "Soul sand, now with less soul.",
  "quest.40C2A1FCDBC69DD4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"An Utrem Jar, nether bricks, quartz and a quartz block.\"}]",
    "",
    "Hold use on soul sand for a moment: it turns into Soulless Sand and drops a Soul.",
    "",
    "[\"\",{\"text\":\"128\",\"color\":\"#A99BFF\"},{\"text\":\" uses per extractor.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Soulless Sand still lifts bubble columns, and a Soul used on it turns it back into soul sand.\"}]"
  ],
  "quest.66FA3B10ABA7E628.title": "A soul with a glint",
  "quest.66FA3B10ABA7E628.quest_subtitle": "One in twenty-five. You were the one.",
  "quest.66FA3B10ABA7E628.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"You took down an Enchanted Lost Soul.\"}]",
    "",
    "[\"\",{\"text\":\"Its Enchanted Soul feeds the forge \"},{\"text\":\"10\",\"color\":\"#A99BFF\"},{\"text\":\" souls at once, or burns in the Clibano as enchanted fire, two and a half times faster.\"}]"
  ],
  "reward.311CE0DAD9836FD8.title": "Secret found",
  "quest.1754343F2BDF9563.title": "Essence in a jar",
  "quest.1754343F2BDF9563.quest_subtitle": "A pantry for the forge.",
  "quest.1754343F2BDF9563.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Seven colorless glass and an Edelwood Plank make an Utrem Jar.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Place it and use any essence item on it (a bottle, a soul, a filled test tube) and it becomes a jar of that essence, up to \"},{\"text\":\"10,000\",\"color\":\"#A99BFF\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Broken, it keeps what it holds.\"}]"
  ],
  "quest.0C9814B908DFD505.title": "Quantum Injector",
  "quest.0C9814B908DFD505.quest_subtitle": "Plumbing, but for souls.",
  "quest.0C9814B908DFD505.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The forge drinks from your jars by itself.\"}]",
    "",
    "[\"\",{\"text\":\"Set it within four blocks of a forge and right-click it on: it pipes essence from jars within eight blocks, \"},{\"text\":\"20\",\"color\":\"#A99BFF\"},{\"text\":\" a second of each kind the forge lacks.\"}]",
    "",
    "Another right-click switches it off.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"A tier \"},{\"text\":\"3\",\"color\":\"#A99BFF\"},{\"text\":\" ritual: Mundabitur Dust in the main slot and four Quantum Cores, for \"},{\"text\":\"5,000\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"3,000\",\"color\":\"#A99BFF\"},{\"text\":\" blood, \"},{\"text\":\"1,060\",\"color\":\"#A99BFF\"},{\"text\":\" experience and \"},{\"text\":\"50\",\"color\":\"#A99BFF\"},{\"text\":\" souls.\"}]"
  ],
  "task.5159267783BDD88D.title": "Look at a Magnetized Pedestal",
  "quest.0F1D6797D3FB32B6.title": "Magnetized",
  "quest.0F1D6797D3FB32B6.quest_subtitle": "It's attractive, and it knows it.",
  "quest.0F1D6797D3FB32B6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A pedestal that catches what you drop on it.\"}]",
    "",
    "Ferrognetic Mixture on a Darkstone Pedestal magnetizes it: when empty it grabs one item dropped on top, so a dropper can load it.",
    "",
    "On boots at the Smithing Table the mixture is the Magnetized modifier, which pulls nearby items to you."
  ],
  "quest.63CB6C45914A7709.title": "Edelwood",
  "quest.63CB6C45914A7709.quest_subtitle": "A tree that grows from a bad mood.",
  "quest.63CB6C45914A7709.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Corrupt souls plant it; the forge eats its planks.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Use a Corrupt Soul on an oak sapling or a dead bush and it becomes Growing Edelwood.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Wandering Traders sell one for \"},{\"text\":\"6\",\"color\":\"#A99BFF\"},{\"text\":\" emeralds.\"}]",
    "",
    "It grows in bright light, faster with bone meal, into a hollow tree whose branches drop Edelwood Sticks.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Its planks are the tier \"},{\"text\":\"2\",\"color\":\"#A99BFF\"},{\"text\":\" main ingredient.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Smelt a log into Dark Matter.\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:edelwood_oil\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Now and then a log turns oily, and a glass bottle collects \"},{\"text\":\"Edelwood Oil\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:edelwood_oil\",\"count\":1}}},{\"text\":\", which crafts into black dye.\"}]"
  ],
  "quest.689CD59FDC4C6701.title": "Spawner Scrap",
  "quest.689CD59FDC4C6701.quest_subtitle": "Recycling, but angrier.",
  "quest.689CD59FDC4C6701.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Break a spawner without Silk Touch and it drops \"},{\"text\":\"Spawner Scrap\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:spawner_scrap\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Four go into the tier \"},{\"text\":\"2\",\"color\":\"#A99BFF\"},{\"text\":\" upgrade, four into a Quantum Catcher.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"In this pack Silk Touch never lifts a spawner, so it only costs you the scrap.\"}]"
  ],
  "quest.374121FB0483D5B9.title": "Edelwood Bucket",
  "quest.374121FB0483D5B9.quest_subtitle": "A wooden bucket with ambitions.",
  "quest.374121FB0483D5B9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A bigger bucket, and ladders that climb faster.\"}]",
    "",
    "Five Edelwood Planks make a bucket that carries four buckets of water or milk, or three of lava or powder snow.",
    "",
    "Edelwood Ladders are worth one look too: you climb them faster.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A Botany Pot takes a full Edelwood Water Bucket as a water soil.\"}]"
  ],
  "quest.5AF7DFE420AA7A06.title": "Magic Wand",
  "quest.5AF7DFE420AA7A06.quest_subtitle": "Point the dangerous end away from friends.",
  "quest.5AF7DFE420AA7A06.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"An arcane crystal, a Deorum Ingot and an Edelwood Stick from an Edelwood branch.\"}]",
    "",
    "[\"\",{\"text\":\"Hold use for a second and a half and the \"},{\"text\":\"Magic Wand\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:magic_wand\",\"count\":1}}},{\"text\":\" fires an aureal missile, \"},{\"text\":\"5\",\"color\":\"#A99BFF\"},{\"text\":\" of your own aureal a shot.\"}]"
  ],
  "quest.4D06EC892DA23352.title": "Quantum Catcher",
  "quest.4D06EC892DA23352.quest_subtitle": "A moving van for villagers.",
  "quest.4D06EC892DA23352.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Store a creature, carry it, set it down again.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Tier \"},{\"text\":\"1\",\"color\":\"#A99BFF\"},{\"text\":\" ritual: a Quantum Core (Rune, flint, Mundabitur) in the main slot and four Spawner Scrap\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Essences: \"},{\"text\":\"200\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"1,200\",\"color\":\"#A99BFF\"},{\"text\":\" blood, \"},{\"text\":\"155\",\"color\":\"#A99BFF\"},{\"text\":\" experience and \"},{\"text\":\"5\",\"color\":\"#A99BFF\"},{\"text\":\" souls\"}]",
    "",
    "Right-click a creature to store it and a block to let it out.",
    "{@pagebreak}",
    "The catch costs your own aureal: half a passive creature's health, or its health plus a tenth for a hostile one.",
    "",
    "[\"\",{\"text\":\"Your meter holds \"},{\"text\":\"100\",\"color\":\"#A99BFF\"},{\"text\":\", and bosses don't fit.\"}]"
  ],
  "quest.49DE53235C00DEB6.title": "Boss Catcher",
  "quest.49DE53235C00DEB6.quest_subtitle": "The fine print is in aureal.",
  "quest.49DE53235C00DEB6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The catcher that fits a boss.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Tier \"},{\"text\":\"4\",\"color\":\"#A99BFF\"},{\"text\":\" ritual: it turns a Quantum Catcher into a \"},{\"text\":\"Boss Catcher\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:boss_catcher\",\"count\":1}}},{\"text\":\" with a Nether Star and three Stellarite Pieces\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Essences: \"},{\"text\":\"500\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"7,500\",\"color\":\"#A99BFF\"},{\"text\":\" blood, \"},{\"text\":\"1,200\",\"color\":\"#A99BFF\"},{\"text\":\" experience and \"},{\"text\":\"10\",\"color\":\"#A99BFF\"},{\"text\":\" souls\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"It lifts the boss ban, not the price: with \"},{\"text\":\"100\",\"color\":\"#A99BFF\"},{\"text\":\" aureal at most, a hostile catch tops out at \"},{\"text\":\"90\",\"color\":\"#A99BFF\"},{\"text\":\" health.\"}]"
  ],
  "quest.6653C2EF87A62B16.title": "Elementarium",
  "quest.6653C2EF87A62B16.quest_subtitle": "The prisms won't answer without it.",
  "quest.6653C2EF87A62B16.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Jungle temples, desert pyramids and ocean ruins hide one about a fifth of the time.\"}]",
    "",
    "It does nothing by itself: every prism ritual wants it in one of the forge's enhancer slots."
  ],
  "quest.4963D4735CDC9490.title": "One trick per tool",
  "quest.4963D4735CDC9490.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"An item takes a single modifier, and only if it carries none of the enchantments that modifier refuses: Silk Touch blocks Fiery, Unbreaking and Mending block Eternal.\"}]"
  ],
  "quest.07F9AD9AAA721431.title": "Fiery",
  "quest.07F9AD9AAA721431.quest_subtitle": "Cooks the ore before it lands.",
  "quest.07F9AD9AAA721431.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A prism that turns every dig into a furnace.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Tier \"},{\"text\":\"1\",\"color\":\"#A99BFF\"},{\"text\":\" ritual: an Arcane Crystal Block in the middle, two coal and four blaze powder around it\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Essences: \"},{\"text\":\"200\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"1,250\",\"color\":\"#A99BFF\"},{\"text\":\" blood and \"},{\"text\":\"4\",\"color\":\"#A99BFF\"},{\"text\":\" souls\"}]",
    "",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Smelter Prism\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:smelter_prism\",\"count\":1}}},{\"text\":\" makes a digging tool Fiery: whatever it breaks drops already smelted.\"}]"
  ],
  "quest.4EE724303EDEEC12.title": "Demolishing",
  "quest.4EE724303EDEEC12.quest_subtitle": "Three by three, no questions asked.",
  "quest.4EE724303EDEEC12.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Dig one block, break nine.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Tier \"},{\"text\":\"2\",\"color\":\"#A99BFF\"},{\"text\":\" ritual: a Diamond Block, two flint, two dripstone blocks and two pointed dripstone\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Essences: \"},{\"text\":\"300\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"1,500\",\"color\":\"#A99BFF\"},{\"text\":\" blood and \"},{\"text\":\"9\",\"color\":\"#A99BFF\"},{\"text\":\" souls\"}]",
    "",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Terrastomp Prism\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:terrastomp_prism\",\"count\":1}}},{\"text\":\" makes a digging tool Demolishing: it breaks the \"},{\"text\":\"3×3\",\"color\":\"#A99BFF\"},{\"text\":\" face around the block you mine.\"}]"
  ],
  "quest.2C296EDA7EF8439A.title": "Aquatic",
  "quest.2C296EDA7EF8439A.quest_subtitle": "Gills sold separately. Healing included.",
  "quest.2C296EDA7EF8439A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A helmet for working underwater.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Tier \"},{\"text\":\"3\",\"color\":\"#A99BFF\"},{\"text\":\" ritual: a Heart of the Sea, two prismarine shards, two turtle scutes and two lapis\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Essences: \"},{\"text\":\"1,000\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"2,000\",\"color\":\"#A99BFF\"},{\"text\":\" blood and \"},{\"text\":\"8\",\"color\":\"#A99BFF\"},{\"text\":\" souls\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Sea Prism\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:sea_prism\",\"count\":1}}},{\"text\":\" makes a helmet Aquatic: head underwater, you mine at full speed and heal a heart every five seconds.\"}]"
  ],
  "quest.0314F0A0C8F9511D.title": "Whirlwind Prism",
  "quest.0314F0A0C8F9511D.quest_subtitle": "An elevator with no floors.",
  "quest.0314F0A0C8F9511D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Stand on the ground and rise ten blocks.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Tier \"},{\"text\":\"3\",\"color\":\"#A99BFF\"},{\"text\":\" ritual: white wool, a bat wing, two feathers and three phantom membranes\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Essences: \"},{\"text\":\"1,000\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"2,250\",\"color\":\"#A99BFF\"},{\"text\":\" blood and \"},{\"text\":\"3\",\"color\":\"#A99BFF\"},{\"text\":\" souls\"}]",
    "",
    "[\"\",{\"text\":\"Use the \"},{\"text\":\"Whirlwind Prism\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:whirlwind_prism\",\"count\":1}}},{\"text\":\" on the ground: a ten-block updraft lifts you and leaves you a few seconds of Slow Falling.\"}]"
  ],
  "quest.52CF7E2611C2A687.title": "Stellarite",
  "quest.52CF7E2611C2A687.quest_subtitle": "The ore that fights back.",
  "quest.52CF7E2611C2A687.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Stella Arcanum ore sits between Y -\"},{\"text\":\"44\",\"color\":\"#A99BFF\"},{\"text\":\" and \"},{\"text\":\"42\",\"color\":\"#A99BFF\"},{\"text\":\" in small clusters.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"Mined without Silk Touch it explodes, radius \"},{\"text\":\"3\",\"color\":\"#A99BFF\"},{\"text\":\", breaking the blocks around it; the \"},{\"text\":\"Stellarite Piece\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:stellarite_piece\",\"count\":1}}},{\"text\":\" it leaves survives the blast.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Four pay the tier \"},{\"text\":\"4\",\"color\":\"#A99BFF\"},{\"text\":\" upgrade, nine make the Stellarite Block tier \"},{\"text\":\"5\",\"color\":\"#A99BFF\"},{\"text\":\" wants, and the Eternal Stella and the Boss Catcher take one and three.\"}]"
  ],
  "quest.2368838F0CC9051D.title": "Defused",
  "quest.2368838F0CC9051D.quest_subtitle": "You carried a bomb home in your pocket.",
  "quest.2368838F0CC9051D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"You lifted a Stella Arcanum with Silk Touch: no blast, and no stellarite either.\"}]",
    "",
    "Place it and mine it again without Silk Touch and it goes off just the same."
  ],
  "reward.100C2ECCAE7A0CE1.title": "Secret found",
  "quest.7A8E426591B7C77C.title": "A black hole",
  "quest.7A8E426591B7C77C.quest_subtitle": "Handle with tongs.",
  "quest.7A8E426591B7C77C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two ingredients thrown together, and a hole in the world.\"}]",
    "",
    "[\"\",{\"text\":\"Toss a Dark Matter (a smelted Edelwood Log) and a \"},{\"text\":\"Corrupti Dust\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:corrupti_dust\",\"count\":1}}},{\"text\":\" so they touch in open air and they collapse into a Black Hole.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"Within five blocks it pulls in items, experience orbs and arrows, and loose items are destroyed.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Every \"},{\"text\":\"60\",\"color\":\"#A99BFF\"},{\"text\":\" experience it swallows comes back as an Xpetrified Orb, thrown at the nearest player within six blocks. Nether stars, stellarite and obsidian are spared. Broken, it drops nothing: choose its spot first.\"}]"
  ],
  "quest.74A847173675E8AB.title": "Xpetrified Orbs",
  "quest.74A847173675E8AB.quest_subtitle": "Experience, set in stone.",
  "quest.74A847173675E8AB.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Each \"},{\"text\":\"Xpetrified Orb\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:xpetrified_orb\",\"count\":1}}},{\"text\":\" holds \"},{\"text\":\"91\",\"color\":\"#A99BFF\"},{\"text\":\" experience for the forge, a shade over six Bottles o' Enchanting.\"}]",
    "",
    "The Eternal Stella takes three.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A Stellarite Bee's combs give one \"},{\"text\":\"30%\",\"color\":\"#A99BFF\"},{\"text\":\" of the time in a centrifuge: see \"},{\"text\":\"Productive Bees\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7ACCFA699A46A465\"}},{\"text\":\".\"}]"
  ],
  "quest.5DCED9F986C02FD7.title": "Leave the Mending off",
  "quest.5DCED9F986C02FD7.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Eternal won't go onto an item that already carries Unbreaking or Mending, and it won't need them afterwards. Every other enchantment stays.\"}]"
  ],
  "quest.21FD8E9DDE9B1674.title": "Crimson Stone",
  "quest.21FD8E9DDE9B1674.quest_subtitle": "Half the souls, same miracle.",
  "quest.21FD8E9DDE9B1674.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Pillager outpost chests hide one \"},{\"text\":\"18%\",\"color\":\"#A99BFF\"},{\"text\":\" of the time.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"In the forge it halves the souls every ritual costs, and the last upgrades want \"},{\"text\":\"100\",\"color\":\"#A99BFF\"},{\"text\":\" and \"},{\"text\":\"500\",\"color\":\"#A99BFF\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"In the Clibano a soul burns \"},{\"text\":\"30%\",\"color\":\"#A99BFF\"},{\"text\":\" longer.\"}]"
  ],
  "quest.5FA7700B4E305788.title": "Dark Nether Star",
  "quest.5FA7700B4E305788.quest_subtitle": "A Wither trophy, repainted.",
  "quest.5FA7700B4E305788.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four \"},{\"text\":\"Obsidiansteel Ingots\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4A09E43F3C8A02F5\"}},{\"text\":\" around a Nether Star.\"}]",
    "",
    "[\"\",{\"text\":\"The tier \"},{\"text\":\"5\",\"color\":\"#A99BFF\"},{\"text\":\" upgrade takes two, and like stellarite the \"},{\"text\":\"Dark Nether Star\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:dark_nether_star\",\"count\":1}}},{\"text\":\" shrugs off explosions and black holes.\"}]"
  ],
  "quest.556990A438665B44.title": "Relics with no job",
  "quest.556990A438665B44.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The Maledictus Pact turns up in bastion treasure, but no ritual in this version asks for it. The Divine Pact, Crescent Moon and Soul Crimson Stone have no source, so neither the Soul Binding Crystal nor its Soulbound modifier can be made.\"}]"
  ],
  "quest.1D876A40378DA0A7.title": "Spectral Eye Amulet",
  "quest.1D876A40378DA0A7.quest_subtitle": "Everyone glows. Nobody asked.",
  "quest.1D876A40378DA0A7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three string, a Nether Star, two Deorum Ingots and an Eye of Ender.\"}]",
    "",
    "[\"\",{\"text\":\"Right-click it on: while the \"},{\"text\":\"Spectral Eye Amulet\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:spectral_eye_amulet\",\"count\":1}}},{\"text\":\" rides in your inventory you have Spectral Vision, and every creature nearby glows through walls.\"}]"
  ],
  "quest.4C5843A9AF1223C3.title": "Ghosts in the catalog",
  "quest.4C5843A9AF1223C3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"EMI lists items this version never hands out:\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Mortem armor\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"The Draco Arcanus tools, scepter and staff\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"The Aureal Tank and Aureal Wardstone\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Eternal and Aurealic Obsidian Skulls\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"The Mortar, the Arcane Crystal Dust Speck and the corrupted arcane crystal set\"}]",
    "",
    "Nothing gives you the first one."
  ],
  "quest.14F67361629CE0D0.title": "Dragon Scales",
  "quest.14F67361629CE0D0.quest_subtitle": "Shed, not stolen. Mostly.",
  "quest.14F67361629CE0D0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Dragon kills and End City chests, nothing else.\"}]",
    "",
    "[\"\",{\"text\":\"Every Ender Dragon kill drops one to three \"},{\"text\":\"Dragon Scales\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:dragon_scale\",\"count\":1}}},{\"text\":\", more with Looting, and End City treasure chests hold one or two a bit over half the time.\"}]",
    "",
    "The End is Act V ground.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A respawned dragon drops them too.\"}]"
  ],
  "quest.44D5BD1787A15336.title": "Draco Arcanus",
  "quest.44D5BD1787A15336.quest_subtitle": "Dress like the thing you killed.",
  "quest.44D5BD1787A15336.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Netherite becomes Draco Arcanus and keeps its enchantments.\"}]",
    "",
    "[\"\",{\"text\":\"Tier \"},{\"text\":\"2\",\"color\":\"#A99BFF\"},{\"text\":\" rituals turn each netherite armor piece into Draco Arcanus with Dragon Scales and \"},{\"text\":\"Obsidiansteel\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4A09E43F3C8A02F5\"}},{\"text\":\", eleven of each for the set.\"}]",
    "",
    "The ritual keeps everything on the netherite piece, enchantments included.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The full set refills your own aureal by \"},{\"text\":\"5\",\"color\":\"#A99BFF\"},{\"text\":\" every five seconds.\"}]"
  ],
  "quest.75C83BB63C6B3C8F.title": "Golden and aquatic scales",
  "quest.75C83BB63C6B3C8F.quest_subtitle": "Same dragon, better tailoring.",
  "quest.75C83BB63C6B3C8F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two ways to make a scale worth more.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:golden_dragon_scale\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Four Deorum Ingots around a Dragon Scale make a \"},{\"text\":\"Golden Dragon Scale\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:golden_dragon_scale\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:aquatic_dragon_scale\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A scale, a prismarine shard, prismarine crystals and arcane crystal dust make an \"},{\"text\":\"Aquatic Dragon Scale\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:aquatic_dragon_scale\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Tyr wants fifteen aquatic and ten golden."
  ],
  "quest.2C177CE6AB67CEA0.title": "Tyr",
  "quest.2C177CE6AB67CEA0.quest_subtitle": "The god of war wants his armor back.",
  "quest.2C177CE6AB67CEA0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Draco Arcanus, one step further.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Tier \"},{\"text\":\"4\",\"color\":\"#A99BFF\"},{\"text\":\" rituals raise each Draco Arcanus piece into Tyr with aquatic and golden scales.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"The chestplate alone costs \"},{\"text\":\"6,300\",\"color\":\"#A99BFF\"},{\"text\":\" aureal, \"},{\"text\":\"8,080\",\"color\":\"#A99BFF\"},{\"text\":\" blood, \"},{\"text\":\"3,420\",\"color\":\"#A99BFF\"},{\"text\":\" experience and \"},{\"text\":\"60\",\"color\":\"#A99BFF\"},{\"text\":\" souls.\"}]",
    "",
    "Enchantments carry over again.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The full set refills your own aureal by \"},{\"text\":\"10\",\"color\":\"#A99BFF\"},{\"text\":\" every five seconds.\"}]"
  ],
  "quest.5E2C197D4D14E92F.title": "Arrows with opinions",
  "quest.5E2C197D4D14E92F.quest_subtitle": "One goes boom, one breathes.",
  "quest.5E2C197D4D14E92F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Dragon's breath in one, TNT in the other.\"}]",
    "",
    "Four around a bottle of Dragon's Breath make one Draco Arcanus Arrow: a hit leaves a cloud of harming breath, like the dragon's own.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"Four arrows around TNT make four Boom Arrows, which explode where they land without breaking blocks.\"}]"
  ],
  "quest.1B0AE141F13BB7A6.title": "An egg worth more than the dragon",
  "quest.1B0AE141F13BB7A6.quest_subtitle": "Six golden scales for a paperweight.",
  "quest.1B0AE141F13BB7A6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"You wrapped the Dragon Egg in six Golden Dragon Scales, twenty-four Deorum Ingots of gilding.\"}]",
    "",
    "The Arcane Dragon Egg does nothing but fall like sand and look expensive."
  ],
  "reward.2E8788169AB790F1.title": "Secret found",
  "quest.2591D00C81AFB14D.title": "The Clibano",
  "quest.2591D00C81AFB14D.quest_subtitle": "Three by three, hollow, and hot.",
  "quest.2591D00C81AFB14D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight darkstone around a Blast Furnace make the \"},{\"text\":\"Clibano Core\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:clibano_core\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Build a 3×3×3 cube of Polished Darkstone Bricks with Polished Darkstone corners, leave the middle hollow, set the core in the centre of one face and dust it with \"},{\"text\":\"Mundabitur\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5693E18BB2B40839\"}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "It cooks only its own recipes (ores, raw metals, arcane crystal, runic stone), two at a time.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Blast furnace fuel works.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"Souls in their own slot make the fire faster.\"}]"
  ],
  "quest.1EF883D9A7A41ECA.title": "Runes",
  "quest.1EF883D9A7A41ECA.quest_subtitle": "Stone with something to say.",
  "quest.1EF883D9A7A41ECA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Runic stone forms below Y \"},{\"text\":\"2\",\"color\":\"#A99BFF\"},{\"text\":\", and inside darkstone it turns into runic darkstone.\"}]",
    "",
    "[\"\",{\"text\":\"Mining it drops a \"},{\"text\":\"Rune\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:rune\",\"count\":1}}},{\"text\":\", Fortune helps, and a furnace, a blast furnace or the Clibano turns silk-touched stone into one too.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Runes make Test Tubes, Quantum Cores and Runic Glass, and four pay the tier \"},{\"text\":\"4\",\"color\":\"#A99BFF\"},{\"text\":\" upgrade.\"}]"
  ],
  "quest.16950761F7920B65.title": "Nine residues, one block",
  "quest.16950761F7920B65.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Clibano recipes can leave a residue: a third of the time for iron, copper, coal and arcane crystal, a fifth for gold and lapis, a tenth for diamond, emerald and runes, one in twenty for ancient debris. Nine of a kind make a block, and nine netherite residues a Block of Netherite.\"}]"
  ],
  "quest.3B69EC6CAD40801E.title": "Soul fire",
  "quest.3B69EC6CAD40801E.quest_subtitle": "Faster, and it only costs a soul.",
  "quest.3B69EC6CAD40801E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Feed it a soul and the flames turn blue.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"A \"},{\"text\":\"Soul\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:soul\",\"count\":1}}},{\"text\":\" or a Corrupt Soul in the soul slot turns the flames blue and cooks \"},{\"text\":\"1.5\",\"color\":\"#A99BFF\"},{\"text\":\" times faster for \"},{\"text\":\"135\",\"color\":\"#A99BFF\"},{\"text\":\" seconds.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"An Enchanted Soul makes enchanted fire, \"},{\"text\":\"2.5\",\"color\":\"#A99BFF\"},{\"text\":\" times.\"}]",
    "",
    "[\"\",{\"text\":\"Souls\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"13CC10E9C5C72D52\"}},{\"text\":\" come from soul sand and Lost Souls.\"}]"
  ],
  "quest.4DEE5DD3B7F31445.title": "Artisan Relic",
  "quest.4DEE5DD3B7F31445.quest_subtitle": "Borrowed from the village smith. Indefinitely.",
  "quest.4DEE5DD3B7F31445.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"One relic, two machines.\"}]",
    "",
    "[\"\",{\"text\":\"Armorer, toolsmith and weaponsmith chests in villages hold one \"},{\"text\":\"28%\",\"color\":\"#A99BFF\"},{\"text\":\" of the time, and Wandering Traders sometimes sell it for \"},{\"text\":\"18\",\"color\":\"#A99BFF\"},{\"text\":\" emeralds.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"In the Clibano's enhancer slot it unlocks alloys.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#A99BFF\"},{\"text\":\"In the forge it cuts experience costs by a quarter.\"}]"
  ],
  "quest.4A09E43F3C8A02F5.title": "Obsidiansteel",
  "quest.4A09E43F3C8A02F5.quest_subtitle": "Iron that learned patience.",
  "quest.4A09E43F3C8A02F5.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Iron plus obsidian, and the Clibano's patience.\"}]",
    "",
    "[\"\",{\"text\":\"With the Artisan Relic in the enhancer slot, raw iron in one input and obsidian in the other come out as an \"},{\"text\":\"Obsidiansteel Ingot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:obsidiansteel_ingot\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Draco Arcanus armor, Dark Nether Stars, Corrupti Dust and Obsidian Skulls all take it."
  ],
  "quest.1441F80228D80C07.title": "Obsidian Skull",
  "quest.1441F80228D80C07.quest_subtitle": "Fireproof, with an expiry date.",
  "quest.1441F80228D80C07.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight Obsidiansteel Ingots around a skeleton skull.\"}]",
    "",
    "[\"\",{\"text\":\"Worn on your head it grants Fire Resistance, but every \"},{\"text\":\"8\",\"color\":\"#A99BFF\"},{\"text\":\" to \"},{\"text\":\"13\",\"color\":\"#A99BFF\"},{\"text\":\" seconds you spend burning it cracks a stage: cracked, fragmented, fading, then a plain skeleton skull.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Two Obsidiansteel Ingots mend it one stage.\"}]"
  ],
  "quest.4BD7EDB51D0BCF7A.title": "Wish upon a star",
  "quest.4BD7EDB51D0BCF7A.quest_subtitle": "Forbidden, but harmless.",
  "quest.4BD7EDB51D0BCF7A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Even a forge room has a window.\"}]",
    "",
    "Make a wish. The sky is listening."
  ],
  "quest.65128FCA13C916D6.title": "Open the Forbiddenomicon",
  "quest.65128FCA13C916D6.quest_subtitle": "Page one is a warning.",
  "quest.65128FCA13C916D6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"It has been open on this desk longer than the forge has stood.\"}]",
    "",
    "Nothing to read. It reads you."
  ],
  "image.78BBC99153C6328E.title": "[\"\",{\"text\":\"ignis\",\"color\":\"#C9BEFF\",\"font\":\"minecraft:alt\"}]",
  "image.1008F45B6434944C.title": "[\"\",{\"text\":\"umbra\",\"color\":\"#C9BEFF\",\"font\":\"minecraft:alt\"}]",
  "image.6AD56CA1CC745FF5.title": "[\"\",{\"text\":\"tenebrae\",\"color\":\"#C9BEFF\",\"font\":\"minecraft:alt\"}]",
  "image.7CDC0DD8304F18B9.title": "Back to the Sun of Heliodor",
  "image.589DD03BDF284958.title": "[\"\",{\"text\":\"FORBIDDEN AND ARCANUS\",\"color\":\"#F3EEDF\",\"bold\":true}]",
  "image.1B21913D5E560F7C.title": "[\"\",{\"text\":\"forge pedestal ritual\",\"color\":\"#C9BEFF\",\"font\":\"minecraft:alt\"}]",
  "image.2DCADEE0CD45801E.title": "[\"\",{\"text\":\"The forge floor\",\"color\":\"#F3EEDF\"}]",
  "image.257622C95A366EE8.title": "[\"\",{\"text\":\"Field notes\",\"color\":\"#F3EEDF\"}]",
  "image.72504EC7D84810FD.title": "[\"\",{\"text\":\"Four essences\",\"color\":\"#F3EEDF\"}]",
  "image.6120BCB4DBCFFC04.title": "[\"\",{\"text\":\"Edelwood and scrap\",\"color\":\"#F3EEDF\"}]",
  "image.2C1A365F3BB4DAE4.title": "[\"\",{\"text\":\"Prisms and modifiers\",\"color\":\"#F3EEDF\"}]",
  "image.111BEFD0AEBB55E6.title": "[\"\",{\"text\":\"Toward eternity\",\"color\":\"#F3EEDF\"}]",
  "image.6FDE60EB29ADE4A4.title": "[\"\",{\"text\":\"Relics\",\"color\":\"#F3EEDF\"}]",
  "image.1E122A7CEF657836.title": "[\"\",{\"text\":\"Dragon scales\",\"color\":\"#F3EEDF\"}]",
  "image.5F87194EEFA90AB4.title": "[\"\",{\"text\":\"The Clibano\",\"color\":\"#F3EEDF\"}]",
  "chapter.3AEF48FF2F23450A.title": "Mahou Tsukai",
  "chapter.3AEF48FF2F23450A.chapter_subtitle": [
    "Draw circles in your own blood, grind gems into powder and project blades until a whole world of swords answers to you."
  ],
  "task.5C42396CE5B287ED.title": "Draw a blood circle",
  "quest.0859CF3B84289FA9.title": "First blood",
  "quest.0859CF3B84289FA9.quest_subtitle": "Bring bandages.",
  "quest.0859CF3B84289FA9.quest_desc": [
    "[\"\",{\"text\":\"Any damage makes you bleed for five seconds. Press \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.drawMahoujin\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" while it lasts and a \"},{\"translate\":\"block.mahoutsukai.mahoujin\",\"color\":\"#8FD6C8\"},{\"text\":\" appears on the block in front of your feet, with the Mahou mana bar on screen. The \"},{\"text\":\"Dagger\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:dagger\",\"count\":1}}},{\"text\":\" costs one heart and leaves you bleeding for fifteen seconds.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The circle needs a solid top face. Purple dye, iron, gold and a stick make the Dagger, and a circle drawn on a \"},{\"text\":\"Spell Cloth\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6592F31DF7E45E78\"}},{\"text\":\" becomes a scroll.\"}]"
  ],
  "quest.595636BCD5A9064E.title": "Knowledge Compendium",
  "quest.595636BCD5A9064E.quest_desc": [
    "Five red dye, three paper and a leather. Each spell gets a page with its three powders, its mana cost and one of three headings: Cloth Required, Cloth Optional or No Cloth. EMI lists the same circles and scrolls under Mahoujin and Mahou Scrolls."
  ],
  "task.799065C93925A12A.title": "Any three powders",
  "quest.44720A1D5EEEF884.title": "Powdered catalysts",
  "quest.44720A1D5EEEF884.quest_subtitle": "Your savings, ground to dust.",
  "quest.44720A1D5EEEF884.quest_desc": [
    "[\"\",{\"text\":\"String, two cobblestone and two sticks make the \"},{\"text\":\"Hammer\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:hammer\",\"count\":1}}},{\"text\":\", which never wears out. It crushes an iron or gold ingot, a diamond, an emerald, quartz, an ender pearl or an eye of ender into one powder. Three powders on a blood circle make one spell.\"}]"
  ],
  "quest.6592F31DF7E45E78.title": "Circle or scroll",
  "quest.6592F31DF7E45E78.quest_subtitle": "Carpet magic.",
  "quest.6592F31DF7E45E78.quest_desc": [
    "[\"\",{\"text\":\"White wool and the Dagger make four \"},{\"text\":\"Spell Cloth\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:spell_cloth\",\"count\":1}}},{\"text\":\", and the Dagger stays. Lay a cloth, draw the circle on it, right-click the three powders in, then right-click the finished circle: out pops the scroll. With no cloth the spell stays on the floor as a circle.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A scroll only answers to whoever drew it. Circles drawn with \"},{\"text\":\"Fae Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:fae_essence\",\"count\":1}}},{\"text\":\" make scrolls and circles anyone can use, which is how you automate them.\"}]"
  ],
  "quest.1A487DE58D0BAD17.title": "Strengthening",
  "quest.1A487DE58D0BAD17.quest_subtitle": "Reinforcement, the first craft.",
  "quest.1A487DE58D0BAD17.quest_desc": [
    "Diamond, diamond and iron powder on a cloth. For 50 mana it strengthens your off-hand item, or else the first hotbar item that isn't a scroll: five more uses, up to 50, of +4 damage, faster digging and no wear. A strengthened bow, stick, sword, shield or book can turn into something else."
  ],
  "task.76B822CF672BF2E3.title": "An attuned gem",
  "quest.555113334FA34893.title": "Attuned gems",
  "quest.555113334FA34893.quest_subtitle": "A savings account for mana.",
  "quest.555113334FA34893.quest_desc": [
    "[\"\",{\"text\":\"Four gold and four lapis make the \"},{\"text\":\"Attuner\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:attuner\",\"count\":1}}},{\"text\":\"; craft it with a diamond or an emerald. Right-click with the gem in hand to pour your mana into it: a diamond holds 10,000, an emerald 5,000, and spells drink from any gem you carry.\"}]"
  ],
  "quest.52951C5E08145F8D.title": "The Mystic Code",
  "quest.52951C5E08145F8D.quest_subtitle": "A wizard's holster.",
  "quest.52951C5E08145F8D.quest_desc": [
    "[\"\",{\"text\":\"Six Spell Cloths around three gold powders. It holds three stacks of scrolls: \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and right-click opens it, \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.changeMysticCode\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" picks the stack and right-click casts. No more digging through the inventory mid-fight.\"}]"
  ],
  "quest.104129DD518BD355.title": "Projection",
  "quest.104129DD518BD355.quest_subtitle": "Stare at a sword long enough and it's yours.",
  "quest.104129DD518BD355.quest_desc": [
    "Diamond, diamond and quartz powder on a cloth, 1,000 mana each use: cast it from a gem. The first use memorizes the tool or weapon you're looking at, for the whole stack; the next ones hand you copies with its enchantments and only five uses of durability left.",
    "{@pagebreak}",
    "It won't copy anything unbreakable, and a copy never keeps Strengthening."
  ],
  "quest.604B7DDA927F56CC.title": "Blades for arrows",
  "quest.604B7DDA927F56CC.quest_subtitle": "Alteration: a sword is an arrow with ambition.",
  "quest.604B7DDA927F56CC.quest_desc": [
    "[\"\",{\"text\":\"Diamond, diamond and gold powder, 100 mana: the scroll hands you a \"},{\"text\":\"Bow of Weapon Projectiles\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:weapon_projectile_bow\",\"count\":1}}},{\"text\":\" that shoots your tools and weapons instead of arrows. \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and right-click switches it to projected copies and Projection scrolls only. The bow itself has 30 durability.\"}]"
  ],
  "task.36A58F5913DEA4F4.title": "Either Mana Circuit",
  "quest.6713F22CD30C7F75.title": "Mana Circuits",
  "quest.6713F22CD30C7F75.quest_subtitle": "A bank that pays no interest.",
  "quest.6713F22CD30C7F75.quest_desc": [
    "[\"\",{\"text\":\"Eight \"},{\"text\":\"Fae Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:fae_essence\",\"count\":1}}},{\"text\":\" around an emerald powder, or six iron ingots around three emerald powders for the Magitech one; both hold 100,000 mana. The first player to right-click it owns it. Right-click pours your mana in, and your spells draw from your circuits within 10 blocks.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and right-click turns it on or off. Broken, it keeps its mana and its owner: a battery you can carry. Right-click it with Fae Essence and your team can drink from it too.\"}]"
  ],
  "task.3A4A7B08F26BE5F5.title": "Fire the gauntlet",
  "quest.60C225AB0B544AE1.title": "Treasury Projection",
  "quest.60C225AB0B544AE1.quest_subtitle": "A king's armory, charged per sword.",
  "quest.60C225AB0B544AE1.quest_desc": [
    "[\"\",{\"text\":\"Diamond, diamond and eye powder. The scroll costs 1,000 mana and leaves a gauntlet that flings weapons and tools from your inventory, some bags and your ender chest at the block you look at, 120 mana each. \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and right-click cycles targeted, area and chain modes.\"}]"
  ],
  "task.5F8B57CAF527B842.title": "Look at a Power Consolidation circle",
  "quest.6A51E319D528C64D.title": "The lake",
  "quest.6A51E319D528C64D.quest_subtitle": "Every lady needs a lake.",
  "quest.6A51E319D528C64D.quest_desc": [
    "[\"\",{\"text\":\"Diamond, diamond and emerald powder straight on the floor, no cloth: \"},{\"translate\":\"block.mahoutsukai.mahoujin_power_consolidation\",\"color\":\"#8FD6C8\"},{\"text\":\" floods the ground around it with murky water, 30 mana per growth, out to a radius of 12. Keep your mana flowing until the lake is full; a small one refuses swords.\"}]"
  ],
  "quest.609BD579C2FEF1AF.title": "A sword from the lake",
  "quest.609BD579C2FEF1AF.quest_subtitle": "The lady of the lake takes swords, not requests.",
  "quest.609BD579C2FEF1AF.quest_desc": [
    "[\"\",{\"text\":\"Throw an enchanted sword into the full lake and pay 5,000 mana: it comes back as \"},{\"text\":\"Caliburn\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:caliburn\",\"count\":1}}},{\"text\":\", with the sword's damage plus a bonus for its enchantments, holier ones counting more. Undead flee it, right-click drags them closer and \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.changeMysticCode\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" smites them.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Throw Caliburn back in with a \"},{\"text\":\"Nether Star\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:nether_star\",\"count\":1}}},{\"text\":\" and its damage ceiling climbs a tier. Mending adds nothing, and the lake refuses Clarent and Morgan.\"}]",
    "",
    "[\"\",{\"text\":\"The book's Rhongomyniad needs the Jousting mod, which this pack doesn't include.\",\"color\":\"#FF8C7A\"}]"
  ],
  "task.79D924461EA0C16C.title": "Enter the Reality Marble",
  "quest.5DE51A3BBD3C868B.title": "Unlimited Blade Works",
  "quest.5DE51A3BBD3C868B.quest_subtitle": "Your circle, your world, your swords.",
  "quest.5DE51A3BBD3C868B.quest_desc": [
    "[\"\",{\"text\":\"Three diamond powders on a cloth make the \"},{\"text\":\"Scroll of the Reality Marble\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:scroll_reality_marble\",\"count\":1}}},{\"text\":\". For 4,000 mana it pulls you, and whoever you're looking at, into a field of red sand bristling with swords. Alone, any hit sends you home; with company, one of you has to fall first.\"}]"
  ],
  "quest.5CDFF2165D9D638C.title": "Mana is a muscle",
  "quest.5CDFF2165D9D638C.quest_subtitle": "The only gym where naps count as training.",
  "quest.5CDFF2165D9D638C.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Your bar starts at 100 and gains 1 for every 100 mana you spend. It refills faster on a full stomach, sleeping returns half of it and leylines speed it up. Big spells run on gems and circuits, not on training.\"}]"
  ],
  "quest.0FA522C681794545.title": "Seven powders, seven schools",
  "quest.0FA522C681794545.quest_desc": [
    "The powder a recipe uses twice names its school: iron Boundaries, ender pearl Displacement, diamond Projection, emerald Exchange, gold Mystic, quartz Intelligence, eye of ender Mystic Eyes. Three different powders mean one of the rumored spells."
  ],
  "quest.68924C9E1161B371.title": "Mahou keys",
  "quest.68924C9E1161B371.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.changeMysticCode\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" does more than switch scrolls: it fires Caliburn's smite, Morgan's rage and Replica's teleport. \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.settingsGUI\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" opens the settings where you recolor your staffs, chains, swords and guns.\"}]"
  ],
  "quest.6928E8224B0D9D90.title": "First Sorcery",
  "quest.6928E8224B0D9D90.quest_subtitle": "Reusable magic, disposable glove.",
  "quest.6928E8224B0D9D90.quest_desc": [
    "[\"\",{\"text\":\"Six Spell Cloths, two \"},{\"text\":\"Fae Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:fae_essence\",\"count\":1}}},{\"text\":\" and a diamond powder. It works like the Mystic Code but casts without using up the scroll, until its 50 uses run out. The one scroll it refuses is the Boundary of Drain Life.\"}]"
  ],
  "quest.5B4489C3234BD736.title": "Secret Calibur",
  "quest.5B4489C3234BD736.quest_subtitle": "Light in one hand, shadow in the other.",
  "quest.5B4489C3234BD736.quest_desc": [
    "[\"\",{\"text\":\"Caliburn in one hand, \"},{\"text\":\"Morgan\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:morgan\",\"count\":1}}},{\"text\":\" in the other. Morgan is what Caliburn becomes when it kills its owner's own tamed wolf, so this took two trips to the lake.\"}]"
  ],
  "reward.75B9EEC48C0CB6EC.title": "Secret found",
  "quest.4C1CB94C2C87E21C.title": "The mortar pays for itself",
  "quest.4C1CB94C2C87E21C.quest_subtitle": "The best investment advice you'll get in this pack.",
  "quest.4C1CB94C2C87E21C.quest_desc": [
    "[\"\",{\"text\":\"Two bricks and a diamond make the \"},{\"text\":\"Mortar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:mortar\",\"count\":1}}},{\"text\":\"; three diamonds and two sticks, the \"},{\"text\":\"Pestle\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:pestle\",\"count\":1}}},{\"text\":\". Put together, they grind two powders per gem or ingot instead of one and, like the Hammer, never wear out.\"}]"
  ],
  "quest.6DB00D19AF1B0068.title": "Circles on display",
  "quest.6DB00D19AF1B0068.quest_subtitle": "Pure decoration. Pure showing off.",
  "quest.6DB00D19AF1B0068.quest_desc": [
    "[\"\",{\"text\":\"Six gold powders, two redstone and a Spell Cloth make the \"},{\"text\":\"Mahoujin Projector\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:mahoujin_projector\",\"count\":1}}},{\"text\":\"; with eye powder instead of gold you get the \"},{\"text\":\"Fog Projector\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:fog_projector\",\"count\":1}}},{\"text\":\". Right-click either to set size, angle, color and speed, or the fog's color and thickness.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Right-click the projector with a piece of armor and the armor wears that circle. A plain stick copies a projector's settings with right-click and pastes them with \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and right-click.\"}]"
  ],
  "quest.36F1FC187829D413.title": "Words have power",
  "quest.36F1FC187829D413.quest_subtitle": "Finally, a use for your poetry.",
  "quest.36F1FC187829D413.quest_desc": [
    "[\"\",{\"text\":\"Write a book, sign it, strengthen it and set it on a lectern: it becomes \"},{\"text\":\"William\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:william\",\"count\":1}}},{\"text\":\", scored on style (words, spacing, punctuation, variety) and fame (villager trades, readers). Positive style feeds nearby circuits; negative style turns it into R'lyeh, which drains everyone around.\"}]",
    "{@pagebreak}",
    "Making it costs 500 mana per point of style, and a finished work never changes its style: write a better one."
  ],
  "task.73114E6EF4571DEA.title": "Look at a Durability Exchange circle",
  "task.7CCF9BD38113F078.title": "Look at an Alchemical Exchange circle",
  "quest.7AE674682B2010B9.title": "Floor exchanges",
  "quest.7AE674682B2010B9.quest_subtitle": "Your junk drawer, liquidated.",
  "quest.7AE674682B2010B9.quest_desc": [
    "[\"\",{\"text\":\"Emerald-school circles that live on the floor, no cloth. Emerald, emerald and diamond make \"},{\"translate\":\"block.mahoutsukai.mahoujin_durability_exchange\",\"color\":\"#8FD6C8\"},{\"text\":\": it eats the durability of tools lying on it or stored in a chest below, and pays you up to 10 mana a second.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Emerald, emerald and gold make \"},{\"translate\":\"block.mahoutsukai.mahoujin_alchemical_exchange\",\"color\":\"#8FD6C8\"},{\"text\":\": once a day it rerolls the natural blocks beneath into others of their class, like dirt into sand or diamond ore into emerald ore, 16 mana a block.\"}]",
    "",
    "[\"\",{\"text\":\"Three emeralds make \"},{\"translate\":\"block.mahoutsukai.mahoujin_catalyst_exchange\",\"color\":\"#8FD6C8\"},{\"text\":\", which rerolls powders dropped on it for 50 mana each. Emerald, emerald and quartz make \"},{\"translate\":\"block.mahoutsukai.mahoujin_chronal_exchange\",\"color\":\"#8FD6C8\"},{\"text\":\": 12 hours of mana around the time you placed it, 12 hours of drain.\"}]"
  ],
  "quest.317BE0EED5BAC9B5.title": "Pain into mana",
  "quest.317BE0EED5BAC9B5.quest_subtitle": "Getting hit, now with a refund.",
  "quest.317BE0EED5BAC9B5.quest_desc": [
    "[\"\",{\"text\":\"Emerald, emerald and iron: \"},{\"translate\":\"block.mahoutsukai.mahoujin_damage_exchange\",\"color\":\"#8FD6C8\"},{\"text\":\" costs 40 mana for five charges, the most you can hold. Each hit you take while a charge lasts deals 1 damage and pays you 20 mana.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Emerald, emerald and eye: \"},{\"translate\":\"block.mahoutsukai.mahoujin_immunity_exchange\",\"color\":\"#8FD6C8\"},{\"text\":\" costs 400 mana. For a minute, you or whatever you look at shrugs off a repeated source of damage and takes double from any new one.\"}]"
  ],
  "task.723F031207698129.title": "Look at an Alarm Boundary",
  "quest.2980EF2C6FEB6D5B.title": "Boundaries",
  "quest.2980EF2C6FEB6D5B.quest_subtitle": "Fences, but magic.",
  "quest.2980EF2C6FEB6D5B.quest_desc": [
    "[\"\",{\"text\":\"Iron, iron and quartz: \"},{\"translate\":\"block.mahoutsukai.mahoujin_alarm_barrier\",\"color\":\"#8FD6C8\"},{\"text\":\" warns you whenever a mob or player enters 10 blocks around it, for 1 mana every 10 seconds. Every boundary works drawn on the floor or as a scroll that plants it where you use it. Right-click toggles it; redstone inverts it.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A comparator reads any boundary: 0 off, 1 on, and the Alarm gives 15 while something is inside. Two players standing on their own \"},{\"translate\":\"block.mahoutsukai.mahoujin_contract\",\"color\":\"#8FD6C8\"},{\"text\":\" circles (emerald, emerald, ender) seal a Contract and walk through each other's boundaries.\"}]"
  ],
  "task.1B2ED71EEF3EB894.title": "Look at a Tangible Boundary",
  "task.769D0F2F430AFC0B.title": "Look at an Enclosure Boundary",
  "quest.59B4C70A09D84561.title": "Walls of mana",
  "quest.59B4C70A09D84561.quest_subtitle": "Instant castle, no building permit.",
  "quest.59B4C70A09D84561.quest_desc": [
    "[\"\",{\"text\":\"Iron, iron and diamond: \"},{\"translate\":\"block.mahoutsukai.mahoujin_tangible_barrier\",\"color\":\"#8FD6C8\"},{\"text\":\" puts up an invisible wall 10 blocks out that you walk through and mobs and arrows don't, for 1 mana every 3 seconds. Three irons: \"},{\"translate\":\"block.mahoutsukai.mahoujin_raise_enclosure\",\"color\":\"#8FD6C8\"},{\"text\":\" lifts the ground in a ring of radius 5 around you into walls, 20 mana per layer.\"}]"
  ],
  "task.1B565172D2E5E53A.title": "Look at a Gravity Boundary",
  "task.607EA698FEC80E19.title": "Look at a Boundary of Drain Life",
  "task.1833E80987D25041.title": "Look at a Displacement Boundary",
  "quest.32EAD309DF43EB17.title": "Fields that bite",
  "quest.32EAD309DF43EB17.quest_desc": [
    "[\"\",{\"text\":\"Iron, iron and gold: \"},{\"translate\":\"block.mahoutsukai.mahoujin_gravity_barrier\",\"color\":\"#8FD6C8\"},{\"text\":\" drags every mob but you down 1.4 times harder within 10 blocks. Iron, iron and ender: \"},{\"translate\":\"block.mahoutsukai.mahoujin_displacement_barrier\",\"color\":\"#8FD6C8\"},{\"text\":\" teleports whatever tries to walk into its 11 blocks out the other side.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Iron, iron and emerald: \"},{\"translate\":\"block.mahoutsukai.mahoujin_drain_life_barrier\",\"color\":\"#8FD6C8\"},{\"text\":\" takes 2 health a second from mobs around it and gives you health, then hunger, then mana, for 5 mana a second.\"}]",
    "",
    "[\"\",{\"text\":\"You can keep only ten Drain Life boundaries running at once.\",\"color\":\"#FF8C7A\"}]"
  ],
  "quest.17D803A7819F2A32.title": "A bow at 200 blocks",
  "quest.17D803A7819F2A32.quest_subtitle": "Snipers are just patient archers.",
  "quest.17D803A7819F2A32.quest_desc": [
    "[\"\",{\"text\":\"Strengthen a plain vanilla bow and hit an enemy 200 blocks away: it becomes \"},{\"text\":\"Nobu\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:nobu\",\"count\":1}}},{\"text\":\". Auto-Lock marks targets while you aim; the Firing Squad modes summon guns, 40 mana each, that fire for 20 mana a shot. \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.gunUp\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.gunDown\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" raise and lower the autonomous squads.\"}]"
  ],
  "task.229A98061EF57842.title": "Earn Replica",
  "quest.549FD66D092BC53E.title": "Maxed-out defense",
  "quest.549FD66D092BC53E.quest_subtitle": "Tanking as a lifestyle.",
  "quest.549FD66D092BC53E.quest_desc": [
    "[\"\",{\"text\":\"Block a hit with a strengthened shield in your main hand while \"},{\"text\":\"Immunity Exchange\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"317BE0EED5BAC9B5\"}},{\"text\":\" is on, Damage Exchange holds five charges, your armor is above 15 and Death Collection has 100 souls. The shield becomes \"},{\"text\":\"Replica\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:replica\",\"count\":1}}},{\"text\":\", a greatshield that shoves foes and teleports your party.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and right-click saves a spot; block and press \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.changeMysticCode\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" to take everyone around you there. Allies are the players you share a Geas or a Contract with.\"}]"
  ],
  "quest.5DB5AD9C07086DE5.title": "Eyes that fight",
  "quest.5DB5AD9C07086DE5.quest_desc": [
    "[\"\",{\"text\":\"Two eye powders and a third. With gold, \"},{\"translate\":\"block.mahoutsukai.mahoujin_mystic_eyes\",\"color\":\"#8FD6C8\"},{\"text\":\" (320 mana) freeze whatever meets your gaze within 5 blocks; players break free by looking away. With emerald, \"},{\"translate\":\"block.mahoutsukai.mahoujin_reversion_eyes\",\"color\":\"#8FD6C8\"},{\"text\":\" (410) strip buffs and immunities: endermen and the Wither stop shrugging off arrows.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"With diamond, \"},{\"translate\":\"block.mahoutsukai.mahoujin_black_flame\",\"color\":\"#8FD6C8\"},{\"text\":\" (300) light black fire wherever you look within 30 blocks. It spreads, burns no blocks and withers whatever touches it.\"}]"
  ],
  "quest.5185D8936EEA43E0.title": "Eyes that know",
  "quest.5185D8936EEA43E0.quest_desc": [
    "[\"\",{\"text\":\"With ender, \"},{\"translate\":\"block.mahoutsukai.mahoujin_insight\",\"color\":\"#8FD6C8\"},{\"text\":\" (320 mana, a minute) show what a creature carries and every effect on it. With quartz, \"},{\"translate\":\"block.mahoutsukai.mahoujin_prediction\",\"color\":\"#8FD6C8\"},{\"text\":\" (220) draw where mobs within 30 blocks are about to walk; skeletons are too random to read.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"With iron, \"},{\"translate\":\"block.mahoutsukai.mahoujin_death_collection\",\"color\":\"#8FD6C8\"},{\"text\":\" (400) gather souls from deaths you watch within 10 blocks, a quarter per mob and one per player. Twelve souls spare you from dying once, but every soul you hold costs mana regeneration.\"}]"
  ],
  "quest.78442B1901FCF823.title": "Rumored spells",
  "quest.78442B1901FCF823.quest_subtitle": "Three schools, one circle.",
  "quest.78442B1901FCF823.quest_desc": [
    "[\"\",{\"text\":\"Three different powders. Gold, emerald and iron: \"},{\"translate\":\"block.mahoutsukai.mahoujin_geas\",\"color\":\"#8FD6C8\"},{\"text\":\", a taboo you set on yourself. Gold, emerald and diamond: \"},{\"translate\":\"block.mahoutsukai.mahoujin_gandr\",\"color\":\"#8FD6C8\"},{\"text\":\", a curse that grows with your max mana. Emerald, iron and diamond: \"},{\"translate\":\"block.mahoutsukai.mahoujin_retribution\",\"color\":\"#8FD6C8\"},{\"text\":\" swaps health with a target.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Gold, ender and iron: \"},{\"translate\":\"block.mahoutsukai.mahoujin_fallen_down\",\"color\":\"#8FD6C8\"},{\"text\":\" digs graves at 2,000 mana every fifth of a second. Eye, ender and emerald: \"},{\"translate\":\"block.mahoutsukai.mahoujin_selective_displacement\",\"color\":\"#8FD6C8\"},{\"text\":\" (900 mana) lets \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.selectiveDisplacement\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" swap you with whatever you look at, or two things with each other, for a minute.\"}]",
    "",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Each geas against an unnamed kind of mob adds 3 to your mana regeneration. Swear never to hurt a sheep and cash in.\"}]"
  ],
  "quest.1E5E7CE04AFACCF1.title": "Rule Breaker and the Ripper",
  "quest.1E5E7CE04AFACCF1.quest_desc": [
    "[\"\",{\"text\":\"Gold, diamond and quartz: set two or more \"},{\"translate\":\"block.mahoutsukai.mahoujin_probability_alter\",\"color\":\"#8FD6C8\"},{\"text\":\" circles with a chorus fruit on each, then read the scroll among them for 5,000 mana. The circles counted set the modulus of \"},{\"text\":\"Rule Breaker\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:rule_breaker\",\"count\":1}}},{\"text\":\", a dagger that rigs your own dice.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Ender, iron and diamond: \"},{\"translate\":\"block.mahoutsukai.mahoujin_presence_concealment\",\"color\":\"#8FD6C8\"},{\"text\":\" (800 mana) hands you \"},{\"text\":\"The Ripper\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:theripper\",\"count\":1}}},{\"text\":\" for each hand. One makes fog; both make you invisible, and a stab from behind deals 6 more damage.\"}]"
  ],
  "quest.5D91A04C864CA08B.title": "Blink",
  "quest.5D91A04C864CA08B.quest_subtitle": "Your arrow, your ride.",
  "quest.5D91A04C864CA08B.quest_desc": [
    "[\"\",{\"text\":\"Ender, ender and diamond: \"},{\"translate\":\"block.mahoutsukai.mahoujin_projectile_displacement\",\"color\":\"#8FD6C8\"},{\"text\":\" (50 mana) teleports you to your last arrow. Ender, ender and iron: \"},{\"translate\":\"block.mahoutsukai.mahoujin_protective_displacement\",\"color\":\"#8FD6C8\"},{\"text\":\" (50) blinks you aside from incoming arrows a set number of times.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Ender, ender and gold: \"},{\"translate\":\"block.mahoutsukai.mahoujin_ascension\",\"color\":\"#8FD6C8\"},{\"text\":\" (30 mana) lifts you to the surface. Drawn on the floor instead, it lifts whatever steps on it, items and mobs included.\"}]"
  ],
  "task.0843E8D316E730A5.title": "Look at an Equivalent Displacement circle",
  "quest.746849AEC954EF3C.title": "Linked circles",
  "quest.746849AEC954EF3C.quest_subtitle": "Mail that goes both ways.",
  "quest.746849AEC954EF3C.quest_desc": [
    "[\"\",{\"text\":\"Ender, ender and emerald on the floor make \"},{\"translate\":\"block.mahoutsukai.mahoujin_equivalent_displacement\",\"color\":\"#8FD6C8\"},{\"text\":\". \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and right-click links two of them anywhere, even across dimensions; when both have something on top, they trade it, 60 mana a trip.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Three enders make \"},{\"translate\":\"block.mahoutsukai.mahoujin_ordered_displacement\",\"color\":\"#8FD6C8\"},{\"text\":\", which hops things from circle to circle within 20 blocks, in the order you placed them. Ender, ender and quartz: \"},{\"translate\":\"block.mahoutsukai.mahoujin_mental_displacement\",\"color\":\"#8FD6C8\"},{\"text\":\" (300 mana) lets you leave your body and roam 20 blocks around it.\"}]"
  ],
  "task.35C140C5F18ABF8B.title": "Land a sympathetic spell",
  "quest.6CBDD65A4899ED9C.title": "Kodoku worms",
  "quest.6CBDD65A4899ED9C.quest_subtitle": "The food chain, bottled.",
  "quest.6CBDD65A4899ED9C.quest_desc": [
    "[\"\",{\"text\":\"Dirt, carrot, potato, poisonous potato, rotten flesh and nether wart make a hungry \"},{\"text\":\"Kodoku\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:kodoku\",\"count\":1}}},{\"text\":\". Every kill a monster makes raises its value by one plus its victim's. Right-click the worm onto a strong specimen, kill it and pick the worm back up. Burned near your circuits, it pays mana.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"For sympathetic magic, keep a \"},{\"translate\":\"block.mahoutsukai.mahoujin_scrying\",\"color\":\"#8FD6C8\"},{\"text\":\" circle (ender, ender, eye) watching someone through a name tag, with worms in a container below. Drop blaze powder, a rabbit's foot, rotten flesh, glowstone dust, splash potions or ender pearls on it and the target feels them. A strong worm in your pocket shields you.\"}]"
  ],
  "quest.6E69EB7DC94BE8E5.title": "Leylines and the Fae",
  "quest.6E69EB7DC94BE8E5.quest_subtitle": "The world has veins. Now you can see them.",
  "quest.6E69EB7DC94BE8E5.quest_desc": [
    "[\"\",{\"text\":\"Three eye powders make \"},{\"translate\":\"block.mahoutsukai.mahoujin_fay_sight\",\"color\":\"#8FD6C8\"},{\"text\":\" (100 mana, 30 seconds): you see the leylines, which meet at leypoints every 300 blocks, and the Fae. Cast magic on a leypoint and the Fae come; each drops one or two \"},{\"text\":\"Fae Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:fae_essence\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Leylines speed up your mana regeneration and push an elytra flying along them. The Fae breed with any powder, and a \"},{\"text\":\"Faecake\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:faecake\",\"count\":1}}},{\"text\":\" keeps them away from you.\"}]"
  ],
  "quest.42CD70A6B27D9F8B.title": "A familiar",
  "quest.42CD70A6B27D9F8B.quest_subtitle": "A chunk loader that talks back.",
  "quest.42CD70A6B27D9F8B.quest_desc": [
    "[\"\",{\"text\":\"Three quartz powders make \"},{\"translate\":\"block.mahoutsukai.mahoujin_summon_familiar\",\"color\":\"#8FD6C8\"},{\"text\":\" (200 mana): a small spirit that chats about the players, mobs and blocks it spots and keeps its area loaded. Right-click it with a block and it reports only that one. Quartz, quartz and ender make \"},{\"translate\":\"block.mahoutsukai.mahoujin_recall_familiar\",\"color\":\"#8FD6C8\"},{\"text\":\", 20 mana.\"}]"
  ],
  "task.6427B770F1598F62.title": "Use the Butterfly Effect",
  "quest.76E2869E7AECBD23.title": "Familiar tricks",
  "quest.76E2869E7AECBD23.quest_desc": [
    "[\"\",{\"text\":\"Quartz, quartz and gold: \"},{\"translate\":\"block.mahoutsukai.mahoujin_possess_entity\",\"color\":\"#8FD6C8\"},{\"text\":\" (200 mana) lets you look through a creature's eyes. Quartz, quartz and iron: \"},{\"translate\":\"block.mahoutsukai.mahoujin_familiars_garden\",\"color\":\"#8FD6C8\"},{\"text\":\" (200) turns 7 blocks around your familiar into a minute where nothing can hurt anything.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Quartz, quartz and emerald: \"},{\"translate\":\"block.mahoutsukai.mahoujin_swap_familiar\",\"color\":\"#8FD6C8\"},{\"text\":\" (40) swaps you with your familiar. Quartz, quartz and diamond: \"},{\"translate\":\"block.mahoutsukai.mahoujin_butterfly_effect\",\"color\":\"#8FD6C8\"},{\"text\":\" (100) grants Foresight for 20 seconds: blocks you break or place and swings you make wait as butterflies until something touches them.\"}]",
    "",
    "[\"\",{\"text\":\"Keep it far from anything you care about.\",\"color\":\"#FF8C7A\"}]"
  ],
  "quest.77DCEDB866A51B01.title": "Shield and shared pain",
  "quest.77DCEDB866A51B01.quest_subtitle": "The answer to a sky full of swords.",
  "quest.77DCEDB866A51B01.quest_desc": [
    "[\"\",{\"text\":\"Gold, gold and iron: \"},{\"translate\":\"block.mahoutsukai.mahoujin_rho_aias\",\"color\":\"#8FD6C8\"},{\"text\":\" (300 mana) raises a great shield for a minute where you face; mobs bounce off, projectiles vanish, and you bounce on it by sneaking. Gold, gold and emerald: \"},{\"translate\":\"block.mahoutsukai.mahoujin_damage_replication\",\"color\":\"#8FD6C8\"},{\"text\":\" (160) copies the damage and effects you take onto a target.\"}]"
  ],
  "quest.71EE6AD73C196DE4.title": "Staffs of the gold school",
  "quest.71EE6AD73C196DE4.quest_subtitle": "Some problems need a crater.",
  "quest.71EE6AD73C196DE4.quest_desc": [
    "[\"\",{\"text\":\"Gold, gold and diamond summon the \"},{\"text\":\"Mystic Staff of Explosive Mana Condensation\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:mystic_staff\",\"count\":1}}},{\"text\":\" for 100 mana: a charged blast for 5,000, a volley for 600, a beam at 500 a tick. Gold, gold and ender summon the \"},{\"text\":\"Mystic Staff of Spatial Disorientation\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:spatial_disorientation_staff\",\"count\":1}}},{\"text\":\", which flings what it touches.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Three golds: \"},{\"translate\":\"block.mahoutsukai.mahoujin_borrowed_authority\",\"color\":\"#8FD6C8\"},{\"text\":\" (900 mana, 20 seconds) makes you fast and sends punched mobs through walls, at 1.5 health per punch.\"}]",
    "",
    "[\"\",{\"text\":\"The blast and the beam break terrain.\",\"color\":\"#FF8C7A\"}]"
  ],
  "quest.279A597CE772F0D6.title": "One big explosion",
  "quest.279A597CE772F0D6.quest_desc": [
    "Five thousand mana, one charge, one crater. The blast scales with your maximum mana and brings rain and thunder along."
  ],
  "reward.1BC8408D91201BB1.title": "Secret found",
  "quest.6C514E09F9322227.title": "When pigs fly",
  "quest.6C514E09F9322227.quest_desc": [
    "Ride a pig, point the Staff of Spatial Disorientation at it and the saying stops being a saying."
  ],
  "reward.7827A579DCCD998F.title": "Secret found",
  "task.56856064E33FE3DF.title": "Activate a Lesser Grail",
  "quest.5984826FEBF1E5BB.title": "The Grail",
  "quest.5984826FEBF1E5BB.quest_subtitle": "Math, but cursed.",
  "quest.5984826FEBF1E5BB.quest_desc": [
    "[\"\",{\"text\":\"Gold, gold and quartz. Set several \"},{\"translate\":\"block.mahoutsukai.mahoujin_cup_of_heaven\",\"color\":\"#8FD6C8\"},{\"text\":\" circles on the floor, no more than 30 blocks apart, and use the scroll within 20. The circles on the outer polygon and those inside are counted and split into primes: 2 poison, 3 weakness, 5 blindness, 7 slowness, 11 wither, 13 levitation.\"}]",
    "{@pagebreak}",
    "Everything inside gets those curses for a minute. A pentagon with four circles inside gives Poison II and Blindness, because 4 is 2 times 2. The cost grows with the area and with the curses."
  ],
  "quest.023DB014BF37BBCA.title": "Greater Grail",
  "quest.023DB014BF37BBCA.quest_desc": [
    "All six curses from one cup: between them, the network's circle counts had to hold 2, 3, 5, 7, 11 and 13. Nobody who stood inside will forget it."
  ],
  "reward.551C61A2E6A4A6B5.title": "Secret found",
  "quest.379AE76B127119E7.title": "Clarent and Emrys",
  "quest.379AE76B127119E7.quest_subtitle": "What Camelot left behind.",
  "quest.379AE76B127119E7.quest_desc": [
    "[\"\",{\"text\":\"Right-click with a strengthened sword while standing in the Ender Dragon's own breath to forge \"},{\"text\":\"Clarent\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:clarent\",\"count\":1}}},{\"text\":\": it hits as hard as its foe's weapon and stores the blows it blocks. Get struck by lightning holding a strengthened stick for \"},{\"text\":\"Emrys\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mahoutsukai:staff_emrys\",\"count\":1}}},{\"text\":\", an off-hand staff that electrifies your attacks.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"A lingering potion's cloud doesn't count\",\"color\":\"#FF8C7A\"},{\"text\":\": the breath has to come from the dragon itself.\"}]"
  ],
  "task.6A490E77D49F235E.title": "Thirty-two powders, any school",
  "quest.5B6292F998FA6527.title": "Powder for the depot",
  "quest.5B6292F998FA6527.quest_subtitle": "Tithes are paid in dust.",
  "quest.5B6292F998FA6527.quest_desc": [
    "Thirty-two powdered catalysts, any mix, for the shared depot. With the Mortar, every gem and ingot counts twice."
  ],
  "image.7E00E86FF3FDD163.title": "[\"\",{\"text\":\"Workshop\",\"color\":\"#F07266\"}]",
  "image.5A49F03F98DECF5A.title": "[\"\",{\"text\":\"Exchange\",\"color\":\"#F07266\"}]",
  "image.4472952DA374E022.title": "[\"\",{\"text\":\"Boundaries\",\"color\":\"#F07266\"}]",
  "image.24F74F3674C4BCF1.title": "[\"\",{\"text\":\"Strengthened feats\",\"color\":\"#F07266\"}]",
  "image.7BDA61505EE7C452.title": "[\"\",{\"text\":\"Mystic Eyes\",\"color\":\"#F07266\"}]",
  "image.3F15CE4AF4FFAF08.title": "[\"\",{\"text\":\"Rumored spells\",\"color\":\"#F07266\"}]",
  "image.1853F38AF1184E74.title": "[\"\",{\"text\":\"Displacement\",\"color\":\"#F07266\"}]",
  "image.574D21C33B634EED.title": "[\"\",{\"text\":\"Fae and familiars\",\"color\":\"#F07266\"}]",
  "image.56D2D2748EF31818.title": "[\"\",{\"text\":\"Mystic\",\"color\":\"#F07266\"}]",
  "image.549F1E2AB6E605FD.title": "[\"\",{\"text\":\"Camelot\",\"color\":\"#F07266\"}]",
  "image.123FA9E3AE1EFC1D.title": "[\"\",{\"text\":\"Mahou Tsukai\",\"color\":\"#FFE6DE\",\"bold\":true}]",
  "image.690C6ACA315E1C93.title": "[\"\",{\"text\":\"three powders one circle\",\"color\":\"#E9A39A\",\"font\":\"minecraft:alt\"}]",
  "image.2D2E0090225D2E44.title": "Back to the Sun of Heliodor",
  "chapter.1E6CA53296A6FFE4.title": "Malum",
  "chapter.1E6CA53296A6FFE4.chapter_subtitle": [
    "Scythes, spirit altars and totems: from a crude scythe to the Weeping Well."
  ],
  "quest.581C01A7948EB423.title": "Soulstone",
  "quest.581C01A7948EB423.quest_subtitle": "Boring rock, interesting afterlife.",
  "quest.581C01A7948EB423.quest_desc": [
    "[\"\",{\"text\":\"Its ore turns up all over the Overworld, from the bottom of the deepslate up to height 100. Each \"},{\"text\":\"Raw Soulstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:raw_soulstone\",\"count\":1}}},{\"text\":\" smelts into two \"},{\"text\":\"Refined Soulstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:refined_soulstone\",\"count\":1}}},{\"text\":\": the scythe, the altar, the Encyclopedia and every Soulstained Steel ingot start here.\"}]"
  ],
  "quest.0699DB3FC29CDC66.title": "The Crude Scythe",
  "quest.0699DB3FC29CDC66.quest_subtitle": "The harvest is not wheat.",
  "quest.0699DB3FC29CDC66.quest_desc": [
    "[\"\",{\"text\":\"Three iron ingots, a \"},{\"text\":\"Refined Soulstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:refined_soulstone\",\"count\":1}}},{\"text\":\" and two sticks. Whatever you kill with it shatters into spirit crystals that fly to you. It hits softer than a sword but sweeps wide, and its soulstone core is what reaches the soul.\"}]"
  ],
  "quest.639E0711137A795A.title": "The primary arcana",
  "quest.639E0711137A795A.quest_desc": [
    "[\"\",{\"text\":\"Every mob carries its own mix. \"},{\"text\":\"Sacred\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:sacred_spirit\",\"count\":1}}},{\"text\":\" comes from peaceful animals, \"},{\"text\":\"Wicked\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:wicked_spirit\",\"count\":1}}},{\"text\":\" from zombies, pillagers and other hostiles, \"},{\"text\":\"Arcane\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:arcane_spirit\",\"count\":1}}},{\"text\":\" from witches and skeletons. One witch alone drops two Wicked and two Arcane.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Iron's Spellbooks damage counts as soul damage here: a spell kill drops spirits the same as a scythe kill.\"}]"
  ],
  "quest.26F8A7D4DA540396.title": "Runewood",
  "quest.26F8A7D4DA540396.quest_subtitle": "Orange leaves, loud magic.",
  "quest.26F8A7D4DA540396.quest_desc": [
    "Look for orange-yellow leaves in plains, hills and mountains; they are rarer in forests. Snowy biomes grow an azure variant that drops the same logs. Sixteen logs is a fair first haul: the altar, its pedestals and the first totem all eat runewood."
  ],
  "quest.5B96C1F2F831C4BE.title": "The Spirit Altar",
  "quest.5B96C1F2F831C4BE.quest_subtitle": "Slow on purpose. The soul doesn't rush.",
  "quest.5B96C1F2F831C4BE.quest_desc": [
    "Runewood planks, two gold ingots and a Refined Soulstone. Put the item to infuse on the altar together with its spirits; extra ingredients go on Runewood pedestals or stands within four blocks, and the altar pulls them in one by one while the spirits flow."
  ],
  "quest.0F75CFDAF88DDB4D.title": "First infusion: Hex Ash",
  "quest.0F75CFDAF88DDB4D.quest_desc": [
    "[\"\",{\"text\":\"Gunpowder on the altar with one Arcane Spirit. \"},{\"text\":\"Hex Ash\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:hex_ash\",\"count\":1}}},{\"text\":\" turns up everywhere later: totem bases, the crucible, the impetus, the scythe upgrade. Make a stack while you learn the altar's pace.\"}]"
  ],
  "quest.6B389E759EB3AD28.title": "Hallowed Gold",
  "quest.6B389E759EB3AD28.quest_subtitle": "Gold, but with better manners.",
  "quest.6B389E759EB3AD28.quest_desc": [
    "[\"\",{\"text\":\"A gold ingot with two Sacred and one Arcane, plus four quartz on the pedestals. Nether quartz works, and so does \"},{\"text\":\"Natural Quartz\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:natural_quartz\",\"count\":1}}},{\"text\":\" from Malum's deep geodes. Arcana glide through the metal, which is why jars, obelisks and trinkets are built on it.\"}]"
  ],
  "quest.5168CEF9792AB068.title": "Soulstained Steel",
  "quest.5168CEF9792AB068.quest_subtitle": "Steel that hits the soul, not the armor.",
  "quest.5168CEF9792AB068.quest_desc": [
    "An iron ingot with three Wicked, one Earthen and one Arcane, and four Refined Soulstone on the pedestals. Whatever you forge from it strikes the soul directly, so every Soulstained tool and weapon reaps spirits.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"One zombie and one witch drop enough spirits for one ingot. The act IV \"},{\"text\":\"containment seal\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"429BA86EC20C7A84\"}},{\"text\":\" takes two.\"}]"
  ],
  "quest.59C7038E69692155.title": "The elemental arcana",
  "quest.59C7038E69692155.quest_desc": [
    "[\"\",{\"text\":\"Earthen\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:earthen_spirit\",\"count\":1}}},{\"text\":\" comes from zombies, cows and iron golems; \"},{\"text\":\"Infernal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:infernal_spirit\",\"count\":1}}},{\"text\":\" from creepers, blazes and most of the Nether; \"},{\"text\":\"Aerial\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:aerial_spirit\",\"count\":1}}},{\"text\":\" from spiders, bats and anything fast; \"},{\"text\":\"Aqueous\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:aqueous_spirit\",\"count\":1}}},{\"text\":\" from drowned, squid and fish. The crucible, the calx and every totem want them.\"}]"
  ],
  "quest.029C950DD37077D3.title": "Tainted and Twisted Rock",
  "quest.029C950DD37077D3.quest_desc": [
    "[\"\",{\"text\":\"Sixteen cobblestone with one Sacred and one Arcane: sixteen \"},{\"text\":\"Tainted Rock\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:tainted_rock\",\"count\":1}}},{\"text\":\", which dissipates nearby magic. Swap the Sacred for a Wicked and you get \"},{\"text\":\"Twisted Rock\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:twisted_rock\",\"count\":1}}},{\"text\":\", which pushes magic away. The crucible takes eight of each.\"}]"
  ],
  "quest.450D7029194842F9.title": "Calx and flesh",
  "quest.450D7029194842F9.quest_subtitle": "Unfit for human consumption. Keep it anyway.",
  "quest.450D7029194842F9.quest_desc": [
    "[\"\",{\"text\":\"Four clay balls with two Arcane, two Earthen and two Aqueous give four \"},{\"text\":\"Alchemical Calx\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:alchemical_calx\",\"count\":1}}},{\"text\":\", the base of every impetus and crucible augment. Four rotten flesh with two Sacred and two Wicked give \"},{\"text\":\"Living Flesh\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:living_flesh\",\"count\":1}}},{\"text\":\" for the healing trinkets.\"}]"
  ],
  "quest.79FCE5C4DDFC5420.title": "The Alchemical Impetus",
  "quest.79FCE5C4DDFC5420.quest_desc": [
    "Four calx with four Refined Soulstone and two Hex Ash, fed four Arcane and four Earthen. It is the crucible's substrate: every focusing cycle costs it durability, and at zero it fractures."
  ],
  "quest.3A6925EFDA62BD58.title": "The Spirit Crucible",
  "quest.3A6925EFDA62BD58.quest_subtitle": "Slow, but it beats mining.",
  "quest.3A6925EFDA62BD58.quest_desc": [
    "A furnace on the altar with two Hex Ash, eight of each rock, eight Infernal and eight Aqueous. Load an impetus and spirits and it focuses them into matter, a little at a time.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"One Arcane gives eight redstone, one Infernal eight glowstone dust, one Earthen eight gunpowder. Two Arcane with two Earthen, Aerial or Aqueous give four quartz, amethyst shards or prismarine shards; with two Infernal, four \"},{\"text\":\"Blazing Quartz\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:blazing_quartz\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.7DB3153950957ACD.title": "Ether",
  "quest.7DB3153950957ACD.quest_subtitle": "A flame that never asks for fuel.",
  "quest.7DB3153950957ACD.quest_desc": [
    "[\"\",{\"text\":\"Blazing Quartz\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:blazing_quartz\",\"count\":1}}},{\"text\":\" comes from Nether ore or from the crucible. Four glowstone dust and one Blazing Quartz, with two Infernal and one Arcane, give two \"},{\"text\":\"Ether\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:ether\",\"count\":1}}},{\"text\":\": a cold flame you can dye. It crafts torches and braziers, goes into the catalyzer and lights the Soulbinding Brazier.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Ether with a prismarine crystal, Arcane Charcoal and two Aqueous becomes \"},{\"text\":\"Iridescent Ether\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:iridescent_ether\",\"count\":1}}},{\"text\":\", which takes a second colour. Its first colour is then locked.\"}]"
  ],
  "quest.1E17E6CE323B2651.title": "The Eldritch spirit",
  "quest.1E17E6CE323B2651.quest_subtitle": "The last principle, found in the strangest mobs.",
  "quest.1E17E6CE323B2651.quest_desc": [
    "[\"\",{\"text\":\"Endermen drop three \"},{\"text\":\"Eldritch\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:eldritch_spirit\",\"count\":1}}},{\"text\":\" each; evokers, ravagers, shulkers and elder guardians carry some too. It is the pair of raw arcana, the impulse of endings, and every totem base and every greater rite needs it.\"}]"
  ],
  "quest.0292DE93381C1030.title": "The Totem Base",
  "quest.0292DE93381C1030.quest_subtitle": "Carve, stack, wait.",
  "quest.0292DE93381C1030.quest_desc": [
    "Four Runewood logs, six planks and two Hex Ash, with two each of Aerial, Aqueous, Earthen, Infernal and Eldritch, make four bases. Stack engraved logs on one in the right order and the totem performs a spirit rite on what surrounds it."
  ],
  "task.676A998FE5A5CA62.title": "Look at an engraved Runewood pole",
  "quest.450BE31FCA508D09.title": "The first rite",
  "quest.450BE31FCA508D09.quest_desc": [
    "[\"\",{\"text\":\"Use a spirit on a Runewood Log placed in the world to engrave it; an axe scrapes a wrong rune back off. Arcane right on the base, then two Sacred above it: the \"},{\"text\":\"Rite of Healing\",\"color\":\"#E07BFF\"},{\"text\":\" mends two hearts on every creature nearby.\"}]"
  ],
  "quest.33FC81BAF7B5B870.title": "Soulwood",
  "quest.33FC81BAF7B5B870.quest_subtitle": "It starts as one tree. It never ends as one tree.",
  "quest.33FC81BAF7B5B870.quest_desc": [
    "[\"\",{\"text\":\"Five Arcane runes on a Runewood base run the Undirected Rite: it scars the totem into Soulwood and turns the ground around it into blight. Run it far from anything you care about, then break the base for a \"},{\"text\":\"Soulwood Totem Base\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:soulwood_totem_base\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.34EA22986567F0EE.title": "Cthonic Gold",
  "quest.34EA22986567F0EE.quest_subtitle": "Pyrite's rich cousin.",
  "quest.34EA22986567F0EE.quest_desc": [
    "[\"\",{\"text\":\"A rare ore deep in the deepslate, between heights -48 and 0, rooted in gold veins. Each ore drops three or four fragments, and eight fragments make one \"},{\"text\":\"Cthonic Gold\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:cthonic_gold\",\"count\":1}}},{\"text\":\". Metal impetuses, the Soulbinding Brazier and the Belt of the Prospector need it.\"}]"
  ],
  "quest.3542C9C7C35584B7.title": "The Soulbinding Brazier",
  "quest.3542C9C7C35584B7.quest_subtitle": "Power for a price, signed in blood.",
  "quest.3542C9C7C35584B7.quest_desc": [
    "Hallowed Gold, Cthonic Gold, Runewood planks and Tainted Rock. Load a geas's central item, extras and spirits into it, light it with Ether, then use it to offer your blood: the oath binds to your soul. A soul holds two geasa at most.",
    "{@pagebreak}",
    "The Pact of the Reaper takes twelve Refined Soulstone, four Grim Talc and four Hex Ash, with sixteen Wicked, Aerial and Infernal: your scythe strikes sometimes follow up with extra cuts, while weapons you forswore deal a tenth of their damage and wear out."
  ],
  "task.76E043F6A9492B93.title": "Find the Weeping Well",
  "quest.2EE87396150D02FA.title": "The Weeping Well",
  "quest.2EE87396150D02FA.quest_subtitle": "Somebody walled this in on purpose.",
  "quest.2EE87396150D02FA.quest_desc": [
    "An old structure buried under the Overworld: Tainted Rock walls around a pool that is neither liquid nor solid. Arcane materials tug at your pockets near it. Throw them in and the Well spits each one back out, changed."
  ],
  "quest.7A8A6543C926E779.title": "What the Well gives back",
  "quest.7A8A6543C926E779.quest_desc": [
    "[\"\",{\"text\":\"Refined Soulstone comes back as \"},{\"text\":\"Null Slate\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:null_slate\",\"count\":1}}},{\"text\":\", Hex Ash as \"},{\"text\":\"Void Salts\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:void_salts\",\"count\":1}}},{\"text\":\", Brilliance as \"},{\"text\":\"Mnemonic Fragments\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:mnemonic_fragment\",\"count\":1}}},{\"text\":\" and blaze powder as \"},{\"text\":\"Auric Embers\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:auric_embers\",\"count\":1}}},{\"text\":\". Most raw ores come back as Raw Soulstone.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Everything the Well rejects flies out due south. Stand on the north side, or build your catcher to the south.\"}]"
  ],
  "quest.293935903406C9F7.title": "A black crystal",
  "quest.293935903406C9F7.quest_subtitle": "Ethics committee: still pending.",
  "quest.293935903406C9F7.quest_desc": [
    "[\"\",{\"text\":\"Step into the Well yourself. It throws you back out for two hearts of damage, and the first time a black spirit crystal comes out with you: \"},{\"text\":\"Umbral\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:umbral_spirit\",\"count\":1}}},{\"text\":\", the absence of arcana. Until you do, Malum keeps the void's items out of JEI and the creative tabs.\"}]"
  ],
  "quest.4B5FE76D7A2B1A33.title": "The Complete Design",
  "quest.4B5FE76D7A2B1A33.quest_desc": [
    "[\"\",{\"text\":\"Throw a block of iron into the Well for an \"},{\"text\":\"Anomalous Design\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:anomalous_design\",\"count\":1}}},{\"text\":\". On the altar with four of each of the eight spirits, it becomes the \"},{\"text\":\"Complete Design\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:complete_design\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.2D93ECBE7A5490E5.title": "Fused Consciousness",
  "quest.2D93ECBE7A5490E5.quest_subtitle": "The blueprint of everything, pocket-sized.",
  "quest.2D93ECBE7A5490E5.quest_desc": [
    "[\"\",{\"text\":\"Give the Complete Design back to the Well. What returns is a \"},{\"text\":\"Fused Consciousness\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:fused_consciousness\",\"count\":1}}},{\"text\":\": the eight arcana and the void in one thought. The \"},{\"text\":\"Belt of the Limitless\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7E34A8EEABC2ED02\"}},{\"text\":\", the Sundering Anchor, Unwinding Chaos and the \"},{\"text\":\"Stellar Mechanism\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"773C52A4D4FCA965\"}},{\"text\":\" are built on it.\"}]",
    "{@pagebreak}",
    "The altar, the crucible, the totems and the Well have all answered you. What remains of Malum is built from this thought."
  ],
  "quest.2CB3D5EEC792BEB2.title": "Encyclopedia Arcana",
  "quest.2CB3D5EEC792BEB2.quest_desc": [
    "A book and a Refined Soulstone. Malum's guide reads like a researcher's notebook, and every entry shows its infusion with the spirits and extra items it needs.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"With Malum's default settings, one of the first undead you kill drops a copy anyway.\"}]"
  ],
  "quest.20A10730D14A955F.title": "Arcane spirits for the common store",
  "quest.20A10730D14A955F.quest_subtitle": "Every lens wants two.",
  "quest.20A10730D14A955F.quest_desc": [
    "[\"\",{\"text\":\"Sixteen \"},{\"text\":\"Arcane Spirits\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:arcane_spirit\",\"count\":1}}},{\"text\":\" for the common store, once a day. Each act IV spectral lens takes two, and Hex Ash, rocks and rites burn through the rest.\"}]"
  ],
  "quest.3BCF26E098F0AE8C.title": "What runewood gives",
  "quest.3BCF26E098F0AE8C.quest_desc": [
    "[\"\",{\"text\":\"Some runewood logs ooze sap: strip one with an axe and use a glass bottle on it for \"},{\"text\":\"Runic Sap\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:runic_sap\",\"count\":1}}},{\"text\":\", a healing drink that also crafts into sapballs, which stand in for slimeballs in most recipes. Smelted runewood gives \"},{\"text\":\"Arcane Charcoal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:arcane_charcoal\",\"count\":1}}},{\"text\":\", which burns longer than charcoal.\"}]"
  ],
  "quest.44280DA3558E5C39.title": "Esoteric reaping",
  "quest.44280DA3558E5C39.quest_desc": [
    "[\"\",{\"text\":\"A soul shattered by the scythe changes what the body drops. Zombies leave \"},{\"text\":\"Rotting Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rotting_essence\",\"count\":1}}},{\"text\":\", skeletons \"},{\"text\":\"Grim Talc\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:grim_talc\",\"count\":1}}},{\"text\":\", phantoms and ghasts \"},{\"text\":\"Astral Weave\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:astral_weave\",\"count\":1}}},{\"text\":\", endermen \"},{\"text\":\"Warp Flux\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:warp_flux\",\"count\":1}}},{\"text\":\", and a breeze leaves a Wind Nucleus.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Grim Talc crafts into six bone meal, and eight bones around one make a skeleton skull.\"}]"
  ],
  "quest.78C17A1C11002516.title": "Enchant the scythe",
  "quest.78C17A1C11002516.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Spirit Plunder reaps extra spirits at the cost of some durability. Rebound lets you throw the scythe, Ascension launches you upward in a cutting gust, and the two don't mix. Haunted adds magic damage and Animated attack speed.\"}]"
  ],
  "quest.1B30DDEA4B287B48.title": "Recipes the pack repaired",
  "quest.1B30DDEA4B287B48.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Create's millstone grinds Grim Talc into six bone meal, with a chance of yellow dye and of four more bone meal; the pack fixed that recipe so it loads. Malum's repairs for The Undergarden's gear stay off: they name their spirits in a format this version rejects.\"}]"
  ],
  "quest.6C9C6969DFA3029C.title": "Soulwoven Silk",
  "quest.6C9C6969DFA3029C.quest_desc": [
    "[\"\",{\"text\":\"Two wool and two string with three Aerial and three Earthen weave four \"},{\"text\":\"Soulwoven Silk\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:soulwoven_silk\",\"count\":1}}},{\"text\":\". The cloth insulates against arcana, so pouches, banners, Soulhunter robes and the Runic Workbench are made of it.\"}]"
  ],
  "quest.4FB4904FC059FA41.title": "Pouches for the harvest",
  "quest.4FB4904FC059FA41.quest_subtitle": "It bites. Only what you told it to.",
  "quest.4FB4904FC059FA41.quest_desc": [
    "[\"\",{\"text\":\"String over Soulwoven Silk sews a \"},{\"text\":\"Soulwoven Pouch\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:soulwoven_pouch\",\"count\":1}}},{\"text\":\" that snaps up every spirit you collect. On the altar with twelve Rotting Essence and eight Grim Talc it grows teeth: the \"},{\"text\":\"Ravenous Pouch\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:ravenous_pouch\",\"count\":1}}},{\"text\":\" grabs any item that matches what it already holds.\"}]"
  ],
  "quest.5DB4B6324C23E1DD.title": "Obelisks",
  "quest.5DB4B6324C23E1DD.quest_subtitle": "Bookshelves, but occult.",
  "quest.5DB4B6324C23E1DD.quest_desc": [
    "[\"\",{\"text\":\"Two Runewood planks and two Hallowed Gold, with sixteen Aerial and eight Sacred: each \"},{\"text\":\"Runewood Obelisk\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:runewood_obelisk\",\"count\":1}}},{\"text\":\" near the altar adds a quarter to its speed, up to four. Socket Raw Brilliance instead and the \"},{\"text\":\"Brilliant Obelisk\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:brilliant_obelisk\",\"count\":1}}},{\"text\":\" counts as five bookshelves.\"}]",
    "{@pagebreak}",
    "Raw Brilliance comes from small pockets of Brilliant Stone below height 40. Smelted, it becomes refined Brilliance, solid experience you can bottle."
  ],
  "quest.28681B052594E15E.title": "Spirit Jars",
  "quest.28681B052594E15E.quest_desc": [
    "[\"\",{\"text\":\"Hallowed Gold over a glass block. Each \"},{\"text\":\"Spirit Jar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:spirit_jar\",\"count\":1}}},{\"text\":\" holds a near-infinite amount of one spirit type, so a row of eight by the altar ends the inventory juggling.\"}]"
  ],
  "quest.6BA85AC9B81751C1.title": "The Soulstained Scythe",
  "quest.6BA85AC9B81751C1.quest_desc": [
    "Put the Crude Scythe on the altar with four Soulstained Steel, two Hex Ash and four Refined Soulstone, fed sixteen Earthen, eight Wicked and eight Arcane. Same wide sweep, far more bite."
  ],
  "quest.0DC886308A399ADF.title": "Soulstained armor",
  "quest.0DC886308A399ADF.quest_desc": [
    "Each piece is its iron counterpart on the altar with six Soulstained Plating, four Refined Soulstone and eight Twisted Rock. The set carries Soul Ward, a recharging barrier: while it holds, magic damage drops by nine tenths and physical damage by three tenths.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The Ring of Manaweaving, a Gilded Ring with six plating and four Refined Soulstone, speeds Soul Ward's recovery every time you collect a spirit.\"}]"
  ],
  "quest.71D3D1E7DA80F940.title": "Soulhunter armor",
  "quest.71D3D1E7DA80F940.quest_subtitle": "Leather with opinions about magic.",
  "quest.71D3D1E7DA80F940.quest_desc": [
    "Leather armor on the altar with Soulwoven Silk, Refined Soulstone and more leather, fed Aerial and Earthen. It guards about as well as leather but amplifies your arcane power, and with Iron's Spellbooks installed it adds spell power too."
  ],
  "quest.3CB2F87E38786E69.title": "The Repair Pylon",
  "quest.3CB2F87E38786E69.quest_desc": [
    "A Tainted Rock pedestal with eight of each rock, fed sixteen Sacred, Aerial, Aqueous and Infernal. Load it with spirits and repair material and it mends a damaged item on a nearby pedestal, stand or crucible without experience: about half its durability, three quarters for spirit gear.",
    "{@pagebreak}",
    "The pack fixed Malum's four chalk repairs for Occultism: white, yellow, purple and red chalk come back to full for eight Arcane and, in that order, burnt otherstone, gold dust, two obsidian dust or Afrit essence."
  ],
  "quest.40C549A72E38B844.title": "Fractured, not finished",
  "quest.40C549A72E38B844.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A fractured impetus goes back to full on the Repair Pylon: two calx, four Arcane and four Earthen for the alchemical one; two Cthonic Gold fragments, eight Aqueous and eight Infernal for a metal one.\"}]"
  ],
  "quest.548DF607820F8C9B.title": "Metal nodes",
  "quest.548DF607820F8C9B.quest_subtitle": "Mining, but make it alchemy.",
  "quest.548DF607820F8C9B.quest_desc": [
    "[\"\",{\"text\":\"An impetus with four gunpowder, one Cthonic Gold and six iron ingots, fed eight Earthen, Infernal and Aqueous, becomes an \"},{\"text\":\"Iron Impetus\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:iron_impetus\",\"count\":1}}},{\"text\":\". Each crucible cycle then gives three \"},{\"text\":\"Iron Nodes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:iron_node\",\"count\":1}}},{\"text\":\", and each node smelts into six nuggets.\"}]",
    "{@pagebreak}",
    "The same recipe works for gold, copper, lead, silver, tin, nickel, zinc, osmium, uranium and aluminum, the metals this pack has ingots for. Cobalt's impetus does not load here."
  ],
  "quest.1E5BF251F3080AFD.title": "Blight: keep it fenced",
  "quest.1E5BF251F3080AFD.quest_desc": [
    "[\"\",{\"text\":\"Blight is random matter the rite left behind, not a poison. It never spreads alone, but spirits or bone meal make it echo outward. Break blighted earth without silk touch for \"},{\"text\":\"Blighted Gunk\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:blighted_gunk\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "Blightroot and Blightpearl grow on it with no light or water. They are useless, and they grow anyway."
  ],
  "quest.51FCBE11068D6261.title": "A plant made of crystal",
  "quest.51FCBE11068D6261.quest_subtitle": "Pretty. Useless. Grows anyway.",
  "quest.51FCBE11068D6261.quest_desc": [
    "[\"\",{\"text\":\"You broke a \"},{\"text\":\"Strange Crystal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:strange_crystal\",\"count\":1}}},{\"text\":\" off Scarstone with silk touch. About one blight spread in ten carves a Scarstone deposit, and the crystal grows on it like a plant. The Encyclopedia still hasn't found a use for it.\"}]"
  ],
  "reward.41D35F556FDC14CA.title": "Secret found",
  "quest.175F98B754DE7A98.title": "Cursed Sap",
  "quest.175F98B754DE7A98.quest_desc": [
    "[\"\",{\"text\":\"Soulwood logs ooze sap far more often than Runewood ones. Bottled the same way, \"},{\"text\":\"Cursed Sap\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:cursed_sap\",\"count\":1}}},{\"text\":\" doesn't heal: it raises your attack strength and adds damage resistance.\"}]"
  ],
  "quest.17A359645F8F7874.title": "Encyclopedia Esoterica",
  "quest.17A359645F8F7874.quest_desc": [
    "Throw your Encyclopedia Arcana into the Well. It comes back as the Esoterica, the notebook of the void: material studies, the black crystal and everything made from them."
  ],
  "quest.281FF55A316F6646.title": "Checkerboard, recharged",
  "quest.281FF55A316F6646.quest_subtitle": "Works even while bent.",
  "quest.281FF55A316F6646.quest_desc": [
    "[\"\",{\"text\":\"You crafted The Device, a checkerboard of Twisted and Tainted Rock, and fed it to the Well. It came back as \"},{\"text\":\"The Vessel\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:the_vessel\",\"count\":1}}},{\"text\":\". The Encyclopedia's only comment on the matter is a joke.\"}]"
  ],
  "reward.2A475781F517DA10.title": "Secret found",
  "quest.3FFCA6FAF2719604.title": "Dressed for the void",
  "quest.3FFCA6FAF2719604.quest_subtitle": "Formal wear for an informal abyss.",
  "quest.3FFCA6FAF2719604.quest_desc": [
    "[\"\",{\"text\":\"You threw black wool into the Weeping Well and it came back as a \"},{\"text\":\"Tophat\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:tophat\",\"count\":1}}},{\"text\":\". Nothing in either Encyclopedia explains why. Wear it anyway.\"}]"
  ],
  "reward.01F35DBE91DAFF72.title": "Secret found",
  "quest.069350E465C17D20.title": "The Mnemonic Hex Staff",
  "quest.069350E465C17D20.quest_desc": [
    "A Totemic Staff with eight Mnemonic Fragments, four Soulstained Steel and two Soulwood planks, fed sixteen Wicked, Aerial, Aqueous and Eldritch. Using it throws balls of liquid Wicked; the charge refills from your soul and is shared by all your staves.",
    "{@pagebreak}",
    "Two Malignant Pewter and eight Void Salts turn it into the Erosion Scepter, whose bolts strip a tenth of the target's magic with every hit."
  ],
  "quest.172A9B6588AB9477.title": "Malignant Pewter",
  "quest.172A9B6588AB9477.quest_subtitle": "The alloy that unwinds progress.",
  "quest.172A9B6588AB9477.quest_desc": [
    "[\"\",{\"text\":\"Cthonic Gold thrown into the Well comes back as \"},{\"text\":\"Malignant Lead\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:malignant_lead\",\"count\":1}}},{\"text\":\". Four iron ingots on the altar with the lead, eight Null Slate and two netherite scrap, fed sixteen Earthen and sixteen Eldritch, make a \"},{\"text\":\"Malignant Pewter Ingot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:malignant_pewter_ingot\",\"count\":1}}},{\"text\":\": a metal that magic cannot form around.\"}]"
  ],
  "quest.2DFAA6209F4758A9.title": "Malignant Stronghold armor",
  "quest.2DFAA6209F4758A9.quest_desc": [
    "Each Soulstained piece takes eight Soulwoven Silk and three Malignant Pewter Plating. With the full set only half of any harm reaches your soul, and the magic it intercepts feeds Malignant Aegis, a barrier that can nullify most incoming harm."
  ],
  "quest.0EE19A191A8A2592.title": "Weight and Edge",
  "quest.0EE19A191A8A2592.quest_desc": [
    "[\"\",{\"text\":\"Two Malignant Pewter turn a Soulstained axe into the \"},{\"text\":\"Weight of Worlds\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:weight_of_worlds\",\"count\":1}}},{\"text\":\": a kill stores a doubled blow for your next swing. The same pair turns the Soulstained scythe into the \"},{\"text\":\"Edge of Deliverance\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:edge_of_deliverance\",\"count\":1}}},{\"text\":\", which alternates killing strength after each taste of blood.\"}]"
  ],
  "image.1AA23F24FAAF7216.title": "[\"\",{\"text\":\"The harvest\",\"color\":\"#E07BFF\"}]",
  "image.033402037719177F.title": "[\"\",{\"text\":\"Around the altar\",\"color\":\"#E07BFF\"}]",
  "image.643B9E9BD992A145.title": "[\"\",{\"text\":\"Soulstained gear\",\"color\":\"#E07BFF\"}]",
  "image.7BB4E88439BF7321.title": "[\"\",{\"text\":\"Focusing\",\"color\":\"#E07BFF\"}]",
  "image.03A53DE2647F8581.title": "[\"\",{\"text\":\"Soulwood and blight\",\"color\":\"#E07BFF\"}]",
  "image.5F7F8D6ECD19780E.title": "[\"\",{\"text\":\"The Weeping Well\",\"color\":\"#E07BFF\"}]",
  "image.392DBEE7632D4B86.title": "[\"\",{\"text\":\"Malignant Pewter\",\"color\":\"#E07BFF\"}]",
  "image.6DA8CC3A4CF61D1A.title": "[\"\",{\"text\":\"Malum\",\"color\":\"#F3EEDF\",\"bold\":true}]",
  "image.5BDCD031C6981A07.title": "[\"\",{\"text\":\"scythe altar well\",\"color\":\"#D9B8F0\",\"font\":\"minecraft:alt\"}]",
  "image.6E498F64292DFA09.title": "Back to the Sun of Heliodor",
  "image.22AE48535A0989D5.title": "[\"\",{\"text\":\"» Rites and artifice\",\"color\":\"#D9B8F0\"}]",
  "chapter.35983AA5277900F3.title": "Malum · Rites and artifice",
  "chapter.35983AA5277900F3.chapter_subtitle": [
    "Twin totems, runes and trinkets, oaths sworn on a brazier and a crucible tuned to the last attribute."
  ],
  "quest.102A3EB7D226F91E.title": "The Totemic Staff",
  "quest.102A3EB7D226F91E.quest_subtitle": "Every totem has its reach.",
  "quest.102A3EB7D226F91E.quest_desc": [
    "A Runewood plank on top of two sticks. Holding it shows the area each totem affects, and using it on an engraved rune lights the rune up without starting a rite."
  ],
  "task.5573C8536D0EBFA9.title": "Look at an Eldritch rune on Runewood",
  "quest.7A36605766A138F0.title": "Greater rites",
  "quest.7A36605766A138F0.quest_subtitle": "The rune of endings goes first.",
  "quest.7A36605766A138F0.quest_desc": [
    "Engrave Eldritch right on the base, then Arcane, then two of one spirit. Most greater rites leave creatures alone and weave a bound locus instead: a spark that wanders four blocks per second and works on the blocks it crosses, eight times before it fades."
  ],
  "task.48B5A6D335998A6C.title": "Look at an engraved Soulwood pole",
  "quest.5B3699D072C5FCCF.title": "Corrupted rites",
  "quest.5B3699D072C5FCCF.quest_subtitle": "Same runes, other intentions.",
  "quest.5B3699D072C5FCCF.quest_desc": [
    "The Undirected Rite left you Soulwood. Engrave Soulwood logs like Runewood ones and stack them on a Soulwood base: every rune sequence now runs its corrupted rite. Some are gifts, one is a trap, and five Arcane runes run the Unchained Rite."
  ],
  "quest.2FE7E7D4223AABFC.title": "Rite Anchors",
  "quest.2FE7E7D4223AABFC.quest_subtitle": "Traffic control for sparks.",
  "quest.2FE7E7D4223AABFC.quest_desc": [
    "[\"\",{\"text\":\"Four Runewood planks with Soulwood planks, Refined Soulstone, Hex Ash and Tainted Rock make four \"},{\"text\":\"Rite Anchors\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rite_anchor\",\"count\":1}}},{\"text\":\". Socket one with a spirit and it steers every locus that passes: Arcane turns it, Aerial doubles its speed, Infernal its distance, Earthen its impact and Aqueous its potency.\"}]",
    "{@pagebreak}",
    "Each boon counts twice at most, and a locus takes four in all. Anchors stop working while powered by redstone, and a locus crossing Tainted Rock does nothing and does not age."
  ],
  "quest.7CE451A92CFB8144.title": "The Runic Workbench",
  "quest.7CE451A92CFB8144.quest_subtitle": "Power without the jewellery.",
  "quest.7CE451A92CFB8144.quest_desc": [
    "A Runewood pedestal on the altar with four Runewood planks, four Soulwoven Silk and two Hallowed Gold, fed sixteen Sacred, Arcane and Aqueous. It carves runes from four base blocks and sixteen or thirty-two spirits.",
    "{@pagebreak}",
    "Four Tainted Rock carve stone runes, four Runewood or Soulwood planks the wooden ones, which take thirty-two spirits, and four Null Slate the voidish ones."
  ],
  "quest.7B32469A75343012.title": "Brooches and runes",
  "quest.7B32469A75343012.quest_desc": [
    "[\"\",{\"text\":\"Runes need slots that only brooches open. The \"},{\"text\":\"Runic Brooch\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:runic_brooch\",\"count\":1}}},{\"text\":\" trades ring space for two rune slots, one per palm. Four Tainted Rock and sixteen Arcane carve the \"},{\"text\":\"Rune of Reinforcement\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_reinforcement\",\"count\":1}}},{\"text\":\", which strengthens Soul Ward.\"}]",
    "{@pagebreak}",
    "One brooch at a time. Rune slots only exist while something opens them: a brooch, or the Pact of Rune Exploitation."
  ],
  "quest.2345DAE0633B71A6.title": "Imitation Heart and Flesh",
  "quest.2345DAE0633B71A6.quest_subtitle": "Organs for oaths, grown on the altar.",
  "quest.2345DAE0633B71A6.quest_desc": [
    "[\"\",{\"text\":\"Four calx with eight Hex Ash, four Refined Soulstone and two Warp Flux, fed sixteen Wicked, Arcane and Aqueous, grow four \"},{\"text\":\"Imitation Hearts\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:imitation_heart\",\"count\":1}}},{\"text\":\". Living Flesh, nether wart and Rotting Essence, with Sacred for Wicked, grow \"},{\"text\":\"Imitation Flesh\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:imitation_flesh\",\"count\":1}}},{\"text\":\" instead.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Seven of the dearer pacts, all six oaths and both Authorities take these organs. The \"},{\"text\":\"Soulbinding Brazier\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3542C9C7C35584B7\"}},{\"text\":\" binds two geasa to a soul at most.\"}]"
  ],
  "quest.7D1F27E89D571CA2.title": "Tuning the crucible",
  "quest.7D1F27E89D571CA2.quest_subtitle": "Every crucible has a personality.",
  "quest.7D1F27E89D571CA2.quest_desc": [
    "[\"\",{\"text\":\"Augments go in a catalyzer, or up to four in the crucible itself. The \"},{\"text\":\"Accelerating Inlay\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:accelerating_inlay\",\"count\":1}}},{\"text\":\" (calx, Astral Weave and soulstone) speeds focusing with no drawback. A \"},{\"text\":\"Tuning Fork\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:tuning_fork\",\"count\":1}}},{\"text\":\" shows every attribute and lets you raise one at the cost of the others.\"}]",
    "{@pagebreak}",
    "Copies of the same augment compound. On top of the four, the crucible holds one core augment. The fork raises the attribute you pick and lowers every other one by half as much."
  ],
  "quest.773C52A4D4FCA965.title": "The Stellar Mechanism",
  "quest.773C52A4D4FCA965.quest_subtitle": "Tuning without the tax.",
  "quest.773C52A4D4FCA965.quest_desc": [
    "[\"\",{\"text\":\"Four calx with a \"},{\"text\":\"Fused Consciousness\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:fused_consciousness\",\"count\":1}}},{\"text\":\" and two Null Slate, fed sixteen Aerial, Aqueous, Earthen, Infernal and Eldritch. In the crucible's core it doubles what the Tuning Fork gives and cancels what it takes: the tuned attribute rises twice as much and the others stop paying for it.\"}]",
    "{@pagebreak}",
    "The totems move the world, the runes and trinkets move you, the geasa move your soul. The crucible, at last, moves matter without a price."
  ],
  "quest.7A8262DE4478E893.title": "Calx for the common store",
  "quest.7A8262DE4478E893.quest_subtitle": "Every augment starts as mud.",
  "quest.7A8262DE4478E893.quest_desc": [
    "[\"\",{\"text\":\"Sixteen \"},{\"text\":\"Alchemical Calx\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:alchemical_calx\",\"count\":1}}},{\"text\":\" for the common store, once a day. Every crucible augment, every Imitation Heart and the Stellar Mechanism start as calx.\"}]"
  ],
  "quest.5C9C0AC8B5BF7B90.title": "Reading a totem",
  "quest.5C9C0AC8B5BF7B90.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Runes count upward from the base. Lesser rite: Arcane, then two of one spirit. Greater rite: Eldritch, Arcane, then two of the spirit. Five Arcane runes are their own thing: the Undirected Rite on Runewood, the Unchained Rite on Soulwood.\"}]"
  ],
  "quest.7AC60A64A2A2953C.title": "Soulwood is not an upgrade",
  "quest.7AC60A64A2A2953C.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A Soulwood rite replaces its Runewood twin; it doesn't add to it. Keep a totem of each wood if you want both, and never run the Wicked lesser rite on Soulwood where you fight: it makes every hostile in range hit harder and last longer.\"}]"
  ],
  "task.70F3EAB795718B08.title": "Look at a Earthen rune on Runewood",
  "quest.25AC2A8EA551C6FC.title": "Earthen rites",
  "quest.25AC2A8EA551C6FC.quest_desc": [
    "[\"\",{\"text\":\"Arcane and two Earthen raise the \"},{\"text\":\"Rite of the Stone Ward\",\"color\":\"#E07BFF\"},{\"text\":\": creatures nearby take a fifth less damage, twice that while unarmored. The greater \"},{\"text\":\"Rite of Creation\",\"color\":\"#E07BFF\"},{\"text\":\" sends out a locus that fills the empty space it crosses with cobblestone.\"}]"
  ],
  "task.74FC3748E2B180CC.title": "Look at a Sacred rune on Runewood",
  "quest.76B410D5A9EA6A0E.title": "Sacred rites",
  "quest.76B410D5A9EA6A0E.quest_subtitle": "Pastoral care, occult edition.",
  "quest.76B410D5A9EA6A0E.quest_desc": [
    "[\"\",{\"text\":\"Arcane and two Sacred make the \"},{\"text\":\"Rite of Healing\",\"color\":\"#E07BFF\"},{\"text\":\". With Eldritch underneath it becomes the \"},{\"text\":\"Rite of Nurturing\",\"color\":\"#E07BFF\"},{\"text\":\": nearby animals age twenty-five seconds at a time, sheep graze more often, chickens lay more, bees pollinate faster and allays duplicate sooner.\"}]"
  ],
  "task.4A31AE83644B7F72.title": "Look at a Wicked rune on Runewood",
  "quest.2FFC4FBD508072ED.title": "Wicked rites",
  "quest.2FFC4FBD508072ED.quest_desc": [
    "[\"\",{\"text\":\"Arcane and two Wicked make the \"},{\"text\":\"Rite of Harming\",\"color\":\"#E07BFF\"},{\"text\":\", which strikes creatures in range for two hearts. The greater \"},{\"text\":\"Rite of Culling\",\"color\":\"#E07BFF\"},{\"text\":\" kills animals of any species with twenty or more of its kind in range, which caps a breeding pen by itself.\"}]"
  ],
  "task.1C54FC7D9EE29632.title": "Look at a Aqueous rune on Runewood",
  "quest.5A0B6339533FABEA.title": "Aqueous rites",
  "quest.5A0B6339533FABEA.quest_desc": [
    "[\"\",{\"text\":\"Arcane and two Aqueous make the \"},{\"text\":\"Rite of the Flowing Grasp\",\"color\":\"#E07BFF\"},{\"text\":\": two fifths more reach and item pickup range. The greater \"},{\"text\":\"Rite of Soaking\",\"color\":\"#E07BFF\"},{\"text\":\" sends out a locus that ages crops on the spot and bonemeals other plants; over tilled soil it grows the crop above.\"}]"
  ],
  "task.739743373D8C0D53.title": "Look at a Infernal rune on Runewood",
  "quest.1E56775317755BB6.title": "Infernal rites",
  "quest.1E56775317755BB6.quest_subtitle": "Why carry a furnace around?",
  "quest.1E56775317755BB6.quest_desc": [
    "[\"\",{\"text\":\"Arcane and two Infernal make the \"},{\"text\":\"Rite of the Burning Fervor\",\"color\":\"#E07BFF\"},{\"text\":\": two fifths more attack and mining speed. The greater \"},{\"text\":\"Rite of Smelting\",\"color\":\"#E07BFF\"},{\"text\":\" sends out a locus that smelts the blocks it crosses in place, as a furnace would: sand turns to glass, cobblestone to stone.\"}]"
  ],
  "task.510A5DF5BACFD5A3.title": "Look at a Aerial rune on Runewood",
  "quest.48F24C837AC8264B.title": "Aerial rites",
  "quest.48F24C837AC8264B.quest_desc": [
    "[\"\",{\"text\":\"Arcane and two Aerial make the \"},{\"text\":\"Rite of the Howling Gale\",\"color\":\"#E07BFF\"},{\"text\":\": two fifths more movement and attack speed. The greater \"},{\"text\":\"Rite of Gravity\",\"color\":\"#E07BFF\"},{\"text\":\" sends out a locus that drops the blocks it crosses like sand, but only blocks silk touch could pick up.\"}]"
  ],
  "task.59949F6B488FE19B.title": "Look at a Earthen rune on Soulwood",
  "quest.2F290E77C45CD90F.title": "Soulwood Earthen rites",
  "quest.2F290E77C45CD90F.quest_desc": [
    "[\"\",{\"text\":\"On Soulwood the lesser rite grants \"},{\"text\":\"Oaken Might\",\"color\":\"#E07BFF\"},{\"text\":\": one more heart of damage per hit, double with an empty hand. The greater \"},{\"text\":\"Rite of Destruction\",\"color\":\"#E07BFF\"},{\"text\":\" sends out a locus that breaks the blocks it crosses whatever tool they would need, unless they cannot be broken at all.\"}]"
  ],
  "task.6269A4852E028324.title": "Look at a Sacred rune on Soulwood",
  "quest.54A63C09008337DA.title": "Soulwood Sacred rites",
  "quest.54A63C09008337DA.quest_desc": [
    "[\"\",{\"text\":\"On Soulwood the lesser rite becomes the \"},{\"text\":\"Rite of Nourishment\",\"color\":\"#E07BFF\"},{\"text\":\": players nearby slowly shed exhaustion, so hunger lasts longer. The greater \"},{\"text\":\"Rite of Lust\",\"color\":\"#E07BFF\"},{\"text\":\" makes nearby animals breed as if you had fed them, until their species crowds.\"}]"
  ],
  "task.3BDAD6AABD9ABF8F.title": "Look at a Wicked rune on Soulwood",
  "quest.2188BA8B13F257C6.title": "Soulwood Wicked rites",
  "quest.2188BA8B13F257C6.quest_subtitle": "One trap, one executioner.",
  "quest.2188BA8B13F257C6.quest_desc": [
    "[\"\",{\"text\":\"The lesser rite here is a trap\",\"color\":\"#FF8C7A\"},{\"text\":\": the \"},{\"text\":\"Rite of Empowerment\",\"color\":\"#E07BFF\"},{\"text\":\" gives nearby hostiles more damage and health. The greater one redeems it: the \"},{\"text\":\"Rite of Rending\",\"color\":\"#E07BFF\"},{\"text\":\" kills any monster that drops below a tenth of its health.\"}]"
  ],
  "task.5EEFEB8E6A61EFF1.title": "Look at a Aqueous rune on Soulwood",
  "quest.1F4B6E52F536C29C.title": "Soulwood Aqueous rites",
  "quest.1F4B6E52F536C29C.quest_desc": [
    "[\"\",{\"text\":\"On Soulwood the lesser rite grants \"},{\"text\":\"Good Tides\",\"color\":\"#E07BFF\"},{\"text\":\", worth one level of Lure and one of Luck of the Sea. The greater \"},{\"text\":\"Rite of Sapping\",\"color\":\"#E07BFF\"},{\"text\":\" sends out a locus that makes pointed dripstone fill the cauldrons under it much faster.\"}]"
  ],
  "task.404C927E4417CC0E.title": "Look at a Infernal rune on Soulwood",
  "quest.5889B70D80DF9CA8.title": "Soulwood Infernal rites",
  "quest.5889B70D80DF9CA8.quest_desc": [
    "[\"\",{\"text\":\"On Soulwood the lesser rite becomes the \"},{\"text\":\"Rite of the Fiery Embrace\",\"color\":\"#E07BFF\"},{\"text\":\": burning creatures nearby are put out and heal a heart twice a second. The greater \"},{\"text\":\"Rite of Quickening\",\"color\":\"#E07BFF\"},{\"text\":\" sends out a locus that speeds up every furnace it crosses; fuel burns in step.\"}]"
  ],
  "task.50EC757E73D9F12C.title": "Look at a Aerial rune on Soulwood",
  "quest.7BF205926923E628.title": "Soulwood Aerial rites",
  "quest.7BF205926923E628.quest_subtitle": "What goes up keeps going.",
  "quest.7BF205926923E628.quest_desc": [
    "[\"\",{\"text\":\"On Soulwood the lesser rite grants \"},{\"text\":\"Sky Tether\",\"color\":\"#E07BFF\"},{\"text\":\": less gravity, two fifths more jump and softer landings. The greater \"},{\"text\":\"Rite of Ascension\",\"color\":\"#E07BFF\"},{\"text\":\" sends out a locus that lifts the blocks it crosses up to sixteen blocks, again only those silk touch could pick up.\"}]"
  ],
  "quest.3D925EB96EB68A09.title": "The other three etchings",
  "quest.3D925EB96EB68A09.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"An anchor socketed with Eldritch splits a passing locus in two, up to four times; the copies can't split again. Sacred mends a locus so it lasts longer, and Wicked mends it at once by burning a boon: speed first, then potency, impact and distance last.\"}]"
  ],
  "quest.4541E38C7DB592F3.title": "The Rite Unweaver",
  "quest.4541E38C7DB592F3.quest_subtitle": "A full stop for sparks.",
  "quest.4541E38C7DB592F3.quest_desc": [
    "[\"\",{\"text\":\"Four Runewood planks with six Soulstained Steel Plating, two Soulwood planks and two Twisted Rock, fed eight Wicked and eight Arcane, make four \"},{\"text\":\"Rite Unweavers\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rite_unweaver\",\"count\":1}}},{\"text\":\". A locus that reaches one unravels on the spot: the fence at the end of an anchor's road.\"}]"
  ],
  "quest.4B7AAE82103542F0.title": "The Arcana Pylon",
  "quest.4B7AAE82103542F0.quest_desc": [
    "A Runewood Obelisk with eight Refined Soulstone, four Hex Ash and two Soulwood planks, fed eight Aerial, Aqueous, Earthen and Infernal. Fed Arcane, each pylon speeds a nearby altar by half, up to four; fed an elemental spirit, it strengthens matching rite and rune auras."
  ],
  "quest.1E9A894EF7F3BD45.title": "Waveform totems",
  "quest.1E9A894EF7F3BD45.quest_desc": [
    "Copper blocks, redstone, Runewood and Ether make four Waveform Totem Bases. They hold the rite's energy until a redstone pulse fires it; only the pulse's rising edge counts, and an observer shows when the rite is ready."
  ],
  "task.0FF4B8A073B3DECF.title": "Any spirit diode",
  "quest.61F8079472144075.title": "Spirit diodes",
  "quest.61F8079472144075.quest_subtitle": "Redstone with a temperament.",
  "quest.61F8079472144075.quest_desc": [
    "[\"\",{\"text\":\"A copper block, four redstone, Ether and two Runewood planks make two diodes, and the spirit picks the temper. The \"},{\"text\":\"Wavecharger\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:wavecharger\",\"count\":1}}},{\"text\":\" (Aerial) ramps up and down, the \"},{\"text\":\"Wavebanker\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:wavebanker\",\"count\":1}}},{\"text\":\" (Aqueous) keeps the signal a while after it stops, the \"},{\"text\":\"Wavebreaker\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:wavebreaker\",\"count\":1}}},{\"text\":\" (Infernal) holds it before letting go.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Wavemaker\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:wavemaker\",\"count\":1}}},{\"text\":\" (Earthen) is a clock: it passes the input and flips it on a steady beat. The \"},{\"text\":\"Artificer's Claw\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:artificers_claw\",\"count\":1}}},{\"text\":\", copper and a block of redstone fed Earthen and Aqueous, stretches or shortens any diode's delay, down to one redstone tick.\"}]"
  ],
  "quest.2827222101205381.title": "Wind-weaving",
  "quest.2827222101205381.quest_subtitle": "An elevator with no cable to snap.",
  "quest.2827222101205381.quest_desc": [
    "[\"\",{\"text\":\"A copper block with redstone, two wind charges and Runewood, fed eight Aerial, makes two \"},{\"text\":\"Gust Igniters\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:gust_igniter\",\"count\":1}}},{\"text\":\": powered, one throws a burst of wind at whatever is near. Swap the charges for Wind Nuclei and you get four \"},{\"text\":\"Wind Tunnels\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:wind_tunnel\",\"count\":1}}},{\"text\":\", which an igniter keeps blowing as a rising column that carries mobs and items.\"}]"
  ],
  "task.621AE232D4CF1BC4.title": "Another brooch",
  "quest.31BAD287355B164A.title": "Three more brooches",
  "quest.31BAD287355B164A.quest_subtitle": "Every brooch sends a bill.",
  "quest.31BAD287355B164A.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Glass Brooch\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:glass_brooch\",\"count\":1}}},{\"text\":\" (the runic one with eight diamonds and four Astral Weave, fed Aqueous) opens its two rune slots for a quarter of your max health. The \"},{\"text\":\"Elaborate Brooch\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:elaborate_brooch\",\"count\":1}}},{\"text\":\", Soulstained Steel on leather, trades your necklace slot for a second belt.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Rotting Essence and Grim Talc, fed Wicked, turn it into the \"},{\"text\":\"Gluttonous Brooch\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:gluttonous_brooch\",\"count\":1}}},{\"text\":\": the extra belt without losing the necklace, paid in hunger that never quite leaves.\"}]"
  ],
  "task.219BE818BE7CCA14.title": "Another stone rune",
  "quest.24EE74019E8555AC.title": "Stone runes",
  "quest.24EE74019E8555AC.quest_desc": [
    "[\"\",{\"text\":\"Each takes four Tainted Rock and sixteen of its spirit. For the body: Sacred \"},{\"text\":\"Vitality\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_vitality\",\"count\":1}}},{\"text\":\", a fifth more healing; Aqueous \"},{\"text\":\"Ailment Cleansing\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_ailment_cleansing\",\"count\":1}}},{\"text\":\", bad effects wear off faster; Earthen \"},{\"text\":\"Protection\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_protection\",\"count\":1}}},{\"text\":\", a fifth more armor.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"For the mind: Aerial \"},{\"text\":\"Dexterity\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_dexterity\",\"count\":1}}},{\"text\":\", up to double speed as your health drops; Wicked \"},{\"text\":\"Culling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_culling\",\"count\":1}}},{\"text\":\", two fifths more scythe damage against targets at half health; Infernal \"},{\"text\":\"Scorching\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_scorching\",\"count\":1}}},{\"text\":\", double fire damage; Eldritch \"},{\"text\":\"Volatile Distortion\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_volatile_distortion\",\"count\":1}}},{\"text\":\", erratic hits that sometimes land double.\"}]"
  ],
  "task.702145C2C2DED778.title": "Any wooden rune",
  "quest.714925F795977D58.title": "Wooden runes",
  "quest.714925F795977D58.quest_subtitle": "A totem you can pocket.",
  "quest.714925F795977D58.quest_desc": [
    "[\"\",{\"text\":\"Four planks and thirty-two spirits carve a rune that wears a rite's aura at half strength. Runewood gives \"},{\"text\":\"Stone Ward\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_stone_ward\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Burning Fervor\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_burning_fervor\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Howling Gale\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_howling_gale\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Flowing Grasp\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_flowing_grasp\",\"count\":1}}},{\"text\":\"; Soulwood gives \"},{\"text\":\"Oaken Might\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_oaken_might\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Fiery Embrace\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_fiery_embrace\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Sky Tether\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_sky_tether\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Good Tides\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_good_tides\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.09C7B1D66513E14F.title": "Voidish runes",
  "quest.09C7B1D66513E14F.quest_desc": [
    "[\"\",{\"text\":\"Carve runes on Null Slate instead of Tainted Rock and they come out warped: four slate and sixteen of a spirit each. Sacred gives the \"},{\"text\":\"Rune of Bolstering\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_bolstering\",\"count\":1}}},{\"text\":\", extra health past full; Arcane gives Spell Mastery, staves charging twice as fast.\"}]"
  ],
  "task.58774E73106D35B3.title": "Another voidish rune",
  "quest.7A441ECB6D305E96.title": "Six more on Null Slate",
  "quest.7A441ECB6D305E96.quest_desc": [
    "[\"\",{\"text\":\"Eldritch \"},{\"text\":\"Heresy\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_heresy\",\"count\":1}}},{\"text\":\" silences the magic of what you hit, stacking up to none at all. Infernal \"},{\"text\":\"Igneous Solace\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_igneous_solace\",\"count\":1}}},{\"text\":\" toughens you while you burn. Earthen \"},{\"text\":\"Indomitability\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_indomitability\",\"count\":1}}},{\"text\":\" cancels knockback.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Wicked \"},{\"text\":\"Radial Empowerment\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_radial_empowerment\",\"count\":1}}},{\"text\":\" grows your weapon's strength with each scythe kill for a while. Aqueous \"},{\"text\":\"Twinned Duration\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_twinned_duration\",\"count\":1}}},{\"text\":\" makes good effects last longer. Aerial \"},{\"text\":\"Unnatural Stamina\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:rune_of_unnatural_stamina\",\"count\":1}}},{\"text\":\" speeds you up and lets you sprint even when hungry.\"}]"
  ],
  "quest.3686FD0D00BE6FB8.title": "Aerial pacts",
  "quest.3686FD0D00BE6FB8.quest_subtitle": "Gravity is a suggestion. Mostly.",
  "quest.3686FD0D00BE6FB8.quest_desc": [
    "[\"\",{\"text\":\"Twelve feathers and four Astral Weave anchor two. \"},{\"text\":\"Windswept\",\"color\":\"#E07BFF\"},{\"text\":\" (leather): sprinting builds speed, lost fast when you stop, and momentum makes knockback worse. \"},{\"text\":\"Continuing Shot\",\"color\":\"#E07BFF\"},{\"text\":\" (arrows): ranged hits speed up your draw, and a miss slows it down.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Sixteen Wind Nuclei anchor \"},{\"text\":\"Cloudskipper\",\"color\":\"#E07BFF\"},{\"text\":\": wind gusts launch you higher and grant Ascension, for double fall damage. A heavy core anchors \"},{\"text\":\"Skybreaker\",\"color\":\"#E07BFF\"},{\"text\":\": taking fall damage strikes the creatures around you and falling blows reach their target at any distance, for double knockback.\"}]"
  ],
  "quest.5D435380674AF0FE.title": "Sacred pacts",
  "quest.5D435380674AF0FE.quest_subtitle": "Mercy, with fine print.",
  "quest.5D435380674AF0FE.quest_desc": [
    "[\"\",{\"text\":\"Twelve \"},{\"text\":\"Living Flesh\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:living_flesh\",\"count\":1}}},{\"text\":\" anchor two. \"},{\"text\":\"Defiance\",\"color\":\"#E07BFF\"},{\"text\":\" (golden carrots, a golden apple): saturation heals twice as fast and healing grows four tenths, for a fifth of your max health. \"},{\"text\":\"Parasite\",\"color\":\"#E07BFF\"},{\"text\":\" (glistering melon, a golden apple): collecting spirits gives absorption, but healing drops four tenths.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Lifeweaver\",\"color\":\"#E07BFF\"},{\"text\":\" takes eight Imitation Flesh with golden carrots, apples and glistering melon: you regenerate on your own and share it with every creature nearby, enemies included.\"}]"
  ],
  "quest.3F2DF552B9B49223.title": "Aqueous pacts",
  "quest.3F2DF552B9B49223.quest_subtitle": "Terms and conditions: waterproof.",
  "quest.3F2DF552B9B49223.quest_desc": [
    "[\"\",{\"text\":\"Twelve prismarine crystals and two nautilus shells anchor two. \"},{\"text\":\"Self-Care\",\"color\":\"#E07BFF\"},{\"text\":\" (salmon): food fills you more and eating cleanses bad effects, but low hunger drains health much faster. \"},{\"text\":\"High Priest\",\"color\":\"#E07BFF\"},{\"text\":\" (prismarine shards): a fifth more block reach and a tenth more entity reach, which stall and slow you when an enemy hurts you.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"A heart of the sea anchors the other two. \"},{\"text\":\"Patience Repaid\",\"color\":\"#E07BFF\"},{\"text\":\" (copper): half of every hit arrives later as damage over time that cannot kill you, a fifth stronger and magical. \"},{\"text\":\"Tidal Affinity\",\"color\":\"#E07BFF\"},{\"text\":\" (kelp): underwater you move, strike and mine faster and resist more, and conduit power heals you; out of water you cannot heal.\"}]"
  ],
  "quest.7DE7D11BCC69E839.title": "Arcane pacts",
  "quest.7DE7D11BCC69E839.quest_subtitle": "Soul Ward, renegotiated.",
  "quest.7DE7D11BCC69E839.quest_desc": [
    "[\"\",{\"text\":\"Twelve \"},{\"text\":\"Soulstained Steel Plating\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:soul_stained_steel_plating\",\"count\":1}}},{\"text\":\" and eight Refined Soulstone anchor two Soul Ward pacts. \"},{\"text\":\"Fortress\",\"color\":\"#E07BFF\"},{\"text\":\" (fed Arcane and Earthen): more capacity and half again the integrity, at half the recovery. \"},{\"text\":\"Shield\",\"color\":\"#E07BFF\"},{\"text\":\" (Arcane, Aerial, Aqueous): more capacity and double recovery, at half the integrity.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Reciprocation\",\"color\":\"#E07BFF\"},{\"text\":\" takes eight Imitation Flesh with Warp Flux, soulstone and plating: magic damage you deal builds Soul Ward, capacity rises a lot and every gain doubles, but the ward no longer recovers on its own.\"}]"
  ],
  "task.2509415B1944A51A.title": "Twelve saplings",
  "quest.1D7513A01005FD48.title": "Earthen pacts",
  "quest.1D7513A01005FD48.quest_subtitle": "Back to the land, the hard way.",
  "quest.1D7513A01005FD48.quest_desc": [
    "[\"\",{\"text\":\"Twelve saplings and four emeralds anchor two. \"},{\"text\":\"Contentedness\",\"color\":\"#E07BFF\"},{\"text\":\" (eight bread): armor and toughness rise a fifth near a full belly and halve near starvation. \"},{\"text\":\"Lone Druid\",\"color\":\"#E07BFF\"},{\"text\":\" (eight chains): each empty armor slot gives five armor, two toughness and a quarter more healing, and any armor you wear hurts your soul.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Sixteen Rotting Essence anchor the profane pair. \"},{\"text\":\"Profane Ascetic\",\"color\":\"#E07BFF\"},{\"text\":\" (Imitation Flesh): Gluttony becomes Trial of Faith, more healing received, and rotten food heals, but saturation stops healing you. \"},{\"text\":\"Profane Glutton\",\"color\":\"#E07BFF\"},{\"text\":\" (Imitation Heart): Gluttony becomes Desperate Need, much more scythe damage and a poisonous slash, at the cost of armor, magic resistance and poison.\"}]"
  ],
  "quest.43E9135A15F94371.title": "Wicked pacts",
  "quest.43E9135A15F94371.quest_subtitle": "Anger, with paperwork.",
  "quest.43E9135A15F94371.quest_desc": [
    "[\"\",{\"text\":\"Twelve \"},{\"text\":\"Refined Soulstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:refined_soulstone\",\"count\":1}}},{\"text\":\" and four Hex Ash anchor two: the \"},{\"text\":\"Pact of the Reaper\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3542C9C7C35584B7\"}},{\"text\":\" and \"},{\"text\":\"Warlock\",\"color\":\"#E07BFF\"},{\"text\":\" (four Arcane Charcoal, fed Wicked and Aqueous). The Warlock's first hit on each enemy blasts it with Wicked arcana, and enemies notice you from twice as far.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Berserker\",\"color\":\"#E07BFF\"},{\"text\":\" takes eight Imitation Hearts with Living Flesh, Grim Talc and rotten flesh: damage you take becomes Wrath, and your hits spend it blasting enemies again and again. You take double damage, and Wrath fades.\"}]"
  ],
  "quest.4462232B5FB236DF.title": "Infernal pacts",
  "quest.4462232B5FB236DF.quest_subtitle": "Everything burns if you believe.",
  "quest.4462232B5FB236DF.quest_desc": [
    "[\"\",{\"text\":\"Twelve gunpowder and eight blaze powder anchor two. \"},{\"text\":\"Combustion\",\"color\":\"#E07BFF\"},{\"text\":\" (Blazing Quartz): the fires you set burn hotter, but being put out blasts you with Infernal arcana. \"},{\"text\":\"Prospector\",\"color\":\"#E07BFF\"},{\"text\":\" (raw gold): mining precious ore grants Avarice, more Fortune and a heart back, but a hit while it lasts sets you on fire.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Sixteen blaze powder anchor the dear pair. \"},{\"text\":\"Blastweaver\",\"color\":\"#E07BFF\"},{\"text\":\" (TNT, fire charges, gunpowder): explosions grow much stronger and feed Avarice, which also raises the blast damage you take. \"},{\"text\":\"Wyrd Reconstruction\",\"color\":\"#E07BFF\"},{\"text\":\" (Imitation Flesh, ghast tears): death is undone with a moment of invulnerability, then a heavy cooldown, and collecting spirits drains hunger.\"}]"
  ],
  "quest.6DF3571422F689BC.title": "Eldritch pacts",
  "quest.6DF3571422F689BC.quest_subtitle": "Hunger for arcana, notarised.",
  "quest.6DF3571422F689BC.quest_desc": [
    "[\"\",{\"text\":\"Twelve \"},{\"text\":\"Raw Soulstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:raw_soulstone\",\"count\":1}}},{\"text\":\" anchor two. \"},{\"text\":\"Shattering Addict\",\"color\":\"#E07BFF\"},{\"text\":\" (Hex Ash, Warp Flux): shattered souls give more spirits, more still when you chain kills, but every day without reaping drains more hunger. \"},{\"text\":\"Arcanaphage\",\"color\":\"#E07BFF\"},{\"text\":\" (Warp Flux, plating): extra arcana, and spirits boost your magic, but all damage turns magical and Soul Ward integrity halves.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Rune Exploitation\",\"color\":\"#E07BFF\"},{\"text\":\" takes eight Imitation Hearts with Warp Flux, soulstone and Hex Ash: your soul opens two rune slots of its own, and each rune worn trims a twentieth off your healing, armor, toughness and magic resistance.\"}]"
  ],
  "quest.50DEA64B044400EE.title": "Blood for the whole team",
  "quest.50DEA64B044400EE.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Everyone who uses the lit brazier offers blood and takes the geas, so a team can swear together. A creature under Weakness when you light it joins too, and both work the same when you forswear.\"}]"
  ],
  "quest.15D52F32EDBA0C82.title": "Oaths of the staff",
  "quest.15D52F32EDBA0C82.quest_subtitle": "House rules for staff casters.",
  "quest.15D52F32EDBA0C82.quest_desc": [
    "[\"\",{\"text\":\"Eight Mnemonic Fragments and four Imitation Hearts, fed thirty-two Arcane and Eldritch. \"},{\"text\":\"Overburdened Mind\",\"color\":\"#E07BFF\"},{\"text\":\" (Auric Embers, echo shards, Aqueous): double staff charge capacity, a quarter longer to charge.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Overeager Fist\",\"color\":\"#E07BFF\"},{\"text\":\" (Void Salts, blaze powder, Infernal): half the charge time, and a full charge fires on its own. \"},{\"text\":\"Overkeen Eye\",\"color\":\"#E07BFF\"},{\"text\":\" (Null Slate, ender pearls, Aerial): staff bolts home in on their target, and charges come back half as fast.\"}]"
  ],
  "quest.787913757E017139.title": "Oaths of deliverance",
  "quest.787913757E017139.quest_subtitle": "Etched into the killing blow.",
  "quest.787913757E017139.quest_desc": [
    "[\"\",{\"text\":\"Eight Malignant Pewter Plating and four Imitation Flesh, fed thirty-two Arcane and Eldritch, etch the critical strikes of the Weight of Worlds and the Edge of Deliverance. \"},{\"text\":\"Undiscerned Maw\",\"color\":\"#E07BFF\"},{\"text\":\" (Living Flesh, Sacred): crits devour life and heal you, until overuse wears your healing down.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Unmaker's Disdain\",\"color\":\"#E07BFF\"},{\"text\":\" (Void Salts, Wicked): crits slash again and again, growing with Malignant Conversion, and the Malignant Aegis shrinks. \"},{\"text\":\"Unsighted Resistance\",\"color\":\"#E07BFF\"},{\"text\":\" (netherite scrap, Earthen): crits recharge the Aegis, and hit softer while they do.\"}]"
  ],
  "quest.3F9CCE5C5AE53389.title": "Authorities",
  "quest.3F9CCE5C5AE53389.quest_subtitle": "A contract with the world itself.",
  "quest.3F9CCE5C5AE53389.quest_desc": [
    "[\"\",{\"text\":\"A \"},{\"text\":\"Fused Consciousness\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:fused_consciousness\",\"count\":1}}},{\"text\":\", sixteen Malignant Pewter Plating and thirty-two of all eight spirits. \"},{\"text\":\"Gleeful Target\",\"color\":\"#E07BFF\"},{\"text\":\" (Imitation Flesh, Void Salts): a hit drops you into stasis, where your effects pause and never run out, but all healing is quartered.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Inverted Heart\",\"color\":\"#E07BFF\"},{\"text\":\" (Imitation Hearts, Mnemonic Fragments): souls that witness yours bind to it, and bound targets take any damage you take or deal. Incoming magic damage is quadrupled.\"}]"
  ],
  "quest.5D52A7B8BD1F1247.title": "Paracausal Flame",
  "quest.5D52A7B8BD1F1247.quest_desc": [
    "Ether on the altar with eight Hex Ash, four Warp Flux and two crying obsidian, fed eight Arcane and eight Eldritch. Light the brazier with it instead of Ether and the geas you assemble burns away instead of binding."
  ],
  "quest.32059C1B4AFDCD51.title": "Tyrving",
  "quest.32059C1B4AFDCD51.quest_subtitle": "No sweep, all grudge.",
  "quest.32059C1B4AFDCD51.quest_desc": [
    "A Soulstained sword with sixteen Twisted Rock, eight Soulwood planks and a Paracausal Flame. Each hit adds magic damage that grows with the target's soul and snaps back a moment later. It cannot sweep, and it repairs with obsidian."
  ],
  "quest.1B5120631CA9DFB2.title": "Plinth, mirrors and poppets",
  "quest.1B5120631CA9DFB2.quest_desc": [
    "Three Encyclopedia pages describe magic Malum 1.8.2 doesn't have yet. The Ritual Plinth is registered with no recipe and no rituals; mirror magic (funnels for items and spirits) and voodoo (poppets you command) are announced for a future release. The Poppet item exists, but nothing makes it."
  ],
  "quest.5E5D469EB7EAF98D.title": "Rings of the harvest",
  "quest.5E5D469EB7EAF98D.quest_desc": [
    "[\"\",{\"text\":\"A \"},{\"text\":\"Gilded Ring\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:gilded_ring\",\"count\":1}}},{\"text\":\" is Hallowed Gold on leather. On the altar with four Living Flesh, four calx and a ghast tear, fed Sacred and Arcane, it becomes the \"},{\"text\":\"Ring of Curative Talent\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:ring_of_curative_talent\",\"count\":1}}},{\"text\":\": every spirit you pick up heals you a little.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Before any effect, Hallowed Gold trinkets add armor and Soulstained Steel ones add toughness.\"}]"
  ],
  "task.18F99D74D0BE8B1E.title": "Another reactive ring",
  "quest.7AF05E844897216C.title": "Rings that feed on spirits",
  "quest.7AF05E844897216C.quest_desc": [
    "[\"\",{\"text\":\"All three start from a Gilded Ring and act each time you collect a spirit. \"},{\"text\":\"Manaweaving\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:ring_of_manaweaving\",\"count\":1}}},{\"text\":\" (six Soulstained Plating) speeds Soul Ward's recovery; \"},{\"text\":\"Arcane Prowess\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:ring_of_arcane_prowess\",\"count\":1}}},{\"text\":\" (raw Brilliance and calx) pays out experience; \"},{\"text\":\"Alchemical Mastery\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:ring_of_alchemical_mastery\",\"count\":1}}},{\"text\":\" (nether wart, a fermented spider eye, calx) trims bad effects and stretches good ones.\"}]"
  ],
  "quest.1DD9966736E00C7B.title": "Ring of Esoteric Spoils",
  "quest.1DD9966736E00C7B.quest_subtitle": "Where the extra comes from, nobody asks.",
  "quest.1DD9966736E00C7B.quest_desc": [
    "An Ornate Ring, Soulstained Steel on leather, goes on the altar with eight Refined Soulstone and eight each of Wicked, Arcane and Eldritch. Every soul you shatter then gives up one extra spirit."
  ],
  "task.1E7079308C536AE1.title": "A wind ring",
  "quest.268BE19D979FBFF7.title": "Rings of the wind",
  "quest.268BE19D979FBFF7.quest_subtitle": "Scythe, meet weather.",
  "quest.268BE19D979FBFF7.quest_desc": [
    "[\"\",{\"text\":\"An Ornate Ring with six iron, four Wind Nuclei and four wind charges. Fed Wicked and Aerial it becomes the \"},{\"text\":\"Howling Maelstrom\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:ring_of_the_howling_maelstrom\",\"count\":1}}},{\"text\":\": a Rebound throw drags cutting winds around the scythe. Fed Sacred and Aerial, the \"},{\"text\":\"Rising Edge\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:ring_of_the_rising_edge\",\"count\":1}}},{\"text\":\": Ascension's blades launch what they cut.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Worn with the Necklace of the Narrow Edge, the Maelstrom brews a small storm where the scythe lands, and the Rising Edge launches hard enough to juggle.\"}]"
  ],
  "quest.476C27099A46B315.title": "Necklace of the Narrow Edge",
  "quest.476C27099A46B315.quest_desc": [
    "An Ornate Necklace with a block and two ingots of iron, fed sixteen Wicked, sixteen Earthen and eight Eldritch. It trades the scythe's sweep for a strong single-target hit. Wind Nuclei and wind charges make the rings that reshape Rebound and Ascension."
  ],
  "task.52EB617AF8D1A946.title": "Another necklace",
  "quest.3B6BD9A1D0317030.title": "Two more necklaces",
  "quest.3B6BD9A1D0317030.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Mystic Mirror\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:necklace_of_the_mystic_mirror\",\"count\":1}}},{\"text\":\" (an Ornate Necklace with Runewood, Warp Flux and an eye of ender, fed Sacred) strengthens every trinket that acts when you collect a spirit. \"},{\"text\":\"Blissful Harmony\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:necklace_of_blissful_harmony\",\"count\":1}}},{\"text\":\" (iron, phantom membrane, Astral Weave, diamonds) hides you from hostiles, Wicked-souled ones most of all.\"}]"
  ],
  "task.2827E62418609854.title": "A voidish necklace",
  "quest.36BD34C4E38ADAC7.title": "Necklaces from the Well",
  "quest.36BD34C4E38ADAC7.quest_desc": [
    "[\"\",{\"text\":\"Sixteen Null Slate and a Malignant Lead push the Narrow Edge into the \"},{\"text\":\"Hidden Blade\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:necklace_of_the_hidden_blade\",\"count\":1}}},{\"text\":\": no more sweep, but the pain you take feeds a flurry of counter-cuts, then ten seconds of rest. The Mystic Mirror becomes the \"},{\"text\":\"Watcher\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:necklace_of_the_watcher\",\"count\":1}}},{\"text\":\": hitting a foe at full health counts as collecting a spirit.\"}]"
  ],
  "quest.787F9BFBCEB05F1F.title": "Belt of the Prospector",
  "quest.787F9BFBCEB05F1F.quest_subtitle": "Greed, with a fortune enchantment.",
  "quest.787F9BFBCEB05F1F.quest_desc": [
    "A Gilded Belt with one Cthonic Gold and four each of raw gold, iron and copper, fed thirty-two Earthen and Infernal and sixteen Arcane. Mining precious ore grants Avarice, a chance at an extra Fortune level, and your explosions dig with Fortune III."
  ],
  "task.1DA28B33DA54DCD3.title": "A blasting ring",
  "quest.5CBB62D75F677D7B.title": "Rings for the blast",
  "quest.5CBB62D75F677D7B.quest_subtitle": "Mining, the loud way.",
  "quest.5CBB62D75F677D7B.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Ring of the Demolitionist\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:ring_of_the_demolitionist\",\"count\":1}}},{\"text\":\", an Ornate Ring with iron, gunpowder and blaze powder fed Infernal, makes your explosions bigger. The \"},{\"text\":\"Ring of the Hoarder\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:ring_of_the_hoarder\",\"count\":1}}},{\"text\":\", a Gilded Ring with iron, Warp Flux and ender pearls, drops what they dig at your feet.\"}]"
  ],
  "task.22F44429146ABEA0.title": "Another belt",
  "quest.7DE80F030C50552F.title": "Belts of want and warding",
  "quest.7DE80F030C50552F.quest_desc": [
    "[\"\",{\"text\":\"On a Gilded Belt, bone, Grim Talc and Rotting Essence fed Wicked make the \"},{\"text\":\"Belt of the Starved\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:belt_of_the_starved\",\"count\":1}}},{\"text\":\": impurities in the spirits you collect stack Gluttony, more magic damage, while hunger drains faster. Twisted Rock, Soulwood and plating make the \"},{\"text\":\"Belt of the Magebane\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:belt_of_the_magebane\",\"count\":1}}},{\"text\":\" instead.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The Magebane speeds Soul Ward's recovery and turns magic damage that hits you into instant ward. \"},{\"text\":\"Concentrated Gluttony\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:concentrated_gluttony\",\"count\":1}}},{\"text\":\", a honey bottle with Rotting Essence, is Gluttony you can drink; the \"},{\"text\":\"Ring of Desperate Voracity\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:ring_of_desperate_voracity\",\"count\":1}}},{\"text\":\" makes rotten food more filling and Gluttony last longer.\"}]"
  ],
  "quest.7E34A8EEABC2ED02.title": "Belt of the Limitless",
  "quest.7E34A8EEABC2ED02.quest_subtitle": "It loves you. Nobody asked.",
  "quest.7E34A8EEABC2ED02.quest_desc": [
    "The Magebane with a Fused Consciousness, sixteen Void Salts, eight Null Slate and four Mnemonic Fragments, fed sixty-four Sacred and thirty-two Arcane and Eldritch. Its own Soul Ward joins yours, doubling it, and together they soak up all damage, holding firmer the weaker they get; the ward recovers more slowly."
  ],
  "quest.0506EE5F0EA759DE.title": "Overclocked rings",
  "quest.0506EE5F0EA759DE.quest_desc": [
    "[\"\",{\"text\":\"Sixteen Null Slate and eight Void Salts push the Ring of Curative Talent into the \"},{\"text\":\"Ring of Growing Flesh\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:ring_of_growing_flesh\",\"count\":1}}},{\"text\":\": every spirit you collect now grants extra health instead of healing. Null Slate with Mnemonic Fragments does the same for Manaweaving and Esoteric Spoils.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Ring of Echoing Arcana\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:ring_of_echoing_arcana\",\"count\":1}}},{\"text\":\" grants Arcane Resonance with every spirit, strengthening your other collection effects. The \"},{\"text\":\"Ring of the Endless Well\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:ring_of_the_endless_well\",\"count\":1}}},{\"text\":\" keeps up to three staff charges in reserve. Desperate Voracity, with Void Salts, becomes the \"},{\"text\":\"Ring of Gruesome Concentration\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:ring_of_gruesome_concentration\",\"count\":1}}},{\"text\":\": foul food builds Gluttony too.\"}]"
  ],
  "quest.0BEEFC25FD2F172A.title": "The Unchained Rite",
  "quest.0BEEFC25FD2F172A.quest_desc": [
    "[\"\",{\"text\":\"Five Arcane runes on a Soulwood base run the Unchained Rite: its locus travels through blight and transmutes the block sitting on top. Runewood becomes Soulwood, so a Runewood Sapling set on blight comes back as a \"},{\"text\":\"Soulwood Sapling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:soulwood_sapling\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Stone steps down to cobblestone, gravel, sand and finally blight; dirt goes to rooted dirt, grass and moss. \"},{\"text\":\"Every step ends in more blight\",\"color\":\"#FF8C7A\"},{\"text\":\", but the locus dies where the blight ends, so its edge is also the rite's fence.\"}]"
  ],
  "task.5F830EBF0B97E3D0.title": "Blocks the rite makes",
  "quest.5C26BE6E956E5060.title": "Five more trees",
  "quest.5C26BE6E956E5060.quest_subtitle": "Snow goes in, calcite comes out.",
  "quest.5C26BE6E956E5060.quest_desc": [
    "Each tree is a ladder the locus climbs one rung per pulse. Deepslate turns to tuff and andesite, packed mud to dripstone and granite, snow blocks to calcite and diorite, and all three end in gravel, sand and blight. Mud turns to clay, prismarine and ice; basalt to magma, netherrack and soul sand.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Pick each rung before the next pulse: blocks nobody wants become renewable calcite, dripstone, tuff, prismarine and soul sand.\"}]"
  ],
  "quest.5A785AD5122542B7.title": "Two hours of void",
  "quest.5A785AD5122542B7.quest_subtitle": "The longest B-side in the Overworld.",
  "quest.5A785AD5122542B7.quest_desc": [
    "You infused a music disc with four each of Aerial, Aqueous, Earthen and Infernal into Kultik's Arcane Elegy, then let the Weeping Well have it. It came back as Aesthetica: two hours and twelve minutes long."
  ],
  "reward.494C8DC9173B4285.title": "Secret found",
  "task.210FDC84EB88B5CB.title": "Another augment",
  "quest.02FFFA3AD4DDC849.title": "Seven more augments",
  "quest.02FFFA3AD4DDC849.quest_desc": [
    "[\"\",{\"text\":\"All start as four calx and two Refined Soulstone. For a safer impetus: the \"},{\"text\":\"Prismatic Focus Lens\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:prismatic_focus_lens\",\"count\":1}}},{\"text\":\" lowers instability, the \"},{\"text\":\"Mending Diffuser\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:mending_diffuser\",\"count\":1}}},{\"text\":\" may mend it after each cycle, and the \"},{\"text\":\"Shielding Apparatus\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:shielding_apparatus\",\"count\":1}}},{\"text\":\" may absorb the damage whole, at some speed.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"For more output: the \"},{\"text\":\"Blazing Diode\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:blazing_diode\",\"count\":1}}},{\"text\":\" cuts the catalyzers' fuel and hurries things a little; the \"},{\"text\":\"Intricate Assembly\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:intricate_assembly\",\"count\":1}}},{\"text\":\" may double a cycle's yield, slower and hungrier; the \"},{\"text\":\"Warping Engine\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:warping_engine\",\"count\":1}}},{\"text\":\" sometimes finishes a second cycle at once and stacks bonuses as it chains, burning much more fuel; the \"},{\"text\":\"Impurity Stabilizer\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:impurity_stabilizer\",\"count\":1}}},{\"text\":\" lifts your weakest attribute.\"}]"
  ],
  "task.5A9414133B0CF9A7.title": "A core augment",
  "quest.764D07B2DD2D9EBF.title": "Core augments",
  "quest.764D07B2DD2D9EBF.quest_subtitle": "One heart per crucible.",
  "quest.764D07B2DD2D9EBF.quest_desc": [
    "[\"\",{\"text\":\"Six calx each, and the crucible holds one in its core. The \"},{\"text\":\"Caustic Catalyst\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:caustic_catalyst\",\"count\":1}}},{\"text\":\" (Blazing Quartz, prismarine crystals) turns rising instability into tuning potency. The \"},{\"text\":\"Resonance Tuner\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:resonance_tuner\",\"count\":1}}},{\"text\":\" (Astral Weave, refined Brilliance) trades speed for little or no instability.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Sympathy Drive\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:sympathy_drive\",\"count\":1}}},{\"text\":\" (Living Flesh and soulstone, fed Sacred and Wicked) remembers each wound to the impetus; when a Mending Diffuser heals it, the drive forgives it with extra repair and better stats for three cycles.\"}]"
  ],
  "quest.35EBED9DA5664F47.title": "Do not install",
  "quest.35EBED9DA5664F47.quest_subtitle": "The manual's only instruction.",
  "quest.35EBED9DA5664F47.quest_desc": [
    "[\"\",{\"text\":\"Six calx and four Warp Flux, fed Arcane and Eldritch: you made the \"},{\"text\":\"Suspicious Device\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"malum:suspicious_device\",\"count\":1}}},{\"text\":\". In a crucible's core, the next finished cycle detonates and spreads blight. The Encyclopedia files it as a warning, not a recommendation.\"}]"
  ],
  "reward.3E8C246C8A196951.title": "Secret found",
  "quest.7967FDD815A59827.title": "The Spirit Catalyzer",
  "quest.7967FDD815A59827.quest_desc": [
    "A Twisted Rock pedestal with four of each rock and one Ether, fed eight Infernal and eight Aerial. Each fueled catalyzer near a crucible speeds focusing, up to eight of them, but instability grows with each one and can wear the impetus faster."
  ],
  "image.44D07685BCCEA36C.title": "[\"\",{\"text\":\"Runewood rites\",\"color\":\"#E07BFF\"}]",
  "image.43F5D68FF48137C0.title": "[\"\",{\"text\":\"Soulwood rites\",\"color\":\"#E07BFF\"}]",
  "image.141E45E8D1806E3A.title": "[\"\",{\"text\":\"Waveform artifice\",\"color\":\"#E07BFF\"}]",
  "image.61537B0FB29D3EA4.title": "[\"\",{\"text\":\"Rings, necklaces and belts\",\"color\":\"#E07BFF\"}]",
  "image.5E7EFCC11E4098CA.title": "[\"\",{\"text\":\"Oaths and Authorities\",\"color\":\"#E07BFF\"}]",
  "image.1504AD75BCACEE9E.title": "[\"\",{\"text\":\"Forswearing\",\"color\":\"#E07BFF\"}]",
  "image.2308DA61997EE6E8.title": "[\"\",{\"text\":\"Unchained and the Well\",\"color\":\"#E07BFF\"}]",
  "image.6A9EEC13EB78F545.title": "[\"\",{\"text\":\"Malum\",\"color\":\"#F3EEDF\",\"bold\":true}]",
  "image.7B39FFD7E0A4D0DF.title": "[\"\",{\"text\":\"Rites and artifice\",\"color\":\"#E07BFF\"}]",
  "image.55E228C67B426772.title": "[\"\",{\"text\":\"totem rune oath\",\"color\":\"#D9B8F0\",\"font\":\"minecraft:alt\"}]",
  "image.54CAD244C7B9D41A.title": "Back to Malum",
  "image.0A6FA6AA4AD76004.title": "[\"\",{\"text\":\"Loci\",\"color\":\"#E07BFF\"}]",
  "image.494946DB1CD83885.title": "[\"\",{\"text\":\"Runes and brooches\",\"color\":\"#E07BFF\"}]",
  "image.6E481B3585039567.title": "[\"\",{\"text\":\"Crucible tuning\",\"color\":\"#E07BFF\"}]",
  "image.435DA791CAC20057.title": "[\"\",{\"text\":\"Pacts by spirit\",\"color\":\"#E07BFF\"}]",
  "chapter.433D202F0AB8B336.title": "Occultism · Spirits and storage",
  "chapter.433D202F0AB8B336.chapter_subtitle": [
    "Workers, miners, familiars and a dimension for your things: every job has its spirit, and every spirit its tier."
  ],
  "quest.353FC9B6E478C883.title": "The Foliot Transporter",
  "quest.353FC9B6E478C883.quest_subtitle": "A hopper line without the hoppers.",
  "quest.353FC9B6E478C883.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Any two inventories, one Foliot: it carries between them.\"}]",
    "",
    "[\"\",{\"text\":\"Aviar's Circle with a minecart, a chest, a dispenser and a hopper calls a Transporter, and the ritual drops its \"},{\"text\":\"Book of Calling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:book_of_calling_foliot_transport_items\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Sneak-use the book on the source inventory, then on the target: machines and other spirits included."
  ],
  "quest.5D6A2910F50F7AD3.title": "The Foliot Janitor",
  "quest.5D6A2910F50F7AD3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A brush, a chest, a dispenser and a hopper on Aviar's Circle.\"}]",
    "",
    "[\"\",{\"text\":\"The Janitor picks up items dropped in its area and delivers them to the inventory you sneak-used its \"},{\"text\":\"Book of Calling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:book_of_calling_foliot_cleaner\",\"count\":1}}},{\"text\":\" on.\"}]",
    "",
    "Transporter in, Janitor out, a crusher in between: the classic ore loop."
  ],
  "quest.25BD7367034ED0C8.title": "It starts on allow",
  "quest.25BD7367034ED0C8.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A new Janitor or Transporter moves nothing: both start with an empty allow list. Sneak-use the spirit to open its filter, then list items or a tag, or flip it to a block list.\"}]"
  ],
  "task.7A1A571CD29A25E7.title": "Summon a Foliot Smelter",
  "task.2CE2CA84DA337880.title": "Summon a Foliot Crystallizer",
  "quest.340A9A1A5DB500E2.title": "Smelter and crystallizer",
  "quest.340A9A1A5DB500E2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"One Foliot smelts with no fuel; another grows gems.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Coal, a furnace and a campfire call a Foliot Smelter: furnace, blast furnace, smoker and campfire recipes at furnace speed, no fuel.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Spirit Attuned Crystal with amethyst, lapis and emerald dusts calls a Foliot Crystallizer, which slowly turns gem dusts back into gems and multiplies gem ores.\"}]"
  ],
  "quest.15EA42219BD31C44.title": "The Foliot Farmer",
  "quest.15EA42219BD31C44.quest_subtitle": "Farm work, outsourced to the afterlife.",
  "quest.15EA42219BD31C44.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Foliot harvests and replants for you.\"}]",
    "",
    "[\"\",{\"text\":\"Demon's Dream Fruit, wheat, a carrot, a potato and a hoe: a Farmer that harvests and replants the crops in its work area and, with a deposit set in its \"},{\"text\":\"Book of Calling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:book_of_calling_foliot_farmer\",\"count\":1}}},{\"text\":\", carries the harvest to a chest.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"It rests a few minutes after clearing the area. Setting the work area again wakes it.\"}]"
  ],
  "task.4612A935AB6117BF.title": "Summon an Otherstone Trader",
  "task.36BC525E28CCBE32.title": "Summon a Sapling Trader",
  "quest.0E2BA12F8E939E80.title": "Trade spirits",
  "quest.0E2BA12F8E939E80.quest_subtitle": "Brief, but fair.",
  "quest.0E2BA12F8E939E80.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two traders swap plain stuff for Otherworld stuff.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Stone, granite, diorite and andesite call an Otherstone Trader.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Four vanilla saplings, a Sapling Trader.\"}]",
    "{@pagebreak}",
    "Drop the offer beside one and it throws the trade back: stone for Otherstone, unstable Otherworld saplings for stable ones anyone can harvest.",
    "",
    "Traders fade fast."
  ],
  "quest.4DF7EE2F9042D90F.title": "The Foliot Lumberjack",
  "quest.4DF7EE2F9042D90F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A stable \"},{\"text\":\"Otherworld Sapling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:otherworld_sapling\",\"count\":1}}},{\"text\":\" from the Sapling Trader, oak, birch and spruce saplings and an axe.\"}]",
    "",
    "[\"\",{\"text\":\"The Lumberjack fells the trees in its work area and, with a deposit set in its \"},{\"text\":\"Book of Calling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:book_of_calling_foliot_lumberjack\",\"count\":1}}},{\"text\":\", stores the wood and replants.\"}]"
  ],
  "quest.2113321E34D6AB18.title": "Books of Calling and lamps",
  "quest.2113321E34D6AB18.quest_subtitle": "The worker goes where you go.",
  "quest.2113321E34D6AB18.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The book runs the worker; the lamp keeps it safe from decay.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Right-click the air to configure.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Sneak-use a block to apply.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Sneak-use the spirit to capture it.\"}]",
    "",
    "Lost the book? Craft it again from a bound book and sneak-use it on the spirit.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"A \"},{\"text\":\"Magic Lamp\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:magic_lamp_empty\",\"count\":1}}},{\"text\":\" carries a worker safe from decay.\"}]"
  ],
  "task.24E3EE5F590F43EF.title": "Summon a Djinni Crusher",
  "task.3B110190CE00533F.title": "Summon a Djinni Smelter",
  "task.034C69768679F790.title": "Summon a Djinni Crystallizer",
  "quest.3E436D1792543A16.title": "Djinni at work",
  "quest.3E436D1792543A16.quest_subtitle": "Faster hands, sharper teeth.",
  "quest.3E436D1792543A16.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Ophyx' Calling\",\"italic\":true},{\"text\":\", with lime chalk and four skulls.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Djinni Crusher turns one ore into three dusts and crushes ice without melting it.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Djinni Smelter works twice as fast.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Djinni Crystallizer is faster, yields more from gem ores and breaks amethyst and quartz blocks back down.\"}]"
  ],
  "task.73CE60572DDE5C99.title": "Make it day",
  "task.73140217EC678081.title": "Make it night",
  "quest.4A60EF2567A10FC6.title": "A Djinni with a watch",
  "quest.4A60EF2567A10FC6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Skip the wait: a Djinni sets day or night on request.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A torch, a sapling, wheat and yellow dye call a Djinni that makes it day.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Gunpowder, rotten flesh, a bone and black dye, one that makes it night.\"}]",
    "{@pagebreak}",
    "Each changes the time once and leaves: cheaper than waiting when a ritual or a hunt wants a certain hour."
  ],
  "task.3B70805F2DDAA330.title": "Summon the Wondering Trader",
  "quest.32889FF2E657980A.title": "The Wondering Trader",
  "quest.32889FF2E657980A.quest_subtitle": "Not a typo. He wonders.",
  "quest.32889FF2E657980A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two Otherworld Essence and two emeralds on Ophyx' Calling.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"To plain eyes he's a wandering trader.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"With the Third Eye or the goggles you see what he really is.\"}]",
    "",
    "The first time you talk to him, he only shows the mundane stock."
  ],
  "task.32EAB44D9D51232A.title": "Summon the Gem Gambler",
  "quest.2AF30E54DE53E590.title": "The house always wins",
  "quest.2AF30E54DE53E590.quest_subtitle": "Especially when the house is a Djinni.",
  "quest.2AF30E54DE53E590.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"You summoned the Gem Gambler with an emerald, a diamond block, gold and a silver block.\"}]",
    "",
    "[\"\",{\"text\":\"Bet a gem and get a random gem or nugget back, the rare \"},{\"text\":\"Iesnium Nugget\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:iesnium_nugget\",\"count\":1}}},{\"text\":\" included. Grab your winnings fast: it keeps betting whatever it finds on the floor.\"}]"
  ],
  "reward.7988E3E417E69ED4.title": "Secret found",
  "task.4BF89B3CE5730D0A.title": "Summon an Afrit Crusher",
  "task.6224FE790BA47933.title": "Summon an Afrit Smelter",
  "task.0E0A7A957C41F5C2.title": "Summon an Afrit Crystallizer",
  "quest.171288938B89FB4E.title": "Afrit at work",
  "quest.171288938B89FB4E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Abras' Conjure\",\"italic\":true},{\"text\":\", red chalk and four crystals.\"}]",
    "",
    "An Afrit Crusher makes four dusts per ore, an Afrit Smelter works in a tenth of the time, and an Afrit Crystallizer also rebuilds crushed blocks."
  ],
  "task.29A446C21E266C33.title": "Call the rain",
  "task.17623287DE105865.title": "Call a thunderstorm",
  "quest.47651405BEFD17E0.title": "Weather on demand",
  "quest.47651405BEFD17E0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Rain, thunder or a clear sky, on order.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Sand, dried kelp, a cactus and a dead bush with a cow bring rain.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Bones, gunpowder and a ghast tear with a cow bring a thunderstorm.\"}]",
    "",
    "A Djinni with beetroot, carrot, potato and wheat clears the sky.",
    "",
    "Weather spirits change it once, then vanish."
  ],
  "task.5CDFA8409363DE17.title": "Summon a Marid Crusher",
  "task.1D8A8579B5203D09.title": "Summon a Marid Smelter",
  "task.3761871741A16F35.title": "Summon a Marid Crystallizer",
  "quest.26FEE7CF2C363E14.title": "Marid at work",
  "quest.26FEE7CF2C363E14.quest_subtitle": "Overkill, by design.",
  "quest.26FEE7CF2C363E14.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Fatma's Incentivized Attraction\",\"italic\":true},{\"text\":\", blue chalk and eight crystals.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Marid Crusher makes six dusts per ore and grinds echo shards whole.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Marid Smelter needs a hundredth of the time.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Marid Crystallizer turns amethyst clusters into budding amethyst and obsidian into crying obsidian.\"}]"
  ],
  "quest.07EE66B014AB00A6.title": "A tablet full of levels",
  "quest.07EE66B014AB00A6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A spirit that holds your experience levels.\"}]",
    "",
    "An Otherworldly Tablet, research dust, a Spirit Attuned Gem and an ender pearl on the Foliot infusion: a spirit that holds experience.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Right-click stores all your levels in the \"},{\"text\":\"Knowledge Tablet\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:knowledge_tablet\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Sneak-right-click takes them back, or hand it to a friend.\"}]"
  ],
  "quest.7DC606A8388E92A2.title": "The Spirit Grindstone",
  "quest.7DC606A8388E92A2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Djinni infusion of a grindstone, glass, a Spirit Attuned Crystal and prismarine crystals.\"}]",
    "",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Spirit Grindstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:spirit_grindstone\",\"count\":1}}},{\"text\":\" strips only curses, keeps every other enchantment, refunds all of the curses' experience and repairs better when you combine two items.\"}]"
  ],
  "quest.29686E1D7D47A842.title": "An iesnium edge",
  "quest.29686E1D7D47A842.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Sevira's circle upgrades the butcher knife with two iesnium ingots, Afrit Essence and netherite dust.\"}]",
    "",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Iesnium Butcher Knife\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:iesnium_butcher_knife\",\"count\":1}}},{\"text\":\" hits harder, still takes tallow, deals triple damage to spirits and sometimes takes heads: a skeleton loses its skull one time in four.\"}]"
  ],
  "quest.177EAD9F1FA367B4.title": "The Iesnium Anvil",
  "quest.177EAD9F1FA367B4.quest_subtitle": "Past the maximum, at half price.",
  "quest.177EAD9F1FA367B4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Uphyxes Inverted Tower with an anvil, three blocks of iesnium and Marid Essence.\"}]",
    "",
    "It never breaks, takes an enchantment one level past its maximum, pays half the shown cost itself, slows the prior-work penalty and raises the too-expensive cap."
  ],
  "quest.125BACA6BF18264C.title": "The Dimensional Mineshaft",
  "quest.125BACA6BF18264C.quest_subtitle": "Mining without the commute.",
  "quest.125BACA6BF18264C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Djinni holds open a portal too small for you, and miner spirits go through it for ore.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Strigeor's Higher Binding with Otherstone, a gold ingot, a block of iesnium and a Spirit Attuned Crystal; in this pack it also takes an \"},{\"text\":\"Ironwood Ingot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"twilightforest:ironwood_ingot\",\"count\":1}}},{\"text\":\", the act IV material.\"}]",
    "{@pagebreak}",
    "Lamp in the top, ores out the bottom, every slot from the sides.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A redstone signal pauses it.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A comparator reads fill and lamp wear, and at \"},{\"text\":\"10\",\"color\":\"#CE8BFF\"},{\"text\":\" it's time to stop.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"It destroys what it can't store, so drain it with a hopper, a pipe or a Transporter.\"}]"
  ],
  "quest.2CDF4CFA614E7F02.title": "Miner Foliot",
  "quest.2CDF4CFA614E7F02.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"An empty Magic Lamp, an Iesnium Pickaxe, an iron ingot and gravel on the Foliot infusion.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"The \"},{\"text\":\"Miner Foliot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:miner_foliot_unspecialized\",\"count\":1}}},{\"text\":\" digs slowly and brings back whatever it finds, stone included.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Its lamp wears slowly, and when it breaks the spirit goes home.\"}]"
  ],
  "quest.70071D10FE1B5D24.title": "Ore Miner Djinni",
  "quest.70071D10FE1B5D24.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The Foliot's lamp, another Iesnium Pickaxe, gold, lapis and a crystal on Strigeor's circle.\"}]",
    "",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Ore Miner Djinni\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:miner_djinni_ores\",\"count\":1}}},{\"text\":\" skips stone and brings only ores, faster, but it wears its lamp quickly.\"}]"
  ],
  "quest.04F1FE3356E5ED23.title": "Deep Ore Miner Afrit",
  "quest.04F1FE3356E5ED23.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The Afrit goes deeper: deepslate ores, faster, gentler on its lamp.\"}]",
    "",
    "[\"\",{\"text\":\"The Djinni's lamp, a third Iesnium Pickaxe, a crystal, Afrit Essence, an echo shard and crying obsidian on Sevira's circle: an \"},{\"text\":\"Afrit\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:miner_afrit_deeps\",\"count\":1}}},{\"text\":\" miner.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Sevira's circle also repairs a worn lamp for three Otherworld Essence and a gem, enchantments kept; the same Afrit ritual fixes tools and armor.\"}]"
  ],
  "quest.303A749BB761A870.title": "Master Miner Marid",
  "quest.303A749BB761A870.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The fastest, the kindest to its lamp, and the only one that finds ancient debris and iesnium ore.\"}]",
    "",
    "[\"\",{\"text\":\"The Afrit's lamp with an Iesnium Pickaxe, a crystal, a netherite pickaxe, dragon's breath, a Totem of Undying, a Nether Star and Marid Essence: the \"},{\"text\":\"Marid\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:miner_marid_master\",\"count\":1}}},{\"text\":\" miner.\"}]"
  ],
  "quest.1E82438707E4EBB5.title": "Enchant your miners",
  "quest.1E82438707E4EBB5.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Miners take enchantments: Efficiency speeds them up, Fortune adds results, Silk Touch multiplies them, Unbreaking and Mending spare the lamp. They draw from ore tags, and Create: New Age's thorium has none in this pack, so it still needs real mining.\"}]"
  ],
  "quest.5DB6E183D1C6408E.title": "The Dimensional Extractor",
  "quest.5DB6E183D1C6408E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A pedestal, a hopper, a block of iesnium, a crystal and two gold ingots on Strigeor's circle.\"}]",
    "",
    "Set mineshafts, battlefields or worker spirits on top and a chest below: a Djinni moves the results down, fast.",
    "",
    "When the chest is full, the extra is thrown away."
  ],
  "quest.54C1268D341BB5CA.title": "The Eldritch Ancient Miner",
  "quest.54C1268D341BB5CA.quest_subtitle": "It stares back.",
  "quest.54C1268D341BB5CA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight Master Miner Marids fold into one that hauls whole storage blocks.\"}]",
    "",
    "[\"\",{\"text\":\"Pressed on Ronaza's Contact, started with a \"},{\"text\":\"Mining Dimension Core Piece\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:mining_dim_core\",\"count\":1}}},{\"text\":\" and paid with a human sacrifice.\"}]",
    "",
    "It skips stone and ore alike and hauls storage blocks:",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Raw ore\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Diamond\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"More\"}]",
    "{@pagebreak}",
    "Core pieces turn up, very rarely, in a Marid's haul."
  ],
  "quest.5606D86189A9DD0B.title": "Iesnium for the common store",
  "quest.5606D86189A9DD0B.quest_subtitle": "Everyone needs a pickaxe eventually.",
  "quest.5606D86189A9DD0B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight \"},{\"text\":\"Iesnium Ingots\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:iesnium_ingot\",\"count\":1}}},{\"text\":\" for the common store, once a day.\"}]",
    "",
    "Every miner's ritual eats a pickaxe made of it, and a Master Miner Marid digs the ore for you."
  ],
  "quest.212D8FE4CBAB4DA8.title": "The Dimensional Storage Actuator",
  "quest.212D8FE4CBAB4DA8.quest_subtitle": "One chest, a dimension deep.",
  "quest.212D8FE4CBAB4DA8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Your storage lives in a pocket dimension, and this block is its door.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Djinni binds three quartz blocks and an ender pearl into a \"},{\"text\":\"Dimensional Crystal Matrix\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:dimensional_matrix\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Foliot binds a pedestal, two copper and a gold ingot into a \"},{\"text\":\"Storage Actuator Base\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:storage_controller_base\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Matrix over base crafts the actuator: \"},{\"text\":\"128\",\"color\":\"#CE8BFF\"},{\"text\":\" item types, \"},{\"text\":\"256,000\",\"color\":\"#CE8BFF\"},{\"text\":\" items.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Break it and everything stays inside, like a shulker box.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Damaged or enchanted variants take one type each.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"To other mods it's just a very large chest.\"}]"
  ],
  "quest.4AAF6194A6D896F8.title": "Stabilizer, tier 1",
  "quest.4AAF6194A6D896F8.quest_subtitle": "Room to breathe.",
  "quest.4AAF6194A6D896F8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Tier \"},{\"text\":\"1\",\"color\":\"#CE8BFF\"},{\"text\":\" buys \"},{\"text\":\"64\",\"color\":\"#CE8BFF\"},{\"text\":\" more types and \"},{\"text\":\"512,000\",\"color\":\"#CE8BFF\"},{\"text\":\" more items.\"}]",
    "",
    "[\"\",{\"text\":\"A pedestal crafts into a stabilizer base; a Foliot infusion with a copper block, blaze powder and a gem makes the tier \"},{\"text\":\"1\",\"color\":\"#CE8BFF\"},{\"text\":\" stabilizer.\"}]",
    "",
    "Aim it at the matrix, one block above the actuator, from up to five blocks away in a straight line."
  ],
  "quest.08A131AC6CE8A3DD.title": "Stabilizer, tier 2",
  "quest.08A131AC6CE8A3DD.quest_subtitle": "Room for the hoard.",
  "quest.08A131AC6CE8A3DD.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Tier \"},{\"text\":\"2\",\"color\":\"#CE8BFF\"},{\"text\":\" buys \"},{\"text\":\"128\",\"color\":\"#CE8BFF\"},{\"text\":\" more types and \"},{\"text\":\"1,024,000\",\"color\":\"#CE8BFF\"},{\"text\":\" more items.\"}]",
    "",
    "[\"\",{\"text\":\"Tier \"},{\"text\":\"1\",\"color\":\"#CE8BFF\"},{\"text\":\", a silver block, a ghast tear and two gems on Strigeor's circle.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Breaking a stabilizer to upgrade it loses nothing; new items just wait until there's room again.\"}]"
  ],
  "quest.3BEE431FEB920864.title": "Stabilizer, tier 3",
  "quest.3BEE431FEB920864.quest_subtitle": "Room for your regrets.",
  "quest.3BEE431FEB920864.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Tier \"},{\"text\":\"3\",\"color\":\"#CE8BFF\"},{\"text\":\" buys \"},{\"text\":\"256\",\"color\":\"#CE8BFF\"},{\"text\":\" more types and \"},{\"text\":\"2,048,000\",\"color\":\"#CE8BFF\"},{\"text\":\" more items.\"}]",
    "",
    "[\"\",{\"text\":\"Tier \"},{\"text\":\"2\",\"color\":\"#CE8BFF\"},{\"text\":\", a gold block, a Totem of Undying, a crystal and Afrit Essence on Sevira's circle.\"}]"
  ],
  "quest.1205B49603EF0C40.title": "Stabilizer, tier 4",
  "quest.1205B49603EF0C40.quest_subtitle": "Room for everything else.",
  "quest.1205B49603EF0C40.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Tier \"},{\"text\":\"4\",\"color\":\"#CE8BFF\"},{\"text\":\" buys \"},{\"text\":\"512\",\"color\":\"#CE8BFF\"},{\"text\":\" more types and \"},{\"text\":\"4,096,000\",\"color\":\"#CE8BFF\"},{\"text\":\" more items.\"}]",
    "",
    "[\"\",{\"text\":\"Tier \"},{\"text\":\"3\",\"color\":\"#CE8BFF\"},{\"text\":\", a block of iesnium, a beacon, two crystals and Marid Essence on Uphyxes Inverted Tower.\"}]"
  ],
  "quest.2CB1AAE292F36D40.title": "A second door",
  "quest.2CB1AAE292F36D40.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A second door to the same storage.\"}]",
    "",
    "[\"\",{\"text\":\"An Otherstone frame, an ender pearl, two quartz and two gold ingots on the Foliot infusion make a \"},{\"text\":\"Stable Wormhole\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:stable_wormhole\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Sneak-use it on the actuator, then place it anywhere: as long as the actuator's chunk stays loaded, it opens the same storage."
  ],
  "quest.4EF9BE143EF7E3EF.title": "The Storage Accessor",
  "quest.4EF9BE143EF7E3EF.quest_subtitle": "The whole vault, one keypress away.",
  "quest.4EF9BE143EF7E3EF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Open your storage from anywhere, other dimensions included.\"}]",
    "",
    "An inert accessor (iesnium nuggets, silver, a gem and an Otherworldly Tablet) with two ender pearls and quartz on Strigeor's circle.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Sneak-use it on the actuator.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Then \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.occultism.storage_remote\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" opens it.\"}]"
  ],
  "quest.3FA223CC01603AE4.title": "The Djinni Machine Operator",
  "quest.3FA223CC01603AE4.quest_subtitle": "On-demand crafting, with attitude.",
  "quest.3FA223CC01603AE4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A coal block, gold, iron and a furnace on Ophyx' Calling.\"}]",
    "",
    "[\"\",{\"text\":\"Link its \"},{\"text\":\"Book of Calling\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:book_of_calling_djinni_manage_machine\",\"count\":1}}},{\"text\":\" to the actuator and a machine: it feeds the machine what you order from the actuator's screen and returns the results to storage.\"}]",
    "",
    "It can also empty a chest into the actuator."
  ],
  "quest.3E8D875D9D616EAE.title": "Bigger on the inside",
  "quest.3E8D875D9D616EAE.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A satchel you open without taking it out.\"}]",
    "",
    "[\"\",{\"text\":\"A chest, two leather, string and silver on the Foliot infusion: the spirit bends the \"},{\"text\":\"Surprisingly Substantial Satchel\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:satchel\",\"count\":1}}},{\"text\":\" so it holds more than its size suggests.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.occultism.backpack\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" opens it from your belt slot or your inventory.\"}]"
  ],
  "quest.7E54EA93E09A8A97.title": "The Ender Satchel",
  "quest.7E54EA93E09A8A97.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"An ender chest, leather, string, silver and gold on Strigeor's circle: your ender chest, carried.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.occultism.ender_bag\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" opens it; sneak-right-click binds it to you, so a friend holding it reaches your ender chest.\"}]"
  ],
  "quest.59DC9600D63225DB.title": "Pull with spirits, not pipes",
  "quest.59DC9600D63225DB.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Pushing items into the actuator is cheap at any rate. Pulling is what costs: a filtered pipe searches the whole storage item by item. A Transporter spirit, even one that drops into a chest right beside it, is far lighter, and so is Theurgy's extractor with a list filter.\"}]"
  ],
  "task.042DE88B7A10B52B.title": "Summon a familiar",
  "quest.43B08A1E3138F0D9.title": "Familiars",
  "quest.43B08A1E3138F0D9.quest_subtitle": "A pet with a résumé.",
  "quest.43B08A1E3138F0D9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Possession pentacles can also call a spirit into an animal body that follows you and helps.\"}]",
    "",
    "[\"\",{\"text\":\"Start the ritual by hand, since a hopper-fed ritual brings familiars out untamed, and heal them with \"},{\"text\":\"Demon's Dream Fruit\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:datura\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "Two cheap first picks on Hedyrin's Lure:",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Greedy Familiar (a chest, an iron block, a dispenser, a hopper and a zombie) picks up items for you\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Deer Familiar (sticks, string and a cow) gives speed, jump boost and step assist\"}]"
  ],
  "task.6473F6B7B71FDC48.title": "Summon a Blacksmith Familiar",
  "task.203CC1D20734EA2E.title": "Summon a Beaver Familiar",
  "quest.4A0440E2A68B91C9.title": "The blacksmith and the beaver",
  "quest.4A0440E2A68B91C9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two familiars: one mends your gear, one fells trees.\"}]",
    "",
    "Iron tools, an anvil and stone with a zombie: the Blacksmith Familiar mends your gear a little whenever you pick up stone and, fed iron, upgrades your other familiars.",
    "",
    "Logs and a pig give a Beaver Familiar, which fells the small trees that grow near it."
  ],
  "task.4A7335EC8BEAD1AE.title": "Summon a Bat Familiar",
  "task.2489EA46485ECC38.title": "Summon a Drikwing",
  "task.0BB8D6EBAB92869B.title": "Summon a Devil Familiar",
  "quest.1C8520A590AF5DEF.title": "Djinni companions",
  "quest.1C8520A590AF5DEF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Ihagan's Enthrallment gives stronger familiars.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Bat (a bat as the sacrifice) grants night vision.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Drikwing (a parrot) multi-jump, jump boost and slow falling.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Devil (a horse) fire resistance, and it breathes fire at your enemies.\"}]"
  ],
  "task.0446177A4F9E246A.title": "Summon a Fairy Familiar",
  "task.3FED09DF6A225976.title": "Summon a Mummy Familiar",
  "task.4C3441C52A55FEFA.title": "Summon a Beholder Familiar",
  "quest.37F92F1083517311.title": "Guards, lasers and a fairy",
  "quest.37F92F1083517311.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three familiars that fight for you.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Fairy (golden apples, a ghast tear, gunpowder and milk, and a horse) keeps your other familiars from dying and drains enemies.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Mummy (slime, paper and wool, and a llama) fights and grants Dodge.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Beholder (spider eyes and glowstone, and a spider) outlines nearby mobs and fires lasers.\"}]"
  ],
  "task.69F3EFB58967D6FB.title": "Summon a Chimera Familiar",
  "task.15CE8D4AAD925E47.title": "Split the goat off",
  "task.6C0E0A2B66FF9A79.title": "Call Shub Niggurath",
  "quest.26A5FBDCDCD9460C.title": "The goat that got away",
  "quest.26A5FBDCDCD9460C.quest_subtitle": "Some assembly required. And disassembly.",
  "quest.26A5FBDCDCD9460C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A goat that grows into a mount, if you keep feeding it meat.\"}]",
    "",
    "A Chimera Familiar (leather, string, feathers, wool, a bone and four raw meats, and a sheep) grows as you feed it meat until you can ride it.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A golden apple splits its goat off.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Take the goat to a forest and use black dye, flint and an eye of ender on it.\"}]"
  ],
  "quest.14809600791FA54B.title": "Soul gems",
  "quest.14809600791FA54B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Foliot binds an egg, an iron ingot and glass into a Fragile Soul Gem that carries one creature, then breaks.\"}]",
    "",
    "[\"\",{\"text\":\"A Djinni binds a diamond, copper, silver and gold, the fragile gem and soul sand into a \"},{\"text\":\"Soul Gem\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:soul_gem\",\"count\":1}}},{\"text\":\" that lasts.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Right-click to capture, again to release.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Bosses refuse.\"}]"
  ],
  "quest.7D62DC89A1D57289.title": "The Familiar Ring",
  "quest.7D62DC89A1D57289.quest_subtitle": "Pocket-sized loyalty.",
  "quest.7D62DC89A1D57289.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Soul Gem, two gold and two silver on Strigeor's circle.\"}]",
    "",
    "Right-click your tamed familiar with the ring to capture it, then wear the ring as a curio: the effect stays, the animal doesn't tag along.",
    "",
    "Whoever releases it becomes its master, so familiars can change hands.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Each familiar's ring effect has its own on-off key, \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.occultism.familiar.greedy_familiar\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" for the Greedy one. They come unbound: set the ones you use in Controls, under Occultism.\"}]"
  ],
  "quest.5CEE9965BE070ED8.title": "The Dimensional Battlefield",
  "quest.5CEE9965BE070ED8.quest_subtitle": "A mob farm with no mobs in your yard.",
  "quest.5CEE9965BE070ED8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Sevira's circle with Otherstone, a netherite ingot, a block of iesnium, a crystal and Afrit Essence.\"}]",
    "",
    "Load a creature in a soul gem, a weapon for the Afrit and spiritual fuel such as Demon's Dream: it clones the creature and kills it for loot, as long as the fuel is worth the creature's health.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Looting adds drops.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"Sharpness, or better Smite and its kin where they apply, speeds it up.\"}]",
    "",
    "[\"\",{\"text\":\"A \"},{\"text\":\"Trinity Gem\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:trinity_gem\",\"count\":1}}},{\"text\":\", forged by Eldritch spirits, even takes possessed mobs and bosses, and triples ordinary loot.\"}]"
  ],
  "task.6F06B2637D3D7A1F.title": "Summon a Guardian Familiar",
  "quest.7FBCCDC83270F980.title": "The Guardian Familiar",
  "quest.7FBCCDC83270F980.quest_subtitle": "Every limb a second chance.",
  "quest.7FBCCDC83270F980.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Posuc's Convocation with four diamonds, two golden apples and a human sacrifice.\"}]",
    "",
    "Each time you are about to die, the Guardian gives up a limb instead, until it has none left.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"It arrives with a random number of limbs.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#CE8BFF\"},{\"text\":\"A Blacksmith upgrade grows one back.\"}]"
  ],
  "task.5E295305574DE562.title": "Call an Iesnium Golem",
  "quest.74E0184C21382D21.title": "The Iesnium Golem",
  "quest.74E0184C21382D21.quest_subtitle": "Unbreakable, unbribable.",
  "quest.74E0184C21382D21.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A far stronger golem that can't be hurt.\"}]",
    "",
    "Xeovrenth Adjure with three blocks of iesnium, Marid Essence, a crystal, a Nether Star and a Soul Gem, and an iron golem as the sacrifice.",
    "",
    "Only a player who sneaks and hits it dismisses it, back into a Fragile Soul Gem."
  ],
  "task.298E6EB7112BFEBD.title": "Resurrect a familiar",
  "quest.1733BF26B7326E96.title": "Susje's Simple Circle",
  "quest.1733BF26B7326E96.quest_subtitle": "Death is more of a setback.",
  "quest.1733BF26B7326E96.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A familiar that dies leaves a \"},{\"text\":\"Soul Shard\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:soul_shard\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Draw Susje's Simple Circle, sixteen colorless glyphs and nothing else, put four Otherworld Essence in the bowls and use the shard on the golden bowl: the familiar builds itself a new body."
  ],
  "quest.4BB1C919B907C365.title": "The Entity Wormhole",
  "quest.4BB1C919B907C365.quest_subtitle": "Step in here, step out there.",
  "quest.4BB1C919B907C365.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"An Otherstone frame, an ender pearl, crying obsidian and an iesnium ingot on Strigeor's circle.\"}]",
    "",
    "Right-click a compass into it to set the exit: a plain one leads to world spawn, a lodestone compass to its lodestone, a recovery compass to your last death.",
    "{@pagebreak}",
    "A compass renamed HOME leads to your own spawn point, one renamed RTP somewhere random.",
    "",
    "[\"\",{\"text\":\"A \"},{\"text\":\"Vitality Compass\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:vitality_compass\",\"count\":1}}},{\"text\":\" bound to a creature leads to it, and a fishing rod cast into the portal reels the creature in.\"}]"
  ],
  "task.158EAF9001B5A2F9.title": "Watch your deer familiar",
  "quest.7F213A8DE4D95C01.title": "Demonic fertilizer",
  "quest.7F213A8DE4D95C01.quest_subtitle": "Fertilizer with a pedigree.",
  "quest.7F213A8DE4D95C01.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Your Deer Familiar pooped out a \"},{\"text\":\"Demon's Dream Seed\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:datura_seeds\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Free seeds are free seeds; nobody needs to know where they came from."
  ],
  "reward.0083B6B1F7541FFD.title": "Secret found",
  "quest.73A4E27CDA77DEB2.title": "Till death, and past it",
  "quest.73A4E27CDA77DEB2.quest_subtitle": "A contract with a very long term.",
  "quest.73A4E27CDA77DEB2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"You married a demon, and your gift of Cursed Honey came back as a \"},{\"text\":\"Sweet-Honey-Heart\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:sweet_honey_heart\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "The Demonic Partner fights beside you, cooks raw food on a right-click and makes potions last much longer. The bond is permanent: spirits take contracts seriously."
  ],
  "reward.003AB4C491F4D566.title": "Secret found",
  "task.770E45317E604381.title": "Purify a vex",
  "quest.71C12374CBE5A56E.title": "Redeemed",
  "quest.71C12374CBE5A56E.quest_subtitle": "Vex no more.",
  "quest.71C12374CBE5A56E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"You purified a Vex into an Allay.\"}]",
    "",
    "Susje's circle, a sugar used as the key, redstone, glowstone, silver and gold dusts in the bowls and a Vex as the sacrifice. Its true name turned out nicer than its manners."
  ],
  "reward.517263F50D9AA598.title": "Secret found",
  "quest.7983A45463227146.title": "Space, folded",
  "quest.7983A45463227146.quest_subtitle": "The stabilizers went somewhere. Don't ask where.",
  "quest.7983A45463227146.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Ronaza's Contact forges tier \"},{\"text\":\"5\",\"color\":\"#CE8BFF\"},{\"text\":\" stabilizers, \"},{\"text\":\"1,024\",\"color\":\"#CE8BFF\"},{\"text\":\" types and \"},{\"text\":\"8,192,000\",\"color\":\"#CE8BFF\"},{\"text\":\" items each.\"}]",
    "",
    "[\"\",{\"text\":\"Six of them, your actuator, two echo dusts and a \"},{\"text\":\"Calibrated Sculk Sensor\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:calibrated_sculk_sensor\",\"count\":1}}},{\"text\":\", paid with a shulker, fold every stabilizer into the block: the equal of eight tier 5s, contents kept.\"}]",
    "{@pagebreak}",
    "External stabilizers add nothing to it anymore. The house is full of spirits, and every one of them has a job."
  ],
  "quest.5794C4D2DD18FD18.title": "Hang the lantern",
  "quest.5794C4D2DD18FD18.quest_subtitle": "Even spirits ask for a light on.",
  "quest.5794C4D2DD18FD18.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"One lantern, four workstations, no overtime.\"}]",
    "",
    "No reward: just light."
  ],
  "image.475153F040C7A9D1.title": "Back to Occultism · Rituals",
  "image.7F1474AF404B4404.title": "[\"\",{\"text\":\"OCCULTISM\",\"color\":\"#F3EEDF\",\"bold\":true}]",
  "image.0DCBAB7A31A57E91.title": "[\"\",{\"text\":\"Spirits and storage\",\"color\":\"#B9A7E0\"}]",
  "image.44A7A22A40C0C1C9.title": "[\"\",{\"text\":\"every job a spirit\",\"color\":\"#8F7FBF\",\"font\":\"minecraft:alt\"}]",
  "image.3E088984AC2584A1.title": "A Foliot at its post",
  "image.4E610759AB5B2E25.title": "A Djinni at its post",
  "image.128C4FDA72F302E1.title": "An Afrit at its post",
  "image.4E6527B0BC9255EE.title": "A Marid at its post",
  "image.74A850D8441071A3.title": "[\"\",{\"text\":\"Workers\",\"color\":\"#B9A7E0\"}]",
  "image.7DC05195FCEAFF37.title": "[\"\",{\"text\":\"Miners\",\"color\":\"#B9A7E0\"}]",
  "image.7CF5114EA9B9C9F7.title": "[\"\",{\"text\":\"Storage\",\"color\":\"#B9A7E0\"}]",
  "image.27C5EC6BB82BF9AE.title": "[\"\",{\"text\":\"Familiars\",\"color\":\"#B9A7E0\"}]",
  "image.213670ED23BEF517.title": "[\"\",{\"text\":\"Tools\",\"color\":\"#B9A7E0\"}]",
  "chapter.2EA4C2D78A033797.title": "Psi",
  "chapter.2EA4C2D78A033797.chapter_subtitle": [
    "The CAD and its parts, the Spell Programmer, bullets, psimetal and psigems, the Exosuit, Ebony and Ivory."
  ],
  "quest.7D362F3E6640B2DF.title": "CAD Assembler",
  "quest.7D362F3E6640B2DF.quest_subtitle": "Some assembly required.",
  "quest.7D362F3E6640B2DF.quest_desc": [
    "[\"\",{\"text\":\"Five iron, a piston and a \"},{\"text\":\"Power Regulator\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:power_regulator\",\"count\":1}}},{\"text\":\": the pack puts Psi in Act III. The \"},{\"text\":\"CAD Assembler\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:cad_assembler\",\"count\":1}}},{\"text\":\" builds a CAD from its parts and loads Spell Bullets into it, and into psimetal tools and armor.\"}]",
    "",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The regulator is the same one the Atlas asks for in \"},{\"text\":\"Power without a Monolith\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"55E5576006404510\"}},{\"text\":\".\"}]"
  ],
  "quest.24BA6CEFF3600962.title": "Psidust",
  "quest.24BA6CEFF3600962.quest_subtitle": "Redstone, but spicier.",
  "quest.24BA6CEFF3600962.quest_desc": [
    "[\"\",{\"text\":\"An \"},{\"text\":\"Iron CAD Assembly\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:cad_assembly_iron\",\"count\":1}}},{\"text\":\" (four iron) alone in the Assembler makes a bare \"},{\"text\":\"CAD\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:cad\",\"count\":1}}},{\"text\":\". It can't cast yet, but drop redstone next to you and use it: every stack within 8 blocks turns into \"},{\"text\":\"Psidust\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:psidust\",\"count\":1}}},{\"text\":\" at once.\"}]",
    "",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Later, any CAD does the same with an empty bullet slot selected.\"}]"
  ],
  "quest.377B938ABA847AB6.title": "Core and Socket",
  "quest.377B938ABA847AB6.quest_subtitle": "A brain and a clip.",
  "quest.377B938ABA847AB6.quest_desc": [
    "[\"\",{\"text\":\"A CAD that casts also needs a \"},{\"text\":\"Basic CAD Core\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:cad_core_basic\",\"count\":1}}},{\"text\":\" (four iron around psidust: one trick per spell) and a \"},{\"text\":\"Basic CAD Socket\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:cad_socket_basic\",\"count\":1}}},{\"text\":\" (two iron and psidust: four bullets, spells up to 5×5). Add both to your Assembly at the Assembler.\"}]",
    "",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A bare CAD alone in a crafting grid gives its Assembly back.\"}]"
  ],
  "quest.336C46A2C862033C.title": "Spell Programmer",
  "quest.336C46A2C862033C.quest_subtitle": "Five iron, one psidust, infinite bugs.",
  "quest.336C46A2C862033C.quest_desc": [
    "Five iron and a psidust. Right-click a cell and type to find a piece: tricks act on the world, selectors fetch things (you, a mob, a spot), operators turn values into others and constants hold numbers. Left-click a piece and set its arrows to take inputs from its neighbors.",
    "{@pagebreak}",
    "When the X in the corner turns into a check mark, the spell compiles; hover the X to read what is wrong. It also needs a name.",
    "",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"First spell: \"},{\"text\":\"Selector: Caster\",\"color\":\"#7FDBFF\"},{\"text\":\" next to \"},{\"text\":\"Trick: Debug\",\"color\":\"#7FDBFF\"},{\"text\":\", its Target arrow pointing at the caster. Cast it and your coordinates show up in chat.\"}]"
  ],
  "quest.349FE8F901DFB239.title": "Load and cast",
  "quest.349FE8F901DFB239.quest_subtitle": "Bang, but polite.",
  "quest.349FE8F901DFB239.quest_desc": [
    "[\"\",{\"text\":\"A \"},{\"text\":\"Spell Bullet\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:spell_bullet\",\"count\":1}}},{\"text\":\" is one iron and one psidust. Use it on the Programmer to copy the spell, load it into your CAD at the Assembler, hold \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"psimisc.keybind\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" to pick it on the wheel and use the CAD to cast.\"}]",
    "",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Changed the spell? \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and use the CAD on the Programmer: the selected bullet updates in place.\"}]"
  ],
  "quest.66787E7A0B61BE71.title": "Psimetal",
  "quest.66787E7A0B61BE71.quest_subtitle": "Alchemy, compiled.",
  "quest.66787E7A0B61BE71.quest_desc": [
    "[\"\",{\"text\":\"A one-piece spell, \"},{\"text\":\"Trick: Infusion\",\"color\":\"#7FDBFF\"},{\"text\":\", turns the gold ingots dropped within 8 blocks of you into \"},{\"text\":\"Psimetal Ingots\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:psimetal\",\"count\":1}}},{\"text\":\", whole stacks per cast. It asks for 100 Potency, exactly an Iron Assembly's; at its 70% efficiency each cast costs about 1,700 of your 5,000 Psi.\"}]",
    "{@pagebreak}",
    "Psimetal makes the better cores, sockets and batteries, the Psimetal Assembly, Spell Drives, tools and armor.",
    "",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Infusion also turns redstone into psidust, so one cast can do both.\"}]"
  ],
  "task.1798720001F2FAE1.title": "A psimetal core",
  "task.7AA71BFFE82016B5.title": "A psimetal socket",
  "quest.2BAA9AA5501D9B58.title": "A second CAD",
  "quest.2BAA9AA5501D9B58.quest_subtitle": "Same frame, more brain.",
  "quest.2BAA9AA5501D9B58.quest_desc": [
    "[\"\",{\"text\":\"Four psimetal make a \"},{\"text\":\"Psimetal CAD Assembly\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:cad_assembly_psimetal\",\"count\":1}}},{\"text\":\": Potency 250 at 85% efficiency. With psimetal around the dust, redstone makes the \"},{\"text\":\"Overclocked Core\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:cad_core_overclocked\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Signaling Socket\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:cad_socket_signaling\",\"count\":1}}},{\"text\":\", glowstone the \"},{\"text\":\"Conductive Core\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:cad_core_conductive\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Large Socket\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:cad_socket_large\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "Overclocked: Complexity 24, three tricks per spell. Conductive: Complexity 20, four tricks. Signaling: six bullets, spells up to 7×7. Large: eight bullets, up to 6×6."
  ],
  "quest.6089239E241C601C.title": "Psigems",
  "quest.6089239E241C601C.quest_subtitle": "Diamonds, but with opinions.",
  "quest.6089239E241C601C.quest_desc": [
    "[\"\",{\"text\":\"Trick: Greater Infusion\",\"color\":\"#7FDBFF\"},{\"text\":\" turns dropped diamonds into \"},{\"text\":\"Psigems\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:psigem\",\"count\":1}}},{\"text\":\". It needs 250 Potency, so a Psimetal Assembly or better, and costs about 3,000 Psi with one. Psigems go into the top cores, sockets and battery, the tools and the Exosuit.\"}]",
    "",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"It also infuses redstone and gold, like the plain Infusion.\"}]"
  ],
  "task.4D0F2F519325C9E8.title": "Eight ebony or ivory substance",
  "quest.4E1D12B86BB751F6.title": "Ebony and Ivory",
  "quest.4E1D12B86BB751F6.quest_subtitle": "The End thinks louder.",
  "quest.4E1D12B86BB751F6.quest_desc": [
    "[\"\",{\"text\":\"Only in the End: \"},{\"text\":\"Trick: Ebony & Ivory\",\"color\":\"#7FDBFF\"},{\"text\":\" (Potency 250) turns dropped coal into \"},{\"text\":\"Ebony Substance\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:ebony_substance\",\"count\":1}}},{\"text\":\" and nether quartz into \"},{\"text\":\"Ivory Substance\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:ivory_substance\",\"count\":1}}},{\"text\":\". Eight of one substance around a psimetal ingot coat it into \"},{\"text\":\"Ebony\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:ebony_psimetal\",\"count\":1}}},{\"text\":\" or \"},{\"text\":\"Ivory Psimetal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:ivory_psimetal\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "The campaign takes you to the End in Act V. In there, the same trick also does the other infusions: redstone, gold and diamonds."
  ],
  "task.23C2876AB4A7DA26.title": "An ebony or ivory assembly",
  "quest.79ED830E2AC5711B.title": "The last Assembly",
  "quest.79ED830E2AC5711B.quest_subtitle": "Pick a side. Or both, if you're greedy.",
  "quest.79ED830E2AC5711B.quest_desc": [
    "[\"\",{\"text\":\"Four coated ingots make the top Assemblies. \"},{\"text\":\"Ebony\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:cad_assembly_ebony_psimetal\",\"count\":1}}},{\"text\":\" takes 350 Potency at 90% efficiency, \"},{\"text\":\"Ivory\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:cad_assembly_ivory_psimetal\",\"count\":1}}},{\"text\":\" 320 at 95%. Ebony for big tricks, Ivory for cheap casting.\"}]"
  ],
  "task.77A7BDA85467DAF5.title": "A psimetal tool",
  "quest.51AA960E129CC4FD.title": "Tools that cast",
  "quest.51AA960E129CC4FD.quest_subtitle": "Mine a block, cast a spell, repeat.",
  "quest.51AA960E129CC4FD.quest_desc": [
    "[\"\",{\"text\":\"A psigem, psimetal and iron where the sticks go: diamond-grade tools that hold three bullets. The pickaxe, shovel and axe cast on every block they break, the sword on every hit; pick the spell with \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"psimisc.keybind\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\". Spare Psi repairs them.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Selector: Block Broken\",\"color\":\"#7FDBFF\"},{\"text\":\" and \"},{\"text\":\"Selector: Block Broken Side\",\"color\":\"#7FDBFF\"},{\"text\":\" tell the spell where the tool struck; the sword fills \"},{\"text\":\"Selector: Attack Target\",\"color\":\"#7FDBFF\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Loopcast and Circle bullets only fit a CAD.\",\"color\":\"#FF8C7A\"}]"
  ],
  "quest.52A72E20AF458775.title": "Psimetal Exosuit",
  "quest.52A72E20AF458775.quest_subtitle": "Armor with reflexes.",
  "quest.52A72E20AF458775.quest_desc": [
    "Eight psigems and sixteen psimetal for four pieces, each holding three bullets and casting within your CAD's limits. The helmet fires on its sensor, the chestplate when you get hurt, the leggings every tick, the boots when you jump. A bit better than iron, and spare Psi repairs it."
  ],
  "task.6BE328CA6B1392C6.title": "A psigem core",
  "task.674802ED434A39E5.title": "A psigem socket",
  "quest.7E7538E140C58749.title": "Psigem Core and Socket",
  "quest.7E7538E140C58749.quest_subtitle": "The whole grid in one bullet.",
  "quest.7E7538E140C58749.quest_desc": [
    "[\"\",{\"text\":\"Two psigems in a core: the \"},{\"text\":\"Hyperclocked Core\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:cad_core_hyperclocked\",\"count\":1}}},{\"text\":\" (redstone) reaches Complexity 36 with six tricks, the \"},{\"text\":\"Radiative Core\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:cad_core_radiative\",\"count\":1}}},{\"text\":\" (glowstone) 30 with seven. One psigem in a socket: \"},{\"text\":\"Transmissive\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:cad_socket_transmissive\",\"count\":1}}},{\"text\":\" holds ten bullets and the whole 9×9 grid, \"},{\"text\":\"Huge\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:cad_socket_huge\",\"count\":1}}},{\"text\":\" twelve at 8×8.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Native recipes: the Power Regulator in the Assembler is the pack's only Psi gate.\",\"color\":\"#9BE08A\"}]"
  ],
  "quest.7B2642782F246FD0.title": "Flash Ring",
  "quest.7B2642782F246FD0.quest_subtitle": "A spell on your finger.",
  "quest.7B2642782F246FD0.quest_desc": [
    "[\"\",{\"text\":\"Three \"},{\"text\":\"Ebony Psimetal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:ebony_psimetal\",\"count\":1}}},{\"text\":\" around glowstone, over a psigem. \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and use the \"},{\"text\":\"Flash Ring\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:flash_ring\",\"count\":1}}},{\"text\":\" to write its spell right there, no Programmer; use it to cast through the CAD you carry. It costs double, and your Psi pauses five seconds before refilling instead of two.\"}]",
    "{@pagebreak}",
    "Terra's notes stop at a ring drawn in the margin: a spell small enough to keep on a finger, ready before the thought is finished."
  ],
  "quest.1126A9C30C2631CD.title": "Numbers and connectors",
  "quest.1126A9C30C2631CD.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Select a \"},{\"text\":\"Constant: Number\",\"color\":\"#7FDBFF\"},{\"text\":\" and type the value. Tricks that scale with a number want a constant, because cost is worked out before casting. A \"},{\"text\":\"Connector\",\"color\":\"#7FDBFF\"},{\"text\":\" passes any value one cell along, so an input can come from far away.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Constant: Wrapper\",\"color\":\"#7FDBFF\"},{\"text\":\" lets a live number drive a trick, capped by the constant you give it.\"}]"
  ],
  "quest.1A449BEF14F33074.title": "Five numbers",
  "quest.1A449BEF14F33074.quest_desc": [
    "[\"\",{\"text\":\"The stats beside the grid are the spell's bill. The Core caps \"},{\"text\":\"Complexity\",\"color\":\"#7FDBFF\"},{\"text\":\" (pieces) and \"},{\"text\":\"Projection\",\"color\":\"#7FDBFF\"},{\"text\":\" (tricks), the Assembly caps \"},{\"text\":\"Potency\",\"color\":\"#7FDBFF\"},{\"text\":\", the Socket caps \"},{\"text\":\"Bandwidth\",\"color\":\"#7FDBFF\"},{\"text\":\" (the spell's width or height). \"},{\"text\":\"Cost\",\"color\":\"#7FDBFF\"},{\"text\":\" comes out of your 5,000 Psi, which refills at 500 a second.\"}]",
    "{@pagebreak}",
    "No trick reaches more than 32 blocks from its focal point, which for a plain bullet is you; past that the spell fizzles with an error. Efficiency is the Assembly's tax: the number in parentheses is what you really pay."
  ],
  "quest.49C120F578144C3E.title": "One CAD per mage",
  "quest.49C120F578144C3E.quest_subtitle": "Two radios, one frequency.",
  "quest.49C120F578144C3E.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Carry a single CAD. With two in your inventory they interfere and every cast fails; spares go in a chest.\"}]"
  ],
  "quest.16A3E9237D11E0DC.title": "Push, aim, boom",
  "quest.16A3E9237D11E0DC.quest_subtitle": "Preferably not at your own feet.",
  "quest.16A3E9237D11E0DC.quest_desc": [
    "[\"\",{\"text\":\"Trick: Add Motion\",\"color\":\"#7FDBFF\"},{\"text\":\" pushes an entity along a vector: \"},{\"text\":\"Selector: Caster\",\"color\":\"#7FDBFF\"},{\"text\":\" as the target, \"},{\"text\":\"Operator: Entity Look\",\"color\":\"#7FDBFF\"},{\"text\":\" as the direction and a constant as the speed. Aim \"},{\"text\":\"Trick: Explode\",\"color\":\"#7FDBFF\"},{\"text\":\" at \"},{\"text\":\"Operator: Vector Raycast\",\"color\":\"#7FDBFF\"},{\"text\":\" from your \"},{\"text\":\"Operator: Entity Position\",\"color\":\"#7FDBFF\"},{\"text\":\" along your look and it blows up what you aim at.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"An \"},{\"text\":\"Error Suppressor\",\"color\":\"#7FDBFF\"},{\"text\":\" anywhere on the grid makes a failed cast stay quiet instead of spamming chat. Leave it out while you debug.\"}]"
  ],
  "quest.682340AC544FC920.title": "The rest of the toolbox",
  "quest.682340AC544FC920.quest_subtitle": "175 pieces. You'll use twelve.",
  "quest.682340AC544FC920.quest_desc": [
    "[\"\",{\"text\":\"Elements: \"},{\"text\":\"Trick: Smite\",\"color\":\"#7FDBFF\"},{\"text\":\" calls lightning, \"},{\"text\":\"Torrent\",\"color\":\"#7FDBFF\"},{\"text\":\" makes water, \"},{\"text\":\"Blaze\",\"color\":\"#7FDBFF\"},{\"text\":\" makes fire, \"},{\"text\":\"Overgrow\",\"color\":\"#7FDBFF\"},{\"text\":\" fertilizes. Effects: Speed, Haste, Strength, Regeneration and more, Time in seconds and Power as the level. \"},{\"text\":\"Smelt Item\",\"color\":\"#7FDBFF\"},{\"text\":\" and \"},{\"text\":\"Smelt Block\",\"color\":\"#7FDBFF\"},{\"text\":\" cook in place; \"},{\"text\":\"Blink\",\"color\":\"#7FDBFF\"},{\"text\":\" and the Mass tricks move crowds.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Switch Focus Slot\",\"color\":\"#7FDBFF\"},{\"text\":\" picks the hotbar slot that Place Block uses; \"},{\"text\":\"Item Presence\",\"color\":\"#7FDBFF\"},{\"text\":\" and \"},{\"text\":\"Block Presence\",\"color\":\"#7FDBFF\"},{\"text\":\" check before acting. \"},{\"text\":\"Nearby Enemies\",\"color\":\"#7FDBFF\"},{\"text\":\" and \"},{\"text\":\"Closest to Point\",\"color\":\"#7FDBFF\"},{\"text\":\" find targets. \"},{\"text\":\"Broadcast\",\"color\":\"#7FDBFF\"},{\"text\":\" sends a number to nearby CADs. The math covers trigonometry, powers, rounding and lists.\"}]",
    "",
    "[\"\",{\"text\":\"Bosses are immune: the spell reports it and stops.\",\"color\":\"#FF8C7A\"}]"
  ],
  "task.466E7F2A0E60E23F.title": "Look at a block you conjured",
  "quest.52BB73C4B3D35C79.title": "Conjured blocks",
  "quest.52BB73C4B3D35C79.quest_subtitle": "Scaffolding that cleans up after itself.",
  "quest.52BB73C4B3D35C79.quest_desc": [
    "[\"\",{\"text\":\"Trick: Conjure Block\",\"color\":\"#7FDBFF\"},{\"text\":\" builds a translucent block at a position, tinted by your colorizer; give it a Time in ticks and it goes away on its own. Aim it at your \"},{\"text\":\"Operator: Entity Position\",\"color\":\"#7FDBFF\"},{\"text\":\" plus your look times three and it floats in front of you. Any tool breaks it at once.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Its cousins: \"},{\"text\":\"Trick: Conjure Light\",\"color\":\"#7FDBFF\"},{\"text\":\", \"},{\"text\":\"Place Block\",\"color\":\"#7FDBFF\"},{\"text\":\" (with the item right of your CAD), \"},{\"text\":\"Break Block\",\"color\":\"#7FDBFF\"},{\"text\":\" (up to diamond-level blocks), \"},{\"text\":\"Move Block\",\"color\":\"#7FDBFF\"},{\"text\":\", \"},{\"text\":\"Collapse Block\",\"color\":\"#7FDBFF\"},{\"text\":\" and their Sequence versions. \"},{\"text\":\"Operator: Vector Axis Raycast\",\"color\":\"#7FDBFF\"},{\"text\":\" gives the face you are looking at.\"}]"
  ],
  "quest.617B2DD752135EC5.title": "Vector Ruler",
  "quest.617B2DD752135EC5.quest_subtitle": "Geometry homework, with explosions.",
  "quest.617B2DD752135EC5.quest_desc": [
    "[\"\",{\"text\":\"Psidust over two iron. \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and use it on a block to store that block's position; use it on another block to store the offset between them. \"},{\"text\":\"Selector: Ruler Vector\",\"color\":\"#7FDBFF\"},{\"text\":\" reads it, and the leftmost ruler in your hotbar wins.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"A vector is three numbers: x east, y up, z south. Add an offset to a position to aim anywhere; \"},{\"text\":\"Vector Sum\",\"color\":\"#7FDBFF\"},{\"text\":\", \"},{\"text\":\"Vector Multiply\",\"color\":\"#7FDBFF\"},{\"text\":\" and \"},{\"text\":\"Vector Normalize\",\"color\":\"#7FDBFF\"},{\"text\":\" do the rest, and \"},{\"text\":\"Vector Cross Product\",\"color\":\"#7FDBFF\"},{\"text\":\" of your look and straight up points to your side.\"}]"
  ],
  "quest.6F26C57331E4A8A7.title": "Eidos: rewind",
  "quest.6F26C57331E4A8A7.quest_subtitle": "An undo button for your whole body.",
  "quest.6F26C57331E4A8A7.quest_desc": [
    "[\"\",{\"text\":\"Trick: Eidos Reversal\",\"color\":\"#7FDBFF\"},{\"text\":\" walks you back along your own path at double speed for some seconds; sneaking stops it. \"},{\"text\":\"Trick: Eidos Anchor\",\"color\":\"#7FDBFF\"},{\"text\":\" marks where you stand and pulls you back there after some seconds. \"},{\"text\":\"Selector: Eidos Changelog\",\"color\":\"#7FDBFF\"},{\"text\":\" tells where you were some ticks ago.\"}]"
  ],
  "quest.4621F69AC863F5AC.title": "Spell Drive",
  "quest.4621F69AC863F5AC.quest_subtitle": "Version control, the magical kind.",
  "quest.4621F69AC863F5AC.quest_desc": [
    "[\"\",{\"text\":\"Two psimetal and a redstone. \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and use an empty \"},{\"text\":\"Spell Drive\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:spell_drive\",\"count\":1}}},{\"text\":\" on the Programmer to save its spell, a full one to load it back; the same on any other block wipes it. In a crafting grid a drive copies its spell onto an empty drive or bullet.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The Programmer's clipboard buttons export a spell as text and import one a friend sent you.\"}]"
  ],
  "quest.6333A50BBE661C42.title": "Order of operations",
  "quest.6333A50BBE661C42.quest_subtitle": "Left to right, top to bottom, once.",
  "quest.6333A50BBE661C42.quest_desc": [
    "[\"\",{\"text\":\"Tricks run left to right, then top to bottom; each piece works out its inputs first, once per cast, so one \"},{\"text\":\"Operator: Random\",\"color\":\"#7FDBFF\"},{\"text\":\" gives all its users the same number. \"},{\"text\":\"Trick: Sleep\",\"color\":\"#7FDBFF\"},{\"text\":\" waits some ticks before the rest runs, \"},{\"text\":\"Trick: Evaluate\",\"color\":\"#7FDBFF\"},{\"text\":\" fixes a value early and \"},{\"text\":\"Trick: Die\",\"color\":\"#7FDBFF\"},{\"text\":\" stops the spell when its number is between -1 and 1.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Selector: Sneak Status\",\"color\":\"#7FDBFF\"},{\"text\":\" is 0 while you sneak: feed it to \"},{\"text\":\"Trick: Die\",\"color\":\"#7FDBFF\"},{\"text\":\" and sneaking cancels the spell. \"},{\"text\":\"Trick: Save Vector\",\"color\":\"#7FDBFF\"},{\"text\":\" keeps a vector in the CAD's memory for later casts and \"},{\"text\":\"Selector: Saved Vector\",\"color\":\"#7FDBFF\"},{\"text\":\" reads it back; the Socket sets how many slots you get.\"}]"
  ],
  "quest.1E8264AB0191DD07.title": "Projectile Spell Bullet",
  "quest.1E8264AB0191DD07.quest_subtitle": "Point, click, arrive later.",
  "quest.1E8264AB0191DD07.quest_desc": [
    "[\"\",{\"text\":\"Add an arrow to the bullet recipe. The spell rides a fast shot and runs where it hits: the shot is the focal point, it flies for up to 30 seconds and over 200 blocks, and \"},{\"text\":\"Selector: Attack Target\",\"color\":\"#7FDBFF\"},{\"text\":\" is whatever it hit. Cost ×1.02.\"}]"
  ],
  "quest.64CB81826AF67315.title": "Grenade Spell Bullet",
  "quest.64CB81826AF67315.quest_subtitle": "Lob it over the wall.",
  "quest.64CB81826AF67315.quest_desc": [
    "Gunpowder instead of the arrow: the shot falls like a thrown item and runs its spell exactly three seconds later, wherever it ended up. It reaches behind walls and down holes a projectile can't. Cost ×1.05."
  ],
  "quest.3A8CD6310D4CC4E7.title": "Charges and the Detonator",
  "quest.3A8CD6310D4CC4E7.quest_subtitle": "Plant now, regret later.",
  "quest.3A8CD6310D4CC4E7.quest_desc": [
    "[\"\",{\"text\":\"Redstone makes a Charge Spell Bullet: a grenade that waits up to five minutes. The \"},{\"text\":\"Spell Detonator\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:detonator\",\"count\":1}}},{\"text\":\" (two iron, psidust and a button) sets off every charge you placed within 32 blocks at once, and so does \"},{\"text\":\"Trick: Detonate\",\"color\":\"#7FDBFF\"},{\"text\":\". Cost ×1.151.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"It also wakes the \"},{\"text\":\"Detonation Sensor\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0AC8874C46010C65\"}},{\"text\":\" of any helmet in range.\"}]"
  ],
  "quest.5869CA781A8485E5.title": "Mine Spell Bullet",
  "quest.5869CA781A8485E5.quest_subtitle": "Watch your step. Really.",
  "quest.5869CA781A8485E5.quest_desc": [
    "[\"\",{\"text\":\"A button makes a mine: it lies on the ground for up to five minutes, arms when something steps on it and fires when that something steps off. \"},{\"text\":\"Selector: Attack Target\",\"color\":\"#7FDBFF\"},{\"text\":\" is whoever stepped off last. Cost ×1.151.\"}]"
  ],
  "quest.3D1917291B69F01F.title": "Loopcast Spell Bullet",
  "quest.3D1917291B69F01F.quest_subtitle": "Again. Again. Again.",
  "quest.3D1917291B69F01F.quest_desc": [
    "[\"\",{\"text\":\"String makes a bullet that recasts four times a second while you hold the CAD, paying full cost each time, and your Psi keeps refilling after the first cast. \"},{\"text\":\"Selector: Loopcast Index\",\"color\":\"#7FDBFF\"},{\"text\":\" counts the runs: 1, 2, 3.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Running dry while loopcasting hurts more: a point of health for every 50 Psi short instead of 125.\",\"color\":\"#FF8C7A\"},{\"text\":\" It only fits a CAD.\"}]"
  ],
  "quest.2FEC15AADAB3C211.title": "Circle Spell Bullet",
  "quest.2FEC15AADAB3C211.quest_subtitle": "Twenty for the price of fifteen.",
  "quest.2FEC15AADAB3C211.quest_desc": [
    "[\"\",{\"text\":\"A snowball or slimeball makes a spell circle where you look, up to 32 blocks away, that runs the spell twenty times over five seconds. It charges ×15 up front, a quarter off per run. \"},{\"text\":\"Selector: Loopcast Index\",\"color\":\"#7FDBFF\"},{\"text\":\" goes from 1 to 20.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A \"},{\"text\":\"Trick: Sleep\",\"color\":\"#7FDBFF\"},{\"text\":\" timed to the runs still to come makes all twenty land at once. It only fits a CAD.\"}]"
  ],
  "quest.1CDA3E094DAB7DF5.title": "Upgrade a loaded bullet",
  "quest.1CDA3E094DAB7DF5.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A programmed plain bullet plus the extra ingredient in a crafting grid becomes the new type and keeps its spell. The multiplier on each type's tooltip scales the cost the Programmer shows.\"}]"
  ],
  "quest.54DEF7901B2771F7.title": "Dark and Bright Plates",
  "quest.54DEF7901B2771F7.quest_subtitle": "Ebony and ivory, for the walls.",
  "quest.54DEF7901B2771F7.quest_desc": [
    "[\"\",{\"text\":\"A psimetal ingot in four coal makes a \"},{\"text\":\"Dark Psimetal Plate\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:black_psimetal_plate\",\"count\":1}}},{\"text\":\"; in four quartz, a \"},{\"text\":\"Bright\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:white_psimetal_plate\",\"count\":1}}},{\"text\":\" one. Glowstone adds the lit Flow versions. Psidust, psimetal, psigems and the coated ingots also pack into blocks of nine.\"}]"
  ],
  "task.2C348754788A49BA.title": "Strong and Thick (ebony)",
  "task.573F7CA7BF476466.title": "Sleeker and Sexier (ivory)",
  "quest.5531CACD5D0FEDF2.title": "Both keys of the piano",
  "quest.5531CACD5D0FEDF2.quest_subtitle": "Strong and thick, sleeker and sexier.",
  "quest.5531CACD5D0FEDF2.quest_desc": [
    "An Ebony and an Ivory Assembly: one for heavy tricks, one for cheap ones. Swap them at the Assembler as the job asks."
  ],
  "reward.76189342291190C5.title": "Secret found",
  "quest.0D4E4EEB3EBE9E69.title": "Exosuit Controller",
  "quest.0D4E4EEB3EBE9E69.quest_subtitle": "It's no butler, but it listens.",
  "quest.0D4E4EEB3EBE9E69.quest_desc": [
    "[\"\",{\"text\":\"Redstone, glass and psimetal. Load each piece with bullets at the Assembler, then hold the controller and press \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"psimisc.keybind\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\": left and right click cycle the pieces, and you pick each one's spell like on a CAD. The empty fourth slot switches a piece off.\"}]"
  ],
  "task.33B2B1009AA696FD.title": "Any exosuit sensor",
  "quest.0AC8874C46010C65.title": "Exosuit Sensors",
  "quest.0AC8874C46010C65.quest_subtitle": "The helmet's five senses.",
  "quest.0AC8874C46010C65.quest_desc": [
    "Two iron and two psimetal around a reagent. Glowstone fires when you walk into darkness, a fire charge when you catch fire, a glistering melon slice at three hearts or less, prismarine crystals when you touch water, gunpowder when a detonator goes off within 32 blocks.",
    "{@pagebreak}",
    "A helmet and a sensor in a crafting grid attach it, one per helmet; the helmet alone gives it back."
  ],
  "quest.39ECF9974F366E64.title": "Leggings never stop",
  "quest.39ECF9974F366E64.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The leggings cast every tick, twenty times a second: a better \"},{\"text\":\"Loopcast\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3D1917291B69F01F\"}},{\"text\":\" that leaves your hands free. Keep that spell cheap, or pick the empty slot when you don't need it.\"}]"
  ],
  "quest.7760AE5E99EE5149.title": "Hit back",
  "quest.7760AE5E99EE5149.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The chestplate fires when you take damage: \"},{\"text\":\"Selector: Attacker\",\"color\":\"#7FDBFF\"},{\"text\":\" is who hit you and \"},{\"text\":\"Selector: Damage Taken\",\"color\":\"#7FDBFF\"},{\"text\":\" how hard. Both only work in spells cast from armor, and Loopcast and Circle bullets don't fit the suit.\"}]"
  ],
  "quest.24D3FF264F5CBEE1.title": "Gold CAD Assembly",
  "quest.24D3FF264F5CBEE1.quest_subtitle": "Worth its weight, as they say.",
  "quest.24D3FF264F5CBEE1.quest_desc": [
    "[\"\",{\"text\":\"Four gold: Potency 175 at 75% efficiency, the best you can make without Psi materials. Later, drop it and cast \"},{\"text\":\"Trick: Infusion\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"66787E7A0B61BE71\"}},{\"text\":\" next to it: it turns into a Psimetal Assembly.\"}]"
  ],
  "quest.1F1890606B8EECB9.title": "Encyclopaedia Psionica",
  "quest.1F1890606B8EECB9.quest_subtitle": "The manual, every piece included.",
  "quest.1F1890606B8EECB9.quest_desc": [
    "[\"\",{\"text\":\"With empty hands, \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"psimisc.keybind\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" opens Psi's book wherever you are. For a copy on the shelf, drop a book and use a CAD with no spell selected next to it. In this pack the recipe has its own ID, because PneumaticCraft's manual used the same one.\"}]"
  ],
  "task.72A12885E17DC5C1.title": "Any CAD battery",
  "quest.77A732125B6256F8.title": "CAD Battery",
  "quest.77A732125B6256F8.quest_subtitle": "Cheaper than a funeral.",
  "quest.77A732125B6256F8.quest_desc": [
    "Iron over a conductor over gold. It fills with Psi you don't use and covers you when you run dry, before your health does: psidust holds 100, psimetal 200, a psigem 400. Past it, every 125 Psi you're short costs a point of health, and the CAD locks until you're full again."
  ],
  "task.6CDF7D9DA3CFF62D.title": "Any dyed or rainbow colorizer",
  "quest.7165CE4A23FBF121.title": "CAD Colorizer",
  "quest.7165CE4A23FBF121.quest_subtitle": "Same spell, better outfit.",
  "quest.7165CE4A23FBF121.quest_desc": [
    "Iron, psidust, two glass and a dye: your spells' particles, projectiles, circles and conjured blocks take its color. Prismarine crystals instead of a dye cycle through the rainbow. A CAD and a colorizer in a crafting grid swap it in, and the old one comes back."
  ],
  "quest.68D567AB61A064B2.title": "Psi-colored",
  "quest.68D567AB61A064B2.quest_subtitle": "Reportedly different for some people.",
  "quest.68D567AB61A064B2.quest_desc": [
    "Psidust as the color. For most people it does nothing special; the book hints that certain supporters see something else."
  ],
  "reward.12BA0DBC8C513FD8.title": "Secret found",
  "quest.126E7BB46AC54FBF.title": "Colorless",
  "quest.126E7BB46AC54FBF.quest_subtitle": "Magic, but make it subtle.",
  "quest.126E7BB46AC54FBF.quest_desc": [
    "A colorizer with nothing in the middle pulls the color out of your Psi, and the particles all but vanish. Spells nobody sees you cast."
  ],
  "reward.5302205122825656.title": "Secret found",
  "quest.31660A2849BD9384.title": "Terra's kind of magic",
  "quest.31660A2849BD9384.quest_subtitle": "A machine you teach to think.",
  "quest.31660A2849BD9384.quest_desc": [
    "Terra liked tools you can read. A Psi spell is one: pieces on a grid, each doing one thing, and a plain reason whenever one fails."
  ],
  "quest.06C03F0B98622C20.title": "Psimetal for the common store",
  "quest.06C03F0B98622C20.quest_subtitle": "Gold that learned to listen.",
  "quest.06C03F0B98622C20.quest_desc": [
    "[\"\",{\"text\":\"Sixteen \"},{\"text\":\"Psimetal Ingots\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"psi:psimetal\",\"count\":1}}},{\"text\":\" for the common store, once a day. Drop a whole stack of gold and a single Infusion cast pays it.\"}]"
  ],
  "image.04EA872F0917824C.title": "[\"\",{\"text\":\"Spell pieces\",\"color\":\"#7FDBFF\"}]",
  "image.65DC5B232FF9FB6F.title": "[\"\",{\"text\":\"Bullets\",\"color\":\"#7FDBFF\"}]",
  "image.60A303F9FC15CB2F.title": "[\"\",{\"text\":\"Ebony & Ivory\",\"color\":\"#7FDBFF\"}]",
  "image.3F3088C0BF9BF923.title": "[\"\",{\"text\":\"Exosuit\",\"color\":\"#7FDBFF\"}]",
  "image.3A8F16737DEF772A.title": "[\"\",{\"text\":\"At the Assembler\",\"color\":\"#7FDBFF\"}]",
  "image.5517E0BF0269564D.title": "[\"\",{\"text\":\"Psi\",\"color\":\"#F2EEFF\",\"bold\":true}]",
  "image.44BB1BB416629C28.title": "[\"\",{\"text\":\"write · compile · cast\",\"color\":\"#9FE6FF\",\"font\":\"minecraft:uniform\"}]",
  "image.5F3938A347BB3277.title": "Back to the Sun of Heliodor",
  "chapter.706C1D99E8A3B84A.title": "Theurgy",
  "chapter.706C1D99E8A3B84A.chapter_subtitle": [
    "Salt, sulfur and mercury: take matter apart, put it back together three times over, then turn iron into gold."
  ],
  "quest.45B1C0CCAB3365E4.title": "Pyromantic Brazier",
  "quest.45B1C0CCAB3365E4.quest_subtitle": "Alchemy starts with a good fire.",
  "quest.45B1C0CCAB3365E4.quest_desc": [
    "[\"\",{\"text\":\"Five copper ingots and four stone make a \"},{\"text\":\"Pyromantic Brazier\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:pyromantic_brazier\",\"count\":1}}},{\"text\":\". Every heated apparatus sits on one: the oven, the cauldron, the distiller and the incubator. It burns furnace fuel, by hand or from a hopper.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Four braziers cover the whole refinery. Later a \"},{\"text\":\"Caloric Flux Emitter\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2362DF329027AE22\"}},{\"text\":\" heats from a distance and the coal can stay in the chest.\"}]"
  ],
  "quest.083771EBDC43B500.title": "Hands, hoppers and buckets",
  "quest.083771EBDC43B500.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Every apparatus takes the same clicks. Empty hand: the output first, then the input. An item in hand goes in. A full bucket pours in, an empty one fills; \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and right-click drains every fluid. Hoppers and pipes load them too.\"}]"
  ],
  "quest.0485429A4ED9F39F.title": "Stone means stone",
  "quest.0485429A4ED9F39F.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Theurgy's recipes ask for the stone tag: stone, andesite, diorite, granite, deepslate and tuff all count, cobblestone doesn't. Smelt a stack before the braziers, the distiller and the vessels.\"}]"
  ],
  "quest.73C3DD49C2314F5A.title": "The Hermetica",
  "quest.73C3DD49C2314F5A.quest_subtitle": "It insists it's science. Humor it.",
  "quest.73C3DD49C2314F5A.quest_desc": [
    "A book and two sand of any kind. The Hermetica runs its experiments in order, and most entries open as you read the ones before: raw iron into three ingots, lapis into quartz, quartz into iron, iron into gold. Every apparatus page shows its recipe and the clicks it takes."
  ],
  "quest.5E1BACB0C941F280.title": "Salt: the body",
  "quest.5E1BACB0C941F280.quest_desc": [
    "[\"\",{\"text\":\"Four iron ingots around a block of copper make the \"},{\"text\":\"Calcination Oven\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:calcination_oven\",\"count\":1}}},{\"text\":\". On a brazier it calcines minerals: an ore block gives three \"},{\"text\":\"Mineral Salt\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_salt_mineral\",\"count\":1}}},{\"text\":\", an ingot or a gem two, a raw metal one. Each ingot or gem the incubator makes eats one.\"}]"
  ],
  "quest.7038E75724D0B7B7.title": "Sal Ammoniac: the solvent",
  "quest.7038E75724D0B7B7.quest_subtitle": "It evaporates water until the water gives up.",
  "quest.7038E75724D0B7B7.quest_desc": [
    "[\"\",{\"text\":\"Set the \"},{\"text\":\"Sal Ammoniac Accumulator\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:sal_ammoniac_accumulator\",\"count\":1}}},{\"text\":\" on its \"},{\"text\":\"Tank\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:sal_ammoniac_tank\",\"count\":1}}},{\"text\":\" and pour in up to ten water buckets. Every bucket of water leaves a tenth of a bucket of solvent; an empty bucket on the tank draws a \"},{\"text\":\"Sal Ammoniac Bucket\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:sal_ammoniac_bucket\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A \"},{\"text\":\"Sal Ammoniac Crystal\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"229F97FB2222BE89\"}},{\"text\":\" dissolved in the accumulator turns each bucket of water into a whole bucket of solvent.\"}]"
  ],
  "quest.00239A02D0B8CA69.title": "Sulfur: the soul",
  "quest.00239A02D0B8CA69.quest_subtitle": "The soul of an ingot, in a jar.",
  "quest.00239A02D0B8CA69.quest_desc": [
    "[\"\",{\"text\":\"Five copper ingots, a cauldron and three stone make the \"},{\"text\":\"Liquefaction Cauldron\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:liquefaction_cauldron\",\"count\":1}}},{\"text\":\". On a brazier and filled with sal ammoniac it dissolves what you feed it and keeps the sulfur: one \"},{\"text\":\"Raw Iron\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:raw_iron\",\"count\":1}}},{\"text\":\" gives three \"},{\"text\":\"Iron Sulfur\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_sulfur_iron\",\"count\":1}}},{\"text\":\". That's where the multiplying happens.\"}]"
  ],
  "quest.3A0E5E4FB37C3C75.title": "Mercury: the spirit",
  "quest.3A0E5E4FB37C3C75.quest_desc": [
    "[\"\",{\"text\":\"Three iron ingots, a block of copper and three stone make the \"},{\"text\":\"Mercury Distiller\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:distiller\",\"count\":1}}},{\"text\":\". On a brazier it boils almost anything down to \"},{\"text\":\"Mercury Shards\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:mercury_shard\",\"count\":1}}},{\"text\":\": ten cobblestone give one, a raw iron one, an iron ore block five. Mercury is the incubator's third ingredient and Theurgy's fuel.\"}]"
  ],
  "quest.7E37B0C668398893.title": "Three ingots from one",
  "quest.7E37B0C668398893.quest_subtitle": "Body, soul and spirit, back together.",
  "quest.7E37B0C668398893.quest_desc": [
    "[\"\",{\"text\":\"Set the \"},{\"text\":\"Incubator\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:incubator\",\"count\":1}}},{\"text\":\" on a brazier with its salt, sulfur and mercury vessels beside it, one of each. An Iron Sulfur, a Mineral Salt and a Mercury Shard incubate into an \"},{\"text\":\"Iron Ingot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:iron_ingot\",\"count\":1}}},{\"text\":\": three for every raw iron.\"}]",
    "{@pagebreak}",
    "Three gold ingots, copper, stone and planks make the incubator; each vessel is four copper and three stone around the principle it holds.",
    "",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Hoppers fill the vessels, so one chest per principle keeps the line running.\"}]"
  ],
  "quest.229F97FB2222BE89.title": "Sal Ammoniac Crystals",
  "quest.229F97FB2222BE89.quest_subtitle": "Ten times the acid, same water.",
  "quest.229F97FB2222BE89.quest_desc": [
    "[\"\",{\"text\":\"Sal Ammoniac Ore\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:sal_ammoniac_ore\",\"count\":1}}},{\"text\":\" runs through the Overworld's stone and deepslate, up to twenty veins a chunk, and Fortune works on it. One \"},{\"text\":\"crystal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:sal_ammoniac_crystal\",\"count\":1}}},{\"text\":\" in the accumulator turns a bucket of water into a whole bucket of solvent instead of a tenth.\"}]",
    "{@pagebreak}",
    "A Sal Ammoniac Bucket crafted alone gives the crystal back, and the bucket."
  ],
  "quest.256C856A88C80CFD.title": "Silk Touch, then acid",
  "quest.256C856A88C80CFD.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The cauldron pays more for whole ores: an iron, gold or copper ore block gives five sulfur where the raw metal gives three, a diamond ore four, a lapis ore twelve. Mine with Silk Touch and dissolve the blocks.\"}]"
  ],
  "quest.19BDB6F62D99F6FE.title": "A bucket, a hundred jobs",
  "quest.19BDB6F62D99F6FE.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A liquefaction drinks only 10 mB of sal ammoniac, so one bucket in the cauldron dissolves a hundred raw ores: three hundred sulfurs. The accumulator never has to hurry.\"}]"
  ],
  "quest.1344D8BC7C0811D2.title": "Every metal in the pack",
  "quest.1344D8BC7C0811D2.quest_subtitle": "Mekanism's ores at alchemy's prices.",
  "quest.1344D8BC7C0811D2.quest_desc": [
    "The recipes read the common metal tags, so the cauldron also takes the pack's other raw metals: osmium, tin, lead, silver, nickel, zinc, aluminum, uranium and platinum, three sulfurs each. The incubator hands back the ingot Almost Unified picks."
  ],
  "quest.22AECFBCC6A23EE3.title": "Fermentation Vat",
  "quest.22AECFBCC6A23EE3.quest_subtitle": "A brewery with a doctorate.",
  "quest.22AECFBCC6A23EE3.quest_desc": [
    "[\"\",{\"text\":\"Six copper ingots, a copper block, a barrel and any sulfur make the \"},{\"text\":\"Fermentation Vat\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:fermentation_vat\",\"count\":1}}},{\"text\":\". It needs no fire: load a sulfur, sugar or a crop and water, then close it with \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and an empty-handed right-click. It opens again when the \"},{\"text\":\"niter\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"30885D7DF78DB6DA\"}},{\"text\":\" is ready.\"}]"
  ],
  "quest.30885D7DF78DB6DA.title": "Niter: the idea of a thing",
  "quest.30885D7DF78DB6DA.quest_subtitle": "Philosophy you can smelt.",
  "quest.30885D7DF78DB6DA.quest_desc": [
    "[\"\",{\"text\":\"Sulfur is stubborn and won't turn into anything else. Fermented, it becomes niter, the idea of a material: \"},{\"text\":\"Common Metals Niter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_niter_metals_common\",\"count\":1}}},{\"text\":\" instead of iron. Each iron sulfur, a sugar or a crop and 250 mB of water give one.\"}]"
  ],
  "quest.21451CC7D8C2C18D.title": "Fermentation Starter",
  "quest.21451CC7D8C2C18D.quest_subtitle": "Sourdough for alchemists.",
  "quest.21451CC7D8C2C18D.quest_desc": [
    "[\"\",{\"text\":\"A crop, a sugar and 100 mB of sal ammoniac ferment into twenty \"},{\"text\":\"Fermentation Starters\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:fermentation_starter\",\"count\":1}}},{\"text\":\". Each one stands in for the sugar or the crop of a niter fermentation: twenty niters for one sugar.\"}]"
  ],
  "quest.6EA24A0AF88E0747.title": "Vats that close themselves",
  "quest.6EA24A0AF88E0747.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A redstone signal closes a vat as soon as a valid recipe is inside, and a vat gives off a signal while its output holds something. A redstone torch between the two runs the loop: fill, close, finish, open, empty.\"}]"
  ],
  "quest.1EF21A76A090EE96.title": "Mercury Catalyst",
  "quest.1EF21A76A090EE96.quest_subtitle": "Shards in, energy out.",
  "quest.1EF21A76A090EE96.quest_desc": [
    "[\"\",{\"text\":\"Iron, gold, a block of quartz and a mercury shard make the \"},{\"text\":\"Mercury Catalyst\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:mercury_catalyst\",\"count\":1}}},{\"text\":\". Feed it shards and it turns each into 800 mercury flux, 20 a tick; its sides go blue as it fills. An emitter set on it spends that flux.\"}]"
  ],
  "quest.2CAB85EC62D1FA63.title": "Mercury Crystal",
  "quest.2CAB85EC62D1FA63.quest_desc": [
    "[\"\",{\"text\":\"Four shards pack into a \"},{\"text\":\"Mercury Crystal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:mercury_crystal\",\"count\":1}}},{\"text\":\" and unpack again. The catalyst gets 3,200 flux out of one, four shards' worth. The catalyst, the mercury vessel and the caloric emitter take either in their recipes; incubation and the logistics parts want shards.\"}]"
  ],
  "quest.6993A430469BB97D.title": "What's worth distilling",
  "quest.6993A430469BB97D.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The distiller pays by value: ten stone, fifteen sand or three crops for a shard; five for an iron or copper ore block, twenty-five for a gold ore, fifty for a diamond or emerald ore or a block of Ancient Debris.\"}]"
  ],
  "quest.2362DF329027AE22.title": "Heat without fire",
  "quest.2362DF329027AE22.quest_subtitle": "Coal is for barbarians.",
  "quest.2362DF329027AE22.quest_desc": [
    "[\"\",{\"text\":\"Gold, stone, a mercury shard and a campfire or a lava bucket make the \"},{\"text\":\"Caloric Flux Emitter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:caloric_flux_emitter\",\"count\":1}}},{\"text\":\". \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and right-click the apparatus to heat, then set the emitter on a catalyst: it keeps its target hot from up to eight blocks away, with no fuel and no brazier.\"}]"
  ],
  "quest.16A48A9D4E0F7868.title": "Redstone on the flux",
  "quest.16A48A9D4E0F7868.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A redstone signal switches the caloric emitter off. A powered catalyst keeps converting shards but holds the flux, so one lever on the catalyst pauses whatever sits on it and nothing is lost.\"}]"
  ],
  "quest.2970F8DD054660BA.title": "Mercurial logistics",
  "quest.2970F8DD054660BA.quest_subtitle": "Items over copper wire.",
  "quest.2970F8DD054660BA.quest_desc": [
    "[\"\",{\"text\":\"Copper over a mercury shard makes a \"},{\"text\":\"Mercurial Item Extractor\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:logistics_item_extractor\",\"count\":1}}},{\"text\":\"; the shard over copper, an \"},{\"text\":\"Inserter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:logistics_item_inserter\",\"count\":1}}},{\"text\":\". Click them onto inventories, join them with \"},{\"text\":\"Mercurial Copper Wire\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:copper_wire\",\"count\":1}}},{\"text\":\", and items flow from every extractor to the inserters of that network.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"An extractor with a list filter is also the lightest way to pull items out of \"},{\"text\":\"Occultism's storage\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"59DC9600D63225DB\"}},{\"text\":\".\"}]"
  ],
  "quest.65BBC794F76CDB98.title": "Mercurial Wand",
  "quest.65BBC794F76CDB98.quest_subtitle": "A wrench with a philosophy degree.",
  "quest.65BBC794F76CDB98.quest_desc": [
    "[\"\",{\"text\":\"Three sticks, copper and a shard. \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and scroll to change modes: pick which side of its block an extractor pulls from, switch a node on or off, or set a frequency so only nodes with the same number talk to each other.\"}]"
  ],
  "quest.6461E2F56CB30B1E.title": "Connection Node",
  "quest.6461E2F56CB30B1E.quest_desc": [
    "[\"\",{\"text\":\"A shard, an iron ingot and three bricks make three \"},{\"text\":\"Mercurial Connection Nodes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:logistics_connector_node\",\"count\":1}}},{\"text\":\". Stick them on any block to carry wire round corners and across distance: everything wired to them is one network, and extractors deal their items out in turns.\"}]"
  ],
  "quest.4988FE6DD038EA06.title": "Filters",
  "quest.4988FE6DD038EA06.quest_subtitle": "Paper, a shard and opinions.",
  "quest.4988FE6DD038EA06.quest_desc": [
    "[\"\",{\"text\":\"Eight paper around a shard make nine \"},{\"text\":\"List Filters\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:list_filter\",\"count\":1}}},{\"text\":\"; trade one paper for a feather and you get \"},{\"text\":\"Attribute Filters\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:attribute_filter\",\"count\":1}}},{\"text\":\". Right-click the air to set one up, then right-click an extractor or inserter to fit it. Buckets in a list filter filter fluids.\"}]"
  ],
  "quest.033A1AD8988EFD53.title": "Fluids on the wire",
  "quest.033A1AD8988EFD53.quest_desc": [
    "[\"\",{\"text\":\"Blue dye on top of the extractor or inserter recipe makes the \"},{\"text\":\"Fluid Extractor\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:logistics_fluid_extractor\",\"count\":1}}},{\"text\":\" and the \"},{\"text\":\"Fluid Inserter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:logistics_fluid_inserter\",\"count\":1}}},{\"text\":\". Draw from the sal ammoniac tank, feed the cauldrons and vats, and nobody carries buckets again.\"}]"
  ],
  "quest.46E441D26E993D4C.title": "Wrong way round",
  "quest.46E441D26E993D4C.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Made an extractor where you wanted an inserter? Put it alone in the crafting grid and it flips to the other one, and back.\"}]"
  ],
  "quest.080F63B7A6A18AC7.title": "Mercury for the common store",
  "quest.080F63B7A6A18AC7.quest_subtitle": "Every apparatus drinks it.",
  "quest.080F63B7A6A18AC7.quest_desc": [
    "[\"\",{\"text\":\"Thirty-two \"},{\"text\":\"Mercury Shards\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:mercury_shard\",\"count\":1}}},{\"text\":\" for the common store, once a day. Incubators, catalysts and wires all run on them, and a quarry's leftover stone distills into plenty.\"}]"
  ],
  "quest.19EF84624B37F27C.title": "Salt from dirt",
  "quest.19EF84624B37F27C.quest_subtitle": "Renewable, unlike your ores.",
  "quest.19EF84624B37F27C.quest_desc": [
    "[\"\",{\"text\":\"Dirt, cobblestone, sand, gravel and clay carry traces of minerals: the oven turns each into \"},{\"text\":\"Strata Salt\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_salt_strata\",\"count\":1}}},{\"text\":\", and five strata salts calcine into one Mineral Salt. Keep the ores for sulfur.\"}]"
  ],
  "quest.3C3EA38712290D0C.title": "Salt for living things",
  "quest.3C3EA38712290D0C.quest_desc": [
    "[\"\",{\"text\":\"Logs, saplings, crops and leaves calcine into \"},{\"text\":\"Plant Salt\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_salt_plant\",\"count\":1}}},{\"text\":\", and two plant salts into one \"},{\"text\":\"Creature Salt\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_salt_creature\",\"count\":1}}},{\"text\":\". Meat, bones and mob drops give creature salt straight away.\"}]"
  ],
  "quest.1AE994324DF11D20.title": "Water in your pocket",
  "quest.1AE994324DF11D20.quest_subtitle": "Lava you can pocket. What could go wrong?",
  "quest.1AE994324DF11D20.quest_desc": [
    "[\"\",{\"text\":\"Any alchemical salt crafted with a water or lava bucket crystallizes it: \"},{\"text\":\"Crystallized Water\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:crystallized_water\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Crystallized Lava\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:crystallized_lava\",\"count\":1}}},{\"text\":\" travel as items and craft back into a bucket. In the accumulator each melts into a full bucket; calcined, the lava gives eight strata salts.\"}]"
  ],
  "quest.4EF9978192D47174.title": "The right salt",
  "quest.4EF9978192D47174.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The salt has to match the sulfur: ores, gems, coal and redstone want Mineral Salt; logs and crops, Plant Salt; animal and mob drops, Creature Salt; earth and stone, Strata Salt. A blaze rod is incubated with creature salt, never with a diamond's.\"}]"
  ],
  "quest.09B46C72FEF179E8.title": "A rod for ordinary ores",
  "quest.09B46C72FEF179E8.quest_subtitle": "Dowsing, except it works.",
  "quest.09B46C72FEF179E8.quest_desc": [
    "[\"\",{\"text\":\"Two glass and three sticks. \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" and right-click a block to attune the \"},{\"text\":\"Glass Divination Rod\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:divination_rod_t1\",\"count\":1}}},{\"text\":\", then hold right-click: it points to the nearest match. Iron, coal and the other common ores are in its reach; gold and diamonds need a better rod.\"}]"
  ],
  "quest.55F5487F803EA5AE.title": "Rod habits",
  "quest.55F5487F803EA5AE.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A rod that found something turns purple. A right-click without holding points to the last find again and costs no durability; hold it to search anew.\"}]"
  ],
  "quest.59C862440444FF26.title": "Amethyst Divination Rod",
  "quest.59C862440444FF26.quest_subtitle": "The rod that finds rods.",
  "quest.59C862440444FF26.quest_desc": [
    "[\"\",{\"text\":\"Glass, sticks and purple dye: no amethyst needed. The \"},{\"text\":\"Amethyst Divination Rod\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:amethyst_divination_rod\",\"count\":1}}},{\"text\":\" comes attuned to \"},{\"text\":\"Budding Amethyst\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:budding_amethyst\",\"count\":1}}},{\"text\":\", and every better rod asks for an \"},{\"text\":\"Amethyst Shard\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:amethyst_shard\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.7D3637F5F5FD6808.title": "Iron Divination Rod",
  "quest.7D3637F5F5FD6808.quest_desc": [
    "[\"\",{\"text\":\"Glass, a gold nugget, an amethyst shard and a stick. The \"},{\"text\":\"Iron Divination Rod\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:divination_rod_t2\",\"count\":1}}},{\"text\":\" lasts longer and reaches the rarer ores, gold among them, and obsidian too.\"}]"
  ],
  "quest.5FD84443AFEE1716.title": "Diamond Divination Rod",
  "quest.5FD84443AFEE1716.quest_desc": [
    "[\"\",{\"text\":\"Glass, a diamond, nether quartz and an amethyst shard. The \"},{\"text\":\"Diamond Divination Rod\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:divination_rod_t3\",\"count\":1}}},{\"text\":\" finds the high-tier ores, diamonds included, and wears much slower.\"}]"
  ],
  "quest.2564C149CC2D0F22.title": "Netherite Divination Rod",
  "quest.2564C149CC2D0F22.quest_subtitle": "It wants the ore, not the scrap.",
  "quest.2564C149CC2D0F22.quest_desc": [
    "[\"\",{\"text\":\"Glass, a blaze rod, an amethyst shard and a whole block of \"},{\"text\":\"Ancient Debris\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ancient_debris\",\"count\":1}}},{\"text\":\". The \"},{\"text\":\"Netherite Divination Rod\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:divination_rod_t4\",\"count\":1}}},{\"text\":\" finds ores of any tier and barely wears.\"}]"
  ],
  "quest.16600D4AB59B2501.title": "Rods that already know",
  "quest.16600D4AB59B2501.quest_subtitle": "Pre-attuned, no second opinions.",
  "quest.16600D4AB59B2501.quest_desc": [
    "[\"\",{\"text\":\"Craft a rod with a sulfur in place of a stick and it comes attuned to that sulfur's ore: \"},{\"text\":\"Iron Sulfur\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_sulfur_iron\",\"count\":1}}},{\"text\":\" makes a \"},{\"text\":\"Divination Rod: Common Materials\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:sulfur_attuned_divination_rod_common\",\"count\":1}}},{\"text\":\" that finds iron. It can't be re-attuned, but it lasts far longer. Copper or coal sulfur makes the abundant one.\"}]"
  ],
  "quest.34410AA11D616C6F.title": "Pre-attuned: rare",
  "quest.34410AA11D616C6F.quest_desc": [
    "[\"\",{\"text\":\"A rare sulfur, glass, a stick and an amethyst shard: \"},{\"text\":\"Gold Sulfur\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_sulfur_gold\",\"count\":1}}},{\"text\":\" makes a \"},{\"text\":\"Divination Rod: Rare Materials\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:sulfur_attuned_divination_rod_rare\",\"count\":1}}},{\"text\":\" locked on gold. Any rare sulfur works the same way.\"}]"
  ],
  "quest.229CF914EE735453.title": "Pre-attuned: precious",
  "quest.229CF914EE735453.quest_subtitle": "A diamond to find diamonds.",
  "quest.229CF914EE735453.quest_desc": [
    "[\"\",{\"text\":\"A precious sulfur, glass, a diamond and an amethyst shard: \"},{\"text\":\"Diamond Sulfur\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_sulfur_diamond\",\"count\":1}}},{\"text\":\" makes a \"},{\"text\":\"Divination Rod: Precious Materials\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:sulfur_attuned_divination_rod_precious\",\"count\":1}}},{\"text\":\", the toughest of the pre-attuned rods, locked on diamonds.\"}]"
  ],
  "quest.7AFB72ECB64931DE.title": "Sulfuric Flux Emitter",
  "quest.7AFB72ECB64931DE.quest_subtitle": "The soul, sent by wire.",
  "quest.7AFB72ECB64931DE.quest_desc": [
    "[\"\",{\"text\":\"Gold, stone, any sulfur, a sal ammoniac crystal and, in this pack, a \"},{\"text\":\"Containment Seal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:containment_seal\",\"count\":1}}},{\"text\":\" (act IV) in the bottom row. Right-click the reformation pedestals with the \"},{\"text\":\"emitter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:sulfuric_flux_emitter\",\"count\":1}}},{\"text\":\" and set it on a catalyst, within eight blocks of them.\"}]",
    "{@pagebreak}",
    "Right-click the placed emitter to check its links. If a pedestal is missing, break the emitter, link it again and put it back."
  ],
  "quest.6104E3D2E6C0C579.title": "Why transmutation waits",
  "quest.6104E3D2E6C0C579.quest_desc": [
    "Reformation, transmutation and exaltation together copy nearly any material, diamonds and netherite included, so the pack ties the emitter to the Containment Seal like its other replication tools. Refining ores stays free from the start."
  ],
  "quest.60577799DFED02A7.title": "The Reformation Array",
  "quest.60577799DFED02A7.quest_subtitle": "Alchemy that needs the furniture just so.",
  "quest.60577799DFED02A7.quest_desc": [
    "[\"\",{\"text\":\"No fixed shape: a \"},{\"text\":\"Target Pedestal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:reformation_target_pedestal\",\"count\":1}}},{\"text\":\" holds the sulfur you want more of and is never used up, \"},{\"text\":\"Source Pedestals\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:reformation_source_pedestal\",\"count\":1}}},{\"text\":\" hold what gets consumed, and one \"},{\"text\":\"Result Pedestal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:reformation_result_pedestal\",\"count\":1}}},{\"text\":\" collects the copies. Keep them within a few blocks of each other.\"}]",
    "{@pagebreak}",
    "All three are built on blackstone, so the Nether comes first."
  ],
  "quest.2064E0CCFA2BFEA8.title": "Room for eight",
  "quest.2064E0CCFA2BFEA8.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Build more source pedestals than you think you need: the expensive recipes spread their sources over up to eight pedestals, sometimes with several sulfurs on each. The recipe viewer shows exactly how many.\"}]"
  ],
  "quest.3EC4794CDE267F83.title": "The flux budget",
  "quest.3EC4794CDE267F83.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A reformation costs 50 mercury flux for abundant sulfurs, 100 for common ones, 150 for rare and 200 for precious. At 800 flux a shard, one shard pays for four diamonds.\"}]"
  ],
  "quest.594FA098977EB3EF.title": "Lapis into quartz",
  "quest.594FA098977EB3EF.quest_subtitle": "Same type, same tier, new face.",
  "quest.594FA098977EB3EF.quest_desc": [
    "[\"\",{\"text\":\"Reformation swaps sulfurs of the same type and tier. Put a \"},{\"text\":\"Quartz Sulfur\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_sulfur_quartz\",\"count\":1}}},{\"text\":\" on the target and \"},{\"text\":\"Lapis Sulfur\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_sulfur_lapis\",\"count\":1}}},{\"text\":\" on the sources: each lapis becomes one more quartz for 100 flux. Certus quartz sits in the same tier, if AE2 is calling.\"}]"
  ],
  "quest.4975298B6C4B378C.title": "Emeralds into diamonds",
  "quest.4975298B6C4B378C.quest_subtitle": "The villagers never saw it coming.",
  "quest.4975298B6C4B378C.quest_desc": [
    "[\"\",{\"text\":\"Diamond and emerald share the precious gem tier. With a \"},{\"text\":\"Diamond Sulfur\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_sulfur_diamond\",\"count\":1}}},{\"text\":\" on the target, every emerald sulfur on the sources turns into another for 200 flux: the villagers pay in emeralds and you cash in diamonds.\"}]"
  ],
  "quest.60135ED4B0E2DC66.title": "Blaze rods from slime",
  "quest.60135ED4B0E2DC66.quest_subtitle": "Zombie leftovers, now with ambition.",
  "quest.60135ED4B0E2DC66.quest_desc": [
    "[\"\",{\"text\":\"Mob drops have tiers too. Ender pearls, blaze rods, slimeballs, phantom membranes and magma cream are all common: with a \"},{\"text\":\"Blaze Rod Sulfur\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_sulfur_blaze_rod\",\"count\":1}}},{\"text\":\" on the target, slime sulfur turns into blaze rods. Rotten flesh, string, bone and gunpowder swap among themselves the same way.\"}]",
    "{@pagebreak}",
    "Animal drops follow the same rule: a rabbit's foot and a turtle scute share the rare tier, so rabbits pay for turtle helmets. Everything from a creature comes back out of the incubator with Creature Salt."
  ],
  "quest.045C5ED3C0D5D418.title": "Any wood from oak",
  "quest.045C5ED3C0D5D418.quest_subtitle": "A lumberjack who never leaves the lab.",
  "quest.045C5ED3C0D5D418.quest_desc": [
    "Logs and crops are abundant tiers of their own and reform for 50 flux. With a birch, cherry or mangrove sulfur on the target, oak sulfur turns into that wood; with a coffee bean sulfur there, wheat does the same. Plant Salt brings them back out of the incubator."
  ],
  "quest.686FBC454CFADC18.title": "Quartz into iron",
  "quest.686FBC454CFADC18.quest_subtitle": "Two metals for every gem.",
  "quest.686FBC454CFADC18.quest_desc": [
    "[\"\",{\"text\":\"Transmutation changes the type. Ferment quartz sulfur into \"},{\"text\":\"Common Gems Niter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_niter_gems_common\",\"count\":1}}},{\"text\":\" and reform it against a Common Metals Niter target, two metal niters per gem niter; then reform those against an Iron Sulfur target. Two metals are worth one gem, and two other minerals one metal.\"}]"
  ],
  "quest.3DB00AF14446AD73.title": "Gold that grows on trees",
  "quest.3DB00AF14446AD73.quest_subtitle": "The goose had a point after all.",
  "quest.3DB00AF14446AD73.quest_desc": [
    "[\"\",{\"text\":\"Charcoal counts as a mineral: its \"},{\"text\":\"Coal Sulfur\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_sulfur_coals\",\"count\":1}}},{\"text\":\" ferments into \"},{\"text\":\"Abundant Other Minerals Niter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_niter_other_minerals_abundant\",\"count\":1}}},{\"text\":\". Transmute and exalt from there and a tree farm feeds gold, or diamonds, forever. Slowly.\"}]"
  ],
  "quest.06D05CB9F8D2BA6F.title": "Digestion Vat",
  "quest.06D05CB9F8D2BA6F.quest_subtitle": "Slow food for niter.",
  "quest.06D05CB9F8D2BA6F.quest_desc": [
    "[\"\",{\"text\":\"A sal ammoniac crystal, two gold ingots, a decorated pot and three sandstone make the \"},{\"text\":\"Digestion Vat\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:digestion_vat\",\"count\":1}}},{\"text\":\". Like the fermentation vat it works closed and loads open. It moves niter between tiers: up with a catalyst, down for free.\"}]"
  ],
  "quest.2D97536F8A6F5FA6.title": "Purified Gold",
  "quest.2D97536F8A6F5FA6.quest_subtitle": "Salt scrubs gold. Don't ask.",
  "quest.2D97536F8A6F5FA6.quest_desc": [
    "[\"\",{\"text\":\"One \"},{\"text\":\"Gold Ingot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:gold_ingot\",\"count\":1}}},{\"text\":\", any alchemical salt and a water bucket digest into twenty \"},{\"text\":\"Purified Gold\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:purified_gold\",\"count\":1}}},{\"text\":\": the salt draws the impurities out. Every upward digestion burns one.\"}]"
  ],
  "quest.0F41A90BDD204B8C.title": "Four into one",
  "quest.0F41A90BDD204B8C.quest_subtitle": "Iron, promoted.",
  "quest.0F41A90BDD204B8C.quest_desc": [
    "[\"\",{\"text\":\"Exaltation climbs tiers. Four Common Metals Niter, a Purified Gold and 15 mB of sal ammoniac digest into one \"},{\"text\":\"Rare Metals Niter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_niter_metals_rare\",\"count\":1}}},{\"text\":\" in twenty seconds. Load the vat in bulk and it repeats until something runs out.\"}]"
  ],
  "quest.710AF1C214920C73.title": "Past gold",
  "quest.710AF1C214920C73.quest_subtitle": "Netherite, the long way round.",
  "quest.710AF1C214920C73.quest_desc": [
    "[\"\",{\"text\":\"Four Rare Metals Niter digest into one \"},{\"text\":\"Precious Metals Niter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_niter_metals_precious\",\"count\":1}}},{\"text\":\", and precious is netherite's tier. Sixteen niters of iron, a Netherite Sulfur on the target, and the incubator hands you a \"},{\"text\":\"Netherite Ingot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:netherite_ingot\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "task.2CA3C823CBC92C53.title": "Look at your Sulfuric Flux Emitter",
  "quest.4297D7DC09942CDB.title": "The Great Work",
  "quest.4297D7DC09942CDB.quest_subtitle": "Base metal in, sun out.",
  "quest.4297D7DC09942CDB.quest_desc": [
    "[\"\",{\"text\":\"Put a \"},{\"text\":\"Gold Sulfur\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"theurgy:alchemical_sulfur_gold\",\"count\":1}}},{\"text\":\" on the target and Rare Metals Niter on the sources, and let the emitter work: every niter becomes gold sulfur, and the incubator makes it gold. Iron in, gold out: the oldest promise in alchemy, kept.\"}]"
  ],
  "quest.1F234AE79532CF15.title": "A doctorate in dirt",
  "quest.1F234AE79532CF15.quest_subtitle": "Somebody had to try.",
  "quest.1F234AE79532CF15.quest_desc": [
    "You fermented dirt. Sixteen of these reform into one Abundant Gems Niter, and three digestions later that's a precious gem: a diamond is 1,024 dirt niters away."
  ],
  "reward.69F74C2B1B425B06.title": "Secret found",
  "quest.6549045E0C681D42.title": "Scrambled",
  "quest.6549045E0C681D42.quest_subtitle": "The only egg in the world, in acid.",
  "quest.6549045E0C681D42.quest_desc": [
    "You dissolved the Dragon Egg, and in this pack there's no way back: the incubator no longer rebuilds eggs or Nether Stars from their sulfur. Another egg means another Ender Dragon."
  ],
  "reward.3C67DA3703B42AD8.title": "Secret found",
  "quest.0D77AC225CBA9BD9.title": "Acid in acid",
  "quest.0D77AC225CBA9BD9.quest_subtitle": "Somebody had to.",
  "quest.0D77AC225CBA9BD9.quest_desc": [
    "You dissolved sal ammoniac in sal ammoniac. It works: a crystal gives one sulfur, an ore block six, and the result counts as an abundant gem. The acid is not amused."
  ],
  "reward.13416D66221AFE7A.title": "Secret found",
  "image.048F5B76CA12AD21.title": "[\"\",{\"text\":\"Divination\",\"color\":\"#EBCB4F\"}]",
  "image.558F2E8215CE1C96.title": "[\"\",{\"text\":\"Salts\",\"color\":\"#EBCB4F\"}]",
  "image.487056F7C6C05DE3.title": "[\"\",{\"text\":\"Mercurial logistics\",\"color\":\"#EBCB4F\"}]",
  "image.161798EB71045D16.title": "[\"\",{\"text\":\"Same tier, new face\",\"color\":\"#EBCB4F\"}]",
  "image.2BC52EEFD7282976.title": "[\"\",{\"text\":\"Heat by flux\",\"color\":\"#EBCB4F\"}]",
  "image.026F7010E06B8DF0.title": "[\"\",{\"text\":\"Theurgy\",\"color\":\"#F3EEDF\",\"bold\":true}]",
  "image.698F951F9810A0BD.title": "[\"\",{\"text\":\"solve et coagula\",\"color\":\"#A7B7C6\",\"font\":\"minecraft:alt\"}]",
  "image.35A37F5D0F282340.title": "Back to the Sun of Heliodor",
  "image.0F2BE617FDF32064.title": "[\"\",{\"text\":\"Sulfur · soul\",\"color\":\"#EBCB4F\"}]",
  "image.56A9A1BA0F009B85.title": "[\"\",{\"text\":\"Salt · body\",\"color\":\"#F3EEDF\"}]",
  "image.39D3DD454B0B55E6.title": "[\"\",{\"text\":\"Mercury · spirit\",\"color\":\"#A7B7C6\"}]",
  "chapter.7FD8A9B267B7C9D3.title": "Iron's Spells · The Arcane Anvil",
  "chapter.7FD8A9B267B7C9D3.chapter_subtitle": [
    "Eight runes around one orb: mithril, three bosses, the ancient books, battlemage gear, rings and Iron's Gems 'n Jewelry."
  ],
  "quest.49A652D6796F6545.title": "The Arcane Anvil",
  "quest.49A652D6796F6545.quest_subtitle": "Heavy, purple and worth every block.",
  "quest.49A652D6796F6545.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three amethyst blocks over a diamond, an anvil and two polished deepslate.\"}]",
    "",
    "It levels scrolls with ink, locks spells into weapons, fits upgrade orbs into armour and books, and attunes rings."
  ],
  "quest.226BC5F8AF53B7AC.title": "One level at a time",
  "quest.226BC5F8AF53B7AC.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A scroll plus one bottle of the ink its next level needs gives the same scroll a level higher. A unique book plus a higher scroll of one of its locked spells raises that spell instead.\"}]"
  ],
  "quest.6F6D8FBB1ADF111A.title": "A spell on a sword",
  "quest.6F6D8FBB1ADF111A.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A weapon plus a scroll imbues it with that spell, cast from the weapon itself. Imbued weapons still spend mana, on half the usual cooldown, and a Shriving Stone at the anvil takes the spell back off.\"}]"
  ],
  "quest.0F20910E4E8C2CC8.title": "Arcane Ingot",
  "quest.0F20910E4E8C2CC8.quest_subtitle": "Metal with a mind of its own.",
  "quest.0F20910E4E8C2CC8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight Arcane Essence around an iron, copper or gold ingot.\"}]",
    "",
    "Upgrade orbs, rings of mana, weapon parts and portal frames all start here."
  ],
  "quest.4843FD54806C56BA.title": "The Empty Upgrade Orb",
  "quest.4843FD54806C56BA.quest_subtitle": "A blank waiting for a rune.",
  "quest.4843FD54806C56BA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four Arcane Ingots, four Cinder Essence and a Mithril Ingot.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Ring it with eight runes of one kind and it becomes that orb.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"At the anvil an orb adds its bonus to armour or a spell book, three upgrades per item at most.\"}]"
  ],
  "quest.6ABD80D961145D42.title": "Orbs for any school",
  "quest.6ABD80D961145D42.quest_subtitle": "One size fits all.",
  "quest.6ABD80D961145D42.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three orbs that fit any school.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Eight Arcane Runes (essence) make the Mana orb, +\"},{\"text\":\"50\",\"color\":\"#8EC8FF\"},{\"text\":\" max mana.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Eight Recovery Runes (phantom membrane) the Cooldown orb, \"},{\"text\":\"5%\",\"color\":\"#8EC8FF\"},{\"text\":\" shorter cooldowns.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Eight Protective Runes (pufferfish) the Protection orb, \"},{\"text\":\"5%\",\"color\":\"#8EC8FF\"},{\"text\":\" spell resistance.\"}]",
    "",
    "[\"\",{\"text\":\"School orbs add \"},{\"text\":\"5%\",\"color\":\"#8EC8FF\"},{\"text\":\" to their school.\"}]"
  ],
  "quest.32107FDAB27722D9.title": "Room for one more",
  "quest.32107FDAB27722D9.quest_subtitle": "Books, now with an extension.",
  "quest.32107FDAB27722D9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Six Hogskin and three Arcane Cloth make a Lesser Spell Slot Improvement.\"}]",
    "",
    "[\"\",{\"text\":\"At the anvil it adds a slot to a spell book, up to \"},{\"text\":\"12\",\"color\":\"#8EC8FF\"},{\"text\":\".\"}]"
  ],
  "quest.4354A593903826B0.title": "Shriving Stone",
  "quest.4354A593903826B0.quest_subtitle": "Undo, in rock form.",
  "quest.4354A593903826B0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Raw iron and an amethyst shard, shapeless.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"At the anvil it strips an item's imbued spell and upgrades.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"In a crafting grid it wipes an inscribed rune back to a Blank Runestone.\"}]"
  ],
  "quest.53C0612C3F0710ED.title": "Legendary Ink",
  "quest.53C0612C3F0710ED.quest_subtitle": "Premium, and priced like it.",
  "quest.53C0612C3F0710ED.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four bottles of Epic Ink and an amethyst shard in the cauldron, or a boss vault.\"}]",
    "",
    "Only legendary ink writes a spell's top levels, and some spells have several legendary levels that only the anvil reaches."
  ],
  "quest.1A797F17F13CB152.title": "Ingots for the forge-house",
  "quest.1A797F17F13CB152.quest_subtitle": "Heavy donations welcome.",
  "quest.1A797F17F13CB152.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight \"},{\"text\":\"Arcane Ingots\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:arcane_ingot\",\"count\":1}}},{\"text\":\" for the common store, once a day: sixty-four essence and eight plain ingots of work.\"}]"
  ],
  "quest.2C5C02FD1DB072D3.title": "Mithril",
  "quest.2C5C02FD1DB072D3.quest_subtitle": "Deep, dark and fussy.",
  "quest.2C5C02FD1DB072D3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Mithril ore hides between Y -\"},{\"text\":\"63\",\"color\":\"#8EC8FF\"},{\"text\":\" and -\"},{\"text\":\"38\",\"color\":\"#8EC8FF\"},{\"text\":\", never touching air, and only a netherite pickaxe mines it.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Blast the Raw Mithril into scrap for \"},{\"text\":\"40\",\"color\":\"#8EC8FF\"},{\"text\":\" experience each.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Four scrap make an ingot.\"}]"
  ],
  "quest.535AE19EBA0DBC90.title": "Mithril Weave",
  "quest.535AE19EBA0DBC90.quest_subtitle": "Chainmail's fancy cousin.",
  "quest.535AE19EBA0DBC90.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Five mithril ingots checkered with four chains.\"}]",
    "",
    "The late chestplates and the Boots of Speed are woven from it."
  ],
  "quest.3AA7FEA28E043C1A.title": "Weapon Parts",
  "quest.3AA7FEA28E043C1A.quest_subtitle": "Some assembly required.",
  "quest.3AA7FEA28E043C1A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three mithril and two Arcane Ingots make Weapon Parts, the hilt of every mage blade.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Two mithril and two diamonds on them make the Spellbreaker.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Amethyst and chains, the Amethyst Rapier.\"}]"
  ],
  "quest.4220639AB1AC0339.title": "Portal Frames",
  "quest.4220639AB1AC0339.quest_subtitle": "Two doors, no hallway.",
  "quest.4220639AB1AC0339.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two mithril ingots, four Arcane Ingots and an ender pearl make two frames.\"}]",
    "",
    "Place both and link them with the Portal spell: a two-way gate that stays."
  ],
  "quest.0FC4D20ED2316AA2.title": "Seven forbidden spells",
  "quest.0FC4D20ED2316AA2.quest_subtitle": "Choose wisely. Or at least choose.",
  "quest.0FC4D20ED2316AA2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Using an Eldritch Manuscript opens a circle of seven spells:\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Abyssal Shroud\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Eldritch Blast\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Planar Sight\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Pocket Dimension\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Sculk Tentacles\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Sonic Boom\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Telekinesis\"}]",
    "",
    "Press and hold one to learn it.",
    "",
    "Each costs a manuscript, and only a learned one can be forged or cast."
  ],
  "task.3D098023340F86F2.title": "Enter your pocket dimension",
  "task.5AABCBE3D6C595ED.title": "Look at the frame that leads back",
  "quest.63CA28457AF2DC41.title": "A room off the map",
  "quest.63CA28457AF2DC41.quest_subtitle": "No rent, no neighbours, no windows.",
  "quest.63CA28457AF2DC41.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Pocket Dimension is a Legendary Eldritch spell.\"}]",
    "",
    "[\"\",{\"text\":\"Forge its scroll with \"},{\"text\":\"Legendary Ink\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:legendary_ink\",\"count\":1}}},{\"text\":\" and an echo shard, or find one.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Cast it out of combat, \"},{\"text\":\"300\",\"color\":\"#8EC8FF\"},{\"text\":\" mana and two seconds of charge, and you step into a room that is yours alone.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"The frame inside walks you back to where you cast.\"}]"
  ],
  "quest.63834E893D842A05.title": "Seven by seven",
  "quest.63834E893D842A05.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The room is a seven-by-seven voidstone floor under a shaft \"},{\"text\":\"27\",\"color\":\"#8EC8FF\"},{\"text\":\" blocks high, walled in barrier: build up, not out. It is the same room every time, so whatever you leave there stays.\"}]"
  ],
  "quest.2961D2D1C2B5820A.title": "House rules",
  "quest.2961D2D1C2B5820A.quest_subtitle": "Tidy, dark and pearl-proof.",
  "quest.2961D2D1C2B5820A.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Inside, ender pearls and chorus fruit fail and the spell won't cast again. Beds, respawn anchors, waystones, warp plates, spatial pylons and portal frames refuse to be placed: the frame is the way out.\"}]"
  ],
  "quest.1F175D1AB007C933.title": "The Wayward Compass",
  "quest.1F175D1AB007C933.quest_subtitle": "The soul inside wants to go home.",
  "quest.1F175D1AB007C933.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four Arcane Essence, four iron ingots and a soul lantern.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"The trapped soul points to the nearest Catacombs.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"If none is loaded yet, use it to search.\"}]"
  ],
  "task.004EABF345719E90.title": "Enter the Catacombs",
  "quest.4F473C051C7DE50A.title": "The Catacombs",
  "quest.4F473C051C7DE50A.quest_subtitle": "Mind the zombies. And the stairs.",
  "quest.4F473C051C7DE50A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Buried under hills, forests, taigas and jungles:\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Halls of Catacombs Zombies\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Cursed armour stands\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"A Necromancer\"}]",
    "",
    "In the deepest one lies a skeleton that isn't finished with you."
  ],
  "task.18C62E708195E1D7.title": "Defeat the Dead King",
  "quest.122E552959C3FE9C.title": "The Dead King",
  "quest.122E552959C3FE9C.quest_subtitle": "Long live the king. Unfortunately.",
  "quest.122E552959C3FE9C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Hit or touch the skeleton in the deepest hall and the Dead King rises, calling the dead around him.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"He drops \"},{\"text\":\"28\",\"color\":\"#8EC8FF\"},{\"text\":\" to \"},{\"text\":\"45\",\"color\":\"#8EC8FF\"},{\"text\":\" Arcane Essence and, half the time, the Blood Staff or the Necronomicon.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Every player who fought gets a Bone Key.\"}]"
  ],
  "quest.6DD225004EEEF7BC.title": "Bone Vault and Phylactery",
  "quest.6DD225004EEEF7BC.quest_subtitle": "Keys, shards and a rematch.",
  "quest.6DD225004EEEF7BC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A key, a vault and a way to bring him back.\"}]",
    "",
    "A Bone Key opens the catacombs' Bone Vault once per player: rare ink, blood, a scroll and one to three Phylactery Shards.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Eight shards around a soul lantern make the Phylactery.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Used on the King's soul, he rises again.\"}]"
  ],
  "task.3C46EB8CB979B269.title": "Take the Necronomicon",
  "quest.3201610D632C8592.title": "Necronomicon",
  "quest.3201610D632C8592.quest_subtitle": "Do not read aloud.",
  "quest.3201610D632C8592.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The Dead King's own tome.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Blood Slash, Blood Step, Ray of Siphoning and Blaze Storm, locked at level \"},{\"text\":\"5\",\"color\":\"#8EC8FF\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Six slots and \"},{\"text\":\"200\",\"color\":\"#8EC8FF\"},{\"text\":\" mana\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Two extra levels to Raise Dead\"}]"
  ],
  "reward.1F34F1284E3F8E9C.title": "Secret found",
  "task.66A6B15B795A7559.title": "Take the Blood Staff",
  "quest.5BD141F9B2023AF3.title": "Staff of Blood",
  "quest.5BD141F9B2023AF3.quest_subtitle": "Pried from bony fingers.",
  "quest.5BD141F9B2023AF3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The Dead King's scepter.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"+\"},{\"text\":\"15%\",\"color\":\"#8EC8FF\"},{\"text\":\" blood power\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"+\"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" summon damage\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"5%\",\"color\":\"#8EC8FF\"},{\"text\":\" spell power\"}]",
    "",
    "It casts your selected spell like any staff."
  ],
  "reward.5B733CC232A53B81.title": "Secret found",
  "task.18D95A7AC8C1A021.title": "Find the Citadel",
  "quest.52FDDD1B3A854FDE.title": "The Citadel",
  "quest.52FDDD1B3A854FDE.quest_subtitle": "Nether real estate, poorly maintained.",
  "quest.52FDDD1B3A854FDE.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A ruined fortress in the Nether's bastion biomes, kept by Ancient Knights and cursed armour.\"}]",
    "",
    "Five paper, two Ancient Knowledge Fragments and two Cinder Essence make a Furled Map that leads there."
  ],
  "quest.4DE9435551F7A808.title": "The Cinderous Soulcaller",
  "quest.4DE9435551F7A808.quest_subtitle": "Ring twice for Tyros.",
  "quest.4DE9435551F7A808.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Six Cinder Essence, two netherite scraps and an echo shard.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Rung near the Citadel's Cinderous Soul Rune, it calls up what's left of Tyros.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Anywhere else, nothing echoes back.\"}]"
  ],
  "task.0D04066AB5ECE331.title": "Defeat the Echo of Tyros",
  "quest.04CB9B7F34B0FA10.title": "Echo of Tyros",
  "quest.04CB9B7F34B0FA10.quest_subtitle": "The first flamebearer still burns.",
  "quest.04CB9B7F34B0FA10.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The echo of the First Flamebearer fights with walls of fire, magma and swarms of fiery daggers.\"}]",
    "",
    "[\"\",{\"text\":\"It drops a Divine Soulshard, \"},{\"text\":\"8\",\"color\":\"#8EC8FF\"},{\"text\":\" to \"},{\"text\":\"16\",\"color\":\"#8EC8FF\"},{\"text\":\" Cinder Essence, two piles of Arcane Essence and, half the time, the Decrepit Scythe or the Signet of the Betrayer.\"}]"
  ],
  "quest.1886A3EFD833D5C4.title": "The Cinderous Vault",
  "quest.1886A3EFD833D5C4.quest_subtitle": "Keys, fire and a pyrium surprise.",
  "quest.1886A3EFD833D5C4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Every player who fought Tyros gets a Decrepit Key.\"}]",
    "",
    "The Citadel's vault always pays a Pyrium Ingot, plus rare ink, scrolls, runes and mithril or netherite scrap.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A Pyrium Ingot in a blast furnace comes out as five Ancient Debris.\"}]"
  ],
  "quest.67CB46EF1DB1D0FE.title": "The Pyrium Staff",
  "quest.67CB46EF1DB1D0FE.quest_subtitle": "Hot to the touch. On purpose.",
  "quest.67CB46EF1DB1D0FE.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two Pyrium Ingots, an Arcane Cloth and a netherite ingot.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"+\"},{\"text\":\"15%\",\"color\":\"#8EC8FF\"},{\"text\":\" fire power\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" shorter casts\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"5%\",\"color\":\"#8EC8FF\"},{\"text\":\" spell power\"}]",
    "",
    "It casts your selected spell."
  ],
  "quest.5426009F4BB82AC4.title": "Timeless Slurry",
  "quest.5426009F4BB82AC4.quest_subtitle": "Rust remover, industrial strength.",
  "quest.5426009F4BB82AC4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Mundane Potion and an echo shard brew Timeless Slurry in the cauldron.\"}]",
    "",
    "At a smithing table it restores relics with a Pyrium Ingot: the Decrepit Scythe becomes the Hellrazor, a Decrepit Flamberge the Legionnaire Flamberge."
  ],
  "task.564579CE49A08640.title": "Find an Ice Spider Den",
  "quest.6E25AEDA2CC2E9DD.title": "The Infested Ruin",
  "quest.6E25AEDA2CC2E9DD.quest_subtitle": "Webs, snow and a very large egg.",
  "quest.6E25AEDA2CC2E9DD.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Find the den first; the egg comes later.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Ice Spider dens hide in snowy and icy biomes away from mountains and oceans.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Two Frozen Bones, four cobwebs and an Arcane Cloth make a Furled Map to one.\"}]",
    "",
    "Break an egg inside and its mother comes to see who did it."
  ],
  "task.08FCBF0019513A5D.title": "Defeat the Ice Spider",
  "quest.4CB0382E9F2BD114.title": "The Ice Spider",
  "quest.4CB0382E9F2BD114.quest_subtitle": "Eight legs, zero chill.",
  "quest.4CB0382E9F2BD114.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A giant spider that pounces, grapples and leaps back out of reach.\"}]",
    "",
    "[\"\",{\"text\":\"It drops \"},{\"text\":\"4\",\"color\":\"#8EC8FF\"},{\"text\":\" to \"},{\"text\":\"16\",\"color\":\"#8EC8FF\"},{\"text\":\" Arcane Essence, string and, four times in ten, an Icy Fang.\"}]",
    "",
    "When it snows, one may come hunting you on its own."
  ],
  "quest.29849C349E293C7F.title": "The Frostbranded Book",
  "quest.29849C349E293C7F.quest_subtitle": "Cold to the touch, as advertised.",
  "quest.29849C349E293C7F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The spider's fang becomes a book.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"An Icy Fang in cauldron water brews Ice Venom.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Three vials, two mithril scraps, a Ruined Book and three Arcane Cloth make the book.\"}]",
    "",
    "[\"\",{\"text\":\"Twelve slots, \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" ice power and \"},{\"text\":\"200\",\"color\":\"#8EC8FF\"},{\"text\":\" mana.\"}]"
  ],
  "quest.5407D7E066F81FA6.title": "The Ice Staff",
  "quest.5407D7E066F81FA6.quest_subtitle": "Mournful, but effective.",
  "quest.5407D7E066F81FA6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Frozen bone, permafrost and a lot of patience.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Four Frozen Bones and three Arcane Ingots make the Frosted Helve.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Add the Permafrost Shard from the Icebreaker. +\"},{\"text\":\"15%\",\"color\":\"#8EC8FF\"},{\"text\":\" ice power, \"},{\"text\":\"25%\",\"color\":\"#8EC8FF\"},{\"text\":\" mana regeneration and \"},{\"text\":\"5%\",\"color\":\"#8EC8FF\"},{\"text\":\" spell power.\"}]"
  ],
  "quest.134503AEA3A84F8C.title": "Breakfast of champions",
  "quest.134503AEA3A84F8C.quest_subtitle": "Tastes like revenge.",
  "quest.134503AEA3A84F8C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Silk Touch on an egg that hadn't frosted over, then honey, sweet berries and a bowl, cooked on a campfire.\"}]",
    "",
    "Nobody asked, and you did it anyway."
  ],
  "reward.2FFAD0EBA1DD4979.title": "Secret found",
  "quest.3C51E9A3764B335F.title": "The Ruined Book",
  "quest.3C51E9A3764B335F.quest_subtitle": "Water damage from before the Warden.",
  "quest.3C51E9A3764B335F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Found in Ancient Cities, and now and then on a Citadel bookshelf.\"}]",
    "",
    "Every late spell book starts from one:",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"The Ancient Codex\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"The Dragonskin\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"The Vampiric\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"The Frostbranded\"}]"
  ],
  "quest.2D520DA7AC1E66AF.title": "The Dragonskin Spell Book",
  "quest.2D520DA7AC1E66AF.quest_subtitle": "Ethically sourced. Probably.",
  "quest.2D520DA7AC1E66AF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Six Dragonskin, two obsidian and a Ruined Book:\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Twelve slots\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" ender power\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"200\",\"color\":\"#8EC8FF\"},{\"text\":\" mana\"}]",
    "",
    "Each Ender Dragon kill drops six to ten skins."
  ],
  "quest.40F8300A2D30AD7E.title": "The Vampiric Spell Book",
  "quest.40F8300A2D30AD7E.quest_subtitle": "A piece of yourself, bound in leather.",
  "quest.40F8300A2D30AD7E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The blood goes in the cauldron, the book comes out.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Soak Hogskin in a cauldron of blood for Bloody Vellum.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Four of it, two Arcane Ingots and a Ruined Book make the book.\"}]",
    "",
    "[\"\",{\"text\":\"Ten slots, \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" blood power, \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" spell resistance and \"},{\"text\":\"200\",\"color\":\"#8EC8FF\"},{\"text\":\" mana.\"}]"
  ],
  "quest.6095C571C61BE84F.title": "The Ancient Codex",
  "quest.6095C571C61BE84F.quest_subtitle": "Restored, not rewritten.",
  "quest.6095C571C61BE84F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The best book two hands can make.\"}]",
    "",
    "A netherite ingot, a Ruined Book, four Arcane Cloth, two Blood Vials and a Bottle o' Lightning restore the Ancient Codex:",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Twelve slots\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"200\",\"color\":\"#8EC8FF\"},{\"text\":\" mana\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"20%\",\"color\":\"#8EC8FF\"},{\"text\":\" shorter cooldowns\"}]",
    "{@pagebreak}",
    "A battle mage's kit: the Codex with three orbs in it, school armour with three each, a Ring of Mana and a Ring of Recovery, and a staff for quick casts.",
    "",
    "[\"\",{\"text\":\"The last page is blank, and signed \"},{\"text\":\"iron\",\"color\":\"#B98CFF\",\"font\":\"minecraft:alt\"},{\"text\":\".\"}]"
  ],
  "quest.6DCA9D2256EC5E7E.title": "Netherite Battlemage",
  "quest.6DCA9D2256EC5E7E.quest_subtitle": "Robes that stop a sword.",
  "quest.6DCA9D2256EC5E7E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A netherite upgrade template and a netherite ingot on each wizard piece, at the smithing table.\"}]",
    "",
    "[\"\",{\"text\":\"The same \"},{\"text\":\"125\",\"color\":\"#8EC8FF\"},{\"text\":\" mana and \"},{\"text\":\"5%\",\"color\":\"#8EC8FF\"},{\"text\":\" spell power per piece, with far more armour than cloth.\"}]"
  ],
  "quest.12AE111657AC7782.title": "The Infernal Sorcerer",
  "quest.12AE111657AC7782.quest_subtitle": "Three stacks and it goes boom.",
  "quest.12AE111657AC7782.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A fire-caster's chestplate with a dangerous habit.\"}]",
    "",
    "A Pyromancer robe, the Divine Soulshard from Tyros, two Mithril Weave and two Pyrium Ingots:",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"+\"},{\"text\":\"150\",\"color\":\"#8EC8FF\"},{\"text\":\" mana\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" spell power\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"Fire spells stack Immolation on their target, and at three stacks it explodes and spreads.\"}]"
  ],
  "quest.0F049277E5D4B154.title": "The Lightbringer",
  "quest.0F049277E5D4B154.quest_subtitle": "Shine responsibly.",
  "quest.0F049277E5D4B154.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A chestplate for the holy school's front line.\"}]",
    "",
    "A Priest robe, a Divine Soulshard, three Mithril Weave and four gold ingots make the Lightbringer Chestplate:",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"+\"},{\"text\":\"150\",\"color\":\"#8EC8FF\"},{\"text\":\" mana\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" spell power\"}]"
  ],
  "quest.6A48B3ADC1F0474F.title": "Boots of Speed",
  "quest.6A48B3ADC1F0474F.quest_subtitle": "Cast and run. Mostly run.",
  "quest.6A48B3ADC1F0474F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Archevoker boots, a Mithril Weave, two feathers and a Divine Soulshard:\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"+\"},{\"text\":\"150\",\"color\":\"#8EC8FF\"},{\"text\":\" mana\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" spell power\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"25%\",\"color\":\"#8EC8FF\"},{\"text\":\" movement speed\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"60%\",\"color\":\"#8EC8FF\"},{\"text\":\" more speed while casting\"}]"
  ],
  "task.5437C0039DA7EADB.title": "Make a Rod o' Lightning",
  "quest.6ADFA6C54B457EEA.title": "Shocking Discovery",
  "quest.6ADFA6C54B457EEA.quest_subtitle": "Hopefully you survived.",
  "quest.6ADFA6C54B457EEA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Wait for a storm and let the sky do the crafting.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Eight Bottles o' Lightning around a copper block make an Energized Core.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Used on a lightning rod in a thunderstorm, the sky answers and the rod becomes a \"},{\"text\":\"Rod o' Lightning\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:lightning_rod\",\"count\":1}}},{\"text\":\", +\"},{\"text\":\"15%\",\"color\":\"#8EC8FF\"},{\"text\":\" lightning power and \"},{\"text\":\"10%\",\"color\":\"#8EC8FF\"},{\"text\":\" shorter cooldowns.\"}]"
  ],
  "reward.23E691495FC90F5F.title": "Secret found",
  "quest.17C6528A2DBACDC7.title": "Ring of Mana",
  "quest.17C6528A2DBACDC7.quest_subtitle": "A hundred reasons to wear it.",
  "quest.17C6528A2DBACDC7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four Arcane Ingots and a diamond: +\"},{\"text\":\"100\",\"color\":\"#8EC8FF\"},{\"text\":\" max mana in a ring slot.\"}]",
    "",
    "[\"\",{\"text\":\"Loot and the Wandering Trader also turn up Silver Rings, worth \"},{\"text\":\"25\",\"color\":\"#8EC8FF\"},{\"text\":\".\"}]"
  ],
  "quest.758939CDF2092C17.title": "Rings of the trade",
  "quest.758939CDF2092C17.quest_subtitle": "Faster, then faster again.",
  "quest.758939CDF2092C17.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two rings: one for cooldowns, one for casts.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"A Mithril Scrap ringed by four copper ingots makes the Ring of Recovery, \"},{\"text\":\"15%\",\"color\":\"#8EC8FF\"},{\"text\":\" shorter cooldowns.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"An amethyst shard beside a scrap makes the Ring of Expediency, \"},{\"text\":\"15%\",\"color\":\"#8EC8FF\"},{\"text\":\" shorter casts.\"}]"
  ],
  "quest.2DC8D08D5613ECB6.title": "Wards",
  "quest.2DC8D08D5613ECB6.quest_subtitle": "Immunity, one ring at a time.",
  "quest.2DC8D08D5613ECB6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Fire, freezing and poison stop hurting.\"}]",
    "",
    "Each one goes on a Mithril Scrap:",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Four Cinder Essence: Fireward Ring\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"A Permafrost Shard: Frostward Ring\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"A Nature Rune: Poisonward Ring\"}]"
  ],
  "quest.08748D559A2AEDD8.title": "An unattuned ring",
  "quest.08748D559A2AEDD8.quest_subtitle": "Bring your own spell.",
  "quest.08748D559A2AEDD8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A bucket and a Mithril Scrap make an unattuned Ring of Affinity.\"}]",
    "",
    "At the Arcane Anvil a scroll attunes it to that spell, which then casts one level higher."
  ],
  "quest.09FD5F6876EBD90E.title": "The Conjurer's Talisman",
  "quest.09FD5F6876EBD90E.quest_subtitle": "For people with a lot of friends.",
  "quest.09FD5F6876EBD90E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A skeleton skull, three string and a Mithril Scrap: +\"},{\"text\":\"15%\",\"color\":\"#8EC8FF\"},{\"text\":\" summon damage.\"}]",
    "",
    "Four Bloody Vellum and an Arcane Rune make it Greater, and summons that time out stop going on cooldown."
  ],
  "quest.6AD961EF77B52800.title": "The Jewelcrafting Station",
  "quest.6AD961EF77B52800.quest_subtitle": "Bling, with stats.",
  "quest.6AD961EF77B52800.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two copper ingots over four planks; a book and one more copper make its guide, «Jewelcrafting and You».\"}]",
    "",
    "Pick a pattern, lay a material in each part, and the station makes the ring or amulet."
  ],
  "quest.483693B0BA94F259.title": "A ring and a chain",
  "quest.483693B0BA94F259.quest_subtitle": "Start simple. Stay shiny.",
  "quest.483693B0BA94F259.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four patterns come unlocked:\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Simple Ring\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Gemset Ring\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Simple Chain\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Simple Amulet\"}]",
    "",
    "Every material brings its own bonus: iron and diamond add armour, copper attack speed, gold mining speed, ruby health."
  ],
  "quest.7BB1F830FFEAE450.title": "The primary part",
  "quest.7BB1F830FFEAE450.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"One part of each pattern is its primary part, and that material's quality scales every bonus on the piece: copper \"},{\"text\":\"0.5\",\"color\":\"#8EC8FF\"},{\"text\":\", iron \"},{\"text\":\"0.75\",\"color\":\"#8EC8FF\"},{\"text\":\", gold \"},{\"text\":\"1.5\",\"color\":\"#8EC8FF\"},{\"text\":\", diamond and the gems \"},{\"text\":\"2\",\"color\":\"#8EC8FF\"},{\"text\":\". Some patterns, like Tearstone or Haggling, multiply quality again.\"}]"
  ],
  "quest.2DCA6BC6C8B7FF81.title": "Seven new gems",
  "quest.2DCA6BC6C8B7FF81.quest_subtitle": "Collect them all. Or just the pretty ones.",
  "quest.2DCA6BC6C8B7FF81.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Ruby, sapphire, topaz, moonstone, peridot, onyx and garnet turn up in dungeon, temple and treasure chests.\"}]",
    "",
    "Each has its own trick when its bonus fires: ruby sets things alight, sapphire freezes them, onyx heals you."
  ],
  "quest.1068D9D37D579C0A.title": "Artisan Scrolls",
  "quest.1068D9D37D579C0A.quest_subtitle": "Patterns, sold separately.",
  "quest.1068D9D37D579C0A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A pattern you don't know is a scroll you haven't found.\"}]",
    "",
    "Locked patterns come on Artisan Scrolls from dungeon, library and Nether chests, from Jewelers and from the Wandering Trader.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Use one to learn its pattern for good.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#8EC8FF\"},{\"text\":\"Iron's own Rune Inscribed Ring is among them.\"}]"
  ],
  "quest.5581113C7A4BCF60.title": "Ask the Jeweler",
  "quest.5581113C7A4BCF60.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A villager who claims a Jewelcrafting Station becomes a Jeweler, selling rings, amulets and patterns. Only Jewelers deal in the Ring of Haggling, which takes items off villager prices; the Piglin Signet pattern comes from Nether chests and makes piglins leave you alone.\"}]"
  ],
  "quest.4742E138AC0E5B46.title": "Mage metals",
  "quest.4742E138AC0E5B46.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Iron's materials work at the station too: mithril has quality \"},{\"text\":\"3\",\"color\":\"#8EC8FF\"},{\"text\":\" and adds \"},{\"text\":\"5%\",\"color\":\"#8EC8FF\"},{\"text\":\" spell power, pyrium quality \"},{\"text\":\"3\",\"color\":\"#8EC8FF\"},{\"text\":\" and \"},{\"text\":\"5%\",\"color\":\"#8EC8FF\"},{\"text\":\" shorter casts, an Arcane Ingot \"},{\"text\":\"50\",\"color\":\"#8EC8FF\"},{\"text\":\" mana, and each rune adds power in its own school.\"}]"
  ],
  "quest.22CB36343BAF177A.title": "Strike the anvil",
  "quest.22CB36343BAF177A.quest_subtitle": "Clang.",
  "quest.22CB36343BAF177A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"One good hit, just because.\"}]",
    "",
    "No reward: just sparks."
  ],
  "image.4A014F1D5D06F010.title": "[\"\",{\"text\":\"The Dead King\",\"color\":\"#D9D3BE\"}]",
  "image.0936089B7F4A6957.title": "[\"\",{\"text\":\"Echo of Tyros\",\"color\":\"#FF8A3D\"}]",
  "image.2E63A750209B71A1.title": "[\"\",{\"text\":\"The Ice Spider\",\"color\":\"#9ADFFF\"}]",
  "image.463331FBE5B2EE9F.title": "[\"\",{\"text\":\"The Pocket Dimension\",\"color\":\"#C9A4FF\"}]",
  "image.5226C8323BC4DFA2.title": "[\"\",{\"text\":\"Mithril\",\"color\":\"#F3E7C6\"}]",
  "image.48FBB90CA490E2A2.title": "[\"\",{\"text\":\"Rings and charms\",\"color\":\"#8FD0FF\"}]",
  "image.2B09D97422706895.title": "[\"\",{\"text\":\"Battlemage gear\",\"color\":\"#F3E7C6\"}]",
  "image.5AA376EF5E0C04BF.title": "[\"\",{\"text\":\"Ancient books\",\"color\":\"#F3E7C6\"}]",
  "image.4870D231B94493D2.title": "[\"\",{\"text\":\"Iron's Gems 'n Jewelry\",\"color\":\"#F3E7C6\"}]",
  "image.44FA71549E05E254.title": "[\"\",{\"text\":\"ARCANE ANVIL\",\"color\":\"#F3E7C6\",\"bold\":true}]",
  "image.62F38D5666C5ABCB.title": "[\"\",{\"text\":\"Iron's Spells\",\"color\":\"#AFC0FF\"}]",
  "image.76D101C384342E3A.title": "Back to Iron's Spells 'n Spellbooks",
  "chapter.5AF5D6D7756C0BF4.title": "Artifacts",
  "chapter.5AF5D6D7756C0BF4.chapter_subtitle": [
    "Forty-eight trinkets nobody crafts: find them, wear them, stack their effects."
  ],
  "task.476EDEA2450010E8.title": "Find an artifact",
  "quest.6AFD3B81196BB353.title": "Amateur Archaeologist",
  "quest.6AFD3B81196BB353.quest_subtitle": "Nobody crafts these. Somebody lost them.",
  "quest.6AFD3B81196BB353.quest_desc": [
    "[\"\",{\"text\":\"Artifacts are never crafted. They wait in structure chests, in suspicious sand and gravel, in underground campsites and on the odd mob; pick one up and it goes in a Curios slot (\"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.curios.open.desc\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\").\"}]",
    "{@pagebreak}",
    "The slots: one head, one necklace, one belt, two hands and one feet slot, the last one added by Artifacts itself. Each has a cosmetic twin."
  ],
  "quest.4C6182A5ACD4BCCB.title": "Where the odds are best",
  "quest.4C6182A5ACD4BCCB.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Bastion treasure rooms roll an artifact 65% of the time, big underwater ruins 45%, woodland mansions 40% and jungle temples 35%. Mineshafts, stronghold corridors, igloos and End cities sit at 30%, the other chests between 5 and 25%.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Lootr gives every player their own roll of each chest, so the whole team gets a try.\"}]"
  ],
  "task.6FE76D2150DA6B9B.title": "Look at suspicious sand",
  "quest.769674767A1151A8.title": "Brush, don't dig",
  "quest.769674767A1151A8.quest_subtitle": "Archaeology, but for trinkets.",
  "quest.769674767A1151A8.quest_desc": [
    "[\"\",{\"text\":\"In desert wells, desert pyramids, ocean ruins and trail ruins, one suspicious block in sixteen hides an artifact in place of its usual find. Work it with a \"},{\"text\":\"Brush\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:brush\",\"count\":1}}},{\"text\":\": a pickaxe only breaks it.\"}]"
  ],
  "task.5275A42B7F105FD8.title": "Kill a Mimic",
  "quest.6C0D53F0E5B344E2.title": "Chest Slayer",
  "quest.6C0D53F0E5B344E2.quest_subtitle": "If the chest has teeth, it has loot.",
  "quest.6C0D53F0E5B344E2.quest_desc": [
    "[\"\",{\"text\":\"Underground campsites, with a bed, a workbench, a furnace and supply barrels, turn up between Y -60 and 40, and three in ten swap their chest for a \"},{\"translate\":\"entity.artifacts.mimic\",\"color\":\"#8FD6C8\"},{\"text\":\". Open it and it bites: 60 health, 5 damage a hit, and an artifact every time it dies.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"While it sits on the ground, arrows bounce off it: catch it mid-jump or go in close.\"}]",
    "",
    "[\"\",{\"text\":\"Too slow? \"},{\"text\":\"A simulated Mimic\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"27DE9C3EC9C7A30B\"}},{\"text\":\" picks the artifact for you.\"}]"
  ],
  "quest.433C02D729E113DD.title": "Mobs dressed for the part",
  "quest.433C02D729E113DD.quest_subtitle": "Yes, that zombie was invisible on purpose.",
  "quest.433C02D729E113DD.quest_desc": [
    "[\"\",{\"text\":\"About one zombie, skeleton or piglin in 670 spawns already wearing an artifact, and drops it when it dies. Drowned go for \"},{\"text\":\"Snorkels\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:snorkel\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Flippers\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:flippers\",\"count\":1}}},{\"text\":\", strays for \"},{\"text\":\"Snowshoes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:snowshoes\",\"count\":1}}},{\"text\":\", ghasts for hats, and the odd zombie for a \"},{\"text\":\"Scarf of Invisibility\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:scarf_of_invisibility\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.3BEDA51087F53E35.title": "The steak that never ends",
  "quest.3BEDA51087F53E35.quest_desc": [
    "[\"\",{\"text\":\"Cows and mooshrooms a player kills drop an \"},{\"text\":\"Everlasting Beef\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:everlasting_beef\",\"count\":1}}},{\"text\":\" one time in 500, and butcher chests and bastion stables hide it too. Cook it into an \"},{\"text\":\"Eternal Steak\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:eternal_steak\",\"count\":1}}},{\"text\":\": it's never used up, it only waits 15 seconds between bites.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Spice of Life pays a heart at 10, 25, 45, 70 and 100 different foods, so the same steak forever earns none: keep it as a safety net.\"}]"
  ],
  "task.62546FFE8F436AA7.title": "Two spare artifacts",
  "quest.177EC7A026415A44.title": "Duplicates for the common store",
  "quest.177EC7A026415A44.quest_subtitle": "The third Villager Hat helps nobody.",
  "quest.177EC7A026415A44.quest_desc": [
    "Any two artifacts you won't wear for the common store, once a day. Between mimics and chests, copies pile up fast."
  ],
  "task.7086055DDADDDAC9.title": "Any head artifact",
  "quest.0DF1D75734FC4CE0.title": "Something on your head",
  "quest.0DF1D75734FC4CE0.quest_subtitle": "Eight hats for one head.",
  "quest.0DF1D75734FC4CE0.quest_desc": [
    "One head slot, eight candidates: six hats and two face pieces. Swap them by the job: Looting for a hunt, cheaper trades for a village run, air for a dive.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Villager Hat\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:villager_hat\",\"count\":1}}},{\"text\":\": villagers charge less. \"},{\"text\":\"Superstitious Hat\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:superstitious_hat\",\"count\":1}}},{\"text\":\": +1 Looting. \"},{\"text\":\"Cowboy Hat\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:cowboy_hat\",\"count\":1}}},{\"text\":\": mounts 40% faster. \"},{\"text\":\"Angler's Hat\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:anglers_hat\",\"count\":1}}},{\"text\":\": +1 Luck of the Sea and +1 Lure. \"},{\"text\":\"Plastic\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:plastic_drinking_hat\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Novelty Drinking Hat\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:novelty_drinking_hat\",\"count\":1}}},{\"text\":\": drink and eat faster.\"}]",
    "",
    "[\"\",{\"text\":\"Snorkel\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:snorkel\",\"count\":1}}},{\"text\":\": 30 seconds of Water Breathing per dive. \"},{\"text\":\"Night Vision Goggles\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:night_vision_goggles\",\"count\":1}}},{\"text\":\": a dim night vision, on and off with \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"artifacts.key.night_vision_goggles.toggle\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\".\"}]"
  ],
  "task.420E60C7F511DCEF.title": "Any necklace artifact",
  "quest.445EF57B8A112BD7.title": "Around your neck",
  "quest.445EF57B8A112BD7.quest_subtitle": "Nine to choose from, one neck to hang them on.",
  "quest.445EF57B8A112BD7.quest_desc": [
    "The necklace slot holds scarves, pendants and charms: luck, speed when you're hurt, a longer breather after each hit, or a counterattack.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Lucky Scarf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:lucky_scarf\",\"count\":1}}},{\"text\":\": +1 Fortune. \"},{\"text\":\"Cross Necklace\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:cross_necklace\",\"count\":1}}},{\"text\":\": a full second more of invulnerability after each hit. \"},{\"text\":\"Panic Necklace\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:panic_necklace\",\"count\":1}}},{\"text\":\": 8 seconds of Speed when you're hurt. \"},{\"text\":\"Thorn\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:thorn_pendant\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Flame\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:flame_pendant\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Shock Pendant\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:shock_pendant\",\"count\":1}}},{\"text\":\": they strike back at attackers.\"}]",
    "",
    "[\"\",{\"text\":\"Scarf of Invisibility\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:scarf_of_invisibility\",\"count\":1}}},{\"text\":\": invisible. \"},{\"text\":\"Charm of Sinking\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:charm_of_sinking\",\"count\":1}}},{\"text\":\": walk the bottom and hold your breath longer. \"},{\"text\":\"Charm of Shrinking\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:charm_of_shrinking\",\"count\":1}}},{\"text\":\": half your size. Each has its own on-off key, unbound at first: \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"artifacts.key.scarf_of_invisibility.toggle\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\", \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"artifacts.key.charm_of_sinking.toggle\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\", \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"artifacts.key.charm_of_shrinking.toggle\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\".\"}]"
  ],
  "task.46272EBE75A32EA1.title": "Any belt artifact",
  "quest.75F48F47F46DCE94.title": "Hanging from your belt",
  "quest.75F48F47F46DCE94.quest_subtitle": "Where the lifesavers hang.",
  "quest.75F48F47F46DCE94.quest_desc": [
    "The belt slot is mostly about staying alive: a second jump, fire resistance when you burn, short bad effects, five extra hearts or a way out of a fatal hit.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Cloud in a Bottle\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:cloud_in_a_bottle\",\"count\":1}}},{\"text\":\": double jump. \"},{\"text\":\"Obsidian Skull\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:obsidian_skull\",\"count\":1}}},{\"text\":\": 30 seconds of Fire Resistance after a burn, once a minute. \"},{\"text\":\"Antidote Vessel\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:antidote_vessel\",\"count\":1}}},{\"text\":\": bad effects last 5 seconds at most. \"},{\"text\":\"Crystal Heart\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:crystal_heart\",\"count\":1}}},{\"text\":\": +10 max health. \"},{\"text\":\"Universal Attractor\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:universal_attractor\",\"count\":1}}},{\"text\":\": pulls in nearby items, on and off with \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"artifacts.key.universal_attractor.toggle\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Chorus Totem\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:chorus_totem\",\"count\":1}}},{\"text\":\": once, a fatal hit teleports you away instead. \"},{\"text\":\"Helium Flamingo\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:helium_flamingo\",\"count\":1}}},{\"text\":\": swim through the air. \"},{\"text\":\"Warp Drive\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:warp_drive\",\"count\":1}}},{\"text\":\": ender pearls cost hunger, not pearls.\"}]"
  ],
  "task.3D801E8E9A3DE784.title": "Any hand artifact",
  "quest.6AC851742C49051F.title": "Two hands, two gloves",
  "quest.6AC851742C49051F.quest_subtitle": "Ten gloves, claws and rings; wear any two.",
  "quest.6AC851742C49051F.quest_desc": [
    "The hands slot comes twice, so two of the ten can work at once: one for the fight and one for the mine, or both for the same job.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Power Glove\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:power_glove\",\"count\":1}}},{\"text\":\": +4 melee damage. \"},{\"text\":\"Feral Claws\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:feral_claws\",\"count\":1}}},{\"text\":\": attack 30% faster. \"},{\"text\":\"Vampiric Glove\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:vampiric_glove\",\"count\":1}}},{\"text\":\": heals a fifth of the melee damage you deal, up to 6 a hit. \"},{\"text\":\"Fire Gauntlet\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:fire_gauntlet\",\"count\":1}}},{\"text\":\": sets targets on fire for 8 seconds. \"},{\"text\":\"Pocket Piston\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:pocket_piston\",\"count\":1}}},{\"text\":\": more knockback. \"},{\"text\":\"Withered Bracelet\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:withered_bracelet\",\"count\":1}}},{\"text\":\": 30% chance of Wither II.\"}]",
    "",
    "[\"\",{\"text\":\"Digging Claws\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:digging_claws\",\"count\":1}}},{\"text\":\": dig 30% faster, and mine like a stone pickaxe bare-handed. \"},{\"text\":\"Pickaxe Heater\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:pickaxe_heater\",\"count\":1}}},{\"text\":\": smelts the ores you mine. \"},{\"text\":\"Golden Hook\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:golden_hook\",\"count\":1}}},{\"text\":\": +50% experience from mobs. \"},{\"text\":\"Onion Ring\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:onion_ring\",\"count\":1}}},{\"text\":\": Haste II after you eat.\"}]"
  ],
  "task.14E59CE834E7793B.title": "Any feet artifact",
  "quest.10DCD6E41BA4EB13.title": "Best foot forward",
  "quest.10DCD6E41BA4EB13.quest_subtitle": "A slot Artifacts brings along, just for shoes.",
  "quest.10DCD6E41BA4EB13.quest_desc": [
    "The feet slot isn't part of Curios: Artifacts adds it, and there's only one, so pick your shoes for the ground you're about to cross.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Running Shoes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:running_shoes\",\"count\":1}}},{\"text\":\": sprint 40% faster and step up blocks. \"},{\"text\":\"Bunny Hoppers\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:bunny_hoppers\",\"count\":1}}},{\"text\":\": jump 40% higher and fall 10 blocks safely. \"},{\"text\":\"Steadfast Spikes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:steadfast_spikes\",\"count\":1}}},{\"text\":\": no knockback, no slipping on ice. \"},{\"text\":\"Kitty Slippers\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:kitty_slippers\",\"count\":1}}},{\"text\":\": creepers keep away and phantoms get hissed at.\"}]",
    "",
    "[\"\",{\"text\":\"Aqua-Dashers\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:aqua_dashers\",\"count\":1}}},{\"text\":\": sprint over water. \"},{\"text\":\"Flippers\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:flippers\",\"count\":1}}},{\"text\":\": swim 70% faster. \"},{\"text\":\"Snowshoes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:snowshoes\",\"count\":1}}},{\"text\":\": walk on powder snow. \"},{\"text\":\"Strider Shoes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:strider_shoes\",\"count\":1}}},{\"text\":\": stand on lava while sneaking, and hot floors don't burn. \"},{\"text\":\"Rooted Boots\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:rooted_boots\",\"count\":1}}},{\"text\":\": grass refills your hunger.\"}]"
  ],
  "task.327E35F07A4A46CD.title": "A head artifact",
  "task.28A9C76A3082F82C.title": "A necklace artifact",
  "task.3DB4B01936FE0427.title": "A belt artifact",
  "task.1C5618A6E961C0BD.title": "Two hand artifacts",
  "task.3B711BBBC66AC551.title": "A feet artifact",
  "quest.165707C003A15055.title": "The full kit",
  "quest.165707C003A15055.quest_subtitle": "Six slots, one very well-dressed adventurer.",
  "quest.165707C003A15055.quest_desc": [
    "Six artifacts for six slots: head, necklace, belt, both hands and feet. Two players in the same armor, two different ways of playing."
  ],
  "quest.6789ACB7F67F457E.title": "One way out",
  "quest.6789ACB7F67F457E.quest_subtitle": "Chorus fruit, in totem form.",
  "quest.6789ACB7F67F457E.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Chorus Totem\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:chorus_totem\",\"count\":1}}},{\"text\":\" turns a fatal hit into a random teleport and gives back 9 health, then breaks. End city treasure and woodland mansions are where it turns up most.\"}]"
  ],
  "quest.6D8ECD123CF696CB.title": "Swimming in the sky",
  "quest.6D8ECD123CF696CB.quest_subtitle": "A pool float with ambitions.",
  "quest.6D8ECD123CF696CB.quest_desc": [
    "[\"\",{\"text\":\"Midair, press \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sprint\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" (or \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"artifacts.key.helium_flamingo.activate\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\", if you give it a key) with the \"},{\"text\":\"Helium Flamingo\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:helium_flamingo\",\"count\":1}}},{\"text\":\" on and you swim through the air for 8 seconds; it recharges in 15. It's among the rarest artifacts: try End cities, ancient cities and stronghold corridors.\"}]"
  ],
  "quest.7AF56C4D1E7DA2DD.title": "Pearls on credit",
  "quest.7AF56C4D1E7DA2DD.quest_subtitle": "Your stomach pays for the teleport.",
  "quest.7AF56C4D1E7DA2DD.quest_desc": [
    "[\"\",{\"text\":\"With the \"},{\"text\":\"Warp Drive\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:warp_drive\",\"count\":1}}},{\"text\":\" on your belt, ender pearls aren't used up: each throw costs 2 hunger instead, and the landing doesn't hurt.\"}]"
  ],
  "task.7123EEEEC7824EE6.title": "Any retaliation pendant",
  "quest.493812FE65FF2579.title": "Pendants that hit back",
  "quest.493812FE65FF2579.quest_desc": [
    "[\"\",{\"text\":\"When something hits you, the \"},{\"text\":\"Thorn Pendant\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:thorn_pendant\",\"count\":1}}},{\"text\":\" hurts it back for 2 to 6 half the time, the \"},{\"text\":\"Flame Pendant\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:flame_pendant\",\"count\":1}}},{\"text\":\" sets it on fire 40% of the time and gives you Fire Resistance, and the \"},{\"text\":\"Shock Pendant\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:shock_pendant\",\"count\":1}}},{\"text\":\" calls lightning 25% of the time, which can't hurt you.\"}]"
  ],
  "quest.6297CBF0EC3921FD.title": "Rain or shine",
  "quest.6297CBF0EC3921FD.quest_subtitle": "An artifact for your hand, not a slot.",
  "quest.6297CBF0EC3921FD.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Umbrella\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:umbrella\",\"count\":1}}},{\"text\":\" goes in no slot: hold it to fall slowly, or raise it like a shield. Tanneries and buried treasure are where it turns up most.\"}]"
  ],
  "quest.5D491DCB10C0BB73.title": "Kit: the miner",
  "quest.5D491DCB10C0BB73.quest_subtitle": "Fortune first, furnace second.",
  "quest.5D491DCB10C0BB73.quest_desc": [
    "[\"\",{\"text\":\"Digging Claws\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:digging_claws\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Pickaxe Heater\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:pickaxe_heater\",\"count\":1}}},{\"text\":\" on your two hands, \"},{\"text\":\"Lucky Scarf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:lucky_scarf\",\"count\":1}}},{\"text\":\" on your neck. Fortune multiplies the raw ore first and the heater smelts every piece, so the extra drops come out as ingots.\"}]"
  ],
  "quest.12D8F4744412CBC1.title": "Kit: the diver",
  "quest.12D8F4744412CBC1.quest_subtitle": "Head, neck and feet, all underwater.",
  "quest.12D8F4744412CBC1.quest_desc": [
    "[\"\",{\"text\":\"Snorkel\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:snorkel\",\"count\":1}}},{\"text\":\" on your head, \"},{\"text\":\"Charm of Sinking\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:charm_of_sinking\",\"count\":1}}},{\"text\":\" on your neck, \"},{\"text\":\"Flippers\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:flippers\",\"count\":1}}},{\"text\":\" on your feet: you breathe longer, walk the sea floor, and swim 70% faster when you switch the charm off.\"}]"
  ],
  "quest.2928C122DE7C0385.title": "Kit: the jumper",
  "quest.2928C122DE7C0385.quest_subtitle": "What goes up comes down gently.",
  "quest.2928C122DE7C0385.quest_desc": [
    "[\"\",{\"text\":\"Cloud in a Bottle\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:cloud_in_a_bottle\",\"count\":1}}},{\"text\":\" on the belt and \"},{\"text\":\"Bunny Hoppers\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:bunny_hoppers\",\"count\":1}}},{\"text\":\" on your feet: the hoppers add 40% to your jump, the cloud gives you a second one, and together they let you fall 13 more blocks unharmed.\"}]"
  ],
  "quest.2BA3E27F99DBAC27.title": "Kit: the brawler",
  "quest.2BA3E27F99DBAC27.quest_subtitle": "Hit harder, heal more.",
  "quest.2BA3E27F99DBAC27.quest_desc": [
    "[\"\",{\"text\":\"A \"},{\"text\":\"Power Glove\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:power_glove\",\"count\":1}}},{\"text\":\" on one hand and a \"},{\"text\":\"Vampiric Glove\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:vampiric_glove\",\"count\":1}}},{\"text\":\" on the other: the extra 4 damage raises what the vampire drinks, a fifth of every melee hit, up to 6 health.\"}]"
  ],
  "quest.0D24D509EBE15121.title": "Kit: the Nether walker",
  "quest.0D24D509EBE15121.quest_subtitle": "Lava is a floor if you sneak.",
  "quest.0D24D509EBE15121.quest_desc": [
    "[\"\",{\"text\":\"Strider Shoes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:strider_shoes\",\"count\":1}}},{\"text\":\" let you stand on lava while sneaking and ignore magma floors; the \"},{\"text\":\"Obsidian Skull\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:obsidian_skull\",\"count\":1}}},{\"text\":\" answers your first burn with 30 seconds of Fire Resistance. Slip once and there's time to get out.\"}]"
  ],
  "quest.2666D84242EF8B60.title": "Kit: the hunter",
  "quest.2666D84242EF8B60.quest_subtitle": "More loot, more levels, same mob.",
  "quest.2666D84242EF8B60.quest_desc": [
    "[\"\",{\"text\":\"Superstitious Hat\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:superstitious_hat\",\"count\":1}}},{\"text\":\" on your head and \"},{\"text\":\"Golden Hook\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:golden_hook\",\"count\":1}}},{\"text\":\" on a hand: every mob you kill drops as if your sword had one more level of Looting, and half again as much experience.\"}]"
  ],
  "quest.31C55D21C98EC018.title": "Kit: the night owl",
  "quest.31C55D21C98EC018.quest_subtitle": "For builders who forget to sleep.",
  "quest.31C55D21C98EC018.quest_desc": [
    "[\"\",{\"text\":\"Night Vision Goggles\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:night_vision_goggles\",\"count\":1}}},{\"text\":\" on your head and \"},{\"text\":\"Kitty Slippers\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:kitty_slippers\",\"count\":1}}},{\"text\":\" on your feet: a little light in the dark, creepers that give you room, and phantoms hissed away before they dive.\"}]"
  ],
  "quest.0CA6B2C089D2ECF0.title": "Wear one, show another",
  "quest.0CA6B2C089D2ECF0.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Every Artifacts slot has a cosmetic twin, shown with the cosmetics button of the Curios screen. Put the hat you like there and the useful one in the real slot: only the real one works.\"}]"
  ],
  "quest.542BD69282313FD6.title": "Mind the piglins",
  "quest.542BD69282313FD6.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Piglins love gold, and that includes the \"},{\"text\":\"Golden Hook\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:golden_hook\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Cross Necklace\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:cross_necklace\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Antidote Vessel\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:antidote_vessel\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Universal Attractor\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:universal_attractor\",\"count\":1}}},{\"text\":\": drop one near them and they'll grab it.\"}]"
  ],
  "quest.0CF6BCA100209E87.title": "Adventurous Eater",
  "quest.0CF6BCA100209E87.quest_subtitle": "It was an Onion Ring. It was right there.",
  "quest.0CF6BCA100209E87.quest_desc": [
    "[\"\",{\"text\":\"You ate the \"},{\"text\":\"Onion Ring\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:onion_ring\",\"count\":1}}},{\"text\":\". It fills 2 hunger and it's gone for good, and the Haste II it gave you after every meal went with it.\"}]"
  ],
  "reward.002DA67D5E4BBCD0.title": "Secret found",
  "quest.1E6526840D08C082.title": "Comic relief",
  "quest.1E6526840D08C082.quest_subtitle": "Every sculk sensor in range heard that.",
  "quest.1E6526840D08C082.quest_desc": [
    "[\"\",{\"text\":\"The \"},{\"text\":\"Whoopee Cushion\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"artifacts:whoopee_cushion\",\"count\":1}}},{\"text\":\" fits any slot and does what you'd expect 12% of the times you sneak or double jump. Sculk sensors hear it. So does the Warden.\"}]"
  ],
  "reward.02161F9086E0EEAA.title": "Secret found",
  "image.235213AA8C5DD6A4.title": "[\"\",{\"text\":\"Where they hide\",\"color\":\"#F2C46B\"}]",
  "image.3640CE3618A954F7.title": "[\"\",{\"text\":\"Kits worth wearing\",\"color\":\"#F2C46B\"}]",
  "image.360875F10D9A7A91.title": "[\"\",{\"text\":\"One of a kind\",\"color\":\"#F2C46B\"}]",
  "image.2BAB85931382281A.title": "[\"\",{\"text\":\"Artifacts\",\"color\":\"#FFF1D6\",\"bold\":true}]",
  "image.39DA4EA75CA18E3E.title": "[\"\",{\"text\":\"find · wear · combine\",\"color\":\"#F2C46B\",\"font\":\"minecraft:uniform\"}]",
  "image.19B3EE05E4115120.title": "Back to the Sun of Heliodor",
  "image.201CFF51A33F5DEE.title": "[\"\",{\"text\":\"» Hostile Neural Networks\",\"color\":\"#F2C46B\"}]",
  "image.036FE14C8E2F3813.title": "[\"\",{\"text\":\"head\",\"color\":\"#F2C46B\"}]",
  "image.56B2B2531428893F.title": "[\"\",{\"text\":\"necklace\",\"color\":\"#F2C46B\"}]",
  "image.55B500E30CD834A3.title": "[\"\",{\"text\":\"belt\",\"color\":\"#F2C46B\"}]",
  "image.0E92605984AEE5D3.title": "[\"\",{\"text\":\"hands ×2\",\"color\":\"#F2C46B\"}]",
  "image.4C28F6C871BC5D4A.title": "[\"\",{\"text\":\"held\",\"color\":\"#F2C46B\"}]",
  "image.158765772F891F8D.title": "[\"\",{\"text\":\"feet\",\"color\":\"#F2C46B\"}]",
  "chapter.627817D1BBA5894F.title": "Creatures and Bosses",
  "chapter.627817D1BBA5894F.chapter_subtitle": [
    "A field guide to what lives out there, where it lives, and what it drops."
  ],
  "quest.1428DDF847B60627.title": "The training yard",
  "quest.1428DDF847B60627.quest_subtitle": "It never hits back. It judges in silence.",
  "quest.1428DDF847B60627.quest_desc": [
    "[\"\",{\"text\":\"Every hit on a \"},{\"text\":\"Target Dummy\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"dummmmmmy:target_dummy\",\"count\":1}}},{\"text\":\" shows its damage, with your \"},{\"text\":\"damage per second\",\"color\":\"#A8D86E\"},{\"text\":\" on top.\"}]",
    "",
    "It never dies, and hitting it never wears down your gear.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Recipe: a \"},{\"text\":\"Hay Bale\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:hay_block\",\"count\":1}}},{\"text\":\" on top of an \"},{\"text\":\"Armor Stand\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:armor_stand\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Compare weapons, enchantments and gems here, not in front of a boss."
  ],
  "quest.78842253312FABBA.title": "Dress it for the job",
  "quest.78842253312FABBA.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"What the dummy wears changes what it counts as.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Zombie Head\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:zombie_head\",\"count\":1}}},{\"text\":\" or \"},{\"text\":\"Skeleton Skull\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:skeleton_skull\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"undead\",\"color\":\"#A8D86E\"},{\"text\":\", so Smite bites.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Turtle Shell\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:turtle_helmet\",\"count\":1}}},{\"text\":\": aquatic, for Impaling.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Dragon Head\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:dragon_head\",\"count\":1}}},{\"text\":\": an \"},{\"text\":\"arthropod\",\"color\":\"#A8D86E\"},{\"text\":\". Nobody knows why.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• Any banner: \"},{\"text\":\"boss mode\",\"color\":\"#A8D86E\"},{\"text\":\", \"},{\"text\":\"200\",\"bold\":true},{\"text\":\" health and a boss bar.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Carved Pumpkin\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:carved_pumpkin\",\"count\":1}}},{\"text\":\": a scarecrow that keeps animals \"},{\"text\":\"12\",\"bold\":true},{\"text\":\" blocks away.\"}]"
  ],
  "task.3FE9D0290C1E3D3E.title": "Build a Copper Golem",
  "quest.5B073D11A6FC1137.title": "A copper golem",
  "quest.5B073D11A6FC1137.quest_subtitle": "Presses buttons. Loves it. Asks nothing.",
  "quest.5B073D11A6FC1137.quest_desc": [
    "[\"\",{\"text\":\"Stack a \"},{\"text\":\"Block of Copper\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:copper_block\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Carved Pumpkin\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:carved_pumpkin\",\"count\":1}}},{\"text\":\" and a \"},{\"text\":\"Lightning Rod\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:lightning_rod\",\"count\":1}}},{\"text\":\" pointing up.\"}]",
    "",
    "[\"\",{\"text\":\"It wanders off to press \"},{\"text\":\"Copper Buttons\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"friendsandfoes:copper_button\",\"count\":1}}},{\"text\":\": a redstone clock with legs.\"}]",
    "{@pagebreak}",
    "• Any oxidation stage works, waxed or not.",
    "",
    "[\"\",{\"text\":\"• A \"},{\"text\":\"Jack o'Lantern\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:jack_o_lantern\",\"count\":1}}},{\"text\":\" also works as the head.\"}]",
    "",
    "[\"\",{\"text\":\"• The Tuff Golem is \"},{\"text\":\"Tuff\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:tuff\",\"count\":1}}},{\"text\":\", wool and a pumpkin: it holds an item for you, and naps.\"}]"
  ],
  "quest.126217933E644739.title": "Keep the golem shiny",
  "quest.126217933E644739.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A copper golem oxidizes like copper does; fully oxidized, it freezes into a \"},{\"text\":\"statue\",\"color\":\"#A8D86E\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Honeycomb\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:honeycomb\",\"count\":1}}},{\"text\":\" waxes it, and an axe scrapes it back one stage.\"}]",
    "",
    "• A lightning strike heals it and, unless it's waxed, leaves it bright copper again."
  ],
  "task.6003866388318186.title": "Every kind of beehive",
  "quest.60C3B1526C40E530.title": "A beehive for every wood",
  "quest.60C3B1526C40E530.quest_subtitle": "Eleven woods, one very busy villager.",
  "quest.60C3B1526C40E530.quest_desc": [
    "[\"\",{\"text\":\"Friends&Foes adds the \"},{\"text\":\"Beekeeper\",\"color\":\"#A8D86E\"},{\"text\":\" villager, whose workstation is any \"},{\"text\":\"Beehive\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:beehive\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"It also adds a beehive for every wood: planks and three \"},{\"text\":\"Honeycomb\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:honeycomb\",\"count\":1}}},{\"text\":\" each.\"}]",
    "{@pagebreak}",
    "The beekeeper buys buttercups, dandelions and sunflowers for emeralds.",
    "",
    "[\"\",{\"text\":\"Get all eleven for \"},{\"text\":\"Be Keeper\",\"italic\":true},{\"text\":\".\"}]"
  ],
  "quest.25F90752659FC778.title": "A net for small things",
  "quest.25F90752659FC778.quest_subtitle": "Butterflies dread it. Snails don't notice.",
  "quest.25F90752659FC778.quest_desc": [
    "[\"\",{\"text\":\"Three \"},{\"text\":\"Bamboo\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:bamboo\",\"count\":1}}},{\"text\":\" and three \"},{\"text\":\"String\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:string\",\"count\":1}}},{\"text\":\" make a \"},{\"text\":\"Capture Net\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturalist:capture_net\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" on a small creature and it drops into your inventory, ready to release somewhere else.\"}]",
    "{@pagebreak}",
    "It catches:",
    "",
    "• butterflies, caterpillars, snails and ants",
    "",
    "• crabs, rats, hedgehogs and desert scorpions",
    "",
    "Fish and water critters still go in buckets."
  ],
  "quest.3267C60676392C44.title": "House rules",
  "quest.3267C60676392C44.quest_desc": [
    "No boss on this map gates the story: they're challenges, not doors.",
    "",
    "• The four Mowzie's bosses can't be boxed as spirits, carried or spawned by any machine.",
    "",
    "• Chests and barrels in these mods' structures roll once per player, through Lootr.",
    "{@pagebreak}",
    "These mods keep their own recipes: the pack changed none of them."
  ],
  "quest.65D3528A8F5F856A.title": "Gunpowder for the store",
  "quest.65D3528A8F5F856A.quest_subtitle": "Creepers: nature's gunpowder dispensers.",
  "quest.65D3528A8F5F856A.quest_desc": [
    "[\"\",{\"text\":\"Sixteen \"},{\"text\":\"Gunpowder\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:gunpowder\",\"count\":1}}},{\"text\":\" for the common store, once a day.\"}]",
    "",
    "Most camouflaged creepers still pay in powder; the bamboo ones pay in bamboo."
  ],
  "task.44AE266480E1D3E5.title": "Net a butterfly",
  "task.6BC6972EE3257D21.title": "Net a snail",
  "task.457294DA5C4A812B.title": "Spot a deer",
  "task.47BC8F970FB97F82.title": "Spot a bear",
  "task.601FC79AEA1F9666.title": "Spot a lion",
  "task.69907D7D71E394AB.title": "Spot an elephant",
  "quest.11386129FAD7C940.title": "Field notes: wildlife",
  "quest.11386129FAD7C940.quest_subtitle": "Real animals. Real teeth.",
  "quest.11386129FAD7C940.quest_desc": [
    "[\"\",{\"text\":\"Naturalist gives every biome its own animals: \"},{\"text\":\"bears\",\"color\":\"#A8D86E\"},{\"text\":\" and \"},{\"text\":\"deer\",\"color\":\"#A8D86E\"},{\"text\":\" in forests, \"},{\"text\":\"lions\",\"color\":\"#A8D86E\"},{\"text\":\" and \"},{\"text\":\"elephants\",\"color\":\"#A8D86E\"},{\"text\":\" on the savanna.\"}]",
    "",
    "Net two small ones, spot four big ones: that's the page.",
    "{@pagebreak}",
    "Where to look:",
    "",
    "• forests and taiga: bears, deer, boars, turkeys",
    "",
    "• savanna: lions, zebras, giraffes, elephants, rhinos",
    "",
    "• swamps and rivers: alligators, ducks, bass, catfish",
    "",
    "• oceans: whales, sharks, rays, jellyfish"
  ],
  "task.5A2230BB3964129F.title": "Spot a Glare",
  "task.5C59503E957C73C5.title": "Spot a Moobloom",
  "task.257FE944B538D660.title": "Spot a crab",
  "task.656ADEE13D329F9F.title": "Find a Rascal",
  "task.03A259954B120116.title": "Spot a Mauler",
  "quest.58D1BA3AF7E9C073.title": "Field notes: Friends and Foes",
  "quest.58D1BA3AF7E9C073.quest_subtitle": "Outvoted in the mob vote. Not in this world.",
  "quest.58D1BA3AF7E9C073.quest_desc": [
    "Five faces, friend or foe, each in its own corner of the world:",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Glare\",\"color\":\"#A8D86E\"},{\"text\":\": lush caves\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Moobloom\",\"color\":\"#A8D86E\"},{\"text\":\": flower forests, meadows, cherry groves\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Crab\",\"color\":\"#A8D86E\"},{\"text\":\": beaches and mangrove swamps\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Rascal\",\"color\":\"#A8D86E\"},{\"text\":\": underground, near mineshafts\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Mauler\",\"color\":\"#A8D86E\"},{\"text\":\": buried in deserts, badlands, savannas\"}]"
  ],
  "task.446D631813B918F3.title": "Spot a savanna enderman",
  "task.6F115D2C7A017E18.title": "Spot a desert enderman",
  "task.644CF6FE2ACF462F.title": "Spot a dark oak enderman",
  "task.5B8478944DB28B3D.title": "Spot a snowy enderman",
  "quest.56E3082B5DAADD68.title": "Field notes: endermen",
  "quest.56E3082B5DAADD68.quest_subtitle": "Looking counts. Looking also counts as rude.",
  "quest.56E3082B5DAADD68.quest_desc": [
    "Enderman Overhaul gives most biomes an enderman of its own and takes the plain one out.",
    "",
    "[\"\",{\"text\":\"To sketch one you have to look at it for a second. \"},{\"text\":\"It will take that personally.\",\"color\":\"#FF8C7A\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A \"},{\"text\":\"Carved Pumpkin\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:carved_pumpkin\",\"count\":1}}},{\"text\":\" on your head, or one of the overhaul's hoods, lets you stare in peace.\"}]",
    "",
    "Cave endermen carry ore instead of blocks, and drop coal, raw iron and the odd emerald."
  ],
  "task.64489EFA2A93BF3A.title": "Defeat a cave creeper",
  "task.44C8A1B655796A17.title": "Defeat a dark oak creeper",
  "task.1C498C3D60B8EAE2.title": "Defeat a desert creeper",
  "task.27A2AE97C4863813.title": "Defeat a savanna creeper",
  "quest.3F178A29219B7BE0.title": "Field notes: creepers",
  "quest.3F178A29219B7BE0.quest_subtitle": "Camouflage, now in sixteen flavors.",
  "quest.3F178A29219B7BE0.quest_desc": [
    "[\"\",{\"text\":\"Creeper Overhaul gives most biomes a creeper of its own, painted to blend in: \"},{\"text\":\"16\",\"bold\":true},{\"text\":\" kinds in all.\"}]",
    "",
    "Each one has a trick. Listen for the hiss before you look.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \"},{\"translate\":\"entity.creeperoverhaul.cave_creeper\",\"color\":\"#8FD6C8\"},{\"text\":\": finish it yourself and it may drop raw ore, even a diamond\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"translate\":\"entity.creeperoverhaul.dark_oak_creeper\",\"color\":\"#8FD6C8\"},{\"text\":\": its blast leaves you \"},{\"text\":\"blind\",\"color\":\"#A8D86E\"},{\"text\":\" for \"},{\"text\":\"5\",\"bold\":true},{\"text\":\" seconds\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"translate\":\"entity.creeperoverhaul.desert_creeper\",\"color\":\"#8FD6C8\"},{\"text\":\": carries a cactus you can shear off\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"translate\":\"entity.creeperoverhaul.savannah_creeper\",\"color\":\"#8FD6C8\"},{\"text\":\": throws punches before it blows\"}]"
  ],
  "task.43599FE4ED574091.title": "Spot a Foliaath",
  "task.3CE084AF415F5820.title": "Spot a Lantern",
  "task.07ECB64A07B2FC42.title": "Spot a Naga",
  "task.48B800277B8A7B83.title": "Spot an Umvuthana Raptor",
  "quest.243E8667C02EA066.title": "Field notes: Mowzie's Mobs",
  "quest.243E8667C02EA066.quest_subtitle": "Bring a pencil and a sword.",
  "quest.243E8667C02EA066.quest_desc": [
    "Four Mowzie's creatures to sketch before you meet their bosses:",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Foliaath\",\"color\":\"#A8D86E\"},{\"text\":\": a carnivorous plant hiding in jungle grass\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Lantern\",\"color\":\"#A8D86E\"},{\"text\":\": drifts through dark forests at night\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Naga\",\"color\":\"#A8D86E\"},{\"text\":\": a winged sea serpent over stony shores, at night\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Umvuthana Raptor\",\"color\":\"#A8D86E\"},{\"text\":\": leads masked hunting parties on the savanna\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Foliaath Seeds\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:foliaath_seed\",\"count\":1}}},{\"text\":\" grow a pet: plant one in grass and toss it meat every half day, for two days.\"}]",
    "",
    "[\"\",{\"text\":\"Lanterns drop \"},{\"text\":\"Luminous Jelly\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:glowing_jelly\",\"count\":1}}},{\"text\":\": eat it for a short burst of night vision.\"}]"
  ],
  "task.6D219A64FC6D7E7D.title": "An Umvuthana mask",
  "quest.7DFF71815AE64548.title": "A borrowed face",
  "quest.7DFF71815AE64548.quest_subtitle": "Nobody in the grove checks IDs.",
  "quest.7DFF71815AE64548.quest_desc": [
    "[\"\",{\"text\":\"Umvuthana drop the mask they wear \"},{\"text\":\"1 time in 3\",\"bold\":true},{\"text\":\", and grove chests keep a few.\"}]",
    "",
    "Worn, each mask grants an effect:",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Fury\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:umvuthana_mask_fury\",\"count\":1}}},{\"text\":\": Strength · \"},{\"text\":\"Fear\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:umvuthana_mask_fear\",\"count\":1}}},{\"text\":\": Speed · \"},{\"text\":\"Rage\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:umvuthana_mask_rage\",\"count\":1}}},{\"text\":\": Haste\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Bliss\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:umvuthana_mask_bliss\",\"count\":1}}},{\"text\":\": Jump Boost · \"},{\"text\":\"Misery\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:umvuthana_mask_misery\",\"count\":1}}},{\"text\":\": Resistance · \"},{\"text\":\"Faith\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:umvuthana_mask_faith\",\"count\":1}}},{\"text\":\": Health Boost\"}]",
    "{@pagebreak}",
    "With one on, the grove takes you for one of its own. That's how you get close to the Sunbird."
  ],
  "task.50734DB2E4BC473B.title": "Receive the Sun's Blessing",
  "quest.3C3360B975FDD608.title": "Heliomancer",
  "quest.3C3360B975FDD608.quest_subtitle": "Seven gold blocks and a borrowed face.",
  "quest.3C3360B975FDD608.quest_desc": [
    "[\"\",{\"text\":\"Wear a mask, walk up to Umvuthi while he's calm and \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" on him.\"}]",
    "",
    "[\"\",{\"text\":\"For \"},{\"text\":\"7\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Blocks of Gold\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:gold_block\",\"count\":1}}},{\"text\":\" he grants the \"},{\"text\":\"Sun's Blessing\",\"color\":\"#A8D86E\"},{\"text\":\": \"},{\"text\":\"60\",\"bold\":true},{\"text\":\" minutes of sun, and the clock only starts the first time you use it.\"}]",
    "{@pagebreak}",
    "With an empty hand:",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" on the ground: Sunstrike\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" + \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.attack\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\": Solar Flare, knocks everything back\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" + \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\": Solar Beam, \"},{\"text\":\"5\",\"bold\":true},{\"text\":\" minutes of blessing\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" + \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.attack\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" + \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\": Supernova, the whole blessing\"}]",
    "{@pagebreak}",
    "Come back later and he tops it up for free."
  ],
  "quest.5C7191A8A17D586B.title": "Leave Looting at home",
  "quest.5C7191A8A17D586B.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Masks and moon paws use odd numbers: with \"},{\"text\":\"Looting\",\"color\":\"#A8D86E\"},{\"text\":\", the drop chance goes \"},{\"text\":\"down\",\"color\":\"#FF8C7A\"},{\"text\":\".\"}]",
    "",
    "No Looting: 1 in 3. Looting I to III: 13 to 17%."
  ],
  "task.15EA53F8D0D185EA.title": "Defeat Umvuthi",
  "quest.74055B78138FF495.title": "Umvuthi, the Sunbird",
  "quest.74055B78138FF495.quest_subtitle": "Praise the Sun. Then duck.",
  "quest.74055B78138FF495.quest_desc": [
    "Umvuthi rules a savanna grove of masked Umvuthana, and fights with the sun itself.",
    "",
    "[\"\",{\"text\":\"Every \"},{\"text\":\"45\",\"bold\":true},{\"text\":\" health he loses, he calls healers: take the cranes out first.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"He drops the \"},{\"text\":\"Sol Visage\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:sol_visage\",\"count\":1}}},{\"text\":\", which never breaks. Wear it and \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" with another mask in hand to summon a follower, up to \"},{\"text\":\"10\",\"bold\":true},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" on a follower sends it back into its mask.\"}]"
  ],
  "quest.62A5116494EEDA19.title": "The Mauler piggy bank",
  "quest.62A5116494EEDA19.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A calm Mauler eats enchanted gear: \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" with an enchanted item or book and it swallows the \"},{\"text\":\"experience\",\"color\":\"#A8D86E\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"A \"},{\"text\":\"Glass Bottle\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:glass_bottle\",\"count\":1}}},{\"text\":\" gets it back as \"},{\"text\":\"Bottles o' Enchanting\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:experience_bottle\",\"count\":1}}},{\"text\":\", seven stored points each.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"It holds up to \"},{\"text\":\"1,395\",\"bold\":true},{\"text\":\" points and grows as it fills. An angry one won't fill bottles.\"}]"
  ],
  "task.2E77516F6758ADAE.title": "Any enderman hood",
  "quest.46128FFEEEFDAAD4.title": "A hood against stares",
  "quest.46128FFEEEFDAAD4.quest_subtitle": "A carved pumpkin, minus the pumpkin.",
  "quest.46128FFEEEFDAAD4.quest_desc": [
    "[\"\",{\"text\":\"Badlands, savanna and snowy endermen drop a hood \"},{\"text\":\"1 time in 10\",\"bold\":true},{\"text\":\", a little more with Looting.\"}]",
    "",
    "Wear it and you can look any enderman in the eye without a fight."
  ],
  "task.70B6DD2947FE420D.title": "Honeycomb for a bear",
  "task.6189372EE90E92E0.title": "Melon for a hippo",
  "task.1336A6ADA08E4B0D.title": "A map on a giraffe",
  "quest.3338024BEB688507.title": "Animal manners",
  "quest.3338024BEB688507.quest_subtitle": "Some animals have opinions about snacks.",
  "quest.3338024BEB688507.quest_desc": [
    "Three things Naturalist animals do when you treat them right:",
    "",
    "[\"\",{\"text\":\"• toss \"},{\"text\":\"Honeycomb\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:honeycomb\",\"count\":1}}},{\"text\":\" to an adult \"},{\"translate\":\"entity.naturalist.bear\",\"color\":\"#8FD6C8\"},{\"text\":\" (\"},{\"text\":\"Oh Bother\",\"italic\":true},{\"text\":\")\"}]",
    "",
    "[\"\",{\"text\":\"• feed a \"},{\"text\":\"Melon\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:melon\",\"count\":1}}},{\"text\":\" to a hippo (\"},{\"text\":\"Hungry Hungry Hippos\",\"italic\":true},{\"text\":\")\"}]",
    "",
    "[\"\",{\"text\":\"• ride a giraffe holding a \"},{\"text\":\"Map\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:filled_map\",\"count\":1}}},{\"text\":\": from up there the map reaches further (\"},{\"text\":\"A Whole New World\",\"italic\":true},{\"text\":\")\"}]"
  ],
  "task.25F91DBDF21FE211.title": "Any Elokosa paw",
  "quest.7C0A20130CB7B6F9.title": "Paws of the moon",
  "quest.7C0A20130CB7B6F9.quest_subtitle": "Collect all five phases. Or one. We won't judge.",
  "quest.7C0A20130CB7B6F9.quest_desc": [
    "Elokosa Howlers roam jungles and change shape at night.",
    "",
    "[\"\",{\"text\":\"They drop a paw \"},{\"text\":\"1 time in 3\",\"bold\":true},{\"text\":\", and the \"},{\"text\":\"moon\",\"color\":\"#A8D86E\"},{\"text\":\" picks which one.\"}]",
    "",
    "[\"\",{\"text\":\"Each paw casts its effect on nearby mobs for \"},{\"text\":\"30\",\"bold\":true},{\"text\":\" seconds: three uses, \"},{\"text\":\"90\",\"bold\":true},{\"text\":\" seconds apart.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Full\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:elokosa_paw_full\",\"count\":1}}},{\"text\":\": Weakness · \"},{\"text\":\"Gibbous\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:elokosa_paw_gibbous\",\"count\":1}}},{\"text\":\": Slowness · \"},{\"text\":\"Half\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:elokosa_paw_half\",\"count\":1}}},{\"text\":\": Mining Fatigue\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Crescent\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:elokosa_paw_crescent\",\"count\":1}}},{\"text\":\": Fragility, they take more damage\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"New\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:elokosa_paw_new\",\"count\":1}}},{\"text\":\", from the day form: Eclipse, which strips every effect while it lasts\"}]"
  ],
  "quest.66132E311AD3BBD4.title": "Wildlife that bites back",
  "quest.66132E311AD3BBD4.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Early on, give these a wide berth:\"}]",
    "",
    "• alligators in swamps and rivers; piranhas in jungle water",
    "",
    "• great white sharks in warm oceans",
    "",
    "• scorpions in deserts, badlands and jungles",
    "",
    "• lions and tigers",
    "",
    "• rhinos, which charge",
    "{@pagebreak}",
    "Predators hunt on their own too: lions chase zebras and boars, tigers go after deer."
  ],
  "quest.3252F91E012FD964.title": "Pearls with a personality",
  "quest.3252F91E012FD964.quest_subtitle": "Same throw, very different landing.",
  "quest.3252F91E012FD964.quest_desc": [
    "Some biome endermen drop their own pearl instead of the plain one:",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Icy Pearl\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"endermanoverhaul:icy_pearl\",\"count\":1}}},{\"text\":\" (ice spikes, snow): freezes whoever is near where it lands\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Summoner Pearl\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"endermanoverhaul:summoner_pearl\",\"count\":1}}},{\"text\":\" (swamps, windswept hills): teleports nearby targets\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Bubble Pearl\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"endermanoverhaul:bubble_pearl\",\"count\":1}}},{\"text\":\" (warm-ocean coral): flies straight, no gravity\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Any of them crafts back into a plain \"},{\"text\":\"Ender Pearl\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_pearl\",\"count\":1}}},{\"text\":\", or into an \"},{\"text\":\"Eye of Ender\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_eye\",\"count\":1}}},{\"text\":\" with \"},{\"text\":\"Blaze Powder\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:blaze_powder\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "task.5CC56CFBCFDB55F0.title": "Any froglass",
  "quest.5F323ACDE0DE72A7.title": "Frog food",
  "quest.5F323ACDE0DE72A7.quest_subtitle": "The dragonfly didn't make it. The glass did.",
  "quest.5F323ACDE0DE72A7.quest_desc": [
    "[\"\",{\"text\":\"A frog ate a dragonfly and left \"},{\"text\":\"froglass\",\"color\":\"#A8D86E\"},{\"text\":\" behind, the way frogs turn magma cubes into froglights.\"}]",
    "",
    "The glass takes the colour of the dragonfly."
  ],
  "reward.532E9C8BDB34F1A8.title": "Secret found",
  "task.7F8F28397A3CD3E7.title": "Shear a Moobloom",
  "quest.00B67316D5FAED27.title": "A cow in bloom",
  "quest.00B67316D5FAED27.quest_subtitle": "MooBoom is the advancement. We didn't pick the name.",
  "quest.00B67316D5FAED27.quest_desc": [
    "Mooblooms graze in flower forests and meadows with buttercups on their backs.",
    "",
    "[\"\",{\"text\":\"Shears\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:shears\",\"count\":1}}},{\"text\":\" turn one into a plain cow and five \"},{\"text\":\"Buttercups\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"friendsandfoes:buttercup\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "A bowl gets you suspicious stew, like a mooshroom's.",
    "",
    "[\"\",{\"text\":\"Buttercups\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"friendsandfoes:buttercup\",\"count\":1}}},{\"text\":\" make yellow dye, and the beekeeper buys them.\"}]"
  ],
  "quest.5E9E708CBED4A95A.title": "What wildlife leaves behind",
  "quest.5E9E708CBED4A95A.quest_subtitle": "Waste not. The bear would want it that way.",
  "quest.5E9E708CBED4A95A.quest_desc": [
    "Naturalist animals drop more than food:",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Hide\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturalist:hide\",\"count\":1}}},{\"text\":\" (boars, elephants, rhinos, komodos): smelts into \"},{\"text\":\"Leather\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:leather\",\"count\":1}}}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Antler\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturalist:antler\",\"count\":1}}},{\"text\":\" (deer): brews the \"},{\"text\":\"Forest Dasher\",\"color\":\"#A8D86E\"},{\"text\":\" potion\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Glow Goop\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturalist:glow_goop\",\"count\":1}}},{\"text\":\" (fireflies, or smelted glow berries): eight and an arrow make two spectral arrows\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"A \"},{\"text\":\"Scorpion Poison Gland\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturalist:scorpion_poison_gland\",\"count\":1}}},{\"text\":\" brews \"},{\"text\":\"Antivenom\",\"color\":\"#A8D86E\"},{\"text\":\"; both potions start from an awkward one.\"}]",
    "",
    "Fur, fat and teeth drop too: EMI shows what each is for."
  ],
  "quest.1CE8470ADDC57201.title": "A backpack for babies",
  "quest.1CE8470ADDC57201.quest_subtitle": "Terms and conditions: must be a baby.",
  "quest.1CE8470ADDC57201.quest_desc": [
    "[\"\",{\"text\":\"Three \"},{\"text\":\"Hide\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturalist:hide\",\"count\":1}}},{\"text\":\" make a \"},{\"text\":\"Knapsack\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturalist:knapsack\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" on any \"},{\"text\":\"baby\",\"color\":\"#A8D86E\"},{\"text\":\" animal to pack it.\"}]",
    "",
    "Use the knapsack on a block to let the little one out wherever the new pen is."
  ],
  "quest.6B1B66232164FC03.title": "Where did the pigs go?",
  "quest.6B1B66232164FC03.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Naturalist moves the farm animals around:\"}]",
    "",
    "• no pigs in forests",
    "",
    "• no cows, pigs, sheep or chickens in savannas and swamps",
    "",
    "Plains and meadows are still the place to start a farm."
  ],
  "task.3D1C42132DC6B99F.title": "A magician's totem",
  "quest.3164D53F6DE3EE38.title": "Totems of the magicians",
  "quest.3164D53F6DE3EE38.quest_subtitle": "Two illagers who skipped the raid to study magic.",
  "quest.3164D53F6DE3EE38.quest_desc": [
    "The Iceologer haunts cabins in snowy biomes; the Illusioner, shacks in the taiga.",
    "",
    "[\"\",{\"text\":\"Each always drops its totem, which fires when a hit leaves you under \"},{\"text\":\"half\",\"bold\":true},{\"text\":\" health:\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Totem of Freezing\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"friendsandfoes:totem_of_freezing\",\"count\":1}}},{\"text\":\": freezes everything nearby and gives you Speed\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Totem of Illusion\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"friendsandfoes:totem_of_illusion\",\"count\":1}}},{\"text\":\": fills the place with copies of you\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Friends&Foes adds a \"},{\"text\":\"charm\",\"color\":\"#A8D86E\"},{\"text\":\" slot for one totem, \"},{\"text\":\"Totem of Undying\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:totem_of_undying\",\"count\":1}}},{\"text\":\" included: it works there, hands free.\"}]"
  ],
  "task.7ACBEE8D4BE8D96B.title": "The three magicians",
  "quest.2769E179BE1CCD4C.title": "The Magicians",
  "quest.2769E179BE1CCD4C.quest_subtitle": "Three wizards walk into a raid.",
  "quest.2769E179BE1CCD4C.quest_desc": [
    "[\"\",{\"text\":\"Take down all three illager magicians: an \"},{\"text\":\"Evoker\",\"color\":\"#A8D86E\"},{\"text\":\", an \"},{\"text\":\"Iceologer\",\"color\":\"#A8D86E\"},{\"text\":\" and an \"},{\"text\":\"Illusioner\",\"color\":\"#A8D86E\"},{\"text\":\".\"}]",
    "",
    "Evokers come with raids and woodland mansions; the other two, from their cabins and shacks.",
    "{@pagebreak}",
    "Iceologers and Illusioners also join raids, so one big raid can bring all three."
  ],
  "task.0B65901AEA37AD3A.title": "Spring a zombie horse trap",
  "quest.4D7E479E3CE3737A.title": "Riders on the Storm",
  "quest.4D7E479E3CE3737A.quest_subtitle": "Some horses are not horses.",
  "quest.4D7E479E3CE3737A.quest_desc": [
    "In a thunderstorm, a lone zombie horse can be a trap: walk up to it and lightning brings its riders.",
    "",
    "[\"\",{\"text\":\"You found one the hard way. Friends&Foes sends its regards.\"}]"
  ],
  "reward.5C3C5D299A60E5B4.title": "Secret found",
  "quest.51525F2225F81724.title": "A claw for reach",
  "quest.51525F2225F81724.quest_subtitle": "Borrowed from a crab. Permanently.",
  "quest.51525F2225F81724.quest_desc": [
    "[\"\",{\"text\":\"Crabs on beaches and in mangrove swamps drop a \"},{\"text\":\"Crab Claw\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"friendsandfoes:crab_claw\",\"count\":1}}},{\"text\":\" every time.\"}]",
    "",
    "[\"\",{\"text\":\"Brewed into an awkward potion, it makes the \"},{\"text\":\"Potion of Reaching\",\"color\":\"#A8D86E\"},{\"text\":\": you place and break blocks from further away.\"}]",
    "{@pagebreak}",
    "Redstone makes it last, glowstone makes it reach further. Builders, this one is yours."
  ],
  "quest.2F3AD185B74C7469.title": "The flying Naga",
  "quest.2F3AD185B74C7469.quest_subtitle": "Not that Naga. This one has wings and a grudge.",
  "quest.2F3AD185B74C7469.quest_desc": [
    "[\"\",{\"text\":\"Nagas swoop over stony shores at night and spit acid. Some drop a \"},{\"text\":\"Naga Fang\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:naga_fang\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"The fang brews \"},{\"text\":\"Poison Resistance\",\"color\":\"#A8D86E\"},{\"text\":\" and makes a \"},{\"text\":\"Naga Fang Dagger\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:naga_fang_dagger\",\"count\":1}}},{\"text\":\": poison, and double damage from behind.\"}]"
  ],
  "quest.4FE73127292FE168.title": "Blowgun and darts",
  "quest.4FE73127292FE168.quest_subtitle": "Quiet, quick, and slightly rude.",
  "quest.4FE73127292FE168.quest_desc": [
    "[\"\",{\"text\":\"Three \"},{\"text\":\"Bamboo\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:bamboo\",\"count\":1}}},{\"text\":\" and two \"},{\"text\":\"String\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:string\",\"count\":1}}},{\"text\":\" make a \"},{\"text\":\"Blowgun\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:blowgun\",\"count\":1}}},{\"text\":\": quick to charge, short range.\"}]",
    "",
    "[\"\",{\"text\":\"It only fires \"},{\"text\":\"Darts\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:dart\",\"count\":1}}},{\"text\":\": a Naga Fang, a stick and a feather make eight, and each one poisons.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The Umvuthana's other weapon, the \"},{\"text\":\"Spear\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:spear\",\"count\":1}}},{\"text\":\" (flint, feather, two sticks), reaches \"},{\"text\":\"1.5\",\"bold\":true},{\"text\":\" blocks further.\"}]",
    "",
    "[\"\",{\"text\":\"One time in three, it fells an animal under \"},{\"text\":\"30\",\"bold\":true},{\"text\":\" health in a single hit.\"}]"
  ],
  "task.4C72F0FDAE2CC935.title": "Defeat an ocean creeper",
  "quest.3F078CEE9DCD646E.title": "The puffer that hisses",
  "quest.3F078CEE9DCD646E.quest_subtitle": "It's a pufferfish. It's a creeper. It's both.",
  "quest.3F078CEE9DCD646E.quest_desc": [
    "[\"\",{\"text\":\"Lukewarm and warm oceans hide the rarest creeper of all: a \"},{\"text\":\"pufferfish\",\"color\":\"#A8D86E\"},{\"text\":\" that learned to explode.\"}]",
    "",
    "You found one and you're still here. Well swum."
  ],
  "reward.04CF62792BC54225.title": "Secret found",
  "quest.4D40832BE582AB3E.title": "The Sculptor's fee",
  "quest.4D40832BE582AB3E.quest_subtitle": "A rod for a chance. Tongbi drives a hard bargain.",
  "quest.4D40832BE582AB3E.quest_desc": [
    "[\"\",{\"text\":\"Monasteries crown the highest peaks, between \"},{\"text\":\"Y 120\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"200\",\"bold\":true},{\"text\":\", and Bluffs guard them.\"}]",
    "",
    "[\"\",{\"text\":\"A Bluff you defeat may drop a \"},{\"text\":\"Bluff Rod\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:bluff_rod\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "It's the Sculptor's fee for his test, and it repairs geomancy gear.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Monastery chests also hide a \"},{\"text\":\"Sand Rake\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:sand_rake\",\"count\":1}}},{\"text\":\", for raking patterns into sand.\"}]"
  ],
  "task.4D8E03689B01BD44.title": "Pass the Sculptor's test",
  "quest.36297A349942A165.title": "Tongbi, the Sculptor",
  "quest.36297A349942A165.quest_subtitle": "You Must Believe. Also, you must not fly.",
  "quest.36297A349942A165.quest_desc": [
    "[\"\",{\"text\":\"Pay him a Bluff Rod and he raises a \"},{\"text\":\"60\",\"bold\":true},{\"text\":\"-block course of stone. Reach the top and \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" on him within \"},{\"text\":\"400\",\"bold\":true},{\"text\":\" seconds.\"}]",
    "",
    "[\"\",{\"text\":\"No placing or breaking blocks, no teleporting, no flying.\",\"color\":\"#FF8C7A\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Passing earns the \"},{\"text\":\"Earthrend Gauntlet\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:earthrend_gauntlet\",\"count\":1}}},{\"text\":\", which never breaks:\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" on the ground lifts a boulder; punch it to fire it\"}]",
    "",
    "[\"\",{\"text\":\"• hold \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" in the air to tunnel through the earth\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" + \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.jump\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" rides a rising pillar\"}]",
    "{@pagebreak}",
    "He leaves once you claim the prize. Want his gear? That fight comes first."
  ],
  "task.3595FB44E85481BB.title": "Any piece of geomancy gear",
  "quest.2721C04D9A366BAB.title": "Geomancer's gear",
  "quest.2721C04D9A366BAB.quest_subtitle": "Dress like the monk. Fight like the mountain.",
  "quest.2721C04D9A366BAB.quest_desc": [
    "Tongbi drops one piece at random; monastery chests hide the rest, rarely.",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Beads\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:geomancer_beads\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+3\",\"bold\":true},{\"text\":\" damage with bare fists and with the gauntlet\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Robe\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:geomancer_robe\",\"count\":1}}},{\"text\":\": sometimes raises a boulder when you hit or get hit\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Belt\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:geomancer_belt\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+4\",\"bold\":true},{\"text\":\" armor and knockback resistance while slowed\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Sandals\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:geomancer_sandals\",\"count\":1}}},{\"text\":\": a burst of speed after falling more than \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" blocks\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Geomancer Staff\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:sculptor_staff\",\"count\":1}}},{\"text\":\": three small rocks that fire where you look\"}]",
    "",
    "Bluff Rods repair all of it."
  ],
  "task.1FEC805D1D9AA085.title": "Fall during the test",
  "quest.40D7C9939219F31E.title": "No One Jumps for the Beef",
  "quest.40D7C9939219F31E.quest_subtitle": "Gravity: still undefeated.",
  "quest.40D7C9939219F31E.quest_desc": [
    "You fell to your death during the Sculptor's test. He saw. He did not approve.",
    "",
    "The course is patient. Try again with a steadier jump."
  ],
  "reward.38728A334B719DE4.title": "Secret found",
  "task.17BBEA432CDD75B6.title": "Defeat a Frostmaw",
  "quest.6FA6B0CE78579892.title": "The Frostmaw",
  "quest.6FA6B0CE78579892.quest_subtitle": "Rude awakening, for both of you.",
  "quest.6FA6B0CE78579892.quest_desc": [
    "A giant ice ape sleeps on snowy plains, slopes and ice spikes, never in forests or taiga.",
    "",
    "[\"\",{\"text\":\"Its breath and ice balls leave you \"},{\"text\":\"Frozen\",\"color\":\"#A8D86E\"},{\"text\":\": no moving, no swinging. Fire damage thaws you early.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Defeated with its crystal, it drops the \"},{\"text\":\"Ice Crystal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:ice_crystal\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Defeated in the rain without one, it drops a music disc instead."
  ],
  "quest.13F659BFAE72AC33.title": "Winter in your hand",
  "quest.13F659BFAE72AC33.quest_subtitle": "A portable blizzard. Batteries not included.",
  "quest.13F659BFAE72AC33.quest_desc": [
    "[\"\",{\"text\":\"Hold \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" with the \"},{\"text\":\"Ice Crystal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:ice_crystal\",\"count\":1}}},{\"text\":\" to channel an icy whirlwind that freezes what it hits.\"}]",
    "",
    "It never breaks: it drains while you use it and recharges in your inventory."
  ],
  "task.6C9A8A08F10E844F.title": "Steal an Ice Crystal",
  "quest.683BCF617C11427B.title": "Big Brain Time",
  "quest.683BCF617C11427B.quest_subtitle": "Why fight an ape when you can pickpocket it?",
  "quest.683BCF617C11427B.quest_desc": [
    "You took the crystal from a sleeping Frostmaw without a fight.",
    "",
    "[\"\",{\"text\":\"The trick: be \"},{\"text\":\"invisible\",\"color\":\"#A8D86E\"},{\"text\":\", walk up to the crystal by its hand and take it. It wakes up very upset.\"}]"
  ],
  "reward.15917027EB6D91D9.title": "Secret found",
  "task.20B2A73F102CF7D2.title": "Tame a Glare",
  "quest.57FA2F4D749C9AB2.title": "A Glare in the dark",
  "quest.57FA2F4D749C9AB2.quest_subtitle": "A grumpy torch-placement consultant. Paid in berries.",
  "quest.57FA2F4D749C9AB2.quest_desc": [
    "[\"\",{\"text\":\"Glares live in lush caves. Feed one \"},{\"text\":\"Glow Berries\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:glow_berries\",\"count\":1}}},{\"text\":\" and it's yours.\"}]",
    "",
    "[\"\",{\"text\":\"A tamed Glare follows you and grumbles at \"},{\"text\":\"dark spots\",\"color\":\"#A8D86E\"},{\"text\":\" where monsters could spawn: put a torch there.\"}]",
    "{@pagebreak}",
    "Wild ones shake glow berries off the vines, so don't leave a harvest near them."
  ],
  "task.76E9B57AD61B6FF6.title": "Win at hide and seek",
  "quest.473AD09B7CEAB75C.title": "Hide and seek",
  "quest.473AD09B7CEAB75C.quest_subtitle": "The only thing in a mineshaft that wants to play.",
  "quest.473AD09B7CEAB75C.quest_desc": [
    "Rascals hide around mineshafts. Find one and it nods, vanishes and hides again.",
    "",
    "[\"\",{\"text\":\"Find it \"},{\"text\":\"three\",\"bold\":true},{\"text\":\" times and it hands you a prize in a \"},{\"text\":\"Bundle\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:bundle\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The prize: an enchanted \"},{\"text\":\"Iron Pickaxe\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:iron_pickaxe\",\"count\":1}}},{\"text\":\", or a pile of iron or gold ore.\"}]"
  ],
  "quest.11706FB8D4B579EA.title": "Creepers that garden",
  "quest.11706FB8D4B579EA.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Some blasts leave something behind:\"}]",
    "",
    "[\"\",{\"text\":\"• spruce creepers turn a third of the grass and dirt into \"},{\"text\":\"Podzol\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:podzol\",\"count\":1}}}]",
    "",
    "[\"\",{\"text\":\"• mushroom creepers turn it into \"},{\"text\":\"Mycelium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:mycelium\",\"count\":1}}},{\"text\":\" and leave a \"},{\"text\":\"poison\",\"color\":\"#A8D86E\"},{\"text\":\" cloud\"}]",
    "",
    "[\"\",{\"text\":\"• cave creepers seed the odd \"},{\"text\":\"Coal Ore\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:coal_ore\",\"count\":1}}},{\"text\":\" into stone\"}]",
    "{@pagebreak}",
    "Not every creeper pays in gunpowder: bamboo ones drop bamboo, savanna ones acacia logs, snowy ones wool.",
    "",
    "[\"\",{\"text\":\"Shears on a desert or badlands creeper give a \"},{\"text\":\"Tiny Cactus\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"creeperoverhaul:tiny_cactus\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "task.5E1262D10BB7B4C3.title": "Defeat the Ferrous Wroughtnaut",
  "quest.1F8C4C21E5A2D724.title": "The Ferrous Wroughtnaut",
  "quest.1F8C4C21E5A2D724.quest_subtitle": "Just a flesh wound. Somewhere under all that iron.",
  "quest.1F8C4C21E5A2D724.quest_desc": [
    "[\"\",{\"text\":\"It sleeps in a Wrought Chamber, sealed in the stone between \"},{\"text\":\"Y 20\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"50\",\"bold\":true},{\"text\":\".\"}]",
    "",
    "Hits from the front ring off its armor.",
    "",
    "[\"\",{\"text\":\"Bait the overhead swing: while the axe is stuck in the floor, hit its \"},{\"text\":\"back\",\"color\":\"#A8D86E\"},{\"text\":\".\"}]",
    "{@pagebreak}",
    "It drops two pieces that never break:",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Axe of a Thousand Metals\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:wrought_axe\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" sweeps a wide arc; \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" + \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" slams a shockwave\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Wrought Helm\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:wrought_helmet\",\"count\":1}}}]"
  ],
  "quest.3C13B0F3899E2E8D.title": "No respawn cheese",
  "quest.3C13B0F3899E2E8D.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The Wroughtnaut, the Frostmaw and Umvuthi heal while they rest.\"}]",
    "",
    "Die and respawn nearby, and they're back to full health.",
    "",
    "Come prepared or come back rested: there's no wearing them down one life at a time."
  ],
  "task.7958373F76EA49CF.title": "Double Or Nothing!",
  "quest.5F3E5D75317D70D9.title": "Double or nothing",
  "quest.5F3E5D75317D70D9.quest_subtitle": "A rock with legs and a diamond problem.",
  "quest.5F3E5D75317D70D9.quest_desc": [
    "[\"\",{\"text\":\"Grottols crawl through caves below \"},{\"text\":\"Y 16\",\"bold\":true},{\"text\":\", crusted with diamonds, and run the moment they see you.\"}]",
    "",
    "[\"\",{\"text\":\"Only a pickaxe that can mine diamond cracks one, in a single hit. With \"},{\"text\":\"Fortune\",\"color\":\"#A8D86E\"},{\"text\":\" it pays extra diamonds.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"With \"},{\"text\":\"Silk Touch\",\"color\":\"#A8D86E\"},{\"text\":\" it comes out whole, as a \"},{\"text\":\"Captured Grottol\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mowziesmobs:captured_grottol\",\"count\":1}}},{\"text\":\". Smelting that gives a diamond. You monster.\"}]",
    "",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Grottols also turn up in the Envés. Pack the same pickaxe.\"}]"
  ],
  "quest.30F2EFA08BFE1214.title": "Nether pearls",
  "quest.30F2EFA08BFE1214.quest_subtitle": "Teleport in, come out swinging.",
  "quest.30F2EFA08BFE1214.quest_desc": [
    "Crimson, warped and soul sand valley endermen drop their own pearl:",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Crimson Pearl\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"endermanoverhaul:crimson_pearl\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"Strength II\",\"color\":\"#A8D86E\"},{\"text\":\" when you land\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Warped Pearl\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"endermanoverhaul:warped_pearl\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"Resistance II\",\"color\":\"#A8D86E\"},{\"text\":\" when you land\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Soul Pearl\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"endermanoverhaul:soul_pearl\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" + \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" binds a creature; the throw moves \"},{\"text\":\"it\",\"italic\":true},{\"text\":\", not you\"}]"
  ],
  "task.005E5A75708647A0.title": "Defeat the Wildfire",
  "quest.715470BADBA985D5.title": "The Wildfire",
  "quest.715470BADBA985D5.quest_subtitle": "A fortress? No, a citadel. With a landlord.",
  "quest.715470BADBA985D5.quest_desc": [
    "[\"\",{\"text\":\"Nether citadels hang above the lava, and a \"},{\"translate\":\"entity.friendsandfoes.wildfire\",\"color\":\"#8FD6C8\"},{\"text\":\" rules each one.\"}]",
    "",
    "It shields itself, fires barrages, summons blazes and knocks you back with a shockwave: bring fire resistance and a bow.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"It drops \"},{\"text\":\"3 to 5\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Wildfire Crown Fragments\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"friendsandfoes:wildfire_crown_fragment\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "The barrels around it hold diamonds, gold and iron, one roll per player through Lootr."
  ],
  "quest.215FC49D5FD50AF3.title": "Who's the new king?",
  "quest.215FC49D5FD50AF3.quest_subtitle": "Heavy is the head. Warm, too.",
  "quest.215FC49D5FD50AF3.quest_desc": [
    "[\"\",{\"text\":\"Five \"},{\"text\":\"Wildfire Crown Fragments\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"friendsandfoes:wildfire_crown_fragment\",\"count\":1}}},{\"text\":\" in a crown shape make the \"},{\"text\":\"Wildfire Crown\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"friendsandfoes:wildfire_crown\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"It's a helmet worth \"},{\"text\":\"3\",\"bold\":true},{\"text\":\" armor, and whenever you catch fire it gives you \"},{\"text\":\"Fire Resistance\",\"color\":\"#A8D86E\"},{\"text\":\".\"}]"
  ],
  "quest.6B546E821D9A722C.title": "Pearls from the End",
  "quest.6B546E821D9A722C.quest_subtitle": "The End endermen play by other rules.",
  "quest.6B546E821D9A722C.quest_desc": [
    "[\"\",{\"text\":\"End endermen drop \"},{\"text\":\"Corrupted Pearls\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"endermanoverhaul:corrupted_pearl\",\"count\":1}}},{\"text\":\": whatever they hit gets sent somewhere random.\"}]",
    "",
    "[\"\",{\"text\":\"Out on the far islands, \"},{\"text\":\"Ancient Pearls\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"endermanoverhaul:ancient_pearl\",\"count\":1}}},{\"text\":\" summon an enderman that fights \"},{\"text\":\"for\",\"color\":\"#A8D86E\"},{\"text\":\" you.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Rarely, End endermen also drop an \"},{\"text\":\"Enderman Tooth\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"endermanoverhaul:enderman_tooth\",\"count\":1}}},{\"text\":\":\"}]",
    "",
    "[\"\",{\"text\":\"• two teeth and a stick: the \"},{\"text\":\"Corrupted Blade\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"endermanoverhaul:corrupted_blade\",\"count\":1}}},{\"text\":\", which teleports what it hits\"}]",
    "",
    "[\"\",{\"text\":\"• four teeth and iron: the \"},{\"text\":\"Corrupted Shield\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"endermanoverhaul:corrupted_shield\",\"count\":1}}},{\"text\":\", which teleports whoever hits you\"}]"
  ],
  "image.0635F46614359E80.title": "[\"\",{\"text\":\"Coast and sea\",\"color\":\"#A8D86E\"}]",
  "image.42E111A1569E2E30.title": "[\"\",{\"text\":\"Woods and meadows\",\"color\":\"#A8D86E\"}]",
  "image.6EF2C994709609A8.title": "[\"\",{\"text\":\"Jungle and swamp\",\"color\":\"#A8D86E\"}]",
  "image.09472E6F765F446D.title": "[\"\",{\"text\":\"Savanna and desert\",\"color\":\"#A8D86E\"}]",
  "image.053C1F28AFC22FBB.title": "[\"\",{\"text\":\"Peaks and snow\",\"color\":\"#A8D86E\"}]",
  "image.3B41D72DA3827D89.title": "[\"\",{\"text\":\"Creatures and Bosses\",\"color\":\"#F4EBD2\",\"bold\":true}]",
  "image.0E4E3171CDC7F1CD.title": "Back to the Sun of Heliodor",
  "chapter.51039924B9EB1219.title": "Gear and Armor",
  "chapter.51039924B9EB1219.chapter_subtitle": [
    "From leather to the last set: what to wear act by act, and where each armory lives."
  ],
  "quest.7E7FE3DB307AD333.title": "Leather, head to toe",
  "quest.7E7FE3DB307AD333.quest_subtitle": "Cheap and cheerful, and a dye away from your colors.",
  "quest.7E7FE3DB307AD333.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Twenty-four leather make the whole set.\"}]",
    "",
    "[\"\",{\"text\":\"7\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E8B04A\"},{\"text\":\" armor points in all.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:leather\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Helmet \"},{\"text\":\"5\",\"color\":\"#E8B04A\"},{\"text\":\", chestplate \"},{\"text\":\"8\",\"color\":\"#E8B04A\"},{\"text\":\", leggings \"},{\"text\":\"7\",\"color\":\"#E8B04A\"},{\"text\":\" and boots \"},{\"text\":\"4\",\"color\":\"#E8B04A\"},{\"text\":\" leather\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Enchantability \"},{\"text\":\"15\",\"color\":\"#E8B04A\"},{\"text\":\", better than iron's \"},{\"text\":\"9\",\"color\":\"#E8B04A\"},{\"text\":\": only gold beats it\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:red_dye\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Any dye recolors it in a crafting grid\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Solsticio's textile shop sells \"},{\"text\":\"Leather\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:leather\",\"count\":1}}},{\"text\":\" at \"},{\"text\":\"6\",\"color\":\"#E8B04A\"},{\"text\":\" emeralds, up to eight at a time.\"}]"
  ],
  "quest.7B66E584AE08E8C5.title": "Iron, the working set",
