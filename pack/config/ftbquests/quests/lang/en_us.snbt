  "quest.359D104890F36751.title": "Draconic Bee",
  "quest.359D104890F36751.quest_subtitle": "Here be dragons, tiny ones.",
  "quest.359D104890F36751.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Rarely nests in the obsidian pillars of the main End island.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:draconic_dust\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Comb: \"},{\"text\":\"Draconic Dust\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:draconic_dust\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"30%\",\"bold\":true},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Breeds on \"},{\"text\":\"two\",\"bold\":true},{\"text\":\" draconic dust, not on flowers.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Gift:\",\"color\":\"#9BE08A\"},{\"text\":\" a second one, so you can breed a pair.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"A dragon egg and a beehive make a \"},{\"text\":\"Dragon Egg Hive\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:dragon_egg_hive\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "In the End, the Draconic Bees in it need no flowers."
  ],
  "quest.58D56C17350E1496.title": "Prismarine Bee",
  "quest.58D56C17350E1496.quest_subtitle": "Something's nibbling the bait.",
  "quest.58D56C17350E1496.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Fish in a deep ocean: each catch has a \"},{\"text\":\"5%\",\"bold\":true},{\"text\":\" chance to hook one.\"}]",
    "",
