    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Comb: \"},{\"text\":\"glowstone dust\",\"color\":\"#FFD84A\"},{\"text\":\", every time.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"With a \"},{\"text\":\"Chocolate Mining Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"66C20327F8782BDC\"}},{\"text\":\": a \"},{\"text\":\"Redstone Bee\",\"color\":\"#FFD84A\"},{\"text\":\".\"}]"
