  "quest.35A7864055AB52ED.title": "Pulsating Alloy",
  "quest.35A7864055AB52ED.quest_desc": [
    "[\"\",{\"text\":\"8\",\"bold\":true},{\"text\":\" essences give \"},{\"text\":\"3\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Pulsating Alloy Ingots\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"enderio:pulsating_alloy_ingot\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Seed: \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Pulsating Alloy Ingots\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"enderio:pulsating_alloy_ingot\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Imperium Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:imperium_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"tier 4\",\"color\":\"#C4DE52\"},{\"text\":\".\"}]"
