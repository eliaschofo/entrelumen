  "reward.49204578437ED904.title": "Secret found",
  "quest.2F85F12146928AC0.title": "Multitude",
  "quest.2F85F12146928AC0.quest_subtitle": "A crowd needs room.",
  "quest.2F85F12146928AC0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Multitude\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:augment_spawn_count\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+2\",\"color\":\"#FF8A3D\"},{\"text\":\" mobs per spawn.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Up to \"},{\"text\":\"16\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Raise \"},{\"text\":\"Crowd\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4FB1A25AAF21F61D\"}},{\"text\":\" with it, or the room fills and the spawner stops.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Core: a \"},{\"text\":\"Fermented Spider Eye\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:fermented_spider_eye\",\"count\":1}}},{\"text\":\" on an \"},{\"text\":\"Ecosystem Capsule\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:ecosystem_capsule\",\"count\":1}}},{\"text\":\", act IV.\"}]"
  ],
  "quest.4FB1A25AAF21F61D.title": "Crowd",
  "quest.4FB1A25AAF21F61D.quest_subtitle": "Standing room only.",
  "quest.4FB1A25AAF21F61D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Crowd\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:augment_max_nearby\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+2\",\"color\":\"#FF8A3D\"},{\"text\":\" mobs allowed nearby.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Up to \"},{\"text\":\"32\",\"color\":\"#FF8A3D\"},{\"text\":\". Only mobs of the spawner's own kind count.\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ghast_tear\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Core: a \"},{\"text\":\"Ghast Tear\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ghast_tear\",\"count\":1}}},{\"text\":\" on an \"},{\"text\":\"Ecosystem Capsule\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:ecosystem_capsule\",\"count\":1}}},{\"text\":\".\"}]"
  ],
