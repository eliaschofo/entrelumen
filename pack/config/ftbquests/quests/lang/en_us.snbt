    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:iron_ingot\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Helmet \"},{\"text\":\"5\",\"color\":\"#E8B04A\"},{\"text\":\", chestplate \"},{\"text\":\"8\",\"color\":\"#E8B04A\"},{\"text\":\", leggings \"},{\"text\":\"7\",\"color\":\"#E8B04A\"},{\"text\":\" and boots \"},{\"text\":\"4\",\"color\":\"#E8B04A\"},{\"text\":\" ingots\"}]",
