    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"justdirethings:ferricore_chestplate\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Just Dire Things: \"},{\"text\":\"Ferricore\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3C94D3074187F71D\"}},{\"text\":\", then Blazegold and Celestigem\"}]",
