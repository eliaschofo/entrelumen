  "quest.340D5AD3A86BC5F4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"On an \"},{\"text\":\"Infusion Altar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:infusion_altar\",\"count\":1}}},{\"text\":\": an \"},{\"text\":\"Imperium Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"23160F9F281E2E74\"}},{\"text\":\" egg, with four supremium blocks and four supremium essences around it.\"}]",
