    "",
    "[\"\",{\"text\":\"• Seed: \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Soularium Ingots\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"enderio:soularium_ingot\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Imperium Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:imperium_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"tier 4\",\"color\":\"#C4DE52\"},{\"text\":\".\"}]"
