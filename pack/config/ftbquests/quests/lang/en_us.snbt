    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:turtle_egg\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Core: a \"},{\"text\":\"Turtle Egg\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:turtle_egg\",\"count\":1}}},{\"text\":\" on a \"},{\"text\":\"Propagation Core\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:propagation_core\",\"count\":1}}},{\"text\":\".\"}]"
