    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:pointed_dripstone\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Core: \"},{\"text\":\"Pointed Dripstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:pointed_dripstone\",\"count\":1}}},{\"text\":\" on a \"},{\"text\":\"Spectral Lens\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:spectral_lens\",\"count\":1}}},{\"text\":\".\"}]"
