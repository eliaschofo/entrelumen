  "task.70B581AC6181ABC9.title": "Any second life",
  "quest.1420E6D2867191CA.title": "Staying alive",
  "quest.1420E6D2867191CA.quest_subtitle": "Dying is optional. Mostly.",
  "quest.1420E6D2867191CA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A second life is cheaper than a better set.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:totem_of_undying\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Totem of Undying: evokers drop it, and Solsticio sells one for \"},{\"text\":\"12\",\"color\":\"#E8B04A\"},{\"text\":\" emerald blocks from act V\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"friendsandfoes:totem_of_freezing\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Totems of Freezing and Illusion\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3164D53F6DE3EE38\"}},{\"text\":\", dropped by the cabin magicians\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"twilightforest:charm_of_life_1\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Charms of Life and Keeping\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"258FDDFEE1E8F9DE\"}},{\"text\":\" from Twilight\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Life Shards\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7D711A8074032A49\"}},{\"text\":\": a permanent heart each\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Also the \"},{\"text\":\"Chorus Totem\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6789ACB7F67F457E\"}},{\"text\":\", the \"},{\"text\":\"Ring of Last Chance\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"688C721A5A7E5C04\"}},{\"text\":\" and the \"},{\"text\":\"Cursium armor\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3B8B713EF44059EF\"}}]"
  ],
  "quest.23CAAA5BB61ABC15.title": "Affix loot: color and salvage",
  "quest.23CAAA5BB61ABC15.quest_subtitle": "Read before you sell.",
  "quest.23CAAA5BB61ABC15.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Gear drops with a rarity color and random affixes: hover to read them.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Rarity climbs from Common to Mythic; each tier is a color\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Break what you won't wear at a \"},{\"text\":\"Salvaging Table\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apotheosis:salvaging_table\",\"count\":1}}},{\"text\":\" for rarity materials\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Smithing keeps every affix: an Epic diamond sword stays Epic as netherite, and as Luminous\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Read the colour\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3B2622C422A7A223\"}},{\"text\":\", \"},{\"text\":\"Salvage everything\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"01CA501717FC9BB8\"}},{\"text\":\" and \"},{\"text\":\"Armor affixes\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"55AE4A81A90A4719\"}},{\"text\":\" go deeper.\"}]"
  ],
  "quest.3FDA107F53BB433C.title": "The story sets the difficulty",
  "quest.3FDA107F53BB433C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Your team's act sets the World Tier, and it never drops.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Haven for acts I and II, then Frontier, Ascent, Summit and Pinnacle\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Invaders show up from Frontier; Mythic loot from Summit\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"The whole ladder: \"},{\"text\":\"World Tiers\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"073625DCC50D40F5\"}}]"
  ],
  "quest.15958DC766C4F2B9.title": "Read the numbers",
  "quest.15958DC766C4F2B9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three mods explain armor without a calculator.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Equipment Compare: hover a piece to set it against what you wear; \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"equipmentcompare.key.showTooltips\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" shows the comparison\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Overloaded Armor Bar: draws armor levels above diamond's \"},{\"text\":\"20\",\"color\":\"#E8B04A\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"AttributeFix: lifts the vanilla attribute caps, so a set of \"},{\"text\":\"60\",\"color\":\"#E8B04A\"},{\"text\":\" counts\"}]"
  ],
  "quest.6D553D7AA84D7933.title": "Test your damage",
  "quest.6D553D7AA84D7933.quest_subtitle": "The dummy does not judge. Much.",
  "quest.6D553D7AA84D7933.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Before a boss, swing at \"},{\"text\":\"the training yard\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1428DDF847B60627\"}},{\"text\":\": the dummy floats every hit and reports your DPS.\"}]"
  ],
  "quest.06791F6F2111D74A.title": "Enchant, then upgrade",
  "quest.06791F6F2111D74A.quest_subtitle": "The smithing table forgets nothing.",
  "quest.06791F6F2111D74A.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Smithing carries enchantments, affixes, gems, name and wear onto the new piece: enchant and repair the diamond set first, and it follows you to netherite and to Luminous.\"}]"
  ],
  "task.06198734F074B082.title": "Any Silent Gear armor piece",
  "quest.65AB29354AB93A83.title": "Silent Gear armor",
  "quest.65AB29354AB93A83.quest_subtitle": "Every plate is your call.",
  "quest.65AB29354AB93A83.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"You pick the material of each plate, so no two sets match.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Plates and \"},{\"text\":\"linings\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5B5C817F70E95ED8\"}},{\"text\":\": the lining adds a trait\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:iron_chestplate\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Vanilla pieces convert: leather, iron, gold, diamond and netherite chestplates all have a recipe\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"The whole act I chapter: \"},{\"text\":\"Silent Gear\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5C9D01E144F06F5A\"}}]"
  ],
  "quest.17E3BDA7D7B3BF96.title": "Ars Nouveau robes",
  "quest.17E3BDA7D7B3BF96.quest_subtitle": "Armor you enchant with thread.",
  "quest.17E3BDA7D7B3BF96.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Robes are armor with thread slots.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Three cuts, from most slots to most armor: \"},{\"text\":\"Three cuts of robe\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0B32EE7DA07573F6\"}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Threads go on at the Alteration Table: \"},{\"text\":\"The tailor's bench\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"23F0756ADB690ACD\"}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"An Undying thread cancels one death per sleep, like a totem: \"},{\"text\":\"Threads that keep you going\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"034005479D041AB1\"}}]"
  ],
  "quest.5314A542EEAD47F1.title": "Iron's Spells robes",
  "quest.5314A542EEAD47F1.quest_subtitle": "The pointy hat is optional. Mostly.",
  "quest.5314A542EEAD47F1.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Wizard robes are the blank canvas for every school of magic.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Each piece adds max mana and spell power\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"A rune turns a robe into school armor: \"},{\"text\":\"Shadow-Walker\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"67357F1DEA4D674E\"}},{\"text\":\", \"},{\"text\":\"Cultist\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0CB62D92B5694C3F\"}},{\"text\":\" and \"},{\"text\":\"Plagued\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"35B78B120361E1C1\"}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Start at \"},{\"text\":\"Wizard robes\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4C06564A76AECE57\"}}]"
  ],
  "quest.242873D4885517AA.title": "Twilight Forest armor",
  "quest.242873D4885517AA.quest_subtitle": "Half a dozen sets, each with a quirk.",
  "quest.242873D4885517AA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Ironwood comes enchanted from the crafting table.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Protection I on the chestplate, Aqua Affinity on the helmet and Feather Falling I on the boots\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"twilightforest:phantom_chestplate\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Phantom armor is never lost on death; Fiery armor burns attackers\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Arctic armor takes any dye: \"},{\"text\":\"Ironwood\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"138D86C2F19F6F21\"}},{\"text\":\", \"},{\"text\":\"Naga\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2343281F0BF397DB\"}},{\"text\":\" and \"},{\"text\":\"Traveller's gear\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"396813E5E068791C\"}}]"
  ],
  "quest.7DB166E897FDC2AB.title": "Undergarden armor",
  "quest.7DB166E897FDC2AB.quest_subtitle": "Two metals from the Depths.",
  "quest.7DB166E897FDC2AB.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Cloggrum first, then Froststeel: the Undergarden's own metals.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"undergarden:cloggrum_chestplate\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Cloggrum boots keep Scintling goo from slowing you down\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Froststeel weapons slow whoever they hit\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Cloggrum\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"40EB69CE87614288\"}},{\"text\":\" and \"},{\"text\":\"Froststeel\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7CBD631CC072C48F\"}},{\"text\":\" have their own nodes\"}]"
  ],
  "quest.788E5565E45D6DD6.title": "Aether armor",
  "quest.788E5565E45D6DD6.quest_subtitle": "Parachutes are for other people.",
  "quest.788E5565E45D6DD6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Gravitite makes falling somebody else's problem.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Higher jumps and no fall damage: \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.aether.gravitite_jump_ability.desc\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" activates the jump\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Valkyrie gear from the Silver Dungeon grants temporary flight\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Phoenix gloves turn to obsidian if you stand in water: \"},{\"text\":\"Defying gravity\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"34AAA2ACF2827249\"}},{\"text\":\", \"},{\"text\":\"Earning your wings\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4F744B0263CA523A\"}}]"
  ],
  "quest.1A8232A238AAF33B.title": "Warden gear",
  "quest.1A8232A238AAF33B.quest_subtitle": "Netherite, but it listens.",
  "quest.1A8232A238AAF33B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Netherite plus a template and a reinforced shard.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"The template hides in ancient city chests and the Ancient Temple's secret room\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Copy it: \"},{\"text\":\"7\",\"color\":\"#E8B04A\"},{\"text\":\" diamonds, a \"},{\"text\":\"Sculk\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:sculk\",\"count\":1}}},{\"text\":\" block and the template make \"},{\"text\":\"2\",\"color\":\"#E8B04A\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"More in \"},{\"text\":\"Warden gear\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0C808CA553F23E84\"}},{\"text\":\" and \"},{\"text\":\"The Warden template\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1B244410D18EF7C9\"}}]"
  ],
  "quest.754E78E658B8E4CB.title": "Mekanism Tools armor",
  "quest.754E78E658B8E4CB.quest_subtitle": "The mod itself says better than netherite.",
  "quest.754E78E658B8E4CB.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Refined obsidian is the set Mekanism Tools calls better than netherite.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Osmium, bronze and steel come earlier; refined obsidian comes from the Osmium Compressor\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"More armor types\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6A64E9D3DE5163E4\"}},{\"text\":\" and \"},{\"text\":\"Better than netherite\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"75B83911CB666CA7\"}}]"
  ],
  "quest.33F18681DB66F833.title": "Eternal Starlight armor",
  "quest.33F18681DB66F833.quest_subtitle": "Silver lining, literally.",
  "quest.33F18681DB66F833.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Every set here does something to whoever hits you.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Deepsilver armor grants immunity to specific negative effects\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Glacite armor freezes enemies when you take damage\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Deepsilver\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"081780CA9258CB29\"}},{\"text\":\", \"},{\"text\":\"Glacite\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"102D52E6E6159A98\"}},{\"text\":\" and \"},{\"text\":\"Unrealium\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"16FDCDD39224D764\"}},{\"text\":\" have their own nodes\"}]"
  ],
  "quest.2D2F517F8FEC1E48.title": "Ignitium armor",
  "quest.2D2F517F8FEC1E48.quest_subtitle": "Fireproof is an understatement.",
  "quest.2D2F517F8FEC1E48.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Netherite plus a boss's metal and a template for every piece.\"}]",
    "",
    "[\"\",{\"text\":\"32\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E8B04A\"},{\"text\":\" armor points.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Gaze of Heat brands what is near, Flame Reflex sets attackers alight and the boots walk on lava\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Details in \"},{\"text\":\"Ignitium armor\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"054BFB74FABFC49C\"}},{\"text\":\"; \"},{\"text\":\"Wings of ignitium\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5BA28D1851ACF891\"}},{\"text\":\" fuse it with an elytra\"}]"
  ],
  "quest.4AEB8CA115B87359.title": "Netherite Space Suit",
  "quest.4AEB8CA115B87359.quest_subtitle": "Doom Slayer, heat edition.",
  "quest.4AEB8CA115B87359.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Venus and Mercury burn anyone without it.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Permanent fire resistance and more protection than the plain space suit\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Before those planets you need the armor itself; the \"},{\"text\":\"Jet Suit\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"647B411C0A583890\"}},{\"text\":\" adds flight\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Its own node: \"},{\"text\":\"Netherite Space Suit\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6164BA6BB34CC619\"}}]"
  ],
  "quest.7D6AE5D9B946A6A4.title": "Draconic Evolution armor",
  "quest.7D6AE5D9B946A6A4.quest_subtitle": "It is a computer that stops bullets.",
  "quest.7D6AE5D9B946A6A4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"One chestpiece, and every module you slot in is the armor.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Wyvern, Draconic and Chaotic tiers: each one fused from the last\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Modules add flight, shields and even an undying totem: \"},{\"text\":\"Wyvern\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"596EBD6A3A451C55\"}},{\"text\":\", \"},{\"text\":\"Draconic\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1AF5529C2E6667ED\"}},{\"text\":\" and \"},{\"text\":\"Chaotic\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"118F626BC2BDFBC0\"}}]"
  ],
  "quest.3795775FF3283BEF.title": "MekaSuit and quantum armor",
  "quest.3795775FF3283BEF.quest_subtitle": "Netherite, but make it electric.",
  "quest.3795775FF3283BEF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The top tech suits wait for act VI.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Each piece takes a Luminosity: Engineering for the MekaSuit, Logistics for Advanced AE's quantum armor, Habitation for Modern Industrialization's\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"MekaSuit\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3B4B14B5E1EC074D\"}},{\"text\":\", \"},{\"text\":\"Advanced AE's network suit\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"79AE6322C80A6B72\"}},{\"text\":\" and \"},{\"text\":\"quantum armor\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0557FB3BF06083E3\"}}]"
  ],
  "quest.4AAC9FF434B9D2EF.title": "Light as a rabbit",
  "quest.4AAC9FF434B9D2EF.quest_subtitle": "The leather boots earn their keep.",
  "quest.4AAC9FF434B9D2EF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Leather boots walk on powder snow without sinking.\"}]",
    "",
    "The cheapest boots in the game are the only vanilla pair that can do it."
  ],
  "reward.202A11C7FEC83113.title": "Secret found",
  "quest.052EEAD73D8599EC.title": "Not today, thank you",
  "quest.052EEAD73D8599EC.quest_subtitle": "Boing.",
  "quest.052EEAD73D8599EC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Any projectile counts, blocked with a shield.\"}]",
    "",
    "An arrow, a fireball or a trident: raise it before the hit lands."
  ],
  "reward.4D995A33D01BCB2D.title": "Secret found",
  "quest.31FCC4F7BA4DFEC3.title": "Smithing with style",
  "quest.31FCC4F7BA4DFEC3.quest_subtitle": "Eight patterns, one very well-dressed hero.",
  "quest.31FCC4F7BA4DFEC3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Apply Spire, Snout, Rib, Ward, Silence, Vex, Tide and Wayfinder once each.\"}]",
    "",
    "Tide comes from an elder guardian and Spire from an End city, so plan the trip."
  ],
  "reward.5E8FEF85D68C4326.title": "Secret found",
  "quest.37B1B6996DBCA90C.title": "Scrap for the common store",
  "quest.37B1B6996DBCA90C.quest_subtitle": "Somebody is always one ingot short.",
  "quest.37B1B6996DBCA90C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"For the common store, once a day.\"}]",
    "",
    "[\"\",{\"text\":\"4\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E8B04A\"},{\"text\":\" \"},{\"text\":\"Netherite Scrap\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:netherite_scrap\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Four scraps and the next crafter has an ingot."
  ],
  "quest.71F0F07F5E3B0F22.title": "Ring the anvil",
  "quest.71F0F07F5E3B0F22.quest_subtitle": "Clang.",
  "quest.71F0F07F5E3B0F22.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Every forge needs a hammer's worth of noise.\"}]",
    "",
    "Nothing to smith. Just sparks."
  ],
