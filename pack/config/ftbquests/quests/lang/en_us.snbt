  "chapter.78409D0F30264A4E.title": "Apotheosis · Enchanting",
  "chapter.78409D0F30264A4E.chapter_subtitle": [
    "Eterna, Quanta and Arcana: the table climbs with your World Tier, shelf by shelf, from 45 to 100. Infusions, tomes, the new enchantments and the Atlas Library that writes what it reaches."
  ],
  "task.0F05332E5318A580.title": "Enchant at level 100",
  "quest.28822DE1AC98F8F1.title": "Level 100",
  "quest.28822DE1AC98F8F1.quest_subtitle": "Fifteen bookshelves were the tutorial.",
  "quest.28822DE1AC98F8F1.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Enchant with the table at its full \"},{\"text\":\"100\",\"color\":\"#FF8A3D\"},{\"text\":\" Eterna.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Summit lifts the last ceiling as act V opens.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Two ways up: a \"},{\"text\":\"Draconic Endshelf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:draconic_endshelf\",\"count\":1}}},{\"text\":\" on top of \"},{\"text\":\"90\",\"color\":\"#FF8A3D\"},{\"text\":\", or a ring of \"},{\"text\":\"Horizon Shelves\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:horizon_shelf\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.7E61A14FE07F9DB9.title": "The table, rewritten",
  "quest.7E61A14FE07F9DB9.quest_subtitle": "Same obsidian, new math.",
  "quest.7E61A14FE07F9DB9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Your \"},{\"text\":\"Enchanting Table\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:enchanting_table\",\"count\":1}}},{\"text\":\" now reads three stats.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Eterna\",\"color\":\"#FF8A3D\"},{\"text\":\", \"},{\"text\":\"Quanta\",\"color\":\"#FF8A3D\"},{\"text\":\" and \"},{\"text\":\"Arcana\",\"color\":\"#FF8A3D\"},{\"text\":\" show under the three offers.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Past level \"},{\"text\":\"30\",\"color\":\"#FF8A3D\"},{\"text\":\" it wants better shelves than bookshelves.\"}]"
  ],
  "quest.35FE1B0A8FA6BB5C.title": "Fifteen bookshelves",
  "quest.35FE1B0A8FA6BB5C.quest_subtitle": "The classic ring.",
  "quest.35FE1B0A8FA6BB5C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Each \"},{\"text\":\"Bookshelf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:bookshelf\",\"count\":1}}},{\"text\":\" adds \"},{\"text\":\"2\",\"color\":\"#FF8A3D\"},{\"text\":\" Eterna, up to \"},{\"text\":\"30\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"It counts two blocks from the table, with air in between.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"The ring has \"},{\"text\":\"32\",\"color\":\"#FF8A3D\"},{\"text\":\" spots over two layers: room left for candles and skulls.\"}]"
  ],
  "task.2DE8F61AE455E37D.title": "Enchant at level 30",
  "quest.2D9BB1DF1EF19BDD.title": "Level 30",
  "quest.2D9BB1DF1EF19BDD.quest_subtitle": "Where vanilla tops out.",
  "quest.2D9BB1DF1EF19BDD.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Fifteen bookshelves: the vanilla top.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Eterna \"},{\"text\":\"is\",\"italic\":true},{\"text\":\" the top offer's level.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Better shelves go further, up to your World Tier: Haven stops at \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]"
  ],
  "quest.3D47F1C2F57025F4.title": "The question mark",
  "quest.3D47F1C2F57025F4.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"With an item in the table, click the question mark at the top right.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Every enchantment each slot can roll, with level and odds.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"What each one excludes, and a slider to try other power levels.\"}]"
  ],
  "task.6E801477F0E31E70.title": "Enchant with 10 of each stat",
  "quest.025856A8FAADDE9F.title": "Eterna, Quanta, Arcana",
  "quest.025856A8FAADDE9F.quest_subtitle": "Three bars, three moods.",
  "quest.025856A8FAADDE9F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three bars, three jobs.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Eterna\",\"color\":\"#FF8A3D\"},{\"text\":\" sets the level.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Quanta\",\"color\":\"#FF8A3D\"},{\"text\":\" swings each roll up or down; the table alone gives \"},{\"text\":\"15%\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Arcana\",\"color\":\"#FF8A3D\"},{\"text\":\" favours the rare ones: \"},{\"text\":\"25%\",\"color\":\"#FF8A3D\"},{\"text\":\" guarantees two enchantments, \"},{\"text\":\"75%\",\"color\":\"#FF8A3D\"},{\"text\":\" three.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"More than shelves feed them: \"},{\"text\":\"candles and skulls\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"636DB5A0F7C32171\"}},{\"text\":\".\"}]"
  ],
  "task.11F3B5435EB0DA82.title": "Any four candles",
  "quest.636DB5A0F7C32171.title": "Not only shelves",
  "quest.636DB5A0F7C32171.quest_subtitle": "Mood lighting counts.",
  "quest.636DB5A0F7C32171.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Other blocks in the ring tune the table too.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:candle\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Each \"},{\"text\":\"Candle\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:candle\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+1.25\",\"color\":\"#FF8A3D\"},{\"text\":\" Arcana.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"A \"},{\"text\":\"skull\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:skeleton_skull\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+5\",\"color\":\"#FF8A3D\"},{\"text\":\" Quanta; a \"},{\"text\":\"wither skull\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:wither_skeleton_skull\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"+10\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"An \"},{\"text\":\"Amethyst Cluster\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:amethyst_cluster\",\"count\":1}}},{\"text\":\": +\"},{\"text\":\"1\",\"color\":\"#FF8A3D\"},{\"text\":\" Eterna up to \"},{\"text\":\"40\",\"color\":\"#FF8A3D\"},{\"text\":\", \"},{\"text\":\"-1 Quanta\",\"color\":\"#FF8C7A\"},{\"text\":\".\"}]"
  ],
  "quest.296483B1183E3B16.title": "The tier sets the ceiling",
  "quest.296483B1183E3B16.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Your World Tier caps the Eterna the table uses.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Haven \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\" · Frontier \"},{\"text\":\"75\",\"color\":\"#FF8A3D\"},{\"text\":\" · Ascent \"},{\"text\":\"90\",\"color\":\"#FF8A3D\"},{\"text\":\" · Summit \"},{\"text\":\"100\",\"color\":\"#FF8A3D\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Each ceiling is what that act's shelves reach. The table says when it holds you back.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The whole climb: \"},{\"text\":\"Apotheosis · Adventure\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"48BC3B6935A4143B\"}},{\"text\":\".\"}]"
  ],
  "quest.43E2479B7B06CBCB.title": "Same offers, same seed",
  "quest.43E2479B7B06CBCB.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The three offers only change when you enchant something.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Don't like them? Enchant a book in the cheapest slot and look again.\"}]"
  ],
  "quest.43344AD478B35363.title": "The Cartographer's Shelf",
  "quest.43344AD478B35363.quest_subtitle": "Made from what a mapmaker keeps on the desk.",
  "quest.43344AD478B35363.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Act II's shelf: \"},{\"text\":\"+3\",\"color\":\"#FF8A3D\"},{\"text\":\" Eterna, up to \"},{\"text\":\"40\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Past a bookshelf, and Haven's ceiling already lets it count.\"}]",
    "{@pagebreak}",
    "Two per craft:",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Four planks\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:map\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Two \"},{\"text\":\"Empty Maps\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:map\",\"count\":1}}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Two bookshelves\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:calibration_frame\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A \"},{\"text\":\"Calibration Frame\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:calibration_frame\",\"count\":1}}}]"
  ],
  "quest.1D8AB1AA11FFFBC3.title": "Hellshelves",
  "quest.1D8AB1AA11FFFBC3.quest_subtitle": "Books with a Nether tan.",
  "quest.1D8AB1AA11FFFBC3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Hellshelf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:hellshelf\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+3\",\"color\":\"#FF8A3D\"},{\"text\":\" Eterna up to \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\", \"},{\"text\":\"+3\",\"color\":\"#FF8A3D\"},{\"text\":\" Quanta.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Five lift a table from \"},{\"text\":\"30\",\"color\":\"#FF8A3D\"},{\"text\":\" to \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\", the Haven ceiling.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Six \"},{\"text\":\"Nether Bricks\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:nether_bricks\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Blaze Rod\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:blaze_rod\",\"count\":1}}},{\"text\":\", a bookshelf and a Potion of Regeneration.\"}]"
  ],
  "quest.26250DBD6915A9BB.title": "Seashelves",
  "quest.26250DBD6915A9BB.quest_subtitle": "Salt water, now in book form.",
  "quest.26250DBD6915A9BB.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Seashelf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:seashelf\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+3\",\"color\":\"#FF8A3D\"},{\"text\":\" Eterna up to \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\", \"},{\"text\":\"+3\",\"color\":\"#FF8A3D\"},{\"text\":\" Arcana.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"The root of the lumen and filtering shelves.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Six \"},{\"text\":\"Prismarine Bricks\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:prismarine_bricks\",\"count\":1}}},{\"text\":\", water, a bookshelf and a \"},{\"text\":\"Pufferfish\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:pufferfish\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"No pufferfish? Four bamboo around any fish make a “Pufferfish” that works.\"}]"
  ],
  "quest.22E1C3ED5D785AC2.title": "Infusion",
  "quest.22E1C3ED5D785AC2.quest_subtitle": "Crafting, but the table does the mixing.",
  "quest.22E1C3ED5D785AC2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Some items change in the table's third slot.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"When Eterna, Quanta and Arcana sit inside a recipe's range, the slot lights up.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"A Hellshelf at \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\" Eterna, \"},{\"text\":\"30\",\"color\":\"#FF8A3D\"},{\"text\":\" Quanta: an \"},{\"text\":\"Infused Hellshelf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:infused_hellshelf\",\"count\":1}}},{\"text\":\", +\"},{\"text\":\"5\",\"color\":\"#FF8A3D\"},{\"text\":\" Eterna up to \"},{\"text\":\"60\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Haven's \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\" already allows it.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"The Eterna past \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\" counts once Frontier lifts the ceiling.\"}]",
    "",
    "EMI lists every infusion with its ranges, maximums included."
  ],
  "quest.424C145C052E00D4.title": "The sea, infused",
