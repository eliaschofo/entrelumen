    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Parent of obsidian and the BreezBee.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Gift:\",\"color\":\"#9BE08A\"},{\"text\":\" a second one, so you can breed a pair.\"}]"
  ],
  "quest.1F84810AFA66B236.title": "Slimy Bee",
  "quest.1F84810AFA66B236.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Lives in the \"},{\"text\":\"Slimy Nest\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:slimy_nest\",\"count\":1}}},{\"text\":\", only in swamps.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:slime_ball\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Comb: \"},{\"text\":\"Slimeball\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:slime_ball\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"20%\",\"bold\":true},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"With a \"},{\"text\":\"Diamond Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"66ED5066B2E23522\"}},{\"text\":\": an \"},{\"text\":\"Emerald Bee\",\"color\":\"#FFD84A\"},{\"text\":\".\"}]"
  ],
  "quest.6F469C669CE00789.title": "Sugarbag Bee",
  "quest.6F469C669CE00789.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Break cocoa pods: \"},{\"text\":\"2%\",\"bold\":true},{\"text\":\" of the time a Sugarbag Bee flies out.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:sugarbag_honeycomb\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Its comb, \"},{\"text\":\"Sugarbag Honeycomb\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:sugarbag_honeycomb\",\"count\":1}}},{\"text\":\", comes \"},{\"text\":\"30%\",\"bold\":true},{\"text\":\" of trips.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Gift:\",\"color\":\"#9BE08A\"},{\"text\":\" a second one, so you can breed a pair.\"}]"
  ],
  "task.07268C6BA07FE66C.title": "Amber Bee spawn egg",
  "quest.05594A3B95BAAF25.title": "Amber Bee",
  "quest.05594A3B95BAAF25.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Brush \"},{\"text\":\"Suspicious Sand\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:suspicious_sand\",\"count\":1}}},{\"text\":\" in cold ocean ruins: \"},{\"text\":\"8%\",\"bold\":true},{\"text\":\" of it holds an Amber Bee egg.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"It seals mobs in amber, and turns honey blocks into petrified honey.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Gift:\",\"color\":\"#9BE08A\"},{\"text\":\" a second one, so you can breed a pair.\"}]"
  ],
  "task.4FBE08F121349ADC.title": "Sussy Bee spawn egg",
  "quest.791AB92C630AB9C9.title": "Sussy Bee",
  "quest.791AB92C630AB9C9.quest_subtitle": "Emergency meeting at the hive.",
  "quest.791AB92C630AB9C9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A sniffer digging for seeds turns up a Sussy Bee egg \"},{\"text\":\"15%\",\"bold\":true},{\"text\":\" of the time.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"It turns sand and gravel suspicious: an archaeology farm.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Gift:\",\"color\":\"#9BE08A\"},{\"text\":\" a second one, so you can breed a pair.\"}]"
  ],
  "task.1513A599645887EF.title": "Ribbeet spawn egg",
  "quest.2E76EFBE7A126F2C.title": "Ribbeet",
  "quest.2E76EFBE7A126F2C.quest_subtitle": "Circle of life, with a croak.",
  "quest.2E76EFBE7A126F2C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A frog that eats a bee leaves a Ribbeet egg behind.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"It pollinates magma cubes and brings home froglights.\"}]"
  ],
  "reward.17BAC5F9DA524B1B.title": "Secret found",
  "quest.1646033728559B21.title": "Her Royal Beeness",
  "quest.1646033728559B21.quest_subtitle": "Kneel before the hive.",
  "quest.1646033728559B21.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Trade a \"},{\"text\":\"Royal Jelly Bucket\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"the_bumblezone:royal_jelly_bucket\",\"count\":1}}},{\"text\":\" to the Bee Queen in the Bumblezone for its egg.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Comb: \"},{\"text\":\"10 mB\",\"bold\":true},{\"text\":\" of royal jelly. It breeds on royal jelly bottles.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Gift:\",\"color\":\"#9BE08A\"},{\"text\":\" a second one for another hive; this species will not pair up.\"}]"
  ],
  "quest.3152454A3DAF1728.title": "The first cross",
  "quest.3152454A3DAF1728.quest_subtitle": "Two carpenters walk into a log.",
  "quest.3152454A3DAF1728.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two different bees, a flower each: their baby can be a new species.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Try a \"},{\"text\":\"Yellow Carpenter Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4F4FB5A0D8756EEC\"}},{\"text\":\" with a \"},{\"text\":\"Green Carpenter Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2CD2E768671626DC\"}},{\"text\":\": a \"},{\"text\":\"Lumber Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1002A9D2E2DDB3ED\"}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Any worker counts: Lumber, Rancher, Quarry or Farmer.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Reward:\",\"color\":\"#9BE08A\"},{\"text\":\" eight honey treats; a treat grows a baby faster.\"}]",
    "{@pagebreak}",
    "When a pair fits several recipes, each birth picks one at random.",
    "",
    "A pair with no recipe gives its own kind, if that species breeds with itself."
  ],
  "quest.631D1DB8B25062CC.title": "The Crystalline Bee",
  "quest.631D1DB8B25062CC.quest_subtitle": "Every metal starts in the Nether.",
  "quest.631D1DB8B25062CC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Place a \"},{\"text\":\"Quartz Nest\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:nether_quartz_nest\",\"count\":1}}},{\"text\":\" in the Nether and cage the bee that moves in.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Comb: \"},{\"text\":\"nether quartz\",\"color\":\"#FFD84A\"},{\"text\":\", \"},{\"text\":\"50%\",\"bold\":true},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"With an \"},{\"text\":\"Ashy Mining Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"072FAF991DFA455F\"}},{\"text\":\": iron, copper, tin or aluminum.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Reward:\",\"color\":\"#9BE08A\"},{\"text\":\" an Ashy Mining Bee egg for that cross, and a random \"},{\"text\":\"perfect gene\",\"color\":\"#FFD84A\"},{\"text\":\".\"}]"
  ],
  "quest.0B7D5340E1851DD0.title": "The Iron Bee",
  "quest.0B7D5340E1851DD0.quest_subtitle": "Mining, outsourced.",
  "quest.0B7D5340E1851DD0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Cross a \"},{\"text\":\"Crystalline Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"631D1DB8B25062CC\"}},{\"text\":\" with an \"},{\"text\":\"Ashy Mining Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"072FAF991DFA455F\"}},{\"text\":\" until an Iron Bee hatches.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"1 in 4\",\"bold\":true},{\"text\":\" of those crosses; the others give copper, tin or aluminum.\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:raw_iron\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Comb: \"},{\"text\":\"Raw Iron\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:raw_iron\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"40%\",\"bold\":true},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Gift:\",\"color\":\"#9BE08A\"},{\"text\":\" a second Iron Bee, and a random \"},{\"text\":\"perfect gene\",\"color\":\"#FFD84A\"},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Half of \"},{\"text\":\"the metal combs\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"371A2EC6CA5746A5\"}},{\"text\":\" has it for a parent.\"}]",
    "",
    "[\"\",{\"text\":\"Working a chipped anvil, it mends it one step \"},{\"text\":\"70%\",\"bold\":true},{\"text\":\" of the time.\"}]"
  ],
  "task.753ED335A4B7F1C8.title": "Look at a CreeBee",
  "quest.05F05DFFB67B931B.title": "The first mutation",
  "quest.05F05DFFB67B931B.quest_subtitle": "Handle with care. Seriously.",
  "quest.05F05DFFB67B931B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Feed a vanilla bee a block of \"},{\"text\":\"TNT\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:tnt\",\"count\":1}}},{\"text\":\": it turns into a CreeBee on the spot.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"It explodes when angered.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Its \"},{\"text\":\"Powdery Comb\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:honeycomb_powdery\",\"count\":1}}},{\"text\":\" gives gunpowder \"},{\"text\":\"50%\",\"bold\":true},{\"text\":\" of the time.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Reward:\",\"color\":\"#9BE08A\"},{\"text\":\" a random \"},{\"text\":\"perfect gene\",\"color\":\"#FFD84A\"},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Some species are fed, not bred.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Feeding changes a bee now.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Breeding only changes the next generation.\"}]"
  ],
  "quest.3B94F90648E02063.title": "Redstone Bee",
  "quest.3B94F90648E02063.quest_subtitle": "Escape artist.",
  "quest.3B94F90648E02063.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Cross a \"},{\"text\":\"Glowing Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"11C2F8166C465BE5\"}},{\"text\":\" with a \"},{\"text\":\"Chocolate Mining Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"66C20327F8782BDC\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:redstone\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Comb: \"},{\"text\":\"Redstone Dust\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:redstone\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"50%\",\"bold\":true},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"With a \"},{\"text\":\"Blue Banded Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5D465DDC3AE835E1\"}},{\"text\":\": a \"},{\"text\":\"Lapis Bee\",\"color\":\"#FFD84A\"},{\"text\":\", on the way to diamond.\"}]"
  ],
  "quest.66ED5066B2E23522.title": "The Diamond Bee",
  "quest.66ED5066B2E23522.quest_subtitle": "The gem line pays off.",
  "quest.66ED5066B2E23522.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Cross an \"},{\"text\":\"Ender Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1176AE6DA3431D93\"}},{\"text\":\" with a \"},{\"text\":\"Lapis Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"49AEEF82C53217C0\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Comb: \"},{\"text\":\"Diamond\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"20%\",\"bold\":true},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Parent of emerald, titanium and three gem mutations.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Reward:\",\"color\":\"#9BE08A\"},{\"text\":\" a random \"},{\"text\":\"perfect gene\",\"color\":\"#FFD84A\"},{\"text\":\".\"}]"
  ],
  "quest.5A702645B25D0E1B.title": "Melittologist",
  "quest.5A702645B25D0E1B.quest_subtitle": "A diploma no university hands out.",
  "quest.5A702645B25D0E1B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Breed each vanilla-material bee at least once.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Iron, gold, coal, redstone, lapis, emerald, diamond.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"BlazBee, experience, frosty and obsidian.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Dye, Lumber, Rancher, Quarry and Farmer.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Reward:\",\"color\":\"#9BE08A\"},{\"text\":\" a \"},{\"text\":\"perfect gene\",\"color\":\"#FFD84A\"},{\"text\":\" of your choice.\"}]",
    "{@pagebreak}",
    "Frosty Bees come from feeding: breed two of them together. Obsidian comes from Lava and Water."
  ],
  "task.6EB63EBCB6A7FCDE.title": "Look at a Lumber Bee",
  "quest.1002A9D2E2DDB3ED.title": "Lumber Bee",
  "quest.1002A9D2E2DDB3ED.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Cross a \"},{\"text\":\"Yellow Carpenter Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4F4FB5A0D8756EEC\"}},{\"text\":\" with a \"},{\"text\":\"Green Carpenter Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2CD2E768671626DC\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"It nibbles logs and brings home wood chips of them.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"Parent of the Rancher, the Farmer and plastic.\"}]"
  ],
  "task.1FA9E8D3F8065D2C.title": "Look at a Rancher Bee",
  "quest.4AC5D5805597A3E8.title": "Rancher Bee",
  "quest.4AC5D5805597A3E8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Cross a \"},{\"text\":\"Lumber Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1002A9D2E2DDB3ED\"}},{\"text\":\" with a \"},{\"text\":\"Sweat Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1B644226D8C15624\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"It milks cows and shears sheep; its \"},{\"text\":\"Milky Comb\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:honeycomb_milky\",\"count\":1}}},{\"text\":\" spins into milk.\"}]"
  ],
  "task.41CE32A76D101854.title": "Look at a Quarry Bee",
  "quest.23ADE5C988C9E272.title": "Quarry Bee",
  "quest.23ADE5C988C9E272.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Cross a \"},{\"text\":\"Chocolate Mining Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"66C20327F8782BDC\"}},{\"text\":\" with a \"},{\"text\":\"Digger Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"137C7C80584F0AB2\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"It nibbles stone, sand and gravel and brings home chips of them.\"}]"
  ],
  "task.1F467A7DC07EFF9A.title": "Look at a Farmer Bee",
  "quest.03E51503917647EC.title": "Farmer Bee",
  "quest.03E51503917647EC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Cross a \"},{\"text\":\"Lumber Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1002A9D2E2DDB3ED\"}},{\"text\":\" with a \"},{\"text\":\"Rancher Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4AC5D5805597A3E8\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"It harvests ripe crops \"},{\"text\":\"four\",\"bold\":true},{\"text\":\" blocks around its hive; range upgrades reach further.\"}]"
  ],
  "task.517050472CBE545B.title": "Look at a CuBee",
  "quest.4FB3C3DF12B6EA53.title": "CuBee",
  "quest.4FB3C3DF12B6EA53.quest_subtitle": "Love is in the air. So is pollen.",
  "quest.4FB3C3DF12B6EA53.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Cross a \"},{\"text\":\"Farmer Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"03E51503917647EC\"}},{\"text\":\" with a \"},{\"text\":\"Rancher Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4AC5D5805597A3E8\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"It makes nearby animals breed, up to \"},{\"text\":\"five\",\"bold\":true},{\"text\":\" a trip.\"}]"
  ],
  "task.1A2DFDDCBDB01634.title": "Look at a Dye Bee",
  "quest.79D583F98A8A93A7.title": "Dye Bee",
  "quest.79D583F98A8A93A7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Cross a \"},{\"text\":\"Lapis Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"49AEEF82C53217C0\"}},{\"text\":\" with a \"},{\"text\":\"Skeletal Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6DA616955F068A6F\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"It brings home the dye of each flower it visits.\"}]"
  ],
  "task.5F4B6A1C8D9CF908.title": "Look at a Collector Bee",
  "quest.24872C4EB21026DC.title": "Collector Bee",
  "quest.24872C4EB21026DC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Feed a vanilla bee a \"},{\"text\":\"Hopper\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:hopper\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"It picks up items left on the ground and stores them in its hive.\"}]"
  ],
  "task.1AC6E53D7145D25C.title": "Look at a Hoarder Bee",
  "quest.19AC2DC74F1A9608.title": "Hoarder Bee",
  "quest.19AC2DC74F1A9608.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Feed a \"},{\"text\":\"Collector Bee\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"24872C4EB21026DC\"}},{\"text\":\" a \"},{\"text\":\"Shulker Shell\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:shulker_shell\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FFD84A\"},{\"text\":\"It collects like a Collector, but carries more.\"}]",
