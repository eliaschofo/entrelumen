    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"undergarden:forgotten_upgrade_smithing_template\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"The Undergarden: \"},{\"text\":\"Forgotten\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"61947CE83E83349C\"}}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"eternal_starlight:starfire_upgrade_smithing_template\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Eternal Starlight: \"},{\"text\":\"Starfire\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"36A55CF0D5551254\"}},{\"text\":\" and \"},{\"text\":\"Flowglaze\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1D7F8D4997F971B3\"}}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ae2:fluix_upgrade_smithing_template\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"AE2: the \"},{\"text\":\"Fluix upgrade\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4BFC33B61517567A\"}},{\"text\":\"; Silent Gear: \"},{\"text\":\"coating\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4415040BB26C2147\"}}]"
  ],
  "quest.5361C7F7A2A980B5.title": "Keep your look",
  "quest.5361C7F7A2A980B5.quest_subtitle": "Saving the world is no excuse to dress badly.",
  "quest.5361C7F7A2A980B5.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Wear the protection you need and show the armor you like.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"A second, cosmetic set: \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"cos.key.opencosarmorinventory\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" opens its screen\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Trims work on any armor in the trimmable tag, mods' armor included\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Artifacts slots have cosmetic twins too: \"},{\"text\":\"Wear one, show another\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0CA6B2C089D2ECF0\"}}]"
  ],
  "task.07C5DEEA8EDC9E82.title": "Armor for a horse or a wolf",
  "quest.453EA7959A695E02.title": "Armor for horses and wolves",
  "quest.453EA7959A695E02.quest_subtitle": "Even the dog gets an upgrade.",
  "quest.453EA7959A695E02.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Mounts and pets have an armor slot of their own.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:armadillo_scute\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Wolf armor: six \"},{\"text\":\"armadillo scutes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:armadillo_scute\",\"count\":1}}},{\"text\":\", brushed off armadillos; it gives \"},{\"text\":\"11\",\"color\":\"#E8B04A\"},{\"text\":\" armor and mends with more scutes\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:leather_horse_armor\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Horse armor: leather is craftable (\"},{\"text\":\"3\",\"color\":\"#E8B04A\"},{\"text\":\" armor); iron \"},{\"text\":\"5\",\"color\":\"#E8B04A\"},{\"text\":\", gold \"},{\"text\":\"7\",\"color\":\"#E8B04A\"},{\"text\":\" and diamond \"},{\"text\":\"11\",\"color\":\"#E8B04A\"},{\"text\":\" only turn up in chests\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Chests with horse armor: dungeons, desert and jungle temples, strongholds, nether fortresses and End cities.\"}]"
  ],
  "quest.452BC0DA17EE27F2.title": "Wings, if you can afford them",
  "quest.452BC0DA17EE27F2.quest_subtitle": "The End's one real souvenir.",
  "quest.452BC0DA17EE27F2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The only vanilla wings sit in an End city.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"A ship in the city keeps one in an item frame\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:phantom_membrane\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Phantom Membranes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:phantom_membrane\",\"count\":1}}},{\"text\":\" mend it; durability \"},{\"text\":\"432\",\"color\":\"#E8B04A\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Solsticio's rarities dealer sells one for \"},{\"text\":\"32\",\"color\":\"#E8B04A\"},{\"text\":\" emerald blocks, from act VI\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Fuse it into armor: \"},{\"text\":\"Ignitium wings\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5BA28D1851ACF891\"}},{\"text\":\", \"},{\"text\":\"Silent Gear's own\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"685B2A281F930398\"}},{\"text\":\" or \"},{\"text\":\"the HDPE-reinforced one\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1C956AD8E29B52C3\"}},{\"text\":\".\"}]"
  ],
  "task.7ED1D6F3A8163DD5.title": "Any water-breathing helmet",
