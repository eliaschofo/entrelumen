  "image.258E2678B1EE2FA0.title": "Upgrade templates from mods",
  "image.2CFEA089EA24739A.title": "Upgrade templates from mods",
  "image.2C2786B1658B91C7.title": "Upgrade templates from mods",
  "image.1D19C8BB750022E1.title": "Upgrade templates from mods",
  "image.20B85A101B4D9C9A.title": "Upgrade templates from mods",
  "image.4D9EE008678246C6.title": "Upgrade templates from mods",
  "image.095B2798058D00C0.title": "Upgrade templates from mods",
  "image.461777128F4106A0.title": "Upgrade templates from mods",
  "chapter.1ED9F916E33F7AC8.title": "Structures and exploration",
  "chapter.1ED9F916E33F7AC8.chapter_subtitle": [
    "What each structure mod adds, what is worth looting and why every player gets their own chest."
  ],
  "quest.74D96402A467B05B.title": "A chest of your own",
  "quest.74D96402A467B05B.quest_subtitle": "Arriving second is no longer arriving last.",
  "quest.74D96402A467B05B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Every player opens their own copy of a structure's loot.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Chests, barrels, shulkers and trapped chests\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Mineshaft minecarts, item frames and decorated pots\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Suspicious sand and gravel\"}]",
    "",
    "Nobody empties it before you, and you empty it for nobody.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"What lands inside is each structure's own loot table, so other mods' rewards turn up too.\"}]",
    "",
    "Your first one is worth 'X' Marks the Spot."
  ],
  "quest.296E4C9B99FD4B9E.title": "Twenty-five and counting",
  "quest.296E4C9B99FD4B9E.quest_subtitle": "Your bags have opinions.",
  "quest.296E4C9B99FD4B9E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Every container you open counts, and the count pays out.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"10\",\"color\":\"#E2A857\"},{\"text\":\" containers: Delightful Decade\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"25\",\"color\":\"#E2A857\"},{\"text\":\": Close Quarters\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"50\",\"color\":\"#E2A857\"},{\"text\":\": Half-Century\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"100\",\"color\":\"#E2A857\"},{\"text\":\": Centennial\"}]",
    "",
    "[\"\",{\"text\":\"The Centennial drops a \"},{\"text\":\"Centennial Trophy\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"lootr:trophy\",\"count\":1}}},{\"text\":\" block to keep.\"}]"
  ],
  "quest.2679304072DB3181.title": "Chest, barrel, cart",
  "quest.2679304072DB3181.quest_subtitle": "Three kinds of first time.",
  "quest.2679304072DB3181.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three container types, one hidden advancement.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"A Loot Chest\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"A Loot Barrel\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"A Minecart with Loot Chest, the ones rolling around mineshafts\"}]",
    "{@pagebreak}",
    "Each kind has its own first-time advancement: 'X' Marks the Spot, Barrel Booty and Tunnel Treasures. Shulkers give Bounty Box and item frames, I was framed!",
    "",
    "Opening all three is Socialised Loot."
  ],
  "quest.2956CA5974D0927F.title": "Brush it off",
  "quest.2956CA5974D0927F.quest_subtitle": "That was 90% gravity.",
  "quest.2956CA5974D0927F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Suspicious blocks and decorated pots hide loot too.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Brush suspicious sand and gravel until it gives.\"}]",
    "",
    "Then open a decorated pot.",
    "{@pagebreak}",
    "Brushing both kinds is Brush It Off; the pot is Woe to the Pot. Together: That Was 90% Gravity."
  ],
  "quest.04AE550B314C7235.title": "Don't break the chest",
  "quest.04AE550B314C7235.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Breaking a Lootr container takes it away from everyone.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Sneak while breaking to do it anyway; the game warns you first\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Carry On won't lift Lootr containers, spawners or vaults in this pack\"}]",
    "",
    "Ask a friend to leave the loot alone rather than the chest."
  ],
  "quest.6C4FB6BBB4F310B2.title": "Centennial",
  "quest.6C4FB6BBB4F310B2.quest_subtitle": "A hundred lids later.",
  "quest.6C4FB6BBB4F310B2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A hundred Lootr containers, and a trophy for the shelf.\"}]",
    "",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Centennial Trophy\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"lootr:trophy\",\"count\":1}}},{\"text\":\" drops from the advancement itself.\"}]"
  ],
  "reward.0B70DE8717E8A61B.title": "Secret found",
  "quest.7949A648A9538C15.title": "Villages that fit the biome",
  "quest.7949A648A9538C15.quest_subtitle": "Every biome gets a landlord.",
  "quest.7949A648A9538C15.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Villages and pillager outposts, dressed for the biome.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"18\",\"color\":\"#E2A857\"},{\"text\":\" village styles, from beach to mushroom fields\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"23\",\"color\":\"#E2A857\"},{\"text\":\" outpost styles\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Ship villages on deep oceans\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"More villages means more trades and more places for a waystone.\"}]"
  ],
  "quest.6033524BE932FAA1.title": "A temple with a puzzle",
  "quest.6033524BE932FAA1.quest_subtitle": "The floor plan is not a suggestion.",
  "quest.6033524BE932FAA1.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A pyramid with rooms, a curse and a ceiling that watches.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Mining Fatigue while you are inside: digging around the rooms is not the answer\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:brush\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Suspicious sand hides more; bring a brush\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"A hidden chest waits for whoever solves the layout\"}]"
  ],
  "quest.530CE321D62202D6.title": "The pharaoh's curse",
  "quest.530CE321D62202D6.quest_subtitle": "He was only napping.",
  "quest.530CE321D62202D6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Slay the Pharaoh and the temple's curse lifts.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:golden_apple\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"The pharaoh's tomb chest can hold an enchanted golden apple\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond_horse_armor\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Also diamond horse armor, emeralds and a golden sword\"}]",
    "",
    "Fight in the corridors, not the tomb."
  ],
  "quest.5DFB7182FFF89F11.title": "Wells, obelisks and arches",
  "quest.5DFB7182FFF89F11.quest_subtitle": "Decoration with a sense of humor.",
  "quest.5DFB7182FFF89F11.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"YUNG's Extras adds no dungeon, only things to stumble on.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Deserts: small, medium and large wells, dry wells and wishing wells, obelisks, ruins and a chill zone\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Swamps: arches, pillars, cubbies, a church and an ogre\"}]",
    "{@pagebreak}",
    "Its desert wells replace the vanilla one. Some desert loot tables are its own, and Lootr covers them."
  ],
  "quest.23E7AE83749138DC.title": "Jungle temple",
  "quest.23E7AE83749138DC.quest_subtitle": "Vines do the decorating.",
  "quest.23E7AE83749138DC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The jungle temple, rebuilt with more rooms and a proper treasure.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:emerald\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"The treasure chest holds diamonds, emeralds and gold\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Suspicious blocks in it drop emeralds\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Emeralds stack up: the toll at the depot is emeralds.\"}]"
  ],
  "quest.4F0ADA339AC46119.title": "Witch huts, two kinds",
  "quest.4F0ADA339AC46119.quest_subtitle": "The cat is not the witch.",
  "quest.4F0ADA339AC46119.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Swamp huts and a witch circle, with black cats to match.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"The hut chest can hold potions, phantom membrane and a rabbit's foot\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"The witch circle also grows in swamps\"}]",
    "{@pagebreak}",
    "Repurposed Structures adds six more hut styles by biome; Dungeons and Taverns adds a mangrove hut and a witch villa."
  ],
  "quest.5CBFA730614A3FB4.title": "Mineshafts by biome",
  "quest.5CBFA730614A3FB4.quest_subtitle": "Every biome digs its own hole.",
  "quest.5CBFA730614A3FB4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Vanilla mineshafts, restyled for whatever grows above them.\"}]",
    "",
    "[\"\",{\"text\":\"13\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E2A857\"},{\"text\":\" styles, from oak to overgrown.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" \"},{\"text\":\"A good early source of ore and rails\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"The chest minecarts are Lootr carts\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Tunnel Treasures is your first Lootr minecart, right here.\"}]"
  ],
  "quest.5D4FB9E2B0B4DED0.title": "Mineshafts in the caves",
  "quest.5D4FB9E2B0B4DED0.quest_subtitle": "Moss on the rails.",
  "quest.5D4FB9E2B0B4DED0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Some styles hide inside cave biomes instead of under a surface one.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Lush caves and dripstone caves\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Ice spikes and frozen peaks\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Mushroom fields, badlands and red desert\"}]",
    "",
    "Repurposed Structures adds sixteen more, down to Nether, End and ocean shafts."
  ],
  "quest.3F33812A507EFF11.title": "Dungeons with floor plans",
  "quest.3F33812A507EFF11.quest_subtitle": "Monster rooms grew up.",
  "quest.3F33812A507EFF11.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Vanilla dungeons become places you can get lost in.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Monster rooms, upgraded\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"A Fortress of the Undead and spider caves\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Catacombs full of zombies\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"A small dungeon in the Nether\"}]"
  ],
  "quest.2EAC90AB88885CA2.title": "A bone to pick",
  "quest.2EAC90AB88885CA2.quest_subtitle": "Rattle first, ask later.",
  "quest.2EAC90AB88885CA2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The Fortress of the Undead is the skeleton dungeon, grown to castle size.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"The middle chests can hold diamonds, coal and torches\"}]",
    "",
    "Bring a shield, and a torch for every corner."
  ],
  "quest.0499C6168C146EDB.title": "Cobweb entanglement",
  "quest.0499C6168C146EDB.quest_subtitle": "Sticky situation.",
  "quest.0499C6168C146EDB.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A spider cave, with its egg room at the bottom.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:golden_apple\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"The egg room can hold golden apples, name tags, saddles and potions\"}]",
    "",
    "Cut cobwebs with a sword or shears, not with hope."
  ],
  "quest.4380F92B83582110.title": "When in Rome",
  "quest.4380F92B83582110.quest_subtitle": "Dress code: bones.",
  "quest.4380F92B83582110.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Catacombs: zombies, tombs and a chest to earn them.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:golden_apple\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"The special chests can hold an enchanted golden apple, XP bottles and diamond tools\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:emerald\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"The tombstone chests hold emeralds and diamonds\"}]"
  ],
  "quest.31F3A1B5BAABC830.title": "Professional dungeoneer",
  "quest.31F3A1B5BAABC830.quest_subtitle": "Five rooms, zero regrets.",
  "quest.31F3A1B5BAABC830.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Every Better Dungeon, including the one in the Nether.\"}]",
    "",
    "The small Nether dungeon hides its own advancement, A Special Addition."
  ],
  "reward.5A1C6A886D6E5A6A.title": "Secret found",
  "quest.283F099B40C6AFCA.title": "The proving halls",
  "quest.283F099B40C6AFCA.quest_subtitle": "Copper, tuff and a bad omen.",
  "quest.283F099B40C6AFCA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Trial spawners drop the keys, and vaults spend them.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:trial_key\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A trial key opens a vault, once per player\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ominous_trial_key\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"An ominous key opens an ominous vault\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Vault loot is rolled for each player, Lootr style\"}]",
    "",
    "In act I the compass leads you to one, until your team reaches First Signal."
  ],
  "quest.55F7A545A66CAAFF.title": "Spend a key",
  "quest.55F7A545A66CAAFF.quest_subtitle": "The lock is not a sponge.",
  "quest.55F7A545A66CAAFF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Put a key in a vault and see what the chamber thinks is fair.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Use a trial key on the vault.\"}]",
    "{@pagebreak}",
    "Ominous vaults come from ominous trials: Bad Omen at the door turns the spawners ominous.",
    "",
    "[\"\",{\"text\":\"The Nether has its own chambers: \"},{\"text\":\"Hellish Trials\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7D9A441741BA22FB\"}},{\"text\":\".\"}]"
  ],
  "quest.5D7F7A7D95A83025.title": "Beyond the fire",
  "quest.5D7F7A7D95A83025.quest_subtitle": "Bring the blaze rods, leave the bricks.",
  "quest.5D7F7A7D95A83025.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"YUNG's remakes the fortress bigger and themed, under a new ID.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:blaze_rod\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Blaze rods: brewing, Powah and many mid-game recipes\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Wither skeletons here drop the skulls for the Wither\"}]",
    "{@pagebreak}",
    "In act III the compass points to one and counts it done as soon as someone on your team carries a blaze rod.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"To locate it, ask for betterfortresses:fortress.\"}]"
  ],
  "quest.4A78C56B50A0EF61.title": "Rooms worth a look",
  "quest.4A78C56B50A0EF61.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The fortress has nine kinds of room, each with its own chest table.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:blaze_rod\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Puzzle: a blaze rod can turn up, with nether wart and diamonds\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Obsidian: crying obsidian, flint and steel, diamonds\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:golden_chestplate\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Keep: gold armor, saddles and horse armor\"}]"
  ],
  "quest.5A6257001663EBBB.title": "Where the eyes lead",
  "quest.5A6257001663EBBB.quest_subtitle": "Bring spares. They break at the worst moment.",
  "quest.5A6257001663EBBB.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eyes of Ender land in a stronghold built room by room.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_eye\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Throw an eye and follow it until it sinks\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"It still counts as the stronghold for eyes and locators\"}]",
    "{@pagebreak}",
    "In act V the compass sends you here: its portal is the last road the Ark's exploration module needs."
  ],
  "quest.75FF06419C87C692.title": "Rooms with names",
  "quest.75FF06419C87C692.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Each stronghold room has its own loot table.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond_chestplate\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Armoury: diamond gear, shields and swords\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:book\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Grand library: books, maps and compasses\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:golden_apple\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Trap chests: golden apples and emeralds, for a price\"}]"
  ],
  "quest.75923818FF452782.title": "The drowned monument",
  "quest.75923818FF452782.quest_subtitle": "Water breathing recommended.",
  "quest.75923818FF452782.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The Elder Guardians keep the sponges and prismarine the Ark's seals need.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Ocean explorer maps still find it\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:nautilus_shell\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A chest in an upper side chamber holds nautilus shells and prismarine\"}]",
    "{@pagebreak}",
    "The compass points here in act V. Bring a way to breathe, and milk for the Mining Fatigue."
  ],
  "quest.40D95F7B204D1779.title": "Purpur towers",
  "quest.40D95F7B204D1779.quest_subtitle": "Shulkers pay no rent.",
  "quest.40D95F7B204D1779.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The outer islands hold cities, and a ship with wings.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:elytra\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"The elytra hangs in an end ship's item frame\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Shulker Levitation wears off in mid-air: carry slow falling or a water bucket\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"The city advancement lives in \"},{\"text\":\"The City at the End of the Game\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"108AAEC672725EF9\"}},{\"text\":\"; this one is the structure itself.\"}]"
  ],
  "quest.44B7A2ABE23B2C6C.title": "A remade island",
  "quest.44B7A2ABE23B2C6C.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"YUNG's Better End Island redraws the central island: a new spawn platform and gateways, a central tower and pillars in initial, guarded and broken versions.\"}]",
    "",
    "It can ring a bell before the Dragon is summoned."
  ],
  "quest.698FE5ED4BE18AB2.title": "Cartographer of ruins",
  "quest.698FE5ED4BE18AB2.quest_subtitle": "Fifty lids, one atlas.",
  "quest.698FE5ED4BE18AB2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Fifty containers opened means fifty places seen.\"}]",
    "",
    "Somewhere among them Heliodor left its own ruins, and the compass knows which ones matter."
  ],
  "quest.0D3DE34E81A94D9C.title": "Emerald toll",
  "quest.0D3DE34E81A94D9C.quest_subtitle": "The depot does not ask where you found them.",
  "quest.0D3DE34E81A94D9C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Sixteen emeralds from places you looted.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:emerald\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Stronghold treasure rooms and prisons\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:emerald\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Jungle temple treasure and catacomb tombstones\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:emerald\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Trap chests, if you dare\"}]"
  ],
  "quest.29F5F44DF6356939.title": "Villages, repurposed",
  "quest.29F5F44DF6356939.quest_subtitle": "Same bread, different roof.",
  "quest.29F5F44DF6356939.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Vanilla structures re-dressed for other biomes and other dimensions.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"17\",\"color\":\"#E2A857\"},{\"text\":\" families, from villages to ruined portals\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"14\",\"color\":\"#E2A857\"},{\"text\":\" village styles, crimson and warped ones included\"}]",
    "",
    "Its villager maps say 'Locating...' while they search. Believe them.",
    "{@pagebreak}",
    "Villages 14, mansions 8, outposts 18, pyramids 11, temples 7, mineshafts 16, igloos 4, witch huts 6, ruins 5, shipwrecks 4, monuments 4, strongholds 2, ancient cities 3, cities 2, and one each of bastion, jungle fortress and ruined portal.",
    "",
    "Each family has its own advancement."
  ],
  "quest.3E931B29BFA75F1D.title": "Mansions in eight styles",
  "quest.3E931B29BFA75F1D.quest_subtitle": "The illagers redecorated.",
  "quest.3E931B29BFA75F1D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Woodland mansions, remade for the biome they stand in.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Birch, oak, jungle, mangrove and taiga\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Desert, savanna and snowy\"}]",
    "{@pagebreak}",
    "Finding all eight is Lavish Livings.",
    "",
    "[\"\",{\"text\":\"Dungeons and Taverns adds its own manors and a hideout network: see \"},{\"text\":\"Illagers and witches\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"324E7D8B1ED78009\"}},{\"text\":\".\"}]"
  ],
  "quest.1A1A6F0ED0438CC8.title": "Pyramids of every biome",
  "quest.1A1A6F0ED0438CC8.quest_subtitle": "Not all of them are hot.",
  "quest.1A1A6F0ED0438CC8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Pyramids stop being a desert habit.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Badlands, jungle, snowy and icy\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Dark forest, mushroom, flower forest and giant taiga\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Ocean, Nether and End\"}]",
    "{@pagebreak}",
    "Temples come in seven: ocean, taiga and five Nether ones (basalt, crimson, soul, warped and wasteland).",
    "",
    "Finding every pyramid is Raider of the Tombs; every temple, Unanswered Prayers."
  ],
  "quest.776D5A8EAA3CEBEB.title": "Outposts by biome",
  "quest.776D5A8EAA3CEBEB.quest_subtitle": "Territory control, biome by biome.",
  "quest.776D5A8EAA3CEBEB.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Pillager outposts in eighteen styles, from oak to basalt.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Overworld: oak, birch, taiga, savanna, jungle, desert, badlands, mangrove, snowy and icy\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Nether: crimson, warped, soul, basalt and nether brick\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Ocean and End\"}]",
    "",
    "Finding all of them is Territory Control."
  ],
  "quest.7A37D16F0BFA9C57.title": "A bastion underground",
  "quest.7A37D16F0BFA9C57.quest_subtitle": "Piglins moved out. Bones moved in.",
  "quest.7A37D16F0BFA9C57.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A bastion that does not need the Nether to exist.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Under most land biomes\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Deep: its start sits around y -45\"}]"
  ],
  "quest.19AB4F336774FE12.title": "Ancient cities elsewhere",
  "quest.19AB4F336774FE12.quest_subtitle": "Sculk with a view.",
  "quest.19AB4F336774FE12.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three more ancient cities, none of them under the Overworld.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"One under the waves\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"One in the Nether\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"One in the End\"}]",
    "{@pagebreak}",
    "Finding all of them is Civilization from the Beyond.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Each has its own explorer map at a cartographer.\"}]"
  ],
  "quest.2F6D25BA13D32CB2.title": "Cities in the Nether",
  "quest.2F6D25BA13D32CB2.quest_subtitle": "Blazing landlords.",
  "quest.2F6D25BA13D32CB2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Nether city, and a whole second Nether around it.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Strongholds, temples and monuments\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Shipwrecks in crimson, warped and nether bricks\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Ruins and mineshafts\"}]",
    "",
    "Finding all shipwrecks is Interdimensional Pirates."
  ],
  "quest.10F58EE7FE1C62F1.title": "A portal that goes nowhere",
  "quest.10F58EE7FE1C62F1.quest_subtitle": "Purple, broken and sincere.",
  "quest.10F58EE7FE1C62F1.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The End gets a ruined portal of its own, and much more.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"A stronghold, outposts and a pyramid\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"A shipwreck and mineshafts\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"An ancient city\"}]",
    "",
    "The ruined portal is The Useless Portal."
  ],
  "quest.4D4B19A26212780C.title": "The ones with no twin",
  "quest.4D4B19A26212780C.quest_subtitle": "Dangerous, and well stocked.",
  "quest.4D4B19A26212780C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Some have no vanilla original.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"The Jungle Fortress, in jungles\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"The Overworld City, in giant-tree biomes\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"The Nether City and the End's ruined portal\"}]",
    "",
    "Enter the Jungle Fortress for Decaying Glory."
  ],
  "quest.77AC4F74AE0AED43.title": "Find a tavern",
  "quest.77AC4F74AE0AED43.quest_subtitle": "A safe haven with a bar tab.",
  "quest.77AC4F74AE0AED43.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Taverns in eleven wood styles, and a cartographer behind the bar.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Oak, birch, spruce, acacia, dark oak and cherry\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Jungle, mangrove, swamp, desert and snowy\"}]",
    "{@pagebreak}",
    "Dungeons and Taverns is 97 structures and 34 sets, from the Overworld to the End.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Two of its hidden advancements do not load in 1.21.1 and are off, so the quest trader has one trade fewer.\"}]"
  ],
  "quest.7842670AC179A85C.title": "Call for adventure",
  "quest.7842670AC179A85C.quest_subtitle": "Ask the barkeep for directions.",
  "quest.7842670AC179A85C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The tavern cartographer sells a map to somewhere worse.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Trade with the cartographer for a quest map.\"}]",
    "{@pagebreak}",
    "There are 21 kinds of map, from the Traveler's Map to the End Lighthouse Map.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A map is the cheapest way to find a dungeon: read the label.\"}]"
  ],
  "quest.604EF35338372467.title": "Combat shrines",
  "quest.604EF35338372467.quest_subtitle": "Five tiers of politeness.",
  "quest.604EF35338372467.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Shrines are combat trials, five tiers and a tower.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:trial_key\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Spawners inside drop the shrine keys\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"The loot can hold Traveler and Illagers Bane books\"}]",
    "",
    "Tier five is for whoever brought a shield and a plan."
  ],
  "quest.324E7D8B1ED78009.title": "Illagers and witches",
  "quest.324E7D8B1ED78009.quest_subtitle": "The Ill Manored.",
  "quest.324E7D8B1ED78009.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A whole illager and witch network, and one advancement to see it all.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Manors, mansions and pillager outposts\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Hideouts to loot and a Badlands Miner Outpost to conquer\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Witch villas, swamp villages, the Toxic Lair and the Lone Citadel\"}]",
    "{@pagebreak}",
    "Their loot hides Illagers Bane, a treasure enchantment that punishes illagers and witches."
  ],
  "quest.636C9B91B5D8637D.title": "Ruins with a past",
  "quest.636C9B91B5D8637D.quest_subtitle": "Someone used to live here.",
  "quest.636C9B91B5D8637D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Twenty-four ruined places, each one a small scene.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"A sawmill, a smithy, a school and a bee keeper\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"A graveyard, a frog ranch and a zombie horse ranch\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Desert remnants and a taiga castle\"}]"
  ],
  "quest.6CD7B0207C292C8D.title": "Dungeon master",
  "quest.6CD7B0207C292C8D.quest_subtitle": "All four, once each.",
  "quest.6CD7B0207C292C8D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Slay every Dungeons and Taverns miniboss once.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"The frozen citadel's Breeze\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"The Toxic Lair's Spider Queen\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"The trident monument's guardian and the End castle's haunting\"}]"
  ],
  "quest.0A23CA0DE4CBB695.title": "Freezing breeze",
  "quest.0A23CA0DE4CBB695.quest_subtitle": "Cold as the bill.",
  "quest.0A23CA0DE4CBB695.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The Lone Citadel sleeps under snow, guarded by a Breeze.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:trial_key\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Graves in the citadel hold its keys\"}]",
    "",
    "Snowy plains and snowy taiga only."
  ],
  "quest.7A55A50978EC1A85.title": "Detoxing the lair",
  "quest.7A55A50978EC1A85.quest_subtitle": "Pest control, deluxe.",
  "quest.7A55A50978EC1A85.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The Toxic Lair hides a Spider Queen under the swamp.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Bogged and cave spiders guard the way\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Its treasure can hold the Antidote enchantment\"}]",
    "",
    "Swamps and mangrove swamps."
  ],
  "quest.0E04936D2D47053F.title": "Abysmally ancient",
  "quest.0E04936D2D47053F.quest_subtitle": "Breathtaking, in every sense.",
  "quest.0E04936D2D47053F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A trident trial monument, and an Elder Guardian to match.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:trident\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Drowned wait at the corners\"}]",
    "",
    "It sits under deep oceans, so pack air."
  ],
  "quest.09012886AD494E43.title": "Keys that look like trial keys",
  "quest.09012886AD494E43.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Fifteen special keys, each for a different vault.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:trial_key\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"They are trial keys with their own name and model\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Trial spawners inside each drop them; bastion brutes carry the donjon and outstation ones\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Try each on the vaults of its own structure\"}]"
  ],
  "quest.3779F198DE6C4767.title": "Treasure enchantments",
  "quest.3779F198DE6C4767.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Thirteen treasure enchantments, off the enchanting table.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:enchanted_book\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Traveler: faster sprint and step-up\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:enchanted_book\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Outreach: longer block reach; Photosynthesis: repairs in sunlight\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:enchanted_book\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Illagers Bane, Antidote, Gravity and a Curse of Conductivity that calls lightning\"}]"
  ],
  "quest.4C295C84845AB264.title": "Port o' magma",
  "quest.4C295C84845AB264.quest_subtitle": "The tide is lava.",
  "quest.4C295C84845AB264.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Nether Ports and Keeps go where fortresses go, and skeleton camps follow.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"A powder snow bath inside a keep is Cool Off\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Camps and towers come in each Nether biome\"}]",
    "",
    "[\"\",{\"text\":\"For Concrete Halls, see \"},{\"text\":\"Concrete Halls\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"76C7A1F4CEEEEE65\"}},{\"text\":\".\"}]"
  ],
  "quest.2F23A67AC7A2264F.title": "Skull collector",
  "quest.2F23A67AC7A2264F.quest_subtitle": "They were not using them.",
  "quest.2F23A67AC7A2264F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Every skeleton camp, tower, port, fortress and keep.\"}]",
    "",
    "The Nether's whole bony side, in one advancement."
  ],
  "reward.44AE0DDA880AEEE3.title": "Secret found",
  "quest.3E92C523700BEB95.title": "Bastion of bastions",
  "quest.3E92C523700BEB95.quest_subtitle": "Piglin architecture, at scale.",
  "quest.3E92C523700BEB95.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The Piglin Donjon is a bastion with a lock and a brute at the door.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:gold_ingot\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Camps, outstations and hamlets share its bastion biomes\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Brutes carry the outstation and donjon keys\"}]",
    "",
    "Exploring a camp, an outstation, a hamlet and a donjon is Hog Hunt."
  ],
  "quest.512667317B378946.title": "The castle in the void",
  "quest.512667317B378946.quest_subtitle": "Spied Eye.",
  "quest.512667317B378946.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A castle above the End, with a haunting on the top floor.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"It starts around y 158: look up\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Its loot can hold Gravity, an enchantment that pulls entities toward the arrow\"}]",
    "",
    "[\"\",{\"text\":\"More in the End: \"},{\"text\":\"the lighthouse\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"09764E768DB75F4F\"}},{\"text\":\" and lone ships.\"}]"
  ],
  "quest.0BF1B9B0ADD28DA5.title": "Afraid of heights?",
  "quest.0BF1B9B0ADD28DA5.quest_subtitle": "It does not fall for it.",
  "quest.0BF1B9B0ADD28DA5.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The End Castle's haunting is a Phantom boss.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:trial_key\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Its spawners drop the End Castle keys\"}]",
    "",
    "Bring slow falling: the fall is long."
  ],
  "quest.2136D5928CDA3557.title": "A village afloat",
  "quest.2136D5928CDA3557.quest_subtitle": "The harbor master is a pillager.",
  "quest.2136D5928CDA3557.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Villages and outposts on ships, over the deep ocean.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Villages in deep oceans, outposts too\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Shipwrecks in the shallows: cold, lukewarm and warm oceans\"}]",
    "",
    "They start at sea level, so they float in view: look for masts."
  ],
  "quest.43C8FF7487ED881B.title": "Which styles are real",
  "quest.43C8FF7487ED881B.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Only 43 of the mod's 60 structures can generate in this pack.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"The 17 exclusive styles need biomes from other biome mods, and this pack has none\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"The rest: villages and outposts by biome, a desert temple mimic and an ocean shipwreck\"}]"
  ],
  "quest.41C40BD2B08166F8.title": "Explorify: small stops",
  "quest.41C40BD2B08166F8.quest_subtitle": "Nobody asked for a farmstead. Here it is.",
  "quest.41C40BD2B08166F8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Small vanilla-style places, made to be stumbled on.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Campsites in taigas, farmsteads on plains\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Watchtowers, and guide posts on the peaks\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"A mausoleum, desert shrines, mangrove huts and jungle ruins\"}]",
    "{@pagebreak}",
    "Twenty-three structures hide in there.",
    "",
    "[\"\",{\"text\":\"In all, \"},{\"text\":\"23\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E2A857\"},{\"text\":\": also a badlands pyramid, dark forest settlements, a tavern and an End shipwreck.\"}]"
  ],
  "quest.70D3CEF4DE9896B2.title": "Supply caches",
  "quest.70D3CEF4DE9896B2.quest_subtitle": "Somebody's stash, somebody else's lunch.",
  "quest.70D3CEF4DE9896B2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Seven supply caches, one for each kind of forest and its neighbors.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Forest, birch, dark forest and taiga\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Jungle, desert and mangrove\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Open them in your first days: they are close, cheap and Lootr-ready.\"}]"
  ],
  "quest.79D1CC874612D3B2.title": "The black spiral",
  "quest.79D1CC874612D3B2.quest_subtitle": "A name like a threat.",
  "quest.79D1CC874612D3B2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Explorify's one Nether structure, and it is not shy.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Crimson and warped forests\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Soul sand valleys and nether wastes\"}]"
  ],
  "quest.7D9A441741BA22FB.title": "Hellish Trials",
  "quest.7D9A441741BA22FB.quest_subtitle": "Fire resistance not included.",
  "quest.7D9A441741BA22FB.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Trial chambers for the Nether, with spawners, vaults and lava traps.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Spawners of skeletons, wither skeletons, blazes and magma cubes\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Normal and ominous vaults\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"Dispensers and lava in the corridors\"}]",
    "{@pagebreak}",
    "They keep ten chunks away from bastions.",
    "",
    "Bring fire resistance and a way back. Especially the way back."
  ],
  "quest.6DB64E53B02C7F9B.title": "Vaults with heat",
  "quest.6DB64E53B02C7F9B.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The Nether vaults are the cheapest route to some rare things.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:netherite_scrap\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Netherite scrap\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:mace\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A mace, and diamond gear\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:rib_armor_trim_smithing_template\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"The Rib armor trim\"}]"
  ],
  "quest.7DB4E463C1F1E87E.title": "Ask something that knows",
  "quest.7DB4E463C1F1E87E.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Cheapest first: look around, then ask.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E2A857\"},{\"text\":\"The \"},{\"text\":\"Explorer's Compass\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"explorerscompass:explorerscompass\",\"count\":1}}},{\"text\":\" points at any structure you pick\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:map\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Cartographers and tavern cartographers sell maps\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_eye\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Eyes of Ender still lead to the stronghold\"}]",
    "",
    "[\"\",{\"text\":\"The Heliodor Compass follows the story instead: \"},{\"text\":\"The Route: Acts I and II\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"60F361B6A2A611B1\"}},{\"text\":\".\"}]"
  ],
  "quest.1C01894D54875656.title": "Go slow on new land",
  "quest.1C01894D54875656.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Structures only appear in newly generated chunks.\"}]",
    "",
    "New Overworld chunks generate noticeably slower than vanilla, mostly because of the whole batch (ores, crops, fauna) and not one structure mod.",
    "",
    "On a modest PC, explore at a steady pace and let the world catch up."
  ],
  "quest.0D21B2B64287DAE0.title": "Not here",
  "quest.0D21B2B64287DAE0.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Heliodor's own ruins are on the compass, not on this map: the Signal Tower, the Sunken Workshop, the Viaduct, the Dome Greenhouse and the Foundry Under the Lava. The Envés is its own descent.\"}]",
    "",
    "[\"\",{\"text\":\"See \"},{\"text\":\"The Heliodor Compass\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"34DC677E5D339B3F\"}},{\"text\":\", and \"},{\"text\":\"Cataclysm's arenas\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"64975244823C07C4\"}},{\"text\":\" for that mod's boss structures.\"}]"
  ],
  "quest.6D8CE09C7F7C9001.title": "Night lights",
  "quest.6D8CE09C7F7C9001.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Light the lamps.\"}]",
    "",
    "Every structure you have found keeps a lantern glowing on the map."
  ],
  "quest.1278A511DFA5E284.title": "A little dust",
  "quest.1278A511DFA5E284.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Brush the sand.\"}]",
    "",
    "Something sparkles near the pyramid."
  ],
  "image.58FE8B8B69F5E68B.title": "Back to the Sun of Heliodor",
  "image.332A6FB9BEF7A73E.title": "[\"\",{\"text\":\"STRUCTURES\",\"color\":\"#F2E6C0\",\"bold\":true}]",
  "image.1AA6B473A8F04F96.title": "[\"\",{\"text\":\"Exploration\",\"color\":\"#E2A857\"}]",
  "image.2818765968671B45.title": "[\"\",{\"text\":\"the world, cut open\",\"color\":\"#B9AE90\",\"font\":\"minecraft:alt\"}]",
  "image.655749B037D1B95C.title": "[\"\",{\"text\":\"SURFACE\",\"color\":\"#9FD08A\",\"bold\":true}]",
  "image.12BACB06DF41F505.title": "[\"\",{\"text\":\"UNDERGROUND\",\"color\":\"#C9B8A0\",\"bold\":true}]",
  "image.3D99AE3575339F94.title": "[\"\",{\"text\":\"OCEAN\",\"color\":\"#7FB6FF\",\"bold\":true}]",
  "image.1304CFE4D08B3130.title": "[\"\",{\"text\":\"THE NETHER\",\"color\":\"#E06A5A\",\"bold\":true}]",
  "image.2AADE8AD903A72E4.title": "[\"\",{\"text\":\"THE END\",\"color\":\"#D9C9F0\",\"bold\":true}]",
  "chapter.67C3B41E0458780C.title": "Travel and navigation",
  "chapter.67C3B41E0458780C.chapter_subtitle": [
    "A map that inks itself in: waystones, compasses, boats, fish, photographs, camps and a chest on the move."
  ],
  "task.7CDA17881133DE18.title": "Activate a waystone",
  "quest.11D3557EB07DBDD1.title": "Wake a waystone",
  "quest.11D3557EB07DBDD1.quest_subtitle": "A glowing stone in the middle of nowhere.",
  "quest.11D3557EB07DBDD1.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Right-click one and it joins your list of destinations.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Wild ones show up about every \"},{\"text\":\"25\",\"color\":\"#E0B15A\"},{\"text\":\" chunks, dressed in the style of their biome\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Villages get one too\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Each player activates their own, so a friend's list starts empty\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"The Overworld, the Nether and the End can all grow them\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Activated ones also land on your JourneyMap, and Statistics counts them.\"}]"
  ],
  "task.1D0783B6998BCFE7.title": "A waystone in another style",
  "quest.7AA339F0860870A9.title": "Nine other stones",
  "quest.7AA339F0860870A9.quest_subtitle": "Same magic, better matching.",
  "quest.7AA339F0860870A9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A waystone can wear the stone of its biome.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Mossy\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:mossy_waystone\",\"count\":1}}},{\"text\":\" comes from mossy stone bricks, or from a \"},{\"text\":\"Waystone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:waystone\",\"count\":1}}},{\"text\":\" plus three moss blocks or three vines\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Sandy\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:sandy_waystone\",\"count\":1}}},{\"text\":\" takes chiseled sandstone and \"},{\"text\":\"Muddy\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:mud_bricks_waystone\",\"count\":1}}},{\"text\":\" takes mud bricks\"}]",
    "{@pagebreak}",
    "Every style swaps the three stone bricks of the plain recipe for another block:",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Black\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:blackstone_waystone\",\"count\":1}}},{\"text\":\": blackstone. \"},{\"text\":\"Deepslate\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:deepslate_waystone\",\"count\":1}}},{\"text\":\": deepslate\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Nether\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:red_nether_bricks_waystone\",\"count\":1}}},{\"text\":\": red nether bricks. \"},{\"text\":\"Ender\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:end_stone_waystone\",\"count\":1}}},{\"text\":\": end stone bricks\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Purpur\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:purpur_waystone\",\"count\":1}}},{\"text\":\": purpur blocks. \"},{\"text\":\"Prismarine\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:prismarine_waystone\",\"count\":1}}},{\"text\":\": prismarine\"}]"
  ],
  "quest.48B1F5AEFE7478C8.title": "A Warp Stone",
  "quest.48B1F5AEFE7478C8.quest_subtitle": "The heart of every waystone.",
  "quest.48B1F5AEFE7478C8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Hold right-click and any waystone you woke is one warp away.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_pearl\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Four ender pearls\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:amethyst_shard\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Four amethyst shards\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:emerald\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"An emerald in the middle\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Charging takes \"},{\"text\":\"1.6\",\"color\":\"#E0B15A\"},{\"text\":\" seconds, and every jump wears the stone down.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Sound like a lot for a bus ticket? It is also what the waystones you build are made around.\"}]"
  ],
  "quest.7BA9C7BD521DB589.title": "Warp Dust",
  "quest.7BA9C7BD521DB589.quest_subtitle": "Ender pearls, ground fine.",
  "quest.7BA9C7BD521DB589.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"One pearl and one shard make four pinches.\"}]",
    "",
    "[\"\",{\"text\":\"The dust goes into the Dormant Shard and the \"},{\"text\":\"Warp Plate\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6A60896789C9232F\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_pearl\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"1\",\"color\":\"#E0B15A\"},{\"text\":\" ender pearl\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:amethyst_shard\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"1\",\"color\":\"#E0B15A\"},{\"text\":\" amethyst shard\"}]"
  ],
  "quest.3B12191E4646294F.title": "Your own waystone",
  "quest.3B12191E4646294F.quest_subtitle": "Plant one wherever you will come back to.",
  "quest.3B12191E4646294F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three stone bricks, three obsidian and a Warp Stone.\"}]",
    "",
    "Put one at your base, at every camp and at each structure you plan to revisit.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Right-click it to name it and choose who sees it\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"Only the owner edits it, and \"},{\"text\":\"Carry On\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7A03AEEEB987D4DA\"}},{\"text\":\" will not lift it.\"}]"
  ],
  "quest.7C134F2795BE6EE4.title": "Tidy the list",
  "quest.7C134F2795BE6EE4.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Star your favorites, sort by name or distance and drag the rest into your own order.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Groups and colors help once the list passes a dozen\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Double-click moves a stop to the top, Shift-double-click to the bottom\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Visibility decides who sees a stone: whoever activates it, everyone, your team or a Sharestone color\"}]"
  ],
  "quest.243D9C659D4F16E0.title": "A Return Scroll",
  "quest.243D9C659D4F16E0.quest_subtitle": "A one-way ticket, home.",
  "quest.243D9C659D4F16E0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"One use, and you are at the nearest waystone you woke.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:gold_nugget\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Two gold nuggets\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ink_sac\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"An ink sac\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:paper\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Three paper, and the batch is \"},{\"text\":\"×3\",\"color\":\"#E0B15A\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Never leave without one. It is the cheapest life insurance in the pack.\"}]"
  ],
  "quest.234CEFCD51122583.title": "A scroll with an address",
  "quest.234CEFCD51122583.quest_subtitle": "Gift-wrapped destination.",
  "quest.234CEFCD51122583.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Use a \"},{\"text\":\"Blank Scroll\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:blank_scroll\",\"count\":1}}},{\"text\":\" on a waystone and it is bound to it.\"}]",
    "",
    "A bound scroll warps whoever holds it back to that stone: a present for a friend who never went.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:feather\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Two gold nuggets, a feather and three paper make \"},{\"text\":\"×3\",\"color\":\"#E0B15A\"},{\"text\":\" blanks\"}]"
  ],
  "quest.3ACD42DBE0A88F21.title": "The pocket menu",
  "quest.3ACD42DBE0A88F21.quest_subtitle": "Your whole list, once.",
  "quest.3ACD42DBE0A88F21.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A \"},{\"text\":\"Warp Scroll\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:warp_scroll\",\"count\":1}}},{\"text\":\" opens the destination list a single time.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_pearl\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"An ender pearl and an ink sac\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:gold_nugget\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Four gold nuggets and three paper: \"},{\"text\":\"×3\",\"color\":\"#E0B15A\"}]",
    "",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Warp Stone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:warp_stone\",\"count\":1}}},{\"text\":\" does the same for good, and it wears out.\"}]"
  ],
  "quest.0D1A09BFA771E482.title": "A door that closes",
  "quest.0D1A09BFA771E482.quest_subtitle": "Temporary, but it takes friends.",
  "quest.0D1A09BFA771E482.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The \"},{\"text\":\"Portal Scroll\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:portal_scroll\",\"count\":1}}},{\"text\":\" opens a Warp Portal for whoever walks in.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:amethyst_shard\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Four amethyst shards, an ender pearl, an ink sac and three paper: \"},{\"text\":\"×3\",\"color\":\"#E0B15A\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"It needs room to open, and it shuts if its target is destroyed.\"}]"
  ],
  "quest.6AC8F125761802DA.title": "What a warp costs",
  "quest.6AC8F125761802DA.quest_subtitle": "Experience, but never much.",
  "quest.6AC8F125761802DA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A jump costs a few points of experience, never more.\"}]",
    "",
    "[\"\",{\"text\":\"27\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E0B15A\"},{\"text\":\" points at most.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Same dimension: \"},{\"text\":\"1\",\"color\":\"#E0B15A\"},{\"text\":\" point every \"},{\"text\":\"100\",\"color\":\"#E0B15A\"},{\"text\":\" blocks\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Between dimensions: a flat \"},{\"text\":\"27\",\"color\":\"#E0B15A\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Free: warp plates, global waystones and memorials\"}]",
    "{@pagebreak}",
    "27 points are exactly the first three levels. Leashed animals come along; pets stay home.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"The Ark's \"},{\"text\":\"Exploration module\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6184CDBD4DC972E3\"}},{\"text\":\" waives the bill for your whole team.\"}]"
  ],
  "task.413CC7BA5E8B60C4.title": "A Sharestone",
  "quest.51955BCEF229BF86.title": "Standing stones",
  "quest.51955BCEF229BF86.quest_subtitle": "One color, one club.",
  "quest.51955BCEF229BF86.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Sharestone links to every other one of its color, and everybody can use it.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"16\",\"color\":\"#E0B15A\"},{\"text\":\" colors: two dyes, three stone bricks, three obsidian and a \"},{\"text\":\"Warp Stone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:warp_stone\",\"count\":1}}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Perfect for a team network\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"A \"},{\"text\":\"Portstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:white_portstone\",\"count\":1}}},{\"text\":\" is the one-way cousin: you leave from it, you never arrive at it.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Three polished andesite, two stone bricks, two dyes and a Warp Stone\"}]"
  ],
  "quest.6A60896789C9232F.title": "Step here, appear there",
  "quest.6A60896789C9232F.quest_subtitle": "Free doors for the impatient.",
  "quest.6A60896789C9232F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two Warp Plates, one shard between them, and a step is a trip.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:warp_dust\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Four \"},{\"text\":\"Warp Dust\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:warp_dust\",\"count\":1}}},{\"text\":\" on the edges\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:dormant_shard\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A \"},{\"text\":\"Dormant Shard\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:dormant_shard\",\"count\":1}}},{\"text\":\" (two dust and a flint) in the middle\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Four stone bricks at the corners\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Slot the dormant shard into a plate to attune it, carry the \"},{\"text\":\"Attuned Shard\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:attuned_shard\",\"count\":1}}},{\"text\":\" to a second plate and slot it there.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Stepping on takes under a second, the trip is free, and a \"},{\"text\":\"Deepslate Shard\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:deepslate_shard\",\"count\":1}}},{\"text\":\" (deepslate and flint) locks a plate.\"}]"
  ],
  "quest.4E68B59145080CA9.title": "Flavor the trip",
  "quest.4E68B59145080CA9.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Open a stone's settings, press Manage Modifiers and drop items in: they add effects to whoever warps through.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Twelve items count: \"},{\"text\":\"Blaze Powder\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:blaze_powder\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Poisonous Potato\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:poisonous_potato\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Ink Sac\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ink_sac\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Milk Bucket\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:milk_bucket\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Honey Block\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:honey_block\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Diamond\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Feather\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:feather\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Magma Cream\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:magma_cream\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Wither Rose\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:wither_rose\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Quartz\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:quartz\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Spider Eye\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:spider_eye\",\"count\":1}}},{\"text\":\" and a \"},{\"text\":\"Redstone Torch\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:redstone_torch\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"You have to own the waystone to edit it.\"}]"
  ],
  "quest.4085EC237F8A0AB9.title": "A feather for two",
  "quest.4085EC237F8A0AB9.quest_subtitle": "Hard to lose a friend.",
  "quest.4085EC237F8A0AB9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two players, two feathers, and each is a destination for the other.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:feather\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A feather, an amethyst shard, a gold nugget and an ink sac, no shape\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Face your friend, hold right-click and touch feather tips for a moment\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Your friend then shows up in the Players group of your waystone list.\"}]"
  ],
  "quest.1CEBF7DF0530721B.title": "A stone for the way back",
  "quest.1CEBF7DF0530721B.quest_subtitle": "Some maps have a small print.",
  "quest.1CEBF7DF0530721B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Die with an \"},{\"text\":\"Epitaph\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:epitaph\",\"count\":1}}},{\"text\":\" in your pockets and a Fleeting Memorial rises near where you fell.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:gold_nugget\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Six gold nuggets, two amethyst shards and a piece of deepslate\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Only you can warp to it, for free, and it is gone after one trip\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"It uses one Epitaph per death, so carry a stack.\"}]"
  ],
  "quest.0BA11AB7D4F5E416.title": "Solsticio joins the network",
  "quest.0BA11AB7D4F5E416.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"When the Town Hall portal opens in act VI, a global waystone appears there.\"}]",
    "",
    "Every waystone in the world can reach the city; the portal will not bounce you back.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"More in \"},{\"text\":\"A Waystone for Everyone\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"727A4BC4EDD7F47B\"}},{\"text\":\".\"}]"
  ],
  "quest.6184CDBD4DC972E3.title": "The Ark pays your fare",
  "quest.6184CDBD4DC972E3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Its Exploration module (act II) makes every warp free for the whole team.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"/rtp\",\"color\":\"#E0B15A\"},{\"text\":\" drops you at a random spot \"},{\"text\":\"1,000\",\"color\":\"#E0B15A\"},{\"text\":\" to \"},{\"text\":\"5,000\",\"color\":\"#E0B15A\"},{\"text\":\" blocks from spawn\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Once an hour, and never in Solsticio\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"All the modules: \"},{\"text\":\"What the Ark Gives\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"62CBF13A5CB4C3E5\"}},{\"text\":\".\"}]"
  ],
  "quest.0B70E5F10FB1C6D9.title": "Explorer's Compass",
  "quest.0B70E5F10FB1C6D9.quest_subtitle": "Any structure, one right-click.",
  "quest.0B70E5F10FB1C6D9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Pick a structure, vanilla or modded, and the needle finds the nearest.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Four cobwebs and four cracked stone bricks around a \"},{\"text\":\"Compass\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:compass\",\"count\":1}}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" opens the list; the screen then shows direction and distance\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"It looks up to \"},{\"text\":\"10,000\",\"color\":\"#E0B15A\"},{\"text\":\" blocks out, and Search for Next hunts further copies, up to \"},{\"text\":\"100\",\"color\":\"#E0B15A\"},{\"text\":\" times.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"The story never needs it: the Heliodor Compass, in \"},{\"text\":\"Never Lost\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"40194B53EA674D94\"}},{\"text\":\", covers that.\"}]"
  ],
  "quest.50447EB500A954EE.title": "Read the long list",
  "quest.50447EB500A954EE.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"With a whole modpack of structures, sort by source or dimension and type in the search box.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Sort by name, source, dimension, group or XP cost\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Searching costs no experience unless the server sets a price\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Creative players and operators also get a Teleport button.\"}]"
  ],
  "quest.1595C7F7FF1FE7A5.title": "Nature's Compass",
  "quest.1595C7F7FF1FE7A5.quest_subtitle": "Biomes, on request.",
  "quest.1595C7F7FF1FE7A5.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Choose a biome and it points to the nearest one, climate included.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Four saplings and four logs around a \"},{\"text\":\"Compass\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:compass\",\"count\":1}}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Search for Next can look further, up to \"},{\"text\":\"25\",\"color\":\"#E0B15A\"},{\"text\":\" times\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The Info button lists a biome's climate, rainfall, base height and top block, so you can rule one out before you walk.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"A Solsticio native's home biome, a mushroom island, the Aether's clouds: pick the biome, then walk. The pack sells one at \"},{\"text\":\"Rumbo's stall\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0C32CBED1669E8DF\"}},{\"text\":\".\"}]"
  ],
  "quest.7766CF40B9EB3115.title": "Compasses that point at things",
  "quest.7766CF40B9EB3115.quest_subtitle": "Not every needle wants north.",
  "quest.7766CF40B9EB3115.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three more ways to aim a needle at something you can't see.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"The \"},{\"text\":\"Recovery Compass\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:recovery_compass\",\"count\":1}}},{\"text\":\": eight echo shards around a compass; it points to your last death\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"A \"},{\"text\":\"Lodestone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:lodestone\",\"count\":1}}},{\"text\":\" binds a plain compass to itself\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"A \"},{\"text\":\"Survey Station\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"306B717DBAA85638\"}},{\"text\":\" does the same, and moves\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"An \"},{\"text\":\"Eye of Ender\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_eye\",\"count\":1}}},{\"text\":\" still finds the stronghold, YUNG's rebuild included.\"}]"
  ],
  "quest.0C32CBED1669E8DF.title": "Rumbo's stall",
  "quest.0C32CBED1669E8DF.quest_subtitle": "Solsticio's cartographer sells the way.",
  "quest.0C32CBED1669E8DF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Survey maps, both compasses and a spyglass, for emeralds.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Explorer's Compass\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"explorerscompass:explorerscompass\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"32\",\"color\":\"#E0B15A\"},{\"text\":\". \"},{\"text\":\"Nature's Compass\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturescompass:naturescompass\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"24\",\"color\":\"#E0B15A\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Survey maps to monuments, mansions, trial chambers and more: \"},{\"text\":\"12\",\"color\":\"#E0B15A\"},{\"text\":\" to \"},{\"text\":\"32\",\"color\":\"#E0B15A\"},{\"text\":\" plus a compass\"}]",
    "{@pagebreak}",
    "Memoria, the curator, sells Heliodor lore books and every pottery sherd.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Rumbo opens in act VI; some offers wait for their act.\"}]"
  ],
  "quest.14793195884A6FFF.title": "Your own map",
  "quest.14793195884A6FFF.quest_subtitle": "It remembers what you saw.",
  "quest.14793195884A6FFF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"JourneyMap draws the world as you walk it.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.journeymap.map_toggle_alt\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" opens the full map; a minimap sits in the corner\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Day, night, topography, biome and cave views; underground it switches to caves by itself\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"The minimap of FTB Chunks is off so the two do not overlap; FTB Chunks stays for claims.\"}]"
  ],
  "quest.214D3B0E22D5020A.title": "Pin every find",
  "quest.214D3B0E22D5020A.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.journeymap.create_waypoint\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" pins where you stand; \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.journeymap.fullscreen_create_waypoint\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" on the full map pins the cursor.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Waypoints throw a beam into the world\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"A Death waypoint marks where you fell and leads back to your grave\"}]"
  ],
  "quest.383C1B79AE356FE3.title": "Before every trip",
  "quest.383C1B79AE356FE3.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Boring, and it beats dying far from home.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Check the \"},{\"text\":\"Heliodor Compass\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"40194B53EA674D94\"}},{\"text\":\" and the Atlas\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:return_scroll\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A \"},{\"text\":\"Return Scroll\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"waystones:return_scroll\",\"count\":1}}},{\"text\":\" in the pocket, a waystone at base\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"A sleeping bag on your back; on arrival, a waystone and a waypoint\"}]"
  ],
  "task.5D82E4AD2E6F8B78.title": "A crimson or warped boat",
  "quest.39BDBAC06BA5F7D3.title": "A boat that shrugs off fire",
  "quest.39BDBAC06BA5F7D3.quest_subtitle": "Planks of the Nether, hull of the Nether.",
  "quest.39BDBAC06BA5F7D3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Crimson and warped boats are fire-proof, and they float on lava.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Five crimson or warped planks in a U, like any boat\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"The hull never burns: a lava lake is just another river\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"A wooden chest and a boat, shapeless, make the chest version\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Bring fire resistance for the shore all the same.\"}]"
  ],
  "quest.5A51F3E1FDA4B732.title": "Hop the bank",
  "quest.5A51F3E1FDA4B732.quest_subtitle": "Boats learned to jump.",
  "quest.5A51F3E1FDA4B732.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Press \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.jump\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" in a boat and it hops: out of the water onto the shore, or back in.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"A boat that stops at every riverbank is a wall; this one is a stepping stone\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"The hop is small on purpose: \"},{\"text\":\"0.4\",\"color\":\"#E0B15A\"},{\"text\":\" in water, \"},{\"text\":\"0.3\",\"color\":\"#E0B15A\"},{\"text\":\" on land, scaled by how long you charge.\"}]"
  ],
  "quest.23F9523F128BB177.title": "Two bases, two Nether doors",
  "quest.23F9523F128BB177.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Nether Portal Fix sends you back through the portal you came in by, not a stranger's.\"}]",
    "",
    "So two bases never end up sharing one Nether exit by accident, even in multiplayer."
  ],
  "task.37DE31DA063CE077.title": "A Sleeping Bag",
  "quest.1176F66E03A9338E.title": "A bed for the road",
  "quest.1176F66E03A9338E.quest_subtitle": "Sleep anywhere; wake up at home.",
  "quest.1176F66E03A9338E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three wool in a column, and the night is yours anywhere.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Crouch to place it; it tries to sleep by itself\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"It only works at night, and your respawn stays where it was\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"It stops phantoms while you try, and never breaks by default\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Sixteen colors: a dye and a bag in the crafting grid\"}]"
  ],
  "quest.37B3E863F08C9BE1.title": "Rope and Nail",
  "quest.37B3E863F08C9BE1.quest_subtitle": "Two anchors and a dream.",
  "quest.37B3E863F08C9BE1.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A hammock hangs between two of them.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:string\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Four strings around an iron ingot make \"},{\"text\":\"×2\",\"color\":\"#E0B15A\"}]",
    "",
    "Set one on each side, a few blocks apart."
  ],
  "task.19E53341ABE16C96.title": "A Hammock",
  "quest.7AC336B5BD03DDA9.title": "Sleep through the day",
  "quest.7AC336B5BD03DDA9.quest_subtitle": "The night shift's bed.",
  "quest.7AC336B5BD03DDA9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A hammock sleeps only by day, so the night stays for exploring.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:stick\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Two sticks, two strings and a wool make the cloth\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Hang it between two \"},{\"text\":\"Ropes and Nails\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"comforts:rope_and_nail\",\"count\":1}}}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"It needs room to fit, and a rope and nail at both ends.\"}]"
  ],
  "quest.1AC6615783138F93.title": "Bag by night, hammock by day",
  "quest.1AC6615783138F93.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Bags cover the night and hammocks the day: between the two you can sleep at any hour.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"By day, the skip follows the world's sleeping-percentage rule\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Hammock cloth takes dye like the bags do\"}]"
  ],
  "quest.270E9E0D7E18890D.title": "Pick up the whole chest",
  "quest.270E9E0D7E18890D.quest_subtitle": "Contents included.",
  "quest.270E9E0D7E18890D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Hold \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.carry.desc\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\", right-click with both hands empty, and the block is on your arms.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Chests, barrels, furnaces and other blocks with an inventory come along, items inside\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Heavier blocks slow you more, and you can't swing while carrying\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Right-click the ground to set it down again.\"}]"
  ],
  "quest.766E62C4E54BA2FF.title": "Carry the cow",
  "quest.766E62C4E54BA2FF.quest_subtitle": "Animals, stacked like a circus.",
  "quest.766E62C4E54BA2FF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The same gesture lifts animals: a sheep in the arms, more on top.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Up to \"},{\"text\":\"10\",\"color\":\"#E0B15A\"},{\"text\":\" stacked, none on a horse\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Nothing wider than \"},{\"text\":\"1.5\",\"color\":\"#E0B15A\"},{\"text\":\" or taller than \"},{\"text\":\"2.5\",\"color\":\"#E0B15A\"},{\"text\":\" blocks, and no hostile mobs\"}]",
    "{@pagebreak}",
    "Players can be lifted too, unless they are in creative.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"Bosses and everything of the pack's own refuse to be carried.\"}]"
  ],
  "quest.7A03AEEEB987D4DA.title": "What stays put",
  "quest.7A03AEEEB987D4DA.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Doors, beds, spawners, vaults, waystones and most machines won't budge.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Lootr chests, Create, AE2, Modern Industrialization, Oritech and Mekanism casings stay where they are\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Everything of ENTRELUMEN's own too, ruins included\"}]"
  ],
  "quest.42D15AAEEA95D343.title": "A camera",
  "quest.42D15AAEEA95D343.quest_subtitle": "The world, in sixteen frames.",
  "quest.42D15AAEEA95D343.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Look through the viewfinder, frame the world and expose a frame of film.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:iron_ingot\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Six iron ingots, a lever, a button and a glass pane\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Scroll to zoom: the lens it ships with covers \"},{\"text\":\"18\",\"color\":\"#E0B15A\"},{\"text\":\" to \"},{\"text\":\"55\",\"color\":\"#E0B15A\"},{\"text\":\" mm\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.exposure.camera_controls\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" opens the controls while you look through it\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Every photo in the margin of this map is a real one: a picture Exposure hides in loot chests.\"}]"
  ],
  "quest.4052518291B4B60C.title": "A roll of film",
  "quest.4052518291B4B60C.quest_subtitle": "Sixteen chances, no retakes.",
  "quest.4052518291B4B60C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Black and white, sixteen frames, and you have to develop it before printing.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:iron_ingot\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Two iron ingots and an iron nugget\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:gunpowder\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Two gunpowder, two bone meal and two dried kelp\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Swap the gunpowder for prismarine crystals and the roll gets a higher sensitivity: better in dim light.\"}]"
  ],
  "quest.7B554077F97F8ADB.title": "Swap the parts",
  "quest.7B554077F97F8ADB.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Sneak and use the camera, or right-click it in your inventory, to open its parts.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Lens: a spyglass widens the range to \"},{\"text\":\"55\",\"color\":\"#E0B15A\"},{\"text\":\" to \"},{\"text\":\"200\",\"color\":\"#E0B15A\"},{\"text\":\" mm\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Flash: a redstone lamp; on, off or auto, which fires below light level \"},{\"text\":\"8\",\"color\":\"#E0B15A\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Filter: any glass pane tints the shot; self-timer of \"},{\"text\":\"1\",\"color\":\"#E0B15A\"},{\"text\":\", \"},{\"text\":\"2\",\"color\":\"#E0B15A\"},{\"text\":\", \"},{\"text\":\"5\",\"color\":\"#E0B15A\"},{\"text\":\" or \"},{\"text\":\"10\",\"color\":\"#E0B15A\"},{\"text\":\" seconds\"}]"
  ],
  "quest.166FE851F96F6813.title": "Develop the roll",
  "quest.166FE851F96F6813.quest_subtitle": "Patience, in a bottle.",
  "quest.166FE851F96F6813.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Craft the exposed roll with a water bottle and the negatives are ready.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Nothing prints until the film is developed\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"A Create setup does it too: fill the roll with \"},{\"text\":\"250\",\"color\":\"#E0B15A\"},{\"text\":\" mB of water in a spout\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"A Deployer on a Camera Stand can swap camera parts by itself.\"}]"
  ],
  "quest.06BC0147FA1CFB19.title": "The Lightroom",
  "quest.06BC0147FA1CFB19.quest_subtitle": "Where light becomes paper.",
  "quest.06BC0147FA1CFB19.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Feed it developed film, paper and dye, and it prints.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"An iron trapdoor, a redstone torch and four planks\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"It needs light level \"},{\"text\":\"13\",\"color\":\"#E0B15A\"},{\"text\":\" or more, or it will not print\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:black_dye\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Black and white: a paper and one black dye, \"},{\"text\":\"4\",\"color\":\"#E0B15A\"},{\"text\":\" seconds\"}]"
  ],
  "quest.3035E5412F41BFA8.title": "Print a photograph",
  "quest.3035E5412F41BFA8.quest_subtitle": "Proof that you were there.",
  "quest.3035E5412F41BFA8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Hang it like a painting, or keep it in your pocket.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Printing also pays \"},{\"text\":\"2\",\"color\":\"#E0B15A\"},{\"text\":\" experience points\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Photos say who took them, and can be stacked \"},{\"text\":\"16\",\"color\":\"#E0B15A\"},{\"text\":\" to a pile\"}]"
  ],
  "quest.19430D05F7ABC9BC.title": "Color film",
  "quest.19430D05F7ABC9BC.quest_subtitle": "Gold, lapis and three bad potions.",
  "quest.19430D05F7ABC9BC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Color film costs gold and lapis, and develops with three different potions.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:gold_ingot\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Two gold ingots, a gold nugget, two lapis and two gunpowder, plus dried kelp\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Develop with an awkward, a thick and a mundane potion\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Printing takes \"},{\"text\":\"8\",\"color\":\"#E0B15A\"},{\"text\":\" seconds and one dye each of cyan, magenta, yellow and black, and pays \"},{\"text\":\"4\",\"color\":\"#E0B15A\"},{\"text\":\" experience points.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Potions get slightly different tints so the three are easy to tell apart.\"}]"
  ],
  "task.682D7110B4CBD552.title": "Print a chromatic photograph",
  "quest.6279218466699641.title": "Three layers, one picture",
  "quest.6279218466699641.quest_subtitle": "Photography, the long way round.",
  "quest.6279218466699641.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Shoot the same scene three times through a red, a green and a blue filter, and print each channel.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Set tinted glass on the Lightroom to switch to chromatic mode\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Each channel prints in \"},{\"text\":\"6\",\"color\":\"#E0B15A\"},{\"text\":\" seconds, dyed with two of magenta, yellow and cyan\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Combine the three layers on a Chromatic Sheet, held in your inventory. It pays \"},{\"text\":\"5\",\"color\":\"#E0B15A\"},{\"text\":\" experience points.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"With tinted glass on top the Lightroom still prints a regular photo, three times slower because of the refraction.\"}]"
  ],
  "task.465159181A1E5F69.title": "A photograph frame",
  "quest.09695426EB512EF8.title": "Hang it up",
  "quest.09695426EB512EF8.quest_subtitle": "A gallery, one block at a time.",
  "quest.09695426EB512EF8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Frames hold a photo in three sizes and go on walls, floors and ceilings.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:item_frame\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"An item frame among four sticks and four planks\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Four glass panes around it make the glass frame\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"A glow ink sac makes the frame glow.\"}]"
  ],
  "quest.5A73AE934498B1A8.title": "A photo album",
  "quest.5A73AE934498B1A8.quest_subtitle": "Pages that remember.",
  "quest.5A73AE934498B1A8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A writable book and a phantom membrane make an album that holds photos and notes.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Sign it and it stops being editable\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"A lectern can display the current page\"}]"
  ],
  "quest.76E57177481EDEAF.title": "A stand for the camera",
  "quest.76E57177481EDEAF.quest_subtitle": "You in the picture, for once.",
  "quest.76E57177481EDEAF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Set the camera on the stand and it shoots for you: selfies, group shots, the family.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Works within \"},{\"text\":\"100\",\"color\":\"#E0B15A\"},{\"text\":\" blocks of its owner; farther, the camera malfunctions\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:stick\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"An iron ingot, four sticks and two smooth stone slabs\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Take one with a tamed cat and wolf for Family Portrait.\"}]"
  ],
  "quest.163DCBE11C0C4D04.title": "An image from another plane",
  "quest.163DCBE11C0C4D04.quest_subtitle": "Any picture, printed as a photo.",
  "quest.163DCBE11C0C4D04.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Rename the projector to a link or a file, use it as a filter, and the camera shoots that picture.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Four tinted glass, four redstone and an ender eye\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Two modes, clean or dithered; the projector is used up\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"A server may block projecting, and the shot has \"},{\"text\":\"5\",\"color\":\"#E0B15A\"},{\"text\":\" seconds to load.\"}]"
  ],
  "quest.0933AB3938650BAD.title": "Copies and old paper",
  "quest.0933AB3938650BAD.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Paper and dye copy a photo, and a brush with brown dye ages it.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Original, copy, copy of a copy, tattered: each generation is a step down\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Loot chests in mineshafts, dungeons, strongholds, shipwrecks and plains houses hold aged photographs\"}]"
  ],
  "task.27AE6D850C4A19EB.title": "Take a selfie",
  "quest.2C0E52EB08D1E736.title": "Was that a spotlight?",
  "quest.2C0E52EB08D1E736.quest_subtitle": "Yes. On you.",
  "quest.2C0E52EB08D1E736.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"You turned the camera around.\"}]",
    "",
    "The selfie mode is one keypress from the viewfinder."
  ],
  "reward.4DE14E6638C81DA2.title": "Secret found",
  "task.2F7D8FAD93C4883B.title": "Photograph an Enderman",
  "quest.69F2E9905A0D441F.title": "Unforeseen consequences",
  "quest.69F2E9905A0D441F.quest_subtitle": "He did not want to be in it.",
  "quest.69F2E9905A0D441F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"You anger an Enderman by photographing him.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"He heard the shutter.\"}]"
  ],
  "reward.241DD33FB8DFF0DF.title": "Secret found",
  "quest.1EB4F69F6ED981C6.title": "A proper rod",
  "quest.1EB4F69F6ED981C6.quest_subtitle": "The vanilla one is a stick with opinions.",
  "quest.1EB4F69F6ED981C6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Iron, gold, diamond or neptunium: the rod is only the frame.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:iron_ingot\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Iron: two ingots, two strings and a stick\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Each rod wears out at its own pace: iron \"},{\"text\":\"125\",\"color\":\"#E0B15A\"},{\"text\":\", gold \"},{\"text\":\"55\",\"color\":\"#E0B15A\"},{\"text\":\", diamond \"},{\"text\":\"450\",\"color\":\"#E0B15A\"},{\"text\":\", neptunium \"},{\"text\":\"1000\",\"color\":\"#E0B15A\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Its parts (hook, bait, line, bobber) go in through a \"},{\"text\":\"Tackle Box\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6E01550D81F53753\"}}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Gold breaks fastest and diamond lasts longest short of neptunium.\"}]"
  ],
  "quest.6E01550D81F53753.title": "A tackle box",
  "quest.6E01550D81F53753.quest_subtitle": "Where the rod gets dressed.",
  "quest.6E01550D81F53753.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Put a rod in, and its hook, bait, line and bobber slots open.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:iron_ingot\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Four iron ingots, an iron block, a chest and two green things (dye, kelp or algae)\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Line and bobber only change how the cast looks\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"The bobber is a nautilus shell between two clay balls.\"}]"
  ],
  "quest.04AB7C167EE78376.title": "The hook decides",
  "quest.04AB7C167EE78376.quest_subtitle": "Small metal, big opinions.",
  "quest.04AB7C167EE78376.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Every hook bends the rod one way: luck, durability, reach or warning.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:iron_hook\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Iron: \"},{\"text\":\"20%\",\"color\":\"#E0B15A\"},{\"text\":\" of casts cost no durability. Four iron nuggets\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:gold_hook\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Gold: more luck. Diamond: \"},{\"text\":\"50%\",\"color\":\"#E0B15A\"},{\"text\":\" free casts\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:double_hook\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Double barb: a chance to land two catches\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:light_hook\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Light casts further and heavy shorter; redstone gives more time to reel in\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:note_hook\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Note plays a sound when a fish approaches\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:nether_star_hook\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Nether star: \"},{\"text\":\"50%\",\"color\":\"#E0B15A\"},{\"text\":\" free casts and more luck\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Gold, light, heavy, diamond and redstone: four of the material around an iron hook.\"}]"
  ],
  "quest.4AC76B2F913C6195.title": "Bait, from a bin",
  "quest.4AC76B2F913C6195.quest_subtitle": "A composter with a secret.",
  "quest.4AC76B2F913C6195.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Worm Farm eats what a composter eats and hands back worms, not bone meal.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Fences, dirt and planks: four fences, a dirt block and three planks\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Worms in the bait slot make fish bite sooner, and run out\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Fish are compostable too: what you don't cook feeds the farm.\"}]"
  ],
  "task.5C48344263278A14.title": "A sea fish",
  "quest.679638EC7C71B76A.title": "Salt water",
  "quest.679638EC7C71B76A.quest_subtitle": "Cold coasts, warm reefs.",
  "quest.679638EC7C71B76A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"What bites depends on the sea: cold shores, mild waters, warm reefs.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:atlantic_cod\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Cold sea or beach: Atlantic cod, blackfish, Pacific halibut, pollock\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:atlantic_herring\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Any sea or beach that isn't hot: herring and Atlantic halibut\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:tuna\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Any sea or beach: jellyfish, red grouper and, rarely, tuna\"}]"
  ],
  "task.6A70DDE4893F2274.title": "A freshwater fish",
  "quest.3D1BF5565C299868.title": "Rivers and lakes",
  "quest.3D1BF5565C299868.quest_subtitle": "Not the desert, not the jungle.",
  "quest.3D1BF5565C299868.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Away from the sea, the pool is bluegill, perch and minnows.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:bluegill\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Bluegill, perch and minnow bite most; carp, bass and brown trout follow\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:catfish\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Rare: catfish and muskellunge\"}]",
    "{@pagebreak}",
    "Perch, bass, brown trout and muskellunge skip hot biomes. Bass, catfish and gar skip snowy ones.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Rainbow trout also bite in cold rivers, seas and beaches, and pink salmon in cold water.\"}]"
  ],
  "task.0CBEA0858DA9655D.title": "A fish of the dry lands",
  "quest.54FA781380E12F3D.title": "Fish in the desert",
  "quest.54FA781380E12F3D.quest_subtitle": "Yes, there are fish. Ask the oasis.",
  "quest.54FA781380E12F3D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Dry, not-cold biomes have their own four.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:synodontis\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Synodontis leads, boulti and bayad follow\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:capitaine\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Capitaine is the rare one\"}]"
  ],
  "task.3398C9B6734D97DA.title": "A catch from odd waters",
  "quest.1CA9E2B8F82A4DAF.title": "Odd waters",
  "quest.1CA9E2B8F82A4DAF.quest_subtitle": "Piranhas, mushrooms and a turtle.",
  "quest.1CA9E2B8F82A4DAF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Jungles, swamps and mushroom islands have catches nowhere else has.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:piranha\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Jungle: piranha, tambaqui, arapaima and the arrau turtle\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:brown_shrooma\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Mushroom island: brown and red shrooma\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:leech\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Swamp: leeches and the box turtle\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"A starshell turtle only bites in the Twilight Forest.\"}]"
  ],
  "quest.30076DC3F84859BF.title": "Fillet the catch",
  "quest.30076DC3F84859BF.quest_subtitle": "A knife and a fish, no table.",
  "quest.30076DC3F84859BF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Any fish and any fillet knife in the two-slot grid make raw fillets.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Wood, stone, iron, gold, diamond or neptunium knives, two materials and a stick\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Neptunium knives give \"},{\"text\":\"25%\",\"color\":\"#E0B15A\"},{\"text\":\" more fillets\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Fish bones grind into bone meal, and a jellyfish smelts into a slimeball.\"}]"
  ],
  "quest.77A417E4F6461ED2.title": "Dinner is served",
  "quest.77A417E4F6461ED2.quest_subtitle": "Three ways to cook a fillet.",
  "quest.77A417E4F6461ED2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Smelt, smoke or grill a fillet and it is food.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:sushi\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Sushi\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:sushi\",\"count\":1}}},{\"text\":\": a raw fillet and seagrass\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:turtle_soup\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Turtle Soup\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:turtle_soup\",\"count\":1}}},{\"text\":\": a turtle, a water bucket and a bowl\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The furnace, the smoker and the campfire all work; the smoker is quickest.\"}]"
  ],
  "quest.3678214AA949BF6D.title": "Junk that pays",
  "quest.3678214AA949BF6D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The bottom of the pond is not all trash.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:tin_can\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A tin can smelts into \"},{\"text\":\"7\",\"color\":\"#E0B15A\"},{\"text\":\" iron nuggets\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:driftwood\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Driftwood makes four oak planks; fish bones, three bone meal\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:message_in_a_bottle\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A message in a bottle carries one of \"},{\"text\":\"29\",\"color\":\"#E0B15A\"},{\"text\":\" lines\"}]"
  ],
  "task.350A158FBC6232C1.title": "A box from the deep",
  "quest.714B4A27979FB1DF.title": "Boxes from the deep",
  "quest.714B4A27979FB1DF.quest_subtitle": "Right-click for a surprise.",
  "quest.714B4A27979FB1DF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three kinds wash up, and each pays better than the last.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:box\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Box: stone, planks, seeds, bones and other everyday things\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:lockbox\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Lockbox: ingots, golden apples, books, compasses and clocks\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:treasure_chest\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Treasure chest: iron, gold, diamonds and emeralds, the rarest of the three\"}]"
  ],
  "quest.54AD27E0715A3768.title": "Neptunium",
  "quest.54AD27E0715A3768.quest_subtitle": "The catch that keeps you fishing.",
  "quest.54AD27E0715A3768.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A neptunium cast is weight \"},{\"text\":\"1\",\"color\":\"#E0B15A\"},{\"text\":\" beside \"},{\"text\":\"85\",\"color\":\"#E0B15A\"},{\"text\":\" for fish and \"},{\"text\":\"10\",\"color\":\"#E0B15A\"},{\"text\":\" for junk.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"A third of them are a Neptune's Bounty: one to four ingots or a piece of gear\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"The rest: an ordinary fishing treasure, or a nugget; nine nuggets make an ingot\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"An ingot makes rods, knives, tools and armor.\"}]"
  ],
  "quest.575997CA0B3E8156.title": "Neptune's kit",
  "quest.575997CA0B3E8156.quest_subtitle": "Everything the sea forgives.",
  "quest.575997CA0B3E8156.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Neptunium tools and armor each grant one power below the surface.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:neptunium_helmet\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Helmet: better underwater sight. Chestplate: you breathe\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:neptunium_leggings\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Leggings: weightless. Boots: faster swimming\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:neptunium_pickaxe\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Pickaxe and shovel: no underwater speed penalty. Sword and axe: more damage there\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:neptunium_hoe\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Hoe: tilled land stays moist. Bow: arrows fly true through water\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Rod: fish bite more; knife: more fillets\"}]"
  ],
  "task.75CCC6BB24C005E7.title": "A fish mount",
  "quest.69E38F0BAECEB57E.title": "Trophy on the wall",
  "quest.69E38F0BAECEB57E.quest_subtitle": "The one that didn't get away.",
  "quest.69E38F0BAECEB57E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Mount the best catch of the day above the fireplace.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"Five buttons of one wood and an iron hook\"}]",
    "",
    "Six woods, and each fish shows on its plaque."
  ],
  "quest.649D53076D314564.title": "Fillets for the common store",
  "quest.649D53076D314564.quest_subtitle": "Somebody has to feed the expedition.",
  "quest.649D53076D314564.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"For the common store, once a day.\"}]",
    "",
    "[\"\",{\"text\":\"16\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E0B15A\"},{\"text\":\" \"},{\"text\":\"Cooked Fish Fillets\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aquaculture:fish_fillet_cooked\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "One good river does it."
  ],
  "quest.402341D6C3A5F2AD.title": "Somebody's pet",
  "quest.402341D6C3A5F2AD.quest_subtitle": "It escaped a bowl the size of the sea.",
  "quest.402341D6C3A5F2AD.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"You fished up a goldfish.\"}]",
    "",
    "It melts into a gold nugget, which feels ungrateful."
  ],
  "reward.1BAF79C93178D0F0.title": "Secret found",
  "quest.7B89274B6FB9FDCE.title": "A note from the deep",
  "quest.7B89274B6FB9FDCE.quest_subtitle": "It is not helpful.",
  "quest.7B89274B6FB9FDCE.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A bottle, a cork and one of twenty-nine daft messages.\"}]",
    "",
    "The message fades from your hand once you read it."
  ],
  "reward.5181DA128F222734.title": "Secret found",
  "quest.18E4ED0DBED8F947.title": "The map, inked",
  "quest.18E4ED0DBED8F947.quest_subtitle": "Getting lost is now a choice.",
  "quest.18E4ED0DBED8F947.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Any four of six ways to be somewhere else, and a map that fills as you walk.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"A waystone of your own, or a compass for structures or for biomes\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E0B15A\"},{\"text\":\"A bed for the road, a hook on the line, or a Lightroom in the dark\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:paper\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A map is eight paper around a compass; carry one filled\"}]",
    "{@pagebreak}",
    "Nobody has to do it all: the rest of the map is for the days you feel like it."
  ],
  "quest.15ACED202661A8D7.title": "A very small courier",
  "quest.15ACED202661A8D7.quest_subtitle": "He has a chest. He has opinions.",
  "quest.15ACED202661A8D7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"He carries a chest across the map and never sets it down.\"}]",
    "",
    "Nothing to build here. Just make way."
  ],
  "quest.2BC7162E23DF25F4.title": "Poke the fire",
  "quest.2BC7162E23DF25F4.quest_subtitle": "Something is roasting. It is a fillet.",
  "quest.2BC7162E23DF25F4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A camp is a bag, a fire and someone awake.\"}]",
    "",
    "Nothing to build here. Just warm your hands."
  ],
  "image.627C6618EA5786AF.title": "Back to the Sun of Heliodor",
  "image.4D35510C41A6383C.title": "[\"\",{\"text\":\"TRAVEL AND NAVIGATION\",\"color\":\"#F4EBD2\",\"bold\":true}]",
  "image.2BAC6E22FFF6A61E.title": "[\"\",{\"text\":\"draw it as you walk it\",\"color\":\"#C9B48A\",\"font\":\"minecraft:alt\"}]",
  "image.0761B5D29375CC3D.title": "[\"\",{\"text\":\"N\",\"color\":\"#4A3524\",\"bold\":true}]",
  "image.3DBDA3B6E14B3CF1.title": "[\"\",{\"text\":\"Waystone Network\",\"color\":\"#4A3524\"}]",
  "image.4E10123CD05B09ED.title": "[\"\",{\"text\":\"Waystone Network\",\"color\":\"#4A3524\"}]",
  "image.5C488AB95C56D2F4.title": "[\"\",{\"text\":\"The Compasses\",\"color\":\"#4A3524\"}]",
  "image.42A3798187C7B9A7.title": "[\"\",{\"text\":\"The Compasses\",\"color\":\"#4A3524\"}]",
  "image.2621C5B1E483BEF9.title": "[\"\",{\"text\":\"Fishing Waters\",\"color\":\"#4A3524\"}]",
  "image.38FE3EFE350AD15A.title": "[\"\",{\"text\":\"Fishing Waters\",\"color\":\"#4A3524\"}]",
  "image.4CAD940F4DE8BF00.title": "[\"\",{\"text\":\"The River\",\"color\":\"#4A3524\"}]",
  "image.3A01B7BB81518212.title": "[\"\",{\"text\":\"The River\",\"color\":\"#4A3524\"}]",
  "image.51D81B19C3ACADB2.title": "[\"\",{\"text\":\"Camps\",\"color\":\"#4A3524\"}]",
  "image.190ABD0505E4B429.title": "[\"\",{\"text\":\"Camps\",\"color\":\"#4A3524\"}]",
  "image.4A3029430294F350.title": "[\"\",{\"text\":\"Photographs\",\"color\":\"#4A3524\"}]",
  "image.0AF4A45AD13503D6.title": "[\"\",{\"text\":\"Photographs\",\"color\":\"#4A3524\"}]",
  "chapter.6CB674C10F6F716D.title": "Accessories and artifacts",
  "chapter.6CB674C10F6F716D.chapter_subtitle": [
    "Curios slots, the Artifacts you find while exploring and the Aether's own accessory menu."
  ],
  "quest.44730CF39368B534.title": "Extra slots, extra powers",
  "quest.44730CF39368B534.quest_desc": [
    "Most mods hang accessories on Curios slots (head, necklace, belt, hands, feet, back and more), the Aether keeps its own menu, and Eternal Starlight's are fused into your gear. The richest source is the Artifacts mod: uncraftable trinkets found while exploring.",
    "",
    "Armor keeps you alive; trinkets make it interesting."
  ],
  "quest.56867C76555F0B5F.title": "Open the Curios inventory",
  "quest.56867C76555F0B5F.quest_desc": [
    "&eG&r, or the Curios button in your inventory, opens the slots. Each slot can hide its item visually, and Artifacts adds cosmetic slots to show one trinket while wearing another.",
    "",
    "If something does not fit, it belongs to another slot: hover the slot to read its name."
  ],
  "quest.1F729E92C66954CF.title": "Toggles and keys",
  "quest.1F729E92C66954CF.quest_desc": [
    "The Universal Attractor, Night Vision Goggles, Scarf of Invisibility, Charms of Shrinking and Sinking and the Helium Flamingo's flight can be switched on and off; their keys are in Controls, under Artifacts.",
    "",
    "Turn the attractor off at home, unless you enjoy collecting every dropped seed."
  ],
  "quest.6ED869120880E115.title": "The Aether accessory menu",
  "quest.6ED869120880E115.quest_desc": [
    "The Aether has its own screen (&eI&r, or its inventory button) for rings, a pendant, gloves, a cape, a shield and more. Highlights: Zanite rings and pendants (faster mining for a while) and Ice ones (walk on water and lava), the Regeneration Stone, the Iron Bubble, the Invisibility Cloak, and Deep Aether's Cloud Cape (double jump) and Aercloud Necklace."
  ],
  "quest.4E0B57BF283905C8.title": "Terra's Arm",
  "quest.4E0B57BF283905C8.quest_desc": [
    "ENTRELUMEN's own accessory: Terra's cyborg arm, worn in a Curios hands slot for extra block reach. The Atlas gives it when act II closes, and the sunken workshop ruin keeps one in a chest.",
    "",
    "Everything else: the Terra's Arm chapter."
  ],
  "quest.434AD099488E169B.title": "Starlight goes inside your gear",
  "quest.434AD099488E169B.quest_desc": [
    "Eternal Starlight's accessories are not worn: each one combines into a specific kind of equipment, like items into a bundle, and the gear gains its effect. How many fit depends on the gear's accessory slots.",
    "",
    "The Glimmering Tablet says how to get each one."
  ],
  "quest.0A8B8F620E1A4BED.title": "Accessories in this pack",
  "quest.0A8B8F620E1A4BED.quest_desc": [
    "Curios and the Aether's Accessories run side by side. Artifacts registers its slots and cosmetic slots in Curios, and Cataclysm, Occultism, Industrial Foregoing and Sophisticated Backpacks use Curios slots too (a backpack goes on your back).",
    "",
    "Iron's Gems and Jewelry makes rings and amulets at a jeweller's bench; it has its own chapter."
  ],
  "quest.68A75072CA987105.title": "A full set of trinkets",
  "quest.68A75072CA987105.quest_desc": [
    "Every slot filled with something that suits you: a jump, a heal, a magnet, a lucky scarf.",
    "",
    "That is how two players in the same armor end up playing completely different games."
  ],
  "chapter.478633D3CFCF8540.title": "Farm · Crops and Trees",
  "chapter.478633D3CFCF8540.chapter_subtitle": [
    "A fenced field in rows, an orchard of three trees and a market: every crop the pack grows, from the first knife to a chorus flower."
  ],
  "quest.45F807AF9E04E1B8.title": "Flint and a stick",
  "quest.45F807AF9E04E1B8.quest_subtitle": "Sharper than it looks.",
  "quest.45F807AF9E04E1B8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Flint on a stick makes a \"},{\"text\":\"Flint Knife\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:flint_knife\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:straw\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Cut tall grass, wheat or rice with it for \"},{\"text\":\"Straw\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:straw\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Kill a pig with it and you get ham.\"}]",
    "",
    "Every knife also works the cutting board."
  ],
  "quest.6906134AB6E3A95F.title": "Straw work",
  "quest.6906134AB6E3A95F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Straw is rope, canvas and bales before it is anything else.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:rope\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Two straw stacked make four \"},{\"text\":\"Rope\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:rope\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:canvas\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Four in a square make \"},{\"text\":\"Canvas\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:canvas\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Nine make a bale, and a bale breaks back into nine.\"}]",
    "",
    "Rope is what tomatoes climb, canvas what baskets and signs are made of."
  ],
  "quest.725A3EF33D10C15D.title": "Crops of the wild",
  "quest.725A3EF33D10C15D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four crops grow wild, each in the biome it likes.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Cabbage and sea beet on beaches\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Tomatoes in hot dry lands\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Onions in most mild ones\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Rice where it is wet\"}]",
    "",
    "[\"\",{\"text\":\"Break the plant for \"},{\"text\":\"Cabbage Seeds\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:cabbage_seeds\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Tomato Seeds\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:tomato_seeds\",\"count\":1}}},{\"text\":\", an \"},{\"text\":\"Onion\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:onion\",\"count\":1}}},{\"text\":\" or \"},{\"text\":\"Rice\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:rice\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.3D8D11D6E1700397.title": "Good dirt",
  "quest.3D8D11D6E1700397.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Dirt, straw, bone meal and four \"},{\"text\":\"Tree Bark\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:tree_bark\",\"count\":1}}},{\"text\":\", or two rotten flesh instead, make \"},{\"text\":\"Organic Compost\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:organic_compost\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Placed, it slowly turns into rich soil.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Sunlight, water and nearby mushrooms, mycelium or podzol hurry it.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Tree bark comes off a log stripped on the cutting board with an axe.\"}]"
  ],
  "quest.5A06C33CE079E461.title": "Black gold",
  "quest.5A06C33CE079E461.quest_subtitle": "The good stuff.",
  "quest.5A06C33CE079E461.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Compost left in place becomes \"},{\"text\":\"Rich Soil\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:rich_soil\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Crops planted on it get a free bone meal boost one time in five, and a hoe turns it into \"},{\"text\":\"Rich Soil Farmland\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:rich_soil_farmland\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Mushrooms planted on it grow into colonies."
  ],
  "quest.2040926786BCD44E.title": "A crop of mushrooms",
  "quest.2040926786BCD44E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A mushroom planted on rich soil grows into a \"},{\"text\":\"Mushroom Colony\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:brown_mushroom_colony\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Break it for more mushrooms the older it is.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Shear a grown one to take it whole.\"}]",
    "",
    "Mushroom fields grow them wild."
  ],
  "quest.2D4352FFE039FDEA.title": "Nine to a crate",
  "quest.2D4352FFE039FDEA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Nine crops pack into a crate, and a crate is a block.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Tomatoes, cabbages, onions, carrots, potatoes and beetroots each have one.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Rice goes in a bag and panicles in a bale.\"}]",
    "",
    "A cellar full of them doubles as decoration."
  ],
  "quest.62E524285F7B767A.title": "Knee-deep",
  "quest.62E524285F7B767A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Rice only takes root in shallow water, one block deep.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:rice_panicle\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"When it tops out, the \"},{\"text\":\"Rice Panicle\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:rice_panicle\",\"count\":1}}},{\"text\":\" on top is the harvest.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"A knife on the board splits it into rice and straw.\"}]"
  ],
  "quest.2AD55E38B2F1A7E7.title": "Tomato skyscraper",
  "quest.2AD55E38B2F1A7E7.quest_subtitle": "Gardening's cheapest skyscraper.",
  "quest.2AD55E38B2F1A7E7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Hang rope above a tomato plant and the vine keeps climbing it, fruiting as it goes.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Pick the tomatoes by hand.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"The vine stays.\"}]"
  ],
  "quest.790231F32D54816F.title": "Tough crowd",
  "quest.790231F32D54816F.quest_subtitle": "Boo.",
  "quest.790231F32D54816F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A \"},{\"text\":\"Rotten Tomato\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:rotten_tomato\",\"count\":1}}},{\"text\":\" can be thrown.\"}]",
    "",
    "One in a pillager's face is the review the raid deserved."
  ],
  "reward.0D8C5DB17D3DF6EA.title": "Secret found",
  "quest.7804B242B4084A02.title": "One tomato, not four",
  "quest.7804B242B4084A02.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Almost Unified merges \"},{\"text\":\"69\",\"color\":\"#E6C766\"},{\"text\":\" crops that several mods share: a tomato is the same item whatever plant it came from, and EMI hides the copies. Farmer's Delight wins ties, then Croptopia, Pam's and Herbs and Harvest.\"}]"
  ],
  "quest.6C13A603F08403DE.title": "A whole field at once",
  "quest.6C13A603F08403DE.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Right-click a ripe crop to harvest it and leave it planted. With a \"},{\"text\":\"Vein Resonator\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:vein_resonator_1\",\"count\":1}}},{\"text\":\" in a charm slot, hold \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.ftbultimine\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" to till or harvest many blocks at once.\"}]"
  ],
  "quest.49C3B2317618601A.title": "Hundreds of crops",
  "quest.49C3B2317618601A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Croptopia scatters wild crops across every biome; break one and its seeds come with it.\"}]",
    "",
    "One crop crafts back into one seed, and the Market sells almost all of them for an emerald."
  ],
  "task.7833B66B04DF035C.title": "Plains",
  "task.03572428CFD39385.title": "Forests",
  "task.346C3318F046330E.title": "Savannas",
  "task.2B119C90BB648161.title": "Jungles",
  "task.6C9E568040005332.title": "Swamps",
  "task.26A22505581B7525.title": "Desert",
  "quest.3A62E3A4B22FB168.title": "A seed for every climate",
  "quest.3A62E3A4B22FB168.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Croptopia's seeds follow the weather; carry them all and you hold every one the mod has.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Fifteen in the plains\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Fifteen in forests\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Ten in savannas\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Thirteen in jungles\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Four in swamps\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"The saguaro in the desert\"}]"
  ],
  "quest.0952B02711D30945.title": "Salt of the river",
  "quest.0952B02711D30945.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Patches of \"},{\"text\":\"Salt Ore\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:salt_ore\",\"count\":1}}},{\"text\":\" lie on river beds.\"}]",
    "",
    "[\"\",{\"text\":\"No river nearby? Smelt one of Croptopia's water bottles, sixteen from a water bucket and three glass, and the water boils off into \"},{\"text\":\"Salt\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:salt\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.2877E523261DFA89.title": "The Croptopedia",
  "quest.2877E523261DFA89.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Three crops and a book make the \"},{\"text\":\"Croptopedia\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:guide\",\"count\":1}}},{\"text\":\", the mod's own guide.\"}]"
  ],
  "quest.7CDBF34580A2B0FB.title": "Spices from seed",
  "quest.7CDBF34580A2B0FB.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Croptopia grows its own spice rack.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:vanilla\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Vanilla\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:vanilla\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Pepper\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:pepper\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Mustard\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:mustard\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Chile Pepper\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:chile_pepper\",\"count\":1}}},{\"text\":\" come from seeds like any crop.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"The mortar and pestle grinds paprika.\"}]"
  ],
  "quest.336AD770D8371E44.title": "The sea harvest",
  "quest.336AD770D8371E44.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Croptopia adds tuna, anchovy, shrimp, crab, clams and oysters to what a rod brings up.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:roe\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Cod, salmon and tropical fish drop \"},{\"text\":\"Roe\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:roe\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:calamari\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Squid drop \"},{\"text\":\"Calamari\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:calamari\",\"count\":1}}},{\"text\":\", and glow squid a glowing one.\"}]"
  ],
  "quest.43DCA7C7C8099BBC.title": "A garden for the sushi bar",
  "quest.43DCA7C7C8099BBC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Grass drops Sushi Go Crafting's seeds too.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Rice, which grows underwater on dirt\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Cucumber\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Soy\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Sesame\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Wasabi Root\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"sushigocrafting:wasabi_root\",\"count\":1}}}]",
    "",
    "Its avocado trees grow mostly in plains; right-click the grown leaves for the fruit."
  ],
  "quest.67E9E631C3EF212F.title": "Mountain salt, found at sea",
  "quest.67E9E631C3EF212F.quest_subtitle": "Ask the captain.",
  "quest.67E9E631C3EF212F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Shipwreck treasure chests sometimes hold \"},{\"text\":\"Mountain Salt\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:mountain_salt\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Nobody explains how it got there. It is also one of six ingredients of something enormous."
  ],
  "reward.50C1989AAA97642F.title": "Secret found",
  "quest.004A8D21394AD997.title": "Wild gardens",
  "quest.004A8D21394AD997.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Pam's crops hide in wild gardens, bushes of mixed plants.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Arid in dry lands\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Frost in conifer forests\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Shaded in forests\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Soggy in swamps\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Tropical by jungles and the sea\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Windy in plains and savannas\"}]",
    "",
    "Each one you break gives a crop of its climate."
  ],
  "task.2AD38669F3494F2B.title": "Arid",
  "task.15E5C50796809D44.title": "Frost",
  "task.22F1A679ADC46AE2.title": "Shaded",
  "task.2646D82C9ABF455D.title": "Soggy",
  "task.15645A39A8C2A141.title": "Tropical",
  "task.6061E0E8946B720A.title": "Windy",
  "quest.566D490748F58B28.title": "Six climates",
  "quest.566D490748F58B28.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"One crop from each kind of garden: agave, cloudberry, tea leaf, lotus, coffee bean and sunchoke.\"}]",
    "",
    "[\"\",{\"text\":\"Any crop crafts into its seed, and the Market sells all \"},{\"text\":\"96\",\"color\":\"#E6C766\"},{\"text\":\" of Pam's seeds for an emerald each.\"}]"
  ],
  "quest.2A0112E749CFE888.title": "Not everything is food",
  "quest.2A0112E749CFE888.quest_subtitle": "A bucket of water from a cactus. Sure.",
  "quest.2A0112E749CFE888.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Some of Pam's plants make tools, not food.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Three aloe make a slime ball.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"A barrel cactus fills a bucket with water.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Two calabashes make two glass bottles.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Two cattails make four sticks.\"}]",
    "",
    "Any two fibers, cotton, jute, sisal, flax or kenaf, twist into string."
  ],
  "quest.4DFA0085B387B0A3.title": "Bread from any grain",
  "quest.4DFA0085B387B0A3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Any three grains make a loaf of bread, not only wheat.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Rye, millet, quinoa, sorghum, barley and oats all count.\"}]",
    "",
    "Pam's grinder turns the same grains into flour."
  ],
  "quest.38B894278804E073.title": "Coffee and tea",
  "quest.38B894278804E073.quest_subtitle": "Breakfast for the night shift.",
  "quest.38B894278804E073.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Smelt coffee beans for \"},{\"text\":\"Hot Coffee\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"pamhc2crops:hotcoffeeitem\",\"count\":1}}},{\"text\":\" and tea leaves for \"},{\"text\":\"Hot Tea\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"pamhc2crops:hotteaitem\",\"count\":1}}},{\"text\":\"; nettles make a hot tea of their own.\"}]",
    "",
    "No kettle, no filter: the furnace does it all."
  ],
  "quest.676505AA50EF425D.title": "No pig required",
  "quest.676505AA50EF425D.quest_subtitle": "Oink not included.",
  "quest.676505AA50EF425D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Shaded gardens in the forests sometimes hide a \"},{\"text\":\"Truffle\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"pamhc2crops:truffleitem\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Plant its seed and it grows like any crop: the priciest mushroom in the world, in a row."
  ],
  "reward.7F5705E02F338121.title": "Secret found",
  "quest.2BFBCA7D7CD7B083.title": "An herb garden",
  "quest.2BFBCA7D7CD7B083.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Mama's Herbs and Harvest brings \"},{\"text\":\"32\",\"color\":\"#E6C766\"},{\"text\":\" crops, \"},{\"text\":\"14\",\"color\":\"#E6C766\"},{\"text\":\" herbs, grapes and eight fruit trees.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Its seeds turn up in village farms and chests across the Overworld.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Herbs want farmland and water like any crop, and one crop crafts into one seed.\"}]"
  ],
  "quest.6B122A4CA97A6168.title": "Parsley, sage, rosemary and thyme",
  "quest.6B122A4CA97A6168.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four fresh herbs from the garden.\"}]",
    "",
    "Each one chops into four on the board with a knife, or in the crafting grid, and the chopped herbs season soups, pans and sandwiches.",
    "",
    "Picked herbs also sit on grass or in a flower pot as decoration."
  ],
  "quest.7A63004E8D6F4EB3.title": "The spice rack",
  "quest.7A63004E8D6F4EB3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Peppercorn, ginger and turmeric also grow on farmland.\"}]",
    "",
    "Peppercorn grinds into pepper, ginger and turmeric into powders, and a spice jar keeps a stack of any seasoning, labeled by what is inside."
  ],
  "quest.00539AD577BA67F5.title": "A flower for cheese",
  "quest.00539AD577BA67F5.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Thistle\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"herbsandharvest:thistle\",\"count\":1}}},{\"text\":\" grows wild in nearly every Overworld biome.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Two blocks tall, with purple flowers\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Bone meal spreads it like any tall flower\"}]",
    "",
    "[\"\",{\"text\":\"A water bucket, a glass bottle and a thistle make rennet for \"},{\"text\":\"cheese\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"31C11EDE6863ECBA\"}},{\"text\":\".\"}]"
  ],
  "quest.704E05D6E5A3C28D.title": "Two blocks tall",
  "quest.704E05D6E5A3C28D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Corn, eggplant, peas and tomatoes from Herbs and Harvest grow two blocks tall from a single seed.\"}]",
    "",
    "Breaking either half harvests the whole plant, seeds included, so replant after every harvest."
  ],
  "quest.7949F20E085F81AC.title": "The produce basket",
  "quest.7949F20E085F81AC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four bamboo make a \"},{\"text\":\"Produce Basket\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"herbsandharvest:crop_basket\",\"count\":1}}},{\"text\":\" that holds eight stacks of fruit and vegetables, one of each shown on top.\"}]",
    "",
    "Right-click it with an empty hand to take the latest back."
  ],
  "quest.2E39D96D48C4BBB6.title": "A salt pan",
  "quest.2E39D96D48C4BBB6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Right-click sand with a shovel to dig a salt basin.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Fill it with a water bucket or let the rain do it.\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"herbsandharvest:salt\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"When it dries, \"},{\"text\":\"Salt\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"herbsandharvest:salt\",\"count\":1}}},{\"text\":\" is left behind.\"}]",
    "",
    "A hopper underneath collects it."
  ],
  "quest.693F292BBFAA480B.title": "Plant an orchard",
  "quest.693F292BBFAA480B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Croptopia's fruit trees grow wild in plains, forests, dark forests and jungles.\"}]",
    "",
    "Two fruits and any sapling craft a new sapling of that fruit, so a single find starts an orchard."
  ],
  "task.6C627140CED710F8.title": "Plains",
  "task.045091F2504847C2.title": "Forests",
  "task.45859B73E0B32E07.title": "Dark forests",
  "task.64F59C744F69AB14.title": "Jungles",
  "quest.0AF3ED5FEB62B928.title": "Every tree in the book",
  "quest.0AF3ED5FEB62B928.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four kinds of country, and every tree Croptopia grows.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Three saplings from the plains\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Eleven from forests\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Four nut trees from dark forests\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Ten from jungles\"}]",
    "",
    "The Market sells all of them for an emerald each."
  ],
  "quest.0BD708EB0E901A5B.title": "Bark you can eat",
  "quest.0BD708EB0E901A5B.quest_subtitle": "Like a regular log, only tastier.",
  "quest.0BD708EB0E901A5B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Cinnamon grows in the trunk: strip one of Croptopia's jungle cinnamon logs with an axe and \"},{\"text\":\"Cinnamon\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:cinnamon\",\"count\":1}}},{\"text\":\" falls out.\"}]"
  ],
  "quest.7A653F67B29F59B1.title": "A handful of nuts",
  "quest.7A653F67B29F59B1.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Almonds, cashews, pecans and walnuts grow on dark forest trees.\"}]",
    "",
    "They go into almond brittle, trail mix, pecan pie and nutty cookies."
  ],
  "quest.6EE73BCEA08C042C.title": "Five from the jungle",
  "quest.6EE73BCEA08C042C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Five jungle trees, five new foods.\"}]",
    "",
    "Banana, mango, coconut, dragon fruit and fig.",
    "",
    "Every one of them counts as fruit for Pam's punch and salads."
  ],
  "quest.2FAE04CEC54E369D.title": "Pam's orchard",
  "quest.2FAE04CEC54E369D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Pam's trees hang their fruit as blocks under the leaves.\"}]",
    "",
    "Right-click ripe fruit with an empty hand: it drops and grows back.",
    "",
    "Eight fruits and any sapling craft a sapling of that tree."
  ],
  "quest.56CDDD1356FA1787.title": "Only in Pam's orchard",
  "quest.56CDDD1356FA1787.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Pomegranate, lychee, papaya, guava and passion fruit: five fruits no other mod here grows.\"}]",
    "",
    "[\"\",{\"text\":\"Pam's Trees has \"},{\"text\":\"49\",\"color\":\"#E6C766\"},{\"text\":\" fruit trees in all, from acorns to tamarind.\"}]"
  ],
  "quest.32DA6F16D4DDBBF6.title": "Trees that grow supplies",
  "quest.32DA6F16D4DDBBF6.quest_subtitle": "Paper grows on trees. Finally literal.",
  "quest.32DA6F16D4DDBBF6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Maple trees grow \"},{\"text\":\"Maple Syrup\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"pamhc2trees:maplesyrupitem\",\"count\":1}}},{\"text\":\" on the trunk, paperbark trees grow paper and spiderweb trees grow string.\"}]",
    "",
    "Eight paper or eight string and a sapling craft the last two."
  ],
  "quest.451F078A12EB81B7.title": "Nine trees at the Market",
  "quest.451F078A12EB81B7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Nine of Pam's trees were copies of Herbs and Harvest ones.\"}]",
    "",
    "Avocado, cherry, cinnamon, lemon, lime, orange, peach, pear and plum.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Their Pam's versions no longer grow wild.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"The Market sells those saplings for an emerald each.\"}]"
  ],
  "quest.5BFC6D8A0B6DBD11.title": "Round trees, endless fruit",
  "quest.5BFC6D8A0B6DBD11.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Herbs and Harvest's eight fruit trees are round and dark green, and grow in almost every Overworld biome.\"}]",
    "",
    "Their leaves keep growing fruit, bone meal hurries it, and the saplings turn up in chests and fit in a flower pot."
  ],
  "quest.45C20B371BF45A31.title": "The cinnamon tree",
  "quest.45C20B371BF45A31.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Herbs and Harvest's cinnamon tree is two blocks tall, and its bark keeps growing back.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"herbsandharvest:cinnamon\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Strip it with an axe when the bark is mature for \"},{\"text\":\"Cinnamon\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"herbsandharvest:cinnamon\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Saplings grow in tropical biomes.\"}]"
  ],
  "quest.3608E1E0D8C9FD21.title": "Vines that grow down",
  "quest.3608E1E0D8C9FD21.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Grape vines hang from the underside of a block and grow downward, like glow berries.\"}]",
    "",
    "Bone meal speeds them up.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Some villages keep a trellis of them.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Chests hold the rest.\"}]"
  ],
  "quest.50A6912B6169501B.title": "A merchant comes to town",
  "quest.50A6912B6169501B.quest_subtitle": "He brings his own parachute.",
  "quest.50A6912B6169501B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Planks, logs and red wool make a \"},{\"text\":\"Market\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmingforblockheads:market\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Place it and a merchant arrives: down from the sky if the spot is open, up through the floor if not.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Emeralds buy seeds and saplings of Croptopia, Pam's, Farmer's Delight and vanilla, and bone meal.\"}]"
  ],
  "quest.26389A080A510E7A.title": "Three fertilizers",
  "quest.26389A080A510E7A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Seeds, gold and a dye make each fertilizer.\"}]",
    "",
    "Used on farmland, red makes crops grow faster, green adds extra crops and yellow keeps the soil from being trampled.",
    "",
    "Fertilized farmland never wears off."
  ],
  "quest.3D23A751FF1AE437.title": "Nest egg",
  "quest.3D23A751FF1AE437.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Planks and a hay bale make a \"},{\"text\":\"Chicken Nest\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmingforblockheads:chicken_nest\",\"count\":1}}},{\"text\":\" that picks up every egg laid within eight blocks.\"}]",
    "",
    "No more egg hunts around the coop."
  ],
  "quest.3B1C954C178CDA25.title": "Feeding time",
  "quest.3B1C954C178CDA25.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Planks, hay and a golden carrot make a \"},{\"text\":\"Feeding Trough\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmingforblockheads:feeding_trough\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Fill it with the right food and it feeds animals ready to breed within eight blocks, up to \"},{\"text\":\"24\",\"color\":\"#E6C766\"},{\"text\":\" of each kind.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Search an animal in EMI: Just Enough Breeding lists what it eats to breed.\"}]"
  ],
  "quest.3FA285E3389B23B2.title": "Harvest tithe",
  "quest.3FA285E3389B23B2.quest_subtitle": "The pantry is always hungry.",
  "quest.3FA285E3389B23B2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two crates of tomatoes and two of cabbages for the common store, once a day.\"}]",
    "",
    "Eighteen of each, packed nine to a crate."
  ],
  "quest.471462F642DDE401.title": "Trade the surplus",
  "quest.471462F642DDE401.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Novice and apprentice farmer villagers may buy Farmer's Delight crops, and the Wandering Trader may sell its seeds.\"}]"
  ],
  "quest.27B01F863308CB58.title": "Soil that forgets",
  "quest.27B01F863308CB58.quest_subtitle": "Named after the river of oblivion.",
  "quest.27B01F863308CB58.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Soul sand or soil, bone meal, Nether roots or straw and rotten flesh make \"},{\"text\":\"Leteos Compost\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mynethersdelight:letios_compost\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Only in the Nether does it forget itself into \"},{\"text\":\"Resurgent Soil\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mynethersdelight:resurgent_soil\",\"count\":1}}},{\"text\":\", faster beside lava or flames: the Nether's rich soil.\"}]"
  ],
  "quest.2EF8C94237256F52.title": "Nether colonies",
  "quest.2EF8C94237256F52.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Crimson and warped fungi planted on resurgent soil grow into colonies, just as mushrooms do on rich soil.\"}]",
    "",
    "Resurgent soil also spreads the plants around it."
  ],
  "quest.7DD271F093405060.title": "Handle with care",
  "quest.7DD271F093405060.quest_subtitle": "Spicy is an understatement.",
  "quest.7DD271F093405060.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Powdery Cane grows wild in crimson forests, and its berries burst on contact.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mynethersdelight:powder_cannon\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Cut the stem instead and plant the \"},{\"text\":\"Powdery Cannon\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mynethersdelight:powder_cannon\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mynethersdelight:bullet_pepper\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"When it fruits it drops \"},{\"text\":\"Bullet Peppers\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mynethersdelight:bullet_pepper\",\"count\":1}}},{\"text\":\", which a knife grinds into pepper powder.\"}]"
  ],
  "quest.110D03529EA5EBD4.title": "A garden in the sky",
  "quest.110D03529EA5EBD4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Skyroot meadows and forests in the Aether grow wild ginger, parsnip and leek, and \"},{\"text\":\"Peppermint\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aethersdelight:peppermint_leaf\",\"count\":1}}},{\"text\":\" bushes.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Unification hands you the same ginger, parsnip and leek your fields grow.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"The peppermint is the Aether's own.\"}]"
  ],
  "quest.7B42DF34C070F496.title": "What grows in the Twilight",
  "quest.7B42DF34C070F496.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The Twilight Forest's plants go into the pot.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Torchberries\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"twilightforest:torchberries\",\"count\":1}}},{\"text\":\" fill pies and fuel the Maze Stove.\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"twilightforest:liveroot\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Liveroot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"twilightforest:liveroot\",\"count\":1}}},{\"text\":\", with fiddleheads, fallen leaves, root strands and vines, makes a Thousand Plant Stew.\"}]"
  ],
  "quest.625B0E890F82013D.title": "A garden at the end",
  "quest.625B0E890F82013D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Chorus Succulent\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ends_delight:chorus_succulent\",\"count\":1}}},{\"text\":\" grows in the End Highlands.\"}]",
    "",
    "[\"\",{\"text\":\"A knife on the board splits a chorus fruit into four \"},{\"text\":\"Chorus Fruit Grains\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ends_delight:chorus_fruit_grain\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Both go into End's Delight's feasts."
  ],
  "quest.3F6E3C8B11246C62.title": "Crop rotation",
  "quest.3F6E3C8B11246C62.quest_subtitle": "From the riverbank to the End.",
  "quest.3F6E3C8B11246C62.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Plant all nineteen food plants Farmer's Delight counts.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Wheat, carrots, potatoes, beetroots, melons and pumpkins\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Sugar cane, sweet berries, cocoa, kelp and glow berries\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Both mushrooms, cabbage, onions, tomatoes and rice\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Nether wart and a chorus flower\"}]"
  ],
  "quest.7617964E52593586.title": "Stand the scarecrow up",
  "quest.7617964E52593586.quest_subtitle": "Keeps the crows off. Mostly.",
  "quest.7617964E52593586.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Every field needs somebody standing guard.\"}]",
    "",
    "Nothing to build. Just a wave at the crows."
  ],
  "image.2E88CE6E972731E4.title": "[\"\",{\"text\":\"FARM\",\"color\":\"#F3E7C6\",\"bold\":true}]",
  "image.6189ECC4631E4441.title": "[\"\",{\"text\":\"Crops and Trees\",\"color\":\"#E8B04A\"}]",
  "image.798ED1A899A2503E.title": "Back to the Sun of Heliodor",
  "image.1251AA367AF4A347.title": "[\"\",{\"text\":\"Farmer's Delight\",\"color\":\"#F3E7C6\"}]",
  "image.735E067FF7A0AC56.title": "[\"\",{\"text\":\"Croptopia\",\"color\":\"#F3E7C6\"}]",
  "image.56103626519DB38D.title": "[\"\",{\"text\":\"Pam's gardens\",\"color\":\"#F3E7C6\"}]",
  "image.1DBF4DB2FC6FC0EF.title": "[\"\",{\"text\":\"Herbs and Harvest\",\"color\":\"#F3E7C6\"}]",
  "image.308A95DD7D5748F9.title": "[\"\",{\"text\":\"Beyond the fence\",\"color\":\"#F3E7C6\"}]",
  "image.3D5C74BC18991985.title": "[\"\",{\"text\":\"The Market\",\"color\":\"#F3E7C6\"}]",
  "chapter.3608810979379C92.title": "Farm · Kitchen",
  "chapter.3608810979379C92.chapter_subtitle": [
    "A table for every guest: the pot, the board and the skillet, four worlds of Delights, and a menu that pays in hearts."
  ],
  "quest.1B01756BFFD75E45.title": "A pot on the fire",
  "quest.1B01756BFFD75E45.quest_subtitle": "Grandma's first appliance.",
  "quest.1B01756BFFD75E45.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Two bricks, five iron ingots, a wooden shovel and a water bucket make a \"},{\"text\":\"Cooking Pot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:cooking_pot\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Set it over fire, a campfire, lava, magma or a \"},{\"text\":\"Stove\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:stove\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Up to six ingredients go in.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Bowl meals also want a bowl in its container slot.\"}]"
  ],
  "quest.36BC5D4950D2E5E3.title": "Soup of the day",
  "quest.36BC5D4950D2E5E3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The pot's first real dish: \"},{\"text\":\"Vegetable Soup\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:vegetable_soup\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"A carrot, a potato, a beetroot and a leafy green such as cabbage\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"A bowl waiting in the pot\"}]",
    "",
    "[\"\",{\"text\":\"Two of them are half of the pack's first \"},{\"text\":\"Travel Rations\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:ration_bundle\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.4695455C2AEC2B69.title": "Mind the board",
  "quest.4695455C2AEC2B69.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Planks and two sticks make a \"},{\"text\":\"Cutting Board\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:cutting_board\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Put an item on it and use it with a tool: a knife slices food, an axe strips a log into \"},{\"text\":\"Tree Bark\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:tree_bark\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Raw beef becomes \"},{\"text\":\"Minced Beef\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:minced_beef\",\"count\":1}}},{\"text\":\", dough becomes \"},{\"text\":\"Raw Pasta\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:raw_pasta\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Each Fortune level on the tool adds \"},{\"text\":\"10%\",\"color\":\"#E6C766\"},{\"text\":\" to the odds of the rare results.\"}]"
  ],
  "quest.7E603A9650927253.title": "A stove of your own",
  "quest.7E603A9650927253.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three iron ingots over four brick blocks and a campfire: a \"},{\"text\":\"Stove\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:stove\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "It heats the pot above it and cooks up to six items on top with campfire recipes.",
    "",
    "It also counts as a passive heater under a Create boiler."
  ],
  "quest.0A07CF5E464A415B.title": "Hot off the skillet",
  "quest.0A07CF5E464A415B.quest_subtitle": "Can double as a frying pan. It is one.",
  "quest.0A07CF5E464A415B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four iron ingots and a brick make a \"},{\"text\":\"Skillet\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:skillet\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Hold food in your other hand and use it within a block of any heat, or while you are on fire: a campfire's thirty seconds become six.",
    "",
    "Sneak to set it down as a block.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Fire Aspect on the skillet shortens that to four seconds at level I and three at level II. It is also a fine blunt weapon.\"}]"
  ],
  "quest.2ACD7F355EDDAEF7.title": "A glorious feast",
  "quest.2ACD7F355EDDAEF7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Some meals are too big for one plate.\"}]",
    "",
    "[\"\",{\"text\":\"Craft a \"},{\"text\":\"Roast Chicken\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:roast_chicken_block\",\"count\":1}}},{\"text\":\" or cook a stuffed pumpkin, place it and serve it with a bowl, one portion at a time.\"}]",
    "",
    "Honey glazed ham, shepherd's pie and the gleaming salad serve the same way."
  ],
  "quest.1B78187A9833F748.title": "Pies count too",
  "quest.1B78187A9833F748.quest_subtitle": "Dessert, but it counts as strategy.",
  "quest.1B78187A9833F748.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three wheat, three apples, two sugar and a \"},{\"text\":\"Pie Crust\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:pie_crust\",\"count\":1}}},{\"text\":\": an \"},{\"text\":\"Apple Pie\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:apple_pie\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Placed, it gives four bites by hand, or four slices with a knife.",
    "",
    "A bite eaten from a block also turns surplus into buffs, cakes and cheesecakes included."
  ],
  "quest.3DD29430B6B744F4.title": "Nourished",
  "quest.3DD29430B6B744F4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"While \"},{\"text\":\"Nourishment\",\"color\":\"#E6C766\"},{\"text\":\" lasts, the hunger bar stops dropping, except when saturation is healing you.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Most pot meals give it.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Vanilla soups and stews give it here too.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A good stew before a long trip is the cheapest travel insurance in the pack.\"}]"
  ],
  "quest.484404374247F7B6.title": "Master Chef",
  "quest.484404374247F7B6.quest_subtitle": "Twenty-seven plates. Nobody said at once.",
  "quest.484404374247F7B6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"One course of every meal Farmer's Delight serves.\"}]",
    "",
    "[\"\",{\"text\":\"27\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" dishes, from cooked rice to the stuffed pumpkin, eaten by you.\"}]",
    "",
    "Each new one also counts for Spice of Life.",
    "{@pagebreak}",
    "Soups, stews, pastas, the grill and every feast on the table.",
    "",
    "The pot, the board and the skillet have all earned their place."
  ],
  "quest.6209169BDCFA8F8D.title": "Soup kitchen",
  "quest.6209169BDCFA8F8D.quest_subtitle": "Same time tomorrow?",
  "quest.6209169BDCFA8F8D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Eight \"},{\"text\":\"Vegetable Soups\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:vegetable_soup\",\"count\":1}}},{\"text\":\" for the common store, once a day.\"}]",
    "",
    "A pot keeps cooking while the bowls last."
  ],
  "quest.7BE9272565596766.title": "Heat goes through",
  "quest.7BE9272565596766.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A hopper or a Create chute between the pot and the fire still passes the heat, and pulls the finished meals out. Ingredients go in from the top, bowls from the sides.\"}]"
  ],
  "quest.494730E1B5502978.title": "One machine per recipe",
  "quest.494730E1B5502978.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Once Create turns, the \"},{\"text\":\"Slicer\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"28984D492046759D\"}},{\"text\":\" runs the cutting-board recipes. Central Kitchen's saw and deployer copies of them and Slice and Dice's basin cooking are off, so each recipe shows up in one machine only.\"}]"
  ],
  "quest.4F5B21376BE057BC.title": "Wild butcher",
  "quest.4F5B21376BE057BC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Kill a pig or a hoglin with a knife and it drops \"},{\"text\":\"Ham\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:ham\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Smoke it for \"},{\"text\":\"Smoked Ham\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:smoked_ham\",\"count\":1}}},{\"text\":\", the heart of the honey glazed feast, or take it to the board: two porkchops and a bone.\"}]"
  ],
  "quest.407C269A4181174F.title": "If you can't take the heat",
  "quest.407C269A4181174F.quest_subtitle": "Or get out of the kitchen.",
  "quest.407C269A4181174F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Knives climb the usual ladder: flint, iron, gold, diamond.\"}]",
    "",
    "[\"\",{\"text\":\"A whole netherite ingot at the smithing table makes the \"},{\"text\":\"Netherite Knife\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:netherite_knife\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"A better knife lasts longer.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Fortune on it pays on the board.\"}]"
  ],
  "quest.4F75C73313B9BA5C.title": "Staff meals",
  "quest.4F75C73313B9BA5C.quest_subtitle": "The dog eats better than you did in act I.",
  "quest.4F75C73313B9BA5C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Farmer's Delight feeds your animals too.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:dog_food\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Rotten flesh, bone meal, raw meat and rice in the pot make \"},{\"text\":\"Dog Food\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:dog_food\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:horse_feed\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Hay or a rice bale, two apples and a golden carrot make \"},{\"text\":\"Horse Feed\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:horse_feed\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Their tooltips list what they do for a tamed wolf or a mount."
  ],
  "quest.5A61644E1853D20B.title": "A second set of utensils",
  "quest.5A61644E1853D20B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Croptopia cooks in the crafting grid, with its own tools.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:frying_pan\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A \"},{\"text\":\"Frying Pan\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:frying_pan\",\"count\":1}}},{\"text\":\" for over fifty recipes\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:cooking_pot\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A \"},{\"text\":\"Cooking Pot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:cooking_pot\",\"count\":1}}},{\"text\":\" for jams and ice cream\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:food_press\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A \"},{\"text\":\"Food Press\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:food_press\",\"count\":1}}},{\"text\":\" for juices and oils\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:mortar_and_pestle\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A \"},{\"text\":\"Mortar and Pestle\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:mortar_and_pestle\",\"count\":1}}}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:knife\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A \"},{\"text\":\"Knife\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:knife\",\"count\":1}}}]"
  ],
  "quest.4ECCD65911905F15.title": "Press, pour, drink",
  "quest.4ECCD65911905F15.quest_subtitle": "Hydration with extra steps.",
  "quest.4ECCD65911905F15.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Croptopia pours twenty-two drinks.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:grape_juice\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A glass bottle and the press turn grapes into \"},{\"text\":\"Grape Juice\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:grape_juice\",\"count\":1}}},{\"text\":\", lemons into lemonade and soybeans into soy milk.\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:wine\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Two grapes make \"},{\"text\":\"Wine\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:wine\",\"count\":1}}},{\"text\":\", hops and barley make beer.\"}]"
  ],
  "quest.2FF7F7B153C02B02.title": "Dinner around the world",
  "quest.2FF7F7B153C02B02.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Croptopia cooks by country.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:burrito\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A \"},{\"text\":\"Burrito\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:burrito\",\"count\":1}}},{\"text\":\" of tortilla, rice, black beans and tomato\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:fish_and_chips\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Fish and Chips\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:fish_and_chips\",\"count\":1}}},{\"text\":\" and a \"},{\"text\":\"Croque Monsieur\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:croque_monsieur\",\"count\":1}}},{\"text\":\" from the frying pan\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:sushi\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Sushi\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"croptopia:sushi\",\"count\":1}}},{\"text\":\" of seagrass, fish and rice\"}]"
  ],
  "quest.2E5B0F2EDA032D7D.title": "A breakfast beyond reason",
  "quest.2E5B0F2EDA032D7D.quest_subtitle": "The most important meal of the campaign.",
  "quest.2E5B0F2EDA032D7D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Six plates, one very long morning.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"A tuna sandwich from a dungeon chest\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Mountain salt from a shipwreck\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Cooked ravager meat\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"A cake crowned with a nether star\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"An omelette of the dragon egg itself\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"The big breakfast\"}]"
  ],
  "reward.50AA44274A637CE5.title": "Secret found",
  "quest.0819A2C4F788D8CE.title": "Pam's utensil drawer",
  "quest.0819A2C4F788D8CE.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Pam's Food Core cooks in the crafting grid with nine tools that are never used up.\"}]",
    "",
    "Copper makes the pot, skillet, saucepan and cutting board; terracotta the juicer and bakeware; planks the mixing bowl, andesite the grinder and a log the roller.",
    "",
    "[\"\",{\"text\":\"About \"},{\"text\":\"180\",\"color\":\"#E6C766\"},{\"text\":\" dishes follow, most from ingredients you already have.\"}]"
  ],
  "quest.34509DE6AFBF7254.title": "Stock the pantry",
  "quest.34509DE6AFBF7254.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A water bucket makes eight \"},{\"text\":\"Fresh Water\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"pamhc2foodcore:freshwateritem\",\"count\":1}}},{\"text\":\", a milk bucket eight fresh milk.\"}]",
    "",
    "[\"\",{\"text\":\"The pot turns water into \"},{\"text\":\"Salt\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"pamhc2foodcore:saltitem\",\"count\":1}}},{\"text\":\" and milk into \"},{\"text\":\"Butter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"pamhc2foodcore:butteritem\",\"count\":1}}},{\"text\":\", or into \"},{\"text\":\"Cheese\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"pamhc2foodcore:cheeseitem\",\"count\":1}}},{\"text\":\" with salt.\"}]",
    "",
    "[\"\",{\"text\":\"The grinder makes \"},{\"text\":\"Flour\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"pamhc2foodcore:flouritem\",\"count\":1}}},{\"text\":\" from wheat or other grains.\"}]"
  ],
  "quest.0BEBA194BF209D26.title": "Sunday chicken",
  "quest.0BEBA194BF209D26.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Pot, flour, raw chicken and cooking oil: \"},{\"text\":\"Fried Chicken\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"pamhc2foodcore:friedchickenitem\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Mixing bowl, baked potato, butter and salt: \"},{\"text\":\"Mashed Potatoes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"pamhc2foodcore:mashedpotatoesitem\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Both on the cutting board with a vegetable: a \"},{\"text\":\"Chicken Dinner\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"pamhc2foodcore:chickendinneritem\",\"count\":1}}},{\"text\":\", one of the routes to \"},{\"text\":\"Travel Rations\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2FEA6E9F24C83087\"}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The roller presses cooking oil out of canola, nuts or vegetables.\"}]"
  ],
  "quest.441A807E8AF62C26.title": "Any fruit will do",
  "quest.441A807E8AF62C26.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Pam's recipes ask for fruit by kind, not by mod.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Three of any fruit in the juicer make \"},{\"text\":\"Fruit Punch\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"pamhc2foodcore:fruitpunchitem\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Two on the cutting board make a \"},{\"text\":\"Fruit Salad\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"pamhc2foodcore:fruitsaladitem\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Every orchard in the pack feeds them."
  ],
  "quest.57AED951CA2AC124.title": "Epic bacon",
  "quest.57AED951CA2AC124.quest_subtitle": "Seven colors, one strip.",
  "quest.57AED951CA2AC124.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Nobody asked for rainbow bacon.\"}]",
    "",
    "Bakeware, cooked pork and seven dyes: red, orange, yellow, green, blue, purple and pink.",
    "",
    "Pam made it anyway."
  ],
  "reward.6EBAB0F7B73C063E.title": "Secret found",
  "quest.31C11EDE6863ECBA.title": "Say cheese",
  "quest.31C11EDE6863ECBA.quest_subtitle": "Curds, whey and patience.",
  "quest.31C11EDE6863ECBA.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Heat a cauldron from below and pour in milk, then add \"},{\"text\":\"Rennet\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"herbsandharvest:rennet\",\"count\":1}}},{\"text\":\" at once, or the milk turns to cream.\"}]",
    "",
    "[\"\",{\"text\":\"Wait for curds and whey, add \"},{\"text\":\"Salt\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"herbsandharvest:salt\",\"count\":1}}},{\"text\":\", and out comes a wheel. Cow's milk gives \"},{\"text\":\"Raw Cheddar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"herbsandharvest:raw_cheddar\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Rennet is a water bucket, a glass bottle and a \"},{\"text\":\"Thistle\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"00539AD577BA67F5\"}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Salt comes from a \"},{\"text\":\"salt basin\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2E39D96D48C4BBB6\"}},{\"text\":\".\"}]",
    "",
    "A dispenser can add both."
  ],
  "quest.44C544953C3BC486.title": "Not only cows",
  "quest.44C544953C3BC486.quest_subtitle": "The camel is not amused.",
  "quest.44C544953C3BC486.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A bucket on a goat or a sheep milks it; sneak and use it on a camel.\"}]",
    "",
    "Each milk makes other cheeses: goat for chèvre, sheep for gouda, camel for caravane, and mixes for parmesan, swiss, feta and ricotta."
  ],
  "quest.4A040B502207961E.title": "Time does the rest",
  "quest.4A040B502207961E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Hard cheeses age on a \"},{\"text\":\"Cheese Aging Shelf\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"herbsandharvest:cheese_shelf\",\"count\":1}}},{\"text\":\", two wheels at a time; hoppers load it and empty it.\"}]",
    "",
    "[\"\",{\"text\":\"An \"},{\"text\":\"Aged Cheddar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"herbsandharvest:aged_cheddar\",\"count\":1}}},{\"text\":\" set down gives four wedges, or four on the cutting board. A placed wheel never comes back up.\"}]"
  ],
  "quest.13F59C97FF90F6C7.title": "Eight servings, one pan",
  "quest.13F59C97FF90F6C7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Fill an iron \"},{\"text\":\"Baking Pan\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"herbsandharvest:pan\",\"count\":1}}},{\"text\":\" with the ingredients, bake it in a furnace and set the \"},{\"text\":\"Pan of Lasagna\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"herbsandharvest:lasagna_pan\",\"count\":1}}},{\"text\":\" on the table.\"}]",
    "",
    "[\"\",{\"text\":\"Each \"},{\"text\":\"Dinner Plate\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"herbsandharvest:dinner_plate\",\"count\":1}}},{\"text\":\" takes one of its eight servings.\"}]"
  ],
  "quest.24AFEBEE9D973F10.title": "The field sandwich",
  "quest.24AFEBEE9D973F10.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Cooked beef, two bread slices, cheddar, lettuce, mayonnaise and tomato: a \"},{\"text\":\"Beef and Cheddar Sandwich\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"herbsandharvest:beef_cheddar\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Two of them and two \"},{\"text\":\"Fish Stews\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:fish_stew\",\"count\":1}}},{\"text\":\" are another way to pack \"},{\"text\":\"Travel Rations\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2FEA6E9F24C83087\"}},{\"text\":\".\"}]"
  ],
  "quest.418EF78F1339E392.title": "A kitchen that reads recipes",
  "quest.418EF78F1339E392.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Smelt a book into \"},{\"text\":\"Cooking for Blockheads I\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"cookingforblockheads:recipe_book\",\"count\":1}}},{\"text\":\": it lists what you can cook right now.\"}]",
    "",
    "[\"\",{\"text\":\"Two diamonds and two crafting tables turn it into \"},{\"text\":\"Cooking for Blockheads II\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"cookingforblockheads:crafting_book\",\"count\":1}}},{\"text\":\", which cooks from your inventory.\"}]",
    "",
    "[\"\",{\"text\":\"Built into a \"},{\"text\":\"Cooking Table\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"cookingforblockheads:cooking_table\",\"count\":1}}},{\"text\":\", it cooks from the whole kitchen.\"}]"
  ],
  "quest.0291675EEB56ED5D.title": "Everything within reach",
  "quest.0291675EEB56ED5D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A chest and an iron door make a \"},{\"text\":\"Fridge\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"cookingforblockheads:white_fridge\",\"count\":1}}},{\"text\":\"; a \"},{\"text\":\"Kitchen Counter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"cookingforblockheads:counter\",\"count\":1}}},{\"text\":\" and cabinets store more.\"}]",
    "",
    "Joined to the cooking table, whatever they hold counts as an ingredient.",
    "",
    "Kitchen floor and connectors link blocks across a gap or around a corner."
  ],
  "quest.261EFAA27C928268.title": "Water and milk on tap",
  "quest.261EFAA27C928268.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A \"},{\"text\":\"Sink\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"cookingforblockheads:sink\",\"count\":1}}},{\"text\":\" gives the kitchen endless water, and a \"},{\"text\":\"Milk Jar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"cookingforblockheads:milk_jar\",\"count\":1}}},{\"text\":\" keeps milk for its recipes.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A cow nearby and something heavy could keep that jar full forever.\"}]"
  ],
  "quest.261A8D385121A7A3.title": "The oven",
  "quest.261A8D385121A7A3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A furnace dressed in iron and black glass: an \"},{\"text\":\"Oven\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"cookingforblockheads:white_oven\",\"count\":1}}},{\"text\":\" that cooks for the whole kitchen.\"}]",
    "",
    "It has its own fuel and slots.",
    "",
    "[\"\",{\"text\":\"A \"},{\"text\":\"Heating Unit\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"cookingforblockheads:heating_unit\",\"count\":1}}},{\"text\":\" lets it run on energy instead of fuel.\"}]"
  ],
  "quest.3938174A2187F7D8.title": "Cow in a jar",
  "quest.3938174A2187F7D8.quest_subtitle": "Ethically questionable dairy.",
  "quest.3938174A2187F7D8.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Lure a cow onto a \"},{\"text\":\"Milk Jar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"cookingforblockheads:milk_jar\",\"count\":1}}},{\"text\":\" and drop an anvil on it.\"}]",
    "",
    "[\"\",{\"text\":\"What is left, a \"},{\"text\":\"Cow in a Jar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"cookingforblockheads:cow_jar\",\"count\":1}}},{\"text\":\", makes milk forever and asks no questions.\"}]"
  ],
  "reward.617459E01B90D644.title": "Secret found",
  "quest.27D38F5307E82FBD.title": "Rice, the right way",
  "quest.27D38F5307E82FBD.quest_subtitle": "Not too wet, not too dry.",
  "quest.27D38F5307E82FBD.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Sushi Go Crafting's seeds come from breaking grass, and its rice grows underwater on dirt.\"}]",
    "",
    "[\"\",{\"text\":\"A \"},{\"text\":\"Rice Cooker\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"sushigocrafting:rice_cooker\",\"count\":1}}},{\"text\":\" of iron, a furnace, redstone and a light pressure plate turns rice, water and fuel into \"},{\"text\":\"Cooked Rice\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"sushigocrafting:cooked_rice\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.7016ED64739DFD99.title": "Cleaver and board",
  "quest.7016ED64739DFD99.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Put fish or produce on the sushi \"},{\"text\":\"Cutting Board\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"sushigocrafting:cutting_board\",\"count\":1}}},{\"text\":\" and use the \"},{\"text\":\"Cleaver Knife\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"sushigocrafting:cleaver_knife\",\"count\":1}}},{\"text\":\" on it.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Salmon and tuna turn into fillets.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Avocado and cucumber turn into slices.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Cod turns into imitation crab.\"}]",
    "",
    "Sneak and use the board to take things back."
  ],
  "quest.349CB0D0BC4F2090.title": "Pressed seaweed",
  "quest.349CB0D0BC4F2090.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Drop a dried kelp block between a piston and an iron block, and the piston squeezes it into \"},{\"text\":\"Nori Sheets\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"sushigocrafting:nori_sheets\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Kelp grows in any ocean."
  ],
  "quest.3592D742DC428127.title": "Tuna and shrimp",
  "quest.3592D742DC428127.quest_subtitle": "Sashimi grade.",
  "quest.3592D742DC428127.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Tuna and shrimp swim in the oceans and drop \"},{\"text\":\"Raw Tuna\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"sushigocrafting:raw_tuna\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Shrimp\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"sushigocrafting:shrimp\",\"count\":1}}},{\"text\":\"; a bucket brings them home alive.\"}]",
    "",
    "[\"\",{\"text\":\"Killing fish also drops \"},{\"text\":\"Tobiko\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"sushigocrafting:tobiko\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.5E52DEB7BB3ECF42.title": "The perfect roll",
  "quest.5E52DEB7BB3ECF42.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Bamboo and string make a \"},{\"text\":\"Roller\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"sushigocrafting:roller\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Pick the sushi, place the ingredients, set how much of each, then click the roller until it rolls.",
    "",
    "[\"\",{\"text\":\"The perfect weight makes a better \"},{\"text\":\"Salmon Maki\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"sushigocrafting:salmon_maki\",\"count\":1}}},{\"text\":\", and the roller remembers every perfect weight you find.\"}]"
  ],
  "quest.3B4B147E249F11A5.title": "Omakase",
  "quest.3B4B147E249F11A5.quest_subtitle": "Chef's choice. The chef is you.",
  "quest.3B4B147E249F11A5.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Five styles of sushi, and every ingredient carries an effect.\"}]",
    "",
    "Nigiri, gunkan, temaki, california and onigiri: each style takes different ingredients.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Acquired Taste\",\"color\":\"#E6C766\"},{\"text\":\" adds food to what you eat.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Small Bites\",\"color\":\"#E6C766\"},{\"text\":\" sometimes spares the bite.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Steady Hands\",\"color\":\"#E6C766\"},{\"text\":\" adds weight on the board.\"}]"
  ],
  "quest.5F3E54942A4BE8EF.title": "Hearts for variety",
  "quest.5F3E54942A4BE8EF.quest_subtitle": "An apple a day is not enough.",
  "quest.5F3E54942A4BE8EF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Spice of Life counts every different food you eat, and pays in hearts.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"A heart at \"},{\"text\":\"10\",\"color\":\"#E6C766\"},{\"text\":\", \"},{\"text\":\"25\",\"color\":\"#E6C766\"},{\"text\":\", \"},{\"text\":\"45\",\"color\":\"#E6C766\"},{\"text\":\", \"},{\"text\":\"70\",\"color\":\"#E6C766\"},{\"text\":\" and \"},{\"text\":\"100\",\"color\":\"#E6C766\"},{\"text\":\" foods: five over the base ten\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Death keeps them.\"}]",
    "",
    "[\"\",{\"text\":\"A book and a carrot make the \"},{\"text\":\"Food Book\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"solcarrot:food_book\",\"count\":1}}},{\"text\":\" that shows your list.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A food must fill at least half a drumstick to count.\"}]"
  ],
  "quest.61DA3B7739F1D466.title": "Two messages at once",
  "quest.61DA3B7739F1D466.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"When a new food both counts for Spice of Life and overflows, Spice of Life's line stays above the hotbar; the buff icons and sparkles still show what you got. AppleSkin previews a food's hunger and saturation: aim for the surplus.\"}]"
  ],
  "quest.795AA46FEC18B774.title": "Nothing eaten is wasted",
  "quest.795AA46FEC18B774.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Here the surplus turns into short random buffs, more and longer the bigger it is.\"}]",
    "",
    "[\"\",{\"text\":\"You only eat below \"},{\"text\":\"20\",\"color\":\"#E6C766\"},{\"text\":\" hunger, so most surplus is saturation: a rich meal when you are not that hungry.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"Vanilla stops hunger at \"},{\"text\":\"20\",\"color\":\"#E6C766\"},{\"text\":\" and saturation at your hunger level; whatever a meal adds past that is lost.\"}]"
  ],
  "quest.20A33F8FE7351249.title": "How many, how long",
  "quest.20A33F8FE7351249.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Under \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\" points of surplus, nothing.\"}]",
    "",
    "[\"\",{\"text\":\"From \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\", one buff, plus one every \"},{\"text\":\"10\",\"color\":\"#E6C766\"},{\"text\":\" points, up to three.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Durations grow with the surplus and top out at \"},{\"text\":\"20\",\"color\":\"#E6C766\"},{\"text\":\" points.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"From \"},{\"text\":\"16\",\"color\":\"#E6C766\"},{\"text\":\", buffs that allow it come at level II.\"}]",
    "",
    "The action bar names what you got.",
    "{@pagebreak}",
    "No buffs in creative or spectator, nor for fake players such as Create deployers."
  ],
  "quest.632BB29C19DACBBF.title": "The buff pool",
  "quest.632BB29C19DACBBF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The buffs are drawn by weight, never twice in one meal.\"}]",
    "",
    "Haste, Speed, Absorption and Luck (up to II), Regeneration, Strength, Resistance, Water Breathing and Night Vision.",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"A buff only adds or extends.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"It never replaces a stronger or endless effect.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Server owners: every number lives in data/entrelumen/satiety/overflow.json, and a datapack at that path replaces it.\"}]"
  ],
  "quest.1D8BC6BE01CD5AD2.title": "Worked examples",
  "quest.1D8BC6BE01CD5AD2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"With no recent overeating: bread at \"},{\"text\":\"19\",\"color\":\"#E6C766\"},{\"text\":\" hunger and \"},{\"text\":\"15\",\"color\":\"#E6C766\"},{\"text\":\" saturation is \"},{\"text\":\"5\",\"color\":\"#E6C766\"},{\"text\":\" points, one buff.\"}]",
    "",
    "[\"\",{\"text\":\"A \"},{\"text\":\"Plate of Roast Chicken\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"farmersdelight:roast_chicken\",\"count\":1}}},{\"text\":\" at \"},{\"text\":\"14\",\"color\":\"#E6C766\"},{\"text\":\" and \"},{\"text\":\"8\",\"color\":\"#E6C766\"},{\"text\":\" is \"},{\"text\":\"17\",\"color\":\"#E6C766\"},{\"text\":\" points: two buffs, level II where allowed.\"}]",
    "",
    "[\"\",{\"text\":\"A cookie at \"},{\"text\":\"19\",\"color\":\"#E6C766\"},{\"text\":\" and \"},{\"text\":\"19\",\"color\":\"#E6C766\"},{\"text\":\" is \"},{\"text\":\"1\",\"color\":\"#E6C766\"},{\"text\":\" point: nothing.\"}]"
  ],
  "quest.1220B712D2C97C4B.title": "Glut",
  "quest.1220B712D2C97C4B.quest_subtitle": "Pace yourself.",
  "quest.1220B712D2C97C4B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"After a buff, ten seconds of nothing.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Every surplus also feeds a hidden glut that halves every five minutes.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"The more glut you carry, the less new surplus is worth.\"}]",
    "",
    "[\"\",{\"text\":\"Five \"},{\"text\":\"Honey Bottles\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:honey_bottle\",\"count\":1}}},{\"text\":\" in a row buy one buff and a stomachache.\"}]"
  ],
  "quest.4054F7EA70F42E88.title": "Food that ignores a full bar",
  "quest.4054F7EA70F42E88.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Golden apples, chorus fruit, suspicious stew, honey bottles and some drinks go down at full hunger, so they are the only way to overflow hunger itself. Space them out: the glut remembers.\"}]"
  ],
  "quest.2FEA6E9F24C83087.title": "Rations for the road",
  "quest.2FEA6E9F24C83087.quest_subtitle": "Pack a lunch. The road is long.",
  "quest.2FEA6E9F24C83087.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Three recipes share one drawing: bowls on the axis, dishes at the sides.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Two Vegetable Soups with two cooked Aquaculture fish fillets\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Two Vegetable Soups with two \"},{\"text\":\"Chicken Dinners\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0BEBA194BF209D26\"}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Two Fish Stews with two \"},{\"text\":\"Beef and Cheddar Sandwiches\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"24AFEBEE9D973F10\"}}]",
    "",
    "The bowls come back."
  ],
  "quest.408556EEDFCE671E.title": "The habitation charter",
  "quest.408556EEDFCE671E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"In act V the Ark needs a place worth coming back to: the \"},{\"text\":\"Habitation Charter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:habitation_contract\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "It takes:",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Two Fish Stews\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Two Mixed Salads\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"An AE2 Calculation Processor\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Two Travel Rations\"}]",
    "",
    "A kitchen that cooks by itself turns it into an errand."
  ],
  "quest.57235F2902A239A5.title": "A stove for the Nether",
  "quest.57235F2902A239A5.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Nether bricks over polished blackstone bricks and a campfire make the \"},{\"text\":\"Nether Stove\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mynethersdelight:nether_bricks_stove\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "It burns blue with a soul campfire.",
    "",
    "My Nether's Delight cooks hoglin loin, strider and ghast in the same pot and on the same board."
  ],
  "quest.76F38BDBF0F447AF.title": "The whole hoglin",
  "quest.76F38BDBF0F447AF.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Hoglin hide, hams, loins and both fungus colonies make a \"},{\"text\":\"Raw Stuffed Hoglin\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mynethersdelight:raw_stuffed_hoglin\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Into the pot with a hot spice, a crimson fungus and two nether salads: a \"},{\"text\":\"Roast Stuffed Hoglin\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mynethersdelight:roast_stuffed_hoglin\",\"count\":1}}},{\"text\":\" for the whole crew.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Hide comes off a hoglin killed with something lighter than a sword: a knife.\"}]"
  ],
  "quest.04397981AE0EF92C.title": "A stove at the end of the world",
  "quest.04397981AE0EF92C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Popped chorus fruit, end stone bricks and a campfire: the \"},{\"text\":\"End Stove\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ends_delight:end_stove\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "End's Delight cuts shulker meat, dragon meat and chorus fruit on the same board, and makes knives of end stone and purpur."
  ],
  "quest.42D25BDE037AB337.title": "An egg worth a star",
  "quest.42D25BDE037AB337.quest_subtitle": "Omelette of legends.",
  "quest.42D25BDE037AB337.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Four obsidian, four end crystals and a dragon tooth from the Ender Dragon make a \"},{\"text\":\"Non Hatchable Dragon Egg\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ends_delight:non_hatchable_dragon_egg\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "Crack it on the cutting board with a nether star as the tool: liquid egg, and a shell to cook the feasts in."
  ],
  "quest.6DC28439D3B85705.title": "Chewy, and it teleports",
  "quest.6DC28439D3B85705.quest_subtitle": "Chew responsibly.",
  "quest.6DC28439D3B85705.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Enderman gristle does to you what it did to the enderman: one bite and you are somewhere else.\"}]",
    "",
    "The game even has a death message for landing badly."
  ],
  "reward.60974DC33B653987.title": "Secret found",
  "quest.2B2C389B01006E55.title": "Cooking above the clouds",
  "quest.2B2C389B01006E55.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Arkenium tops the \"},{\"text\":\"Holystone Stove\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aethersdelight:holystone_stove\",\"count\":1}}},{\"text\":\" over holystone bricks and a campfire.\"}]",
    "",
    "It is a metal of the Aether that needs a zanite pickaxe.",
    "",
    "Aether's Delight adds moa roasts, knives of holystone, zanite and gravitite, and its own furnace and smoker."
  ],
  "quest.1DC8387EA4042DAE.title": "Cookie cutters",
  "quest.1DC8387EA4042DAE.quest_subtitle": "Run, run, as fast as you can.",
  "quest.1DC8387EA4042DAE.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Arkenium nuggets bend into three cookie cutters.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"A man\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"A star\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aethersdelight:cookie_cutter_moa\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"A \"},{\"text\":\"Moa Cookie Cutter\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aethersdelight:cookie_cutter_moa\",\"count\":1}}}]",
    "",
    "Egg, ginger spice, wheat and sugar make the dough.",
    "",
    "[\"\",{\"text\":\"Cut it on the board with a cutter as the tool and bake a \"},{\"text\":\"Gingerbread Moa\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aethersdelight:gingerbread_moa\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.4C3A5C1111D60D0A.title": "A pot that brings its own fire",
  "quest.4C3A5C1111D60D0A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The \"},{\"text\":\"Fiery Cooking Pot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"twilightdelight:fiery_cooking_pot\",\"count\":1}}},{\"text\":\" heats itself and cooks Twilight meals faster.\"}]",
    "",
    "Mazestone bricks, fiery ingots, an ironwood shovel and a water bucket make it.",
    "",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Maze Stove\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"twilightdelight:maze_stove\",\"count\":1}}},{\"text\":\", of knightmetal and torchberries, speeds them up too.\"}]"
  ],
  "quest.3D4696261A8F3CD7.title": "Knives from the Twilight",
  "quest.3D4696261A8F3CD7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Ironwood, steeleaf and knightmetal each make a knife.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"The knightly one hits armored targets harder.\"}]",
    "",
    "[\"\",{\"text\":\"The \"},{\"text\":\"Fiery Knife\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"twilightdelight:fiery_knife\",\"count\":1}}},{\"text\":\" burns what it hits and cooks food as it cuts.\"}]"
  ],
  "quest.04D32E12B66C0A34.title": "Experiment 113",
  "quest.04D32E12B66C0A34.quest_subtitle": "Do not ask what happened to 111 and 112.",
  "quest.04D32E12B66C0A34.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Nobody knows what the numbers mean.\"}]",
    "",
    "Put the Ur-Ghast's trophy on a cutting board and use a knife on it:",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Nine Experiment \"},{\"text\":\"113\",\"color\":\"#E6C766\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Four Experiment \"},{\"text\":\"115\",\"color\":\"#E6C766\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"One time in ten, an Experiment \"},{\"text\":\"110\",\"color\":\"#E6C766\"}]"
  ],
  "reward.0C0443FC3EF3C16D.title": "Secret found",
  "quest.2261818BCD3F5333.title": "Ring the dinner bell",
  "quest.2261818BCD3F5333.quest_subtitle": "Come and get it.",
  "quest.2261818BCD3F5333.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Somebody always turns up hungry.\"}]",
    "",
    "Nothing to cook. Just a ring."
  ],
  "image.2DB9CD27223AEF3C.title": "[\"\",{\"text\":\"FARM\",\"color\":\"#F3E7C6\",\"bold\":true}]",
  "image.0BE91819A7D4D06C.title": "[\"\",{\"text\":\"Kitchen\",\"color\":\"#E8B04A\"}]",
  "image.5071092AC323EBF3.title": "Back to the Sun of Heliodor",
  "image.2893F6546AB46219.title": "[\"\",{\"text\":\"Croptopia\",\"color\":\"#F3E7C6\"}]",
  "image.4EEC15BEB47E11AA.title": "[\"\",{\"text\":\"Pam's HarvestCraft\",\"color\":\"#F3E7C6\"}]",
  "image.7F2F84F62B6738C8.title": "[\"\",{\"text\":\"Herbs and Harvest\",\"color\":\"#F3E7C6\"}]",
  "image.5AEE824DE25B11E5.title": "[\"\",{\"text\":\"Nether and End\",\"color\":\"#F3E7C6\"}]",
  "image.71658D33A3731187.title": "[\"\",{\"text\":\"The pantry\",\"color\":\"#F3E7C6\"}]",
  "image.06D73AA9DDC9DC58.title": "[\"\",{\"text\":\"Farmer's Delight\",\"color\":\"#F3E7C6\"}]",
  "image.13B87C553CF4510B.title": "[\"\",{\"text\":\"Cooking for Blockheads\",\"color\":\"#F3E7C6\"}]",
  "image.6339315BB9BEFD5C.title": "[\"\",{\"text\":\"Sushi Go Crafting\",\"color\":\"#F3E7C6\"}]",
  "image.2F84C42E45A1944E.title": "[\"\",{\"text\":\"The menu\",\"color\":\"#F3E7C6\"}]",
  "image.4782CC2734ACC42E.title": "[\"\",{\"text\":\"For the road\",\"color\":\"#F3E7C6\"}]",
  "image.567883AF4FFB2D3D.title": "[\"\",{\"text\":\"Aether and Twilight\",\"color\":\"#F3E7C6\"}]",
  "chapter.23C6117EB2888697.title": "Farm · Pots and Automation",
  "chapter.23C6117EB2888697.chapter_subtitle": [
    "Botany Pots, tiers, soils and hoppers, and trees in pots."
  ],
  "quest.5EDB0491D1D23CD9.title": "A farm in a pot",
  "quest.5EDB0491D1D23CD9.quest_subtitle": "Farming, apartment edition.",
  "quest.5EDB0491D1D23CD9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Soil, seed and a corner of the shelf: no field needed.\"}]",
    "",
    "[\"\",{\"text\":\"A \"},{\"text\":\"Botany Pot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"botanypots:terracotta_botany_pot\",\"count\":1}}},{\"text\":\" is a \"},{\"text\":\"Flower Pot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:flower_pot\",\"count\":1}}},{\"text\":\" ringed by \"},{\"text\":\"5\",\"color\":\"#E6C766\"},{\"text\":\" terracotta.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Right-click it to load soil, seed and tool. Right-click a grown one to harvest.\"}]",
    "{@pagebreak}",
    "Every pot comes plain, with a hopper or waxed.",
    "",
    "[\"\",{\"text\":\"61\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" materials: terracotta in 17 colours, glazed and concrete in 16 each, and twelve kinds of brick.\"}]"
  ],
  "quest.12F7D1660A7EC383.title": "First harvest",
  "quest.12F7D1660A7EC383.quest_subtitle": "Sixty seconds of patience.",
  "quest.12F7D1660A7EC383.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Soil and a seed in, a crop out.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Top slot, soil: \"},{\"text\":\"Dirt\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:dirt\",\"count\":1}}},{\"text\":\" will do.\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:wheat_seeds\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Second slot, seed: \"},{\"text\":\"Wheat Seeds\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:wheat_seeds\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"Wheat is ready in \"},{\"text\":\"60\",\"color\":\"#E6C766\"},{\"text\":\" seconds.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Each crop sets its own time: trees take \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\" minutes, sculk two to five.\"}]"
  ],
  "quest.6CE4CDD69A080D72.title": "Hopper pot",
  "quest.6CE4CDD69A080D72.quest_subtitle": "The pot that harvests itself.",
  "quest.6CE4CDD69A080D72.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"It harvests on its own and hands the crop to whatever sits below.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Shapeless: a \"},{\"text\":\"Hopper\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:hopper\",\"count\":1}}},{\"text\":\" and a pot.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Or the quick recipe: the hopper in the pot's top gap.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Twelve slots hold the harvest.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"Full slots lose the new harvest. Put a container under it.\"}]"
  ],
  "quest.74566BCAF79C084B.title": "Elite Upgrade",
  "quest.74566BCAF79C084B.quest_subtitle": "Act III, in white trim.",
  "quest.74566BCAF79C084B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A white band on the pot and triple the work.\"}]",
    "",
    "[\"\",{\"text\":\"×3\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" speed, \"},{\"text\":\"×3\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" harvest.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Two \"},{\"text\":\"Iron Ingots\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:iron_ingot\",\"count\":1}}},{\"text\":\" flanking a \"},{\"text\":\"Propagation Core\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:propagation_core\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Sneak-click it on a placed pot: the contents stay.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"The core is an act III delivery: \"},{\"text\":\"Seeds of Continuity\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"075794DD2C2DFAA0\"}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"The tooltip says Speed \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\" and Multiplier \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\". They add to the base \"},{\"text\":\"1\",\"color\":\"#E6C766\"},{\"text\":\": the pot runs at ×3, so wheat takes \"},{\"text\":\"20\",\"color\":\"#E6C766\"},{\"text\":\" seconds.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A whole new pot takes the upgrade, \"},{\"text\":\"5\",\"color\":\"#E6C766\"},{\"text\":\" terracotta, \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\" iron ingots and a plain pot.\"}]"
  ],
  "quest.48A2C778A47A2FD7.title": "Ultra Upgrade",
  "quest.48A2C778A47A2FD7.quest_subtitle": "Act IV, cyan trim.",
  "quest.48A2C778A47A2FD7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A cyan band: seven times the speed, four times the harvest.\"}]",
    "",
    "[\"\",{\"text\":\"×7\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" speed, \"},{\"text\":\"×4\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" harvest.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Two \"},{\"text\":\"Diamonds\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\" flanking an \"},{\"text\":\"Ecosystem Capsule\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:ecosystem_capsule\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Sneak-click it on an Elite pot.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"The capsule is an act IV delivery: \"},{\"text\":\"A small agreement\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"780224C0B0190A32\"}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Wheat takes \"},{\"text\":\"20\",\"color\":\"#E6C766\"},{\"text\":\" seconds in an Elite pot and \"},{\"text\":\"8.5\",\"color\":\"#E6C766\"},{\"text\":\" in an Ultra.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A whole new pot takes the upgrade, \"},{\"text\":\"5\",\"color\":\"#E6C766\"},{\"text\":\" terracotta, \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\" diamonds and an Elite pot.\"}]"
  ],
  "quest.11415ECC40754CC5.title": "Mega Upgrade",
  "quest.11415ECC40754CC5.quest_subtitle": "Act V, red trim.",
  "quest.11415ECC40754CC5.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A red band: eleven times the speed, five times the harvest.\"}]",
    "",
    "[\"\",{\"text\":\"×11\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" speed, \"},{\"text\":\"×5\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" harvest.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Two \"},{\"text\":\"Netherite Ingots\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:netherite_ingot\",\"count\":1}}},{\"text\":\" flanking a \"},{\"text\":\"Renewal Engine\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:renewal_engine\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Sneak-click it on an Ultra pot.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"The engine is an act V delivery: \"},{\"text\":\"The reserve's engine\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6F3334D0429BBA36\"}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"In the pack's own test, a Mega hopper pot grew wheat in \"},{\"text\":\"109\",\"color\":\"#E6C766\"},{\"text\":\" ticks: \"},{\"text\":\"5.4\",\"color\":\"#E6C766\"},{\"text\":\" seconds.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A whole new pot takes the upgrade, \"},{\"text\":\"5\",\"color\":\"#E6C766\"},{\"text\":\" terracotta, \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\" netherite ingots and an Ultra pot.\"}]"
  ],
  "quest.2DF906FBE910488B.title": "The Greenhouse",
  "quest.2DF906FBE910488B.quest_subtitle": "Load it once, then walk away.",
  "quest.2DF906FBE910488B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A Mega hopper pot over a chest: crop after crop, by itself.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"A hopper on a Mega pot, or a Mega upgrade on an Ultra hopper pot.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Soil, seed and tool go in once, by hand.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"The chest below takes the rest.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"An upgrade keeps the colour, the hopper and everything inside.\"}]"
  ],
  "quest.093B8CA6C20B5373.title": "Ground rules",
  "quest.093B8CA6C20B5373.quest_subtitle": "A pot is only as good as its dirt.",
  "quest.093B8CA6C20B5373.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The soil decides what can grow in it.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Dirt family: dirt, grass, podzol, mycelium, moss, mud, farmland.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Sand: cactus and sugar cane.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Soul sand or soul soil: nether wart.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"End stone: chorus. Sculk: sculk crops.\"}]",
    "{@pagebreak}",
    "Two soils are also faster:",
    "",
    "[\"\",{\"text\":\"+10%\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" speed on farmland and on a Sculk Catalyst.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"At Mega speed that bonus is a rounding error: +0.1 on top of 11.\"}]"
  ],
  "task.2A3B42CD7FD12379.title": "Any hoe",
  "quest.6B809B4A31C8D442.title": "Click the soil",
  "quest.6B809B4A31C8D442.quest_subtitle": "The pot is a workbench too.",
  "quest.6B809B4A31C8D442.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Tools and buckets change the soil without taking it out.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Hoe on dirt: farmland. On coarse or rooted dirt: plain dirt.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Shovel on grass, dirt, podzol or mycelium: a dirt path.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Water bucket on a lava-bucket soil: obsidian. Lava bucket on a water-bucket soil: stone.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A hoe on rooted dirt also drops hanging roots.\"}]"
  ],
  "task.4780326ECC6E74C0.title": "A hoe or shears",
  "quest.2BC5E4CF6FEB518E.title": "The tool slot",
  "quest.2BC5E4CF6FEB518E.quest_subtitle": "The pot borrows your hoe.",
  "quest.2BC5E4CF6FEB518E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The third slot takes a hoe or shears, and that tool judges the harvest.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:shears\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Shears\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:shears\",\"count\":1}}},{\"text\":\": trees drop their leaves.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Efficiency: \"},{\"text\":\"+5%\",\"color\":\"#E6C766\"},{\"text\":\" growth speed per level.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Fortune counts for crops whose loot asks for it.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Careful: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"Each harvest wears the tool down.\"}]",
    "{@pagebreak}",
    "The Curse of Idle Hands stops the wear, and leaves the tool useless in your hands.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Librarians can sell it.\"}]"
  ],
  "quest.4B7CADDB99FB8394.title": "Bone meal helps",
  "quest.4B7CADDB99FB8394.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Bone meal on a growing pot skips \"},{\"text\":\"400\",\"color\":\"#E6C766\"},{\"text\":\" to \"},{\"text\":\"600\",\"color\":\"#E6C766\"},{\"text\":\" ticks, up to ready.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:bone_meal\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Plain wheat takes two or three; in an Elite pot, one.\"}]"
  ],
  "quest.0252E2F221E3C7ED.title": "Read the growth",
  "quest.0252E2F221E3C7ED.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"A comparator beside a pot reads it: the signal climbs while the crop grows and hits \"},{\"text\":\"15\",\"color\":\"#E6C766\"},{\"text\":\" when it is ready.\"}]",
    "",
    "Enough to switch a lamp on, or a farm off."
  ],
  "quest.499E1F2A67C8058B.title": "Frozen in bloom",
  "quest.499E1F2A67C8058B.quest_subtitle": "Honeycomb turns a pot into a statue.",
  "quest.499E1F2A67C8058B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Wax a pot and its plant stays at full growth for good.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"A \"},{\"text\":\"Honeycomb\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:honeycomb\",\"count\":1}}},{\"text\":\" and a pot, shapeless: a \"},{\"text\":\"Waxed Botany Pot\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"botanypots:terracotta_waxed_botany_pot\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Nothing goes in and nothing comes out.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Wax a full pot for the display shelf.\"}]"
  ],
  "quest.1DAB6DFC061BFB67.title": "Empty from below",
  "quest.1DAB6DFC061BFB67.quest_subtitle": "Nothing goes in from outside.",
  "quest.1DAB6DFC061BFB67.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Hopper pots empty through the bottom face, and only through it.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"A chest, a hopper or a pipe under the pot takes the harvest.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Soil, seed and tool can only be loaded by hand.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Basic pots have no automatic output at all.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Pipes and routers: \"},{\"text\":\"Logistics Networks\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"57D95FCA49DD6FFA\"}},{\"text\":\" and \"},{\"text\":\"Modular Routers\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"335E1EBA8FB3C477\"}},{\"text\":\".\"}]"
  ],
  "quest.58E2FB172D4B055C.title": "Buckets are soil",
  "quest.58E2FB172D4B055C.quest_subtitle": "Yes, a bucket of cod works.",
  "quest.58E2FB172D4B055C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A water bucket is a valid soil, and so is any bucket of fish.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Kelp\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:kelp\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Seagrass\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:seagrass\",\"count\":1}}},{\"text\":\" and \"},{\"text\":\"Sea Pickle\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:sea_pickle\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Corals and coral fans.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Lily Pads\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:lily_pad\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Salmon, cod, tropical fish, pufferfish, axolotl and tadpole buckets all count.\"}]"
  ],
  "quest.35B78EA93BB73AC6.title": "The Nether on a shelf",
  "quest.35B78EA93BB73AC6.quest_subtitle": "No fortress required.",
  "quest.35B78EA93BB73AC6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Soul soil and nylium turn a pot into a piece of the Nether.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:nether_wart\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Nether Wart\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:nether_wart\",\"count\":1}}},{\"text\":\" grows on soul sand or soul soil.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Fungus and roots take nylium or netherrack.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Crimson fungus also drops \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" shroomlight and \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" wart blocks.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Past the Nether: \"},{\"text\":\"Chorus Flower\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:chorus_flower\",\"count\":1}}},{\"text\":\" on \"},{\"text\":\"End Stone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:end_stone\",\"count\":1}}},{\"text\":\" gives chorus fruit and, now and then, another flower.\"}]"
  ],
  "quest.4A322C5C28B6CB3D.title": "A sculk garden",
  "quest.4A322C5C28B6CB3D.quest_subtitle": "The Warden is not invited.",
  "quest.4A322C5C28B6CB3D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Sculk grows on sculk: farm it without a Warden in sight.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Soil: \"},{\"text\":\"Sculk\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:sculk\",\"count\":1}}},{\"text\":\" or a \"},{\"text\":\"Sculk Catalyst\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:sculk_catalyst\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Sculk takes \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\" minutes; catalyst, sensor and shrieker crops, \"},{\"text\":\"5\",\"color\":\"#E6C766\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Each harvest: sculk, plus \"},{\"text\":\"15%\",\"color\":\"#E6C766\"},{\"text\":\" catalyst, \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" sensor and \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" shrieker.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"The Echo Tree of Deeper and Darker grows on sculk too.\"}]"
  ],
  "quest.6547E0A02647A224.title": "Fibres, oil and dreams",
  "quest.6547E0A02647A224.quest_subtitle": "Field crops that keep the machines fed.",
  "quest.6547E0A02647A224.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Industry's crops grow in pots too.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" \"},{\"text\":\"Hemp: \"},{\"text\":\"Industrial hemp\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"370620B2987FD43B\"}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Flax, from Silent Gear and Actually Additions: \"},{\"text\":\"Flax\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3DD29656FE7C8536\"}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Canola: \"},{\"text\":\"Canola oil\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"69AA923D35150556\"}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Demon's Dream\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:datura\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"Demon's Dream\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"55F0051E7C82041E\"}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Put a Fortune tool in the tool slot: hemp, flax and canola ask for it.\"}]"
  ],
  "task.683EDF58BE7C5F6E.title": "A Farmer's Delight crop",
  "quest.55229EA85F7AE6E0.title": "A garden of hundreds",
  "quest.55229EA85F7AE6E0.quest_subtitle": "Most of the pack's farms already fit a pot.",
  "quest.55229EA85F7AE6E0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Most crop mods in the pack ship a pot recipe.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"200\",\"color\":\"#E6C766\"},{\"text\":\" Pam's HarvestCraft crops and \"},{\"text\":\"121\",\"color\":\"#E6C766\"},{\"text\":\" from Herbs and Harvest.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Farmer's Delight: rice, tomato, cabbage, onion and their wild forms.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Sushi Go: cucumber, rice, sesame, soy and wasabi.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Croptopia's crops are off in this pack: its pot recipes use a pre-1.21 format that no longer loads.\"}]",
    "",
    "[\"\",{\"text\":\"The rest of the garden: \"},{\"text\":\"Farm · Crops and Trees\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"478633D3CFCF8540\"}},{\"text\":\".\"}]"
  ],
  "quest.1F5B7169F872605D.title": "Essence farms elsewhere",
  "quest.1F5B7169F872605D.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Pro tip: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Mystical Agriculture has its own fields: \"},{\"text\":\"Essence\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"523A3AABA8EB23F1\"}},{\"text\":\" for seeds and tiers, \"},{\"text\":\"Greenhouse\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"57BDDE750ECDEFA3\"}},{\"text\":\" for the harvester and machines.\"}]"
  ],
  "quest.4F65428A124B93FC.title": "A forest in a pot",
  "quest.4F65428A124B93FC.quest_subtitle": "Botany Trees: no axe required.",
  "quest.4F65428A124B93FC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A sapling in a pot yields wood every two minutes.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Trees take \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\" minutes, twice a crop.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"1 to 4\",\"color\":\"#E6C766\"},{\"text\":\" \"},{\"text\":\"Oak Logs\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:oak_log\",\"count\":1}}},{\"text\":\" per harvest.\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" \"},{\"text\":\"A \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" chance of another sapling.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"With shears in the tool slot: \"},{\"text\":\"1 to 3\",\"color\":\"#E6C766\"},{\"text\":\" leaves.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Oak also drops an apple \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" of the time. All eight vanilla trees work, mangrove included.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Trees take the same dirt-type soils as crops.\"}]"
  ],
  "task.42034D9E28BB7A7A.title": "Any magic wood",
  "quest.207B15E954EA35A2.title": "Woods with a secret",
  "quest.207B15E954EA35A2.quest_subtitle": "The bonus is in the drops.",
  "quest.207B15E954EA35A2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Modded trees give their log plus a rare extra.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Runewood\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"26F8A7D4DA540396\"}},{\"text\":\": \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" exposed logs. Soulwood: \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" Blight and Blighted Gunk.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Menril\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"06E82664F98B587E\"}},{\"text\":\": \"},{\"text\":\"15%\",\"color\":\"#E6C766\"},{\"text\":\" berries, one to four.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Netherwood\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"038CB3615E470F42\"}},{\"text\":\": \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" nether banana.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"These plain-log trees also grow in a pot: the four \"},{\"text\":\"Archwoods\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"379561AE02FBE13A\"}},{\"text\":\" and Ars Elemental's yellow one, \"},{\"text\":\"Aurum\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0C5E009946DCB505\"}},{\"text\":\", \"},{\"text\":\"Otherworld\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"20100A494B9AB672\"}},{\"text\":\" and \"},{\"text\":\"Undead\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1FCBB104FA180DDD\"}},{\"text\":\".\"}]"
  ],
  "task.475DF4A87140735D.title": "A log from another world",
  "quest.16003EFA40A7946F.title": "Woods from other worlds",
  "quest.16003EFA40A7946F.quest_subtitle": "Saplings are the souvenir.",
  "quest.16003EFA40A7946F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Bring a sapling home from another dimension.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Eternal Starlight\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1854B10F8C564348\"}},{\"text\":\": seven woods; the lunar tree gives \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" berries.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Aether: skyroot, and golden oak with \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" golden amber.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Undergarden\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0E7BEC7B420B7310\"}},{\"text\":\": three woods; grongle drops \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" gronglets.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Twilight Forest: ten trees.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"The Echo Tree of Deeper and Darker needs a sculk soil. The rest take dirt.\"}]"
  ],
  "quest.295F7952BA44B819.title": "Timber for the common store",
  "quest.295F7952BA44B819.quest_subtitle": "Straight off the shelf.",
  "quest.295F7952BA44B819.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"For the common store, once a day.\"}]",
    "",
    "[\"\",{\"text\":\"64\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" \"},{\"text\":\"Oak Logs\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:oak_log\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "An upgraded hopper pot over a chest fills it while you do something else."
  ],
  "quest.1603E456AD93F23E.title": "Loud neighbours",
  "quest.1603E456AD93F23E.quest_subtitle": "Five percent, patiently.",
  "quest.1603E456AD93F23E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A sculk pot rolled a \"},{\"text\":\"Sculk Shrieker\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:sculk_shrieker\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" per harvest, and not an Ancient City in sight.\"}]"
  ],
  "reward.3D381F5488A81E0E.title": "Secret found",
  "quest.7801CA513942EEA7.title": "A banana from the Nether",
  "quest.7801CA513942EEA7.quest_subtitle": "It grows on a tree. Of course it does.",
  "quest.7801CA513942EEA7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"A netherwood tree in a pot dropped a \"},{\"text\":\"Nether Banana\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"silentgear:nether_banana\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" per harvest.\"}]"
  ],
  "reward.30A7337BD0D6F9CB.title": "Secret found",
  "quest.70C1C09A3720AE8E.title": "Switch on the grow lamps",
  "quest.70C1C09A3720AE8E.quest_subtitle": "Plants like a night shift.",
  "quest.70C1C09A3720AE8E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Five lamps under the roof.\"}]",
    "",
    "Nothing to build here. Just a switch."
  ],
  "image.5B88FD3FCE54D28A.title": "[\"\",{\"text\":\"GREENHOUSE\",\"color\":\"#F1E9C4\",\"bold\":true}]",
  "image.646D9CBE55B58E78.title": "[\"\",{\"text\":\"Pots and automation\",\"color\":\"#E6C766\"}]",
