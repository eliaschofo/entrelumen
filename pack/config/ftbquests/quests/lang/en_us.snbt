    "",
    "[\"\",{\"text\":\"• Seed: \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" platinum ingots and \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Supremium Essence\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:supremium_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"tier 5\",\"color\":\"#C4DE52\"},{\"text\":\".\"}]",
    "",
