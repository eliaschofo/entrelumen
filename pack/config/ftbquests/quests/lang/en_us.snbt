  "quest.31F1025C6342BEC4.title": "Act VI: the Luminous ingot",
  "quest.31F1025C6342BEC4.quest_subtitle": "Six lights and three rarities in one bar.",
  "quest.31F1025C6342BEC4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The best gear in the pack starts as one ingot.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Six Luminosities, each bought from a Solsticio native\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"The \"},{\"text\":\"Ingot of the Skies\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:sky_ingot\",\"count\":1}}},{\"text\":\", a \"},{\"text\":\"Godforged Pearl\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apotheosis:godforged_pearl\",\"count\":1}}},{\"text\":\" and an \"},{\"text\":\"Atomic Alloy\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mekanism:alloy_atomic\",\"count\":1}}},{\"text\":\" in the middle column\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"One ingot per piece: \"},{\"text\":\"the recipe\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"457C56A252E9B15D\"}},{\"text\":\" and \"},{\"text\":\"the smithing\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7251812C8E588515\"}}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"The MekaSuit and both quantum armors also wait for act VI: each piece takes one Luminosity.\"}]"
  ],
  "quest.37575A687460FCA9.title": "Dressed in light",
  "quest.37575A687460FCA9.quest_subtitle": "From leather to the last set.",
  "quest.37575A687460FCA9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The full set never breaks and lets you fly.\"}]",
    "",
    "[\"\",{\"text\":\"60\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E8B04A\"},{\"text\":\" armor points.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"12\",\"color\":\"#E8B04A\"},{\"text\":\", \"},{\"text\":\"22\",\"color\":\"#E8B04A\"},{\"text\":\", \"},{\"text\":\"16\",\"color\":\"#E8B04A\"},{\"text\":\" and \"},{\"text\":\"10\",\"color\":\"#E8B04A\"},{\"text\":\" a piece, with \"},{\"text\":\"15\",\"color\":\"#E8B04A\"},{\"text\":\" toughness each\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Light repairs it; the four pieces together give creative flight and night vision\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Netherite piece, nether star and one ingot per piece at the smithing table\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Elytra, jetpacks and other flight stack with it; the details are in \"},{\"text\":\"The full set: flight\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4B504EF68D518396\"}},{\"text\":\".\"}]"
  ],
  "quest.69F5E5FCFE215294.title": "Gold, the detour",
  "quest.69F5E5FCFE215294.quest_subtitle": "Weak, shiny, and piglins love it.",
  "quest.69F5E5FCFE215294.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"The weakest set to wear on purpose.\"}]",
    "",
    "[\"\",{\"text\":\"11\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E8B04A\"},{\"text\":\" armor points.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:gold_ingot\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Piglins stay calm around anyone in a piece of it\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Enchantability \"},{\"text\":\"25\",\"color\":\"#E8B04A\"},{\"text\":\", the best of any tier; durability factor \"},{\"text\":\"7\",\"color\":\"#E8B04A\"},{\"text\":\", iron's is \"},{\"text\":\"15\",\"color\":\"#E8B04A\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Golden helmets turn up in bastions, ruined portals and underwater ruins\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Chainmail (armor \"},{\"text\":\"12\",\"color\":\"#E8B04A\"},{\"text\":\") has no recipe: it comes from woodland mansions, trial chamber mobs and an armorer's Hero of the Village gift.\"}]"
  ],
  "quest.174546574F72CA9A.title": "A shield",
  "quest.174546574F72CA9A.quest_subtitle": "Six planks and an ingot: the best deal in the game.",
  "quest.174546574F72CA9A.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Armor softens a hit; a shield cancels it.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:iron_ingot\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Six planks and one iron ingot; durability \"},{\"text\":\"336\",\"color\":\"#E8B04A\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"A banner in the crafting grid puts its pattern on the shield\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Apotheosis rolls affixes on shields too: \"},{\"text\":\"Shield affixes\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7328E9C28FC876AE\"}}]"
  ],
  "quest.412094B2FFE0FF32.title": "Tools, tier by tier",
  "quest.412094B2FFE0FF32.quest_subtitle": "The same ladder as the armor.",
  "quest.412094B2FFE0FF32.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Six materials, and each one decides uses and speed.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:wooden_pickaxe\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Wood: \"},{\"text\":\"59\",\"color\":\"#E8B04A\"},{\"text\":\" uses, speed \"},{\"text\":\"2\",\"color\":\"#E8B04A\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:stone_pickaxe\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Stone: \"},{\"text\":\"131\",\"color\":\"#E8B04A\"},{\"text\":\", speed \"},{\"text\":\"4\",\"color\":\"#E8B04A\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:iron_pickaxe\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Iron: \"},{\"text\":\"250\",\"color\":\"#E8B04A\"},{\"text\":\", speed \"},{\"text\":\"6\",\"color\":\"#E8B04A\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:golden_pickaxe\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Gold: \"},{\"text\":\"32\",\"color\":\"#E8B04A\"},{\"text\":\", speed \"},{\"text\":\"12\",\"color\":\"#E8B04A\"},{\"text\":\", and gone in a blink\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond_pickaxe\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Diamond: \"},{\"text\":\"1561\",\"color\":\"#E8B04A\"},{\"text\":\", speed \"},{\"text\":\"8\",\"color\":\"#E8B04A\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:netherite_pickaxe\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Netherite: \"},{\"text\":\"2031\",\"color\":\"#E8B04A\"},{\"text\":\", speed \"},{\"text\":\"9\",\"color\":\"#E8B04A\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Note: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Ancient debris and obsidian need a diamond pickaxe or better.\"}]"
  ],
  "task.16CB96E006FA22DD.title": "A pickaxe from a mod tier",
  "quest.70C76183FBFB6B51.title": "Tools by act",
  "quest.70C76183FBFB6B51.quest_subtitle": "Where the pickaxe goes after netherite.",
  "quest.70C76183FBFB6B51.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Every act has a pickaxe to graduate to.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"I: \"},{\"text\":\"a pickaxe of your own\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5B513654FB93EAAA\"}},{\"text\":\", built from parts\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"actuallyadditions:iron_aiot\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"II: \"},{\"text\":\"all-in-one tools\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3E59CE30AE2CC842\"}},{\"text\":\", one head for every job\"}]",
