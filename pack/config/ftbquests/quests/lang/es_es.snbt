  ],
  "task.344ADAAAF68256E3.title": "Cualquier molde de adorno",
  "quest.5676765C7A170966.title": "Dieciocho formas de vestir la armadura",
  "quest.5676765C7A170966.quest_subtitle": "Las stats se quedan. El look, no.",
  "quest.5676765C7A170966.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Un adorno cambia cómo se ve la armadura y nada más.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:sentry_armor_trim_smithing_template\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Dieciocho diseños, cada uno en un lugar distinto\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Diez materiales los tiñen: cobre, hierro, oro, diamante, netherita, esmeralda, lapislázuli, redstone, cuarzo y amatista\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:emerald\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"El herrero de Solsticio vende los dieciocho: de \"},{\"text\":\"20\",\"color\":\"#E8B04A\"},{\"text\":\" a \"},{\"text\":\"64\",\"color\":\"#E8B04A\"},{\"text\":\" esmeraldas\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Buscá en naufragios, templos de la jungla, ciudades ancestrales, ciudades del End y cámaras de prueba: el guardián anciano suelta Marea, un puesto esconde Centinela y la mansión del bosque, Vex.\"}]"
  ],
  "task.73AE0EA864C5D6B9.title": "Cualquier molde de mejora de un mod",
