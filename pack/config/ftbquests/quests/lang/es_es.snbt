  "image.105345EA663687BB.title": "[\"\",{\"text\":\"Refugio 45\",\"color\":\"#8FE68F\"}]",
  "image.044BAB5653B031F9.title": "[\"\",{\"text\":\"Frontera 75\",\"color\":\"#8FE68F\"}]",
