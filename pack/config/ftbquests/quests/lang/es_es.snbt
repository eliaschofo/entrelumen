  "quest.69F5E5FCFE215294.title": "Oro, el desvío",
  "quest.69F5E5FCFE215294.quest_subtitle": "Frágil, brillante, y a los piglins les encanta.",
  "quest.69F5E5FCFE215294.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"El set más flojo para llevar a propósito.\"}]",
    "",
    "[\"\",{\"text\":\"11\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E8B04A\"},{\"text\":\" puntos de armadura.\"}]",
