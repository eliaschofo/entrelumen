    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Un lingote por pieza: \"},{\"text\":\"la receta\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"457C56A252E9B15D\"}},{\"text\":\" y \"},{\"text\":\"la herrería\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7251812C8E588515\"}}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Dato: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"El MekaTraje y las dos armaduras cuánticas también esperan al acto VI: cada pieza pide una Luminosidad.\"}]"
  ],
  "quest.37575A687460FCA9.title": "Vestido de luz",
  "quest.37575A687460FCA9.quest_subtitle": "Del cuero al último set.",
  "quest.37575A687460FCA9.quest_desc": [
