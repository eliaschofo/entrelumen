    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Encantabilidad \"},{\"text\":\"25\",\"color\":\"#E8B04A\"},{\"text\":\", la mejor de todas; factor de durabilidad \"},{\"text\":\"7\",\"color\":\"#E8B04A\"},{\"text\":\", el del hierro es \"},{\"text\":\"15\",\"color\":\"#E8B04A\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Hay cascos dorados en bastiones, portales en ruinas y ruinas submarinas\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Dato: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"La cota de mallas (armadura \"},{\"text\":\"12\",\"color\":\"#E8B04A\"},{\"text\":\") no tiene receta: sale de mansiones del bosque, de mobs de las cámaras de prueba y del regalo de un armero por ser Héroe de la aldea.\"}]"
