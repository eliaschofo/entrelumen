  "quest.5671C0EC336AA93E.quest_subtitle": "El Warden no presta. Se le saca.",
  "quest.5671C0EC336AA93E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Un \"},{\"text\":\"zarcillo del Warden\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:warden_tendril\",\"count\":1}}},{\"text\":\" vuelve de sculk cada estante profundo.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"+10\",\"color\":\"#FF8A3D\"},{\"text\":\" de Eterna hasta \"},{\"text\":\"80\",\"color\":\"#FF8A3D\"},{\"text\":\", más Quanta y Arcana, y una pista.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Acá cada uno pide además dos \"},{\"text\":\"gemas de zanita\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"aether:zanite_gemstone\",\"count\":1}}},{\"text\":\", del acto IV.\"}]",
