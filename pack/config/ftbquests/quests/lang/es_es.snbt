    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Cada acto tiene un pico al que ascender.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"I: \"},{\"text\":\"un pico propio\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5B513654FB93EAAA\"}},{\"text\":\", armado con partes\"}]",
