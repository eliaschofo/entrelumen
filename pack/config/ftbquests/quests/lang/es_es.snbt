  "quest.1F6C219ADC24EB61.quest_desc": [
    "[\"\",{\"text\":\"8\",\"bold\":true},{\"text\":\" esencias dan \"},{\"text\":\"6\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Varas de blaze\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:blaze_rod\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Semilla: \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Tarros de alma\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:soul_jar\",\"count\":1}}},{\"text\":\" llenos y \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Esencias de imperium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:imperium_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"nivel 4\",\"color\":\"#C4DE52\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Cada tarro guarda \"},{\"text\":\"10\",\"bold\":true},{\"text\":\" almas.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• Una con ocho de enderman da \"},{\"text\":\"3\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Ojos de ender\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ender_eye\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• El \"},{\"text\":\"Generador de soulium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:soulium_spawner\",\"count\":1}}},{\"text\":\" convierte \"},{\"text\":\"24\",\"bold\":true},{\"text\":\" esencias en un blaze.\"}]"
  ],
  "quest.55CA30C58AC3F5DA.title": "Ghast",
  "quest.55CA30C58AC3F5DA.quest_subtitle": "Lágrimas a demanda.",
  "quest.55CA30C58AC3F5DA.quest_desc": [
