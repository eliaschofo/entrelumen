    "[\"\",{\"text\":\"• La \"},{\"text\":\"Tierra de cultivo de tertium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:tertium_farmland\",\"count\":1}}},{\"text\":\" alimenta a los cultivos de nivel 3.\"}]",
