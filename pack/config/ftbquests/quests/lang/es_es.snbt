    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"La \"},{\"text\":\"librería de estabilidad\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:geode_shelf\",\"count\":1}}},{\"text\":\" saca las tiradas negativas: sólo sube \"},{\"text\":\"para arriba\",\"color\":\"#9BE08A\"},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Infundí un bloque de amatista con \"},{\"text\":\"60\",\"color\":\"#FF8A3D\"},{\"text\":\" de Eterna, entre \"},{\"text\":\"30\",\"color\":\"#FF8A3D\"},{\"text\":\" y \"},{\"text\":\"50\",\"color\":\"#FF8A3D\"},{\"text\":\" de Quanta y \"},{\"text\":\"50\",\"color\":\"#FF8A3D\"},{\"text\":\" de Arcana: un \"},{\"text\":\"brotador de amatista\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:budding_amethyst\",\"count\":1}}},{\"text\":\".\"}]",
