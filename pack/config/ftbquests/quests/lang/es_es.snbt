    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Esencia de fuego\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_nouveau:fire_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"25%\",\"bold\":true},{\"text\":\".\"}]"
  ],
  "quest.27147F5128F8CF70.title": "Abeja de esencia de agua",
  "quest.27147F5128F8CF70.quest_desc": [
    "Aparato: un huevo arcano, con uno escarchado, uno de agua y alga.",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Esencia de agua\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ars_nouveau:water_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"25%\",\"bold\":true},{\"text\":\".\"}]"
  ],
  "quest.50E49156C7CAB54A.title": "Abeja de hierro infundido",
  "quest.50E49156C7CAB54A.quest_desc": [
    "[\"\",{\"text\":\"Dejá un huevo de abeja de hierro en un \"},{\"text\":\"Altar natural\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:nature_altar\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"15000\",\"bold\":true},{\"text\":\" de aura.\"}]",
    "",
    "[\"\",{\"text\":\"• Los huevos salen de un gen de tipo en la \"},{\"text\":\"incubadora\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3221DCBBBB0504C7\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Lingote de hierro infundido\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:infused_iron\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"80%\",\"bold\":true},{\"text\":\".\"}]"
  ],
  "quest.38A1F3C0CA28DB46.title": "Abeja de oro corrupto",
  "quest.38A1F3C0CA28DB46.quest_desc": [
    "[\"\",{\"text\":\"Un huevo de abeja de oro en el altar natural: \"},{\"text\":\"3000\",\"bold\":true},{\"text\":\" de aura.\"}]",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Lingote de oro corrupto\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:tainted_gold\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"75%\",\"bold\":true},{\"text\":\".\"}]"
  ],
  "quest.03E6D5DF31D293C5.title": "Abeja del cielo",
  "quest.03E6D5DF31D293C5.quest_desc": [
    "[\"\",{\"text\":\"Ofrecé un huevo de hierro infundido en una \"},{\"text\":\"Mesa de ofrendas\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:offering_table\",\"count\":1}}},{\"text\":\" con un \"},{\"text\":\"Espíritu de la llamada\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:calling_spirit\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Lingote de los cielos\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:sky_ingot\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"50%\",\"bold\":true},{\"text\":\".\"}]"
  ],
  "quest.273610EB31AA35A4.title": "Abeja de las profundidades",
  "quest.273610EB31AA35A4.quest_desc": [
    "Ofrecé un huevo de oro corrupto en la mesa de ofrendas, igual.",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Lingote de las profundidades\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"naturesaura:depth_ingot\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"50%\",\"bold\":true},{\"text\":\".\"}]"
  ],
  "quest.7ACCFA699A46A465.title": "Abeja arcanus",
  "quest.7ACCFA699A46A465.quest_desc": [
    "[\"\",{\"text\":\"Dale un \"},{\"text\":\"Bloque de Cristal Arcano\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:arcane_crystal_block\",\"count\":1}}},{\"text\":\" a una \"},{\"text\":\"abeja de diamante\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"66ED5066B2E23522\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Cristal arcano\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:arcane_crystal\",\"count\":1}}},{\"text\":\", siempre.\"}]"
  ],
  "quest.17ED02C4C0612998.title": "Abeja rúnica",
  "quest.17ED02C4C0612998.quest_desc": [
    "[\"\",{\"text\":\"Dale un \"},{\"text\":\"Bloque de Runas\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:rune_block\",\"count\":1}}},{\"text\":\" a una \"},{\"text\":\"abeja arcanus\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7ACCFA699A46A465\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Runa\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:rune\",\"count\":1}}},{\"text\":\", siempre.\"}]"
  ],
  "quest.4B81990892F3470E.title": "Abeja de deorum",
  "quest.4B81990892F3470E.quest_subtitle": "Dorada, y apenas chamuscada.",
  "quest.4B81990892F3470E.quest_desc": [
    "[\"\",{\"text\":\"Cociná un \"},{\"text\":\"Generar abeja\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:bee_spawn_egg\",\"count\":1}}},{\"text\":\" común en un Clibano con fuego de almas y elementarium.\"}]",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Pepita de Deorum\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:deorum_nugget\",\"count\":1}}},{\"text\":\", siempre.\"}]"
  ],
  "reward.02D3BCA4D6559821.title": "Secreto encontrado",
  "quest.27A435852EB7C26C.title": "Abeja de stellarite",
  "quest.27A435852EB7C26C.quest_desc": [
    "[\"\",{\"text\":\"Un ritual de nivel 3 en la \"},{\"text\":\"Forja de Hephaestus\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:hephaestus_forge\",\"count\":1}}},{\"text\":\": un huevo de diamante, cuatro orbes xpetrified y dos estelas eternas.\"}]",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Orbe de Xpetrified\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"forbidden_arcanus:xpetrified_orb\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"30%\",\"bold\":true},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Regalo:\",\"color\":\"#9BE08A\"},{\"text\":\" otra más para otra colmena; esta especie no se cruza entre sí.\"}]"
  ],
  "quest.3CA6CAC0619EDC5B.title": "Abeja de esencia arcana",
  "quest.3CA6CAC0619EDC5B.quest_desc": [
    "[\"\",{\"text\":\"Fabricá un huevo de abeja de diamante rodeado de \"},{\"text\":\"8×\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Esencia Arcana\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:arcane_essence\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Esencia Arcana\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"irons_spellbooks:arcane_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"75%\",\"bold\":true},{\"text\":\".\"}]",
    "",
    "• Con una de hierro también da mithril."
  ],
  "quest.2873E6392DAD24E6.title": "Abeja de superexperiencia",
  "quest.2873E6392DAD24E6.quest_desc": [
    "[\"\",{\"text\":\"Dale una \"},{\"text\":\"Súper Plantilla de Encantamiento\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"create_enchantment_industry:super_enchanting_template\",\"count\":1}}},{\"text\":\" a una \"},{\"text\":\"abeja de experiencia\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7B43DE0FD900D675\"}},{\"text\":\".\"}]",
    "",
    "• Su panal se mezcla en superexperiencia en una mezcladora de Create."
  ],
  "quest.5C21D12EC528C301.title": "Abejas que no se emparejan",
  "quest.5C21D12EC528C301.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Muchas abejas de otros mods no se crían con su especie.\"}]",
    "",
    "• Los niveles altos de Mystical Agriculture, los metales celestes y las de fusión piden otro huevo cada una.",
    "",
    "• Poné una en una colmena y que los panales hagan el resto."
  ],
  "quest.1B679D7140DCE2B3.title": "Huevos por encargo",
  "quest.1B679D7140DCE2B3.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Cada abeja de esta copa arranca como un huevo que come una máquina.\"}]",
    "",
    "[\"\",{\"text\":\"• Embotellá una abeja, centrifugá el frasco y purificá su gen de tipo hasta el \"},{\"text\":\"100%\",\"bold\":true},{\"text\":\".\"}]",
    "",
    "• Un gen de tipo puro en un dulce saca ese huevo siempre en la incubadora."
  ],
  "quest.3D9B14EE69E4658D.title": "Panales de inferium para el depósito",
  "quest.3D9B14EE69E4658D.quest_subtitle": "Esencia por panal.",
  "quest.3D9B14EE69E4658D.quest_desc": [
    "Dieciséis panales de abeja de inferium para el depósito común.",
    "",
    "Cada esencia de ahí le ahorra una semilla a alguien."
  ],
