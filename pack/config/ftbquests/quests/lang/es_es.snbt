    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Lino, de Silent Gear y de Actually Additions: \"},{\"text\":\"Lino\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3DD29656FE7C8536\"}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Canola: \"},{\"text\":\"Aceite de canola\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"69AA923D35150556\"}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Fruta de sueño demoníaco\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"occultism:datura\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"Sueño demoníaco\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"55F0051E7C82041E\"}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Poné una herramienta con Fortuna en la ranura: el cáñamo, el lino y la canola la piden.\"}]"
  ],
  "task.683EDF58BE7C5F6E.title": "Un cultivo de Farmer's Delight",
  "quest.55229EA85F7AE6E0.title": "Un jardín de cientos",
  "quest.55229EA85F7AE6E0.quest_subtitle": "La mayoría de las granjas del pack entran en una maceta.",
  "quest.55229EA85F7AE6E0.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"La mayoría de los mods de cultivos del pack traen su receta de maceta.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"200\",\"color\":\"#E6C766\"},{\"text\":\" cultivos de Pam's HarvestCraft y \"},{\"text\":\"121\",\"color\":\"#E6C766\"},{\"text\":\" de Herbs and Harvest.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Farmer's Delight: arroz, tomate, repollo, cebolla y sus versiones silvestres.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Sushi Go: pepino, arroz, sésamo, soja y wasabi.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Dato: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Los cultivos de Croptopia están apagados en este pack: sus recetas de maceta usan un formato anterior a la 1.21 que ya no carga.\"}]",
    "",
    "[\"\",{\"text\":\"El resto del jardín: \"},{\"text\":\"Granja · Cultivos y árboles\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"478633D3CFCF8540\"}},{\"text\":\".\"}]"
  ],
  "quest.1F5B7169F872605D.title": "La esencia se cultiva aparte",
  "quest.1F5B7169F872605D.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Mystical Agriculture tiene sus propios campos: \"},{\"text\":\"Esencia\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"523A3AABA8EB23F1\"}},{\"text\":\" para semillas y niveles, \"},{\"text\":\"Invernadero\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"57BDDE750ECDEFA3\"}},{\"text\":\" para la cosechadora y las máquinas.\"}]"
  ],
  "quest.4F65428A124B93FC.title": "Un bosque en una maceta",
  "quest.4F65428A124B93FC.quest_subtitle": "Botany Trees: sin hacha.",
  "quest.4F65428A124B93FC.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Un brote en una maceta da madera cada dos minutos.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Los árboles tardan \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\" minutos, el doble que un cultivo.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"1 a 4\",\"color\":\"#E6C766\"},{\"text\":\" \"},{\"text\":\"Troncos de roble\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:oak_log\",\"count\":1}}},{\"text\":\" por cosecha.\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" de chance de otro brote.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Con tijeras en la ranura de herramienta: \"},{\"text\":\"1 a 3\",\"color\":\"#E6C766\"},{\"text\":\" hojas.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"El roble suelta además una manzana el \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" de las veces. Andan los ocho árboles de vanilla, el de mangle incluido.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Dato: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Los árboles usan los mismos suelos de la familia de la tierra que los cultivos.\"}]"
  ],
  "task.42034D9E28BB7A7A.title": "Cualquier madera mágica",
  "quest.207B15E954EA35A2.title": "Maderas con secreto",
  "quest.207B15E954EA35A2.quest_subtitle": "El extra viene en el botín.",
  "quest.207B15E954EA35A2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Los árboles de mods dan su tronco y, a veces, un extra.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Runewood\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"26F8A7D4DA540396\"}},{\"text\":\": \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" de troncos expuestos. Soulwood: \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" de Blight y de Residuos Marchitos.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Menril\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"06E82664F98B587E\"}},{\"text\":\": \"},{\"text\":\"15%\",\"color\":\"#E6C766\"},{\"text\":\" de bayas, de una a cuatro.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Madera del Nether\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"038CB3615E470F42\"}},{\"text\":\": \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" de banana del Nether.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Estos árboles de tronco común también crecen en maceta: las cuatro \"},{\"text\":\"Archwood\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"379561AE02FBE13A\"}},{\"text\":\" y la amarilla de Ars Elemental, el \"},{\"text\":\"Aurum\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0C5E009946DCB505\"}},{\"text\":\", el \"},{\"text\":\"Otherworld\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"20100A494B9AB672\"}},{\"text\":\" y el \"},{\"text\":\"no-muerto\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1FCBB104FA180DDD\"}},{\"text\":\".\"}]"
  ],
  "task.475DF4A87140735D.title": "Un tronco de otro mundo",
  "quest.16003EFA40A7946F.title": "Maderas de otros mundos",
  "quest.16003EFA40A7946F.quest_subtitle": "El souvenir es el brote.",
  "quest.16003EFA40A7946F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Traé un brote de otra dimensión.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Eternal Starlight\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1854B10F8C564348\"}},{\"text\":\": siete maderas; el árbol lunar da \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" de bayas.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Aether: raicielo, y roble dorado con \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" de ámbar dorado.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Undergarden\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0E7BEC7B420B7310\"}},{\"text\":\": tres maderas; el grongle suelta \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" de gronglets.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Twilight Forest: diez árboles.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Dato: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"El Árbol del eco de Deeper and Darker pide un suelo de sculk. El resto, tierra.\"}]"
  ],
  "quest.295F7952BA44B819.title": "Madera para el depósito común",
  "quest.295F7952BA44B819.quest_subtitle": "Directo del estante.",
