  "chapter.78409D0F30264A4E.title": "Apotheosis · Encantamiento",
  "chapter.78409D0F30264A4E.chapter_subtitle": [
    "Eterna, Quanta y Arcana: la mesa sube con tu Nivel de Mundo, estante por estante, de 45 a 100. Infusiones, tomos, los encantamientos nuevos y la Biblioteca del Atlas que escribe lo que alcanza."
  ],
  "task.0F05332E5318A580.title": "Encantá a nivel 100",
  "quest.28822DE1AC98F8F1.title": "Nivel 100",
  "quest.28822DE1AC98F8F1.quest_subtitle": "Las quince librerías eran el tutorial.",
  "quest.28822DE1AC98F8F1.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Encantá con la mesa en sus \"},{\"text\":\"100\",\"color\":\"#FF8A3D\"},{\"text\":\" de Eterna.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"La Cumbre levanta el último techo al abrir el acto V.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Dos caminos: un \"},{\"text\":\"estante del End dracónico\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:draconic_endshelf\",\"count\":1}}},{\"text\":\" sobre \"},{\"text\":\"90\",\"color\":\"#FF8A3D\"},{\"text\":\", o un anillo de \"},{\"text\":\"estantes del horizonte\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:horizon_shelf\",\"count\":1}}},{\"text\":\".\"}]"
  ],
  "quest.7E61A14FE07F9DB9.title": "La mesa, reescrita",
  "quest.7E61A14FE07F9DB9.quest_subtitle": "La misma obsidiana, otra matemática.",
  "quest.7E61A14FE07F9DB9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Tu \"},{\"text\":\"mesa de encantamientos\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:enchanting_table\",\"count\":1}}},{\"text\":\" ahora lee tres valores.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Eterna\",\"color\":\"#FF8A3D\"},{\"text\":\", \"},{\"text\":\"Quanta\",\"color\":\"#FF8A3D\"},{\"text\":\" y \"},{\"text\":\"Arcana\",\"color\":\"#FF8A3D\"},{\"text\":\" aparecen debajo de las tres ofertas.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Pasado el nivel \"},{\"text\":\"30\",\"color\":\"#FF8A3D\"},{\"text\":\" pide mejores estantes que las librerías.\"}]"
  ],
  "quest.35FE1B0A8FA6BB5C.title": "Quince librerías",
  "quest.35FE1B0A8FA6BB5C.quest_subtitle": "El anillo de siempre.",
  "quest.35FE1B0A8FA6BB5C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Cada \"},{\"text\":\"librería\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:bookshelf\",\"count\":1}}},{\"text\":\" suma \"},{\"text\":\"2\",\"color\":\"#FF8A3D\"},{\"text\":\" de Eterna, hasta \"},{\"text\":\"30\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Cuenta a dos bloques de la mesa, con aire en el medio.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"El anillo tiene \"},{\"text\":\"32\",\"color\":\"#FF8A3D\"},{\"text\":\" lugares en dos capas: sobra lugar para velas y calaveras.\"}]"
  ],
  "task.2DE8F61AE455E37D.title": "Encantá a nivel 30",
  "quest.2D9BB1DF1EF19BDD.title": "Nivel 30",
  "quest.2D9BB1DF1EF19BDD.quest_subtitle": "Donde vanilla toca techo.",
  "quest.2D9BB1DF1EF19BDD.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Quince librerías: el techo vanilla.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"La Eterna \"},{\"text\":\"es\",\"italic\":true},{\"text\":\" el nivel de la oferta de arriba.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Con mejores estantes se sigue, hasta tu Nivel de Mundo: el Refugio frena en \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]"
  ],
  "quest.3D47F1C2F57025F4.title": "El signo de pregunta",
  "quest.3D47F1C2F57025F4.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Con un ítem en la mesa, hacé clic en el signo de pregunta de arriba a la derecha.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Cada encantamiento que puede salir en cada ranura, con nivel y chances.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Con qué choca cada uno, y un deslizador para probar otras potencias.\"}]"
  ],
  "task.6E801477F0E31E70.title": "Encantá con 10 de cada valor",
  "quest.025856A8FAADDE9F.title": "Eterna, Quanta, Arcana",
  "quest.025856A8FAADDE9F.quest_subtitle": "Tres barras, tres humores.",
  "quest.025856A8FAADDE9F.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Tres barras, tres trabajos.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"La \"},{\"text\":\"Eterna\",\"color\":\"#FF8A3D\"},{\"text\":\" marca el nivel.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"La \"},{\"text\":\"Quanta\",\"color\":\"#FF8A3D\"},{\"text\":\" mueve cada tirada para arriba o para abajo; la mesa sola da \"},{\"text\":\"15%\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"La \"},{\"text\":\"Arcana\",\"color\":\"#FF8A3D\"},{\"text\":\" favorece lo raro: con \"},{\"text\":\"25%\",\"color\":\"#FF8A3D\"},{\"text\":\" salen dos encantamientos seguros, con \"},{\"text\":\"75%\",\"color\":\"#FF8A3D\"},{\"text\":\", tres.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"No sólo los estantes las alimentan: \"},{\"text\":\"velas y calaveras\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"636DB5A0F7C32171\"}},{\"text\":\".\"}]"
  ],
  "task.11F3B5435EB0DA82.title": "Cuatro velas cualesquiera",
  "quest.636DB5A0F7C32171.title": "No sólo estantes",
  "quest.636DB5A0F7C32171.quest_subtitle": "La iluminación también cuenta.",
  "quest.636DB5A0F7C32171.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Otros bloques del anillo también afinan la mesa.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:candle\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Cada \"},{\"text\":\"vela\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:candle\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+1,25\",\"color\":\"#FF8A3D\"},{\"text\":\" de Arcana.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Una \"},{\"text\":\"calavera\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:skeleton_skull\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+5\",\"color\":\"#FF8A3D\"},{\"text\":\" de Quanta; una \"},{\"text\":\"de wither\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:wither_skeleton_skull\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"+10\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Un \"},{\"text\":\"racimo de amatista\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:amethyst_cluster\",\"count\":1}}},{\"text\":\": +\"},{\"text\":\"1\",\"color\":\"#FF8A3D\"},{\"text\":\" de Eterna hasta \"},{\"text\":\"40\",\"color\":\"#FF8A3D\"},{\"text\":\", \"},{\"text\":\"-1 de Quanta\",\"color\":\"#FF8C7A\"},{\"text\":\".\"}]"
  ],
  "quest.296483B1183E3B16.title": "El nivel pone el techo",
  "quest.296483B1183E3B16.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Tu Nivel de Mundo limita la Eterna que usa la mesa.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Refugio \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\" · Frontera \"},{\"text\":\"75\",\"color\":\"#FF8A3D\"},{\"text\":\" · Ascenso \"},{\"text\":\"90\",\"color\":\"#FF8A3D\"},{\"text\":\" · Cumbre \"},{\"text\":\"100\",\"color\":\"#FF8A3D\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Cada techo es lo que alcanzan los estantes de ese acto. La mesa avisa cuando te frena.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"La escalada completa: \"},{\"text\":\"Apotheosis · Aventura\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"48BC3B6935A4143B\"}},{\"text\":\".\"}]"
  ],
  "quest.43E2479B7B06CBCB.title": "Mismas ofertas, misma semilla",
  "quest.43E2479B7B06CBCB.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Las tres ofertas sólo cambian cuando encantás algo.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"¿No te gustan? Encantá un libro en la ranura más barata y volvé a mirar.\"}]"
  ],
  "quest.43344AD478B35363.title": "El Estante del cartógrafo",
  "quest.43344AD478B35363.quest_subtitle": "Hecho con lo que un cartógrafo tiene en el escritorio.",
  "quest.43344AD478B35363.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"El estante del acto II: \"},{\"text\":\"+3\",\"color\":\"#FF8A3D\"},{\"text\":\" de Eterna, hasta \"},{\"text\":\"40\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Más que una librería, y el techo del Refugio ya lo deja contar.\"}]",
    "{@pagebreak}",
    "Dos por crafteo:",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Cuatro tablones\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:map\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Dos \"},{\"text\":\"mapas en blanco\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:map\",\"count\":1}}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Dos librerías\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:calibration_frame\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Un \"},{\"text\":\"Marco de calibración\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:calibration_frame\",\"count\":1}}}]"
  ],
  "quest.1D8AB1AA11FFFBC3.title": "Estantes infernales",
  "quest.1D8AB1AA11FFFBC3.quest_subtitle": "Libros con bronceado del Nether.",
  "quest.1D8AB1AA11FFFBC3.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Estante infernal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:hellshelf\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+3\",\"color\":\"#FF8A3D\"},{\"text\":\" de Eterna hasta \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\", \"},{\"text\":\"+3\",\"color\":\"#FF8A3D\"},{\"text\":\" de Quanta.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Cinco llevan una mesa de \"},{\"text\":\"30\",\"color\":\"#FF8A3D\"},{\"text\":\" a \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\", el techo del Refugio.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Seis \"},{\"text\":\"ladrillos del Nether\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:nether_bricks\",\"count\":1}}},{\"text\":\", una \"},{\"text\":\"vara de blaze\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:blaze_rod\",\"count\":1}}},{\"text\":\", una librería y una poción de regeneración.\"}]"
  ],
  "quest.26250DBD6915A9BB.title": "Estantes marinos",
  "quest.26250DBD6915A9BB.quest_subtitle": "Agua salada, en formato libro.",
  "quest.26250DBD6915A9BB.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Estante marino\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:seashelf\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+3\",\"color\":\"#FF8A3D\"},{\"text\":\" de Eterna hasta \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\", \"},{\"text\":\"+3\",\"color\":\"#FF8A3D\"},{\"text\":\" de Arcana.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"La raíz de los estantes de lumen y de filtrado.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Seis \"},{\"text\":\"ladrillos de prismarina\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:prismarine_bricks\",\"count\":1}}},{\"text\":\", agua, una librería, un \"},{\"text\":\"pez globo\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:pufferfish\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"¿Sin pez globo? Cuatro bambúes alrededor de un pescado dan un «Pez globo» que sirve.\"}]"
  ],
  "quest.22E1C3ED5D785AC2.title": "Infusión",
  "quest.22E1C3ED5D785AC2.quest_subtitle": "Crafteo, pero la mezcla la hace la mesa.",
  "quest.22E1C3ED5D785AC2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Algunos ítems cambian en la tercera ranura de la mesa.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Si Eterna, Quanta y Arcana caen dentro del rango de una receta, la ranura se enciende.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Un estante infernal con \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\" de Eterna y \"},{\"text\":\"30\",\"color\":\"#FF8A3D\"},{\"text\":\" de Quanta: un \"},{\"text\":\"estante infernal infundido\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:infused_hellshelf\",\"count\":1}}},{\"text\":\", +\"},{\"text\":\"5\",\"color\":\"#FF8A3D\"},{\"text\":\" de Eterna hasta \"},{\"text\":\"60\",\"color\":\"#FF8A3D\"},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Los \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\" del Refugio ya lo permiten.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"La Eterna por encima de \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\" cuenta cuando la Frontera sube el techo.\"}]",
    "",
    "EMI lista cada infusión con sus rangos, máximos incluidos."
  ],
  "quest.424C145C052E00D4.title": "El mar, infundido",
  "quest.424C145C052E00D4.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Los estantes marinos también se \"},{\"text\":\"infunden\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"22E1C3ED5D785AC2\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Con \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\" de Eterna, \"},{\"text\":\"15\",\"color\":\"#FF8A3D\"},{\"text\":\" de Quanta y \"},{\"text\":\"10\",\"color\":\"#FF8A3D\"},{\"text\":\" de Arcana: el \"},{\"text\":\"estante marino infundido\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"apothic_enchanting:infused_seashelf\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"+\"},{\"text\":\"5\",\"color\":\"#FF8A3D\"},{\"text\":\" de Eterna hasta \"},{\"text\":\"60\",\"color\":\"#FF8A3D\"},{\"text\":\", +\"},{\"text\":\"5\",\"color\":\"#FF8A3D\"},{\"text\":\" de Arcana.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#FF8A3D\"},{\"text\":\"Cuatro dan cuatro \"},{\"text\":\"estantes de lumen\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:lumen_shelf\",\"count\":1}}},{\"text\":\"; dos van en un estante de filtrado.\"}]"
  ],
  "task.5627CF9193095A48.title": "Encantá a nivel 60",
  "quest.1FD96FD6D15D2278.title": "Nivel 60",
  "quest.1FD96FD6D15D2278.quest_subtitle": "Infierno y mar, dominados.",
  "quest.1FD96FD6D15D2278.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Los estantes infundidos pasan los \"},{\"text\":\"45\",\"color\":\"#FF8A3D\"},{\"text\":\" del Refugio.\"}]",
