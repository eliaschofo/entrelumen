    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Polvo dracónico\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:draconic_dust\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"30%\",\"bold\":true},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Se cría con \"},{\"text\":\"dos\",\"bold\":true},{\"text\":\" polvos dracónicos, no con flores.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Regalo:\",\"color\":\"#9BE08A\"},{\"text\":\" otra más, para criar una pareja.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Un huevo de dragón y una colmena hacen una \"},{\"text\":\"Colmena de huevo de dragón\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:dragon_egg_hive\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "En el End, las dracónicas de adentro no necesitan flores."
  ],
  "quest.58D56C17350E1496.title": "Abeja de prismarina",
  "quest.58D56C17350E1496.quest_subtitle": "Algo está mordiendo la carnada.",
  "quest.58D56C17350E1496.quest_desc": [
    "[\"\",{\"text\":\"Pescá en un océano profundo: cada pesca tiene \"},{\"text\":\"5%\",\"bold\":true},{\"text\":\" de chance de enganchar una.\"}]",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Fragmento de prismarina\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:prismarine_shard\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"20%\",\"bold\":true},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Regalo:\",\"color\":\"#9BE08A\"},{\"text\":\" otra más, para criar una pareja.\"}]",
    "{@pagebreak}",
    "La abeja pescada sale enojada: tené a mano una jaula y un dulce de miel."
  ],
  "quest.65031E9BE7567D19.title": "Abeja aceitosa",
  "quest.65031E9BE7567D19.quest_desc": [
    "[\"\",{\"text\":\"Pescá en un océano profundo: cada pesca tiene \"},{\"text\":\"5%\",\"bold\":true},{\"text\":\" de chance de enganchar una.\"}]",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"50 mB\",\"bold\":true},{\"text\":\" de crudo en la centrifugadora.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Regalo:\",\"color\":\"#9BE08A\"},{\"text\":\" otra más, para criar una pareja.\"}]"
  ],
  "task.0C567E2218413677.title": "Pescá en un océano profundo",
  "quest.352E9CD1FC60126A.title": "Abeja esponja",
  "quest.352E9CD1FC60126A.quest_desc": [
    "[\"\",{\"text\":\"Pescá en un océano profundo: cada pesca tiene \"},{\"text\":\"3%\",\"bold\":true},{\"text\":\" de chance de enganchar una.\"}]",
    "",
    "[\"\",{\"text\":\"• Trae esponjas, secas y mojadas, \"},{\"text\":\"5%\",\"bold\":true},{\"text\":\" cada una.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Regalo:\",\"color\":\"#9BE08A\"},{\"text\":\" otra más, para criar una pareja.\"}]"
  ],
  "task.5531FEAC6FCB29EB.title": "Pescá en un río",
  "quest.33CB2746F880B011.title": "Abeja de agua",
  "quest.33CB2746F880B011.quest_subtitle": "La que no se escapó.",
  "quest.33CB2746F880B011.quest_desc": [
    "[\"\",{\"text\":\"Pescá en un río: cada pesca tiene \"},{\"text\":\"5%\",\"bold\":true},{\"text\":\" de chance de enganchar una.\"}]",
    "",
    "• Trae pescado y algas.",
    "",
    "• Madre de la obsidiana y de la abeja brisa.",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Regalo:\",\"color\":\"#9BE08A\"},{\"text\":\" otra más, para criar una pareja.\"}]"
  ],
  "quest.1F84810AFA66B236.title": "Abeja viscosa",
  "quest.1F84810AFA66B236.quest_desc": [
    "[\"\",{\"text\":\"Vive en el \"},{\"text\":\"Nido viscoso\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:slimy_nest\",\"count\":1}}},{\"text\":\", sólo en pantanos.\"}]",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Bola de slime\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:slime_ball\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"20%\",\"bold\":true},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Con una \"},{\"text\":\"abeja de diamante\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"66ED5066B2E23522\"}},{\"text\":\": una \"},{\"text\":\"abeja de esmeralda\",\"color\":\"#FFD84A\"},{\"text\":\".\"}]"
  ],
  "quest.6F469C669CE00789.title": "Abeja sugarbag",
  "quest.6F469C669CE00789.quest_desc": [
    "[\"\",{\"text\":\"Rompé vainas de cacao: el \"},{\"text\":\"2%\",\"bold\":true},{\"text\":\" de las veces sale volando una abeja sugarbag.\"}]",
    "",
    "[\"\",{\"text\":\"• Su panal, \"},{\"text\":\"Panal de saco de azúcar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:sugarbag_honeycomb\",\"count\":1}}},{\"text\":\", sale el \"},{\"text\":\"30%\",\"bold\":true},{\"text\":\" de los viajes.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Regalo:\",\"color\":\"#9BE08A\"},{\"text\":\" otra más, para criar una pareja.\"}]"
  ],
  "task.07268C6BA07FE66C.title": "Huevo de abeja de ámbar",
  "quest.05594A3B95BAAF25.title": "Abeja de ámbar",
  "quest.05594A3B95BAAF25.quest_desc": [
    "[\"\",{\"text\":\"Cepillá \"},{\"text\":\"Arena sospechosa\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:suspicious_sand\",\"count\":1}}},{\"text\":\" en ruinas oceánicas frías: el \"},{\"text\":\"8%\",\"bold\":true},{\"text\":\" guarda un huevo de abeja de ámbar.\"}]",
    "",
    "• Encierra mobs en ámbar y vuelve los bloques de miel en miel petrificada.",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Regalo:\",\"color\":\"#9BE08A\"},{\"text\":\" otra más, para criar una pareja.\"}]"
  ],
  "task.4FBE08F121349ADC.title": "Huevo de abeja sospechosa",
  "quest.791AB92C630AB9C9.title": "Abeja sospechosa",
  "quest.791AB92C630AB9C9.quest_subtitle": "Reunión de emergencia en la colmena.",
  "quest.791AB92C630AB9C9.quest_desc": [
    "[\"\",{\"text\":\"Un sniffer que escarba buscando semillas desentierra un huevo de abeja sospechosa el \"},{\"text\":\"15%\",\"bold\":true},{\"text\":\" de las veces.\"}]",
    "",
    "• Vuelve sospechosas la arena y la grava: una granja de arqueología.",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Regalo:\",\"color\":\"#9BE08A\"},{\"text\":\" otra más, para criar una pareja.\"}]"
  ],
  "task.1513A599645887EF.title": "Huevo de Ribbeet",
  "quest.2E76EFBE7A126F2C.title": "Ribbeet",
  "quest.2E76EFBE7A126F2C.quest_subtitle": "El ciclo de la vida, con croar.",
  "quest.2E76EFBE7A126F2C.quest_desc": [
    "Una rana que se come una abeja deja un huevo de Ribbeet.",
    "",
    "• Poliniza cubos de magma y trae luces de rana."
  ],
  "reward.17BAC5F9DA524B1B.title": "Secreto encontrado",
  "quest.1646033728559B21.title": "Su Real Abejeza",
  "quest.1646033728559B21.quest_subtitle": "De rodillas ante la colmena.",
  "quest.1646033728559B21.quest_desc": [
    "[\"\",{\"text\":\"Cambiale un \"},{\"text\":\"Cubo con jalea real\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"the_bumblezone:royal_jelly_bucket\",\"count\":1}}},{\"text\":\" a la Abeja Reina de la Bumblezone por su huevo.\"}]",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"10 mB\",\"bold\":true},{\"text\":\" de jalea real. Se cría con botellas de jalea real.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Regalo:\",\"color\":\"#9BE08A\"},{\"text\":\" otra más para otra colmena; esta especie no se cruza entre sí.\"}]"
  ],
  "quest.3152454A3DAF1728.title": "La primera cruza",
  "quest.3152454A3DAF1728.quest_subtitle": "Dos carpinteras entran a un tronco.",
  "quest.3152454A3DAF1728.quest_desc": [
    "Dos abejas distintas, una flor para cada una: la cría puede ser una especie nueva.",
    "",
    "[\"\",{\"text\":\"• Probá una \"},{\"text\":\"abeja carpintero amarilla\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4F4FB5A0D8756EEC\"}},{\"text\":\" con una \"},{\"text\":\"abeja carpintero verde\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2CD2E768671626DC\"}},{\"text\":\": una \"},{\"text\":\"abeja de madera\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1002A9D2E2DDB3ED\"}},{\"text\":\".\"}]",
    "",
    "• Vale cualquier obrera: de madera, ranchera, de cantera o granjera.",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Premio:\",\"color\":\"#9BE08A\"},{\"text\":\" ocho dulces de miel; un dulce hace crecer antes a una cría.\"}]",
    "{@pagebreak}",
    "Cuando una pareja calza con varias recetas, cada nacimiento elige una al azar.",
    "",
    "Una pareja sin receta da su propia especie, si esa especie se cría consigo misma."
  ],
  "quest.631D1DB8B25062CC.title": "La abeja cristalina",
  "quest.631D1DB8B25062CC.quest_subtitle": "Todo metal arranca en el Nether.",
  "quest.631D1DB8B25062CC.quest_desc": [
    "[\"\",{\"text\":\"Poné un \"},{\"text\":\"Nido de cuarzo\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:nether_quartz_nest\",\"count\":1}}},{\"text\":\" en el Nether y enjaulá a la abeja que se mude.\"}]",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"cuarzo del Nether\",\"color\":\"#FFD84A\"},{\"text\":\", \"},{\"text\":\"50%\",\"bold\":true},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Con una \"},{\"text\":\"abeja minera cenicienta\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"072FAF991DFA455F\"}},{\"text\":\": hierro, cobre, estaño o aluminio.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Premio:\",\"color\":\"#9BE08A\"},{\"text\":\" un huevo de minera cenicienta para esa cruza y un \"},{\"text\":\"gen perfecto\",\"color\":\"#FFD84A\"},{\"text\":\" al azar.\"}]"
  ],
  "quest.0B7D5340E1851DD0.title": "La abeja de hierro",
  "quest.0B7D5340E1851DD0.quest_subtitle": "Minería tercerizada.",
  "quest.0B7D5340E1851DD0.quest_desc": [
    "[\"\",{\"text\":\"Cruzá una \"},{\"text\":\"abeja cristalina\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"631D1DB8B25062CC\"}},{\"text\":\" con una \"},{\"text\":\"abeja minera cenicienta\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"072FAF991DFA455F\"}},{\"text\":\" hasta que nazca una de hierro.\"}]",
    "",
    "[\"\",{\"text\":\"• Sale en \"},{\"text\":\"1 de cada 4\",\"bold\":true},{\"text\":\" cruzas; las otras dan cobre, estaño o aluminio.\"}]",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Hierro en bruto\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:raw_iron\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"40%\",\"bold\":true},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Regalo:\",\"color\":\"#9BE08A\"},{\"text\":\" otra abeja de hierro y un \"},{\"text\":\"gen perfecto\",\"color\":\"#FFD84A\"},{\"text\":\" al azar.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"La mitad de \"},{\"text\":\"los panales de metal\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"371A2EC6CA5746A5\"}},{\"text\":\" la tiene de madre.\"}]",
    "",
    "[\"\",{\"text\":\"Si trabaja un yunque astillado, lo arregla un paso el \"},{\"text\":\"70%\",\"bold\":true},{\"text\":\" de las veces.\"}]"
  ],
  "task.753ED335A4B7F1C8.title": "Mirá una abeja explosiva",
  "quest.05F05DFFB67B931B.title": "La primera mutación",
  "quest.05F05DFFB67B931B.quest_subtitle": "Manipular con cuidado. En serio.",
  "quest.05F05DFFB67B931B.quest_desc": [
    "[\"\",{\"text\":\"Dale un bloque de \"},{\"text\":\"Dinamita\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:tnt\",\"count\":1}}},{\"text\":\" a una abeja común: se vuelve abeja explosiva en el acto.\"}]",
    "",
    "• Algunas especies no se crían: se alimentan.",
    "",
    "[\"\",{\"text\":\"• Su \"},{\"text\":\"Panal polvoriento\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:honeycomb_powdery\",\"count\":1}}},{\"text\":\" da pólvora el \"},{\"text\":\"50%\",\"bold\":true},{\"text\":\" de las veces.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Premio:\",\"color\":\"#9BE08A\"},{\"text\":\" un \"},{\"text\":\"gen perfecto\",\"color\":\"#FFD84A\"},{\"text\":\" al azar.\"}]",
    "{@pagebreak}",
    "Explota si se enoja. Alimentar cambia a la abeja ahora; criar sólo cambia a la generación siguiente."
  ],
  "quest.3B94F90648E02063.title": "Abeja de redstone",
  "quest.3B94F90648E02063.quest_subtitle": "Artista del escape.",
  "quest.3B94F90648E02063.quest_desc": [
    "[\"\",{\"text\":\"Cruzá una \"},{\"text\":\"abeja brillante\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"11C2F8166C465BE5\"}},{\"text\":\" con una \"},{\"text\":\"abeja minera de chocolate\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"66C20327F8782BDC\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Polvo de redstone\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:redstone\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"50%\",\"bold\":true},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Con una \"},{\"text\":\"abeja de bandas azules\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5D465DDC3AE835E1\"}},{\"text\":\": una \"},{\"text\":\"abeja de lapislázuli\",\"color\":\"#FFD84A\"},{\"text\":\", camino al diamante.\"}]"
  ],
  "quest.66ED5066B2E23522.title": "La abeja de diamante",
  "quest.66ED5066B2E23522.quest_subtitle": "La línea de gemas rinde.",
  "quest.66ED5066B2E23522.quest_desc": [
    "[\"\",{\"text\":\"Cruzá una \"},{\"text\":\"abeja de ender\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1176AE6DA3431D93\"}},{\"text\":\" con una \"},{\"text\":\"abeja de lapislázuli\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"49AEEF82C53217C0\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Panal: \"},{\"text\":\"Diamante\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"20%\",\"bold\":true},{\"text\":\".\"}]",
    "",
    "• Madre de la esmeralda, el titanio y tres mutaciones de gemas.",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Premio:\",\"color\":\"#9BE08A\"},{\"text\":\" un \"},{\"text\":\"gen perfecto\",\"color\":\"#FFD84A\"},{\"text\":\" al azar.\"}]"
  ],
  "quest.5A702645B25D0E1B.title": "Melitología",
  "quest.5A702645B25D0E1B.quest_subtitle": "Un diploma que ninguna facultad entrega.",
  "quest.5A702645B25D0E1B.quest_desc": [
    "Criá al menos una vez cada abeja de material común.",
    "",
    "• Hierro, oro, carbón, redstone, lapislázuli, esmeralda, diamante.",
    "",
    "• Llameante, experiencia, escarchada y obsidiana.",
    "",
    "• Del tinte, de madera, ranchera, de cantera y granjera.",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Premio:\",\"color\":\"#9BE08A\"},{\"text\":\" un \"},{\"text\":\"gen perfecto\",\"color\":\"#FFD84A\"},{\"text\":\" a elección.\"}]",
    "{@pagebreak}",
    "Las escarchadas salen de alimentar: criá dos entre sí. La obsidiana sale de lava y agua."
  ],
  "task.6EB63EBCB6A7FCDE.title": "Mirá una abeja de madera",
  "quest.1002A9D2E2DDB3ED.title": "Abeja de madera",
  "quest.1002A9D2E2DDB3ED.quest_desc": [
    "[\"\",{\"text\":\"Cruzá una \"},{\"text\":\"abeja carpintero amarilla\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4F4FB5A0D8756EEC\"}},{\"text\":\" con una \"},{\"text\":\"abeja carpintero verde\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2CD2E768671626DC\"}},{\"text\":\".\"}]",
    "",
    "• Mordisquea troncos y trae astillas de ellos.",
    "",
    "• Madre de la ranchera, la granjera y el plástico."
  ],
  "task.1FA9E8D3F8065D2C.title": "Mirá una abeja ranchera",
  "quest.4AC5D5805597A3E8.title": "Abeja ranchera",
  "quest.4AC5D5805597A3E8.quest_desc": [
    "[\"\",{\"text\":\"Cruzá una \"},{\"text\":\"abeja de madera\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1002A9D2E2DDB3ED\"}},{\"text\":\" con una \"},{\"text\":\"abeja del sudor\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1B644226D8C15624\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Ordeña vacas y esquila ovejas; su \"},{\"text\":\"Panal lechoso\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:honeycomb_milky\",\"count\":1}}},{\"text\":\" da leche.\"}]"
  ],
  "task.41CE32A76D101854.title": "Mirá una abeja de cantera",
  "quest.23ADE5C988C9E272.title": "Abeja de cantera",
  "quest.23ADE5C988C9E272.quest_desc": [
    "[\"\",{\"text\":\"Cruzá una \"},{\"text\":\"abeja minera de chocolate\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"66C20327F8782BDC\"}},{\"text\":\" con una \"},{\"text\":\"abeja excavadora\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"137C7C80584F0AB2\"}},{\"text\":\".\"}]",
    "",
    "• Mordisquea piedra, arena y grava y trae pedazos de eso."
  ],
  "task.1F467A7DC07EFF9A.title": "Mirá una abeja granjera",
  "quest.03E51503917647EC.title": "Abeja granjera",
  "quest.03E51503917647EC.quest_desc": [
    "[\"\",{\"text\":\"Cruzá una \"},{\"text\":\"abeja de madera\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1002A9D2E2DDB3ED\"}},{\"text\":\" con una \"},{\"text\":\"abeja ranchera\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4AC5D5805597A3E8\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Cosecha cultivos maduros a \"},{\"text\":\"cuatro\",\"bold\":true},{\"text\":\" bloques de su colmena; las mejoras de alcance llegan más lejos.\"}]"
  ],
  "task.517050472CBE545B.title": "Mirá una abeja cupido",
  "quest.4FB3C3DF12B6EA53.title": "Abeja cupido",
  "quest.4FB3C3DF12B6EA53.quest_subtitle": "El amor está en el aire. El polen también.",
  "quest.4FB3C3DF12B6EA53.quest_desc": [
    "[\"\",{\"text\":\"Cruzá una \"},{\"text\":\"abeja granjera\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"03E51503917647EC\"}},{\"text\":\" con una \"},{\"text\":\"abeja ranchera\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4AC5D5805597A3E8\"}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Hace criar a los animales cercanos, hasta \"},{\"text\":\"cinco\",\"bold\":true},{\"text\":\" por viaje.\"}]"
  ],
  "task.1A2DFDDCBDB01634.title": "Mirá una abeja del tinte",
  "quest.79D583F98A8A93A7.title": "Abeja del tinte",
  "quest.79D583F98A8A93A7.quest_desc": [
