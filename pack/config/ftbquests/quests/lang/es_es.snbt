    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Copias: \"},{\"text\":\"7\",\"color\":\"#E8B04A\"},{\"text\":\" diamantes y \"},{\"text\":\"Netherrack\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:netherrack\",\"count\":1}}},{\"text\":\" alrededor del molde dan \"},{\"text\":\"2\",\"color\":\"#E8B04A\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Dato: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"El molde se gasta en cada pieza: un set completo son cuatro moldes.\"}]"
  ],
  "quest.366CB84368848221.title": "Lingote de netherita",
  "quest.366CB84368848221.quest_subtitle": "Cuatro fragmentos y cuatro de oro. Paciencia, más que nada.",
  "quest.366CB84368848221.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Cuatro fragmentos y cuatro de oro, sin forma fija.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:netherite_scrap\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Cada uno de los \"},{\"text\":\"Escombros ancestrales\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:ancient_debris\",\"count\":1}}},{\"text\":\" se funde en un fragmento, al doble de velocidad en un alto horno\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Mekanism lo triplica: \"},{\"text\":\"tres fragmentos por escombro\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FFBDA5C1966E63E\"}}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"El comerciante de rarezas vende fragmentos a \"},{\"text\":\"4\",\"color\":\"#E8B04A\"},{\"text\":\" bloques de esmeralda cada uno, desde el acto IV\"}]",
