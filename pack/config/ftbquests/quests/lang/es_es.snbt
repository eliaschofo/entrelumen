    "[\"\",{\"text\":\"• Con una gema de prosperidad: una \"},{\"text\":\"Gema de soulium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:soulium_gemstone\",\"count\":1}}},{\"text\":\".\"}]"
