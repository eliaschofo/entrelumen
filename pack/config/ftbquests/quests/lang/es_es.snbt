    "[\"\",{\"text\":\"• Un \"},{\"text\":\"Lingote de prosperidad\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:prosperity_ingot\",\"count\":1}}},{\"text\":\" y \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" polvos de soulium: un \"},{\"text\":\"Lingote de soulium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:soulium_ingot\",\"count\":1}}},{\"text\":\".\"}]",
