  "chapter.23C6117EB2888697.title": "Granja · Macetas y automatización",
  "chapter.23C6117EB2888697.chapter_subtitle": [
    "Botany Pots: niveles, suelos, tolvas y árboles en maceta."
  ],
  "quest.5EDB0491D1D23CD9.title": "Una granja en una maceta",
  "quest.5EDB0491D1D23CD9.quest_subtitle": "Agricultura, versión departamento.",
  "quest.5EDB0491D1D23CD9.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Tierra, semilla y un rincón del estante: sin campo.\"}]",
    "",
    "[\"\",{\"text\":\"Una \"},{\"text\":\"Maceta botánica\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"botanypots:terracotta_botany_pot\",\"count\":1}}},{\"text\":\" es una \"},{\"text\":\"Maceta\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:flower_pot\",\"count\":1}}},{\"text\":\" rodeada de \"},{\"text\":\"5\",\"color\":\"#E6C766\"},{\"text\":\" terracotas.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Clic derecho para cargarle tierra, semilla y herramienta. Sobre una crecida, cosecha.\"}]",
    "{@pagebreak}",
    "Cada maceta viene simple, con tolva o encerada.",
    "",
    "[\"\",{\"text\":\"61\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" materiales: terracota en 17 colores, vidriada y hormigón en 16 cada una, y doce tipos de ladrillo.\"}]"
  ],
  "quest.12F7D1660A7EC383.title": "Primera cosecha",
  "quest.12F7D1660A7EC383.quest_subtitle": "Sesenta segundos de paciencia.",
  "quest.12F7D1660A7EC383.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Tierra y semilla adentro, cosecha afuera.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Ranura de arriba, tierra: alcanza con \"},{\"text\":\"Tierra\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:dirt\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:wheat_seeds\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Segunda ranura, semilla: \"},{\"text\":\"Semillas de trigo\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:wheat_seeds\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"El trigo está listo en \"},{\"text\":\"60\",\"color\":\"#E6C766\"},{\"text\":\" segundos.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Dato: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Cada cultivo trae su tiempo: los árboles tardan \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\" minutos, el sculk de dos a cinco.\"}]"
  ],
  "quest.6CE4CDD69A080D72.title": "Maceta con tolva",
  "quest.6CE4CDD69A080D72.quest_subtitle": "La maceta que se cosecha sola.",
  "quest.6CE4CDD69A080D72.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Cosecha sola y le pasa el cultivo a lo que tenga abajo.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Sin forma: una \"},{\"text\":\"Tolva\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:hopper\",\"count\":1}}},{\"text\":\" y una maceta.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"O la receta rápida: la tolva en el hueco de arriba.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Doce ranuras guardan la cosecha.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Ojo: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"Con las ranuras llenas se pierde la cosecha nueva. Ponele un contenedor abajo.\"}]"
  ],
  "quest.74566BCAF79C084B.title": "Mejora Elite",
  "quest.74566BCAF79C084B.quest_subtitle": "Acto III, con ribete blanco.",
  "quest.74566BCAF79C084B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Una franja blanca en la maceta y el triple de laburo.\"}]",
    "",
    "[\"\",{\"text\":\"×3\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" velocidad, \"},{\"text\":\"×3\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" cosecha.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Dos \"},{\"text\":\"Lingotes de hierro\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:iron_ingot\",\"count\":1}}},{\"text\":\" a los lados de un \"},{\"text\":\"Núcleo de propagación\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:propagation_core\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Clic agachado sobre una maceta puesta: el contenido se queda.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Dato: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"El núcleo es una entrega del acto III: \"},{\"text\":\"Semillas de continuidad\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"075794DD2C2DFAA0\"}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"El tooltip dice Velocidad \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\" y Multiplicador \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\". Se suman a la base de \"},{\"text\":\"1\",\"color\":\"#E6C766\"},{\"text\":\": la maceta anda a ×3 y el trigo tarda \"},{\"text\":\"20\",\"color\":\"#E6C766\"},{\"text\":\" segundos.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Una maceta nueva pide la mejora, \"},{\"text\":\"5\",\"color\":\"#E6C766\"},{\"text\":\" terracotas, \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\" lingotes de hierro y una maceta simple.\"}]"
  ],
  "quest.48A2C778A47A2FD7.title": "Mejora Ultra",
  "quest.48A2C778A47A2FD7.quest_subtitle": "Acto IV, con ribete cian.",
  "quest.48A2C778A47A2FD7.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Una franja cian: siete veces la velocidad, cuatro veces la cosecha.\"}]",
    "",
    "[\"\",{\"text\":\"×7\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" velocidad, \"},{\"text\":\"×4\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" cosecha.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Dos \"},{\"text\":\"Diamantes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\" a los lados de una \"},{\"text\":\"Cápsula de ecosistema\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:ecosystem_capsule\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Clic agachado sobre una maceta Elite.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Dato: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"La cápsula es una entrega del acto IV: \"},{\"text\":\"Un acuerdo pequeño\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"780224C0B0190A32\"}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"El trigo tarda \"},{\"text\":\"20\",\"color\":\"#E6C766\"},{\"text\":\" segundos en una maceta Elite y \"},{\"text\":\"8,5\",\"color\":\"#E6C766\"},{\"text\":\" en una Ultra.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Una maceta nueva pide la mejora, \"},{\"text\":\"5\",\"color\":\"#E6C766\"},{\"text\":\" terracotas, \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\" diamantes y una maceta Elite.\"}]"
  ],
  "quest.11415ECC40754CC5.title": "Mejora Mega",
  "quest.11415ECC40754CC5.quest_subtitle": "Acto V, con ribete rojo.",
  "quest.11415ECC40754CC5.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Una franja roja: once veces la velocidad, cinco veces la cosecha.\"}]",
    "",
    "[\"\",{\"text\":\"×11\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" velocidad, \"},{\"text\":\"×5\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" cosecha.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Dos \"},{\"text\":\"Lingotes de netherita\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:netherite_ingot\",\"count\":1}}},{\"text\":\" a los lados de un \"},{\"text\":\"Motor de renovación\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:renewal_engine\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Clic agachado sobre una maceta Ultra.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Dato: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"El motor es una entrega del acto V: \"},{\"text\":\"El motor de la reserva\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6F3334D0429BBA36\"}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"En la prueba del propio pack, una maceta Mega con tolva hizo crecer trigo en \"},{\"text\":\"109\",\"color\":\"#E6C766\"},{\"text\":\" ticks: \"},{\"text\":\"5,4\",\"color\":\"#E6C766\"},{\"text\":\" segundos.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Una maceta nueva pide la mejora, \"},{\"text\":\"5\",\"color\":\"#E6C766\"},{\"text\":\" terracotas, \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\" lingotes de netherita y una maceta Ultra.\"}]"
  ],
  "quest.2DF906FBE910488B.title": "El Invernadero",
  "quest.2DF906FBE910488B.quest_subtitle": "Cargala una vez y andá tranquilo.",
  "quest.2DF906FBE910488B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Una maceta Mega con tolva sobre un cofre: cosecha tras cosecha, sola.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Una tolva sobre una maceta Mega, o una mejora Mega sobre una maceta Ultra con tolva.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Tierra, semilla y herramienta entran una vez, a mano.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"El cofre de abajo se queda con el resto.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Dato: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"La mejora conserva el color, la tolva y todo lo que hay adentro.\"}]"
  ],
  "quest.093B8CA6C20B5373.title": "Reglas del suelo",
  "quest.093B8CA6C20B5373.quest_subtitle": "Una maceta vale lo que vale su tierra.",
  "quest.093B8CA6C20B5373.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"El suelo decide qué puede crecer ahí.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Familia de la tierra: tierra, césped, podsol, micelio, musgo, barro, tierra de cultivo.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Arena: cactus y caña de azúcar.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Arena o tierra de almas: verruga del Nether.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Piedra del End: chorus. Sculk: cultivos de sculk.\"}]",
    "{@pagebreak}",
    "Dos suelos, además, son más rápidos:",
    "",
    "[\"\",{\"text\":\"+10%\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" de velocidad en tierra de cultivo y en un catalizador de sculk.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Dato: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"A velocidad Mega ese bonus es redondeo: +0,1 sobre 11.\"}]"
  ],
  "task.2A3B42CD7FD12379.title": "Cualquier azada",
  "quest.6B809B4A31C8D442.title": "Clic sobre la tierra",
  "quest.6B809B4A31C8D442.quest_subtitle": "La maceta también es un banco de trabajo.",
  "quest.6B809B4A31C8D442.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Herramientas y baldes cambian el suelo sin sacarlo.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Azada sobre tierra: tierra de cultivo. Sobre tierra estéril o enraizada: tierra común.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Pala sobre césped, tierra, podsol o micelio: un camino de tierra.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Cubo con agua sobre un suelo de cubo con lava: obsidiana. Cubo con lava sobre un suelo de cubo con agua: piedra.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Una azada sobre tierra enraizada suelta además raíces colgantes.\"}]"
  ],
  "task.4780326ECC6E74C0.title": "Una azada o tijeras",
  "quest.2BC5E4CF6FEB518E.title": "La ranura de herramienta",
  "quest.2BC5E4CF6FEB518E.quest_subtitle": "La maceta te pide prestada la azada.",
  "quest.2BC5E4CF6FEB518E.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"La tercera ranura acepta una azada o tijeras, y esa herramienta juzga la cosecha.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:shears\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Tijeras\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:shears\",\"count\":1}}},{\"text\":\": los árboles sueltan sus hojas.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Eficiencia: \"},{\"text\":\"+5%\",\"color\":\"#E6C766\"},{\"text\":\" de velocidad de crecimiento por nivel.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Fortuna cuenta en los cultivos cuyo botín la pide.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Ojo: \",\"color\":\"#FF8C7A\",\"bold\":true},{\"text\":\"Cada cosecha desgasta la herramienta.\"}]",
    "{@pagebreak}",
    "La Maldición de manos ociosas frena el desgaste y deja la herramienta inservible en tus manos.",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Dato: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Los bibliotecarios pueden venderla.\"}]"
  ],
  "quest.4B7CADDB99FB8394.title": "El polvo de hueso ayuda",
  "quest.4B7CADDB99FB8394.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"El polvo de hueso sobre una maceta que crece salta de \"},{\"text\":\"400\",\"color\":\"#E6C766\"},{\"text\":\" a \"},{\"text\":\"600\",\"color\":\"#E6C766\"},{\"text\":\" ticks, hasta dejarla lista.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:bone_meal\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"El trigo común pide dos o tres; en una maceta Elite, uno.\"}]"
  ],
  "quest.0252E2F221E3C7ED.title": "Leer el crecimiento",
  "quest.0252E2F221E3C7ED.quest_desc": [
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Un comparador junto a la maceta la lee: la señal sube mientras el cultivo crece y llega a \"},{\"text\":\"15\",\"color\":\"#E6C766\"},{\"text\":\" cuando está listo.\"}]",
    "",
    "Alcanza para prender una lámpara o apagar una granja."
  ],
  "quest.499E1F2A67C8058B.title": "Congelada en flor",
  "quest.499E1F2A67C8058B.quest_subtitle": "El panal vuelve estatua a la maceta.",
  "quest.499E1F2A67C8058B.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Encerá una maceta y su planta queda crecida para siempre.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Un \"},{\"text\":\"Panal\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:honeycomb\",\"count\":1}}},{\"text\":\" y una maceta, sin forma: una \"},{\"text\":\"Maceta botánica encerada\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"botanypots:terracotta_waxed_botany_pot\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Nada entra y nada sale.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Encerá una maceta llena para el estante de exhibición.\"}]"
  ],
  "quest.1DAB6DFC061BFB67.title": "Vaciar desde abajo",
  "quest.1DAB6DFC061BFB67.quest_subtitle": "Desde afuera no entra nada.",
  "quest.1DAB6DFC061BFB67.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Las macetas con tolva se vacían por la cara de abajo, y sólo por ahí.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Un cofre, una tolva o un caño bajo la maceta se lleva la cosecha.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Tierra, semilla y herramienta sólo se cargan a mano.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Las macetas simples no tienen salida automática.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Dato: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Caños y routers: \"},{\"text\":\"Redes de logística\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"57D95FCA49DD6FFA\"}},{\"text\":\" y \"},{\"text\":\"Modular Routers\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"335E1EBA8FB3C477\"}},{\"text\":\".\"}]"
  ],
  "quest.58E2FB172D4B055C.title": "El balde es la tierra",
  "quest.58E2FB172D4B055C.quest_subtitle": "Sí, un balde con bacalao sirve.",
  "quest.58E2FB172D4B055C.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Un cubo con agua es un suelo válido, y también cualquier cubo con pescado.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Alga\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:kelp\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"Hierba marina\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:seagrass\",\"count\":1}}},{\"text\":\" y \"},{\"text\":\"Pepino de mar\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:sea_pickle\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Corales y abanicos de coral.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Nenúfares\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:lily_pad\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Dato: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Cubos con salmón, bacalao, pez tropical, pez globo, ajolote y renacuajo también cuentan.\"}]"
  ],
  "quest.35B78EA93BB73AC6.title": "El Nether en un estante",
  "quest.35B78EA93BB73AC6.quest_subtitle": "Sin fortaleza de por medio.",
  "quest.35B78EA93BB73AC6.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Tierra de almas y necelio vuelven a una maceta un pedazo del Nether.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:nether_wart\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"La \"},{\"text\":\"Verruga del Nether\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:nether_wart\",\"count\":1}}},{\"text\":\" crece en arena o tierra de almas.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Hongos y raíces piden necelio o netherrack.\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"El hongo carmesí suelta además \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" de brillongo y \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" de bloques de verrugas.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Más allá del Nether: la \"},{\"text\":\"Flor chorus\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:chorus_flower\",\"count\":1}}},{\"text\":\" sobre \"},{\"text\":\"Piedra del End\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:end_stone\",\"count\":1}}},{\"text\":\" da fruta chorus y, de vez en cuando, otra flor.\"}]"
  ],
  "quest.4A322C5C28B6CB3D.title": "Un jardín de sculk",
  "quest.4A322C5C28B6CB3D.quest_subtitle": "El Warden no está invitado.",
  "quest.4A322C5C28B6CB3D.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"El sculk crece sobre sculk: cultivalo sin un Warden a la vista.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Suelo: \"},{\"text\":\"Sculk\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:sculk\",\"count\":1}}},{\"text\":\" o un \"},{\"text\":\"Catalizador de sculk\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:sculk_catalyst\",\"count\":1}}},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"El sculk tarda \"},{\"text\":\"2\",\"color\":\"#E6C766\"},{\"text\":\" minutos; los cultivos de catalizador, sensor y chillador, \"},{\"text\":\"5\",\"color\":\"#E6C766\"},{\"text\":\".\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E6C766\"},{\"text\":\"Cada cosecha: sculk, más \"},{\"text\":\"15%\",\"color\":\"#E6C766\"},{\"text\":\" de catalizador, \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" de sensor y \"},{\"text\":\"5%\",\"color\":\"#E6C766\"},{\"text\":\" de chillador.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"El Árbol del eco de Deeper and Darker también crece sobre sculk.\"}]"
  ],
  "quest.6547E0A02647A224.title": "Fibras, aceite y sueños",
  "quest.6547E0A02647A224.quest_subtitle": "Cultivos de campo para alimentar las máquinas.",
  "quest.6547E0A02647A224.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Los cultivos de la industria también crecen en macetas.\"}]",
    "",
