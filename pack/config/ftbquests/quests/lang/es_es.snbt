    "[\"\",{\"text\":\"• \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" esencias despertadas, piedra y una gema despertada dan \"},{\"text\":\"3\",\"bold\":true},{\"text\":\".\"}]",
