    "",
    "• El altar del despertar toma de los cuatro a la vez."
  ],
  "quest.0826D3348EC4A160.title": "El Wither",
  "quest.0826D3348EC4A160.quest_subtitle": "Un donante de tres cabezas.",
  "quest.0826D3348EC4A160.quest_desc": [
    "[\"\",{\"text\":\"Si lo matás con un arma de esencia encantada con Iluminación mística, suelta \"},{\"text\":\"Polvo cognizante\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:cognizant_dust\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" con nivel I y uno más por nivel.\"}]",
    "",
    "[\"\",{\"text\":\"• Cualquier arma de esencia además le saca \"},{\"text\":\"1\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"3\",\"bold\":true},{\"text\":\" esencias de su nivel.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"La Iluminación mística sale del Encantador: \"},{\"text\":\"3\",\"bold\":true},{\"text\":\" esencias de supremium y \"},{\"text\":\"64\",\"bold\":true},{\"text\":\" de experiencia por nivel.\"}]"
  ],
  "quest.2F9D40EF186A4510.title": "El Dragón del End",
  "quest.2F9D40EF186A4510.quest_subtitle": "Mejores números, viaje más largo.",
  "quest.2F9D40EF186A4510.quest_desc": [
    "[\"\",{\"text\":\"El Dragón paga mejor: \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Polvos cognizantes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:cognizant_dust\",\"count\":1}}},{\"text\":\" más \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" por nivel de Iluminación mística.\"}]",
    "",
    "[\"\",{\"text\":\"• Y \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" esencias del nivel de tu arma.\"}]"
  ],
  "quest.407E45A9049C0435.title": "Polvo que sabe",
  "quest.407E45A9049C0435.quest_desc": [
    "[\"\",{\"text\":\"Un despertar pide \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Polvos cognizantes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:cognizant_dust\",\"count\":1}}},{\"text\":\", un bloque de supremium y \"},{\"text\":\"10\",\"bold\":true},{\"text\":\" de cada elemento.\"}]",
    "",
    "• El polvo va en los cuatro pedestales.",
    "",
    "• El bloque en el altar, los elementos en los recipientes."
  ],
  "quest.70D61774E3B61F65.title": "Despierto",
  "quest.70D61774E3B61F65.quest_subtitle": "El bloque que ascendió.",
  "quest.70D61774E3B61F65.quest_desc": [
