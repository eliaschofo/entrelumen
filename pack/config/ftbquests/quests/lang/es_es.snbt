    "[\"\",{\"text\":\"• La \"},{\"text\":\"Tierra de cultivo de imperium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:imperium_farmland\",\"count\":1}}},{\"text\":\" es la del oro, el lapislázuli, el End y casi todas las aleaciones.\"}]"
