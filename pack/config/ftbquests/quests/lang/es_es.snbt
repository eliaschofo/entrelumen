    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Dejá el oro para el final: cuatro lingotes son la mitad barata.\"}]"
