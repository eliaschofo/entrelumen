  ],
  "quest.5361C7F7A2A980B5.title": "Conservá tu estilo",
  "quest.5361C7F7A2A980B5.quest_subtitle": "Salvar el mundo no es excusa para vestirse mal.",
  "quest.5361C7F7A2A980B5.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Llevá la protección que necesitás y mostrá la armadura que te gusta.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Un segundo set cosmético: \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"cos.key.opencosarmorinventory\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" abre su pantalla\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Los adornos andan en cualquier armadura de la etiqueta trimmable, la de los mods incluida\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Los espacios de Artifacts también tienen gemelo cosmético: \"},{\"text\":\"Uno puesto, otro a la vista\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0CA6B2C089D2ECF0\"}}]"
  ],
  "task.07C5DEEA8EDC9E82.title": "Armadura para un caballo o un lobo",
  "quest.453EA7959A695E02.title": "Armadura para caballos y lobos",
  "quest.453EA7959A695E02.quest_subtitle": "Hasta el perro tiene mejora.",
  "quest.453EA7959A695E02.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Las monturas y las mascotas tienen un espacio de armadura propio.\"}]",
    "",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:armadillo_scute\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Armadura de lobo: seis \"},{\"text\":\"escamas de armadillo\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:armadillo_scute\",\"count\":1}}},{\"text\":\", sacadas con un cepillo; da \"},{\"text\":\"11\",\"color\":\"#E8B04A\"},{\"text\":\" de armadura y se repara con más escamas\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:leather_horse_armor\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Armadura de caballo: la de cuero se fabrica (\"},{\"text\":\"3\",\"color\":\"#E8B04A\"},{\"text\":\" de armadura); la de hierro \"},{\"text\":\"5\",\"color\":\"#E8B04A\"},{\"text\":\", la de oro \"},{\"text\":\"7\",\"color\":\"#E8B04A\"},{\"text\":\" y la de diamante \"},{\"text\":\"11\",\"color\":\"#E8B04A\"},{\"text\":\" sólo aparecen en cofres\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\"},{\"text\":\" Dato: \",\"color\":\"#9DC3FF\",\"bold\":true},{\"text\":\"Cofres con armadura de caballo: mazmorras, templos del desierto y de la jungla, fortalezas, fortalezas del Nether y ciudades del End.\"}]"
  ],
  "quest.452BC0DA17EE27F2.title": "Alas, si podés pagarlas",
  "quest.452BC0DA17EE27F2.quest_subtitle": "El único souvenir de verdad del End.",
  "quest.452BC0DA17EE27F2.quest_desc": [
    "[{\"text\":\"\",\"bold\":true},{\"text\":\"Las únicas alas vanilla están en una ciudad del End.\"}]",
    "",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Un barco de la ciudad guarda unas en un marco\"}]",
    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:phantom_membrane\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Las \"},{\"text\":\"membranas de fantasma\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:phantom_membrane\",\"count\":1}}},{\"text\":\" las reparan; durabilidad \"},{\"text\":\"432\",\"color\":\"#E8B04A\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"El comerciante de rarezas de Solsticio vende unas por \"},{\"text\":\"32\",\"color\":\"#E8B04A\"},{\"text\":\" bloques de esmeralda, desde el acto VI\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"Fusionalas con una armadura: \"},{\"text\":\"alas de ignitio\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5BA28D1851ACF891\"}},{\"text\":\", las \"},{\"text\":\"de Silent Gear\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"685B2A281F930398\"}},{\"text\":\" o las \"},{\"text\":\"reforzadas con HDPE\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1C956AD8E29B52C3\"}},{\"text\":\".\"}]"
  ],
