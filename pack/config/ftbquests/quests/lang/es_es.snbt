  "quest.072FAF991DFA455F.quest_desc": [
    "[\"\",{\"text\":\"Anida en el \"},{\"text\":\"Nido de tierra\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"productivebees:coarse_dirt_nest\",\"count\":1}}},{\"text\":\", y en nidos de arena y grava junto a desiertos, playas y ríos.\"}]",
