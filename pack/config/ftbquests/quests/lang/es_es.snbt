    "",
    "[\"\",{\"text\":\"64\",\"font\":\"entrelumen:quest_big\",\"color\":\"#E6C766\"},{\"text\":\" \"},{\"text\":\"Troncos de roble\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:oak_log\",\"count\":1}}},{\"text\":\".\"}]",
