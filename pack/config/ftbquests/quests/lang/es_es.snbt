    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"IV a V: herramientas \"},{\"text\":\"Wyvern\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6FC734E34DCB6224\"}},{\"text\":\", \"},{\"text\":\"dracónicas\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4338BEEF620CA369\"}},{\"text\":\" y \"},{\"text\":\"caóticas\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2747470770A8C4BD\"}}]",
