    "[\"\",{\"text\":\"• Semilla: \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Tarros de alma\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:soul_jar\",\"count\":1}}},{\"text\":\" llenos y \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Esencias de imperium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:imperium_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"nivel 4\",\"color\":\"#C4DE52\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Cada tarro guarda \"},{\"text\":\"8\",\"bold\":true},{\"text\":\" almas.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• El \"},{\"text\":\"Generador de soulium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:soulium_spawner\",\"count\":1}}},{\"text\":\" convierte \"},{\"text\":\"24\",\"bold\":true},{\"text\":\" esencias en un enderman.\"}]"
  ],
  "task.79A7EEB6D67A6848.title": "16 esencias del cantero",
  "quest.4ECA4B68CEA2AA4F.title": "Alas, viento y perlas",
  "quest.4ECA4B68CEA2AA4F.quest_desc": [
    "Phantom, breeze y enderman.",
    "",
    "[\"\",{\"text\":\"• Cosechá \"},{\"text\":\"16\",\"bold\":true},{\"text\":\" esencias de cualquiera de sus cultivos.\"}]",
    "",
    "[\"\",{\"text\":\"• Después elegí un premio: \"},{\"text\":\"Aceleradores de crecimiento de imperium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:imperium_growth_accelerator\",\"count\":1}}},{\"text\":\", tarros de alma o esencia.\"}]"
  ],
