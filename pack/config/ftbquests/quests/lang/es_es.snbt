  "quest.0E4DADD35126FC7B.title": "Los cuatro elementos",
  "quest.0E4DADD35126FC7B.quest_subtitle": "Grava, tierra y arcilla, de cuatro maneras.",
  "quest.0E4DADD35126FC7B.quest_desc": [
    "[\"\",{\"text\":\"Cada despertar toma \"},{\"text\":\"10\",\"bold\":true},{\"text\":\" de cada elemento.\"}]",
    "",
    "• Esencia de aire, tierra, agua y fuego, diez de cada una.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Los cultivos elementales toman la tierra de inferium como la de su nivel: plantalos ahí para tener el \"},{\"text\":\"20%\",\"bold\":true},{\"text\":\".\"}]"
  ],
  "quest.1684E583E20FDEC9.title": "Cuatro recipientes",
  "quest.1684E583E20FDEC9.quest_desc": [
    "[\"\",{\"text\":\"Cada \"},{\"text\":\"Recipiente de esencia\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:essence_vessel\",\"count\":1}}},{\"text\":\" guarda hasta \"},{\"text\":\"40\",\"bold\":true},{\"text\":\" de una sola esencia elemental.\"}]",
    "",
