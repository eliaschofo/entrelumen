  "quest.3AB01992C621BB93.quest_subtitle": "Caminá por el campo. Crece.",
  "quest.3AB01992C621BB93.quest_desc": [
    "Con las cuatro piezas despertadas puestas tenés el bono de conjunto: las plantas crecen más rápido a tu alrededor.",
    "",
    "• Cada pieza conserva sus dos espacios de aumento."
  ],
  "quest.162E139D9D4F412F.title": "El último acelerador",
  "quest.162E139D9D4F412F.quest_desc": [
    "[\"\",{\"text\":\"Los \"},{\"text\":\"Aceleradores de crecimiento de supremium despertado\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:awakened_supremium_growth_accelerator\",\"count\":1}}},{\"text\":\" llegan a \"},{\"text\":\"54\",\"bold\":true},{\"text\":\" bloques.\"}]",
