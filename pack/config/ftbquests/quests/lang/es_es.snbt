    "",
    "[\"\",{\"text\":\"• Con tierra: \"},{\"text\":\"24\",\"bold\":true},{\"text\":\" bolas de arcilla o \"},{\"text\":\"12\",\"bold\":true},{\"text\":\" de barro. Con naturaleza: \"},{\"text\":\"8\",\"bold\":true},{\"text\":\" algas.\"}]"
