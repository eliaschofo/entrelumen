    "[\"\",{\"text\":\"\",\"font\":\"entrelumen:quest_icons\",\"color\":\"#FFFFFF\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"twilightforest:charm_of_life_1\",\"count\":1}}},{\"text\":\" \"},{\"text\":\"Amuletos de vida y de conservación\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"258FDDFEE1E8F9DE\"}},{\"text\":\" de Twilight\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"Fragmentos de vida\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7D711A8074032A49\"}},{\"text\":\": un corazón permanente cada uno\"}]",
    "[\"\",{\"text\":\"• \",\"color\":\"#E8B04A\"},{\"text\":\"También el \"},{\"text\":\"Tótem de Coral\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6789ACB7F67F457E\"}},{\"text\":\", el \"},{\"text\":\"Anillo de la última oportunidad\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"688C721A5A7E5C04\"}},{\"text\":\" y la \"},{\"text\":\"armadura de Cursio\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3B8B713EF44059EF\"}}]"
  ],
