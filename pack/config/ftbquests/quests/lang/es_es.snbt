    "",
    "[\"\",{\"text\":\"• Semilla: \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Aglomeraciones de tierra\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:earth_agglomeratio\",\"count\":1}}},{\"text\":\" y \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Esencias de inferium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:inferium_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"nivel elemental\",\"color\":\"#C4DE52\"},{\"text\":\".\"}]",
