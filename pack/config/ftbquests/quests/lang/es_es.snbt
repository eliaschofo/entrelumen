    "[\"\",{\"text\":\"• Después elegí un premio: \"},{\"text\":\"Aceleradores de crecimiento de imperium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:imperium_growth_accelerator\",\"count\":1}}},{\"text\":\", fertilizante o esencia.\"}]"
  ],
  "quest.60B13DF13769AA3A.title": "Diamante",
  "quest.60B13DF13769AA3A.quest_subtitle": "El motivo por el que viniste.",
  "quest.60B13DF13769AA3A.quest_desc": [
    "[\"\",{\"text\":\"9\",\"bold\":true},{\"text\":\" esencias dan \"},{\"text\":\"1\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Diamante\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Semilla: \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Diamantes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:diamond\",\"count\":1}}},{\"text\":\" y \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Esencias de supremium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:supremium_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"nivel 5\",\"color\":\"#C4DE52\"},{\"text\":\".\"}]"
  ],
  "quest.7183A17E639035D9.title": "Esmeralda",
  "quest.7183A17E639035D9.quest_subtitle": "Los aldeanos odian esta semilla.",
  "quest.7183A17E639035D9.quest_desc": [
    "[\"\",{\"text\":\"9\",\"bold\":true},{\"text\":\" esencias dan \"},{\"text\":\"1\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Esmeralda\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:emerald\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Semilla: \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Esmeraldas\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:emerald\",\"count\":1}}},{\"text\":\" y \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Esencias de supremium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:supremium_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"nivel 5\",\"color\":\"#C4DE52\"},{\"text\":\".\"}]"
  ],
  "quest.342BD02A45690DB2.title": "Netherita",
  "quest.342BD02A45690DB2.quest_subtitle": "Los restos ancestrales, jubilados.",
  "quest.342BD02A45690DB2.quest_desc": [
    "[\"\",{\"text\":\"8\",\"bold\":true},{\"text\":\" esencias dan \"},{\"text\":\"1\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Lingote de netherita\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:netherite_ingot\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Semilla: \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Lingotes de netherita\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:netherite_ingot\",\"count\":1}}},{\"text\":\" y \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Esencias de supremium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:supremium_essence\",\"count\":1}}},{\"text\":\", \"},{\"text\":\"nivel 5\",\"color\":\"#C4DE52\"},{\"text\":\".\"}]"
  ],
  "task.0716FF66DBB150C9.title": "16 esencias del cantero",
  "quest.35BDC314D202A42C.title": "Diamante, esmeralda y netherita",
  "quest.35BDC314D202A42C.quest_subtitle": "Valen los cuatro supremium.",
  "quest.35BDC314D202A42C.quest_desc": [
    "El cantero del tesoro.",
    "",
    "[\"\",{\"text\":\"• Cosechá \"},{\"text\":\"16\",\"bold\":true},{\"text\":\" esencias de cualquiera de sus cultivos.\"}]",
    "",
    "[\"\",{\"text\":\"• Después elegí un premio: \"},{\"text\":\"Aceleradores de crecimiento de supremium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:supremium_growth_accelerator\",\"count\":1}}},{\"text\":\", fertilizante o esencia.\"}]"
  ],
  "image.3F0DBC13A4E32497.title": "[\"\",{\"text\":\"Inferium\",\"color\":\"#9BC02A\"}]",
  "image.1522CD9E240C8C62.title": "[\"\",{\"text\":\"Prudentium\",\"color\":\"#1FA63F\"}]",
  "image.303646BCA0E0E631.title": "[\"\",{\"text\":\"Tertium\",\"color\":\"#D8651A\"}]",
  "image.30F9487C55200239.title": "[\"\",{\"text\":\"Imperium\",\"color\":\"#2E8FE0\"}]",
  "image.446A8E4DAB4A27B5.title": "[\"\",{\"text\":\"Supremium\",\"color\":\"#D53434\"}]",
  "image.762D7377CEC84C3C.title": "[\"\",{\"text\":\"Galpón\",\"color\":\"#E6CFA0\"}]",
  "image.3A08778835D537BF.title": "[\"\",{\"text\":\"Mystical Agriculture\",\"color\":\"#F1F6D8\",\"bold\":true}]",
  "image.5690A53C2848EBC3.title": "[\"\",{\"text\":\"Esencia\",\"color\":\"#C4DE52\"}]",
  "image.7CB6C048CF1689A4.title": "Volver al Sol de Heliodor",
  "image.005F0DE32607F586.title": "[\"\",{\"text\":\"» Invernadero\",\"color\":\"#C4DE52\"}]",
  "image.4B442FCC0A2058D3.title": "[\"\",{\"text\":\"» Almas y despertar\",\"color\":\"#C4DE52\"}]",
  "chapter.5A4360D7A7F20D68.title": "Immersive Aircraft",
  "chapter.5A4360D7A7F20D68.chapter_subtitle": [
    "Siete aeronaves con un puñado de piezas: dirigibles, biplanos, un helicóptero a pulmón; motores, mejoras, armas y combustible."
  ],
  "quest.3C52109D4DAAB402.title": "Cascos",
  "quest.3C52109D4DAAB402.quest_subtitle": "Troncos y hierro. El vuelo viene después.",
  "quest.3C52109D4DAAB402.quest_desc": [
    "[\"\",{\"text\":\"El \"},{\"text\":\"Casco\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:hull\",\"count\":1}}},{\"text\":\" es el armazón de casi todas las aeronaves.\"}]",
    "",
    "• Seis troncos y tres lingotes de hierro.",
    "",
    "[\"\",{\"text\":\"• Dirigible \"},{\"text\":\"2\",\"color\":\"#F29E6D\"},{\"text\":\", biplano \"},{\"text\":\"3\",\"color\":\"#F29E6D\"},{\"text\":\", buque de guerra \"},{\"text\":\"3\",\"color\":\"#F29E6D\"},{\"text\":\" más.\"}]",
    "",
    "• Todo se fabrica en la mesa de trabajo."
  ],
  "quest.72B3D7A1DFB7E1AB.title": "Lona",
  "quest.72B3D7A1DFB7E1AB.quest_desc": [
    "[\"\",{\"text\":\"Las \"},{\"text\":\"Velas\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:sail\",\"count\":1}}},{\"text\":\" son la envoltura del dirigible: pide \"},{\"text\":\"6\",\"color\":\"#F29E6D\"},{\"text\":\".\"}]",
    "",
    "• Seis alfombras blancas y tres hilos.",
    "",
    "[\"\",{\"text\":\"• Los aviones vuelan con un \"},{\"text\":\"Propulsor\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:propeller\",\"count\":1}}},{\"text\":\": cinco lingotes de hierro doblados.\"}]"
  ],
  "quest.0C9B6B3192A484AE.title": "Un corazón de cobre",
  "quest.0C9B6B3192A484AE.quest_desc": [
    "[\"\",{\"text\":\"La \"},{\"text\":\"Caldera\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:boiler\",\"count\":1}}},{\"text\":\" va adentro de cada Motor.\"}]",
    "",
    "• Siete lingotes de cobre alrededor de un horno.",
    "",
    "• En vuelo, la ranura de combustible es la caldera: quema lo mismo que un horno."
  ],
  "quest.19E92EE086F5C840.title": "La sala de máquinas",
  "quest.19E92EE086F5C840.quest_subtitle": "Un regulador, siete aeronaves.",
  "quest.19E92EE086F5C840.quest_desc": [
    "[\"\",{\"text\":\"El \"},{\"text\":\"Motor\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:engine\",\"count\":1}}},{\"text\":\" mueve el dirigible, el biplano y el quadrocóptero.\"}]",
    "",
    "• Una Caldera, dos pistones, un alto horno y roca.",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"En este pack\",\"bold\":true},{\"text\":\", un \"},{\"text\":\"Regulador de energía\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"entrelumen:power_regulator\",\"count\":1}}},{\"text\":\" del acto III reemplaza la roca de arriba.\"}]",
    "{@pagebreak}",
    "El buque de guerra lleva dos, y la tolva de bambú uno más además de sus biplanos.",
    "",
    "El girodino no necesita ninguno."
  ],
  "quest.41571E5944B41C5F.title": "Lento y noble",
  "quest.41571E5944B41C5F.quest_subtitle": "El mejor primer vuelo.",
  "quest.41571E5944B41C5F.quest_desc": [
    "[\"\",{\"text\":\"El \"},{\"text\":\"Dirigible\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:airship\",\"count\":1}}},{\"text\":\" sube y baja derecho, y se queda quieto en el aire.\"}]",
    "",
    "• Seis velas, dos cascos y un Motor.",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"16\",\"color\":\"#F29E6D\"},{\"text\":\" ranuras de carga, \"},{\"text\":\"3\",\"color\":\"#F29E6D\"},{\"text\":\" mejoras, un arma y \"},{\"text\":\"2\",\"color\":\"#F29E6D\"},{\"text\":\" asientos.\"}]",
    "{@pagebreak}",
    "Hacé clic derecho al suelo con el ítem para apoyarlo; necesita lugar para armarse."
  ],
  "quest.0527BDAA90FDB0EC.title": "Día de mudanza",
  "quest.0527BDAA90FDB0EC.quest_desc": [
    "[\"\",{\"text\":\"El \"},{\"text\":\"Dirigible de carga\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:cargo_airship\",\"count\":1}}},{\"text\":\" lleva un depósito entero.\"}]",
    "",
    "• Un Dirigible, cuatro cofres y un casco.",
    "",
    "[\"\",{\"text\":\"• Cuatro cajones laterales suman \"},{\"text\":\"64\",\"color\":\"#F29E6D\"},{\"text\":\" ranuras: \"},{\"text\":\"80\",\"color\":\"#F29E6D\"},{\"text\":\" en total.\"}]",
    "",
    "[\"\",{\"text\":\"• Sin arma, \"},{\"text\":\"4\",\"color\":\"#F29E6D\"},{\"text\":\" mejoras y un \"},{\"text\":\"25%\",\"color\":\"#F29E6D\"},{\"text\":\" más de combustible.\"}]"
  ],
  "quest.0337268EBFD86CD7.title": "Fortaleza voladora",
  "quest.0337268EBFD86CD7.quest_subtitle": "Tres calderas, cero disimulo.",
  "quest.0337268EBFD86CD7.quest_desc": [
    "[\"\",{\"text\":\"El \"},{\"text\":\"Buque de guerra\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:warship\",\"count\":1}}},{\"text\":\" es lo más grande que vuela.\"}]",
    "",
    "• Un Dirigible de carga, dos motores, tres cascos, dos velas y engranajes industriales.",
    "",
    "[\"\",{\"text\":\"• Durabilidad \"},{\"text\":\"3×\",\"color\":\"#F29E6D\"},{\"text\":\", \"},{\"text\":\"6\",\"color\":\"#F29E6D\"},{\"text\":\" mejoras, \"},{\"text\":\"66\",\"color\":\"#F29E6D\"},{\"text\":\" ranuras de carga, \"},{\"text\":\"4\",\"color\":\"#F29E6D\"},{\"text\":\" asientos.\"}]",
    "",
    "[\"\",{\"text\":\"• Una ranura de armas arma \"},{\"text\":\"4\",\"color\":\"#F29E6D\"},{\"text\":\" montajes laterales; la otra, \"},{\"text\":\"2\",\"color\":\"#F29E6D\"},{\"text\":\" al frente.\"}]",
    "{@pagebreak}",
    "Alimentá las tres calderas: sólo rinde al máximo cuando arden todas.",
    "",
    "Ponele un giroscopio y un refuerzo de casco antes de salir a buscar lío."
  ],
  "quest.20D18291E169CAA8.title": "Necesita pista",
  "quest.20D18291E169CAA8.quest_subtitle": "Rápido, ruidoso y apurado.",
  "quest.20D18291E169CAA8.quest_desc": [
    "[\"\",{\"text\":\"El \"},{\"text\":\"Biplano\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:biplane\",\"count\":1}}},{\"text\":\" es el rápido.\"}]",
    "",
    "• Tres cascos, un Motor y un Propulsor.",
    "",
    "• Carretealo en terreno plano hasta tomar velocidad y tirá hacia atrás para subir.",
    "",
    "• Para aterrizar, lo mismo: largo, plano y despacio.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"4\",\"color\":\"#F29E6D\"},{\"text\":\" mejoras, un arma, una ranura de cohetes, \"},{\"text\":\"16\",\"color\":\"#F29E6D\"},{\"text\":\" ranuras de carga y \"},{\"text\":\"1\",\"color\":\"#F29E6D\"},{\"text\":\" asiento.\"}]",
    "",
    "[\"\",{\"text\":\"Gasta un \"},{\"text\":\"25%\",\"color\":\"#F29E6D\"},{\"text\":\" más de combustible que el dirigible.\"}]"
  ],
  "quest.3E5E43E5ED1910A7.title": "Hidroavión",
  "quest.3E5E43E5ED1910A7.quest_subtitle": "El juego le dice «Tolva de bambú». Es un hidroavión.",
  "quest.3E5E43E5ED1910A7.quest_desc": [
    "[\"\",{\"text\":\"La \"},{\"text\":\"Tolva de bambú\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:bamboo_hopper\",\"count\":1}}},{\"text\":\" aterriza en el agua: tiene flotadores.\"}]",
    "",
    "• Dos Biplanos, un casco, un Motor y cinco bloques de bambú.",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"3\",\"color\":\"#F29E6D\"},{\"text\":\" asientos, \"},{\"text\":\"2\",\"color\":\"#F29E6D\"},{\"text\":\" ranuras de armas, \"},{\"text\":\"4\",\"color\":\"#F29E6D\"},{\"text\":\" mejoras y una ranura de cohetes.\"}]",
    "",
    "[\"\",{\"text\":\"• Un \"},{\"text\":\"50%\",\"color\":\"#F29E6D\"},{\"text\":\" más de combustible que el dirigible.\"}]"
  ],
  "quest.34311711D79C123C.title": "Empujón de cohete",
  "quest.34311711D79C123C.quest_desc": [
    "[\"\",{\"text\":\"Los \"},{\"text\":\"Cohetes de fuegos artificiales\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:firework_rocket\",\"count\":1}}},{\"text\":\" dan un empujón en vuelo.\"}]",
    "",
    "• Van en la ranura de cohetes del biplano, la tolva de bambú y el buque de guerra.",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.immersive_aircraft.boost\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" quema uno para empujarte hacia adelante.\"}]",
    "",
    "• Los cohetes de más vuelo empujan más tiempo."
  ],
  "quest.4A7E00C064077EA8.title": "A pulmón",
  "quest.4A7E00C064077EA8.quest_subtitle": "Día de piernas, en el aire.",
  "quest.4A7E00C064077EA8.quest_desc": [
    "[\"\",{\"text\":\"Sin motor: el \"},{\"text\":\"Girodino\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:gyrodyne\",\"count\":1}}},{\"text\":\" vuela con tu hambre.\"}]",
    "",
    "[\"\",{\"text\":\"• Mantené \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.forward\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" en el suelo hasta que el rotor llegue a la velocidad de despegue.\"}]",
    "",
    "• Comé antes de salir: con poca comida no despega.",
    "{@pagebreak}",
    "[\"\",{\"text\":\"En este pack\",\"bold\":true},{\"text\":\", una \"},{\"text\":\"Aleación reforzada\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mekanism:alloy_reinforced\",\"count\":1}}},{\"text\":\" del acto III reemplaza la vela de abajo.\"}]"
  ],
  "quest.3645241838AF3C28.title": "El dron del albañil",
  "quest.3645241838AF3C28.quest_subtitle": "Cuatro hélices y unas cañas.",
  "quest.3645241838AF3C28.quest_desc": [
    "[\"\",{\"text\":\"El \"},{\"text\":\"Quadrocóptero\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:quadrocopter\",\"count\":1}}},{\"text\":\" se queda quieto y casi no siente el viento.\"}]",
    "",
    "• Cuatro propulsores, cuatro bambúes y un Motor.",
    "",
    "• Gasta la mitad que un dirigible: está hecho para construir en altura.",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"6\",\"color\":\"#F29E6D\"},{\"text\":\" ranuras de carga, \"},{\"text\":\"1\",\"color\":\"#F29E6D\"},{\"text\":\" mejora y un arma.\"}]"
  ],
  "task.53FAC36CBE5F2E6D.title": "Una mejora de potencia",
  "quest.0827E6F45D206DF5.title": "Más potencia",
  "quest.0827E6F45D206DF5.quest_desc": [
    "Las ranuras de mejora aceptan piezas que cambian los números.",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Tuberías resistentes\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:sturdy_pipes\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+10%\",\"color\":\"#9BE08A\"},{\"text\":\" de potencia.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Caldera de acero\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:steel_boiler\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+25%\",\"color\":\"#9BE08A\"},{\"text\":\" de potencia, \"},{\"text\":\"+50%\",\"color\":\"#FF8C7A\"},{\"text\":\" de combustible.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Motor de Nether\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:nether_engine\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+40%\",\"color\":\"#9BE08A\"},{\"text\":\" de potencia, \"},{\"text\":\"+30%\",\"color\":\"#FF8C7A\"},{\"text\":\" de combustible.\"}]",
    "{@pagebreak}",
    "El Motor de Nether cuesta un lingote de netherita. El tooltip de cada mejora muestra sus números."
  ],
  "task.3E29734F1EEC784B.title": "Una mejora que ahorra combustible",
  "quest.465D7CC46CB5773E.title": "Menos combustible",
  "quest.465D7CC46CB5773E.quest_desc": [
    "Dos piezas estiran cada carga de combustible.",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Engranajes industriales\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:industrial_gears\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"-20%\",\"color\":\"#9BE08A\"},{\"text\":\" de combustible.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Motor ecológico\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:eco_engine\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"-75%\",\"color\":\"#9BE08A\"},{\"text\":\" de combustible, \"},{\"text\":\"-20%\",\"color\":\"#FF8C7A\"},{\"text\":\" de potencia.\"}]",
    "{@pagebreak}",
    "Los engranajes también van en el Buque de guerra y en el Cañón giratorio."
  ],
  "task.0039D7EB1103FA32.title": "Cualquier giroscopio",
  "quest.3591550FEC33CF17.title": "Firme con viento",
  "quest.3591550FEC33CF17.quest_desc": [
    "[\"\",{\"text\":\"El viento empuja las aeronaves, \"},{\"text\":\"3×\",\"color\":\"#F29E6D\"},{\"text\":\" más con lluvia y tormenta.\"}]",
    "",
    "[\"\",{\"text\":\"• Un \"},{\"text\":\"Giroscopio\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:gyroscope\",\"count\":1}}},{\"text\":\" anula el viento y estabiliza la nariz.\"}]",
    "",
    "[\"\",{\"text\":\"• El \"},{\"text\":\"Gyroscopio avanzado\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:gyroscope_dials\",\"count\":1}}},{\"text\":\" suma un tablero de relojes.\"}]",
    "",
    "[\"\",{\"text\":\"• El \"},{\"text\":\"Gyroscopio electrónico\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:gyroscope_hud\",\"count\":1}}},{\"text\":\" suma un HUD.\"}]"
  ],
  "task.3B72EDDF9F7A7C16.title": "Una mejora del armazón",
  "quest.57284F9E1A7AD30B.title": "Más duro, más ágil",
  "quest.57284F9E1A7AD30B.quest_desc": [
    "Tres piezas trabajan sobre el armazón.",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Refuerzo del casco\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:hull_reinforcement\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+100%\",\"color\":\"#9BE08A\"},{\"text\":\" de durabilidad.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Tren de aterrizaje mejorado\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:improved_landing_gear\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"+50%\",\"color\":\"#9BE08A\"},{\"text\":\" de velocidad de despegue.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Hélice mejorada\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:enhanced_propeller\",\"count\":1}}},{\"text\":\": \"},{\"text\":\"-75%\",\"color\":\"#9BE08A\"},{\"text\":\" de rozamiento con el aire.\"}]"
  ],
  "task.6F9D2B222A1E79B0.title": "Cualquier arma aérea",
  "quest.5EB8D9EFE4993166.title": "Armamento",
  "quest.5EB8D9EFE4993166.quest_desc": [
    "[\"\",{\"text\":\"Una ranura de armas acepta una de cuatro, que se dispara con \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.use\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Cañón giratorio\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:rotary_cannon\",\"count\":1}}},{\"text\":\": una pólvora, \"},{\"text\":\"10\",\"color\":\"#F29E6D\"},{\"text\":\" disparos.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Ballesta pesada\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:heavy_crossbow\",\"count\":1}}},{\"text\":\": una flecha, \"},{\"text\":\"2\",\"color\":\"#F29E6D\"},{\"text\":\" virotes.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Bahía de bombas\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:bomb_bay\",\"count\":1}}},{\"text\":\": una dinamita, \"},{\"text\":\"5\",\"color\":\"#F29E6D\"},{\"text\":\" bombas.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"Telescopio\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:telescope\",\"count\":1}}},{\"text\":\": un catalejo que viaja con vos.\"}]",
    "{@pagebreak}",
    "La munición sale de la carga de la propia aeronave, y por defecto ningún arma rompe bloques."
  ],
  "task.4938DB30A1E028F2.title": "Cualquier estandarte",
  "quest.0BCE346C918C34C3.title": "Colores y banderas",
  "quest.0BCE346C918C34C3.quest_desc": [
    "Dirigibles, dirigibles de carga y biplanos llevan un estandarte en su ranura de estandarte.",
    "",
    "• Dirigibles, dirigibles de carga y buques de guerra aceptan un tinte en su ranura de tinte.",
    "",
    "• Con pintura o sin ella, vuela igual."
  ],
  "quest.64316D614B1F2430.title": "Palanca y acelerador",
  "quest.64316D614B1F2430.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Se vuela con las teclas de caminar.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.forward\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" / \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.back\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\": nariz abajo o arriba; en dirigibles, avanzar o retroceder.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.jump\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" / \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.sneak\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\": acelerador en aviones; subir o bajar en dirigibles.\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.left\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" / \"},{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.right\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\": girar.\"}]",
    "{@pagebreak}",
    "[\"\",{\"text\":\"\",\"extra\":[{\"text\":\"[\"},{\"keybind\":\"key.immersive_aircraft.dismount\"},{\"text\":\"]\"}],\"color\":\"#F2D060\"},{\"text\":\" te baja; en el aire, apretala dos veces para saltar.\"}]",
    "",
    "Adentro, la cámara pasa a tercera persona por defecto."
  ],
  "quest.70D6B624DE07D0C7.title": "Lo que come la caldera",
  "quest.70D6B624DE07D0C7.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Todo lo que quema un horno es combustible, y el \"},{\"text\":\"Polvo de blaze\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"minecraft:blaze_powder\",\"count\":1}}},{\"text\":\" también.\"}]",
    "",
    "• El indicador sobre la barra rápida muestra el motor.",
    "",
    "• Con poco combustible baja la potencia y llega un aviso; sin nada, el motor se apaga.",
    "{@pagebreak}",
    "Consumo por aeronave:",
    "",
    "[\"\",{\"text\":\"• Quadrocóptero \"},{\"text\":\"×0,5\",\"color\":\"#F29E6D\"},{\"text\":\", buque de guerra \"},{\"text\":\"×0,8\",\"color\":\"#F29E6D\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Dirigible \"},{\"text\":\"×1\",\"color\":\"#F29E6D\"},{\"text\":\"; biplano y dirigible de carga \"},{\"text\":\"×1,25\",\"color\":\"#F29E6D\"},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• Tolva de bambú \"},{\"text\":\"×1,5\",\"color\":\"#F29E6D\"},{\"text\":\".\"}]"
  ],
  "quest.767DAAD2F5180B35.title": "Emparchá antes de volar",
  "quest.767DAAD2F5180B35.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Una aeronave dañada no te deja subir: los clics derechos primero la emparchan.\"}]",
    "",
    "• Cada clic repara un poco y te da hambre.",
    "",
    "• Los choques explotan sin romper bloques ni prender fuego, y no te pueden matar.",
    "{@pagebreak}",
    "Si la rompés, vuelve como ítem con sus mejoras adentro; la carga cae al piso."
  ],
  "quest.7D5EC275B5E31E21.title": "Remís aéreo",
  "quest.7D5EC275B5E31E21.quest_subtitle": "Ojo con el aldeano.",
  "quest.7D5EC275B5E31E21.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Los mobs se suben como a un bote; los animales acuáticos, no.\"}]",
    "",
    "[\"\",{\"text\":\"• Asientos: dirigible y girodino \"},{\"text\":\"2\",\"color\":\"#F29E6D\"},{\"text\":\", tolva de bambú \"},{\"text\":\"3\",\"color\":\"#F29E6D\"},{\"text\":\", buque de guerra \"},{\"text\":\"4\",\"color\":\"#F29E6D\"},{\"text\":\".\"}]",
    "",
    "• Los demás jugadores suben con clic derecho."
  ],
  "task.3679AF83F7C463AC.title": "Estrellá una aeronave",
  "quest.75E0C58838022533.title": "Aterrizaje forzoso",
  "quest.75E0C58838022533.quest_subtitle": "Si salís caminando, cuenta como aterrizaje.",
  "quest.75E0C58838022533.quest_desc": [
    "Tu primer choque, registrado: tus estadísticas cuentan cada accidente.",
    "",
    "• Acá los choques no rompen bloques ni te pueden matar."
  ],
  "reward.1B00FB101C474FC3.title": "Secreto encontrado",
  "task.2B57B8D29D7CB9E3.title": "Volá 10 km a los mandos",
  "quest.09FFA410BF61BB58.title": "Viajero frecuente",
  "quest.09FFA410BF61BB58.quest_subtitle": "Diez mil bloques de cielo.",
  "quest.09FFA410BF61BB58.quest_desc": [
    "[\"\",{\"text\":\"10 km\",\"color\":\"#F29E6D\"},{\"text\":\" volados a los mandos: tus estadísticas guardan cada metro.\"}]",
    "",
    "• También cuentan el tiempo a bordo y el combustible quemado."
  ],
  "reward.6E0114AF2F22E451.title": "Secreto encontrado",
  "quest.33F7B45027222879.title": "Cascos de repuesto",
  "quest.33F7B45027222879.quest_subtitle": "El hangar siempre pide más.",
  "quest.33F7B45027222879.quest_desc": [
    "[\"\",{\"text\":\"Cuatro \"},{\"text\":\"Cascos\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"immersive_aircraft:hull\",\"count\":1}}},{\"text\":\" para el depósito común, una vez por día.\"}]",
    "",
    "• Seis troncos y tres de hierro cada uno."
  ],
  "image.46A212376B6193C4.title": "Dirigible",
  "image.0EF0C5FA15D17974.title": "Dirigible de carga",
  "image.5C3E88E48359C460.title": "Buque de guerra",
  "image.7C391BA365645E68.title": "Biplano",
  "image.49D510D9426E7488.title": "Tolva de bambú",
  "image.515FBD367802D773.title": "Quadrocóptero",
  "image.3B13141BD706F9A6.title": "Girodino",
  "image.49F06E1C47332DBA.title": "[\"\",{\"text\":\"Sala de máquinas\",\"color\":\"#F29E6D\"}]",
  "image.01C35E0FF73B4D05.title": "[\"\",{\"text\":\"Manejo\",\"color\":\"#F29E6D\"}]",
  "image.6BA085208A7DD1E2.title": "[\"\",{\"text\":\"Armas y colores\",\"color\":\"#F29E6D\"}]",
  "image.294EDDA6FF0CCE8F.title": "[\"\",{\"text\":\"Immersive Aircraft\",\"color\":\"#F5E6D3\",\"bold\":true}]",
  "image.5324EBD4B6BE9EAD.title": "Volver al Sol de Heliodor",
  "chapter.57BDDE750ECDEFA3.title": "Mystical Agriculture · Invernadero",
  "chapter.57BDDE750ECDEFA3.chapter_subtitle": [
    "Los cultivos de los otros mods en canteros, y las máquinas que los cosechan."
  ],
  "quest.5023171132D78E9D.title": "Un marco, cinco máquinas",
  "quest.5023171132D78E9D.quest_desc": [
    "[\"\",{\"text\":\"Cinco máquinas de Mystical Agriculture se arman sobre un \"},{\"text\":\"Marco de máquina\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:machine_frame\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "• Receta: hierro, redstone y piedra.",
    "",
    "• Horno, cosechadora, reprocesador de semillas, extractora de almas y generador de soulium.",
    "",
    "• Las cinco queman combustible sólido."
  ],
  "quest.4AF7DF1AD20071DC.title": "Un peón que no duerme",
  "quest.4AF7DF1AD20071DC.quest_subtitle": "Y replanta. No como otros.",
  "quest.4AF7DF1AD20071DC.quest_desc": [
    "[\"\",{\"text\":\"Mirando al campo, la \"},{\"text\":\"Cosechadora\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:harvester\",\"count\":1}}},{\"text\":\" junta lo maduro y lo replanta.\"}]",
    "",
    "[\"\",{\"text\":\"• Receta: \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" guadañas de diamante, \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" lingotes de soulium, hierro y un marco.\"}]",
    "",
    "• Guarda la cosecha adentro; la redstone la pausa.",
    "",
    "[\"\",{\"text\":\"• Trabaja un cuadro de \"},{\"text\":\"3×3\",\"bold\":true},{\"text\":\"; cada nivel de mejora suma un anillo, hasta \"},{\"text\":\"15×15\",\"bold\":true},{\"text\":\".\"}]"
  ],
  "quest.77EBCA19F26ED39B.title": "Un horno que acepta mejoras",
  "quest.77EBCA19F26ED39B.quest_desc": [
    "[\"\",{\"text\":\"El \"},{\"text\":\"Horno\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:furnace\",\"count\":1}}},{\"text\":\" de Mystical Agriculture funde como cualquiera hasta que le ponés una mejora.\"}]",
    "",
    "[\"\",{\"text\":\"• Receta: \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" hornos, \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" lingotes de prosperidad, hierro y un marco.\"}]"
  ],
  "quest.619FAACEEAA5DACE.title": "Semillas de sobra a esencia",
  "quest.619FAACEEAA5DACE.quest_desc": [
    "[\"\",{\"text\":\"El \"},{\"text\":\"Reprocesador de semillas\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:seed_reprocessor\",\"count\":1}}},{\"text\":\" vuelve cada semilla de sobra \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" esencias de su cultivo.\"}]",
    "",
    "[\"\",{\"text\":\"• Receta: \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" lingotes de soulium, \"},{\"text\":\"2\",\"bold\":true},{\"text\":\" azadas de hierro, hierro y un marco.\"}]",
    "",
    "[\"\",{\"text\":\"• Una semilla cada \"},{\"text\":\"10\",\"bold\":true},{\"text\":\" segundos, más rápido con mejoras.\"}]",
    "",
    "• Las segundas semillas de la tierra de esencia por fin sirven."
  ],
  "quest.4321C26C27515858.title": "Máquinas más rápidas",
  "quest.4321C26C27515858.quest_desc": [
    "Las mejoras de máquina aceleran las cinco máquinas con marco.",
    "",
    "[\"\",{\"text\":\"• Fragmentos, lingotes de prosperidad y un diamante dan la \"},{\"text\":\"Base de mejora de máquina\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:upgrade_base\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "[\"\",{\"text\":\"• \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" inferium y \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" lingotes de inferium la vuelven la \"},{\"text\":\"Mejora de máquina de inferium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:inferium_upgrade\",\"count\":1}}},{\"text\":\".\"}]",
    "{@pagebreak}",
    "• Cada nivel envuelve la mejora anterior en cuatro esencias y cuatro lingotes propios.",
    "",
    "• Las máquinas mejoradas trabajan más rápido y queman más; la cosechadora llega más lejos."
  ],
  "quest.076B407519BF16D8.title": "Segunda marcha",
  "quest.076B407519BF16D8.quest_desc": [
    "[\"\",{\"text\":\"La \"},{\"text\":\"Mejora de máquina de prudentium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:prudentium_upgrade\",\"count\":1}}},{\"text\":\" es la de inferium más \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" prudentium y \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" lingotes de prudentium.\"}]",
    "",
    "[\"\",{\"text\":\"• Las máquinas tardan el \"},{\"text\":\"62,5%\",\"bold\":true},{\"text\":\" del tiempo.\"}]",
    "",
    "[\"\",{\"text\":\"• La cosechadora trabaja \"},{\"text\":\"7×7\",\"bold\":true},{\"text\":\".\"}]"
  ],
  "quest.6B4DFDB1381CA6D5.title": "Tercera marcha",
  "quest.6B4DFDB1381CA6D5.quest_desc": [
    "[\"\",{\"text\":\"La \"},{\"text\":\"Mejora de máquina de tertium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:tertium_upgrade\",\"count\":1}}},{\"text\":\" envuelve la de prudentium en \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" tertium y \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" lingotes de tertium.\"}]",
    "",
    "[\"\",{\"text\":\"• Las máquinas tardan el \"},{\"text\":\"40%\",\"bold\":true},{\"text\":\" del tiempo.\"}]",
    "",
    "[\"\",{\"text\":\"• La cosechadora trabaja \"},{\"text\":\"9×9\",\"bold\":true},{\"text\":\".\"}]"
  ],
  "quest.63C81A9355C712FE.title": "Ocho veces más rápido",
  "quest.63C81A9355C712FE.quest_subtitle": "Más rápido, y más glotón.",
  "quest.63C81A9355C712FE.quest_desc": [
    "[\"\",{\"text\":\"La \"},{\"text\":\"Mejora de máquina de imperium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:imperium_upgrade\",\"count\":1}}},{\"text\":\" hace trabajar a una máquina en el \"},{\"text\":\"12,5%\",\"bold\":true},{\"text\":\" del tiempo.\"}]",
    "",
    "[\"\",{\"text\":\"• Receta: la mejora de tertium, \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" imperium y \"},{\"text\":\"4\",\"bold\":true},{\"text\":\" lingotes de imperium.\"}]",
    "",
    "[\"\",{\"text\":\"• Quema combustible \"},{\"text\":\"16\",\"bold\":true},{\"text\":\" veces más rápido; la cosechadora trabaja \"},{\"text\":\"11×11\",\"bold\":true},{\"text\":\".\"}]"
  ],
  "task.1DB346DD5905D0C5.title": "16 esencias de un cantero de nivel 5",
  "quest.08DAF11BA2246173.title": "Cuarenta veces más rápido",
  "quest.08DAF11BA2246173.quest_subtitle": "El invernadero anda solo.",
  "quest.08DAF11BA2246173.quest_desc": [
    "[\"\",{\"text\":\"La \"},{\"text\":\"Mejora de máquina de supremium\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"mysticalagriculture:supremium_upgrade\",\"count\":1}}},{\"text\":\" hace trabajar a una máquina \"},{\"text\":\"40\",\"bold\":true},{\"text\":\" veces más rápido.\"}]",
    "",
    "[\"\",{\"text\":\"• La cosechadora barre \"},{\"text\":\"13×13\",\"bold\":true},{\"text\":\" y quema combustible \"},{\"text\":\"48\",\"bold\":true},{\"text\":\" veces más rápido.\"}]",
    "",
    "[\"\",{\"text\":\"• Su primer laburo: el estante de arriba, \"},{\"text\":\"16\",\"bold\":true},{\"text\":\" esencias de cualquier cantero de nivel 5.\"}]"
  ],
  "task.2D926E048CF0607C.title": "32 esencias de los canteros",
  "quest.0C71A30B3F7B6C8C.title": "El diezmo del invernadero",
  "quest.0C71A30B3F7B6C8C.quest_subtitle": "Lo que sobra, vuelto un cajón.",
  "quest.0C71A30B3F7B6C8C.quest_desc": [
    "Treinta y dos esencias de cualquier cantero del invernadero, para el depósito común.",
    "",
    "• Vale cualquier mezcla de cultivos."
  ],
  "quest.222AE9DFC27DD38A.title": "Prensas sin meteoritos",
  "quest.222AE9DFC27DD38A.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Ocho esencias de certus alrededor de la pieza central de una prensa dan esa prensa.\"}]",
    "",
    "[\"\",{\"text\":\"• Cristal de certus: la \"},{\"text\":\"Prensa de Circuito de Cálculo\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"ae2:calculation_processor_press\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "• Lingote de oro: lógica. Diamante: ingeniería. Silicio: silicio.",
    "",
    "[\"\",{\"text\":\"• Nada de buscar cráteres para \"},{\"text\":\"Applied Energistics 2\",\"color\":\"#9DC3FF\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1E24729503A1C81A\"}},{\"text\":\".\"}]"
  ],
  "quest.178F5BD1A035A457.title": "El metal de cualquier mod",
  "quest.178F5BD1A035A457.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Una semilla hecha con un tag acepta la versión de cualquier mod del material.\"}]",
    "",
    "• El estaño de Mekanism o el de Modern Industrialization siembran la misma semilla."
  ],
  "quest.24A33ECDF244DFE9.title": "La mesa llena",
  "quest.24A33ECDF244DFE9.quest_desc": [
    "[\"\",{\"text\":\"» \",\"color\":\"#E8B04A\"},{\"text\":\"La posta: \",\"color\":\"#E8B04A\",\"bold\":true},{\"text\":\"Algunas esencias piden los nueve casilleros de la mesa.\"}]",
    "",
    "[\"\",{\"text\":\"• Diamante, esmeralda, cristal niótico y espirituoso: \"},{\"text\":\"9\",\"bold\":true},{\"text\":\" por uno.\"}]",
    "",
    "• Automatizalas con un fabricador que llene la mesa entera."
  ],
  "quest.43D0F233567739A0.title": "Un árbol de una baya",
  "quest.43D0F233567739A0.quest_subtitle": "Integrated Dynamics, por bosquecito.",
  "quest.43D0F233567739A0.quest_desc": [
    "[\"\",{\"text\":\"Dos esencias de menril y una de naturaleza dan \"},{\"text\":\"8\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Brotes de menril\",\"color\":\"#8FD6C8\",\"hoverEvent\":{\"action\":\"show_item\",\"contents\":{\"id\":\"integrateddynamics:menril_sapling\",\"count\":1}}},{\"text\":\".\"}]",
    "",
    "• Un bosquecito entero salido de un surco."
