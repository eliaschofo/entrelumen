  "quests": [
    {
      "key": "netherend_welcome", "deps": [], "type": "checkmark", "layout": {"x": 0, "y": 0, "size": 2.0, "shape": "hexagon"},
      "en_us": {"title": "Familiar places, new rules", "subtitle": "Same portals, busier worlds.",
        "text": ["[lead] Both dimensions are far busier than vanilla.",
                 "[li] YUNG's rebuilds the big structures",
                 "[li] Five more mods add many others",
                 "[li] Enderman Overhaul fills them with biome endermen",
                 "The [item:entrelumen:heliodor_compass|compass] sends you to a Nether fortress in act [hl|III] and to the End in act [hl|V].",
                 "{page}",
                 "The five: Repurposed Structures, Dungeons and Taverns, Cataclysm, Friends and Foes and Hellish Trials."]},
      "es_es": {"title": "Lugares conocidos, reglas nuevas", "subtitle": "Los mismos portales, mundos más ocupados.",
        "text": ["[lead] Las dos dimensiones están mucho más pobladas que en vanilla.",
                 "[li] YUNG's rehace las estructuras grandes",
                 "[li] Otros cinco mods suman muchas más",
                 "[li] Enderman Overhaul las llena de endermen de bioma",
                 "La [item:entrelumen:heliodor_compass|brújula] te manda a una fortaleza del Nether en el acto [hl|III] y al End en el acto [hl|V].",
                 "{page}",
                 "Los cinco: Repurposed Structures, Dungeons and Taverns, Cataclysm, Friends and Foes y Hellish Trials."]},
      "sources": ["repo:docs/design/exploration-structures-family.md", "repo:content/compass_targets.json", "repo:docs/design/mod-pingpong.md"]
    },
    {
      "key": "netherend_portal", "deps": ["netherend_welcome"], "type": "dimension", "dimension": "minecraft:the_nether", "layout": {"x": 3.9, "y": -1.0, "size": 1.75, "shape": "diamond"}, "hide_lines": true,
      "icon": "minecraft:obsidian",
      "en_us": {"title": "We Need to Go Deeper",
        "text": ["[lead] Build an [item:minecraft:obsidian|obsidian] frame and light it.",
                 "Nether Portal Fix links the return portal to the one you came from. Pack for the trip:",
                 "[li] Fire resistance",
                 "[li] One piece of gold armor: piglins leave you alone",
                 "[li] Blocks to bridge with",
                 "[li] Something to put out fires",
                 "The Nether does not do second chances."]},
      "es_es": {"title": "Tenemos que ir más profundo",
        "text": ["[lead] Armá un marco de [item:minecraft:obsidian|obsidiana] y encendelo.",
                 "Nether Portal Fix vincula el portal de vuelta con el que usaste. Llevá para el viaje:",
                 "[li] Resistencia al fuego",
                 "[li] Una pieza de armadura de oro: los piglins te dejan en paz",
                 "[li] Bloques para hacer puentes",
                 "[li] Algo para apagar incendios",
                 "El Nether no da segundas oportunidades."]},
      "sources": ["jar:minecraft_1.21.1_client.jar:data/minecraft/advancement/story/enter_the_nether.json", "jar:netherportalfix-neoforge-1.21.1-21.1.1.jar:META-INF/neoforge.mods.toml", "repo:catalog/curated.json"]
    },
    {
      "key": "netherend_fortress", "deps": ["netherend_portal"], "type": "item", "item": "minecraft:blaze_rod", "layout": {"x": 8.0, "y": 6.6, "size": 1.0, "shape": "circle"}, "hide_lines": true,
      "en_us": {"title": "A blaze rod from a fortress",
        "text": ["[lead] YUNG's Better Nether Fortresses makes them larger and themed.",
                 "In act [hl|III] the compass points to one and counts it done as soon as someone on your team carries a [item:minecraft:blaze_rod|Blaze Rod].",
                 "Blaze rods feed brewing, Powah and many mid-game recipes. The wither skeletons here drop the skulls for the Wither."]},
      "es_es": {"title": "Una vara de blaze de una fortaleza",
        "text": ["[lead] YUNG's Better Nether Fortresses las hace más grandes y temáticas.",
                 "En el acto [hl|III] la brújula apunta a una y la da por cumplida apenas alguien de tu equipo lleva una [item:minecraft:blaze_rod|Vara de blaze].",
                 "Las varas de blaze alimentan pociones, Powah y muchas recetas de medio juego. Los esqueletos wither de acá sueltan los cráneos para el Wither."]},
      "sources": ["repo:content/compass_targets.json", "jar:YungsBetterNetherFortresses-1.21.1-NeoForge-3.1.5.jar:data/betterfortresses/worldgen/structure/fortress.json", "repo:docs/design/exploration-structures-family.md"]
    },
    {
      "key": "netherend_boats", "deps": ["netherend_portal"], "type": "item", "item": "fireproofboats:crimson_boat", "optional": true, "layout": {"x": 4.4, "y": 10.1, "size": 0.85, "shape": "circle"}, "hide_lines": true,
      "en_us": {"title": "Crossing lava seas", "subtitle": "Slower boats have personality.",
        "text": ["[lead] Fireproof Boats adds crimson and warped boats that survive lava like their planks.",
                 "Cross lava oceans and scout the shores.",
                 "[tip] Or go vanilla: saddle a strider and steer it with a warped fungus on a stick. Slower, but it has personality."]},
      "es_es": {"title": "Cruzar mares de lava", "subtitle": "Los botes lentos tienen personalidad.",
        "text": ["[lead] Fireproof Boats suma botes carmesí y distorsionados que resisten la lava como sus tablas.",
                 "Cruzá los océanos de lava y recorré las costas.",
                 "[tip] O a la vanilla: ensillá un strider y dirigilo con un hongo distorsionado en un palo. Más lento, pero con personalidad."]},
      "sources": ["jar:fireproofboats-1.21.1-1.0.4.jar:assets/fireproofboats/lang/en_us.json", "jar:minecraft_1.21.1_client.jar:data/minecraft/advancement/nether/ride_strider.json"]
    },
    {
      "key": "netherend_structures", "deps": ["netherend_fortress"], "type": "checkmark", "layout": {"x": 10.2, "y": 10.0, "size": 0.85, "shape": "circle"}, "hide_lines": true,
      "icon": "minecraft:nether_bricks",
      "en_us": {"title": "What else lives in the Nether",
        "text": ["[lead] More lives down here than a fortress and a bastion.",
                 "In [chapter:sector_structures|Structures and exploration]:",
                 "[li] Dungeons and Taverns' keeps, ports and camps",
                 "[li] Repurposed Structures' cities",
                 "[li] Hellish Trials' chambers",
                 "Add the Citadel of the Wildfire (Friends and Foes) and the Burning Arena and Soul Forge (Cataclysm)."]},
      "es_es": {"title": "Qué más hay en el Nether",
        "text": ["[lead] Acá abajo hay más que una fortaleza y un bastión.",
                 "En [chapter:sector_structures|Estructuras y exploración]:",
                 "[li] Los torreones, puertos y campamentos de Dungeons and Taverns",
                 "[li] Las ciudades de Repurposed Structures",
                 "[li] Las cámaras de Hellish Trials",
                 "Sumá la Ciudadela del Wildfire (Friends and Foes) y la Arena Ardiente y la Forja de Almas (Cataclysm)."]},
      "sources": ["jar:friendsandfoes-neoforge-4.0.27+mc1.21.1.jar:data/friendsandfoes/worldgen/structure/citadel.json", "jar:L_Ender's Cataclysm 1.21.1-3.33.jar:data/cataclysm/worldgen/structure/burning_arena.json", "repo:content/sectors/sector_structures.json (the Nether structures moved there)"]
    },
    {
      "key": "netherend_keep", "deps": ["netherend_structures"], "type": "advancement", "advancement": "nova_structures:nether/find_keep", "optional": true, "layout": {"x": 14.2, "y": 10.2, "size": 1.0, "shape": "circle"}, "hide_lines": true,
      "icon": "minecraft:skeleton_skull",
      "en_us": {"title": "Concrete Halls",
        "text": ["[lead] Find a Dungeons and Taverns Nether Keep for the advancement.",
                 "Keeps and ports are skeleton strongholds. Two more advancements:",
                 "[li] Skull Collector: explore every skeleton camp, tower, port, fortress and keep",
                 "[li] Cool Off: bathe in powder snow inside a keep",
                 "Somebody had a fun afternoon designing that."]},
      "es_es": {"title": "Salones de concreto",
        "text": ["[lead] Encontrá un Fortín del Nether de Dungeons and Taverns para el logro.",
                 "Fortines y puertos son bastiones de esqueletos. Dos logros más:",
                 "[li] «Skull Collector»: explorar cada campamento, torre, puerto, fortaleza y fortín de esqueletos",
                 "[li] «Cool Off»: bañarte en nieve polvo adentro de un fortín",
                 "Alguien se divirtió diseñando eso."]},
      "sources": ["jar:dungeons-and-taverns-v4.4.4.jar:data/nova_structures/advancement/nether/find_keep.json", "jar:dungeons-and-taverns-v4.4.4.jar:data/nova_structures/advancement/nether/find_nether_skeleton.json", "jar:dungeons-and-taverns-v4.4.4.jar:data/nova_structures/advancement/nether/powder_snow_keep.json"]
    },
    {
      "key": "netherend_bastion", "deps": ["netherend_fortress"], "type": "advancement", "advancement": "minecraft:nether/find_bastion", "layout": {"x": 12.2, "y": 6.6, "size": 1.0, "shape": "circle"}, "hide_lines": true,
      "icon": "minecraft:gilded_blackstone",
      "en_us": {"title": "Bastions and piglins",
        "text": ["[lead] Bastion remnants hold gold and netherite upgrade templates, with ancient debris nearby.",
                 "Wear gold and do not open chests in sight of piglins.",
                 "[careful] Piglin Brutes ignore gold entirely.",
                 "Dungeons and Taverns adds [hl|four] more piglin places, for Hog Hunt."]},
      "es_es": {"title": "Bastiones y piglins",
        "text": ["[lead] Los restos de bastión tienen oro y plantillas de mejora de netherite, con restos antiguos cerca.",
                 "Llevá oro y no abras cofres a la vista de los piglins.",
                 "[careful] Los Piglins brutos ignoran el oro por completo.",
                 "Dungeons and Taverns suma [hl|cuatro] lugares piglin más, para «Hog Hunt»."]},
      "sources": ["jar:minecraft_1.21.1_client.jar:data/minecraft/advancement/nether/find_bastion.json", "jar:dungeons-and-taverns-v4.4.4.jar:data/nova_structures/advancement/nether/find_piglins.json"]
    },
    {
      "key": "netherend_debris", "deps": ["netherend_bastion"], "type": "advancement", "advancement": "minecraft:nether/obtain_ancient_debris", "layout": {"x": 16.4, "y": 6.6, "size": 1.0, "shape": "circle"}, "hide_lines": true,
      "icon": "minecraft:ancient_debris",
      "en_us": {"title": "Hidden in the Depths",
        "text": ["[lead] Ancient debris hides low in the Nether and shrugs off explosions.",
                 "[li:minecraft:diamond_pickaxe] Mine it with a diamond pickaxe",
                 "[li:minecraft:netherite_scrap] Smelt it into scrap",
                 "[li:minecraft:netherite_ingot] Combine the scrap with gold into netherite ingots",
                 "[tip] Keep your netherite gear: it is the base for Cataclysm's Ignitium and Cursium and for Luminous gear."]},
      "es_es": {"title": "Escondido en las profundidades",
        "text": ["[lead] Los restos antiguos se esconden abajo en el Nether y aguantan explosiones.",
                 "[li:minecraft:diamond_pickaxe] Picalos con pico de diamante",
                 "[li:minecraft:netherite_scrap] Fundilos en chatarra",
                 "[li:minecraft:netherite_ingot] Combiná la chatarra con oro para hacer lingotes de netherite",
                 "[tip] Guardá tu equipo de netherite: es la base del Ignitium y el Cursium de Cataclysm y del equipo Luminoso."]},
      "sources": ["jar:minecraft_1.21.1_client.jar:data/minecraft/advancement/nether/obtain_ancient_debris.json", "repo:docs/design/luminous-gear.md"]
    },
    {
      "key": "netherend_endermen", "deps": ["netherend_portal"], "type": "checkmark", "optional": true, "layout": {"x": 0.6, "y": 7.5, "size": 0.85, "shape": "circle"}, "hide_lines": true,
      "icon": "endermanoverhaul:crimson_pearl",
      "en_us": {"title": "Nether endermen and food",
        "text": ["[lead] Enderman Overhaul gives each Nether biome its own enderman.",
                 "[li] Crimson: pearls that grant Strength on teleport",
                 "[li] Warped: pearls that grant Resistance",
                 "[li] Soul sand valley: a pearl that teleports a bound creature",
                 "{page}",
                 "My Nether's Delight adds Nether cooking to Farmer's Delight: more variety for the pack's food system."]},
      "es_es": {"title": "Endermen y comida del Nether",
        "text": ["[lead] Enderman Overhaul le da a cada bioma del Nether su propio enderman.",
                 "[li] Carmesí: perlas que dan Fuerza al teletransportarte",
                 "[li] Distorsionado: perlas que dan Resistencia",
                 "[li] Valle de almas: una perla que teletransporta a una criatura vinculada",
                 "{page}",
                 "My Nether's Delight suma cocina del Nether a Farmer's Delight: más variedad para el sistema de comida del pack."]},
      "sources": ["jar:endermanoverhaul-neoforge-1.21.1-2.0.3.jar:assets/endermanoverhaul/lang/en_us.json", "jar:endermanoverhaul-neoforge-1.21.1-2.0.3.jar:data/endermanoverhaul/loot_table/entities/crimson_forest_enderman.json", "repo:docs/design/mod-pingpong.md"]
    },
    {
      "key": "netherend_stronghold", "deps": ["netherend_welcome"], "type": "advancement", "advancement": "minecraft:story/follow_ender_eye", "layout": {"x": 7.6, "y": 0.2, "size": 1.0, "shape": "circle"}, "hide_lines": true,
      "icon": "minecraft:ender_eye",
      "en_us": {"title": "The stronghold",
        "text": ["[lead] [item:minecraft:ender_eye|Eyes of Ender] lead to the stronghold, rebuilt by YUNG's Better Strongholds.",
                 "In act [hl|V] the compass counts it done when your team reaches the End.",
                 "[tip] Bring spare eyes. They break at the worst moment."]},
      "es_es": {"title": "La fortaleza del End",
        "text": ["[lead] Los [item:minecraft:ender_eye|ojos de ender] llevan a la fortaleza, rehecha por YUNG's Better Strongholds.",
                 "En el acto [hl|V] la brújula la da por cumplida cuando tu equipo llega al End.",
                 "[tip] Llevá ojos de repuesto. Se rompen en el peor momento."]},
      "sources": ["jar:minecraft_1.21.1_client.jar:data/minecraft/advancement/story/follow_ender_eye.json", "jar:YungsBetterStrongholds-1.21.1-NeoForge-5.1.3.jar:data/minecraft/tags/worldgen/structure/eye_of_ender_located.json", "repo:content/compass_targets.json"]
    },
    {
      "key": "netherend_end", "deps": ["netherend_stronghold"], "type": "dimension", "dimension": "minecraft:the_end", "layout": {"x": 6.8, "y": -8.3, "size": 1.75, "shape": "diamond"}, "hide_lines": true,
      "icon": "minecraft:end_stone",
      "en_us": {"title": "The End",
        "text": ["[lead] YUNG's Better End Island rebuilds the central island and the Dragon arena.",
                 "The fight itself is in [chapter:guide_bosses|the bosses chapter].",
                 "After the Dragon, throw an [item:minecraft:ender_pearl|ender pearl] into an End Gateway to reach the outer islands, for Remote Getaway."]},
      "es_es": {"title": "El End",
        "text": ["[lead] YUNG's Better End Island rehace la isla central y la arena del Dragón.",
                 "La pelea está en [chapter:guide_bosses|el capítulo de jefes].",
                 "Después del Dragón, tirá una [item:minecraft:ender_pearl|perla de ender] dentro de un Portal del End para llegar a las islas exteriores, para «Remote Getaway»."]},
      "sources": ["jar:YungsBetterEndIsland-1.21.1-NeoForge-3.1.2.jar:assets/betterendisland/lang/en_us.json", "jar:minecraft_1.21.1_client.jar:data/minecraft/advancement/end/enter_end_gateway.json", "repo:content/compass_targets.json"]
    },
    {
      "key": "netherend_end_city", "deps": ["netherend_end"], "type": "advancement", "advancement": "minecraft:end/find_end_city", "layout": {"x": 14.5, "y": -8.9, "size": 1.0, "shape": "circle"}, "hide_lines": true,
      "icon": "minecraft:purpur_block",
      "en_us": {"title": "The City at the End of the Game",
        "text": ["[lead] End cities rise on the outer islands, guarded by Shulkers.",
                 "[careful] Shulker Levitation can kill you when it wears off: carry slow falling or a [item:minecraft:water_bucket|water bucket].",
                 "Their ships hide [item:minecraft:elytra|Elytra], and their chests hold good enchanted gear.",
                 "Look up before you look down."]},
      "es_es": {"title": "La ciudad al final del juego",
        "text": ["[lead] Las ciudades del End se levantan en las islas exteriores, custodiadas por Shulkers.",
                 "[careful] La Levitación del Shulker te puede matar cuando se termina: llevá caída lenta o un [item:minecraft:water_bucket|balde de agua].",
                 "Sus barcos esconden [item:minecraft:elytra|élitros] y sus cofres, buen equipo encantado.",
                 "Mirá para arriba antes de mirar para abajo."]},
      "sources": ["jar:minecraft_1.21.1_client.jar:data/minecraft/advancement/end/find_end_city.json", "jar:minecraft_1.21.1_client.jar:data/minecraft/advancement/end/levitate.json"]
    },
    {
      "key": "netherend_end_more", "deps": ["netherend_end_city"], "type": "checkmark", "layout": {"x": 21.0, "y": -10.2, "size": 0.85, "shape": "circle"},
      "icon": "minecraft:chorus_flower",
      "en_us": {"title": "The busy outer End",
        "text": ["[lead] The outer End is busier than it looks.",
                 "The End Castle and its haunting, lone ships, Repurposed Structures' End set and Explorify's shipwreck are in [chapter:sector_structures|Structures and exploration].",
                 "{page}",
                 "[li] Cataclysm adds the Ruined Citadel and its Ender Guardian",
                 "[li] Enderman Overhaul's End endermen drop Corrupted and Ancient Pearls",
                 "[li] End's Delight cooks it all"]},
      "es_es": {"title": "El End exterior poblado",
        "text": ["[lead] El End exterior está más ocupado de lo que parece.",
                 "El Castillo del End y su fantasma, los barcos solitarios, el conjunto del End de Repurposed Structures y el naufragio de Explorify están en [chapter:sector_structures|Estructuras y exploración].",
                 "{page}",
                 "[li] Cataclysm suma la Ciudadela en Ruinas y su Guardián Ender",
                 "[li] Los endermen del End de Enderman Overhaul sueltan Perlas corruptas y antiguas",
                 "[li] End's Delight lo cocina todo"]},
      "sources": ["jar:L_Ender's Cataclysm 1.21.1-3.33.jar:data/cataclysm/worldgen/structure/ruined_citadel.json", "jar:endermanoverhaul-neoforge-1.21.1-2.0.3.jar:assets/endermanoverhaul/lang/en_us.json", "repo:docs/design/mod-pingpong.md", "repo:content/sectors/sector_structures.json (the End structures moved there)"]
    },
    {
      "key": "netherend_lighthouse", "deps": ["netherend_end_more"], "type": "advancement", "advancement": "nova_structures:end/find_end_lighthouse", "optional": true, "layout": {"x": 24.6, "y": -8.2, "size": 1.0, "shape": "circle"},
      "icon": "minecraft:sea_lantern",
      "en_us": {"title": "The Light at the End of the Game",
        "text": ["[lead] Find a Dungeons and Taverns End Lighthouse.",
                 "A fitting landmark for a pack about light, and a good spot for a waystone before exploring further.",
                 "Even at the end of the world, someone left a light on."]},
      "es_es": {"title": "La luz al final del juego",
        "text": ["[lead] Encontrá un Faro del End de Dungeons and Taverns.",
                 "Una referencia muy a tono con un pack sobre la luz, y un buen lugar para una waystone antes de seguir explorando.",
                 "Hasta en el fin del mundo alguien dejó una luz prendida."]},
      "sources": ["jar:dungeons-and-taverns-v4.4.4.jar:data/nova_structures/advancement/end/find_end_lighthouse.json"]
    },
    {
      "key": "netherend_waystones", "deps": ["netherend_welcome"], "type": "checkmark", "layout": {"x": -3.2, "y": 0.2, "size": 1.0, "shape": "rsquare"},
      "icon": "waystones:red_nether_bricks_waystone",
      "en_us": {"title": "Waystones in other dimensions",
        "text": ["[lead] Build one waystone beside each portal and skip the walk every time.",
                 "[li] Nether: red Nether bricks",
                 "[li] End: End stone bricks",
                 "Warping between dimensions costs a flat amount of experience.",
                 "[note] Wild waystones also generate in the Nether and the End."]},
      "es_es": {"title": "Waystones en otras dimensiones",
        "text": ["[lead] Construí una waystone junto a cada portal y ahorrate la caminata siempre.",
                 "[li] Nether: ladrillos rojos del Nether",
                 "[li] End: ladrillos de piedra del End",
                 "Viajar entre dimensiones cuesta una cantidad fija de experiencia.",
                 "[note] Las waystones salvajes también aparecen en el Nether y el End."]},
      "sources": ["jar:waystones-neoforge-1.21.1-21.1.41.jar:data/waystones/recipe/red_nether_bricks_waystone.json", "jar:waystones-neoforge-1.21.1-21.1.41.jar:net/blay09/mods/waystones/config/WaystonesConfigData.class", "jar:waystones-neoforge-1.21.1-21.1.41.jar:net/blay09/mods/waystones/config/WaystonesConfigData$WorldGen.class"]
    },
    {
      "key": "netherend_pack", "deps": ["netherend_welcome"], "type": "checkmark", "layout": {"x": -2.2, "y": -3.1, "size": 1.0, "shape": "rsquare"},
      "icon": "entrelumen:heliodor_compass",
      "en_us": {"title": "What ENTRELUMEN changes here",
        "text": ["[lead] The compass visits a fortress, then the End.",
                 "[li] Act [hl|III]: a YUNG's fortress; carry a blaze rod",
                 "[li] Act [hl|V]: the ocean monument, the stronghold and the End; kill the Dragon",
                 "The Wither is the only nether star source.",
                 "{page}",
                 "[note] Dungeons and Taverns adds fortresses, ports and towers to the Nether, and the pack's measurements flag them as worth watching on a modest PC."]},
      "es_es": {"title": "Qué cambia ENTRELUMEN acá",
        "text": ["[lead] La brújula visita una fortaleza y después el End.",
                 "[li] Acto [hl|III]: una fortaleza de YUNG's; llevá una vara de blaze",
                 "[li] Acto [hl|V]: el monumento oceánico, la fortaleza del End y el End; matá al Dragón",
                 "El Wither es la única fuente de estrellas del Nether.",
                 "{page}",
                 "[note] Dungeons and Taverns suma fortalezas, puertos y torres al Nether, y las mediciones del pack las marcan como algo a vigilar en una PC modesta."]},
      "sources": ["repo:content/compass_targets.json", "repo:docs/design/mod-pingpong.md", "repo:docs/design/exploration-structures-family.md", "repo:catalog/curated.json"]
    },
    {
      "key": "netherend_mastery", "deps": ["netherend_debris", "netherend_end_more"], "type": "checkmark", "layout": {"x": 22.0, "y": 0.3, "size": 2.25, "shape": "pentagon"}, "hide_lines": true,
      "icon": "minecraft:end_crystal",
      "en_us": {"title": "Both ends of the world", "subtitle": "Below and beyond.",
        "text": ["[lead] Fortresses, bastions and keeps below; cities, lighthouses and citadels beyond the void.",
                 "You have seen both ends of the world. Heliodor is somewhere in between."]},
      "es_es": {"title": "Los dos extremos del mundo", "subtitle": "Abajo y más allá.",
        "text": ["[lead] Fortalezas, bastiones y fortines abajo; ciudades, faros y ciudadelas más allá del vacío.",
                 "Ya viste los dos extremos del mundo. Heliodor está en algún lugar del medio."]},
      "sources": ["repo:docs/design/story-bible.md", "repo:docs/design/quest-lore.md"]
    },
    {
      "key": "netherend_toy_flint", "role": "decor", "deps": [], "type": "checkmark", "optional": true, "layout": {"x": 1.5, "y": -1.7, "size": 0.75, "shape": "none"},
      "icon": "minecraft:flint_and_steel",
      "en_us": {"title": "Flint and Steel",
        "text": ["[lead] One spark and the frame remembers it is a door.",
                 "In the world the portal needs a light of its own. In the book, a click will do."]},
      "es_es": {"title": "Pedernal y acero",
        "text": ["[lead] Una chispa y el marco se acuerda de que es una puerta.",
                 "En el mundo el portal necesita su propia luz. En el libro alcanza con un clic."]},
      "sources": ["jar:minecraft_1.21.1_client.jar:data/minecraft/advancement/story/enter_the_nether.json"]
    },
    {
      "key": "netherend_toy_ghast", "role": "decor", "deps": [], "type": "checkmark", "optional": true, "layout": {"x": 24.8, "y": 6.3, "size": 0.75, "shape": "none"},
      "icon": "minecraft:ghast_tear",
      "en_us": {"title": "Say Hi to the Ghast",
        "text": ["[lead] It floats, it cries and its fireballs are not a greeting.",
                 "Bounce one back for the advancement Return to Sender. In the book it just waves."]},
      "es_es": {"title": "Saludá al Ghast",
        "text": ["[lead] Flota, llora y sus bolas de fuego no son un saludo.",
                 "Devolvele una para el logro «Return to Sender». En el libro sólo saluda."]},
      "sources": ["jar:minecraft_1.21.1_client.jar:data/minecraft/advancement/nether/return_to_sender.json"]
    }
  ]
}
