  "quests": [
    {
      "key": "farming_resources_welcome", "deps": [], "type": "checkmark", "layout": {"x": 0, "y": 0.3, "size": 2.0, "shape": "hexagon"},
      "en_us": {"title": "Fish That Pay", "subtitle": "The pier opens at dusk.",
        "text": ["[lead] Aquaculture fishes up metal, treasure and fillets.",
                 "[li] Dozens of fish by biome",
                 "[li] Better rods, hooks and bait",
                 "Slow to start, endless once running, and the travel food the Atlas asks for in act [hl|II] comes from here.",
                 "[note] Productive Bees has [chapter:sector_bees_apiary|chapters of its own]; so does Mystical Agriculture: [chapter:sector_ma_essence|Essence]."]},
      "es_es": {"title": "Peces que rinden", "subtitle": "El muelle abre al atardecer.",
        "text": ["[lead] Aquaculture pesca metal, tesoros y filetes.",
                 "[li] Decenas de peces por bioma",
                 "[li] Mejores cañas, anzuelos y carnada",
                 "Arranca lento, no se agota nunca, y de acá sale la comida de viaje que pide el Atlas en el acto [hl|II].",
                 "[note] Productive Bees tiene [chapter:sector_bees_apiary|capítulos propios]; Mystical Agriculture también: [chapter:sector_ma_essence|Esencia]."]},
      "sources": ["repo:content/integration-design.json", "repo:content/sectors/sector_bees_apiary.json", "repo:content/sectors/sector_ma_essence.json"]
    },
    {
      "key": "farming_resources_fishing", "deps": ["farming_resources_welcome"], "type": "item", "item": "aquaculture:iron_fishing_rod", "layout": {"x": 3.6, "y": 0.65, "size": 1.25, "shape": "circle"},
      "en_us": {"title": "Aquaculture: Better Fishing",
        "text": ["[lead] Dozens of biome fish, better rods and a whole tackle system.",
                 "[li] Rods: iron, gold, diamond and neptunium",
                 "[li] Hooks, bait like worms, lines and bobbers",
                 "[li] A [item:aquaculture:tackle_box|Tackle Box] for gear and a [item:aquaculture:iron_fillet_knife|Fillet Knife] for fillets",
                 "{page}",
                 "It also fishes up treasure: [item:aquaculture:neptunes_bounty|Neptune's Bounty] chests hold neptunium, a metal for underwater gear."]},
      "es_es": {"title": "Aquaculture: mejor pesca",
        "text": ["[lead] Decenas de peces por bioma, mejores cañas y todo un sistema de pesca.",
                 "[li] Cañas: hierro, oro, diamante y neptunio",
                 "[li] Anzuelos, carnada como gusanos, líneas y boyas",
                 "[li] Una [item:aquaculture:tackle_box|Caja de pesca] para el equipo y un [item:aquaculture:iron_fillet_knife|Cuchillo fileteador] para los filetes",
                 "{page}",
                 "También pesca tesoros: los cofres de [item:aquaculture:neptunes_bounty|Neptune's Bounty] traen neptunio, un metal para equipo submarino."]},
      "sources": ["jar:Aquaculture-1.21.1-2.7.21.jar:assets/aquaculture/lang/en_us.json"]
    },
    {
      "key": "farming_resources_tackle_box", "deps": ["farming_resources_fishing"], "type": "item", "item": "aquaculture:tackle_box", "layout": {"x": 7.2, "y": 0.7, "size": 1.0, "shape": "circle"},
      "en_us": {"title": "The Tackle Box",
        "text": ["[lead] The [item:aquaculture:tackle_box|Tackle Box] stores the fishing gear.",
                 "A rod set in it takes a hook, a line, a bobber and bait.",
                 "Craft it from:",
                 "[li] Five iron",
                 "[li] An iron block",
                 "[li] A chest",
                 "[li] Two green dyes"]},
      "es_es": {"title": "La caja de pesca",
        "text": ["[lead] La [item:aquaculture:tackle_box|Caja de pesca] guarda el equipo de pesca.",
                 "Una caña puesta ahí acepta anzuelo, sedal, corcho y carnada.",
                 "Se fabrica con:",
                 "[li] Cinco de hierro",
                 "[li] Un bloque de hierro",
                 "[li] Un cofre",
                 "[li] Dos tintes verdes"]},
      "sources": ["jar:Aquaculture-1.21.1-2.7.21.jar:data/aquaculture/recipe/tackle_box.json", "jar:Aquaculture-1.21.1-2.7.21.jar:com/teammetallurgy/aquaculture/inventory/container/TackleBoxContainer.class"]
    },
    {
      "key": "farming_resources_hooks", "deps": ["farming_resources_tackle_box"], "type": "item", "item": "aquaculture:iron_hook", "optional": true, "layout": {"x": 10.8, "y": 0.7, "size": 1.0, "shape": "diamond"},
      "en_us": {"title": "Hooks",
        "text": ["[lead] Four iron nuggets make an [item:aquaculture:iron_hook|Iron Hook], which saves durability one cast in [hl|five].",
                 "Two iron hooks make a [item:aquaculture:double_hook|Double Hook] that can land two catches at once.",
                 "[li] Gold and glowstone hooks add luck",
                 "[li] Redstone ones give you longer to reel in"]},
      "es_es": {"title": "Anzuelos",
        "text": ["[lead] Cuatro pepitas de hierro hacen un [item:aquaculture:iron_hook|Anzuelo de hierro], que ahorra durabilidad una vez de cada [hl|cinco].",
                 "Dos anzuelos de hierro hacen un [item:aquaculture:double_hook|Anzuelo doble] que puede sacar dos piezas de una.",
                 "[li] Los de oro y piedra luminosa dan suerte",
                 "[li] Los de redstone, más tiempo para recoger"]},
      "sources": ["jar:Aquaculture-1.21.1-2.7.21.jar:data/aquaculture/recipe/iron_hook.json", "jar:Aquaculture-1.21.1-2.7.21.jar:data/aquaculture/recipe/double_hook.json", "jar:Aquaculture-1.21.1-2.7.21.jar:assets/aquaculture/lang/en_us.json"]
    },
    {
      "key": "farming_resources_fillet_knife", "deps": ["farming_resources_fishing"], "type": "item", "item": "aquaculture:iron_fillet_knife", "layout": {"x": 13.6, "y": 3.45, "size": 1.0, "shape": "circle"}, "hide_lines": true,
      "en_us": {"title": "The Fillet Knife",
        "text": ["[lead] Two iron ingots and a stick make an [item:aquaculture:iron_fillet_knife|Iron Fillet Knife].",
                 "A fish and the knife on a crafting grid become raw fillets, and the neptunium knife cuts more of them."]},
      "es_es": {"title": "El cuchillo fileteador",
        "text": ["[lead] Dos lingotes de hierro y un palo hacen un [item:aquaculture:iron_fillet_knife|Cuchillo fileteador de hierro].",
                 "Un pez y el cuchillo en la mesa de trabajo dan filetes crudos, y el de neptunio corta más."]},
      "sources": ["jar:Aquaculture-1.21.1-2.7.21.jar:data/aquaculture/recipe/iron_fillet_knife.json", "jar:Aquaculture-1.21.1-2.7.21.jar:data/aquaculture/recipe/fish_fillet.json", "jar:Aquaculture-1.21.1-2.7.21.jar:assets/aquaculture/lang/en_us.json"]
    },
    {
      "key": "farming_resources_fillets", "deps": ["farming_resources_fillet_knife"], "type": "item", "item": "aquaculture:fish_fillet_cooked", "layout": {"x": 16.0, "y": 3.45, "size": 1.0, "shape": "pentagon"},
      "en_us": {"title": "Fillets for the Story",
        "text": ["[lead] Two vegetable soups and two cooked Aquaculture fillets make the first [item:entrelumen:ration_bundle|Travel Rations].",
                 "They are the travel food the Atlas asks for in act [hl|II].",
                 "[tip] A [item:aquaculture:worm_farm|Worm Farm] keeps the bait coming."]},
      "es_es": {"title": "Filetes para la historia",
        "text": ["[lead] Dos sopas de verduras y dos filetes cocidos de Aquaculture hacen las primeras [item:entrelumen:ration_bundle|Provisiones de viaje].",
                 "Son la comida de viaje que pide el Atlas en el acto [hl|II].",
                 "[tip] Una [item:aquaculture:worm_farm|Granja de gusanos] mantiene la carnada."]},
      "sources": ["repo:content/integration-design.json", "repo:docs/design/cooking-provisions-family.md"]
    },
    {
      "key": "farming_resources_neptunium", "deps": ["farming_resources_fishing"], "type": "item", "item": "aquaculture:neptunium_ingot", "optional": true, "layout": {"x": 6.0, "y": 9.2, "size": 1.0, "shape": "circle"}, "hide_lines": true,
      "en_us": {"title": "Neptunium Gear", "subtitle": "Ocean monuments beware.",
        "text": ["[lead] Built for underwater.",
                 "[li] Rod: faster bites",
                 "[li] Helmet: clearer vision",
                 "[li] Chestplate: breath",
                 "[li] Leggings: weightlessness",
                 "[li] Boots: speed",
                 "[li] Pickaxe and shovel: no speed lost underwater; the hoe keeps farmland moist",
                 "{page}",
                 "Ocean monuments will not know what hit them."]},
      "es_es": {"title": "Equipo de neptunio", "subtitle": "Que tiemblen los monumentos.",
        "text": ["[lead] Hecho para bajo el agua.",
                 "[li] Caña: pican antes",
                 "[li] Casco: mejor visión",
                 "[li] Pechera: deja respirar",
                 "[li] Pantalones: te hacen ingrávido",
                 "[li] Botas: nadan rápido",
                 "[li] Pico y pala: no pierden velocidad bajo el agua; la azada mantiene húmeda la tierra",
                 "{page}",
                 "Los monumentos oceánicos no van a saber qué los golpeó."]},
      "sources": ["jar:Aquaculture-1.21.1-2.7.21.jar:assets/aquaculture/lang/en_us.json"]
    },
    {
      "key": "farming_resources_close", "deps": ["farming_resources_fillets"], "type": "checkmark", "layout": {"x": 16.6, "y": 0.3, "size": 2.0, "shape": "hexagon"}, "hide_lines": true,
      "icon": "minecraft:honeycomb",
      "en_us": {"title": "Endless Supplies", "subtitle": "One more cast.",
        "text": ["[lead] A fishing line that pays in treasure, fillets for the road and neptunium for the deep.",
                 "Somewhere, a fish is swimming toward your hook right now."]},
      "es_es": {"title": "Suministro sin fin", "subtitle": "Un lanzamiento más.",
        "text": ["[lead] Una caña que paga en tesoros, filetes para el camino y neptunio para lo profundo.",
                 "En algún lado, un pez está nadando hacia tu anzuelo ahora mismo."]},
      "sources": ["repo:content/guides/README.md"]
    },
    {
      "key": "farming_resources_toy_lanterns", "role": "decor", "deps": [], "type": "checkmark", "optional": true, "layout": {"x": 1.8, "y": -1.9, "size": 0.75, "shape": "none"},
      "icon": "minecraft:lantern",
      "en_us": {"title": "Light the Pier",
        "text": ["[lead] Four posts, four lanterns, one click.",
                 "Fish do not care about the light, but the fisher does."]},
      "es_es": {"title": "Prender el muelle",
        "text": ["[lead] Cuatro postes, cuatro faroles, un clic.",
                 "A los peces la luz no les importa, pero a quien pesca, sí."]},
      "sources": ["jar:Aquaculture-1.21.1-2.7.21.jar:assets/aquaculture/lang/en_us.json"]
    },
    {
      "key": "farming_resources_toy_bite", "role": "decor", "deps": [], "type": "checkmark", "optional": true, "layout": {"x": 19.8, "y": 2.4, "size": 0.75, "shape": "none"},
      "icon": "minecraft:cod",
      "en_us": {"title": "Something Bites",
        "text": ["[lead] The bobber dips, the line goes tight, the fish jumps clear.",
                 "In the book one click is enough. In the world, time it."]},
      "es_es": {"title": "Algo pica",
        "text": ["[lead] La boya se hunde, el sedal se tensa, el pez salta.",
                 "En el libro alcanza con un clic. En el mundo, es cuestión de timing."]},
      "sources": ["jar:Aquaculture-1.21.1-2.7.21.jar:assets/aquaculture/lang/en_us.json"]
    }
  ]
}
