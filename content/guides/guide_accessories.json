  "quests": [
    {
      "key": "accessories_welcome", "deps": [], "type": "checkmark", "layout": {"x": 0, "y": 0, "size": 2.0, "shape": "hexagon"},
      "en_us": {"title": "Extra slots, extra powers",
        "text": ["[lead] Most mods hang their accessories on Curios slots.",
                 "[li] Curios: head, necklace, belt, hands, feet, back and more",
                 "[li] The Aether keeps its own menu",
                 "[li] Eternal Starlight's are fused into your gear",
                 "{page}",
                 "The richest source is the Artifacts mod: uncraftable trinkets found while exploring.",
                 "Armor keeps you alive; trinkets make it interesting."]},
      "es_es": {"title": "Ranuras extra, poderes extra",
        "text": ["[lead] Casi todos los mods cuelgan sus accesorios de ranuras de Curios.",
                 "[li] Curios: cabeza, collar, cinturón, manos, pies, espalda y más",
                 "[li] El Aether conserva su propio menú",
                 "[li] Los de Eternal Starlight se funden con tu equipo",
                 "{page}",
                 "La fuente más rica es el mod Artifacts: chucherías que no se fabrican y se encuentran explorando.",
                 "La armadura te mantiene vivo; las chucherías lo vuelven interesante."]},
      "sources": ["jar:curios-neoforge-9.5.1+1.21.1.jar:assets/curios/lang/en_us.json", "jar:aether-1.21.1-1.5.10-neoforge.jar:assets/aether/lang/en_us.json", "jar:eternalstarlight-0.9.0+1.21.1+neoforge.jar:assets/eternal_starlight/lang/en_us.json", "jar:artifacts-neoforge-13.2.3.jar:data/artifacts/curios/slots/belt.json", "repo:docs/design/accessory-tooltip-compat.md"]
    },
    {
      "key": "accessories_curios", "deps": ["accessories_welcome"], "type": "checkmark", "layout": {"x": 4.6, "y": -4.4, "size": 0.85, "shape": "circle"},
      "icon": "minecraft:armor_stand",
      "en_us": {"title": "Open the Curios inventory",
        "text": ["[lead] Press [key:key.curios.open.desc], or click the Curios button in your inventory, to open the slots.",
                 "[li] Each slot can hide its item visually",
                 "[li] Artifacts adds cosmetic slots: show one trinket while wearing another",
                 "[tip] If something does not fit, it belongs to another slot: hover the slot to read its name."]},
      "es_es": {"title": "Abrí el inventario de Curios",
        "text": ["[lead] Apretá [key:key.curios.open.desc], o el botón de Curios del inventario, para abrir las ranuras.",
                 "[li] Cada ranura puede ocultar su ítem a la vista",
                 "[li] Artifacts suma ranuras cosméticas: mostrá una chuchería mientras llevás otra",
                 "[tip] Si algo no entra, es de otra ranura: pasá el mouse sobre la ranura para leer su nombre."]},
      "sources": ["jar:curios-neoforge-9.5.1+1.21.1.jar:assets/curios/lang/en_us.json", "jar:artifacts-neoforge-13.2.3.jar:data/artifacts/curios/slots/belt.json", "jar:artifacts-neoforge-13.2.3.jar:assets/artifacts/lang/en_us.json"]
    },
    {
      "key": "accessories_keys", "deps": ["accessories_curios"], "type": "checkmark", "optional": true, "layout": {"x": 9.2, "y": -4.4, "size": 0.85, "shape": "circle"},
      "icon": "artifacts:universal_attractor",
      "en_us": {"title": "Toggles and keys",
        "text": ["[lead] Some trinkets switch on and off, and their keys live in Controls, under Artifacts.",
                 "[li:artifacts:universal_attractor] The Universal Attractor",
                 "[li:artifacts:night_vision_goggles] The Night Vision Goggles",
                 "[li:artifacts:scarf_of_invisibility] The Scarf of Invisibility",
                 "[li:artifacts:charm_of_shrinking] The Charms of Shrinking and Sinking",
                 "[li:artifacts:helium_flamingo] The Helium Flamingo's flight",
                 "[tip] Turn the attractor off at home, unless you enjoy collecting every dropped seed."]},
      "es_es": {"title": "Interruptores y teclas",
        "text": ["[lead] Algunas chucherías se prenden y apagan, con teclas en Controles, categoría Artifacts.",
                 "[li:artifacts:universal_attractor] El Imán universal",
                 "[li:artifacts:night_vision_goggles] Las Gafas de visión nocturna",
                 "[li:artifacts:scarf_of_invisibility] La Bufanda de la invisibilidad",
                 "[li:artifacts:charm_of_shrinking] Los Collares del enanismo y acuático",
                 "[li:artifacts:helium_flamingo] El vuelo del Flamenco de helio",
                 "[tip] Apagá el imán en casa, salvo que te guste juntar cada semilla que se cae."]},
      "sources": ["jar:artifacts-neoforge-13.2.3.jar:assets/artifacts/lang/en_us.json"]
    },
    {
      "key": "accessories_aether", "deps": ["accessories_welcome"], "type": "checkmark", "layout": {"x": 4.6, "y": 4.4, "size": 0.85, "shape": "circle"},
      "icon": "aether:ice_ring",
      "en_us": {"title": "The Aether accessory menu",
        "text": ["[lead] The Aether has its own screen for rings, a pendant, gloves, a cape, a shield and more.",
                 "Open it with [key:key.aether.open_accessories.desc], or its inventory button.",
                 "{page}",
                 "Highlights:",
                 "[li] Zanite rings and pendants: faster mining for a while",
                 "[li] Ice ones: walk on water and lava",
                 "[li] The Regeneration Stone",
                 "[li] The Iron Bubble",
                 "[li] The Invisibility Cloak",
                 "[li:deep_aether:cloud_cape] Deep Aether's Cloud Cape (double jump) and Aercloud Necklace"]},
      "es_es": {"title": "El menú de accesorios del Aether",
        "text": ["[lead] El Aether tiene su propia pantalla para anillos, colgante, guantes, capa, escudo y más.",
                 "Abrila con [key:key.aether.open_accessories.desc], o con su botón en el inventario.",
                 "{page}",
                 "Destacados:",
                 "[li] Anillos y colgantes de zanita: picás más rápido un rato",
                 "[li] Los de hielo: caminar sobre agua y lava",
                 "[li] La Piedra de regeneración",
                 "[li] La Burbuja de hierro",
                 "[li] La Capa de invisibilidad",
                 "[li:deep_aether:cloud_cape] De Deep Aether, la Capa de nube (doble salto) y el Collar de aeronube"]},
      "sources": ["jar:aether-1.21.1-1.5.10-neoforge.jar:assets/aether/lang/en_us.json", "jar:aether-1.21.1-1.5.10-neoforge.jar:com/aetherteam/aether/client/AetherKeys.class", "jar:aether-1.21.1-1.5.10-neoforge.jar:data/aether/tags/item/accessories.json", "jar:deep_aether-1.21.1-1.1.5.1.jar:assets/deep_aether/lang/en_us.json"]
    },
    {
      "key": "accessories_terra", "deps": ["accessories_curios"], "type": "item", "item": "entrelumen:terra_arm", "layout": {"x": 9.2, "y": 4.4, "size": 1.0, "shape": "circle"},
      "en_us": {"title": "Terra's Arm",
        "text": ["[lead] ENTRELUMEN's own accessory: Terra's cyborg arm.",
                 "It goes in a Curios hands slot and gives extra block reach.",
                 "Only the Atlas gives it, when act [hl|II] closes: the sunken workshop's vault holds the blueprint, not the arm.",
                 "Everything else: [chapter:guide_entrelumen_terra_arm|the Terra's Arm chapter]."]},
      "es_es": {"title": "El Brazo de Terra",
        "text": ["[lead] El accesorio propio de ENTRELUMEN: el brazo ciborg de Terra.",
                 "Va en una ranura de manos de Curios y da más alcance de bloques.",
                 "Sólo lo da el Atlas, al cerrar el acto [hl|II]: la bóveda del taller hundido guarda el plano, no el brazo.",
                 "Todo lo demás: [chapter:guide_entrelumen_terra_arm|el capítulo El Brazo de Terra]."]},
      "sources": ["repo:docs/design/heliodor-ruins.md", "repo:companion/src/main/resources/data/curios/tags/item/hands.json", "repo:companion/src/main/resources/data/entrelumen/campaign/projects.json", "repo:companion/src/main/resources/data/entrelumen/loot_table/chests/ruin_act2_workshop.json"]
    },
    {
      "key": "accessories_starlight", "deps": ["accessories_aether"], "type": "checkmark", "optional": true, "layout": {"x": 4.6, "y": 9.0, "size": 0.85, "shape": "circle"},
      "icon": "eternal_starlight:orb_of_prophecy",
      "en_us": {"title": "Starlight goes inside your gear",
        "text": ["[lead] Eternal Starlight's accessories are not worn: they combine into your gear.",
                 "Each one merges into a specific kind of equipment, like items into a bundle, and the gear gains its effect. How many fit depends on the gear's accessory slots.",
                 "[tip] The Glimmering Tablet says how to get each one."]},
      "es_es": {"title": "Starlight va dentro del equipo",
        "text": ["[lead] Los accesorios de Eternal Starlight no se visten: se combinan con tu equipo.",
                 "Cada uno se une a un tipo de equipo concreto, como meter ítems en un saco, y el equipo gana el efecto. Cuántos entran depende de sus ranuras de accesorio.",
                 "[tip] La Glimmering Tablet dice cómo conseguir cada uno."]},
      "sources": ["jar:eternalstarlight-0.9.0+1.21.1+neoforge.jar:assets/eternal_starlight/lang/en_us.json"]
    },
    {
      "key": "accessories_pack", "deps": ["accessories_welcome"], "type": "checkmark", "layout": {"x": 0, "y": 4.4, "size": 1.0, "shape": "rsquare"},
      "icon": "sophisticatedbackpacks:backpack",
      "en_us": {"title": "Accessories in this pack",
        "text": ["[lead] Curios and the Aether's Accessories run side by side.",
                 "[li] Artifacts registers its slots, and the cosmetic ones, in Curios",
                 "[li] Cataclysm, Occultism, Industrial Foregoing and Sophisticated Backpacks use Curios slots too: a backpack goes on your back",
                 "{page}",
                 "Iron's Gems and Jewelry makes rings and amulets at a jeweller's bench; it has its own chapter: [chapter:sector_irons_arcana|The Arcane Anvil]."]},
      "es_es": {"title": "Los accesorios en este pack",
        "text": ["[lead] Curios y los Accessories del Aether conviven.",
                 "[li] Artifacts registra sus ranuras, y las cosméticas, en Curios",
                 "[li] Cataclysm, Occultism, Industrial Foregoing y Sophisticated Backpacks también usan ranuras de Curios: la mochila va en la espalda",
                 "{page}",
                 "Iron's Gems and Jewelry hace anillos y amuletos en un banco de joyero; tiene su propio capítulo: [chapter:sector_irons_arcana|El Yunque Arcano]."]},
      "sources": ["repo:docs/design/accessory-tooltip-compat.md", "repo:docs/design/heliodor-ruins.md", "repo:docs/design/arcane-expansion-family.md", "jar:artifacts-neoforge-13.2.3.jar:data/artifacts/curios/slots/belt.json"]
    },
    {
      "key": "accessories_mastery", "deps": ["accessories_keys", "accessories_terra"], "type": "checkmark", "layout": {"x": 14.0, "y": 0.0, "size": 2.25, "shape": "pentagon"},
      "icon": "artifacts:lucky_scarf",
      "en_us": {"title": "A full set of trinkets", "subtitle": "Every slot, a different game.",
        "text": ["[lead] Every slot filled with something that suits you: a jump, a heal, a magnet, a lucky scarf.",
                 "That is how two players in the same armor end up playing completely different games."]},
      "es_es": {"title": "Un juego completo de chucherías", "subtitle": "Cada ranura, un juego distinto.",
        "text": ["[lead] Cada ranura con algo que va con vos: un salto, una curación, un imán, una bufanda de la suerte.",
                 "Así dos jugadores con la misma armadura terminan jugando juegos completamente distintos."]},
      "sources": ["jar:artifacts-neoforge-13.2.3.jar:assets/artifacts/lang/en_us.json"]
    },
    {
      "key": "accessories_toy_cloud", "role": "decor", "deps": [], "type": "checkmark", "optional": true, "layout": {"x": 19.4, "y": -3.4, "size": 0.75, "shape": "none"},
      "icon": "artifacts:cloud_in_a_bottle",
      "en_us": {"title": "Cloud in a Bottle",
        "text": ["[lead] Jump, then jump again: the bottle keeps one puff for you.",
                 "In the book the puff just floats. In the world, press jump in the air."]},
      "es_es": {"title": "Nube en una botella",
        "text": ["[lead] Un salto, y otro más: la botella guarda una nube para vos.",
                 "En el libro la nube sólo flota. En el mundo, saltá de nuevo en el aire."]},
      "sources": ["jar:artifacts-neoforge-13.2.3.jar:assets/artifacts/lang/en_us.json"]
