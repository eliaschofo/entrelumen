      "en_us": {"title": "Polish the Rings",
        "text": ["[lead] A soft cloth, one ring, and the whole case catches the light.",
                 "In the book one click will do."]},
      "es_es": {"title": "Pulir los anillos",
        "text": ["[lead] Un paño suave, un anillo, y toda la vitrina agarra la luz.",
