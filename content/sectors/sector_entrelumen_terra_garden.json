  "quests": [
    {
      "key": "tg_plan", "role": "entry", "deps": [],
      "task": {"item": "entrelumen:terra_garden_plan"},
      "at": {"x": -9, "y": 5},
      "en_us": {"title": "Terra's plan", "subtitle": "Rolled up in the Atlas since the light froze.",
        "text": ["[lead] Renewable Horizons gives you [item:entrelumen:terra_garden_plan|Terra's Plan: Hydroponic Garden].",
                 "Deliver a [item:entrelumen:renewal_engine|Renewal Engine] to that act V project in the Atlas and the plan is yours.",
                 "[tip] Four paper around the plan make a second copy for a teammate."]},
      "es_es": {"title": "El plano de Terra", "subtitle": "Enrollado en el Atlas desde que la luz se congeló.",
        "text": ["[lead] Horizontes renovables te da el [item:entrelumen:terra_garden_plan|Plano de Terra: jardín hidropónico].",
                 "Entregá un [item:entrelumen:renewal_engine|Motor de renovación] en ese proyecto del acto V, desde el Atlas, y el plano es tuyo.",
                 "[tip] Cuatro papeles alrededor del plano hacen una copia para alguien de tu equipo."]},
      "sources": ["repo:docs/design/terra-garden.md", "repo:companion/src/main/resources/data/entrelumen/campaign/projects.json", "repo:companion/src/main/resources/data/entrelumen/recipe/terra_garden_plan_copy.json"]
    },
    {
      "key": "tg_ghost", "role": "info", "deps": ["tg_plan"],
      "task": {"type": "checkmark"},
      "icon": "entrelumen:terra_garden_plan",
      "at": {"x": -5, "y": 5},
      "en_us": {"title": "See it before you build it",
        "text": ["[lead] The plan projects the whole garden as a ghost, block by block.",
                 "[li] [icon:right_click] Right-click a block: the core goes there, the front faces you",
                 "[li] Crouch and right-click the ghost to roll the plan up",
                 "Blocks you still owe glow in place, and the counter says how many are left."]},
      "es_es": {"title": "Miralo antes de armarlo",
        "text": ["[lead] El plano proyecta el jardín entero como un fantasma, bloque por bloque.",
                 "[li] [icon:right_click] Clic derecho en un bloque: el núcleo va ahí y el frente te mira",
                 "[li] Agachate y hacé clic derecho en el fantasma para enrollar el plano",
                 "Los bloques que te faltan brillan en su lugar, y el contador dice cuántos quedan."]},
      "sources": ["repo:docs/design/terra-garden.md", "repo:companion/src/main/java/dev/entrelumen/client/TerraGardenClient.java"]
    },
    {
      "key": "tg_build", "role": "step", "deps": ["tg_ghost"],
      "tasks": [{"item": "entrelumen:terra_garden_core"}, {"item": "entrelumen:hydroponic_trough", "count": 25}],
      "at": {"x": -1, "y": 5},
      "en_us": {"title": "Copper, glass and moss",
        "text": ["[lead] The garden is ordinary blocks around one core and 25 troughs.",
                 "[li] The [item:entrelumen:terra_garden_core|Hydroponic Garden Core], on the front edge",
                 "[li] Troughs in three steps: 16, 8 and 1",
                 "[li] Calcite, moss, oxidized copper, glass, lanterns and glow berries",
                 "[note] Copper counts at any stage, waxed or not."]},
      "es_es": {"title": "Cobre, vidrio y musgo",
        "text": ["[lead] El jardín son bloques comunes alrededor de un núcleo y 25 bandejas.",
                 "[li] El [item:entrelumen:terra_garden_core|Núcleo del jardín hidropónico], en el borde del frente",
                 "[li] Bandejas en tres escalones: 16, 8 y 1",
                 "[li] Calcita, musgo, cobre oxidado, vidrio, faroles y bayas luminosas",
                 "[note] El cobre vale en cualquier etapa, encerado o no."]},
      "sources": ["repo:docs/design/terra-garden.md", "repo:art/structures/terra_garden.py", "repo:companion/src/main/resources/data/entrelumen/recipe/terra_garden_core.json", "repo:companion/src/main/resources/data/entrelumen/recipe/hydroponic_trough.json"]
    },
    {
      "key": "tg_wake", "role": "milestone", "deps": ["tg_build"],
      "task": {"type": "stat", "stat": "entrelumen:terra_garden_activations", "value": 1, "icon": "entrelumen:terra_grow_lamp", "title": {"en_us": "Wake a garden", "es_es": "Despertá un jardín"}},
      "icon": "entrelumen:terra_grow_lamp",
      "at": {"x": 3, "y": 1},
      "en_us": {"title": "Wake it with the lamp", "subtitle": "A flame kept upside down, so its light drips.",
        "text": ["[lead] [item:entrelumen:terra_grow_lamp|Terra's Grow Lamp] wakes a built garden.",
                 "[icon:right_click] Right-click the core with it. Two sky ingots, two atomic alloys and a copper bulb make one.",
                 "It is never used up: one lamp wakes every garden you build, each once."]},
