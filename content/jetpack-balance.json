    "oritech-startup.toml": "OritechStartupConfig (NeoForge STARTUP config); BaseJetpackItem.tickJetpack takes fuelUsage of fluid per tick when the jetpack holds fuel, otherwise energyUsage of energy. NeoForge fills in the other keys with their defaults.",
    "pneumaticcraft-common.toml": "CommonConfig.Armor.jetBootsAirUsage, air per tick of thrust for each Jet Boots upgrade. NeoForge fills in the other keys with their defaults."
  },
  "surcharge": {
    "script": "pack/kubejs/server_scripts/entrelumen_jetpack_balance.js",
    "note": "These pieces fix their per-tick cost in code and have no setting for it. After each player tick the script takes 1.5 times what the worn chest piece lost since the previous tick; a loss above the piece's native maximum per tick is a swap, not flight, and is not charged.",
    "items": [
      {
        "item": "mekanism:jetpack",
        "name": "Jetpack de hidrógeno",
        "mod": "Mekanism 10.7.19",
        "kind": "chemical",
        "max": 1,
        "before": "1 mB de hidrógeno/t",
        "after": "2,5 mB/t",
        "evidence": "ItemJetpack.useJetpackFuel extracts a constant 1 mB; gear.toml only sets the tank."
      },
      {
        "item": "mekanism:jetpack_armored",
        "name": "Jetpack blindado",
        "mod": "Mekanism 10.7.19",
        "kind": "chemical",
        "max": 1,
        "before": "1 mB de hidrógeno/t",
        "after": "2,5 mB/t",
        "evidence": "ItemArmoredJetpack inherits ItemJetpack.useJetpackFuel."
      },
      {
        "item": "mekanism:mekasuit_bodyarmor",
        "name": "MekaSuit con unidad jetpack",
        "mod": "Mekanism 10.7.19",
        "kind": "chemical",
        "max": 4,
        "before": "1 a 4 mB/t (según el empuje)",
        "after": "2,5 a 10 mB/t",
        "evidence": "ItemMekaSuitArmor.useJetpackFuel extracts ceil(thrust multiplier), 0.5 to 4."
      },
      {
        "item": "modern_industrialization:diesel_jetpack",
        "name": "Jetpack diésel",
        "mod": "Modern Industrialization 2.5.6",
        "kind": "fluid",
        "max": 2,
        "before": "1 mB/t en el aire, 2 subiendo",
        "after": "2,5 a 5 mB/t",
        "evidence": "JetpackItem.tickArmor calls FluidFuelItemHelper.decrement once in the air and once more when holding up."
      },
      {
        "item": "ad_astra:jet_suit",
        "name": "Traje propulsor",
        "mod": "Ad Astra 1.16.19",
        "kind": "energy",
        "max": 100,
        "before": "50 FE/t subiendo, 100 a pleno",
        "after": "125 a 250 FE/t",
        "evidence": "JetSuitItem.inventoryTick calls consume with the constants 50 and 100; no config key."
      }
    ]
