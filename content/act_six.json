  "quests": [
    {
      "key": "solsticio_arrival", "deps": ["horizon_last"], "milestone": "solsticio_arrival", "layout": {"group": "arrival", "x": 0, "y": -9.5, "size": 2.0, "shape": "hexagon", "hide_dependent_lines": false},
      "icon": "entrelumen:light_key",
      "en_us": {"title": "Inside the light",
        "text": ["[lead] Hold use with your [item:entrelumen:light_key|Light Key] until the ring closes.",
                 "It carries you into Solsticio and breaks as you cross; what is left takes you home and back.",
                 "Noon over copper and glass, and nobody has aged a day. Terra is already waving."]},
      "es_es": {"title": "Adentro de la luz",
        "text": ["[lead] Mantené apretado el uso de la [item:entrelumen:light_key|Llave de Luz] hasta que se cierre el anillo.",
                 "Te lleva a Solsticio y se rompe al cruzar; lo que queda te lleva a casa y de vuelta.",
                 "Mediodía sobre cobre y vidrio, y nadie envejeció un día. Terra ya te está saludando."]}
    },
    {
      "key": "solsticio_mayor", "deps": ["solsticio_arrival"], "milestone": "solsticio_mayor", "layout": {"group": "town_hall", "x": 0, "y": -6.0, "size": 2.0, "shape": "hexagon", "hide_dependent_lines": false},
      "icon": "minecraft:bell",
      "en_us": {"title": "The City That Never Dawns",
        "text": ["[lead] Talk to Aurelia in the town hall, beside the portal.",
                 "'Three relics and the key that brought you. Juan, Terra and Bodhi each hold one. The Heart of Heliodor I would keep myself, of course.'"]},
      "es_es": {"title": "La ciudad que no amanece",
        "text": ["[lead] Hablá con Aurelia en el Ayuntamiento, junto al portal.",
                 "«Tres reliquias y la llave que te trajo. Juan, Terra y Bodhi tienen una cada uno. El Corazón de Heliodor lo guardaría yo, por supuesto.»"]}
    },
    {
      "key": "solsticio_seeds", "deps": ["solsticio_mayor"], "milestone": "solsticio_seeds", "layout": {"group": "gardens", "x": -5.64, "y": -2.05, "size": 2.0, "shape": "hexagon", "hide_dependent_lines": false},
      "icon": "minecraft:wheat_seeds",
      "en_us": {"title": "Seeds of the World",
        "text": ["[lead] Bring Juan seeds of eight different species from outside.",
                 "Wheat, beetroot, melon, carrot, potato, berries, cocoa, Farmer's Delight crops...",
                 "'Same seeds since the light fell. The beds are tired. Variety, not sacks.'"]},
      "es_es": {"title": "Semillas del mundo",
        "text": ["[lead] Llevale a Juan semillas de ocho especies distintas de afuera.",
                 "Trigo, remolacha, melón, zanahoria, patata, bayas, cacao, cultivos de Farmer's Delight...",
                 "«Las mismas semillas desde que cayó la luz. Los canteros están cansados. Variedad, no bolsas.»"]}
    },
    {
      "key": "solsticio_harvest", "deps": ["solsticio_seeds"], "milestone": "solsticio_harvest", "layout": {"group": "gardens", "x": -5.64, "y": 2.05, "size": 2.0, "shape": "hexagon", "hide_dependent_lines": false},
      "icon": "entrelumen:heliodor_relic_1",
      "en_us": {"title": "A Harvest for Everyone",
        "text": ["[lead] Bring Juan four different Farmer's Delight meals, sixteen of each.",
                 "Central Kitchen or Slice and Dice can cook them. He gives you the [item:entrelumen:heliodor_relic_1|Luminous Seed].",
                 "'A city eats every day. Feed it, and the seed that carries the light is yours.'"]},
      "es_es": {"title": "Una cosecha para todos",
        "text": ["[lead] Llevale a Juan cuatro platos distintos de Farmer's Delight, dieciséis de cada uno.",
                 "Central Kitchen o Slice and Dice los cocinan. Te da la [item:entrelumen:heliodor_relic_1|Semilla Luminosa].",
                 "«Una ciudad come todos los días. Dale de comer y la semilla que lleva la luz es tuya.»"]}
    },
    {
      "key": "solsticio_power", "deps": ["solsticio_mayor"], "milestone": "solsticio_power", "layout": {"group": "workshop", "x": 3.0, "y": -0.3, "size": 2.0, "shape": "hexagon", "hide_dependent_lines": false},
      "icon": "minecraft:lightning_rod",
      "en_us": {"title": "Power from Outside",
        "text": ["[lead] Bring Terra power that is not frozen light:",
                 "[li] Four [item:create_new_age:generator_coil|Generator Coils]",
                 "[li] Two [item:create_new_age:advanced_solar_heating_plate|Advanced Solar Heating Plates]",
                 "[li] A charged battery from any energy mod ([hl|100,000] FE or more), held in your off hand",
                 "She gives you the Terraprism diagram.",
                 "{page}",
                 "'Frozen light runs machines badly. I need power from outside. Charged means full.'"]},
      "es_es": {"title": "Energía de afuera",
        "text": ["[lead] Llevale a Terra energía que no sea luz congelada:",
                 "[li] Cuatro [item:create_new_age:generator_coil|bobinas del generador]",
                 "[li] Dos [item:create_new_age:advanced_solar_heating_plate|placas solares avanzadas]",
                 "[li] Una batería cargada de cualquier mod de energía ([hl|100.000] FE o más), en la mano secundaria",
                 "Te da el diagrama del Terraprisma.",
                 "{page}",
                 "«La luz congelada mueve mal las máquinas. Necesito energía de afuera. Cargada quiere decir llena.»"]}
    },
    {
      "key": "solsticio_terraprism", "deps": ["solsticio_power"], "milestone": "solsticio_terraprism", "layout": {"group": "workshop", "x": 3.0, "y": 2.5, "size": 2.0, "shape": "hexagon", "hide_dependent_lines": false},
      "icon": "entrelumen:heliodor_relic_2",
      "en_us": {"title": "Channelling the Light",
        "text": ["[lead] Bring Terra one Luminosity of each discipline, all six.",
                 "The natives of the trading hall sell them once they have seen their biome. She gives you the [item:entrelumen:heliodor_relic_2|Terraprism].",
                 "'It takes the light and gives it back as power people can use. That is all I ever wanted it to do.'"]},
      "es_es": {"title": "Canalizar la luz",
        "text": ["[lead] Llevale a Terra una Luminosidad de cada disciplina, las seis.",
                 "Las venden los nativos de la sala de comercio cuando conocen su bioma. Te da el [item:entrelumen:heliodor_relic_2|Terraprisma].",
                 "«Toma la luz y la devuelve como energía que la gente puede usar. Es todo lo que siempre quise que hiciera.»"]}
    },
    {
      "key": "solsticio_good_works", "deps": ["solsticio_mayor"], "milestone": "solsticio_good_works", "layout": {"group": "chapel", "x": 5.64, "y": -2.05, "size": 2.0, "shape": "hexagon", "hide_dependent_lines": false},
      "icon": "minecraft:candle",
      "en_us": {"title": "Good Works",
        "text": ["[lead] Do the errands of the four innkeepers, two each.",
                 "Every errand raises your relation with Bodhi; at five, he listens.",
                 "'I do not bless on request. Help the people here; I will hear about it.'"]},
      "es_es": {"title": "Buenas obras",
        "text": ["[lead] Hacé los encargos de los cuatro posaderos, dos cada uno.",
                 "Cada encargo sube tu relación con Bodhi; con cinco, te escucha.",
                 "«No bendigo por encargo. Ayudá a la gente de acá; me voy a enterar.»"]}
    },
    {
      "key": "solsticio_blessing", "deps": ["solsticio_good_works"], "milestone": "solsticio_blessing", "layout": {"group": "chapel", "x": 5.64, "y": 2.05, "size": 2.0, "shape": "hexagon", "hide_dependent_lines": false},
      "icon": "entrelumen:heliodor_relic_3",
      "en_us": {"title": "The Blessing",
        "text": ["[lead] Talk to Bodhi: your Atlas gives back the Heart of Heliodor.",
                 "Hand it to him and it becomes the [item:entrelumen:heliodor_relic_3|Blessed Heart of Heliodor]. If the Sun Spirit still has it, beat it first.",
                 "'It was never a machine's heart. With love, then.'"]},
      "es_es": {"title": "La bendición",
        "text": ["[lead] Hablá con Bodhi: tu Atlas devuelve el Corazón de Heliodor.",
                 "Dáselo y se convierte en el [item:entrelumen:heliodor_relic_3|Corazón de Heliodor bendito]. Si el Espíritu del Sol todavía lo tiene, vencelo primero.",
                 "«Nunca fue el corazón de una máquina. Con amor, entonces.»"]}
    },
    {
      "key": "solsticio_accord", "deps": ["solsticio_harvest", "solsticio_terraprism", "solsticio_blessing"], "milestone": "solsticio_accord", "layout": {"group": "town_hall", "x": 0, "y": 6.0, "size": 2.0, "shape": "hexagon", "hide_dependent_lines": false},
      "icon": "minecraft:lantern",
      "en_us": {"title": "The Table of Two Lights",
        "text": ["[lead] With the three relics, talk to Aurelia in the town hall and to Bodhi in the chapel.",
                 "The order does not matter.",
                 "She wants the crystal to rule the light; he fears a second fusion. The only way out is that nobody keeps it."]},
      "es_es": {"title": "La mesa de las dos luces",
        "text": ["[lead] Con las tres reliquias, hablá con Aurelia en el Ayuntamiento y con Bodhi en la capilla.",
                 "El orden da igual.",
                 "Ella quiere el cristal para mandar sobre la luz; él teme otra fusión. La única salida es que nadie se lo quede."]}
    },
    {
      "key": "solsticio_portal", "deps": ["solsticio_accord"], "milestone": "solsticio_portal", "layout": {"group": "portal", "x": 0, "y": 9.0, "size": 2.0, "shape": "hexagon", "hide_dependent_lines": false},
      "icon": "entrelumen:light_key_broken",
      "en_us": {"title": "The Portal",
        "text": ["[lead] [icon:right_click] Right-click the town hall portal with each of your three relics, then with your own [item:entrelumen:light_key_broken|Broken Light Key] in your pack.",
                 "The first team to open it frees the Entrelumen for everyone, and every shop gets cheaper.",
                 "Still a shelter. No longer a prison."]},
      "es_es": {"title": "El portal",
        "text": ["[lead] [icon:right_click] Clic derecho en el portal del Ayuntamiento con cada una de tus tres reliquias y después con tu propia [item:entrelumen:light_key_broken|Llave de Luz rota] encima.",
                 "El primer equipo que lo abre libera el Entrelumen para todos, y bajan los precios de todas las tiendas.",
                 "Sigue siendo un refugio. Ya no es una prisión."]}
    },
    {
      "key": "solsticio_elections", "deps": ["solsticio_portal"], "milestone": "solsticio_elections", "layout": {"group": "town_hall", "x": 0, "y": 12.75, "size": 3.0, "shape": "hexagon", "hide_dependent_lines": false},
      "icon": "minecraft:paper",
      "en_us": {"title": "Elections in Solsticio",
        "text": ["[lead] Three days after the portal first opens, the square votes.",
                 "Then talk to Aurelia.",
                 "'Elected. It sounds different from appointed.' Nobody asks too loudly about the new windows."]},
      "es_es": {"title": "Elecciones en Solsticio",
        "text": ["[lead] Tres días después de la primera apertura del portal, la plaza vota.",
                 "Después hablá con Aurelia.",
                 "«Elegida. Suena distinto de designada.» Nadie pregunta muy fuerte por los ventanales nuevos."]}
    }
  ]
}
